import joky/array.{type Array}
extern fn note(value: Int32)
struct Guard { id: Int32, text: String, fails: Bool }

fn make(id: Int32) -> Guard {
    let value = Guard { id: id, text: "owned", fails: false }
    note(id)
    value
}
fn normal() -> Int32 {
    let source = [make(1), make(2), make(3)]
    let result = [make(4), ..source]
    assert(result[0].id == 4 && result[1].id == 1 && result[2].id == 2 && result[3].id == 3, "spread order")
    42
}
fn nested() -> Int32 {
    let source = [[make(1)], [make(2)]]
    let result = [[make(3)], ..source, [make(4)]]
    assert(result[1][0].id == 1 && result[2][0].id == 2, "nested spread order")
    42
}
fn fail() -> Array<Guard> { let zero = 0; let bad = 1 / zero; [make(bad)] }
fn failed_source() -> Int32 {
    let pending = [make(1), make(2)]
    let result = [make(3), ..{ let temporary = make(4); fail() }, ..pending]
    0
}
fn failed_after() -> Int32 {
    let source = [make(1), make(2)]
    let result = [..source, ..fail()]
    0
}
fn failed_drop() -> Int32 {
    let source = [Guard { id: 1, text: "failing", fails: true }, make(2)]
    note(1)
    let result = [..source, make(3)]
    0
}
fn early() -> Int32 {
    let source = [make(1), make(2)]
    let result = [make(3), ..source, ..{ return 42 }]
}
fn task() @suspends -> Int32 { normal() }
fn nested_task() @suspends -> Int32 { nested() }
fn main() { note(normal()); note(nested()); note(early()) }
