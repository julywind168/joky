import joky/array.{type Array}
import joky/fixed_array.{type FixedArray}
import joky/slice.{type Slice}
import joky/string
import joky/task
import joky/check
import joky/drop.{type Drop}

fn array_sum(values: &Array<Int32>) @suspends -> Int32 {
    var total = 0
    for value in values {
        task.yield_now()
        total += *value
    }
    total
}

fn slice_sum(values: &Slice<Int32>) @suspends -> Int32 {
    var total = 0
    for value in slice.iter(values) {
        task.yield_now()
        total += *value
    }
    total
}

fn text_size(text: &String) @suspends -> Int32 {
    let copied = string.clone(text)
    let runes = string.rune_count(text)
    var count = 0
    for byte in slice.iter(string.bytes(text)) {
        task.yield_now()
        count += 1
    }
    if runes != string.rune_count(&copied) || uint64(count) != string.byte_length(&copied) { return -1 }
    count
}

fn main() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let text = "héllo 世界"
    let empty_values: Array<Int32> = []
    let empty_text = ""
    let (whole, overlap, bytes, empty, empty_array, empty_string) = join {
        array_sum(&values)
        slice_sum(values.slice(1, 4))
        text_size(&text)
        slice_sum(values.slice(4, 4))
        array_sum(&empty_values)
        text_size(&empty_text)
    }
    values[0] = 42
    whole + overlap + bytes + empty + empty_array + empty_string + values[0]
}

// Borrow in an ordinary helper after the source has moved to another worker.
fn keep(values: &Array<Int32>, text: String) @suspends -> String {
    array_sum(values)
    task.yield_now()
    text
}
fn inspect(values: &Array<Int32>, text: &String) @suspends -> UInt64 {
    let (kept, count) = join {
        keep(values, "kept")
        text_size(text)
    }
    string.byte_length(&kept) + uint64(count)
}
fn moved(values: Array<Int32>, text: String) @suspends -> UInt64 {
    inspect(&values, &text)
}
fn advanced() @suspends -> UInt64 {
    let values = [3, 5, 7, 11]
    let (count, _) = join { moved(values, "héllo 世界"), task.yield_now() }
    count
}

fn invalid_index(values: &Array<Int32>) @suspends -> Int32 {
    task.yield_now()
    values[99]
}
fn failed() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let (a, b) = join { array_sum(&values), invalid_index(&values) }
    a + b
}
fn forever(values: &Array<Int32>) @suspends -> Int32 {
    while true { array_sum(values); }
}
fn parked() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let (a, b) = join { array_sum(&values), forever(&values) }
    a + b
}

fn nested_owned(anchor: &Int32) @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let (a, b) = join { array_sum(&values), slice_sum(values.slice(1, 4)) }
    values[0] = 42
    a + b + values[0]
}
fn local_forever(anchor: &Int32) @suspends -> Int32 { while true { task.yield_now() } }
fn nested_race() @suspends -> Int32 {
    let anchor = 1
    race { nested_owned(&anchor), local_forever(&anchor) }
}
fn borrowed_race() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let result = race { array_sum(&values), forever(&values) }
    values[0] = 42
    result + values[0]
}
fn nested_isolate() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let view = &values
    let result = isolate {
        let (a, b) = join { array_sum(view), invalid_index(view) }
        a + b
    }
    values[0] = 42
    match result { Ok(_) => 0, Err(_) => values[0] }
}
struct FailedResult { text: String }
impl Drop for FailedResult { fn drop(&mut self) { check.panic("result cleanup failed") } }
fn produced(text: &String) @suspends -> FailedResult {
    task.yield_now()
    FailedResult { text: string.clone(text) }
}
fn delayed_failure(text: &String) @suspends {
    task.sleep(2ms)
    check.panic("reader failed")
}
fn isolated_results() @suspends -> Int32 {
    let text = "retained source"
    let result = isolate {
        let (a, b) = join { produced(&text), delayed_failure(&text) }
    }
    task.yield_now()
    match result { Ok(_) => 0, Err(_) => 7 }
}

fn nested_isolated_success() @suspends -> Int32 {
    let anchor = 1
    match isolate { nested_owned(&anchor) } { Ok(value) => value, Err(_) => -1 }
}

// Each level narrows only the view it received; siblings share overlapping bytes.
fn relay_slice(values: &Slice<Int32>, depth: Int32) @suspends -> Int32 {
    if depth == 0 { return slice_sum(values) }
    let (a, b) = join {
        relay_slice(slice.slice(values, 1, slice.len(values)), depth - 1)
        slice_sum(slice.slice(values, 0, 2))
    }
    a + b
}
fn relay_array(values: &Array<Int32>) @suspends -> Int32 {
    let (a, b) = join { relay_slice(values.slice(0, values.len()), 2), array_sum(values) }
    a + b
}
fn relay_text(text: &String, depth: Int32) @suspends -> Int32 {
    if depth == 0 { return text_size(text) }
    let (a, b) = join { relay_text(text, depth - 1), text_size(text) }
    a + b
}
fn relay_empty(values: &Slice<Int32>) @suspends -> Int32 {
    let (a, b) = join { slice_sum(values), slice_sum(slice.slice(values, 0, 0)) }
    a + b
}
fn forwarded() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let text = "héllo 世界"
    let (a, b, c) = join {
        relay_array(&values)
        relay_text(&text, 2)
        relay_empty(values.slice(4, 4))
    }
    values[0] = 42
    a + b + c + values[0]
}
fn relay_race(values: &Array<Int32>) @suspends -> Int32 {
    race { array_sum(values), forever(values) }
}
fn forwarded_race() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let (a, b) = join { relay_race(&values), array_sum(&values) }
    values[0] = 42
    a + b + values[0]
}
fn relay_isolate(values: &Array<Int32>) @suspends -> Int32 {
    match isolate { failed_reader(values) } { Ok(_) => 0, Err(_) => array_sum(values) }
}
fn failed_reader(values: &Array<Int32>) @suspends -> Int32 {
    let (a, b) = join { array_sum(values), invalid_index(values) }
    a + b
}
fn forwarded_isolate() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let (a, b) = join { relay_isolate(&values), array_sum(&values) }
    values[0] = 42
    a + b + values[0]
}

fn forwarded_failed() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let (a, b) = join { failed_reader(&values), array_sum(&values) }
    a + b
}
fn parked_reader(values: &Array<Int32>) @suspends -> Int32 {
    let (a, b) = join { array_sum(values), forever(values) }
    a + b
}
fn forwarded_parked() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let (a, b) = join { parked_reader(&values), array_sum(&values) }
    a + b
}

struct LocalAnchor { value: String }
impl Drop for LocalAnchor { fn drop(&mut self) {} }
fn local_anchor(anchor: &LocalAnchor) @suspends { task.yield_now() }
fn dynamic_shared() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let view = &values
    let anchor = LocalAnchor { value: "local" }
    let local = &anchor
    scope {
        branch { local_anchor(local) }
        var i = 0
        while i < 3 {
            branch { if array_sum(view) != 26 { invalid_index(view); } }
            i += 1
        }
        branch { local_anchor(local) }
        branch { scope { branch { array_sum(view); } } }
        if array_sum(view) != 26 { invalid_index(view); }
    }
    values[0] = 42
    values[0]
}
fn dynamic_return() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let view = &values
    scope {
        branch { array_sum(view); }
        return array_sum(view)
    }
}
fn dynamic_isolate() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let view = &values
    let result = isolate {
        branch { forever(view); }
        branch { invalid_index(view); }
    }
    values[0] = 42
    match result { Ok(_) => 0, Err(_) => values[0] }
}
fn dynamic_views() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let text = "héllo 世界"
    let view = values.slice(1, 3)
    let empty = values.slice(4, 4)
    let borrowed_text = &text
    scope {
        branch { if slice_sum(view) != 12 { check.panic("bad slice") } }
        branch { if slice_sum(empty) != 0 { check.panic("bad empty slice") } }
        branch { if text_size(borrowed_text) != 13 { check.panic("bad text") } }
    }
    12
}

struct LocalCounter { value: Int32 }
fn dynamic_mixed() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let view = &values
    var counter = LocalCounter { value: 0 }
    let local = &mut counter
    scope {
        branch { array_sum(view); }
        branch { task.yield_now(); local.value = 9 }
        branch { array_sum(view); }
    }
    counter.value
}
fn dynamic_failed() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let view = &values
    scope { branch { invalid_index(view); }; branch { forever(view); } }
    0
}
fn dynamic_parked() @suspends -> Int32 {
    let values = [3, 5, 7, 11]
    let view = &values
    scope { branch { forever(view); }; branch { forever(view); } }
    0
}
fn dynamic_break_continue() @suspends -> Int32 {
    var values = [3, 5, 7, 11]
    let view = &values
    var count = 0
    while count < 3 {
        scope {
            branch { array_sum(view); }
            count += 1
            if count == 1 { continue }
            break
        }
    }
    values[0] = 42
    values[0] + count
}


// Padded records, tuples and inline fixed arrays remain borrowed payloads.
struct Cell { flag: Bool, weight: Float64, pair: (Int32, Int16), row: FixedArray<Int32, 2> }
fn cell(n: Int32) -> Cell {
    Cell { flag: true, weight: 1.5, pair: (n, int16(2)), row: fixed_array.repeat::<Int32, 2>(n) }
}
fn cell_sum(values: &Slice<Cell>) @suspends -> Int32 {
    var total = 0
    for value in slice.iter(values) {
        task.yield_now()
        let weight = if value.weight == 1.5 { 1 } else { 0 }
        let flag = if value.flag { 1 } else { 0 }
        total += value.pair.0 + int32(value.pair.1) + weight + value.row[0] + value.row[1] + flag
    }
    total
}
fn cell_forward(values: &Array<Cell>) @suspends -> Int32 {
    let part = values.slice(1, 3)
    let (a, b) = join { cell_sum(part), cell_sum(slice.slice(part, 0, 1)) }
    a + b
}
fn cell_forever(values: &Slice<Cell>) @suspends -> Int32 {
    while true { cell_sum(values); }
}
fn aggregate_readers() @suspends -> Int32 {
    var values = [cell(1), cell(2), cell(3)]
    let (a, b) = join { cell_forward(&values), cell_sum(values.slice(0, 3)) }
    let view = values.slice(0, 3)
    scope { branch { if cell_sum(view) != 30 { check.panic("bad aggregate capture") } } }
    let c = match isolate {
        race { cell_sum(view), cell_forever(view) }
    } { Ok(value) => value, Err(_) => return -1 }
    values[0] = cell(4)
    a + b + c + cell_sum(values.slice(0, 1))
}
fn cell_fail(values: &Slice<Cell>) @suspends -> Int32 {
    task.yield_now()
    check.panic("aggregate reader failed")
}
fn aggregate_failed() @suspends -> Int32 {
    let values = [cell(1)]
    let (a, b) = join { cell_sum(values.slice(0, 1)), cell_fail(values.slice(0, 1)) }
    a + b
}
fn aggregate_parked() @suspends -> Int32 {
    let values = [cell(1)]
    let view = values.slice(0, 1)
    scope { branch { cell_forever(view); }; branch { cell_forever(view); } }
    0
}
struct Empty { value: Unit }
fn empty_count(values: &Slice<Empty>) @suspends -> Int32 {
    var count = 0
    for value in slice.iter(values) { task.yield_now(); count += 1 }
    count
}
fn empty_forward(values: &Array<Empty>) @suspends -> Int32 {
    let part = values.slice(1, 3)
    let (a, b) = join { empty_count(part), empty_count(slice.slice(part, 1, 1)) }
    a + b
}
fn aggregate_zero() @suspends -> Int32 {
    var values = [Empty { value: {} }, Empty { value: {} }, Empty { value: {} }]
    let (a, b) = join { empty_forward(&values), empty_count(values.slice(0, 3)) }
    values.push(Empty { value: {} })
    a + b + int32(values.len())
}
fn tuple_sum(values: &Array<(UInt8, Int64)>) @suspends -> Int32 {
    task.yield_now()
    let pair = values[0]
    int32(pair.0) + int32(pair.1)
}
fn row_sum(values: &Array<FixedArray<Int32, 2>>) @suspends -> Int32 {
    task.yield_now()
    let row = values[0]
    row[0] + row[1]
}
fn aggregate_layouts() @suspends -> Int32 {
    let pairs = [(uint8(2), int64(4))]
    let rows = [fixed_array.repeat::<Int32, 2>(3)]
    let (a, b) = join { tuple_sum(&pairs), row_sum(&rows) }
    a + b
}

fn aggregate_capture() @suspends -> Int32 {
    let values = [cell(1), cell(2), cell(3)]
    let view = &values
    scope { branch { if cell_forward(view) != 33 { check.panic("bad aggregate relay") } } }
    cell_sum(values.slice(0, 3))
}
