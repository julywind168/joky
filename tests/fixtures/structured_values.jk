import joky/task
import joky/drop.{type Drop}
import joky/array.{type Array}
import joky/result.{type Result, Ok, Err}
import joky/check.{assert}
extern fn record(value: Int32) -> Int32
extern fn delayed_value(value: Int32) @suspends -> Int32

fn ensure(value: Bool) { let message = "structured value contract"; assert(value, &message) }
struct Tracked { id: Int32, text: String }
impl Drop for Tracked { fn drop(&mut self) { record(self.id); if self.id == 9 { ensure(false) } } }
fn make(id: Int32) -> Tracked {
    let value = Tracked { id: id, text: "payload" }
    record(-id);
    value
}
fn relay<T>(value: T, polls: Int32) @suspends -> T {
    var n = 0
    while n < polls { task.yield_now(); n = n + 1 }
    value
}
fn unit() @suspends { task.yield_now() }
fn scope_scalar() @suspends -> Int32 {
    let value: Int8 = scope { branch { task.yield_now(); record(10); }; 42 }
    ensure(value == 42)
    let wide = 1 + scope { relay::<Int64>(41, 1) }
    ensure(wide == 42)
    42
}
fn scope_owned() @suspends -> Int32 {
    let value = scope { branch { task.yield_now(); record(10); }; make(1) }
    record(100);
    task.yield_now()
    ensure(value.id == 1 && value.text.byte_length() == 7)
    42
}
fn scope_return_value() @suspends -> Tracked {
    scope { branch { task.yield_now(); record(10); }; return make(1) }
}
fn scope_return() @suspends -> Int32 {
    let value = scope_return_value()
    ensure(value.id == 1)
    42
}
fn scope_failure() @suspends -> Int32 {
    let value = scope { branch { task.yield_now(); ensure(false) }; make(1) }
    record(100);
    42
}
fn mixed() @suspends -> Int32 {
    let (a, b, c, d, e) = parallel {
        | relay::<Int8>(-128, 2)
        | relay::<UInt64>(18446744073709551615, 0)
        | unit()
        | relay::<Float64>(1.5, 1)
        | relay(true, 0)
    }
    let unit_value: Unit = c
    ensure(a == -128 && b == 18446744073709551615 && d == 1.5 && e)
    let (single,) = parallel { | relay(42, 1) }
    let empty: Unit = parallel { | unit() | unit() }
    single
}
struct Empty {}
struct Pair { small: Int8, wide: UInt64 }
fn aggregates() @suspends -> Int32 {
    let (a, b, c) = parallel {
        | relay(Pair { small: -128, wide: 18446744073709551615 }, 2)
        | relay((40, 2), 0)
        | relay(Empty {}, 1)
    }
    ensure(a.small == -128 && a.wide == 18446744073709551615)
    let (left, right) = b
    left + right
}
fn owned() @suspends -> Int32 {
    let (a, b) = parallel { | relay(make(1), 0) | relay(make(2), 3) }
    record(100);
    task.yield_now()
    ensure(a.id == 1 && b.id == 2 && a.text.byte_length() == 7)
    42
}
fn discard() @suspends -> Int32 {
    parallel { | relay(make(1), 0) | relay(make(2), 2) };
    record(100);
    42
}
fn array_value(id: Int32) -> Array<Tracked> {
    var values = Array.new::<Tracked>()
    values.push(make(id))
    values
}
fn arrays() @suspends -> Int32 {
    let (first, second) = parallel { | relay(array_value(1), 0) | relay(array_value(2), 2) }
    var a = first
    var b = second
    a.push(make(3))
    b.push(make(4))
    ensure(a.len() == 2 && b.len() == 2)
    42
}
fn results() @suspends -> Int32 {
    let a: Result<Tracked, Tracked> = Ok(make(1))
    let b: Result<Tracked, Tracked> = Err(make(2))
    let (a, b) = parallel { | relay(a, 0) | relay(b, 2) }
    let left = match a { Ok(v) => v.id, Err(_) => 0 }
    let right = match b { Ok(_) => 0, Err(v) => v.id }
    ensure(left == 1 && right == 2)
    42
}
fn nested_value() @suspends -> (Tracked, Tracked) {
    scope { branch { task.yield_now() }; parallel { | relay(make(1), 0) | relay(make(2), 2) } }
}
fn nested() @suspends -> Int32 {
    let ((a, b), c) = parallel { | nested_value() | relay(make(3), 0) }
    ensure(a.id == 1 && b.id == 2 && c.id == 3)
    42
}
fn relay_owned(value: Tracked, polls: Int32) @suspends -> Tracked { relay(value, polls) }
fn indirect() @suspends -> Int32 {
    let f = relay_owned
    let (a, b) = parallel { | f(make(1), 0) | f(make(2), 2) }
    ensure(a.id == 1 && b.id == 2)
    42
}
fn host_scalar() @suspends -> Int32 {
    let (a, b) = parallel { | delayed_value(19) | delayed_value(21) }
    a + b
}
fn repeat() @suspends -> Int32 {
    var n = 0
    while n < 3 {
        let (a, b) = parallel { | relay(make(1), 0) | relay(make(2), 2) }
        ensure(a.id == 1 && b.id == 2)
        n = n + 1
    }
    42
}
fn fail_branch() @suspends -> Tracked { task.yield_now(); ensure(false); make(2) }
fn branch_failure() @suspends -> Int32 {
    let value = parallel { | relay(make(1), 0) | fail_branch() }
    record(100);
    42
}
fn fail_return() @suspends -> Tracked { let bad = make(9); task.yield_now(); make(2) }
fn cleanup_failure() @suspends -> Int32 {
    let value = parallel { | relay(make(1), 0) | fail_return() }
    record(100);
    42
}
fn choose<T>(value: T) @suspends -> T { scope { branch { unit() }; value } }
fn pair<T, U>(a: T, b: U) @suspends -> (T, U) { parallel { | relay(a, 0) | relay(b, 1) } }
fn generic_context() @suspends -> Int32 {
    let (a, b) = pair(choose(make(1)), 41)
    ensure(a.id == 1)
    let total = 1 + scope { b }
    total
}
fn scope_control_flow() @suspends -> Int32 {
    var n = 0
    while n < 3 {
        let value = scope {
            branch { unit() }
            n = n + 1
            if n == 1 { continue }
            if n == 3 { break }
            make(1)
        }
        ensure(value.id == 1)
    }
    let value: Unit = scope { 42; }
    42
}
struct Worker { id: Int32 }
impl Worker { fn work(self) @suspends -> Int32 { task.yield_now(); self.id } }
fn members() @suspends -> Int32 {
    let a = Worker { id: 40 }
    let b = Worker { id: 2 }
    let (a, b) = parallel { | a.work() | b.work() }
    a + b
}

fn padded<T>(before: Unit, value: T, after: Unit, polls: Int32) @suspends -> T {
    relay(value, polls)
}
fn padded_pair(before: Unit, value: Pair, after: Unit, polls: Int32) @suspends -> Pair {
    padded(before, value, after, polls)
}
fn call_shapes() @suspends -> Int32 {
    let empty = unit()
    padded(empty, empty, empty, 1)
    let narrow = padded::<Int8>(empty, -128, empty, 2)
    let original = padded(empty, Pair { small: narrow, wide: 18446744073709551615 }, empty, 2)
    let f = padded_pair
    let (pair, owner) = parallel {
        | f(empty, original, empty, 2)
        | padded(empty, make(1), empty, 0)
    }
    let winner = race {
        | f(empty, pair, empty, 2)
        | f(empty, Pair { small: 0, wide: 0 }, empty, 4)
    }
    ensure(winner.small == -128 && winner.wide == 18446744073709551615)
    ensure(owner.id == 1 && owner.text.byte_length() == 7)
    42
}
