import joky/array.{type Array}

enum ProbeWord { A(Int32), B(Int32), C(Int32), D(Int32) }
enum ProbeMixed { Wide(Int64), Small(Bool), Empty, Float(Float64) }

fn read(value: ProbeWord) -> Int32 {
    match value {
        ProbeWord.A(x) => x
        ProbeWord.B(x) => x + 1
        ProbeWord.C(x) => x + 2
        ProbeWord.D(x) => x + 3
    }
}

fn roundtrip() -> Int32 {
    var words = Array.with_capacity::<ProbeWord>(1)
    words.push(ProbeWord.D(-3))
    words.push(ProbeWord.B(41))
    var reads: UInt64 = 0
    let saved = words[{ let i = reads; reads += 1; i }]
    if read(words.take_last()) != 42 { return 2 }
    words.push(ProbeWord.A(3))
    words.push(ProbeWord.A(4))
    let tail = &mut words[1..3]
    let last = tail.slice_mut(1, 2)
    last[0] = ProbeWord.C(40)
    if read(last[0]) != 42 || last.get(1).is_some() { return 11 }
    if read(tail.get(0)!) != 3 || read(words.take_last()) != 42 { return 12 }
    words.take_last()
    var index: UInt64 = 0
    words[{ let i = index; index += 1; i }] = {
        if index != 1 { return 10 }
        index = 2
        ProbeWord.C(40)
    }
    if index != 2 { return 13 }
    if reads != 1 || read(saved) != 0 { return 1 }
    var values = [ProbeMixed.Wide(4294967297), ProbeMixed.Float(-1.5)]
    values[0] = ProbeMixed.Small(true)
    if (match values[0] { ProbeMixed.Small(x) => x, _ => false }) == false { return 3 }
    values.set(0, ProbeMixed.Empty)
    if (match values.get(0)! { ProbeMixed.Empty => false, _ => true }) { return 4 }
    values[0] = ProbeMixed.Wide(-4294967297)
    if (match values.get(0)! { ProbeMixed.Wide(x) => x, _ => 0 }) != -4294967297 { return 5 }
    if (match values.take_last() { ProbeMixed.Float(x) => x, _ => 0.0 }) != -1.5 { return 6 }
    read(words.take_last())
}

fn reserve_words(n: UInt64) -> Int32 {
    var words = Array.with_capacity::<ProbeWord>(n)
    words.push(ProbeWord.A(42))
    read(words.take_last())
}

fn bad_index() -> Int32 {
    let words = [ProbeWord.A(42)]
    read(words[1])
}

fn rebind_store() -> Int32 {
    var first = [ProbeWord.A(1)]
    var second = [ProbeWord.A(2)]
    var dest = &mut first
    dest[0] = { dest = &mut second; ProbeWord.B(39) }
    read(first[0]) + read(dest[0])
}

fn bad_store() -> Int32 {
    var words = [ProbeWord.A(42)]
    words[1] = { return 17 }
}
