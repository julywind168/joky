import joky/array.{type Array}

enum ProbeWord { A(Int32), B(Int32), C(Int32), D(Int32) }
enum ProbeMixed { Wide(Int64), Small(Bool), Empty, Float(Float64) }

fn read(value: ProbeWord) -> Int32 {
    match value {
        ProbeWord.A(x) => x
        ProbeWord.B(x) => x + 1
        ProbeWord.C(x) => x + 2
        ProbeWord.D(x) => x + 3
    }
}

fn roundtrip() -> Int32 {
    var words = Array.with_capacity::<ProbeWord>(1)
    words.push(ProbeWord.D(-3))
    words.push(ProbeWord.B(41))
    if read(words.get(0)!) != 0 { return 1 }
    if read(words.take_last()) != 42 { return 2 }
    words.set(0, ProbeWord.C(40))
    var values = [ProbeMixed.Wide(4294967297), ProbeMixed.Float(-1.5)]
    values.set(0, ProbeMixed.Small(true))
    if (match values.get(0)! { ProbeMixed.Small(x) => x, _ => false }) == false { return 3 }
    values.set(0, ProbeMixed.Empty)
    if (match values.get(0)! { ProbeMixed.Empty => false, _ => true }) { return 4 }
    values.set(0, ProbeMixed.Wide(-4294967297))
    if (match values.get(0)! { ProbeMixed.Wide(x) => x, _ => 0 }) != -4294967297 { return 5 }
    if (match values.take_last() { ProbeMixed.Float(x) => x, _ => 0.0 }) != -1.5 { return 6 }
    read(words.take_last())
}

fn reserve_words(n: UInt64) -> Int32 {
    var words = Array.with_capacity::<ProbeWord>(n)
    words.push(ProbeWord.A(42))
    read(words.take_last())
}
