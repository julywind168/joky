import joky/array.{type Array}
import remove_library.{remove}
import joky/drop.{type Drop}
extern fn record_drop(value: Int32)
struct Resource { id: Int32, values: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { record_drop(self.id) } }
fn resource(id: Int32) -> Resource {
    let result = Resource { id: id, values: Array.new::<Int32>() }
    record_drop(-id)
    result
}
fn remove_copy() -> Int32 {
    var values = Array.with_capacity::<Int64>(8)
    values.push(10); values.push(20); values.push(30); values.push(40)
    let capacity = values.capacity()
    let first = array.swap_remove(&mut values, 0).unwrap_or(0)
    if first != 10 || values.get(0).unwrap_or(0) != 40 { return 0 }
    let middle = remove(&mut values, 1).unwrap_or(0)
    if middle != 20 || values.get(1).unwrap_or(0) != 30 { return 0 }
    if values.swap_remove(18446744073709551615).is_some() { return 0 }
    if values.len() != 2 || values.capacity() != capacity { return 0 }
    if values.swap_remove(1).unwrap_or(0) != 30 { return 0 }
    if values.swap_remove(0).unwrap_or(0) != 40 { return 0 }
    if values.swap_remove(0).is_some() { return 0 }
    values.push(42)
    int32(values.get(0).unwrap_or(0))
}
fn remove_owned() -> Int32 {
    var values = Array.with_capacity::<Resource>(4)
    values.push(resource(1)); values.push(resource(2)); values.push(resource(3))
    if values.swap_remove(3).is_some() { return 0 }
    let old = remove(&mut values, 0)
    if values.borrow_ref(0).id != 3 || values.borrow_ref(1).id != 2 { return 0 }
    if values.capacity() != 4 || values.len() != 2 { return 0 }
    match old { Some(item) => item.id + 41, None => 0 }
}
fn remove_enum_tuple() -> Int32 {
    var values = Array.new::<Option<(Resource, Resource)>>()
    values.push(Some((resource(1), resource(2))))
    values.push(None)
    let old = values.swap_remove(0)
    if !values.swap_remove(0).unwrap_or(None).is_none() { return 0 }
    match old {
        Some(Some((a, b))) => a.id + b.id + 39
        _ => 0
    }
}
fn remove_wrapper() -> Int32 {
    var values = Array.new::<Array<Int32>>()
    var a = Array.new::<Int32>(); a.push(20)
    var b = Array.new::<Int32>(); b.push(22)
    values.push(a); values.push(b)
    let old = values.swap_remove(0)
    match old {
        Some(item) => item.get(0).unwrap_or(0) + values.borrow_ref(0).get(0).unwrap_or(0)
        None => 0
    }
}
struct Pair { a: UInt64, b: Bool, c: Unit }
fn remove_zero_and_aggregate() -> Int32 {
    var zero = Array.new::<Unit>()
    zero.push({}); zero.push({})
    if zero.swap_remove(0).is_none() || zero.len() != 1 { return 0 }
    if zero.swap_remove(0).is_none() || !zero.is_empty() { return 0 }
    if zero.swap_remove(0).is_some() { return 0 }
    var values = Array.new::<Pair>()
    values.push(Pair { a: 18446744073709551615, b: false, c: {} })
    values.push(Pair { a: 42, b: true, c: {} })
    let old = values.swap_remove(0)
    match old { Some(item) => if item.a != 18446744073709551615 || item.b { return 0 }, None => return 0 }
    if values.get(0).unwrap_or(Pair { a: 0, b: false, c: {} }).b { 42 } else { 0 }
}
fn remove_references() -> Int32 {
    var values = Array.new::<&Int32>()
    values.push((&*(alloc(20)))); values.push((&*(alloc(22))))
    let old = values.swap_remove(0)
    let remaining = values.get(0)
    values.release()
    match old { Some(a) => match remaining { Some(b) => (*a) + (*b), None => 0 }, None => 0 }
}
struct Failing { id: Int32, values: Array<Int32> }
impl Drop for Failing {
    fn drop(&mut self) { record_drop(self.id); let zero = 0; let _ = 1 / zero }
}
fn remove_drop_failure() -> Int32 {
    var values = Array.new::<Failing>()
    values.push(Failing { id: 1, values: Array.new::<Int32>() })
    values.push(Failing { id: 2, values: Array.new::<Int32>() })
    values.push(Failing { id: 3, values: Array.new::<Int32>() })
    let removed = values.swap_remove(0)
    42
}
fn remove_transitions() -> Int32 {
    var values = Array.new::<Resource>()
    values.push(resource(1)); values.push(resource(2)); values.push(resource(3))
    let old = values.swap_remove(0)
    values.push(resource(4))
    if values.borrow_ref(0).id != 3 { return 0 }
    record_drop(-90)
    match old { Some(item) => item.id + 41, None => 0 }
}
fn remove_task() @suspends -> Int32 { remove_transitions() }
