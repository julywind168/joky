import joky/option as opt.{type Option as Maybe}
import joky/result as res.{type Result as Outcome}
import joky/array.{type Array}
import joky/string
import joky/check as checks.{assert}

struct Cell { value: Int32 }
struct Link { next: Maybe<&Cell> }
struct OwnedField { data: Array<Int32>, state: Maybe<Int32> }

fn present<T>(value: &Maybe<T>) -> Bool { value.is_some() && !value.is_none() }
fn successful<T, E>(value: &Outcome<T, E>) -> Bool { value.is_ok() && !value.is_err() }
fn fallback() -> Int32 { 42 }
fn recover(error: Int32) -> Int32 { error + 2 }

fn check() -> Int32 {
    let text = Maybe.Some("hello")
    if !present(&text) || !text.is_some() || text.is_none() { return 1 }
    if text.unwrap_or("wrong").byte_length() != 5 { return 2 }
    let good: Outcome<String, String> = Outcome.Ok("hello")
    let bad: Outcome<String, String> = Outcome.Err("error")
    if !successful(&good) || good.is_err() || bad.is_ok() || !bad.is_err() { return 3 }
    if good.unwrap_or("wrong").byte_length() != 5 || bad.err().unwrap_or("").byte_length() != 5 { return 4 }
    var values = Array.new::<Int32>()
    values.push(42)
    let owned = Maybe.Some(values)
    if !owned.is_some() || owned.is_none() { return 5 }
    let restored = owned.unwrap_or_else(|| { Array.new::<Int32>() })
    if restored.get(0).unwrap_or(0) != 42 { return 6 }
    if !Maybe.Some("temporary").is_some() || !Outcome.Err::<Int32, String>("temporary").is_err() { return 7 }
    if !opt.Option::<String>.is_some(Maybe.Some("qualified")) { return 8 }

    var calls = 0
    let a = { Maybe.Some(40).unwrap_or_else(|| { calls = calls + 1; 0 }) }
    let b = { Maybe.None::<Int32>.unwrap_or_else(|| { calls = calls + 1; 2 }) }
    let c = { Outcome.Ok::<Int32, Int32>(40).unwrap_or_else(|error| { calls = calls + 1; error }) }
    let d = { Outcome.Err::<Int32, Int32>(1).unwrap_or_else(|error| { calls = calls + 1; error + 1 }) }
    if calls != 2 || a + b != 42 || c + d != 42 { return 9 }
    if Maybe.None::<Int32>.unwrap_or_else(fallback) != 42 || Outcome.Err::<Int32, Int32>(40).unwrap_or_else(recover) != 42 { return 10 }
    let captured = "moved fallback"
    let moved = Maybe.None::<String>.unwrap_or_else(move || { captured })
    let error: Outcome<String, String> = Outcome.Err(moved)
    let recovered = error.unwrap_or_else(|error| { error })
    if recovered.byte_length() != 14 { return 11 }
    let unused = "unused fallback"
    let kept = Maybe.Some("kept").unwrap_or_else(move || { unused })
    if kept.byte_length() != 4 { return 12 }
    let unit = Maybe.None::<Unit>.unwrap_or_else(|| {})
    let unit_error: Outcome<Unit, Unit> = Outcome.Err({})
    unit_error.unwrap_or_else(|error| { error })

    let mapped = Maybe.Some(20).map_or(1, |value| { value + 1 })
    let mapped_default = Maybe.None::<Int32>.map_or(21, |value| { value + 1 })
    let result_mapped = Outcome.Ok::<Int32, Int32>(20).map_or(1, |value| { value + 1 })
    let result_mapped_default = Outcome.Err::<Int32, Int32>(21).map_or(22, |value| { value + 1 })
    let filtered = Maybe.Some(4).filter(|value| { *value > 3 })
    let rejected = Maybe.Some(2).filter(|value| { *value > 3 })
    let nested_some: Maybe<Maybe<Int32>> = Maybe.Some(Maybe.Some(42))
    let nested_none: Maybe<Maybe<Int32>> = Maybe.Some(Maybe.None)
    let outer_none: Maybe<Maybe<Int32>> = Maybe.None
    let nested_ok: Outcome<Outcome<Int32, Int32>, Int32> = Outcome.Ok(Outcome.Ok(42))
    let nested_err: Outcome<Outcome<Int32, Int32>, Int32> = Outcome.Ok(Outcome.Err(7))
    let outer_err: Outcome<Outcome<Int32, Int32>, Int32> = Outcome.Err(9)
    if mapped != 21 || mapped_default != 21 || result_mapped != 21 || result_mapped_default != 22 ||
        filtered.unwrap_or(0) != 4 || rejected.is_some() || nested_some.flatten().unwrap_or(0) != 42 ||
        !nested_none.flatten().is_none() || !outer_none.flatten().is_none() ||
        nested_ok.flatten().unwrap_or(0) != 42 || nested_err.flatten().err().unwrap_or(0) != 7 ||
        outer_err.flatten().err().unwrap_or(0) != 9 { return 18 }
    if !Maybe.Some(3).is_some_and(|value| { *value == 3 }) || Maybe.None::<Int32>.is_some_and(|value| { *value == 0 }) { return 19 }
    let missing = Maybe.None::<Int32>.ok_or(7)
    let lazy_missing = Maybe.None::<Int32>.ok_or_else(|| { 8 })
    let present_result: Outcome<Int32, Int32> = Maybe.Some(9).ok_or(0)
    if missing.err().unwrap_or(0) != 7 || lazy_missing.err().unwrap_or(0) != 8 || present_result.unwrap_or(0) != 9 { return 20 }
    let inspected = Outcome.Err::<Int32, Int32>(11).inspect_err(|error| { checks.assert(*error == 11, "inspect_err") })
    if inspected.err().unwrap_or(0) != 11 || Outcome.Ok::<Int32, Int32>(12).inspect_err(|error| { checks.assert(false, "unexpected inspect_err") }).unwrap_or(0) != 12 { return 21 }
    if Maybe.Some(22).expect("present") != 22 || Outcome.Ok::<Int32, Int32>(23).expect("success") != 23 { return 22 }

    // Receiver and callback construction run once in order; only invocation is lazy.
    var order = 0
    let value = { order = order * 10 + 1; Maybe.Some(42) }.unwrap_or_else({
        order = order * 10 + 2
        fallback
    })
    if value != 42 || order != 12 { return 13 }
    shared_queries()
}

fn shared_queries() -> Int32 {
    let cell: &Cell = alloc(Cell { value: 42 })
    let selected: Maybe<&Cell> = Maybe.Some(cell)
    let outcome: Outcome<&Cell, &Cell> = Outcome.Err(cell)
    if !selected.is_some() || selected.is_none() || outcome.is_ok() || !outcome.is_err() { return 14 }
    if !opt.Option::<&Cell>.is_some(selected) { return 15 }
    let link = alloc(Link { next: selected })
    if !link.next.is_some() || selected.unwrap_or(cell).value != 42 { return 16 }
    let owner = OwnedField { data: Array.new::<Int32>(), state: Maybe.Some(42) }
    if !owner.state.is_some() || owner.data.len() != 0 { return 17 }
    42
}
