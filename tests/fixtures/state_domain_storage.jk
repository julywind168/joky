import joky/domain
import joky/task
import joky/check
import joky/mem
import joky/array.{type Array}
import joky/map.{type Map}

fn assert(condition: Bool) { let message = "HR1 domain"; check.assert(condition, &message) }
enum Status { Idle, Ready((Int32, String)) }
struct Profile { name: String, score: Int32, details: (String, Int32), status: Status }
struct Player { profile: Profile, inventory: Array<String> }
struct State { leader: Player, players: Array<Player>, rooms: Map<Int32, Player>, value: Int32 }
fn player(value: Int32) -> Player {
    var inventory = Array.new::<String>()
    inventory.push("sword")
    inventory.push("shield")
    Player { profile: Profile { name: "玩家", score: value, details: ("active", value), status: Status.Ready((value, "ready")) }, inventory: inventory }
}
fn make(value: Int32) -> State {
    var players = Array.new::<Player>()
    players.push(player(value))
    var rooms = Map.new::<Int32, Player>()
    rooms.insert(1, player(value));
    rooms.insert(2, player(value + 1));
    let temporary = player(0)
    State { leader: player(value), players: players, rooms: rooms, value: value }
}
fn read(state: &State) -> Int32 { state.value }
fn valid(player: &Player, value: Int32) -> Bool {
    let name = "玩家"
    let item = "shield"
    let detail = "active"
    player.profile.details.0 == detail && player.profile.details.1 == value && (match &player.profile.status { Ready(details) => details.0 == value && details.1 == "ready", _ => false }) && player.profile.name == name && player.profile.score == value && player.inventory.len() == 2 && player.inventory.borrow_ref(1) == item
}
fn inspect(state: &State) -> Bool {
    let temporary = player(0)
    valid(&state.leader, state.value) && state.players.len() == 1 && valid(state.players.borrow_ref(0), state.value) && state.rooms.len() == 2 && valid(state.rooms.borrow_ref(1), state.value) && valid(state.rooms.borrow_ref(2), state.value + 1)
}
fn change(state: &mut State, value: Int32) -> Int32 {
    var next = make(value)
    mem.swap(state, &mut next)
    value
}
fn edit(state: &mut State, value: Int32) -> Int32 {
    state.rooms.insert(1, player(value));
    state.rooms.remove(2);
    state.rooms.insert(2, player(value + 1));
    state.players.replace(0, player(value));
    var leader = player(value)
    mem.swap(&mut state.leader, &mut leader)
    state.value = value
    value
}
struct EditInput { value:Int32, ignored:Bool }
fn update(state:&mut State,input:EditInput) { edit(state,input.value); }
fn swap_states(a:&mut State,b:&mut State,input:Unit) { mem.swap(a,b) }
fn sum(a:&State,b:&State)->Int32 { a.value+b.value }
fn copy_value(a:&State,b:&mut State,value:Int32)->Int32 { edit(b,a.value+value) }
fn fail_swap(a:&mut State,b:&mut State,zero:Int32)->Int32 { mem.swap(a,b); 1/zero }
fn fail_mixed(a:&State,b:&mut State,zero:Int32)->Int32 { edit(b,99); a.value/zero }
fn capture(a:domain.ReadHandle<State>,b:domain.ReadHandle<State>,c:domain.ReadHandle<State>) @suspends ->domain.SnapshotSet {
    var accesses=domain.access_set()
    accesses.include(a); accesses.include(b); accesses.include(c); accesses.include(a)
    domain.snapshot_set(accesses)
}
fn narrow(handle:domain.WriteHandle<State>)->domain.ReadHandle<State> {handle.read_only()}
struct TextOnly {text:String}
fn text(n:Int32)->TextOnly {TextOnly{text:if n==1 {"first"} else {"single"}}}
fn text_swap(a:&mut TextOnly,b:&mut TextOnly,input:Unit) {mem.swap(a,b)}
fn text_valid(state:&TextOnly)->Bool {let expected="single"; state.text == expected}
fn text_pair(a:&TextOnly,b:&TextOnly)->Bool {text_valid(a) && text_valid(b)}
fn lifecycle() @suspends ->Int32 {
    let a=domain.create(make,1); let b=domain.create(make,2); let c=domain.create(make,3)
    let ah=a.handle(); let bh=b.handle(); let ch=c.handle()
    let ar=narrow(ah); let br=bh.read_only(); let cr=ch.read_only()
    let projected=domain.snapshot_pair(ar,br,sum)
    assert(projected.value()==3)
    let old=capture(ar,br,cr)
    assert(domain.read_snapshot(&old,ar,inspect))
    domain.write_pair(ah,bh,swap_states,{}).unwrap()
    assert(domain.read_from(ar,read).unwrap()==2 && domain.read_from(br,read).unwrap()==1)
    assert(domain.read_from(ar,inspect).unwrap() && domain.read_from(br,inspect).unwrap())
    assert(domain.read_snapshot(&old,ar,read)==1 && domain.read_snapshot(&old,ar,inspect))
    assert(projected.value()==3 && (match projected.check(){Conflict=>true,_=>false}))
    assert(domain.read_pair(ar,ar,sum).unwrap()==4)
    assert(domain.update_pair(ar,bh,copy_value,2).unwrap()==4)
    let frozen=capture(ar,br,cr)
    let candidate=domain.edit_snapshot(frozen,bh,update,EditInput{value:10,ignored:false})
    task.yield_now()
    let candidate=domain.edit_candidate(candidate,ah,update,EditInput{value:20,ignored:true})
    let candidate=domain.edit_candidate(candidate,bh,update,EditInput{value:11,ignored:false})
    assert(domain.read_from(ar,read).unwrap()==2 && domain.read_from(br,read).unwrap()==4)
    var receipt=domain.commit_set(candidate)
    assert(receipt.wait().is_ok())
    assert(receipt.revision(cr).unwrap().is_none())
    assert(domain.read_from(ar,read).unwrap()==20 && domain.read_from(br,read).unwrap()==11)
    assert(domain.read_from(ar,inspect).unwrap() && domain.read_from(br,inspect).unwrap())
    let stale=domain.edit_snapshot(capture(ar,br,cr),ah,update,EditInput{value:99,ignored:false})
    domain.write_to(ch,edit,4).unwrap()
    var rejected=domain.commit_set(stale)
    assert(match rejected.wait(){Err(Conflict)=>true,_=>false})
    assert(domain.read_from(ar,read).unwrap()==20)
    let rebuilt=domain.candidate_set_from(capture(ar,br,cr),ah,make,30)
    let rebuilt=domain.candidate_set_add(rebuilt,bh,make,40)
    var built=domain.commit_set(rebuilt)
    assert(built.wait().is_ok())
    assert(domain.read_from(ar,read).unwrap()==30 && domain.read_from(br,read).unwrap()==40)
    assert(domain.read_from(ar,inspect).unwrap() && domain.read_from(br,inspect).unwrap())
    let single=domain.create(text,0)
    let sh=single.handle()
    var accesses=domain.access_set(); accesses.include(sh.read_only())
    let frozen=domain.snapshot_set(accesses)
    assert(domain.read_snapshot(&frozen,sh.read_only(),text_valid))
    assert(domain.read_pair(sh.read_only(),sh.read_only(),text_pair).unwrap())
    let another=domain.create(text,1)
    domain.write_pair(sh,another.handle(),text_swap,{}).unwrap()
    assert(!domain.read_from(sh.read_only(),text_valid).unwrap())
    assert(domain.read_from(another.read_handle(),text_valid).unwrap())
    assert(domain.read_snapshot(&frozen,sh.read_only(),text_valid))
    a.close(); b.close(); c.close()
    let closed=narrow(ah)
    assert(domain.read_from(closed,read).is_err())
    assert(domain.read_snapshot(&old,ar,inspect))
    24
}
fn main() @suspends {assert(lifecycle()==24)}
