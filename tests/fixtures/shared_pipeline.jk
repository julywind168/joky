import joky/array.{type Array}
import joky/check.{assert, panic}
import joky/iter
import joky/string.{type StringBuilder}

extern fn record(value: Int32) -> Int32
fn keep(value: &String) @noescape -> Bool {
    record(int32(string.byte_length(value)))
    value != ""
}
fn length(value: &String) @noescape -> UInt64 {
    record(100 + int32(string.byte_length(value)))
    string.byte_length(value)
}
fn copy_name(value: &String) @noescape -> String {
    record(100 + int32(value.byte_length()))
    value.clone()
}
fn long(value: UInt64) @noescape -> Bool { value > 3 }
struct Measure { size: UInt64, present: Bool }
fn measure(value: &String) @noescape -> Measure {
    Measure { size: string.byte_length(value), present: value != "" }
}
fn discard(value: &String) @noescape { }
fn failed_length(value: &String) @noescape -> UInt64 { panic("pipeline callback failed") }
fn failed_copy(value: &String) @noescape -> String { panic("pipeline callback failed") }
fn count<I: Copy + iter.SharedIterator>(values: I) -> UInt64 {
    iter.count_shared(values)
}
fn copy_first() -> String {
    let names = ["first", "second"]
    let copies = iter.shared(&names).map(|name| { name.clone() })
    let (next, first) = iter.step_shared(copies)
    let (_, second) = iter.step_shared(next)
    let (_, copied) = iter.step_shared(copies)
    names.release()
    assert(second! == "second" && copied! == "first", "independent copies of shared cursor")
    first!
}
fn compute() -> Int32 {
    var names = ["Alice", "", "Bob", "Carol"]
    assert(iter.shared(&names).filter(|name| { name != "" }).count() == 3, "filtered count")
    let tail = iter.shared(&names).filter(|name| { name != "" }).enumerate().skip(1).take(1)
    assert(tail.fold(false, |found, entry| {
        let (index, name) = entry
        found || (index == 1 && name == "Bob")
    }), "enumerate counts filtered items")
    assert(iter.shared(&names).take(0).fold(42, |acc, name| { assert(false, "empty fold"); acc }) == 42, "empty fold")
    let built = iter.shared(&names).take(1).fold(StringBuilder.new(), |var acc, name| {
        acc.push_str(name)
        acc
    })
    let text = built.finish()
    assert(text == "Alice", "owning accumulator")
    let suffix = "!"
    let built = iter.fold_shared(names.iter_shared(), StringBuilder.new(), |var acc, name| {
        acc.push_str(name)
        acc.push_str(&suffix)
        acc
    })
    suffix.release()
    let text = built.finish()
    assert(text == "Alice!!Bob!Carol!", "captured fold")
    assert(iter.fold_shared(names.iter_shared(), 0, |acc, name| { acc + int32(name.byte_length()) }) == 13, "shared fold")
    let digits = [1, 2, 3]
    assert(iter.shared(&digits).map(|n| { *n }).fold(0, |acc, n| { acc * 10 + n }) == 123, "ordered mapped fold")
    let mapped = iter.shared(&digits).skip(1).enumerate().map(|entry| {
        let (index, value) = entry
        int32(index) + *value
    })
    assert(mapped.fold(0, |sum, n| { sum + n }) == 6, "numbering starts after skip")
    let more_digits = [3, 4, 5]
    let chained = iter.shared(&digits).take(2).chain(iter.shared(&more_digits).skip(1))
    assert(chained.fold(0, |acc, n| { acc * 10 + *n }) == 1245, "shared chain order")
    var calls = 0
    assert(iter.shared(&digits).fold(0, |acc, n| { calls += 1; acc + *n }) == 6, "mutable fold capture")
    assert(calls == 3, "fold callback count")
    let values = iter.shared(&names).map(measure).take(1)
    for value in values { assert(value.size == 5 && value.present, "Copy record output") }
    assert(count(values) == 1, "shared state is Copy")
    assert(count(iter.shared(&names).map(discard)) == 4, "Unit output")
    assert(count(iter.shared(&names).take(0).map(failed_length)) == 0, "take zero is lazy")
    let scores = [10, 20]
    var total = 0
    for (name, score) in iter.shared(&names).zip(iter.shared(&scores)) {
        total += int32(string.byte_length(name)) + *score
    }
    assert(total == 35, "shared zip order and shorter side")
    let empty: Array<String> = []
    assert(count(iter.shared(&empty).map(measure).skip(1)) == 0, "empty pipeline")
    assert(copy_first() == "first", "owned item survives its source")
    let offset = 5
    let arrays = iter.shared(&digits).map(|n| { [*n + offset] }).skip(1).take(1)
    let strings = iter.shared(&names).map(|name| { name.clone() })
    let zipped_total = arrays.zip(strings).enumerate().fold(0, |acc, entry| {
        let (index, (array, text)) = entry
        assert(index == 0 && text == "Alice", "owning zip and enumerate")
        acc + array[0]
    })
    assert(zipped_total == 7 && strings.count() == 4, "owned fold and discard")
    names.push("last")
    assert(names.len() == 5, "pipeline does not consume source")
    42
}
fn lazy() -> Int32 {
    let names = ["Alice", "", "Bob", "Carol"]
    var total: UInt64 = 0
    for index, value in iter.shared(&names).filter(keep).map(length).take(2) {
        total += value + index
    }
    assert(total == 9, "indexed pipeline")
    for value in iter.shared(&names).map(length).filter(long).take(1) {
        assert(value == 5, "filter after map")
    }
    42
}
fn early() -> Int32 {
    let names = ["aa", "b", "ccc"]
    let other = ["unvisited"]
    let left = iter.shared(&names).map(copy_name).skip(1)
    for value in left.chain(iter.shared(&other).map(failed_copy)) { return int32(value.byte_length()) }
    0
}
fn failed() {
    let names = ["owned"]
    let left = iter.shared(&names).map(copy_name)
    let right = iter.shared(&names).map(failed_copy)
    for _ in left.zip(right) {}
}
fn main() { assert(compute() == 42 && lazy() == 42 && early() == 1, "shared pipeline") }
