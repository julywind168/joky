import joky/json/typed as typed.{type ToJson, type FromJson, type Context, type MappingError, type MappingErrorKind, type Options, type CodecError}
import joky/json as json.{type Value, type Number}
import joky/result.{type Result, Ok, Err}
import joky/option.{type Option}
import joky/check.{require}
import joky/array.{type Array}
import joky/map.{type Map}
import joky/integer
import joky/float
import joky/task

fn ensure(ok: Bool) { let message = "typed JSON contract" require(ok, &message) }
fn decoded<T: FromJson>(text: String) -> T {
    match typed.decode::<T>(&text) {
        | Ok(value) => value
        | Err(_) => { ensure(false) decoded::<T>("null") }
    }
}
fn encoded<T: ToJson>(value: &T) -> String {
    match typed.encode(value) { | Ok(text) => text | Err(_) => { ensure(false) "" } }
}
fn code(kind: MappingErrorKind) -> Int32 {
    match kind {
        | MissingField => 1 | UnknownField => 2 | ExpectedNumber => 3 | NotInteger => 4
        | OutOfRange => 5 | NonFinite => 6 | DepthLimit => 7 | NodeLimit => 8
        | StringLimit => 9 | NumberLimit => 10 | InvalidLimits => 11 | DuplicateField => 12
        | ExpectedString => 13 | ExpectedObject => 14 | ExpectedArray => 15 | CallLimit => 16
        | ExpectedNull => 17 | ExpectedBoolean => 18
    }
}
fn mapping(error: CodecError, expected: Int32, path: String) {
    match error {
        | Mapping(error) => { ensure(code(error.kind) == expected) ensure(error.pointer().equals(&path)) }
        | _ => { ensure(false) }
    }
}
fn bad<T: FromJson>(text: String, expected: Int32, path: String) {
    match typed.decode::<T>(&text) { | Err(error) => mapping(error, expected, path) | Ok(_) => { ensure(false) } }
}
fn limited<T: ToJson>(value: &T, options: Options, expected: Int32, path: String) {
    match typed.encode_with_options(value, options) { | Err(error) => mapping(error, expected, path) | Ok(_) => { ensure(false) } }
}
fn main() {
    bad::<Map<String, UInt8>>("{{\"a~/你\":300}}", 5, "/a~0~1你")
    bad::<Map<String, UInt8>>("{{\"\":300}}", 5, "/")
    bad::<Array<UInt8>>("[0,1,300]", 5, "/2")
    bad::<Array<UInt8>>("{{}}", 15, "")
    bad::<Bool>("0", 18, "") bad::<Unit>("false", 17, "")
    let unit = decoded::<Unit>("null") ensure(encoded(&unit).byte_length() == 4)
    ensure(decoded::<Bool>("true")) ensure(!decoded::<Bool>("false"))
    let number = decoded::<Number>("-0.1200E+004")
    let text = "-0.1200E+004" ensure(encoded(&number).equals(&text))

}
