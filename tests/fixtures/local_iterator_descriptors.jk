import joky/array.{type Array}
import joky/slice
import joky/iter.{type Iter}

extern fn delayed_value(value: Int32) @suspends -> Int32
extern fn fail_now() @suspends

fn forwarded(values: &Array<Int32>) -> &Iter<Int32> { values.iter() }
fn current(cursor: &Iter<Int32>) -> &Int32 { iter.current(cursor) }

fn alias_loop() -> Int32 {
    let values = [10, 20, 12]
    var round = 0
    while round < 512 {
        let cursor = forwarded(&values)
        let alias = cursor
        if !iter.advance(alias) { return 0 }
        let saved = current(cursor)
        if !iter.advance(cursor) { return 0 }
        if *saved != 10 || *current(alias) != 20 { return 0 }
        var total = 30
        for value in cursor { total += *value }
        if total != 42 || iter.advance(alias) || iter.advance(cursor) { return 0 }

        round += 1
    }
    42
}

fn independent_loop() -> Int32 {
    let values = [10, 20, 12]
    var round = 0
    while round < 512 {
        let view = values.slice(1, 3)
        let left = slice.iter(view)
        let right = slice.iter(view)
        if !iter.advance(left) || !iter.advance(right) || !iter.advance(left) { return 0 }
        if *current(left) != 12 || *current(right) != 20 { return 0 }

        round += 1
    }
    42
}

fn mutable_loop() -> Int32 {
    var changed = [0, 0]
    var round = 0
    while round < 512 {
        let mutable = changed.iter_mut()
        for value in &mut *mutable { *value += 1; break }
        if !iter.advance(mutable) { return 0 }
        *iter.current_mut(mutable) += 1
        for value in slice.iter_mut(changed.slice_mut(1, 2)) { *value += 1 }

        round += 1
    }
    if changed.get(0).unwrap_or(0) == 512 && changed.get(1).unwrap_or(0) == 512 * 2 { 42 } else { 0 }
}

fn empty_zst_loop() -> Int32 {
    let empty = Array.new::<Int32>()
    let units = [{}, {}, {}]
    var round = 0
    while round < 512 {
        var count = 0
        for _ in empty.iter() { count += 100 }
        for _ in slice.iter(units.slice(0, 3)) { count += 1 }
        if count != 3 { return 0 }
        round += 1
    }
    42
}

fn descriptor_loop() -> Int32 {
    if alias_loop() != 42 || independent_loop() != 42 || mutable_loop() != 42 || empty_zst_loop() != 42 { return 0 }
    payload_loop()
}

fn descriptor_previous() -> Int32 {
    let values = [20, 22, 99]
    var previous = values.iter()
    iter.advance(previous)
    iter.advance(previous)
    var round = 0
    var sum = 0
    while round < 2 {
        let next = values.iter()
        sum += *current(previous)
        iter.advance(next)
        previous = next
        iter.advance(previous)
        round += 1
    }
    if sum == 44 { 42 } else { 0 }
}

fn selected(values: &Array<Int32>, skip: Bool) -> &Iter<Int32> {
    let cursor = values.iter()
    if skip { iter.advance(cursor); }
    cursor
}

fn element(values: &Array<Int32>) -> &Int32 {
    let cursor = values.iter()
    iter.advance(cursor)
    current(cursor)
}

fn payload_loop() -> Int32 {
    let values = [42]
    var round = 0
    while round < 512 {
        if *element(&values) != 42 { return 0 }
        round += 1
    }
    42
}

fn descriptor_escape_loop() -> Int32 {
    let values = [42]
    var round = 0
    while round < 512 {
        let cursor = selected(&values, true)
        if *current(cursor) != 42 { return 0 }
        round += 1
    }
    42
}

fn from_range(values: &Array<Int32>) -> &Iter<Int32> {
    let view = values.slice(1, 2)
    slice.iter(view)
}

fn descriptor_returned() -> Int32 {
    let values = [20, 22, 99]
    let saved = element(&values)
    let left = selected(&values, true)
    let right = selected(&values, false)
    if !iter.advance(left) || !iter.advance(right) { return 0 }
    if *current(left) != 22 || *current(right) != 20 { return 0 }
    let ranged = from_range(&values)
    if !iter.advance(ranged) { return 0 }
    *saved + *current(ranged)
}

fn descriptor_suspend() @suspends -> Int32 {
    var values = [0, 0]
    var round = 0
    while round < 3 {
        let view = values.slice_mut(0, 2)
        let cursor = slice.iter_mut(view)
        if !iter.advance(cursor) { return 0 }
        let first = iter.current_mut(cursor)
        let one = delayed_value(0)
        *first = 20 + one
        if !iter.advance(cursor) { return 0 }
        *iter.current_mut(cursor) = 21
        if iter.advance(cursor) { return 0 }
        round += 1
    }
    values.get(0).unwrap_or(0) + values.get(1).unwrap_or(0)
}

fn descriptor_failure() @suspends -> Int32 {
    let values = ["owner", "cleanup"]
    let cursor = values.iter()
    iter.advance(cursor)
    delayed_value(0)
    fail_now()
    if iter.advance(cursor) { 42 } else { 0 }
}

fn descriptor_bounds() @suspends -> Int32 {
    let values = [42]
    let cursor = values.iter()
    delayed_value(0)
    *current(cursor)
}

fn descriptor_layout() -> Int32 {
    let values = [42]
    let cursor = values.iter()
    iter.advance(cursor)
    *current(cursor)
}
