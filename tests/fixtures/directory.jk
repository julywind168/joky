import joky/domain
import joky/array.{type Array}
import joky/check
import joky/task

struct Room { value:Int32 }
fn make(value:Int32)->Room { Room{value:value} }
fn read(room:&Room)->Int32 { room.value }
fn update(room:&mut Room,value:Int32)->Int32 { room.value=value value }
fn witness(room:&Room)->Int32 { let message="lookup must not invoke witness" check.assert(false,&message) room.value }
fn assert(ok:Bool) { let message="directory routing" check.assert(ok,&message) }
fn value(directory:domain.DirectoryHandle,key:UInt64) @suspends ->Int32 {
    match domain.lookup(directory,key,read) { Some(room)=>domain.read_from(room,read),None=>-1 }
}
fn route() @suspends {
    let table=domain.directory(2)
    let directory=table.handle()
    let first=domain.create(make,10)
    let second=domain.create(make,20)
    let a=first.handle()
    let b=second.handle()
    let old=a.read_only()
    assert(domain.lookup(directory,7,read).is_none())
    assert(directory.insert(7,a).is_ok())
    assert(domain.lookup(directory,7,witness).is_some())
    assert(match directory.insert(7,b) { Err(Occupied)=>true,_=>false })
    assert(value(directory,7)==10)
    assert(directory.insert_read(9,b.read_only()).is_ok())
    assert(domain.lookup_write(directory,9,read).is_none())
    assert(match directory.insert(11,b) { Err(Full)=>true,_=>false })
    assert(match directory.replace(7,b.read_only(),b) { Err(Conflict)=>true,_=>false })
    assert(directory.replace(7,old,b).is_ok())
    // A stale connection cleanup cannot remove the replacement room route.
    assert(!directory.remove(7,old))
    assert(value(directory,7)==20)
    match domain.lookup_write(directory,7,read) {
        Some(room)=>assert(domain.write_to(room,update,42)==42)
        None=>assert(false)
    }
    assert(value(directory,9)==42)
    assert(directory.replace_read(7,b.read_only(),old).is_ok())
    assert(domain.lookup_write(directory,7,read).is_none())
    assert(directory.remove(7,old))
    assert(domain.lookup(directory,7,read).is_none())
    second.close()
    assert(domain.lookup(directory,9,read).is_none())
    assert(match directory.insert(12,b) { Err(InvalidTarget)=>true,_=>false })
    // Closed routes not explicitly looked up also release capacity on insertion.
    let third=domain.create(make,30)
    assert(directory.insert(5,third.handle()).is_ok())
    assert(directory.insert(6,third.handle()).is_ok())
    third.close()
    assert(directory.insert(8,a).is_ok())
    table.close()
    assert(value(directory,8)==-1)
    assert(match directory.insert(8,a) { Err(Closed)=>true,_=>false })
    assert(!directory.remove(8,old))
    assert(domain.read_from(old,read)==10)
}
fn weak() @suspends {
    let table=domain.directory(1)
    let directory=table.handle()
    { let room=domain.create(make,1) assert(directory.insert(1,room.handle()).is_ok()) }
    assert(domain.lookup(directory,1,read).is_none())
    let room=domain.create(make,2)
    let dangling={ let other=domain.directory(1) let h=other.handle() assert(h.insert(1,room.handle()).is_ok()) h }
    assert(domain.lookup(dangling,1,read).is_none())
    assert(domain.read_from(room.read_handle(),read)==2)
}
struct Catalog { values:Array<Int32> }
fn catalog(value:Int32)->Catalog { var values=Array.new::<Int32>() values.push(value) Catalog{values:values} }
fn first(catalog:&Catalog)->Int32 { catalog.values.get(0).unwrap_or(-1) }
fn owned() @suspends {
    let table=domain.directory(1)
    let state=domain.create(catalog,73)
    assert(table.handle().insert_read(1,state.read_handle()).is_ok())
    match domain.lookup(table.handle(),1,first) {
        Some(handle)=>assert(domain.read_from(handle,first)==73)
        None=>assert(false)
    }
}
fn main() @suspends ->Int32 { route() task.yield_now() weak() owned() println("directory ok") 0 }
