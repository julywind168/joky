fn manage_truncate_failure() -> Int32 {
    var values = Array.new::<Failing>()
    values.push(Failing { id: 1, values: Array.new::<Int32>() })
    values.push(Failing { id: 2, values: Array.new::<Int32>() })
    values.push(Failing { id: 3, values: Array.new::<Int32>() })
