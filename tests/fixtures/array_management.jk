import joky/array.{type Array}
import joky/fixed_array.{type FixedArray}
import management_library.{shorten, empty, exchange}
extern fn record_drop(value: Int32)
struct Resource { id: Int32, values: Array<Int32> }

fn resource(id: Int32) -> Resource {
    let result = Resource { id: id, values: Array.new::<Int32>() }
    record_drop(-id)
    result
}
fn manage_copy() -> Int32 {
    var values = Array.with_capacity::<UInt64>(8)
    if values.swap(0, 0) { return 0 }
    values.clear(); values.truncate(18446744073709551615)
    values.push(18446744073709551615); values.push(20); values.push(42)
    if !array.swap(&mut values, 0, 2) || values.get(2).unwrap_or(0) != 18446744073709551615 { return 0 }
    if !values.swap(1, 1) || values.get(1).unwrap_or(0) != 20 { return 0 }
    if values.swap(0, 3) || values.swap(3, 0) || values.swap(18446744073709551615, 18446744073709551615) { return 0 }
    values.truncate(3); shorten(&mut values, 4); values.truncate(18446744073709551615)
    if values.len() != 3 || values.capacity() != 8 { return 0 }
    array.truncate(&mut values, 1)
    let result = int32(values.get(0).unwrap_or(0))
    empty(&mut values)
    if !values.is_empty() || values.capacity() != 8 { return 0 }
    values.clear(); values.push(20); values.push(22)
    if values.len() == 2 && values.capacity() == 8 { result } else { 0 }
}
fn manage_append() -> Int32 {
    var values = Array.with_capacity::<String>(4)
    var other = Array.with_capacity::<String>(3)
    values.append(&mut other)
    if !values.is_empty() || values.capacity() != 4 || other.capacity() != 3 { return 0 }

    other.push("first")
    array.append(&mut values, &mut other)
    if !other.is_empty() || other.capacity() != 3 { return 0 }
    other.push("second")
    other.push("third")
    values.append(&mut other)
    if !other.is_empty() || other.capacity() != 3 { return 0 }
    other.release()

    if values.len() != 3 || values.capacity() != 4 { return 0 }
    if values.borrow_ref(0) != "first" || values.borrow_ref(1) != "second" || values.borrow_ref(2) != "third" { return 0 }
    42
}

fn manage_extend() -> Int32 {
    var values = Array.with_capacity::<Int32>(1)
    values.push(10)
    let source = [99, 20, 22, 99]
    values.extend(&source[..0])
    if values.len() != 1 || values.capacity() != 1 { return 0 }

    values.extend(&source[1..3])
    if values.len() != 3 || values.capacity() < 3 || values[0] != 10 { return 0 }
    if values[1] != 20 || values[2] != 22 || source[1] != 20 || source[2] != 22 { return 0 }
    array.extend(&mut values, &source[3..])
    if values.len() != 4 || values[3] != 99 || source.len() != 4 { return 0 }
    let fixed: FixedArray<Int32, 2> = [17, 19]
    values.extend(&fixed[..])
    if values.len() != 6 || values[4] != 17 || values[5] != 19 || fixed[0] != 17 { return 0 }
    42
}
fn manage_owned() -> Int32 {
    var values = Array.with_capacity::<Resource>(4)
    values.push(resource(1)); values.push(resource(2)); values.push(resource(3))
    values.truncate(3); values.truncate(4); values.truncate(18446744073709551615)
    if !values.swap(1, 1) { return 0 }
    if !exchange(&mut values, 0, 2) { return 0 }
    if values.swap(0, 3) || values.swap(3, 0) { return 0 }
    if values.borrow_ref(0).id != 3 || values.borrow_ref(2).id != 1 { return 0 }
    shorten(&mut values, 1)
    if values.borrow_ref(0).id != 3 || values.capacity() != 4 { return 0 }
    empty(&mut values)
    values.clear()
    values.push(resource(4))
    values.borrow_ref(0).id + 38
}
fn manage_enum_tuple() -> Int32 {
    var values = Array.new::<Option<(Resource, Resource)>>()
    values.push(Some((resource(1), resource(2)))); values.push(None)
    values.swap(0, 1)
    values.truncate(1)
    if !values.pop().unwrap_or(None).is_none() { return 0 }
    values.clear()
    42
}
fn manage_wrapper() -> Int32 {
    var values = Array.new::<Array<Int32>>()
    var a = Array.new::<Int32>(); a.push(20)
    var b = Array.new::<Int32>(); b.push(22)
    values.push(a); values.push(b)
    values.swap(0, 1)
    let result = values.borrow_ref(0).get(0).unwrap_or(0) + values.borrow_ref(1).get(0).unwrap_or(0)
    values.truncate(1); values.clear()
    result
}
struct Pair { a: UInt64, b: Bool, c: Unit }
fn manage_zero_and_aggregate() -> Int32 {
    var zero = Array.new::<Unit>()
    var other = Array.with_capacity::<Unit>(2)
    zero.push({}); other.push({})
    zero.append(&mut other)
    if zero.len() != 2 || !other.is_empty() || other.capacity() != 2 { return 0 }
    other.push({})
    zero.extend(&other[..])
    if zero.len() != 3 || other.len() != 1 { return 0 }
    if !zero.swap(0, 1) || !zero.swap(1, 1) || zero.swap(0, 3) { return 0 }
    zero.truncate(1); zero.clear()
    if zero.swap(0, 0) { return 0 }
    var values = Array.new::<Pair>()
    values.push(Pair { a: 18446744073709551615, b: false, c: {} })
    let source = [Pair { a: 42, b: true, c: {} }]
    values.extend(&source[..])
    values.swap(0, 1)
    if values.get(1).unwrap_or(Pair { a: 0, b: true, c: {} }).b { return 0 }
    values.truncate(1)
    let result = int32(values.get(0).unwrap_or(Pair { a: 0, b: false, c: {} }).a)
    values.clear()
    result
}
fn manage_references() -> Int32 {
    var values = Array.new::<&Int32>()
    var other = Array.new::<&Int32>()
    values.push((&*(alloc(20)))); other.push((&*(alloc(22))))
    values.append(&mut other)
    other.extend(&values[..1])
    let copied = other[0]
    other.release()
    if *copied != 20 || values.len() != 2 { return 0 }
    values.swap(0, 1)
    let a = values.get(0)
    let b = values.get(1)
    values.truncate(1); values.clear(); values.release()
    match a { Some(x) => match b { Some(y) => (*x) + (*y), None => 0 }, None => 0 }
}
struct Failing { id: Int32, values: Array<Int32> }

fn manage_clear_failure() -> Int32 {
    var values = Array.new::<Failing>()
    values.push(Failing { id: 1, values: Array.new::<Int32>() })
    values.push(Failing { id: 2, values: Array.new::<Int32>() })
    values.push(Failing { id: 3, values: Array.new::<Int32>() })
    values.clear()
    42
}
fn manage_truncate_failure() -> Int32 {
    var values = Array.new::<Failing>()
    values.push(Failing { id: 1, values: Array.new::<Int32>() })
    values.push(Failing { id: 2, values: Array.new::<Int32>() })
    values.push(Failing { id: 3, values: Array.new::<Int32>() })
    values.truncate(2)
    42
}
fn manage_budget() -> Int32 {
    var values = Array.with_capacity::<Array<Int32>>(1)
    var round = 0
    while round < 96 {
        values.push(Array.with_capacity::<Int32>(262144))
        if (round & 1) == 0 { values.truncate(0) } else { values.clear() }
        if values.len() != 0 || values.capacity() != 1 { return 0 }
        round = round + 1
    }
    42
}
fn manage_evaluation() -> Int32 {
    var values = Array.new::<Int32>()
    values.push(42); values.push(20)
    values.swap({ record_drop(10); 0 }, { record_drop(20); 1 })
    values.truncate({ record_drop(30); 1 })
    let result = values.pop().unwrap_or(0) + 22
    values.clear()
    result
}
fn manage_transitions() -> Int32 {
    var values = Array.with_capacity::<Resource>(1)
    var other = Array.with_capacity::<Resource>(2)
    values.push(resource(1)); other.push(resource(2)); other.push(resource(3))
    values.append(&mut other)
    if values.len() != 3 || !other.is_empty() || other.capacity() != 2 { return 0 }
    values.swap(0, 2)
    values.truncate(1)
    values.push(resource(4))
    if values.borrow_ref(0).id != 3 || values.borrow_ref(1).id != 4 { return 0 }
    record_drop(-90)
    values.clear()
    values.clear()
    42
}
fn manage_task() @suspends -> Int32 {
    if manage_extend() != 42 { return 0 }
    manage_transitions()
}
