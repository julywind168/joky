fn manage_budget() -> Int32 {
    var values = Array.with_capacity::<Array<Int32>>(1)
    var round = 0
    while round < 96 {
        values.push(Array.with_capacity::<Int32>(262144))
        if (round & 1) == 0 { values.truncate(0) } else { values.clear() }
        if values.len() != 0 || values.capacity() != 1 { return 0 }
        round = round + 1
    }
    42
}
fn manage_evaluation() -> Int32 {
    var values = Array.new::<Int32>()
    values.push(42) values.push(20)
    values.swap({ record_drop(10) 0 }, { record_drop(20) 1 })
    values.truncate({ record_drop(30) 1 })
    let result = values.pop().unwrap_or(0) + 22
    values.clear()
    result
}
fn manage_transitions() -> Int32 {
    var values = Array.new::<Resource>()
    values.push(resource(1)) values.push(resource(2)) values.push(resource(3))
    values.swap(0, 2)
    values.truncate(1)
    values.push(resource(4))
    if values.borrow_ref(0).id != 3 || values.borrow_ref(1).id != 4 { return 0 }
    record_drop(-90)
    values.clear()
    values.clear()
