import joky/tcp.{type Address, type TcpListener, type TcpStream, type BufferedTcp, type IoError, type ReadError, type Shutdown}
import joky/array.{type Array}
import joky/string
import joky/result.{type Result}
import joky/check.{assert}
import joky/task

fn ensure(ok: Bool) { let message = "TCP exact, delimited and UTF-8 reads"; assert(ok, &message) }
fn bytes(text: String) -> Array<UInt8> { text.into_bytes() }
fn pair() @suspends -> Result<(TcpStream, TcpStream), IoError> {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return Result.Err(error) } }
    let address = match listener.local_addr() { Ok(address) => address, Err(error) => { return Result.Err(error) } }
    let stream = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { return Result.Err(error) } }
    let peer = match listener.accept() { Ok(stream) => stream, Err(error) => { return Result.Err(error) } }
    Result.Ok((stream, peer))
}
fn reader(data: Array<UInt8>, capacity: UInt64) @suspends -> Result<BufferedTcp, ReadError> {
    let (stream, peer) = match pair() { Ok(pair) => pair, Err(error) => { return Result.Err(ReadError.Io(error)) } }
    var peer = peer
    match peer.write_all(data) { Ok(_) => {}, Err(error) => { return Result.Err(ReadError.Io(error)) } }
    match peer.shutdown(Shutdown.Write) { Ok(_) => {}, Err(error) => { return Result.Err(ReadError.Io(error)) } }
    BufferedTcp.with_capacity(stream, capacity)
}
fn expect_line(buffered: &mut BufferedTcp, limit: UInt64, expected: String) @suspends {
    let line = match buffered.read_line(limit) { Ok(Some(line)) => line, _ => { ensure(false); return } }
    ensure(line.equals(&expected))
}
fn exact() @suspends -> Int32 {
    var buffered = match reader(bytes("12345"), 2) { Ok(b) => b, _ => { return 1 } }
    match buffered.read_exact(1048577) { Err(InvalidLimit) => {}, _ => { return 2 } }
    let empty = match buffered.read_exact(0) { Ok(Some(data)) => data, _ => { return 3 } }
    ensure(empty.is_empty() && !buffered.is_eof())
    let first = match buffered.read_exact(3) { Ok(Some(data)) => data, _ => { return 4 } }
    ensure(first.len() == 3 && first.get(0).unwrap_or(0) == 49 && first.get(2).unwrap_or(0) == 51)
    let second = match buffered.read_exact(2) { Ok(Some(data)) => data, _ => { return 5 } }
    ensure(second.len() == 2 && second.get(0).unwrap_or(0) == 52 && second.get(1).unwrap_or(0) == 53)
    match buffered.read_exact(1) { Ok(None) => {}, _ => { return 6 } }
    match buffered.read_exact(1048576) { Ok(None) => {}, _ => { return 11 } }
    ensure(buffered.is_eof())
    let zero = match buffered.read_exact(0) { Ok(Some(data)) => data, _ => { return 7 } }
    ensure(zero.is_empty())
    var truncated = match reader(bytes("xy"), 1) { Ok(b) => b, _ => { return 8 } }
    match truncated.read_exact(3) { Err(UnexpectedEof(count)) => { ensure(count == 2) }, _ => { return 9 } }
    match truncated.read_exact(1) { Ok(None) => {}, _ => { return 10 } }
    42
}
fn delimited() @suspends -> Int32 {
    var buffered = match reader(bytes("a;b;\0;c"), 16) { Ok(b) => b, _ => { return 1 } }
    match buffered.read_until(59, 0) { Err(InvalidLimit) => {}, _ => { return 2 } }
    match buffered.read_until(59, 1048577) { Err(InvalidLimit) => {}, _ => { return 3 } }
    let first = match buffered.read_until(59, 2) { Ok(Some(data)) => data, _ => { return 4 } }
    ensure(first.len() == 2 && first.get(0).unwrap_or(0) == 97 && first.get(1).unwrap_or(0) == 59)
    let before = buffered.buffered_len()
    match buffered.read_until(59, 0) { Err(InvalidLimit) => {}, _ => { return 5 } }
    ensure(buffered.buffered_len() == before)
    let second = match buffered.read_until(59, 2) { Ok(Some(data)) => data, _ => { return 6 } }
    ensure(second.len() == 2 && second.get(0).unwrap_or(0) == 98 && second.get(1).unwrap_or(0) == 59)
    let nul = match buffered.read_until(0, 1) { Ok(Some(data)) => data, _ => { return 7 } }
    ensure(nul.len() == 1 && nul.get(0).unwrap_or(1) == 0)
    let separator = match buffered.read_until(59, 1) { Ok(Some(data)) => data, _ => { return 8 } }
    ensure(separator.len() == 1 && separator.get(0).unwrap_or(0) == 59)
    match buffered.read_until(59, 2) { Err(UnexpectedEof(count)) => { ensure(count == 1) }, _ => { return 9 } }
    match buffered.read_until(59, 1) { Ok(None) => {}, _ => { return 10 } }
    var fragmented = match reader(bytes("123456\n"), 2) { Ok(b) => b, _ => { return 11 } }
    let frame = match fragmented.read_until(10, 1048576) { Ok(Some(data)) => data, _ => { return 12 } }
    ensure(frame.len() == 7 && frame.get(5).unwrap_or(0) == 54 && frame.get(6).unwrap_or(0) == 10)
    var bounded = match reader(bytes("abcd\nz\n"), 2) { Ok(b) => b, _ => { return 13 } }
    match bounded.read_until(10, 4) { Err(LimitExceeded) => {}, _ => { return 14 } }
    // Deliberate recovery: discard the known remainder, then verify the next frame.
    let suffix = match bounded.read_until(10, 1) { Ok(Some(data)) => data, _ => { return 15 } }
    ensure(suffix.len() == 1 && suffix.get(0).unwrap_or(0) == 10)
    expect_line(&mut bounded, 2, "z")
    42
}
fn lines() @suspends -> Int32 {
    var buffered = match reader(bytes("你好\r\n\nlast\n\rX\n"), 1) { Ok(b) => b, _ => { return 1 } }
    expect_line(&mut buffered, 8, "你好")
    expect_line(&mut buffered, 1, "")
    expect_line(&mut buffered, 5, "last")
    expect_line(&mut buffered, 1048576, "\rX")
    match buffered.read_line(8) { Ok(None) => {}, _ => { return 2 } }
    match buffered.read_line(0) { Err(InvalidLimit) => {}, _ => { return 3 } }
    var truncated = match reader(bytes("last"), 2) { Ok(b) => b, _ => { return 4 } }
    match truncated.read_line(5) { Err(UnexpectedEof(count)) => { ensure(count == 4) }, _ => { return 5 } }
    var overlong = match reader(bytes("a\r\n"), 1) { Ok(b) => b, _ => { return 6 } }
    match overlong.read_line(2) { Err(LimitExceeded) => {}, _ => { return 7 } }
    var invalid = Array.new::<UInt8>()
    invalid.push(97)
    invalid.push(255)
    invalid.push(10)
    invalid.push(195)
    invalid.push(10)
    invalid.push(111)
    invalid.push(107)
    invalid.push(10)
    var errors = match reader(invalid, 2) { Ok(b) => b, _ => { return 8 } }
    match errors.read_line(3) {
        Err(InvalidUtf8(error)) => {
            ensure(error.offset == 1)
            match error.code { InvalidSequence => {}, _ => { return 9 } }
        }
        _ => { return 10 }
    }
    match errors.read_line(2) {
        Err(InvalidUtf8(error)) => {
            ensure(error.offset == 0)
            match error.code { UnexpectedEnd => {}, _ => { return 11 } }
        }
        _ => { return 12 }
    }
    expect_line(&mut errors, 3, "ok")
    42
}
fn wait(buffered: &mut BufferedTcp, mode: UInt64) @suspends {
    if mode == 0 { buffered.read_exact(3); }
    else { if mode == 1 { buffered.read_until(10, 3); } else { buffered.read_line(3); } }
}
fn pending(mode: UInt64) @suspends -> Int32 {
    let (stream, peer) = match pair() { Ok(pair) => pair, _ => { return 1 } }
    var peer = peer
    ensure(peer.write_all(bytes("x")).is_ok())
    var buffered = BufferedTcp.new(stream)
    wait(&mut buffered, mode)
    peer.close();
    42
}
fn pending_exact() @suspends -> Int32 { pending(0) }
fn pending_until() @suspends -> Int32 { pending(1) }
fn pending_line() @suspends -> Int32 { pending(2) }
fn cancel() @suspends -> Int32 {
    var mode: UInt64 = 0
    while mode < 3 {
        let (stream, peer) = match pair() { Ok(pair) => pair, _ => { return 1 } }
        var peer = peer
        ensure(peer.write_all(bytes("x")).is_ok())
        var buffered = BufferedTcp.new(stream)
        race { wait(&mut buffered, mode), task.sleep_ms(1) }
        ensure(buffered.buffered_len() <= buffered.capacity())
        ensure(buffered.close().is_ok())
        ensure(peer.close().is_ok())
        mode = mode + 1
    }
    42
}
fn main() @suspends -> Int32 {
    ensure(exact() == 42)
    ensure(delimited() == 42)
    ensure(lines() == 42)
    ensure(cancel() == 42)
    ensure(streaming() == 42)
    0
}

// A short path for instruction-by-instruction ownership/cancellation coverage.
fn sweep() @suspends -> Int32 {
    var data = bytes("\0;ok\n")
    data.push(255)
    data.push(10)
    data.push(122)
    var buffered = match reader(data, 2) { Ok(b) => b, _ => { return 1 } }
    let head = match buffered.read_exact(1) { Ok(Some(data)) => data, _ => { return 2 } }
    ensure(head.len() == 1 && head.get(0).unwrap_or(1) == 0)
    let separator = match buffered.read_until(59, 1) { Ok(Some(data)) => data, _ => { return 3 } }
    ensure(separator.len() == 1)
    expect_line(&mut buffered, 3, "ok")
    match buffered.read_line(2) { Err(InvalidUtf8(_)) => {}, _ => { return 4 } }
    match buffered.read_exact(2) { Err(UnexpectedEof(count)) => { ensure(count == 1) }, _ => { return 5 } }
    match buffered.read_line(1) { Ok(None) => {}, _ => { return 6 } }
    ensure(buffered.close().is_ok())
    42
}

fn produce(peer: &mut TcpStream) @suspends {
    ensure(peer.write_all(bytes("abc")).is_ok())
    task.sleep_ms(2)
    ensure(peer.write_all(bytes("de\n")).is_ok())
    var prefix = Array.new::<UInt8>()
    prefix.push(228)
    prefix.push(189)
    ensure(peer.write_all(prefix).is_ok())
    task.sleep_ms(2)
    var suffix = Array.new::<UInt8>()
    suffix.push(160)
    suffix.push(13)
    suffix.push(10)
    suffix.push(10)
    ensure(peer.write_all(suffix).is_ok())
    ensure(peer.shutdown(Shutdown.Write).is_ok())
}
fn consume(buffered: &mut BufferedTcp) @suspends {
    let exact = match buffered.read_exact(5) { Ok(Some(data)) => data, _ => { ensure(false); return } }
    ensure(exact.len() == 5 && exact.get(2).unwrap_or(0) == 99 && exact.get(4).unwrap_or(0) == 101)
    let end = match buffered.read_until(10, 1) { Ok(Some(data)) => data, _ => { ensure(false); return } }
    ensure(end.len() == 1 && end.get(0).unwrap_or(0) == 10)
    expect_line(buffered, 5, "你")
    expect_line(buffered, 1, "")
    match buffered.read_line(1) { Ok(None) => {}, _ => { ensure(false) } }
}
fn streaming() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, _ => { return 1 } }
    let address = match listener.local_addr() { Ok(address) => address, _ => { return 2 } }
    let stream = match TcpStream.connect(address) { Ok(stream) => stream, _ => { return 3 } }
    var peer = match listener.accept() { Ok(stream) => stream, _ => { return 4 } }
    var buffered = match BufferedTcp.with_capacity(stream, 2) { Ok(b) => b, _ => { return 2 } }
    join { consume(&mut buffered), produce(&mut peer) }
    ensure(buffered.close().is_ok())
    ensure(peer.close().is_ok())
    42
}
