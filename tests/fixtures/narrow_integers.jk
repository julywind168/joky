// N4 narrow integers: Int8/Int16/UInt16 literals, wrapping arithmetic, shift
// bounds, sign/zero extension through conversions, arrays and checked bridges.
import joky/array.{type Array}

fn signed8() -> Int32 {
    if Int8.MIN != -128 || Int8.MAX != 127 { return 1 }
    let min: Int8 = -128
    let max: Int8 = 127
    if min + max != -1 { return 2 }
    if min - 1 != 127 { return 3 }
    if max + 1 != -128 { return 4 }
    if min * 2 != 0 { return 5 }
    if min * min != 0 { return 6 }
    // MIN / -1 wraps to MIN instead of trapping.
    if min / -1 != -128 { return 7 }
    if -min != -128 { return 8 }
    if ~min != 127 { return 9 }
    if min << 7 != 0 { return 10 }
    if min >> 7 != -1 { return 11 }
    if (max << 1) != -2 { return 12 }
    return_shifts(max, min)
}

fn return_shifts(max: Int8, min: Int8) -> Int32 {
    if max >> 1 != 63 { return 13 }
    if min >> 1 != -64 { return 14 }
    0
}

fn signed16() -> Int32 {
    if Int16.MIN != -32768 || Int16.MAX != 32767 { return 1 }
    let min: Int16 = -32768
    if min - 1 != 32767 { return 2 }
    if min / -1 != -32768 { return 3 }
    if ~min != 32767 { return 4 }
    if min << 15 != 0 { return 5 }
    if min >> 15 != -1 { return 6 }
    0
}

fn unsigned16() -> Int32 {
    if UInt16.MIN != 0 || UInt16.MAX != 65535 { return 1 }
    let max: UInt16 = 65535
    if max + 1 != 0 { return 2 }
    if max * 2 != 65534 { return 3 }
    if max >> 15 != 1 { return 4 }
    if ~max != 0 { return 5 }
    if max / 3 != 21845 { return 6 }
    0
}

// Extension keeps the sign for signed lanes and zeroes for unsigned ones.
fn extension() -> Int32 {
    let neg: Int8 = -1
    if int64(neg) != -1 { return 1 }
    let neg16: Int16 = -300
    if int32(neg16) != -300 { return 2 }
    let byte: UInt8 = 255
    if int64(byte) != 255 { return 3 }
    let word: UInt16 = 65535
    if int32(word) != 65535 { return 4 }
    if uint64(word) != 65535 { return 5 }
    // Narrowing keeps low bits, then the target type reinterprets them.
    if int8(word) != -1 { return 6 }
    if int16(uint64(70000)) != 4464 { return 7 }
    if uint8(-1) != 255 { return 8 }
    if uint16(-2) != 65534 { return 9 }
    0
}

fn checked_bridges() -> Int32 {
    let low: Int8 = -40
    if low.to_u8().is_some() { return 1 }
    if low.to_i16().unwrap_or(0) != -40 { return 2 }
    let word: UInt16 = 40000
    if word.to_i16().is_some() { return 3 }
    if word.to_u32().unwrap_or(0) != 40000 { return 4 }
    let high: Int16 = 32767
    if high.to_i8().is_some() { return 5 }
    if high.to_u16().unwrap_or(0) != 32767 { return 6 }
    if 127.5.round_to_i8().is_some() { return 7 }
    if 127.4.round_to_i8().unwrap_or(0) != 127 { return 12 }
    if 65535.5.round_to_u16().is_some() { return 8 }
    if (-1.5).trunc_to_i16().unwrap_or(0) != -1 { return 9 }
    if float64(Int8.MIN) != -128.0 { return 10 }
    if 65535.0.trunc_to_u16().unwrap_or(0) != 65535 { return 11 }
    0
}

fn arrays() -> Int32 {
    var bytes = Array.new::<Int8>()
    bytes.push(-128)
    bytes.push(127)
    if bytes.len() != 2 { return 1 }
    if bytes.get(0).unwrap_or(0) != -128 { return 2 }
    if bytes.get(1).unwrap_or(0) != 127 { return 3 }
    var words = Array.new::<UInt16>()
    words.push(65535)
    words.push(0)
    if words.len() != 2 { return 4 }
    if words.get(0).unwrap_or(1) != 65535 { return 5 }
    if words.get(1).unwrap_or(1) != 0 { return 6 }
    if !(words.get(0).unwrap_or(1) > 65534) { return 7 }
    0
}

fn main() -> Int32 {
    let a = signed8()
    if a != 0 { return a }
    let b = signed16()
    if b != 0 { return 100 + b }
    let c = unsigned16()
    if c != 0 { return 200 + c }
    let d = extension()
    if d != 0 { return 300 + d }
    let e = checked_bridges()
    if e != 0 { return 400 + e }
    let f = arrays()
    if f != 0 { return 500 + f }
    42
}
