import joky/domain
import joky/outbox
import joky/task
import joky/check
import joky/array.{type Array}
import joky/result.{type Result}
enum AwardError { Missing, Changed, Unavailable }
struct Context { directory:domain.DirectoryHandle, output:outbox.Handle, timer:domain.TimerHandle }
#state
struct Room { score:Int32 }
#state
struct Ledger { total:Int32 }
#state
struct Clock { ticks:Int32, last:Int32, waiting:Int32 }
fn assert(ok:Bool) {let message="reload server Script"; check.assert(ok,&message)}
fn version()->Int32 {1}
fn room(score:Int32)->Room {Room{score:score}}
fn ledger(total:Int32)->Ledger {Ledger{total:total}}
fn clock(n:Int32)->Clock {Clock{ticks:n,last:0,waiting:0}}
impl Clock {
    fn current(&self)->Int32 {self.last}
    fn awaiting(&self)->Int32 {self.waiting}
    fn wait_for_publish(&mut self,previous:Int32) {self.waiting=previous}
}
fn balance(a:&Room,b:&Ledger)->Int32 {if b.total==a.score*2 {a.score} else {-100}}
fn tick(s:&mut Clock,n:Int32) {s.ticks=s.ticks+n; s.last=version()}
fn hold(ctx:Context) @suspends {
    let a=domain.create(room,0); let b=domain.create(ledger,0); let c=domain.create(clock,0)
    assert(ctx.directory.insert(1,a.handle()).is_ok())
    assert(ctx.directory.insert(2,b.handle()).is_ok())
    assert(ctx.directory.insert(3,c.handle()).is_ok())
    task.sleep_ms(100000)
}
fn probe(ctx:Context) @suspends ->Int32 {
    let a=match domain.lookup::<Room>(ctx.directory,1) {Some(h)=>h,None=>return -1}
    let b=match domain.lookup::<Ledger>(ctx.directory,2) {Some(h)=>h,None=>return -1}
    when "balance" (a,b) {balance(a,b)}.unwrap()
}
fn tick_version(ctx:Context) @suspends ->Int32 {
    match domain.lookup::<Clock>(ctx.directory,3) {Some(h)=>h.current().unwrap(),None=>-1}
}
fn awaiting(ctx:Context) @suspends ->Int32 {
    match domain.lookup::<Clock>(ctx.directory,3) {Some(h)=>h.awaiting().unwrap(),None=>-1}
}
// This old flow retains its input, but the named block resolves after publication.
fn award(ctx:Context) @suspends ->Result<Int32,AwardError> {
    let a=match domain.lookup_write::<Room>(ctx.directory,1) {Some(h)=>h,None=>return Result.Err(AwardError.Missing)}
    let b=match domain.lookup_write::<Ledger>(ctx.directory,2) {Some(h)=>h,None=>return Result.Err(AwardError.Missing)}
    let c=match domain.lookup_write::<Clock>(ctx.directory,3) {Some(h)=>h,None=>return Result.Err(AwardError.Missing)}
    let previous=c.current().unwrap()
    let amount=version()
    c.wait_for_publish(previous).unwrap()
    while c.current().unwrap()==previous {task.yield_now()}
    match when "award" (mut a,mut b) {
        let increment=amount*version()
        a.score+=increment
        b.total+=increment*2
        increment
    } {
        Ok(value)=>Result.Ok(value),
        Err(Incompatible)=>Result.Err(AwardError.Changed),
        Err(_)=>Result.Err(AwardError.Unavailable)
    }
}
fn start_tick(ctx:Context) @suspends ->Bool {
    match domain.lookup_write::<Clock>(ctx.directory,3) {
        Some(h)=>domain.every(ctx.timer,h,1,tick,1).is_ok(),None=>false
    }
}
fn request(ctx:Context) @suspends ->Int32 {
    let a=match domain.lookup_write::<Room>(ctx.directory,1) {Some(h)=>h,None=>return -1}
    let b=match domain.lookup_write::<Ledger>(ctx.directory,2) {Some(h)=>h,None=>return -1}
    // State and reply must publish together: keep the candidate/outbox protocol.
    let snapshot=domain.snapshot_pair(a.read_only(),b.read_only(),balance)
    let value=snapshot.value()+version()
    assert(value>0 && value<256)
    let first=domain.candidate_from(snapshot, a, room, value)
    let pair=domain.candidate_pair_from(first, b, ledger, value*2)
    var bytes=Array.new::<UInt8>(); bytes.push(value.to_u8().unwrap_or(0))
    var batch=outbox.batch(1,1)
    assert(outbox.stage(&mut batch,ctx.output,bytes).is_ok())
    var receipt=domain.commit_pair_to(a,b,pair.with_outbox(batch))
    assert(match receipt.wait() {Ok(_)=>true,_=>false})
    value
}
