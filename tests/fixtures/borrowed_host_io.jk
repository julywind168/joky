// NET0 only: bounded host-owned I/O, not a public socket or byte-buffer ABI.
import joky/array.{type Array}
import joky/result.{type Result, Ok, Err}
import joky/drop.{type Drop}
import joky/task
import joky/check.{assert}

#repr(C) struct NetRequest {
    marker: Int32, mode: Int32, limit: Int32, received: Int32,
    b0: UInt8, b1: UInt8, b2: UInt8, b3: UInt8
}
extern fn borrowed_host_io_read(request: &mut NetRequest) @suspends -> Int32
extern fn borrowed_host_io_event(value: Int32)
fn ensure(condition: Bool) { let message = "NET0 contract violation"; assert(condition, &message) }
struct Packet { bytes: Array<UInt8> }
impl Drop for Packet { fn drop(&mut self) { borrowed_host_io_event(20) } }
struct PendingBytes { bytes: Array<UInt8> }
impl Drop for PendingBytes { fn drop(&mut self) { borrowed_host_io_event(21) } }
enum IoError { UnexpectedEof(Int32), ReadFailed(Int32) }
fn request(mode: Int32) -> &mut NetRequest {
    alloc(NetRequest { marker: 42, mode: mode, limit: 4, received: 0,
        b0: 0, b1: 0, b2: 0, b3: 0 })
}
fn pending_bytes() -> Array<UInt8> {
    var bytes = Array.new::<UInt8>(); bytes.push(99)
    bytes
}
fn finish_read(bytes: Array<UInt8>, req: &NetRequest, count: Int32) -> Result<Array<UInt8>, IoError> {
    let pending = PendingBytes { bytes: bytes }
    // stop has already run; the task's pre-existing owner is still alive.
    ensure(req.marker == 43 && pending.bytes.get(0).unwrap_or(0) == 99)
    borrowed_host_io_event(10)
    if count == -1 { return Err(IoError.UnexpectedEof(req.received)) }
    if count < 0 { return Err(IoError.ReadFailed(req.received)) }
    ensure(count == 4 && req.received == 4)
    var output = Array.new::<UInt8>()
    output.push(req.b0); output.push(req.b1); output.push(req.b2); output.push(req.b3)
    Ok(output)
}
fn classify(result: Result<Array<UInt8>, IoError>) -> Array<UInt8> {
    match result {
        Ok(bytes) => bytes
        Err(error) => {
            match error {
                IoError.UnexpectedEof(n) => { ensure(n == 2); borrowed_host_io_event(12) }
                IoError.ReadFailed(n) => { ensure(n == 2); borrowed_host_io_event(13) }
            }
            Array.new::<UInt8>()
        }
    }
}
fn complete(bytes: Array<UInt8>, req: &NetRequest, count: Int32) -> Array<UInt8> {
    classify(finish_read(bytes, req, count))
}
fn receive(mode: Int32) @suspends -> Array<UInt8> {
    let pending = pending_bytes()
    let req = request(mode)
    let count = borrowed_host_io_read(req)
    let bytes = complete(pending, req, count)
    task.yield_now()
    bytes
}
fn check_packet(bytes: Array<UInt8>) -> Int32 {
    let packet = Packet { bytes: bytes }
    ensure(packet.bytes.len() == 4)
    ensure(packet.bytes.get(0).unwrap_or(1) == 0 && packet.bytes.get(1).unwrap_or(0) == 128)
    ensure(packet.bytes.get(2).unwrap_or(0) == 255 && packet.bytes.get(3).unwrap_or(0) == 42)
    42
}
fn check_empty(bytes: Array<UInt8>) -> Int32 { ensure(bytes.is_empty()); 42 }
fn data() @suspends -> Int32 { check_packet(receive(0)) }
fn eof() @suspends -> Int32 { check_empty(receive(0)) }
fn domain_error() @suspends -> Int32 { check_empty(receive(3)) }
fn startup_failure() @suspends -> Int32 { receive(1); borrowed_host_io_event(99); 0 }
fn pending_failure() @suspends -> Int32 { receive(2); borrowed_host_io_event(99); 0 }
fn discard_read() @suspends { receive(0); }
fn timeout() @suspends -> Int32 {
    race { discard_read(), task.sleep(10ms) }
    borrowed_host_io_event(11)
    42
}
fn fail_now() {
    let message = "NET0 parent failure"
    assert(false, &message)
}
fn fail_later() @suspends { task.sleep(10ms); fail_now() }
fn sibling_failure() @suspends -> Int32 {
    join { discard_read(), fail_later() }
    borrowed_host_io_event(99); 0
}
fn instant() @suspends {}
fn unstarted() @suspends -> Int32 {
    race { instant(), discard_read() }
    42
}
struct State { label: String }
impl Drop for State { fn drop(&mut self) { borrowed_host_io_event(30) } }
fn create() -> State { State { label: "NET0 instance" } }
fn instance_read() @suspends { data(); }
