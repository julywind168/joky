// M0 probes only: no hashing table or public standard-library API.
import joky/array.{type Array}

pub trait Eq { fn eq(self, other: Self) -> Bool }
pub trait Hash { fn hash(self) -> UInt64 }

pub fn mix(value: UInt64) -> UInt64 {
    let first = (value ^ (value >> 30)) * 0xbf58476d1ce4e5b9
    let second = (first ^ (first >> 27)) * 0x94d049bb133111eb
    second ^ (second >> 31)
}
impl Eq for Int32 { fn eq(self, other: Self) -> Bool { self == other } }
impl Hash for Int32 { fn hash(self) -> UInt64 { mix(uint64(int64(self))) } }
impl Eq for Int64 { fn eq(self, other: Self) -> Bool { self == other } }
impl Hash for Int64 { fn hash(self) -> UInt64 { mix(uint64(self)) } }
impl Eq for UInt32 { fn eq(self, other: Self) -> Bool { self == other } }
impl Hash for UInt32 { fn hash(self) -> UInt64 { mix(uint64(self)) } }
impl Eq for UInt64 { fn eq(self, other: Self) -> Bool { self == other } }
impl Hash for UInt64 { fn hash(self) -> UInt64 { mix(self) } }
impl Eq for Bool { fn eq(self, other: Self) -> Bool { self == other } }
impl Hash for Bool { fn hash(self) -> UInt64 { mix(if self { 1 } else { 0 }) } }
impl Eq for Unit { fn eq(self, other: Self) -> Bool { true } }
impl Hash for Unit { fn hash(self) -> UInt64 { mix(0) } }

pub fn same<K: Eq + Hash>(left: K, right: K) -> Bool {
    Hash.hash(left) == Hash.hash(right) && Eq.eq(left, right)
}
pub enum Bucket { Empty Deleted Full(UInt64) }
pub struct Storage<K, V> {
    private buckets: Array<Bucket>
    private keys: Array<K>
    private values: Array<V>
    private hashes: Array<UInt64>
    private positions: Array<UInt64>
    private deleted: UInt64
}
pub fn empty<K, V>() -> Storage<K, V> {
    Storage {
        buckets: Array.new::<Bucket>()
        keys: Array.new::<K>()
        values: Array.new::<V>()
        hashes: Array.new::<UInt64>()
        positions: Array.new::<UInt64>()
        deleted: 0
    }
}
pub fn append<K: Hash, V>(table: &mut Storage<K, V>, key: K, value: V) {
    let hash = Hash.hash(key)
    let index = table.values.len()
    table.keys.push(key)
    table.values.push(value)
    table.hashes.push(hash)
    table.positions.push(index)
    table.buckets.push(Bucket.Full(index))
}
pub fn len<K, V>(table: &Storage<K, V>) -> UInt64 { table.values.len() }
pub fn release<K, V>(table: Storage<K, V>) {}
pub fn metadata<K, V>(table: &Storage<K, V>) -> Bool {
    let n = table.values.len()
    n == table.keys.len() && n == table.hashes.len() && n == table.positions.len()
        && n == table.buckets.len() && table.deleted == 0
}
pub fn matches<K: Eq + Hash, V>(table: &Storage<K, V>, index: UInt64, key: K) -> Bool {
    match table.keys.get(index) {
        | Some(stored) => same(stored, key)
        | None => false
    }
}
pub fn view<K, V>(table: &Storage<K, V>, index: UInt64) -> &V { table.values.borrow_ref(index) }
pub fn view_mut<K, V>(table: &mut Storage<K, V>, index: UInt64) -> &mut V { table.values.borrow_mut_ref(index) }
pub fn get<K, V>(table: &Storage<K, V>, index: UInt64) -> Option<V> { table.values.get(index) }
pub fn replace<T>(values: &mut Array<T>, index: UInt64, next: T) -> Option<T> {
    values.replace(index, next)
}
pub fn replace_value<K, V>(table: &mut Storage<K, V>, index: UInt64, next: V) -> Option<V> {
    replace(&mut table.values, index, next)
}
// Rebuild only index storage; payload arrays and their cleanup stay untouched.
pub fn reset_index<K, V>(table: &mut Storage<K, V>) {
    var buckets = Array.new::<Bucket>()
    var positions = Array.new::<UInt64>()
    var index: UInt64 = 0
    while index < len(table) {
        buckets.push(Bucket.Full(index)) positions.push(index)
        index = index + 1
    }
    let old_buckets = memory.replace(&mut table.buckets, buckets)
    let old_positions = memory.replace(&mut table.positions, positions)
    table.deleted = 0
}
pub fn bucket_states() -> Bool {
    var buckets = Array.new::<Bucket>()
    buckets.push(Bucket.Empty) buckets.push(Bucket.Deleted) buckets.push(Bucket.Full(42))
    buckets.swap(0, 2)
    let first = match buckets.get(0).unwrap_or(Bucket.Empty) { | Bucket.Full(n) => n == 42 | Bucket.Empty => false | Bucket.Deleted => false }
    let middle = match buckets.get(1).unwrap_or(Bucket.Empty) { | Bucket.Deleted => true | Bucket.Empty => false | Bucket.Full(n) => false }
    let last = match buckets.get(2).unwrap_or(Bucket.Deleted) { | Bucket.Empty => true | Bucket.Deleted => false | Bucket.Full(n) => false }
    first && middle && last
}
// The caller supplies the target/layout-dependent bucket-count limit.
pub fn bucket_count(required: UInt64, limit: UInt64) -> Option<UInt64> {
    if required == 0 { return Some(0) }
    if limit < 8 { return None }
    var count: UInt64 = 8
    while required > count - count / 4 {
        if count > limit / 2 { return None }
        count = count + count
    }
    Some(count)
}
pub fn required_count(length: UInt64, additional: UInt64) -> Option<UInt64> {
    if additional > UInt64.MAX - length { None } else { Some(length + additional) }
}
