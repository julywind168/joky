import joky/vm
import joky/task
import joky/array.{type Array}

struct Script { engine: vm.Vm, name: String }
fn call(engine: &vm.Vm, value: Int32) @suspends -> Int32 {
    engine.call::<Int32, Int32>("answer", value)
}
fn script(value: &Script) @suspends -> Int32 {
    let (a, b) = join { call(&value.engine, 10), call(&value.engine, 9) }
    if !value.name.equals("script") { return -100 }
    a + b
}
fn collection(values: &Array<Script>) @suspends -> Int32 { script(values.borrow_ref(0)) }
fn alias(engine: &vm.Vm) @suspends -> vm.Vm { engine.share() }
fn slow(engine: &vm.Vm) @suspends -> Int32 {
    engine.call::<Int32, Int32>("slow", 0)
}
fn failed(engine: &vm.Vm) @suspends -> Int32 {
    let zero = call(engine, -1)
    1 / zero
}
fn main() @suspends -> Int32 {
    let engine = vm.Vm.interpreter()
    engine.load_source("extern fn __joky_task_sleep_ms(milliseconds: UInt64) @suspends\nfn answer(value: Int32) @suspends -> Int32 {{ value + 1 }}\nfn slow(value: Int32) @suspends -> Int32 {{ __joky_task_sleep_ms(60000); value }}")!
    let source = Script { engine, name: "script" }
    let (a, b) = join { script(&source), script(&source) }
    if a + b != 42 { return 1 }
    let rows = [Script { engine: source.engine.share(), name: "script" }]
    let (a, b) = join { collection(&rows), collection(&rows) }
    if a + b != 42 { return 8 }
    let shared = &source
    scope {
        branch { let _ = script(shared) }
        branch { let _ = script(shared) }
    }
    let (first, second) = join { alias(&source.engine), alias(&source.engine) }
    let (a, b) = join { call(&first, 20), call(&second, 20) }
    if a + b != 42 { return 2 }
    if (race { slow(&source.engine), call(&source.engine, 41) }) != 42 { return 3 }
    let failure = isolate { join { failed(&shared.engine), slow(&shared.engine) } }
    if failure.is_ok() { return 4 }
    source.engine.load_source("fn answer(value: Int32) @suspends -> Int32 {{ value + 2 }}")!
    let (a, b) = join { call(&first, 19), call(&second, 19) }
    if a + b != 42 { return 5 }
    if first.close() != 0 { return 6 }
    if source.engine.try_call::<Int32, Int32>("answer", 0).is_ok() { return 7 }
    0
}
fn parked() @suspends -> Int32 {
    let engine = vm.Vm.interpreter()
    engine.load_source("extern fn __joky_task_sleep_ms(milliseconds: UInt64) @suspends\nfn slow(value: Int32) @suspends -> Int32 {{ __joky_task_sleep_ms(60000); value }}")!
    let (a, b) = join { slow(&engine), slow(&engine) }
    a + b
}
