eff time { @suspends fn sleep(duration: Duration) -> Unit }

trait Work {
    fn finish(self) -> String effects { time }
}

class Tracked { let text: String }
impl Drop for Tracked {
    fn drop(&self) { println("dropped") }
}

impl Work for Tracked {
    fn finish(self) -> String effects { time } {
        time.sleep(1ms)
        time.sleep(1ms)
        self.text
    }
}

fn make(text: String) -> Dyn(Work) { Dyn(Work)(Tracked(text: text)) }

fn main() effects { time } {
    let unused = make("unused")
    let work = make("resumed")
    println(work.finish())
}
