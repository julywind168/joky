import joky/domain
import joky/task
import joky/check
fn assert(ok:Bool) { let message="atomic pair commit" check.assert(ok,&message) }
struct State { n:Int32, wide:UInt64, real:Float64 }
struct Rules { limit:Int32 }
fn make(n:Int32)->State { State{n:n,wide:18446744073709551615,real:Float64.from_bits(9221120237041090626)} }
fn rules(n:Int32)->Rules { Rules{limit:n} }
fn total(a:&State,b:&Rules)->Int32 { a.n+b.limit }
fn read(a:&State)->Int32 { a.n }
fn read_rules(b:&Rules)->Int32 { b.limit }
fn valid(a:&State)->Bool { a.wide==18446744073709551615 && a.real.to_bits()==9221120237041090626 }
fn set_rules(b:&mut Rules,n:Int32) { b.limit=n }
fn fail(b:&mut Rules,n:Int32)->Int32 { b.limit=99 1/n }
fn poison(n:Int32) @suspends ->Int32 { domain.write(fail,n) }
fn revision(result:domain.PairCommitOutcome,a:UInt64,b:UInt64)->Bool {
    match result { Committed((x,y))=>x==a && y==b, _=>false }
}
fn bundle(a:domain.ReadHandle<State>,b:domain.ReadHandle<Rules>,x:Int32,y:Int32) @suspends -> domain.CandidatePair<State,Rules> {
    let snapshot=domain.snapshot_pair(a,b,total)
    let first=domain.candidate_from(snapshot,make,x)
    task.yield_now()
    domain.candidate_pair_from(first,rules,y)
}
fn lifecycle() @suspends ->Int32 {
    let a=domain.create(make,7)
    let b=domain.create(rules,10)
    let ah=a.handle()
    let bh=b.handle()
    domain.write_to(bh,set_rules,10)
    let old=domain.snapshot_pair(ah.read_only(),bh.read_only(),total)
    let candidates=bundle(ah.read_only(),bh.read_only(),20,30)
    assert(domain.read_pair(ah.read_only(),bh.read_only(),total)==17)
    let deadline=domain.deadline_after(100000)
    var receipt=domain.commit_pair_before(ah,bh,candidates,&deadline)
    assert(revision(receipt.wait(),1,2))
    assert(receipt.identity()!=0)
    receipt.cancel()
    assert(revision(receipt.wait(),1,2))
    assert(old.value()==17)
    assert(match old.check() { Conflict=>true, _=>false })
    assert(domain.read_pair(ah.read_only(),bh.read_only(),total)==50)
    assert(domain.read_from(ah.read_only(),valid))
    let stale=bundle(ah.read_only(),bh.read_only(),100,200)
    domain.write_to(bh,set_rules,30)
    var conflict=domain.commit_pair_to(ah,bh,stale)
    assert(match conflict.wait() { Conflict=>true, _=>false })
    assert(domain.read_from(ah.read_only(),read)==20)
    assert(domain.read_from(bh.read_only(),read_rules)==30)
    let timed=bundle(ah.read_only(),bh.read_only(),100,200)
    let expired=domain.deadline_after(0)
    var expiry=domain.commit_pair_before(ah,bh,timed,&expired)
    assert(match expiry.wait() { Expired=>true, _=>false })
    assert(domain.read_pair(ah.read_only(),bh.read_only(),total)==50)
    let other=domain.create(rules,40)
    let wrong=bundle(ah.read_only(),bh.read_only(),100,200)
    var rejected=domain.commit_pair_to(ah,other.handle(),wrong)
    assert(match rejected.wait() { InvalidAccess=>true, _=>false })
    assert(domain.read_pair(ah.read_only(),bh.read_only(),total)==50)
    let doomed=bundle(ah.read_only(),bh.read_only(),100,200)
    b.close()
    var closed=domain.commit_pair_to(ah,bh,doomed)
    assert(match closed.wait() { Closed=>true, _=>false })
    assert(domain.read_from(ah.read_only(),read)==20)
    let other_handle=other.handle()
    let poisoned=bundle(ah.read_only(),other_handle.read_only(),100,200)
    assert(domain.request(other_handle,poison,0).is_err())
    var failed=domain.commit_pair_to(ah,other_handle,poisoned)
    assert(match failed.wait() { DomainFailed=>true, _=>false })
    assert(domain.read_from(ah.read_only(),read)==20)
    a.close()
    assert(revision(receipt.wait(),1,2))
    24
}
fn main() @suspends { assert(lifecycle()==24) println("pair commits ok") }
