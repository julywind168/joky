import joky/array.{type Array}
import joky/drop.{type Drop}
import joky/option.{type Option}
import joky/result.{type Result}
import joky/check.{assert}
extern fn closure_event(value: Int32)
struct Resource { id: Int32, data: Array<Int32> }
impl Drop for Resource {
    fn drop(&mut self) {
        closure_event(self.id)
        if self.id == 4 {
            let message = "First closure drop failure"
            assert(false, &message)
        }
        if self.id == 5 {
            let message = "Second closure drop failure"
            assert(false, &message)
        }
    }
}
fn resource(id: Int32) -> Resource {
    let value = Resource { id: id, data: Array.new::<Int32>() }
    closure_event(-id)
    value
}
fn apply<F: FnOnce() -> Int32>(f: F) -> Int32 { f() }
fn unused() -> Int32 {
    let a = resource(1); let b = resource(2)
    let f = move || { a.id + b.id }
    42
}
fn consume() -> Int32 {
    let a = resource(1)
    let f = move || -> Resource { a }
    let result = f()
    result.id + 41
}
fn repeated() -> Int32 {
    let a = resource(1)
    let f = move || { a.id + 20 }
    f() + f()
}
fn skipped() -> Int32 {
    let a = resource(1)
    let none: Option<Int32> = Option.None
    let result = none.map(move |x| { a.id + x })
    result.unwrap_or(42)
}
fn consumed_helper() -> Int32 {
    let a = resource(1)
    let result = apply(move || { a.id + 41 })
    let after = resource(2)
    result
}
fn failure() -> Int32 {
    let a = resource(1); let b = resource(2)
    let f = move || -> Int32 {
        let value = a.id + b.id
        let message = "Closure failure"
        assert(false, &message)
        value
    }
    f()
}
fn cancellation_work() -> Int32 {
    let first = resource(1)
    let reader = move || { first.id }
    let second = resource(2)
    let consumer = move || -> Resource { second }
    let result = consumer()
    let mapped = Option.Some(reader()).map(|x| { x + result.id })
    mapped.unwrap_or(0) + 39
}
fn closure_task() @suspends -> Int32 { cancellation_work() }

fn consume_last() -> Int32 {
    let a = resource(1); let b = resource(2); let c = resource(3)
    let f = move || { let value = a.id + b.id; let transferred = c; value + transferred.id + 36 }
    f()
}
fn consuming_failure() -> Int32 {
    let a = resource(1); let b = resource(2); let c = resource(3)
    let f = move || {
        let value = a.id + b.id
        let message = "Closure failure"
        assert(false, &message)
        let transferred = c
        value + transferred.id
    }
    f()
}

fn cleanup_failure() -> Int32 {
    let a = resource(4); let b = resource(5); let c = resource(1)
    let f = move || { a.id + b.id + c.id }
    42
}
fn failure_before_cleanup_failure() -> Int32 {
    let a = resource(4); let b = resource(5); let c = resource(1)
    let f = move || {
        let value = a.id + b.id + c.id
        let message = "Closure failure"
        assert(false, &message)
        value
    }
    f()
}
fn argument_event(tag: Int32, value: Int32) -> Int32 { closure_event(tag); value }
fn argument_order() -> Int32 {
    let offset = 1
    let f = |a: Int32, b: Int32| { closure_event(400); a + b + offset }
    closure_event(100)
    f(argument_event(200, 20), argument_event(300, 21))
}
fn failed_argument() -> Int32 {
    let message = "Closure failure"
    assert(false, &message)
    0
}
fn consuming_argument_failure() -> Int32 {
    let a = resource(1)
    let f = move |x: Int32| { let owned = a; owned.id + x }
    f(failed_argument())
}

fn lazy_skipped() -> Int32 {
    let first = resource(1)
    let a = Option.Some(20).unwrap_or_else(move || { first.id })
    let second = resource(2)
    let b = Result.Ok::<Int32, Int32>(22).unwrap_or_else(move |error| { second.id + error })
    a + b
}
fn lazy_consumed() -> Int32 {
    let captured = resource(1)
    let result = Option.None::<Resource>.unwrap_or_else(move || { captured })
    result.id + 41
}
fn lazy_error_consumed() -> Int32 {
    let error: Result<Resource, Resource> = Result.Err(resource(1))
    let result = error.unwrap_or_else(|error| { error })
    result.id + 41
}
fn query_owned() -> Int32 {
    let value = Option.Some(resource(1))
    if !value.is_some() || value.is_none() { return 0 }
    let fallback = resource(2)
    let result = value.unwrap_or_else(move || { fallback })
    result.id + 41
}
fn query_temporary() -> Int32 {
    let present = Option.Some(resource(1)).is_some()
    closure_event(100)
    if present { 42 } else { 0 }
}
fn lazy_failure() -> Int32 {
    let error: Result<Int32, Resource> = Result.Err(resource(1))
    let captured = resource(2)
    error.unwrap_or_else(move |error| { failed_argument() + error.id + captured.id })
}

fn lazy_cancellation_work() -> Int32 {
    let captured = resource(1)
    let error: Result<Resource, Resource> = Result.Err(resource(2))
    if !error.is_err() || error.is_ok() { return 0 }
    let result = error.unwrap_or_else(move |error| {
        if error.id != 2 { return error }
        captured
    })
    result.id + 41
}
fn lazy_closure_task() @suspends -> Int32 { lazy_cancellation_work() }
