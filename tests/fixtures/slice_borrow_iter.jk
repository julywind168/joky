import joky/array.{type Array}
import joky/slice.{type Slice}
import joky/iter.{type Iter}
import joky/map.{type Map}
import joky/option.{Some, None}
import joky/check.{assert}
import joky/drop.{type Drop}
import joky/string
extern fn record(x: Int32) -> Int32
extern fn delayed_value(x: Int32) @suspends -> Int32

fn expect(ok: Bool) { assert(ok, "Slice iterator mismatch") }
fn forward<T>(values: &Slice<T>) -> &Iter<T> { slice.iter(values) }
fn forward_mut<T>(values: &mut Slice<T>) -> &mut Iter<T> { slice.iter_mut(values) }
fn sum(values: &Slice<Int32>) -> Int32 {
    var result = 0
    for value in values { result += *value }
    result
}
fn compute() -> Int32 {
    var input = [90, 1, 2, 3, 80]
    let middle = input.slice_mut(1, 4)
    for value in slice.slice_mut(middle, 1, 3) { *value += 10 }
    expect(sum(input.slice(0, 5)) == 196)
    expect(sum(slice.slice(input.slice(1, 5), 1, 3)) == 25)
    var count = 0
    for _ in input.slice(5, 5) { count += 1 }
    let units = [{}, {}, {}]
    for _ in slice.iter(units.slice(1, 3)) { count += 1 }
    expect(count == 2)
    let texts = ["skip", "a", "bc", "skip"]
    var bytes: UInt64 = 0
    for value in slice.iter(texts.slice(1, 3)) { bytes += string.byte_length(value) }
    expect(bytes == 3)
    resumed()
    map_columns()
    42
}
fn resumed() {
    var input = [90, 1, 2, 80]
    let cursor = slice.iter_mut(input.slice_mut(1, 3))
    for value in &mut *cursor { *value += 10; break }
    expect(iter.advance(cursor))
    *iter.current_mut(cursor) += 10
    expect(!iter.advance(cursor))
    expect(!iter.advance(cursor))
    let saved = {
        let view = input.slice(1, 3)
        let cursor = slice.iter(view)
        expect(iter.advance(cursor))
        iter.current(cursor)
    }
    expect(*saved == 11)
    input.push(7)
    expect(sum(input.slice(0, input.len())) == 200)
}
fn map_columns() {
    var table = Map.new::<Int32, Int32>()
    var count = 0
    for _ in slice.iter(table.keys()) { count += 1 }
    expect(count == 0)
    table.insert(1, 10)
    table.insert(2, 20)
    table.insert(3, 30)
    table.remove(2)
    table.insert(4, 40)
    expect(sum(table.keys()) == 8)
    expect(sum(table.values()) == 80)
    for value in slice.iter_mut(table.values_mut()) { *value += 1 }
    expect(*table.borrow_ref(1) == 11)
    expect(*table.borrow_ref(3) == 31 && *table.borrow_ref(4) == 41)
    // Keys and values share dense indices while both shared views remain live.
    let keys = slice.iter(table.keys())
    let values = slice.iter(table.values())
    for key in keys {
        expect(iter.advance(values))
        expect(*iter.current(values) == *key * 10 + 1)
    }
    expect(!iter.advance(values))
    table.clear()
    expect(sum(table.values()) == 0)
}

struct Owned { id: Int32, data: Array<Int32> }
impl Drop for Owned { fn drop(&mut self) { record(self.id); } }
fn owned(id: Int32) -> Owned {
    let value = Owned { id: id, data: [id] }
    record(-id)
    value
}
fn pending() @suspends -> Int32 {
    var input = [owned(1), owned(2), owned(3), owned(4)]
    let view = input.slice_mut(1, 4)
    for value in slice.slice_mut(view, 0, 2) {
        value.data.push(99)
        delayed_value(record(10 + value.id))
        expect(value.data.len() == 2)
        if value.id == 2 { continue }
        break
    }
    expect(input.len() == 4)
    42
}
fn map_owners(action: Int32) -> Int32 {
    var table = Map.new::<Int32, Owned>()
    table.insert(1, owned(1))
    table.insert(2, owned(2))
    for value in slice.iter_mut(table.values_mut()) {
        value.data.push(99)
        expect(value.data.len() == 2)
        if action == 1 { return 42 }
        if action == 2 { let invalid = value.id % 0 }
    }
    var result = 0
    for value in slice.iter(table.values()) { result += value.id }
    expect(result == 3 && table.len() == 2)
    record(20)
    42
}
