import joky/domain
import joky/task
import joky/check
fn assert(ok: Bool) { let message="joint snapshot" check.assert(ok,&message) }
struct State { n:Int32 }
struct Rules { limit:Int32 }
fn make(n:Int32)->State { State{n:n} }
fn rules(n:Int32)->Rules { Rules{limit:n} }
fn project(a:&State,b:&Rules)->Int32 { a.n+b.limit }
fn same(a:&State,b:&State)->Int32 { a.n+b.n }
fn empty(a:&State,b:&Rules) {}
fn bits(a:&State,b:&Rules)->UInt64 { 18446744073709551615 }
fn nan(a:&State,b:&Rules)->Float64 { Float64.from_bits(9221120237041090626) }
fn read(a:&State)->Int32 { a.n }
fn change(b:&mut Rules,n:Int32) { b.limit=n }
fn fail(b:&mut Rules,n:Int32)->Int32 { b.limit=99 1/n }
fn poison(n:Int32) @suspends ->Int32 { domain.write(fail,n) }
fn lifecycle() @suspends ->Int32 {
    let a=domain.create(make,7)
    let b=domain.create(rules,10)
    let ah=a.handle()
    let bh=b.handle()
    let saved=domain.snapshot_pair(ah.read_only(),bh.read_only(),project)
    assert(saved.value()==17)
    assert(match saved.check() { Current=>true, _=>false })
    task.yield_now()
    let c=domain.candidate_from(saved,make,17)
    domain.write_to(bh,change,10)
    let r=domain.commit_to(ah,c)
    var receipt=r
    assert(match receipt.wait() { Conflict=>true, _=>false })
    assert(domain.read_from(ah.read_only(),read)==7)
    let fresh=domain.snapshot_pair(ah.read_only(),bh.read_only(),project)
    let next=fresh.value()
    let candidate=domain.candidate_from(fresh,make,next)
    task.yield_now()
    let deadline=domain.deadline_after(100000)
    var success=domain.commit_before(ah,candidate,&deadline)
    assert(match success.wait() { Committed(revision)=>revision==1, _=>false })
    let duplicate=domain.snapshot_pair(ah.read_only(),ah.read_only(),same)
    assert(duplicate.value()==34)
    var dup=domain.commit_to(ah,domain.candidate_from(duplicate,make,18))
    assert(match dup.wait() { Committed(revision)=>revision==2, _=>false })
    let unit=domain.snapshot_pair(ah.read_only(),bh.read_only(),empty)
    unit.value()
    let large=domain.snapshot_pair(ah.read_only(),bh.read_only(),bits)
    let real=domain.snapshot_pair(ah.read_only(),bh.read_only(),nan)
    assert(large.value()==18446744073709551615)
    assert(real.value().to_bits()==9221120237041090626)
    let stale=domain.snapshot_pair(ah.read_only(),bh.read_only(),project)
    let late=domain.candidate_from(domain.snapshot_pair(ah.read_only(),bh.read_only(),project),make,99)
    b.close()
    let replacement=domain.create(rules,10)
    assert(stale.value()==28)
    assert(match stale.check() { Closed=>true, _=>false })
    var closed=domain.commit_to(ah,late)
    assert(match closed.wait() { Closed=>true, _=>false })
    let doomed=domain.snapshot_pair(ah.read_only(),replacement.read_handle(),project)
    let poisoned=domain.candidate_from(domain.snapshot_pair(ah.read_only(),replacement.read_handle(),project),make,99)
    assert(domain.request(replacement.handle(),poison,0).is_err())
    assert(match doomed.check() { DomainFailed=>true, _=>false })
    var failed=domain.commit_to(ah,poisoned)
    assert(match failed.wait() { DomainFailed=>true, _=>false })
    assert(domain.read_from(ah.read_only(),read)==18)
    a.close()
    assert(large.value()==18446744073709551615)
    24
}
fn main() @suspends { assert(lifecycle()==24) println("joint snapshots ok") }
