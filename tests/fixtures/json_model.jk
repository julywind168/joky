    model("false", 29, 2)
    model("[null, {{\"0\\udbff\\udfff\": \"\\u4f60\\ud83d\\ude42\", \"1e\\u0301\": 0, \"2\": \"e\\u0301\"}}, [{{\"0\\udbff\\udfff\": 0.1, \"1\\udbff\\udfff\": [true, null, [true, \"\\u4f60\\ud83d\\ude42\", 0.1, null]], \"2\\u2028\\u2029\": [\"\\udbff\\udfff\", null, [-1, -0.0, 18446744073709551616]], \"3\\u2028\\u2029\": 0}}, null, false, null]]", 17600215059674783812, 3)
    model("{{\"root\": -1, \"\": 1e-300}}", 11936553897495881283, 4)
}
