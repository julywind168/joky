// 40 fixed-seed semantic goldens and five edge models from Python's JSON codec.
// Codec roundtrips preserve kinds, array order and number spelling; object
// order is ignored by the independent semantic fingerprints.
import joky/json.{type Value}
import joky/slice
import joky/check.{assert}
fn text_hash(text: &String) -> UInt64 {
    var hash: UInt64 = 14695981039346656037
    var index: UInt64 = 0
    let bytes = text.bytes()
    while index < text.byte_length() {
        hash = (hash ^ uint64(*slice.borrow_ref(bytes, index))) * 1099511628211
        index = index + 1
    }
    hash
}
// Recursion is limited to the generated model's five levels, independently of
// the decoder's iterative traversal and configured depth checks.
fn fingerprint(value: &Value) -> UInt64 {
    match value {
        Null => 17
        Boolean(value) => if value { 23 } else { 29 }
        Text(text) => text_hash(text) + 33
        Number(number) => text_hash(number.as_text()) + 41
        Array(items) => {
            var hash: UInt64 = 7
            var index: UInt64 = 0
            while index < items.len() {
                hash = hash * 131 + fingerprint(items.borrow_ref(index))
                index = index + 1
            }
            hash
        }
        Object(fields) => {
            var hash: UInt64 = 11
            var index: UInt64 = 0
            let keys = fields.keys()
            while index < fields.len() {
                let key = slice.borrow_ref(keys, index)
                hash = hash + text_hash(key) * fingerprint(fields.value_ref(key))
                index = index + 1
            }
            hash
        }
    }
}
fn model(input: String, expected: UInt64, index: Int32) {
    let message = "JSON codec semantic model {index}"
    match json.decode(&input) {
        Ok(value) => {
            assert(fingerprint(&value) == expected, &message)
            match json.encode(&value) {
                Ok(output) => {
                    assert(fingerprint(&value) == expected, &message)
                    match json.decode(&output) {
                        Ok(recovered) => { assert(fingerprint(&recovered) == expected, &message) }
                        Err(_) => { assert(false, &message) }
                    }
                }
                Err(_) => { assert(false, &message) }
            }
        }
        Err(_) => { assert(false, &message) }
    }
}
