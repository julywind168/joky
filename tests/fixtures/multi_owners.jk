import joky/array.{type Array}
import joky/drop.{type Drop}
import joky/option.{type Option}

extern fn record_drop(value: Int32)

struct Leaf<T> { id: Int32, values: Array<T> }
impl<T> Drop for Leaf<T> {
    fn drop(&mut self) { let length = self.values.len() record_drop(self.id) }
}
fn leaf<T>(id: Int32) -> Leaf<T> { Leaf { id: id, values: Array.new::<T>() } }
fn tracked_leaf<T>(id: Int32) -> Leaf<T> {
    let value = leaf::<T>(id)
    record_drop(0 - id)
    value
}

struct Pair { tag: Int32, first: Leaf<Int32>, flag: Bool, second: Leaf<Int64>, unit: Unit }
impl Drop for Pair {
    fn drop(&mut self) {
        // Both siblings must remain live until the parent's hook finishes.
        let tag = self.tag
        self.first.values.push(tag)
        self.second.values.push(int64(tag))
        record_drop(self.tag)
    }
}
fn pair(tag: Int32) -> Pair {
    Pair { tag: tag, first: leaf::<Int32>(tag + 1), flag: true, second: leaf::<Int64>(tag + 2), unit: {} }
}
fn tracked_pair(tag: Int32) -> Pair {
    let value = Pair { second: tracked_leaf::<Int64>(tag + 2), first: tracked_leaf::<Int32>(tag + 1), tag: tag, flag: true, unit: {} }
    record_drop(0 - tag)
    value
}
fn pass(value: Pair) -> Pair { value }
struct Empty { unit: Unit }
fn select(unit: Unit, empty: Empty, first: Pair, tag: Unit, second: Pair) -> Pair { first }

fn multi_scope() -> Int32 { let first = pair(10) let second = pair(20) 42 }
fn multi_move() -> Int32 {
    let first = pair(10)
    var value = pass(first)
    value.tag = 30
    value.second.id = 32
    value.first.id = 31
    value.first.values.push(7)
    value.second.values.push(8)
    42
}
fn multi_replace() -> Int32 { var value = pair(10) value = pair(20) 42 }
fn multi_reinitialize() -> Int32 {
    var first = pair(10)
    let second = first
    first = pair(20)
    42
}
fn multi_reinitialize_failure() -> Int32 {
    var first = pair(10)
    let second = first
    first = pair(20)
    1 / 0
}
fn multi_call() -> Int32 { let value = select({}, Empty { unit: {} }, pair(10), {}, pair(20)) 42 }
fn multi_early() -> Int32 { let a = pair(10) { let b = pair(20) return 42 } }
fn multi_loop() -> Int32 {
    var i = 1
    while i < 4 {
        let value = pair(i * 10)
        i = i + 1
        if i == 2 { continue }
        if i == 3 { break }
    }
    42
}
struct Envelope { left: Pair, right: Pair, tail: Leaf<Int32> }
impl Drop for Envelope { fn drop(&mut self) { record_drop(1) self.right.first.id = 29 } }
struct Wrapped { inner: Envelope }
fn multi_nested() -> Int32 {
    let value = Wrapped { inner: Envelope { right: pair(20), tail: leaf::<Int32>(3), left: pair(10) } }
    let moved = value
    42
}
fn multi_partial() -> Int32 {
    let value = Pair { second: leaf::<Int64>(2), first: leaf::<Int32>(1), tag: 1 / 0, flag: true, unit: {} }
    42
}
fn multi_partial_return() -> Int32 {
    let value = Pair { second: leaf::<Int64>(2), first: leaf::<Int32>(1), flag: true, unit: {}, tag: { return 42 } }
}
fn multi_partial_break() -> Int32 {
    while true {
        let value = Pair { first: leaf::<Int32>(1), second: leaf::<Int64>(2), flag: true, unit: {}, tag: { break } }
    }
    42
}
fn multi_partial_nested() -> Int32 {
    let value = Envelope { right: pair(20), left: Pair { first: leaf::<Int32>(11), tag: 1 / 0, flag: true, unit: {}, second: leaf::<Int64>(12) }, tail: leaf::<Int32>(3) }
    42
}
fn multi_argument_failure() -> Int32 {
    let value = select({}, Empty { unit: {} }, pair(10), {}, Pair { second: leaf::<Int64>(22), tag: 1 / 0, flag: true, unit: {}, first: leaf::<Int32>(21) })
    42
}
struct Failing { first: Leaf<Int32>, second: Leaf<Int64> }
impl Drop for Failing { fn drop(&mut self) { record_drop(9) let bad = 1 / 0 } }
fn multi_failing_hook() -> Int32 {
    let before = pair(10)
    let failed = Failing { first: leaf::<Int32>(1), second: leaf::<Int64>(2) }
    42
}
fn multi_original_failure() -> Int32 {
    let failed = Failing { first: leaf::<Int32>(1), second: leaf::<Int64>(2) }
    1 << 32
}
fn multi_failed_overwrite() -> Int32 {
    var failed = Failing { first: leaf::<Int32>(1), second: leaf::<Int64>(2) }
    failed = Failing { first: leaf::<Int32>(3), second: leaf::<Int64>(4) }
    42
}
fn failed_return() -> Pair {
    let failed = Failing { first: leaf::<Int32>(1), second: leaf::<Int64>(2) }
    pair(10)
}
fn multi_failed_return() -> Int32 { let value = failed_return() 42 }
fn multi_transitions() -> Int32 {
    var value = select({}, Empty { unit: {} }, tracked_pair(10), {}, tracked_pair(20))
    value = tracked_pair(30)
    let moved = pass(value)
    42
}
fn multi_transition_task() @suspends -> Int32 { multi_transitions() }

struct Buffers<T> { first: Array<Int32>, second: Array<T>, version: UInt64 }
impl<T> Buffers<T> {
    fn new() -> Buffers<T> { Buffers { first: Array.new::<Int32>(), second: Array.new::<T>(), version: 1 } }
    fn add(&mut self, value: T) { self.second.push(value) }
    fn get(&self) -> Option<T> { self.second.get(0) }
}
fn multi_references() -> Int32 {
    let p = share(alloc(42))
    var values = Buffers.new::<&Int32>()
    values.add(p)
    let result = values.get().unwrap_or(p)
    { let moved = values }
    memory.read(result)
}
fn multi_reuse_budget() -> Int32 {
    var i = 0
    while i < 80 {
        let values = Buffers { first: Array.with_capacity::<Int32>(262144), second: Array.with_capacity::<Int64>(262144), version: 1 }
        i = i + 1
    }
    42
}
