import joky/crypto.{ type Sha256, type HmacSha256 }
import joky/hex
import joky/array.{ type Array }
import joky/slice.{ type Slice }
import joky/option.{ type Option }
import joky/result
import joky/check.{ assert }
import joky/task
import joky/mem

fn filled(byte: UInt8, count: UInt64) -> Array<UInt8> {
    var values = Array.with_capacity::<UInt8>(count)
    for i in uint64(0) .. count { values.push(byte) }
    values
}
fn sha(input: &Slice<UInt8>, expected: &String) {
    let output = crypto.sha256(input)
    assert(output.len() == 32 && hex.encode(output.slice(0, 32)) == expected, "SHA-256 known answer")
    var state = Sha256.new()
    state.update(slice.slice(input, 0, 0))
    var start: UInt64 = 0
    for boundary in [uint64(1), 55, 56, 63, 64, 65, 16383, 16384] {
        if boundary <= slice.len(input) {
            state.update(slice.slice(input, start, boundary))
            start = boundary
        }
    }
    state.update(slice.slice(input, start, slice.len(input)))
    let streamed = state.finish()
    assert(hex.encode(streamed.slice(0, 32)) == expected, "streamed SHA-256 known answer")
}
fn mac(key: &Slice<UInt8>, input: &Slice<UInt8>, expected: &String) {
    let output = crypto.hmac_sha256(key, input)
    assert(output.len() == 32 && hex.encode(output.slice(0, 32)) == expected, "HMAC-SHA256 known answer")
    let decoded = hex.decode(expected).unwrap()
    assert(crypto.verify_hmac_sha256(key, input, decoded.slice(0, 32)), "verify independent expected tag")
    var state = HmacSha256.new(key)
    let split = slice.len(input) / 2
    state.update(slice.slice(input, 0, split))
    state.update(slice.slice(input, split, split))
    state.update(slice.slice(input, split, slice.len(input)))
    let streamed = state.finish()
    assert(hex.encode(streamed.slice(0, 32)) == expected, "streamed HMAC known answer")
    assert(stream_verify(key, input, decoded.slice(0, 32)), "stream verifies independent expected tag")
}
fn stream_verify(key: &Slice<UInt8>, input: &Slice<UInt8>, tag: &Slice<UInt8>) -> Bool {
    var state = HmacSha256.new(key)
    state.update(input)
    state.verify(tag)
}
fn crypto_vectors() -> Int32 {
    let text = ""
    sha(text.bytes(), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    let text = "abc"
    sha(text.bytes(), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    let text = "abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"
    sha(text.bytes(), "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    let text = "你好"
    sha(text.bytes(), "670d9743542cae3ea7ebe36af56bd53648b0a1126162e78d81a32934a711302e")
    // RFC 4231 cases 1-4, 6, 7, followed by an empty-key/empty-input vector.
    // https://www.rfc-editor.org/rfc/rfc4231.html
    let key0 = hex.decode("0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b0b").unwrap()
    let data0 = hex.decode("4869205468657265").unwrap()
    mac(key0.slice(0, key0.len()), data0.slice(0, data0.len()), "b0344c61d8db38535ca8afceaf0bf12b881dc200c9833da726e9376c2e32cff7")
    let key1 = hex.decode("4a656665").unwrap()
    let data1 = hex.decode("7768617420646f2079612077616e7420666f72206e6f7468696e673f").unwrap()
    mac(key1.slice(0, key1.len()), data1.slice(0, data1.len()), "5bdcc146bf60754e6a042426089575c75a003f089d2739839dec58b964ec3843")
    let key2 = hex.decode("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa").unwrap()
    let data2 = hex.decode("dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd").unwrap()
    mac(key2.slice(0, key2.len()), data2.slice(0, data2.len()), "773ea91e36800e46854db8ebd09181a72959098b3ef8c122d9635514ced565fe")
    let key3 = hex.decode("0102030405060708090a0b0c0d0e0f10111213141516171819").unwrap()
    let data3 = hex.decode("cdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcdcd").unwrap()
    mac(key3.slice(0, key3.len()), data3.slice(0, data3.len()), "82558a389a443c0ea4cc819899f2083a85f0faa3e578f8077a2e3ff46729665b")
    let key4 = hex.decode("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa").unwrap()
    let data4 = hex.decode("54657374205573696e67204c6172676572205468616e20426c6f636b2d53697a65204b6579202d2048617368204b6579204669727374").unwrap()
    mac(key4.slice(0, key4.len()), data4.slice(0, data4.len()), "60e431591ee0b67f0d8a26aacbf5b77f8e0bc6213728c5140546040f0ee37f54")
    let key5 = hex.decode("aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa").unwrap()
    let data5 = hex.decode("").unwrap()
    mac(key5.slice(0, key5.len()), data5.slice(0, data5.len()), "9b09ffa71b942fcb27635fbcd5b0e944bfdc63644f0713938a7f51535c3a35e2")
    let key6 = hex.decode("").unwrap()
    let data6 = hex.decode("").unwrap()
    mac(key6.slice(0, key6.len()), data6.slice(0, data6.len()), "b613679a0814d9ec772f95d778c35fc5ff1697c493715653c6c712144292c5ad")
    42
}
// Padding, block, binary and runtime chunk boundaries; independent Python hashlib/hmac answers.
fn crypto_boundaries() -> Int32 {
    var bytes = Array.with_capacity::<UInt8>(16385)
    for i in uint64(0) .. 16385 { bytes.push(uint8(i % 251)) }
    var whole = Sha256.new()
    whole.update(bytes.slice(0, bytes.len()))
    let whole = whole.finish()
    assert(hex.encode(whole.slice(0, 32)) == "ba4f9b37402df1e3ad948a794ab43a9ed887d63e3a389c208ca4314fdd5add58", "large streaming update crosses runtime chunks")
    sha(bytes.slice(0, 55), "463eb28e72f82e0a96c0a4cc53690c571281131f672aa229e0d45ae59b598b59")
    sha(bytes.slice(0, 56), "da2ae4d6b36748f2a318f23e7ab1dfdf45acdc9d049bd80e59de82a60895f562")
    sha(bytes.slice(0, 63), "29af2686fd53374a36b0846694cc342177e428d1647515f078784d69cdb9e488")
    sha(bytes.slice(0, 64), "fdeab9acf3710362bd2658cdc9a29e8f9c757fcf9811603a8c447cd1d9151108")
    sha(bytes.slice(0, 65), "4bfd2c8b6f1eec7a2afeb48b934ee4b2694182027e6d0fc075074f2fabb31781")
    sha(bytes.slice(0, 16383), "e08c7d58e58b9318263144a618d6f2b6f6825974decd9e6f9371567354b6f566")
    sha(bytes.slice(0, 16384), "4348e3b98e8a327b34ced39c1da9e67cdb4cd5e48e4d7960607a3ae403d35f0c")
    sha(bytes.slice(0, 16385), "ba4f9b37402df1e3ad948a794ab43a9ed887d63e3a389c208ca4314fdd5add58")
    mac(bytes.slice(0, 63), bytes.slice(0, 16385), "5e535f6807710abc13d2d7e919b9dec501ffc3d800ae1d77777d41fde9ace691")
    mac(bytes.slice(0, 64), bytes.slice(0, 16385), "49f80a996ba671b2b762c06e92e7d47eedcf77c372df239b43b04f9182c16264")
    mac(bytes.slice(0, 65), bytes.slice(0, 16385), "ab6902fbc0b0fe742aef70d1b34fc53e3ab0d3d83ccfe6184e8e53ff27c8de7c")
    mac(bytes.slice(0, 16385), bytes.slice(0, 16385), "338fd8d50d48cf2f0fd45298390b650fd33088085ebfec6508cc7525dcdba4d9")
    42
}
fn crypto_verification_and_views() -> Int32 {
    let key = "key"
    let input = "message"
    var tag = crypto.hmac_sha256(key.bytes(), input.bytes())
    for i in uint64(0) .. 32 {
        let original = tag[i]
        tag[i] = original ^ 1
        assert(!crypto.verify_hmac_sha256(key.bytes(), input.bytes(), tag.slice(0, 32)), "reject mismatch at every position")
        assert(!stream_verify(key.bytes(), input.bytes(), tag.slice(0, 32)), "stream rejects mismatch")
        tag[i] = original
    }
    let wrong_key = "kez"
    let wrong_input = "messagf"
    assert(!crypto.verify_hmac_sha256(wrong_key.bytes(), input.bytes(), tag.slice(0, 32)), "wrong key")
    assert(!crypto.verify_hmac_sha256(key.bytes(), wrong_input.bytes(), tag.slice(0, 32)), "wrong input")
    assert(!stream_verify(wrong_key.bytes(), input.bytes(), tag.slice(0, 32)), "stream wrong key")
    assert(!stream_verify(key.bytes(), wrong_input.bytes(), tag.slice(0, 32)), "stream wrong input")
    for length in [uint64(0), 16, 31] {
        assert(!crypto.verify_hmac_sha256(key.bytes(), input.bytes(), tag.slice(0, length)), "reject truncated tag")
        assert(!stream_verify(key.bytes(), input.bytes(), tag.slice(0, length)), "stream rejects truncated tag")
    }
    tag.push(0)
    assert(!crypto.verify_hmac_sha256(key.bytes(), input.bytes(), tag.slice(0, 33)), "reject oversized tag")
    assert(!stream_verify(key.bytes(), input.bytes(), tag.slice(0, 33)), "stream rejects oversized tag")
    let decorated = "!abc?"
    sha(slice.slice(decorated.bytes(), 1, 4), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    var original = hex.decode("616263").unwrap()
    let independent = crypto.sha256(original.slice(0, 3))
    original[0] = 0
    assert(hex.encode(independent.slice(0, 32)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "output owns storage")
    let padded_key = "!key?"
    let padded_input = "!message?"
    assert(crypto.verify_hmac_sha256(slice.slice(padded_key.bytes(), 1, 4), slice.slice(padded_input.bytes(), 1, 8), tag.slice(0, 32)), "nonzero input offsets")
    let padded_tag = [uint8(0), .. tag]
    assert(crypto.verify_hmac_sha256(key.bytes(), input.bytes(), padded_tag.slice(1, 33)), "nonzero tag offset")
    assert(stream_verify(key.bytes(), input.bytes(), padded_tag.slice(1, 33)), "stream nonzero tag offset")
    let empty = ""
    let same = crypto.hmac_sha256(empty.bytes(), empty.bytes())
    assert(crypto.verify_hmac_sha256(empty.bytes(), empty.bytes(), same.slice(0, 32)), "empty inputs")
    42
}
fn crypto_repeated() -> Int32 {
    let key = "secret"
    let input = "message"
    for i in 0 .. 128 {
        let hash = crypto.sha256(input.bytes())
        let tag = crypto.hmac_sha256(key.bytes(), hash.slice(0, 32))
        assert(crypto.verify_hmac_sha256(key.bytes(), hash.slice(0, 32), tag.slice(0, 32)), "bounded repeated use")
    }
    42
}
fn crypto_pending() @suspends -> Int32 {
    let key = filled(0xaa, 131)
    let input = filled(0, 64)
    let hash = crypto.sha256(input.slice(0, input.len()))
    let tag = crypto.hmac_sha256(key.slice(0, key.len()), hash.slice(0, 32))
    task.yield_now()
    assert(crypto.verify_hmac_sha256(key.slice(0, key.len()), hash.slice(0, 32), tag.slice(0, 32)), "owners survive suspension")
    42
}
fn crypto_parallel() @suspends -> Int32 {
    assert(crypto_verification_and_views() == 42, "worker verification")
    crypto_pending()
}

fn crypto_stream_empty() -> Int32 {
    let empty = ""
    let hash = Sha256.new().finish()
    assert(hex.encode(hash.slice(0, 32)) == "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "finish without update")
    let tag = HmacSha256.new(empty.bytes()).finish()
    assert(HmacSha256.new(empty.bytes()).verify(tag.slice(0, 32)), "verify without update")
    42
}
fn crypto_stream_repeated() -> Int32 {
    let key = "key"
    let input = "abc"
    for i in 0 .. 128 {
        var state = Sha256.new()
        state.update(input.bytes())
        let hash = state.finish()
        var state = HmacSha256.new(key.bytes())
        state.update(hash.slice(0, 32))
        let tag = state.finish()
        assert(stream_verify(key.bytes(), hash.slice(0, 32), tag.slice(0, 32)), "bounded streaming states")
        var unfinished = HmacSha256.new(key.bytes())
        unfinished.update(input.bytes())
        mem.drop(unfinished)
    }
    42
}
fn crypto_stream_pending() @suspends -> Int32 {
    var key = filled(0xaa, 131)
    let input = "abc"
    let expected = crypto.hmac_sha256(key.slice(0, key.len()), input.bytes())
    var hash = Sha256.new()
    var mac = HmacSha256.new(key.slice(0, key.len()))
    var verify = HmacSha256.new(key.slice(0, key.len()))
    key[0] = 0
    mem.drop(key)
    var bytes = filled(97, 1)
    hash.update(bytes.slice(0, 1))
    mac.update(bytes.slice(0, 1))
    verify.update(bytes.slice(0, 1))
    bytes[0] = 0
    mem.drop(bytes)
    task.yield_now()
    let tail = "bc"
    hash.update(tail.bytes())
    mac.update(tail.bytes())
    verify.update(tail.bytes())
    let hash = hash.finish()
    let tag = mac.finish()
    assert(hex.encode(hash.slice(0, 32)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "hash survives suspension without input borrow")
    assert(hex.encode(tag.slice(0, 32)) == hex.encode(expected.slice(0, 32)), "HMAC key and chunks are not retained")
    assert(verify.verify(expected.slice(0, 32)), "verification survives suspension")
    42
}
fn crypto_stream_failed() @suspends -> Int32 {
    let key = "secret"
    var hash = Sha256.new()
    var mac = HmacSha256.new(key.bytes())
    hash.update(key.bytes())
    mac.update(key.bytes())
    task.yield_now()
    assert(false, "fail with live streaming states")
    42
}
fn hash_child(var state: Sha256) @suspends -> Sha256 {
    task.yield_now()
    let tail = "bc"
    state.update(tail.bytes())
    state
}
fn mac_child(var state: HmacSha256) @suspends -> HmacSha256 {
    task.yield_now()
    let tail = "bc"
    state.update(tail.bytes())
    state
}
fn crypto_stream_parallel() @suspends -> Int32 {
    let key = "key"
    let head = "a"
    var hash = Sha256.new()
    var mac = HmacSha256.new(key.bytes())
    hash.update(head.bytes())
    mac.update(head.bytes())
    let (hash, mac) = join { | hash_child(hash) | mac_child(mac) }
    let digest = hash.finish()
    assert(hex.encode(digest.slice(0, 32)) == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad", "hash owner moves to child and back")
    let input = "abc"
    let expected = crypto.hmac_sha256(key.bytes(), input.bytes())
    assert(mac.verify(expected.slice(0, 32)), "HMAC owner moves to child and back")
    crypto_stream_pending()
}
