import joky/float
extern fn dirty()
extern fn dirty_value(value: Float64) -> Float64
extern fn observe(value: Float64)
extern fn pause() @suspends

fn folded64() -> Float64 { 1.0 + 1.1102230246251565e-16 }
fn folded32() -> Float32 { 1.0 + 5.9604645e-8 }
fn folded_tiny() -> Float64 { 2.2250738585072014e-308 * 0.5 }
fn add64(a: Float64, b: Float64) -> Float64 { dirty(); a + b }
fn add32(a: Float32, b: Float32) -> Float32 { dirty(); a + b }
fn pure64(a: Float64, b: Float64) -> Float64 { a + b }
fn pure32(a: Float32, b: Float32) -> Float32 { a + b }
fn before_host64(a: Float64, b: Float64) -> Float64 { let value = a + b; dirty(); value }
fn host_value64(a: Float64, b: Float64) -> Float64 { dirty_value(a + b) + b }
fn branch64(a: Float64, b: Float64) -> Float64 {
    dirty()
    if a > 0.0 { a + b } else { a - b }
}
fn loop64(a: Float64, b: Float64) -> Float64 {
    var value = a
    var index = 0
    while index < 3 {
        dirty()
        value += b
        index += 1
    }
    value
}
fn loop32(a: Float32, b: Float32) -> Float32 {
    var value = a
    var index = 0
    while index < 3 {
        dirty()
        value += b
        index += 1
    }
    value
}
fn half(a: Float64) -> Float64 { dirty(); a * 0.5 }
fn half32(a: Float32) -> Float32 { dirty(); a * 0.5 }
fn buffer_helpers(a: Float64, b: Float64) -> Float64 {
    let values = [a, b]
    var total: Float64 = 0.0
    for value in &values {
        dirty()
        total += *value
    }
    total + values.get(1)!
}
fn buffer_bounds(a: Float64) -> Float64 {
    let values = [a]
    dirty()
    values.get(7)!
}
fn indirect(a: Float64, b: Float64) -> Float64 {
    let f = add64
    f(a, b)
}
fn closure_borrowed64(a: Float64, b: Float64) -> Float64 {
    let f = |x: Float64| { dirty(); x + b }
    f(a)
}
fn closure_move32(a: Float32, b: Float32) -> Float32 {
    let state = "closure"
    let f = move |x: Float32| {
        state.release()
        dirty()
        x + b
    }
    f(a)
}
fn integer_result() -> Int32 {
    if add64(1.0, 1.1102230246251565e-16) == 1.0 { 1 } else { 0 }
}
fn fail(a: Float64) -> Float64 {
    dirty()
    let n = 1 / 0
    a + float64(n)
}
struct State { value: Float64, text: String }
fn create() -> State { State { value: 2.2250738585072014e-308, text: "state" } }
fn update(state: &mut State) @noescape -> Float64 {
    dirty()
    state.value = state.value * 0.5
    state.value
}

fn cleanup(a: Float64) -> Float64 {
    let local = State { value: a, text: "task" }
    dirty()
    a
}
fn flowing(a: Float64, b: Float64) @suspends -> Float64 {
    let local = "task"
    pause()
    dirty()
    local.release()
    cleanup(a) + b
}
