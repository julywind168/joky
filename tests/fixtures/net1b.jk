import joky/array.{type Array}
import joky/task
extern fn net1b_make(input: UInt64) -> Socket
extern fn net1b_read(socket: &mut Socket, limit: UInt64) @suspends -> Array<UInt8>
fn inspect(bytes: Array<UInt8>) -> Int32 {
    if bytes.len()==4 && bytes.get(0).unwrap_or(1)==0 && bytes.get(1).unwrap_or(0)==128 && bytes.get(2).unwrap_or(0)==255 && bytes.get(3).unwrap_or(0)==42 {42} else {0}
}
fn receive() @suspends -> Int32 { var socket=net1b_make(1); inspect(net1b_read(&mut socket,4)) }
fn eof() @suspends -> Int32 { var socket=net1b_make(1); let bytes=net1b_read(&mut socket,4); if empty(bytes) {42} else {0} }
fn hold(socket: &mut Socket) @suspends { net1b_read(socket,4); }
fn instant() @suspends {}
fn timeout() @suspends -> Int32 { var socket=net1b_make(1); race { | hold(&mut socket) | task.sleep_ms(10) }; 42 }
fn fail_later() @suspends { task.sleep_ms(10); let ignored=1/0 }
fn sibling_failure() @suspends -> Int32 { var socket=net1b_make(1); parallel { | hold(&mut socket) | fail_later() }; 42 }
fn reuse() @suspends -> Int32 { var socket=net1b_make(1); race { | hold(&mut socket) | instant() }; inspect(net1b_read(&mut socket,4)) }
fn unstarted() @suspends -> Int32 { var socket=net1b_make(1); race { | instant() | hold(&mut socket) }; inspect(net1b_read(&mut socket,4)) }
fn dynamic() @suspends -> Int32 {
    var socket=net1b_make(1)
    scope { let view=&mut socket; branch {hold(view)}; task.yield_now() }
    let bytes=net1b_read(&mut socket,4)
    if empty(bytes) {42} else {0}
}
struct State { label:String }
fn create() -> State { State {label:"NET1b instance"} }
fn instance_read() @suspends { receive(); }

fn empty(bytes: Array<UInt8>) -> Bool {bytes.len()==0}
