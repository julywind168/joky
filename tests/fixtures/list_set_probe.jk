// LS0 feasibility only. This is not the public List or Set implementation.
import joky/array.{type Array}
import joky/element as element.{type Element}
import joky/map.{type Map}
import joky/slice as slices.{type Slice}
import joky/option.{type Option, Some, None}
import joky/drop.{type Drop}
import joky/eq.{type BorrowEq}
import joky/hash.{type BorrowHash}
import joky/check.{require}
import joky/string
import joky/mem
extern fn record_int(value: Int32)
fn ensure(condition: Bool, message: String) { require(condition, &message) }

struct Links { prev: Option<UInt64>, next: Option<UInt64>, value_index: UInt64 }
enum NodeSlot { Used(Links), Free(Option<UInt64>) }
pub struct ListProbe<T> {
    values: Array<T>, owners: Array<UInt64>, slots: Array<NodeSlot>,
    head: Option<UInt64>, tail: Option<UInt64>, free: Option<UInt64>
}
fn links<T>(list: &ListProbe<T>, slot: UInt64) -> Links {
    match list.slots.get(slot) {
        | Some(NodeSlot.Used(value)) => value
        | _ => {
            ensure(false, "Invalid probe slot")
            Links { prev: None, next: None, value_index: 0 }
        }
    }
}
pub fn three<T>(a: T, b: T, c: T) -> ListProbe<T> {
    var values = Array.new::<T>()
    values.push(a) values.push(b) values.push(c)
    var owners = Array.new::<UInt64>()
    owners.push(0) owners.push(1) owners.push(2)
    var slots = Array.new::<NodeSlot>()
    slots.push(NodeSlot.Used(Links { prev: None, next: Some(1), value_index: 0 }))
    slots.push(NodeSlot.Used(Links { prev: Some(0), next: Some(2), value_index: 1 }))
    slots.push(NodeSlot.Used(Links { prev: Some(1), next: None, value_index: 2 }))
    ListProbe { values: values, owners: owners, slots: slots, head: Some(0), tail: Some(2), free: None }
}
impl<T> ListProbe<T> {
    pub fn len(&self) -> UInt64 { self.values.len() }
    pub fn get(&self, slot: UInt64) -> Option<T> { self.values.get(links(self, slot).value_index) }
    pub fn borrow(&self, slot: UInt64) -> &Element<T> { self.values.borrow(links(self, slot).value_index) }
    pub fn borrow_mut(&mut self, slot: UInt64) -> &mut Element<T> {
        let index = links(self, slot).value_index
        self.values.borrow_mut(index)
    }
    pub fn borrow_ref(&self, slot: UInt64) -> &T { self.values.borrow_ref(links(self, slot).value_index) }
    pub fn borrow_mut_ref(&mut self, slot: UInt64) -> &mut T {
        let index = links(self, slot).value_index
        self.values.borrow_mut_ref(index)
    }
    pub fn pop_front(&mut self) -> Option<T> {
        let slot = match self.head { | None => return None | Some(slot) => slot }
        let current = links(self, slot)
        let value = self.values.swap_remove(current.value_index)
        self.owners.swap_remove(current.value_index)
        if current.value_index < self.values.len() {
            let moved = match self.owners.get(current.value_index) {
                | Some(value) => value
                | None => { ensure(false, "Invalid probe owner") 0 }
            }
            var moved_links = links(self, moved)
            moved_links.value_index = current.value_index
            self.slots.set(moved, NodeSlot.Used(moved_links));
        }
        self.head = current.next
        match current.next {
            | None => { self.tail = None }
            | Some(next) => {
                var next_links = links(self, next)
                next_links.prev = None
                self.slots.set(next, NodeSlot.Used(next_links));
            }
        }
        let previous_free = self.free
        self.slots.set(slot, NodeSlot.Free(previous_free))
        self.free = Some(slot)
        value
    }
}

pub struct SetProbe<T> { items: Map<T, Unit> }
impl<T> SetProbe<T> {
    pub fn new() -> Self { SetProbe { items: Map.new::<T, Unit>() } }
    pub fn len(&self) -> UInt64 { self.items.len() }
    pub fn elements(&self) -> &Slice<T> { self.items.keys() }
    pub fn pop(&mut self) -> Option<T> {
        match self.items.pop() { | None => None | Some((key, _)) => Some(key) }
    }
}
pub fn contains<T: BorrowEq + BorrowHash>(set: &SetProbe<T>, value: &T) @noescape(value) -> Bool {
    set.items.contains_key_by_ref(value)
}
pub fn remove<T: BorrowEq + BorrowHash>(set: &mut SetProbe<T>, value: &T) @noescape(value) -> Bool {
    set.items.remove_by_ref(value).is_some()
}
impl<T: BorrowEq + BorrowHash> SetProbe<T> {
    pub fn insert(&mut self, value: T) -> Bool { self.items.insert(value, {}).is_none() }
    pub fn contains(&self, value: &T) @noescape(value) -> Bool { contains(self, value) }
    pub fn remove(&mut self, value: &T) @noescape(value) -> Bool { remove(self, value) }
}

pub struct Tracked { pub id: Int32, pub group: Int32, text: String }
impl Drop for Tracked { fn drop(&mut self) { record_int(self.id) } }
impl BorrowEq for Tracked {
    fn eq_ref(&self, other: &Self) -> Bool { self.group == other.group }
}
impl BorrowHash for Tracked { fn hash_ref(&self) -> UInt64 { 0 } }
pub fn tracked(id: Int32, group: Int32) -> Tracked {
    let value = Tracked { id: id, group: group, text: "owned" }
    record_int(-id)
    value
}
// List cases.
pub fn list_moves() -> Int32 {
    var list = three(tracked(1, 42), tracked(2, 20), tracked(3, 22))
    let removed = list.pop_front()
    ensure(list.len() == 2, "Probe length")
    ensure(links(&list, 2).value_index == 0 && list.owners.get(0).unwrap_or(99) == 2, "Probe moved index")
    ensure(list.head.unwrap_or(99) == 1 && list.tail.unwrap_or(99) == 2, "Probe endpoints")
    ensure(links(&list, 1).prev.is_none() && links(&list, 1).next.unwrap_or(99) == 2, "Probe links")
    match list.slots.get(0) { | Some(NodeSlot.Free(next)) => ensure(next.is_none(), "Probe free link") | _ => ensure(false, "Probe free slot") }
    ensure(list.free.unwrap_or(99) == 0, "Probe free head")
    ensure(list.borrow_ref(1).group + list.borrow_ref(2).group == 42, "Probe remapped values")
    record_int(100)
    mem.drop(list)
    record_int(200)
    match removed { | Some(value) => value.group | None => 0 }
}
pub fn list_borrows() -> Int32 {
    var list = three(tracked(1, 1), tracked(2, 2), tracked(3, 3))
    let view = list.borrow_mut_ref(1)
    view.group = 42
    ensure(list.borrow_ref(1).group == 42, "Probe borrow recovery")
    mem.drop(list.pop_front())
    let second = list.pop_front()
    ensure(list.borrow_ref(2).group == 3, "Probe second remap")
    mem.drop(list.pop_front())
    ensure(list.pop_front().is_none() && list.tail.is_none(), "Probe empty")
    match second { | Some(value) => value.group | None => 0 }
}
pub fn list_types() -> Int32 {
    var ints = three(20, 21, 22)
    let view = ints.borrow(1)
    ensure(element.read(view) == 21, "Probe Copy view")
    element.write(ints.borrow_mut(1), 20)
    ints.pop_front()
    ensure(ints.get(1).unwrap_or(0) + ints.get(2).unwrap_or(0) == 42, "Probe Copy values")
    var units = three({}, {}, {})
    ensure(units.pop_front().is_some() && units.len() == 2, "Probe Unit")
    let node = (&*(alloc(42)))
    var refs = three(node, node, node)
    let copied = refs.pop_front().unwrap_or(node)
    mem.drop(refs)
    ensure((*copied) == 42, "Probe shared source")
    var a = Array.new::<Int32>()
    a.push(42)
    var nested = three(a, Array.new::<Int32>(), Array.new::<Int32>())
    nested.borrow_mut_ref(1).push(9)
    let first = nested.pop_front()
    mem.drop(nested)
    match first { | Some(value) => value.get(0).unwrap_or(0) | None => 0 }
}
// Set cases.
pub fn set_strings() -> Int32 {
    var set = SetProbe.new::<String>()
    ensure(set.insert("alpha"), "Probe new String")
    ensure(!set.insert("alpha") && set.len() == 1, "Probe duplicate String")
    let view = set.elements()
    ensure(slices.borrow_ref(view, 0).byte_length() == 5, "Probe String view")
    var query = "alpha"
    ensure(set.contains(query) && contains(&set, &query), "Probe borrowed query")
    ensure(set.remove(query) && query.byte_length() == 5, "Probe borrowed removal")
    query = "replacement"
    ensure(query.byte_length() == 11 && set.len() == 0, "Probe query lifetime")
    var copy = SetProbe.new::<Int32>()
    ensure(copy.insert(42) && copy.contains(42), "Probe Copy protocol")
    var units = SetProbe.new::<Unit>()
    ensure(units.insert({}) && !units.insert({}), "Probe Unit key")
    match copy.pop() { | Some(value) => value | None => 0 }
}
pub fn set_duplicates() -> Int32 {
    var set = SetProbe.new::<Tracked>()
    ensure(set.insert(tracked(1, 7)), "Probe first instance")
    ensure(!set.insert(tracked(2, 7)), "Probe repeated instance")
    ensure(slices.borrow_ref(set.elements(), 0).id == 1, "Probe representative")
    let query = tracked(3, 7)
    ensure(set.contains(&query), "Probe owned query")
    record_int(100)
    ensure(set.remove(&query), "Probe remove instance")
    record_int(200)
    ensure(query.id == 3 && !set.contains(&query), "Probe query remains owned")
    42
}
pub fn set_transfer() -> Int32 {
    var set = SetProbe.new::<Tracked>()
    set.insert(tracked(1, 42))
    set.insert(tracked(2, 42))
    let result = set.pop()
    mem.drop(set)
    record_int(100)
    match result { | Some(value) => value.group | None => 0 }
}
