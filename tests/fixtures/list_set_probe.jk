// Retained LS0 Set feasibility. List is covered by production regressions.
import joky/map.{type Map}
import joky/slice as slices.{type Slice}
import joky/option.{type Option, Some, None}
import joky/drop.{type Drop}
import joky/eq.{type BorrowEq}
import joky/hash.{type BorrowHash}
import joky/check.{require}
import joky/string
import joky/mem
extern fn record_int(value: Int32)
fn ensure(condition: Bool, message: String) { require(condition, &message) }

pub struct SetProbe<T> { items: Map<T, Unit> }
impl<T> SetProbe<T> {
    pub fn new() -> Self { SetProbe { items: Map.new::<T, Unit>() } }
    pub fn len(&self) -> UInt64 { self.items.len() }
    pub fn elements(&self) -> &Slice<T> { self.items.keys() }
    pub fn pop(&mut self) -> Option<T> {
        match self.items.pop() { | None => None | Some((key, _)) => Some(key) }
    }
}
pub fn contains<T: BorrowEq + BorrowHash>(set: &SetProbe<T>, value: &T) @noescape(value) -> Bool {
    set.items.contains_key_by_ref(value)
}
pub fn remove<T: BorrowEq + BorrowHash>(set: &mut SetProbe<T>, value: &T) @noescape(value) -> Bool {
    set.items.remove_by_ref(value).is_some()
}
impl<T: BorrowEq + BorrowHash> SetProbe<T> {
    pub fn insert(&mut self, value: T) -> Bool { self.items.insert(value, {}).is_none() }
    pub fn contains(&self, value: &T) @noescape(value) -> Bool { contains(self, value) }
    pub fn remove(&mut self, value: &T) @noescape(value) -> Bool { remove(self, value) }
}

pub struct Tracked { pub id: Int32, pub group: Int32, text: String }
impl Drop for Tracked { fn drop(&mut self) { record_int(self.id) } }
impl BorrowEq for Tracked {
    fn eq_ref(&self, other: &Self) -> Bool { self.group == other.group }
}
impl BorrowHash for Tracked { fn hash_ref(&self) -> UInt64 { 0 } }
pub fn tracked(id: Int32, group: Int32) -> Tracked {
    let value = Tracked { id: id, group: group, text: "owned" }
    record_int(-id)
    value
}
// Set cases.
pub fn set_strings() -> Int32 {
    var set = SetProbe.new::<String>()
    ensure(set.insert("alpha"), "Probe new String")
    ensure(!set.insert("alpha") && set.len() == 1, "Probe duplicate String")
    let view = set.elements()
    ensure(slices.borrow_ref(view, 0).byte_length() == 5, "Probe String view")
    var query = "alpha"
    ensure(set.contains(query) && contains(&set, &query), "Probe borrowed query")
    ensure(set.remove(query) && query.byte_length() == 5, "Probe borrowed removal")
    query = "replacement"
    ensure(query.byte_length() == 11 && set.len() == 0, "Probe query lifetime")
    var copy = SetProbe.new::<Int32>()
    ensure(copy.insert(42) && copy.contains(42), "Probe Copy protocol")
    var units = SetProbe.new::<Unit>()
    ensure(units.insert({}) && !units.insert({}), "Probe Unit key")
    match copy.pop() { | Some(value) => value | None => 0 }
}
pub fn set_duplicates() -> Int32 {
    var set = SetProbe.new::<Tracked>()
    ensure(set.insert(tracked(1, 7)), "Probe first instance")
    ensure(!set.insert(tracked(2, 7)), "Probe repeated instance")
    ensure(slices.borrow_ref(set.elements(), 0).id == 1, "Probe representative")
    let query = tracked(3, 7)
    ensure(set.contains(&query), "Probe owned query")
    record_int(100)
    ensure(set.remove(&query), "Probe remove instance")
    record_int(200)
    ensure(query.id == 3 && !set.contains(&query), "Probe query remains owned")
    42
}
pub fn set_transfer() -> Int32 {
    var set = SetProbe.new::<Tracked>()
    set.insert(tracked(1, 42))
    set.insert(tracked(2, 42))
    let result = set.pop()
    mem.drop(set)
    record_int(100)
    match result { | Some(value) => value.group | None => 0 }
}
