// JSON0 capability probe only: these finite types do not parse or encode JSON.
import joky/array.{type Array}
import joky/map.{type Map}
import joky/string.{type StringBuilder}
import joky/integer
import joky/mem
import joky/check.{assert}
import joky/task

enum Atom { Nil, Flag(Bool), Text(String), Numeric(String) }
enum Group { Items(Array<Atom>), Fields(Map<String, Atom>) }
struct Tracked { id: Int32, groups: Array<Group> }

fn ensure(ok: Bool) { let message = "JSON0 existing primitive capability"; assert(ok, &message) }
fn equals(atom: &Atom, expected: &String) -> Bool {
    match atom { Text(text) => text == expected, Numeric(text) => text == expected, _ => false }
}
fn groups() -> Array<Group> {
    var values = Array.new::<Atom>()
    values.push(Atom.Nil)
    values.push(Atom.Flag(true))
    values.push(Atom.Text("你\0🙂"))
    values.push(Atom.Numeric("18446744073709551616"))
    var fields = Map.new::<String, Atom>()
    fields.insert("value", Atom.Numeric("1e400"));
    fields.insert("empty", Atom.Text(""));
    var groups = Array.new::<Group>()
    groups.push(Group.Items(values))
    groups.push(Group.Fields(fields))
    groups
}
fn inspect(groups: &Array<Group>) {
    ensure(groups.len() == 2)
    match groups.borrow_ref(0) {
        Items(values) => {
            ensure(values.len() == 4)
            match values.borrow_ref(0) { Nil => {}, _ => ensure(false) }
            match values.borrow_ref(1) { Flag(flag) => ensure(flag), _ => ensure(false) }
            let expected = "你\0🙂"
            ensure(equals(values.borrow_ref(2), &expected))
            let expected = "18446744073709551616"
            ensure(equals(values.borrow_ref(3), &expected))
        }
        _ => ensure(false)
    }
    match groups.borrow_ref(1) {
        Fields(fields) => {
            let key = "value"
            ensure(fields.contains_key(&key))
            let expected = "1e400"
            ensure(equals(fields.borrow_ref(&key), &expected))
        }
        _ => ensure(false)
    }
}
fn mutate(groups: &mut Array<Group>) {
    match groups.borrow_mut_ref(0) {
        Items(values) => {
            values.replace(2, Atom.Text("updated"));
            let expected = "updated"
            ensure(equals(values.borrow_ref(2), &expected))
        }
        _ => ensure(false)
    }
    match groups.borrow_mut_ref(1) {
        Fields(fields) => {
            let key = "value"
            mem.replace(fields.borrow_mut_ref(&key), Atom.Numeric("-0"));
            let expected = "-0"
            ensure(equals(fields.borrow_ref(&key), &expected))
        }
        _ => ensure(false)
    }
}
fn numbers() {
    let maximum: UInt64 = 18446744073709551615
    let expected = "18446744073709551615"
    ensure(maximum.to_string() == expected)
    let minimum: Int64 = -9223372036854775808
    let expected = "-9223372036854775808"
    ensure(minimum.to_string() == expected)
    let large: UInt64 = 9007199254740993
    ensure(float64(large).to_bits() == float64(large - 1).to_bits())
    let expected = "-0"
    ensure((-0.0).to_text() == expected)
    ensure(!Float64.NAN.is_finite() && !Float64.INFINITY.is_finite())
    // Existing fixed decimal formatting can exceed a 256-byte token limit.
    let smallest = Float64.from_bits(1).to_text()
    let largest = Float64.from_bits(0x7fefffffffffffff).to_text()
    ensure(smallest.byte_length() > 256 && smallest.byte_length() <= 1024)
    ensure(largest.byte_length() > 256 && largest.byte_length() <= 1024)
    // Preserve numeric spelling without assuming a machine-number conversion.
    let source = "-0.00e+400"
    let copy = source.clone()
    ensure(copy == source)
}
fn unicode() {
    ensure(Rune.from_u32(0xd800).is_none() && Rune.from_u32(0xdfff).is_none())
    var builder = StringBuilder.new()
    builder.push('\0')
    builder.push(Rune.from_u32(0x1f642).unwrap_or('\0'))
    let text = builder.finish()
    let expected = "\0🙂"
    ensure(text == expected && text.byte_length() == 5)
    var invalid = Array.new::<UInt8>()
    invalid.push(0xed); invalid.push(0xa0); invalid.push(0x80)
    match String.from_utf8(invalid) { Err(error) => ensure(error.offset == 0), _ => ensure(false) }
}
fn hold(owner: &Tracked) @suspends {
    task.sleep(100s)
    ensure(owner.id == 42)
}
fn main() @suspends -> Int32 {
    numbers()
    unicode()
    var owner = Tracked { id: 42, groups: groups() }
    task.yield_now()
    inspect(&owner.groups)
    mutate(&mut owner.groups)
    race { hold(&owner), task.yield_now() }
    ensure(owner.groups.len() == 2)
    0
}
