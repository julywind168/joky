import joky/internal/int_map as maps.{type IntMap}
import joky/check.{require}
extern fn print_int(value: Int32)
fn basic() -> Int32 {
    var m = IntMap.new::<Int32>()
    require(m.len() == 0 && m.capacity() == 0 && m.is_empty(), "Empty map")
    require(!m.contains_key(0) && m.get(0).is_none() && m.remove(0).is_none(), "Empty lookup")
    require(m.insert(0, 10).is_none(), "New zero")
    require(m.insert(-1, 20).is_none(), "New negative")
    require(m.insert(Int32.MIN, 30).is_none() && m.insert(Int32.MAX, 40).is_none(), "Boundary keys")
    let cap = m.capacity()
    var i = 0
    while i < 16 { require(m.insert(-1, i).unwrap_or(-1) == if i == 0 { 20 } else { i - 1 }, "Replacement") i = i + 1 }
    require(m.len() == 4 && m.capacity() == cap && maps.invariant(&m), "Replacement metadata")
    require(m.get(Int32.MIN).unwrap_or(0) == 30 && m.get(Int32.MAX).unwrap_or(0) == 40, "Boundary read")
    require(m.remove(0).unwrap_or(0) == 10 && m.remove(Int32.MIN).unwrap_or(0) == 30, "Boundary removal")
    require(m.get(-1).unwrap_or(0) == 15 && m.get(Int32.MAX).unwrap_or(0) == 40 && maps.invariant(&m), "Moved entry")
    m.reserve(0)
    m.release()
    42
}
fn collisions() -> Int32 {
    var m = IntMap.with_capacity::<Int32>(6)
    m.insert(9, 1) m.insert(19, 2) m.insert(33, 3) m.insert(44, 4)
    require(m.remove(19).unwrap_or(0) == 2 && maps.invariant(&m), "Cluster middle")
    require(m.get(44).unwrap_or(0) == 4 && m.get(33).unwrap_or(0) == 3, "Deleted probe")
    require(m.insert(33, 30).unwrap_or(0) == 3 && m.len() == 3, "Deleted before existing")
    m.insert(49, 5)
    require(maps.deleted_count(&m) == 0 && maps.invariant(&m), "Reuse deleted")
    m.remove(9) m.remove(44)
    require(m.get(33).unwrap_or(0) == 30 && m.get(49).unwrap_or(0) == 5, "Cluster ends")
    m.remove(33) m.remove(49)
    require(m.is_empty() && maps.invariant(&m), "All deleted")
    m.insert(52, 6) m.insert(61, 7)
    require(m.get(52).unwrap_or(0) == 6 && maps.invariant(&m), "Reinsert")
    let cap = m.capacity()
    m.clear()
    require(m.capacity() == cap && maps.deleted_count(&m) == 0 && maps.invariant(&m), "Clear capacity")
    42
}
fn capacities() -> Int32 {
    require(maps.bucket_count(0, 0) == 0 && maps.bucket_count(6, 8) == 8, "Small bucket count")
    require(maps.bucket_count(7, 25) == 16 && maps.bucket_count(12, 25) == 16 && maps.bucket_count(13, 32) == 32, "Bucket boundaries")
    var m = IntMap.with_capacity::<Int32>(6)
    var key = 0
    while key < 6 { m.insert(key, key) key = key + 1 }
    m.remove(0) m.remove(1) m.remove(2)
    let cap = m.capacity()
    m.reserve(3)
    require(m.capacity() == cap && maps.deleted_count(&m) == 0 && maps.invariant(&m), "Same capacity rehash")
    m.insert(10, 10) m.insert(11, 11) m.insert(12, 12)
    m.insert(13, 13)
    require(m.capacity() > cap && maps.invariant(&m), "Growth threshold")
    var i = 14
    while i < 80 { m.insert(i, i) require(maps.invariant(&m), "Growth invariant") i = i + 1 }
    m.reserve(17)
    let reserved = m.capacity()
    i = 80
    while i < 97 { m.insert(i, i) require(m.capacity() == reserved && maps.invariant(&m), "Reserve promise") i = i + 1 }
    42
}
fn capacity_failure() -> Int32 {
    var m = IntMap.new::<Int32>() m.insert(1, 1)
    m.reserve(UInt64.MAX)
    0
}
fn bucket_limit_failure() -> Int32 { int32(maps.bucket_count(13, 25)) }
fn oracle_sequence() -> Int32 {
    var m = IntMap.new::<Int32>()
    var rng: UInt32 = 123456789
    var step: UInt32 = 0
    while step < 192 {
        rng = rng * 1664525 + 1013904223
        let key = int32((rng >> 8) & 63) - 32
        let value = int32(rng & 0x7fffffff)
        let op = (rng >> 16) & 7
        var result = 0
        if op <= 1 || op == 7 { result = m.insert(key, value).unwrap_or(-1) }
        else {
            if op == 2 { result = m.remove(key).unwrap_or(-1) }
            else {
                if op == 3 { result = m.get(key).unwrap_or(-1) }
                else {
                    if op == 4 { m.reserve(uint64(rng & 7)) }
                    else {
                        if op == 5 && (step & 31) == 0 { m.clear() }
                        else { if op == 6 { result = if m.contains_key(key) { 1 } else { 0 } } else { result = m.insert(key, value).unwrap_or(-1) } }
                    }
                }
            }
        }
        require(maps.invariant(&m), "Oracle index invariant")
        var scan = -32
        var digest = 0
        while scan < 32 {
            let current = m.get(scan)
            print_int(current.unwrap_or(-1))
            match current { | Some(v) => { digest = digest + v * (scan + 33) } | None => {} }
            scan = scan + 1
        }
        print_int(result) print_int(int32(m.len())) print_int(digest)
        step = step + 1
    }
    42
}
fn main() { print_int(basic()) print_int(collisions()) print_int(capacities()) print_int(oracle_sequence()) }
