import joky/map as maps.{type Map}
import joky/check.{require}
extern fn print_int(value: Int32)
fn basic() -> Int32 {
    var m = Map.new::<Int32, Int32>()
    { let assertion_condition = m.len() == 0 && m.capacity() == 0 && m.is_empty() let assertion_message = "Empty map" require(assertion_condition, &assertion_message) }
    { let assertion_condition = !m.contains_key(0) && m.get(0).is_none() && m.remove(0).is_none() let assertion_message = "Empty lookup" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.insert(0, 10).is_none() let assertion_message = "New zero" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.insert(-1, 20).is_none() let assertion_message = "New negative" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.insert(Int32.MIN, 30).is_none() && m.insert(Int32.MAX, 40).is_none() let assertion_message = "Boundary keys" require(assertion_condition, &assertion_message) }
    let cap = m.capacity()
    var i = 0
    while i < 16 { { let assertion_condition = m.insert(-1, i).unwrap_or(-1) == if i == 0 { 20 } else { i - 1 } let assertion_message = "Replacement" require(assertion_condition, &assertion_message) } i = i + 1 }
    { let assertion_condition = m.len() == 4 && m.capacity() == cap && maps.test_invariant(&m) let assertion_message = "Replacement metadata" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.get(Int32.MIN).unwrap_or(0) == 30 && m.get(Int32.MAX).unwrap_or(0) == 40 let assertion_message = "Boundary read" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.remove(0).unwrap_or(0) == 10 && m.remove(Int32.MIN).unwrap_or(0) == 30 let assertion_message = "Boundary removal" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.get(-1).unwrap_or(0) == 15 && m.get(Int32.MAX).unwrap_or(0) == 40 && maps.test_invariant(&m) let assertion_message = "Moved entry" require(assertion_condition, &assertion_message) }
    m.reserve(0)
    m.release()
    42
}
fn collisions() -> Int32 {
    var m = Map.with_capacity::<Int32, Int32>(6)
    m.insert(9, 1) m.insert(19, 2) m.insert(33, 3) m.insert(44, 4)
    { let assertion_condition = m.remove(19).unwrap_or(0) == 2 && maps.test_invariant(&m) let assertion_message = "Cluster middle" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.get(44).unwrap_or(0) == 4 && m.get(33).unwrap_or(0) == 3 let assertion_message = "Deleted probe" require(assertion_condition, &assertion_message) }
    { let assertion_condition = m.insert(33, 30).unwrap_or(0) == 3 && m.len() == 3 let assertion_message = "Deleted before existing" require(assertion_condition, &assertion_message) }
    m.insert(49, 5)
    { let assertion_condition = maps.test_deleted_count(&m) == 0 && maps.test_invariant(&m) let assertion_message = "Reuse deleted" require(assertion_condition, &assertion_message) }
    m.remove(9) m.remove(44)
    { let assertion_condition = m.get(33).unwrap_or(0) == 30 && m.get(49).unwrap_or(0) == 5 let assertion_message = "Cluster ends" require(assertion_condition, &assertion_message) }
    m.remove(33) m.remove(49)
    { let assertion_condition = m.is_empty() && maps.test_invariant(&m) let assertion_message = "All deleted" require(assertion_condition, &assertion_message) }
    m.insert(52, 6) m.insert(61, 7)
    { let assertion_condition = m.get(52).unwrap_or(0) == 6 && maps.test_invariant(&m) let assertion_message = "Reinsert" require(assertion_condition, &assertion_message) }
    let cap = m.capacity()
    m.clear()
    { let assertion_condition = m.capacity() == cap && maps.test_deleted_count(&m) == 0 && maps.test_invariant(&m) let assertion_message = "Clear capacity" require(assertion_condition, &assertion_message) }
    42
}
fn capacities() -> Int32 {
    { let assertion_condition = maps.test_bucket_count(0, 0) == 0 && maps.test_bucket_count(6, 8) == 8 let assertion_message = "Small bucket count" require(assertion_condition, &assertion_message) }
    { let assertion_condition = maps.test_bucket_count(7, 25) == 16 && maps.test_bucket_count(12, 25) == 16 && maps.test_bucket_count(13, 32) == 32 let assertion_message = "Bucket boundaries" require(assertion_condition, &assertion_message) }
    var m = Map.with_capacity::<Int32, Int32>(6)
    var key = 0
    while key < 6 { m.insert(key, key) key = key + 1 }
    m.remove(0) m.remove(1) m.remove(2)
    let cap = m.capacity()
    m.reserve(3)
    { let assertion_condition = m.capacity() == cap && maps.test_deleted_count(&m) == 0 && maps.test_invariant(&m) let assertion_message = "Same capacity rehash" require(assertion_condition, &assertion_message) }
    m.insert(10, 10) m.insert(11, 11) m.insert(12, 12)
    m.insert(13, 13)
    { let assertion_condition = m.capacity() > cap && maps.test_invariant(&m) let assertion_message = "Growth threshold" require(assertion_condition, &assertion_message) }
    var i = 14
    while i < 80 { m.insert(i, i) { let assertion_condition = maps.test_invariant(&m) let assertion_message = "Growth invariant" require(assertion_condition, &assertion_message) } i = i + 1 }
    m.reserve(17)
    let reserved = m.capacity()
    i = 80
    while i < 97 { m.insert(i, i) { let assertion_condition = m.capacity() == reserved && maps.test_invariant(&m) let assertion_message = "Reserve promise" require(assertion_condition, &assertion_message) } i = i + 1 }
    42
}
fn capacity_failure() -> Int32 {
    var m = Map.new::<Int32, Int32>() m.insert(1, 1)
    m.reserve(UInt64.MAX)
    0
}
fn bucket_limit_failure() -> Int32 { int32(maps.test_bucket_count(13, 25)) }
fn main() { print_int(basic()) print_int(collisions()) print_int(capacities()) }
