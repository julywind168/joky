import joky/slice as slices.{type Slice}
pub type Region<T> = Slice<T>
pub fn tail<T>(values: &Region<T>) -> &Slice<T> { slices.slice(values, 1, slices.len(values)) }
pub fn tail_mut<T>(values: &mut Region<T>) -> &mut Slice<T> {
    let end = slices.len(values)
    slices.slice_mut(values, 1, end)
}
pub fn first<T>(values: &Region<T>) -> &T { slices.borrow_ref(values, 0) }
pub fn first_mut<T>(values: &mut Region<T>) -> &mut T { slices.borrow_mut_ref(values, 0) }
