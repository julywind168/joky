import joky/eq.{type Eq as Equal}
import joky/hash.{type Hash as Hashed}
import joky/check.{assert, panic}
import joky/array.{type Array}
import joky/map.{type Map}
import joky/clone.{type Clone}
import joky/task
extern fn record_int(value: Int32)
struct Key<T> { value: T }
impl<T: Equal> Equal for Key<T> { fn eq(&self, other: &Self) -> Bool { self.value == other.value } }
impl<T: Hashed> Hashed for Key<T> { fn hash(&self) -> UInt64 { Hashed.hash(&self.value) } }
// Inherent names must not replace the selected trait requirements.
impl<T> Key<T> {
    fn eq(&self, other: &Self) -> Bool { false }
    fn hash(&self) -> UInt64 { 0 }
}
fn same<K: Equal + Hashed>(a: &K, b: &K) -> Bool { a.eq(b) && a.hash() == b.hash() }
fn equal<T: Equal>(a: &T, b: &T) -> Bool { a == b }
fn next(count: &mut Int32, expected: Int32) -> Key<String> {
    assert(*count == expected, "Equality operand order")
    *count += 1
    Key { value: "owned" }
}
#derive(Eq, Hash)
enum Choice { Empty, Text(String), Other(String), Number(Int32) }
#derive(Clone, Eq, Hash)
struct Derived<T, Unused> { value: T, code: Int32 }
#derive(Eq, Hash)
struct Nested<T> { value: Key<T> }
#derive(Eq, Hash)
struct Empty {}
#derive(Eq, Hash)
enum Single<T> { Value(T) }
#derive(Eq)
struct Floating { value: Float64 }
enum Tag { One, Two }
impl Equal for Tag { fn eq(&self, other: &Self) -> Bool { true } }
enum PlainTag { One, Two }
fn equality_pending() @suspends -> Int32 {
    var count = 0
    let different = next(&mut count, 0) != {
        task.yield_now()
        task.yield_now()
        next(&mut count, 1)
    }
    assert(!different && count == 2, "Equality operands survive suspension")
    42
}
struct Failing { text: String }
impl Equal for Failing {
    fn eq(&self, other: &Self) -> Bool { panic("Eq comparison failed") }
}
#derive(Eq)
struct Guarded { first: Int32, rest: Failing }
fn equality_failed() { let _same = Failing { text: "left" } != Failing { text: "right" } }
fn equality_failed_derived() { let _same = Guarded { first: 1, rest: Failing { text: "a" } } == Guarded { first: 1, rest: Failing { text: "b" } } }
fn equality_failed_rhs() { let _same = Key { value: "left" } == { panic("Eq argument failed") } }
fn derived_protocols() {
    let a = Derived::<String, fn() -> Unit> { value: "owned", code: 7 }
    let b = Clone.clone(&a)
    assert(same(&a, &b), "Derived generic owner protocols")
    assert(a != Derived::<String, fn() -> Unit> { value: "owned", code: 8 }, "All fields participate")
    assert(a.value == "owned" && b.value == "owned", "Derived protocols preserve owners")
    assert(same(Nested { value: Key { value: "nested" } }, Nested { value: Key { value: "nested" } }), "Derived conditional fields use standard traits")
    assert(same(Empty {}, Empty {}), "Empty derived records")
    assert(same(Single.Value(42), Single.Value(42)), "Single Copy variant")
    assert(same(Single.Value("payload"), Single.Value("payload")), "Single owning variant")
    assert(same(Choice.Text("same"), Choice.Text("same")), "Derived enum hash equality")
    assert(Choice.Text("a") != Choice.Text("b") && Choice.Number(1) != Choice.Number(2), "Enum payload comparison")
    assert(same(Choice.Number(42), Choice.Number(42)) && same(Choice.Empty, Choice.Empty), "Copy and empty variant protocols")
    assert(Choice.Text("same") != Choice.Other("same") && Hashed.hash(Choice.Text("same")) != Hashed.hash(Choice.Other("same")), "Enum tag participates in equality and hashing")
    assert(Guarded { first: 1, rest: Failing { text: "a" } } != Guarded { first: 2, rest: Failing { text: "b" } }, "Derived equality short circuits")
    assert(Floating { value: -0.0 } == Floating { value: 0.0 }, "Derived IEEE zero equality")
    assert(Floating { value: Float64.NAN } != Floating { value: Float64.NAN }, "Derived IEEE NaN equality")
    var table = Map.new::<Derived<String, fn() -> Unit>, Int32>()
    table.insert(a, 42)
    assert(table.get(&b)! == 42 && b.code == 7, "Derived owning Map key")
}
fn protocols() -> Int32 {
    derived_protocols()
    { let assertion_condition = Hashed.hash(int32(0)) == 0 && Hashed.hash(int32(1)) == 6238072747940578789; let assertion_message = "Small hash vectors"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Hashed.hash(int32(42)) == 12058926934050108962; let assertion_message = "Hash 42"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Hashed.hash(Int32.MAX) == 8876943580449041804 && Hashed.hash(Int32.MIN) == 11926543287740443804; let assertion_message = "Int32 hash vectors"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Hashed.hash(Int64.MAX) == 6514504133438201533 && Hashed.hash(Int64.MIN) == 2720858781877447050; let assertion_message = "Int64 hash vectors"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Hashed.hash(UInt32.MAX) == 10030294862651378044; let assertion_message = "UInt32 hash vector"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Hashed.hash(int32(-1)) == 13029008266876403067 && Hashed.hash(UInt64.MAX) == 13029008266876403067; let assertion_message = "Unsigned conversion"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Hashed.hash(false) == 0 && Hashed.hash(true) == 6238072747940578789 && Hashed.hash({}) == 0; let assertion_message = "Bool and Unit hashes"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = same(Key { value: int32(42) }, Key { value: int32(42) }); let assertion_message = "Fixed trait method"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = !same(Key { value: int32(42) }, Key { value: int32(43) }); let assertion_message = "Unequal records"; assert(assertion_condition, &assertion_message) }
    let owner = Key { value: "owned" }
    assert(same(&owner, Key { value: "owned" }), "Owning conditional key protocols")
    assert(owner.value == "owned", "Key protocols preserve owning fields")
    assert(Equal.eq(-0.0, 0.0) && !Equal.eq(Float64.NAN, Float64.NAN), "IEEE equality")
    assert(owner == Key { value: "owned" } && owner != Key { value: "different" }, "Fixed Eq operator dispatch")
    var other = Key { value: "owned" }
    assert(&owner == &mut other && equal(&owner, &other), "Borrowed equality")
    let values = [Key { value: "owned" }]
    assert(values[0] == owner && owner == values[0], "Owning indexed operands")
    assert(owner.value == "owned" && values[0].value == "owned", "Operators preserve owners")
    var count = 0
    assert(next(&mut count, 0) == next(&mut count, 1) && count == 2, "Operands evaluated once")
    assert(Choice.Text("a") == Choice.Text("a") && Choice.Text("a") != Choice.Empty, "Payload enum equality")
    assert(Tag.One == Tag.Two && !(Tag.One != Tag.Two), "Explicit enum Eq overrides tag equality")
    assert(PlainTag.One == PlainTag.One && PlainTag.One != PlainTag.Two, "Default tag equality")
    assert(equal(42, 42) && equal("a", "a") && equal({}, {}), "Generic primitive equality")
    let number = 42
    assert(number == &number && &number == number && &number == &number, "Borrowed scalar equality")
    assert(equal(-0.0, 0.0) && !equal(Float32.NAN, Float32.NAN), "Generic IEEE equality")
    assert(1s == 1000ms && 1s != 2s, "Standard record equality")
    assert(Key { value: 42 } == Key { value: 42 }, "Inferred generic operands")
    42
}
fn main() { record_int(protocols()) }
