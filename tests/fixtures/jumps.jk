fn return_value(x: Int32) -> Int32 { return x + 1 }
fn return_unit() { return; }
fn return_bool(x: Bool) -> Bool { return !x }
fn return_flag(x: Int32) -> Int32 { if return_bool(x == 0) { 1 } else { 0 } }
fn return_text(x: Bool) -> String { if x { return "yes" } return "no" }
fn return_multiline() -> Int32 { return
    42
}
fn return_sequence() -> Int32 { return (1; 2; 3) }
fn return_both(x: Int32) -> Int32 { if x < 0 { return -1 } else { return 1 } }
fn return_mixed(x: Int32) -> Int32 {
    let y = if x < 0 { return -1 } else { x + 1 }
    y * 2
}
fn return_else(x: Int32) -> Int32 {
    let y = if x >= 0 { x + 1 } else { return -1 }
    y * 2
}
fn return_argument(x: Int32) -> Int32 { return_value(if x < 0 { return 9 } else { x }) }
fn return_operand(x: Int32) -> Int32 { 2 * if x < 0 { return 9 } else { x } }
fn return_short_circuit(x: Int32) -> Int32 {
    x < 0 && (return -1);
    x == 0 || (return 1);
    0
}
fn return_initializer() -> Int32 { let unused: Bool = (return 42) }
fn return_assignment() -> Int32 { var x = 0 x = (return 42) }
fn return_unary() -> Int32 { -(return 42) }
fn return_nested() -> Int32 { return return 42 }
fn return_trailing() -> Int32 { return 42; }
fn return_condition() -> Int32 { while (return 42) {} }
fn break_only_condition() -> Int32 { while (break) {} 42 }
fn diverging_condition(n: Int32) -> Int32 {
    var i = 0
    while (i = i + 1; if i < n { continue } else { break }) {}
    i
}
fn break_or_return(n: Int32) -> Int32 {
    while (if n < 0 { return -1 } else { break }) {}
    42
}
fn break_in_return() -> Int32 {
    while true { return (break) }
    42
}
fn continue_in_return() -> Int32 {
    var i = 0
    while i < 3 { i = i + 1 return (continue) }
    i
}
fn return_or_diverge(n: Int32) -> Int32 {
    if n == 0 { return 42 } else { while (continue) {} }
}
fn nested_condition_loops() -> Int32 {
    var i = 0
    while (while (break) {}; i < 3) { i = i + 1 }
    i
}

fn break_continue(n: Int32) -> Int32 {
    var i = 0
    var total = 0
    while i < n {
        i = i + 1
        if i == 2 { continue }
        if i > 5 { break }
        total = total + i
    }
    total
}
fn return_loop(n: Int32) -> Int32 {
    var i = 0
    while i < n {
        i = i + 1
        if i == 3 { return i * 10 }
    }
    i
}
fn nested_breaks() -> Int32 {
    var i = 0 var total = 0
    while i < 3 {
        i = i + 1
        var j = 0
        while true {
            j = j + 1
            if j == 1 { continue }
            if j == 3 { break }
            total = total + i * 10 + j
        }
    }
    total
}
fn break_join() -> Int32 {
    var i = 0 var total = 0
    while true {
        i = i + 1
        let value = if i < 4 { i } else { break }
        total = total + value
    }
    total
}
fn continue_condition() -> Int32 {
    var i = 0 var total = 0
    while (i = i + 1; if i == 2 { continue } else { i < 5 }) {
        total = total + i
    }
    total
}
fn break_condition() -> Int32 {
    var i = 0
    while (i = i + 1; if i == 3 { break } else { true }) {}
    i
}
fn continue_and_break_paths() -> Int32 {
    var i = 0
    while true {
        i = i + 1
        if i < 3 { continue } else { break }
    }
    i
}
fn short_circuit_jumps() -> Int32 {
    var i = 0 var sum = 0
    while true {
        i = i + 1
        i == 2 && (continue);
        i < 5 || (break);
        sum = sum + i
    }
    sum
}
