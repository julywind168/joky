import joky/domain
import joky/task
import joky/check
struct State { title: String, count: Int32 }
fn make(count: Int32) -> State { State { title: "room", count: count } }
fn read(state: &State) -> Int32 { state.count }
fn assert(value: Bool) { let message = "domain deadline" check.assert(value, &message) }
fn lifecycle() @suspends -> Int32 {
    let owner = domain.create(make, 7)
    let reader = owner.read_handle()
    let expired = domain.deadline_after(0)
    let candidate = domain.candidate_from(domain.snapshot_from(reader, read), owner.handle(), make, 99)
    task.yield_now()
    var rejected = domain.commit_before(owner.handle(), candidate, &expired)
    assert(match rejected.wait() { Err(Expired) => true, _ => false })
    assert(domain.read_from(reader, read).unwrap() == 7)
    let snapshot = domain.snapshot_from(reader, read)
    assert(match snapshot.check() { Current => true, _ => false })
    // The deadline is created before preparation and remains independent of it.
    let later = domain.deadline_after(2147483647)
    let next = domain.candidate_from(snapshot, owner.handle(), make, 12)
    task.yield_now()
    var committed = domain.commit_before(owner.handle(), next, &later)
    assert(match committed.wait() { Ok(version) => version == 1, _ => false })
    assert(domain.read_from(reader, read).unwrap() == 12)
    // Reusing a deadline neither resets nor extends it.
    var again = domain.commit_before(owner.handle(), domain.candidate_from(domain.snapshot_from(reader, read), owner.handle(), make, 88), &expired)
    assert(match again.wait() { Err(Expired) => true, _ => false })
    owner.close()
    committed.cancel()
    assert(match committed.wait() { Ok(version) => version == 1, _ => false })
    assert(match rejected.wait() { Err(Expired) => true, _ => false })
    24
}
fn main() @suspends { assert(lifecycle() == 24) println("domain deadlines ok") }
