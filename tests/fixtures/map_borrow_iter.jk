import joky/map as maps.{type Map, type Iter, type Entry}
import joky/array.{type Array}
import joky/option.{Some, None}
import joky/check.{assert}
import joky/string as text
import joky/drop.{type Drop}
extern fn record(x: Int32) -> Int32
extern fn delayed_value(x: Int32) @suspends -> Int32
fn expect(ok: Bool) { assert(ok, "Map iterator mismatch") }
fn forward<K, V>(table: &Map<K, V>) -> &Iter<K, V> { table.iter() }
fn forward_mut<K, V>(table: &mut Map<K, V>) -> &mut Iter<K, V> { table.iter_mut() }
fn compute() -> Int32 {
    var table = Map.new::<Int32, Int32>()
    var count = 0
    for _ in table.iter() { count += 1 }
    expect(count == 0)
    table.insert(1, 10)
    table.insert(2, 20)
    table.insert(3, 30)
    table.remove(2)
    table.insert(4, 40)
    var total = 0
    for entry in forward(&table) {
        let key = maps.entry_key(entry)
        let value = maps.entry_value(entry)
        expect(*value == *key * 10)
        total += *key + *value
    }
    expect(total == 88)
    for entry in forward_mut(&mut table) {
        let key = *maps.entry_key(entry)
        *maps.entry_value_mut(entry) += key
    }
    expect(*table.borrow_ref(1) == 11 && *table.borrow_ref(3) == 33 && *table.borrow_ref(4) == 44)
    snapshots(&table)
    resumed(&mut table)
    nested_values()
    42
}
fn snapshots(table: &Map<Int32, Int32>) {
    let cursor = table.iter()
    expect(maps.advance(cursor))
    let first = maps.current(cursor)
    let key = *maps.entry_key(first)
    let other = cursor
    expect(maps.advance(other))
    expect(*maps.entry_key(first) == key)
    expect(*maps.entry_value(first) == key * 11)
    let second = maps.current(cursor)
    expect(*maps.entry_key(second) != key)
    var count = 0
    for _ in cursor { count += 1 }
    expect(count == 1 && !maps.advance(cursor) && !maps.advance(cursor))
    expect(*maps.entry_key(first) == key)
}
fn resumed(table: &mut Map<Int32, Int32>) {
    let cursor = table.iter_mut()
    for entry in &mut *cursor { *maps.entry_value_mut(entry) += 1; break }
    expect(maps.advance(cursor))
    let entry = maps.current_mut(cursor)
    *maps.entry_value_mut(entry) += 1
    var total = 0
    for entry in table.iter() { total += *maps.entry_value(entry) }
    expect(total == 90)
}
fn invalid_current(after_end: Int32) -> Int32 {
    var table = Map.new::<Int32, Int32>()
    table.insert(1, 42)
    let cursor = table.iter()
    if after_end != 0 { expect(maps.advance(cursor)); expect(!maps.advance(cursor)) }
    *maps.entry_value(maps.current(cursor))
}
struct Owned { id: Int32, data: Array<Int32> }
impl Drop for Owned { fn drop(&mut self) { record(self.id); } }
fn owned(id: Int32) -> Owned {
    let value = Owned { id: id, data: [id] }
    record(-id)
    value
}
fn owned_table() -> Map<String, Owned> {
    var table = Map.new::<String, Owned>()
    table.insert("a", owned(1))
    table.insert("bbb", owned(2))
    table
}
fn consume(action: Int32) -> Int32 {
    var table = owned_table()
    var bytes: UInt64 = 0
    for entry in table.iter_mut() {
        bytes += text.byte_length(maps.entry_key(entry))
        let value = maps.entry_value_mut(entry)
        value.data.push(99)
        expect(value.data.len() == 2)
        if action == 1 { return 42 }
        if action == 2 { let invalid = value.id % 0 }
    }
    expect(bytes == 4)
    var total = 0
    for entry in table.iter() { total += maps.entry_value(entry).id }
    expect(total == 3)
    record(20)
    42
}
fn pending() @suspends -> Int32 {
    var table = owned_table()
    for entry in table.iter_mut() {
        let size = text.byte_length(maps.entry_key(entry))
        let value = maps.entry_value_mut(entry)
        value.data.push(99)
        delayed_value(record(10 + value.id))
        expect(value.data.len() == 2)
        expect(size == 1 || size == 3)
    }
    42
}

fn nested_values() {
    var table = Map.new::<Int32, Array<Int32>>()
    table.insert(1, [1, 2])
    for entry in table.iter_mut() { maps.entry_value_mut(entry).push(3) }
    for entry in table.iter() {
        let values = maps.entry_value(entry)
        expect(values.len() == 3 && values.get(2).unwrap_or(0) == 3)
    }
}
