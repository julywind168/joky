import joky/map.{type Map, type Iter, type Entry}
import joky/array.{type Array}
import joky/option.{Some, None}
import joky/check.{assert}
import joky/string
extern fn record(x: Int32) -> Int32
extern fn delayed_value(x: Int32) @suspends -> Int32
fn expect(ok: Bool) { assert(ok, "Map iterator mismatch") }
fn forward<K, V>(table: &Map<K, V>) -> &Iter<K, V> { table.iter() }
fn forward_mut<K, V>(table: &mut Map<K, V>) -> &mut Iter<K, V> { table.iter_mut() }
fn compute() -> Int32 {
    var table = Map.new::<Int32, Int32>()
    var count = 0
    for _ in &table { count += 1 }
    expect(count == 0)
    table.insert(1, 10)
    table.insert(2, 20)
    table.insert(3, 30)
    table.remove(2)
    table.insert(4, 40)
    var total = 0
    for entry in &table {
        let key = map.entry_key(entry)
        let value = map.entry_value(entry)
        expect(*value == *key * 10)
        total += *key + *value
    }
    expect(total == 88)
    for entry in &mut table {
        let key = *map.entry_key(entry)
        *map.entry_value_mut(entry) += key
    }
    expect(*table.borrow_ref(1) == 11 && *table.borrow_ref(3) == 33 && *table.borrow_ref(4) == 44)
    snapshots(&table)
    resumed(&mut table)
    nested_values()
    projected_pairs()
    42
}
fn projected_pairs() {
    var table = Map.new::<Int32, Int32>()
    for value in [1, 2, 3] { table.insert(value, value * 10) }
    let cursor = forward(&table)
    let alias = cursor
    for index, (key, value) in cursor {
        let expected = *key
        expect(index == 0)
        expect(map.advance(alias))
        // Both projected references retain their original item across advance.
        expect(*key == expected && *value == expected * 10)
        break
    }
    let remaining = cursor
    for (_, value) in remaining { expect(*value > 0) }
    var count = 0
    for (key, value) in &table {
        for (other, _) in &table { count += 1; expect(*other > 0) }
        expect(*value == *key * 10)
    }
    expect(count == 9)
    let cursor = forward_mut(&mut table)
    for (_, value) in &mut *cursor { *value += 1; break }
    for (key, value) in &mut *cursor { *value += *key; continue }
    var units = Map.new::<Unit, Unit>()
    units.insert({}, {})
    for (key, value) in &mut units { let k = *key; *value = k }
    let saved = first_value(&table)
    expect(*saved > 0)
}
fn first_value(table: &Map<Int32, Int32>) -> &Int32 {
    for (_, value) in table { return value }
    table.borrow_ref(1)
}
fn snapshots(table: &Map<Int32, Int32>) {
    let cursor = table.iter()
    expect(map.advance(cursor))
    let first = map.current(cursor)
    let key = *map.entry_key(first)
    let other = cursor
    expect(map.advance(other))
    expect(*map.entry_key(first) == key)
    expect(*map.entry_value(first) == key * 11)
    let second = map.current(cursor)
    expect(*map.entry_key(second) != key)
    var count = 0
    for _ in cursor { count += 1 }
    expect(count == 1 && !map.advance(cursor) && !map.advance(cursor))
    expect(*map.entry_key(first) == key)
}
fn resumed(table: &mut Map<Int32, Int32>) {
    let cursor = table.iter_mut()
    for entry in &mut *cursor { *map.entry_value_mut(entry) += 1; break }
    expect(map.advance(cursor))
    let entry = map.current_mut(cursor)
    *map.entry_value_mut(entry) += 1
    var total = 0
    for entry in table.iter() { total += *map.entry_value(entry) }
    expect(total == 90)
}
fn invalid_current(after_end: Int32) -> Int32 {
    var table = Map.new::<Int32, Int32>()
    table.insert(1, 42)
    let cursor = table.iter()
    if after_end != 0 { expect(map.advance(cursor)); expect(!map.advance(cursor)) }
    *map.entry_value(map.current(cursor))
}
struct Owned { id: Int32, data: Array<Int32> }

fn owned(id: Int32) -> Owned {
    let value = Owned { id: id, data: [id] }
    record(-id)
    value
}
fn owned_table() -> Map<String, Owned> {
    var table = Map.new::<String, Owned>()
    table.insert("a", owned(1))
    table.insert("bbb", owned(2))
    table
}
fn consume(action: Int32) -> Int32 {
    var table = owned_table()
    var bytes: UInt64 = 0
    for index, (key, value) in &mut table {
        expect(index < 2)
        bytes += string.byte_length(key)
        value.data.push(99)
        expect(value.data.len() == 2)
        if action == 1 { return 42 }
        if action == 2 { let invalid = value.id % 0 }
    }
    expect(bytes == 4)
    var total = 0
    for entry in table.iter() { total += map.entry_value(entry).id }
    expect(total == 3)
    record(20)
    42
}
fn pending() @suspends -> Int32 {
    var table = owned_table()
    var ordinal = 0
    for index, (key, value) in &mut table {
        expect(index == ordinal)
        ordinal += 1
        let size = string.byte_length(key)
        value.data.push(99)
        delayed_value(record(10 + value.id))
        expect(value.data.len() == 2)
        expect(size == 1 || size == 3)
        expect(index == ordinal - 1 && string.byte_length(key) == size)
    }
    42
}

fn nested_values() {
    var table = Map.new::<Int32, Array<Int32>>()
    table.insert(1, [1, 2])
    for (_, value) in &mut table { value.push(3) }
    for entry in table.iter() {
        let values = map.entry_value(entry)
        expect(values.len() == 3 && values.get(2).unwrap_or(0) == 3)
    }
}
