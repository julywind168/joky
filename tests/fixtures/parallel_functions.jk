struct Callback { call: fn(Int32) -> Int32 }
fn apply_once<F: FnOnce(Int32) -> Int32>(value: Int32, f: F) -> Int32 { f(value) }
fn plus(value: Int32) -> Int32 { apply_once(value, |x| { x + 1 }) }
fn twice(value: Int32) -> Int32 { value * 2 }
fn invoke(callback: Callback, value: Int32) @suspends -> Int32 { callback.call(value) }
fn choose() -> Callback { Callback { call: twice } }
fn later(value: Int32) @suspends -> Int32 { value + 1 }
fn main() @suspends -> Int32 {
    let callback = Callback { call: plus }
    let target = later
    let (a, b, c) = join { invoke(callback, 20), invoke(choose(), 21), target(20) }
    let result = a + b + c
    if result == 84 { 0 } else { 1 }
}

extern fn __joky_task_sleep_ms(milliseconds: UInt64) @suspends
fn slow(text: String) @suspends -> String { __joky_task_sleep_ms(60000); text }
fn fast(text: String) @suspends -> String { text }
fn cancelled() @suspends -> String {
    let target = slow
    race { target("cancelled owner"), fast("winner") }
}
