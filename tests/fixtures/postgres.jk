import joky/postgres
import joky/task
import joky/mem
import joky/array.{type Array}
#derive(FromRow)
struct NamedRow<T> { Text: T, n: Option<Int64>, flag: Bool }
#derive(FromRow)
struct RequiredRow { Text: String, n: Int64 }
#derive(FromRow)
struct MissingRow { Text: String, missing: Option<Int64> }
#derive(FromRow)
struct WrongRow { Text: String, n: Option<Bool> }
#derive(FromRow)
struct Identifier { id: Int64 }
#derive(FromRow)
struct EmptyRow {}

#derive(FromRow)
struct BinaryRow { bytes: Array<UInt8>, nullable: Option<Array<UInt8>> }
#derive(FromRow)
struct RequiredBinaryRow { bytes: Array<UInt8>, nullable: Array<UInt8> }

fn binary_columns(row: postgres.Row) {
    var bytes = row.get::<Array<UInt8>>("bytes")!
    bytes[0] = 7
    assert(row.get_bytes("bytes")!![0] == 0, "generic bytes own an independent copy")
    assert(row.get::<Array<UInt8>>("empty")!.is_empty(), "empty binary value")
    assert(row.get_opt::<Array<UInt8>>("nullable")!.is_none(), "binary NULL")
    assert(match row.get::<Array<UInt8>>("nullable") { Err(Column(UnexpectedNull(2))) => true, _ => false }, "required binary NULL")
    assert(match row.get_opt::<Array<UInt8>>("wrong") { Err(Column(TypeMismatch(3))) => true, _ => false }, "binary NULL type mismatch")
    assert(match row.get::<Array<UInt8>>("missing") { Err(Column(MissingColumn)) => true, _ => false }, "missing binary column")
    assert(match postgres.FromRow.from_row::<RequiredBinaryRow>(&row) { Err(Column(UnexpectedNull(2))) => true, _ => false }, "partial binary mapping")
    let decoded = postgres.FromRow.from_row::<BinaryRow>(&row)!
    mem.drop(row)
    assert(decoded.bytes[1] == 255 && decoded.bytes[2] == 42 && decoded.nullable.is_none(), "derived binary values outlive the row")
}

struct OrderId { value: Int64 }
impl postgres.FromSql for OrderId {
    fn from_sql(row: &postgres.Row, i: UInt64) @noescape -> Result<OrderId, postgres.DbError> {
        let value = postgres.FromSql.from_sql::<Int64>(row, i)?
        if value < 0 { return Err(postgres.DbError.Invalid) }
        Ok(OrderId { value })
    }
}
#derive(FromRow)
struct WrappedRow<T> { id: T }

fn scalar(p: &postgres.Pool, sql: String) @suspends -> Int64 {
    p.query_scalar::<Int64>(sql, [])!
}
fn scalar_queries(pool: &postgres.Pool) @suspends {
    assert(pool.query_scalar::<Int64>("SELECT count(*) FROM generate_series(1, 3)", [])! == 3, "scalar count")
    assert(pool.query_scalar::<Bool>("SELECT $1::bool", [postgres.Value.BoolValue(true)])!, "scalar bound boolean")
    let text = pool.query_scalar::<String>("SELECT $1::text", [postgres.Value.TextValue("owned scalar")])!
    let bytes = pool.query_scalar::<Array<UInt8>>("SELECT $1::bytea", [postgres.Value.BytesValue([0,255])])!
    assert(text == "owned scalar" && bytes.len() == 2 && bytes[1] == 255, "scalar owning results")
    assert(pool.query_scalar::<Option<Int64>>("SELECT NULL::bigint", [])!.is_none(), "scalar nullable integer")
    assert(pool.query_scalar::<Option<Int64>>("SELECT 42::bigint", [])!! == 42, "scalar present optional")
    assert(match pool.query_scalar::<Option<Int64>>("SELECT 1 WHERE false", []) { Err(ResultRead(NoRows)) => true, _ => false }, "scalar optional still requires a row")
    assert(match pool.query_scalar::<Int64>("SELECT n, n FROM generate_series(1, 2) AS s(n)", []) { Err(ResultRead(MultipleRows)) => true, _ => false }, "scalar row count precedes column count")
    assert(match pool.query_scalar::<Int64>("SELECT FROM generate_series(1, 1)", []) { Err(ResultRead(ColumnCount(0))) => true, _ => false }, "scalar zero columns")
    assert(match pool.query_scalar::<Int64>("SELECT 1, 'extra'::text", []) { Err(ResultRead(ColumnCount(2))) => true, _ => false }, "scalar multiple columns")
    assert(match pool.query_scalar::<Int64>("SELECT NULL::bigint", []) { Err(Column(UnexpectedNull(0))) => true, _ => false }, "scalar required NULL")
    assert(match pool.query_scalar::<Option<Int64>>("SELECT NULL::text", []) { Err(Column(TypeMismatch(0))) => true, _ => false }, "scalar wrong NULL type")
    assert(match pool.query_scalar::<Int64>("SELECT 'wrong'::text", []) { Err(Column(TypeMismatch(0))) => true, _ => false }, "scalar type mismatch")
    let id = pool.query_scalar::<OrderId>("SELECT 42::bigint", [])!
    assert(id.value == 42, "scalar custom FromSql")
    assert(match pool.query_scalar::<OrderId>("SELECT -1::bigint", []) { Err(Invalid) => true, _ => false }, "scalar custom error")
    let error = postgres.DbError.ResultRead(postgres.ReadFailure.ColumnCount(2))
    assert("{error}" == "query returned 2 columns; expected one", "scalar column count diagnostic")

    var tx = pool.begin()!
    assert(match tx.query_scalar::<Int64>("SELECT 1 WHERE false", []) { Err(ResultRead(NoRows)) => true, _ => false }, "transaction scalar no rows")
    assert(match tx.query_scalar::<Int64>("SELECT generate_series(1, 2)", []) { Err(ResultRead(MultipleRows)) => true, _ => false }, "transaction scalar multiple rows")
    assert(match tx.query_scalar::<Int64>("SELECT 1, 2", []) { Err(ResultRead(ColumnCount(2))) => true, _ => false }, "transaction scalar columns")
    assert(match tx.query_scalar::<Int64>("SELECT true", []) { Err(Column(TypeMismatch(0))) => true, _ => false }, "transaction scalar decode error")
    assert(tx.query_scalar::<Option<String>>("SELECT NULL::text", [])!.is_none(), "transaction scalar nullable text")
    assert(tx.query_scalar::<Int64>("SELECT $1::bigint", [postgres.Value.IntValue(42)])! == 42, "transaction remains usable after scalar errors")
    tx.commit()!
}
fn types(pool: &postgres.Pool) @suspends {
    let rows = pool.query("SELECT $1::bool, $2::bigint, $3::text, $4::bytea, $5::bigint, 7::int2, 8::int4", [
        postgres.Value.BoolValue(true), postgres.Value.IntValue(-42), postgres.Value.TextValue("a';--好"),
        postgres.Value.BytesValue([0,255]), postgres.Value.Null(postgres.Kind.Integer)])!
    let r = rows.borrow_ref(0)
    assert(match r.borrow_ref(0) { BoolValue(b) => b, _ => false }, "boolean")
    assert(match r.borrow_ref(1) { IntValue(n) => n == -42, _ => false }, "negative bigint")
    assert(match r.borrow_ref(2) { TextValue(s) => s.equals("a';--好"), _ => false }, "bound UTF-8")
    assert(match r.borrow_ref(3) { BytesValue(b) => b.len() == 2 && b[1] == 255, _ => false }, "binary data")
    assert(match r.borrow_ref(4) { Null(Integer) => true, _ => false }, "typed null")
    assert(match r.borrow_ref(5) { IntValue(n) => n == 7, _ => false }, "int2")
    assert(match r.borrow_ref(6) { IntValue(n) => n == 8, _ => false }, "int4")
    assert(match pool.query("SELECT 1.5::numeric", []) { Err(ResultRead(UnsupportedType)) => true, _ => false }, "unsupported column")
    assert(match pool.query("SELECT repeat('x', 1048567) AS payload", []) { Err(ResultRead(ResultLimit)) => true, _ => false }, "column metadata counts toward the byte bound")
    assert(match pool.query("SELECT generate_series(0,1024)", []) { Err(ResultRead(ResultLimit)) => true, _ => false }, "row bound")
}
fn cells(row: &postgres.Row) {
    assert(postgres.get_i64(row, 0)!.is_none() && postgres.get_bool(row, 1)!!, "typed cells")
    assert(postgres.get_text(row, 2)!! == "x" && postgres.get_bytes(row, 3)!![1] == 255, "borrow owning cells")
    assert(match postgres.get_bool(row, 0) { Err(TypeMismatch(0)) => true, _ => false }, "typed null mismatch")
    assert(match postgres.get_text(row, 4) { Err(OutOfBounds(4)) => true, _ => false }, "absent column")
    assert(row.get_int64("n")!.is_none() && row.get_bool("flag")!!, "named typed NULL and boolean")
    let text = { let label = "Text"; row.get_text(&label)!! }
    assert(text == "x" && row.get_bytes("bytes")!![1] == 255, "named values borrow only the row")
    assert(match row.require_int64("n") { Err(Column(UnexpectedNull(0))) => true, _ => false }, "required NULL")
    assert(match row.get_bool("n") { Err(TypeMismatch(0)) => true, _ => false }, "wrong type for NULL")
    assert(match row.get_text("text") { Err(MissingColumn) => true, _ => false }, "exact column name")
}
fn check_batch(batch: &Array<postgres.Row>) {
    let second = batch.borrow_ref(1)
    assert(second.get::<Int64>("id")! == 2, "generic required integer")
    assert(second.get_opt::<Int64>("qty")!! == 12, "generic optional integer")
    assert(second.get_int64("id")!! == 2 && second.get_int64("qty")!! == 12, "column labels on every row")
    assert(second.column_names().borrow_ref(0) == "qty" && second.values().len() == 2, "ordered column metadata")
}
fn cardinality(pool: &postgres.Pool) @suspends {
    assert(pool.query_optional("SELECT 1 WHERE false", [])!.is_none(), "optional empty")
    assert(match pool.query_one("SELECT 1 WHERE false", []) { Err(ResultRead(NoRows)) => true, _ => false }, "required empty")
    assert(match pool.query_optional("SELECT generate_series(1, 2)", []) { Err(ResultRead(MultipleRows)) => true, _ => false }, "optional multiple")
    var tx = pool.begin()!
    assert(match tx.query_one("SELECT generate_series(1, 2)", []) { Err(ResultRead(MultipleRows)) => true, _ => false }, "required multiple")
    let row = tx.query_optional("SELECT NULL::bigint AS n, true AS flag, 'x'::text AS \"Text\", $1::bytea AS bytes", [postgres.Value.BytesValue([0,255])])!!
    cells(&row)
    assert(row.get_opt::<Int64>("n")!.is_none(), "generic typed NULL")
    assert(row.get::<Bool>("flag")! && row.get::<String>("Text")! == "x", "generic scalar reads")
    assert(match row.get::<Int64>("n") { Err(Column(UnexpectedNull(0))) => true, _ => false }, "generic required NULL")
    assert(match row.get_opt::<Bool>("n") { Err(Column(TypeMismatch(0))) => true, _ => false }, "generic NULL type mismatch")
    assert(match row.get_opt::<String>("text") { Err(Column(MissingColumn)) => true, _ => false }, "generic missing column")
    assert(match postgres.FromRow.from_row::<RequiredRow>(&row) { Err(Column(UnexpectedNull(0))) => true, _ => false }, "derived partial owning result cleans up")
    assert(match postgres.FromRow.from_row::<MissingRow>(&row) { Err(Column(MissingColumn)) => true, _ => false }, "optional field still requires its column")
    assert(match postgres.FromRow.from_row::<WrongRow>(&row) { Err(Column(TypeMismatch(0))) => true, _ => false }, "derived typed NULL")
    let mapped = postgres.FromRow.from_row::<NamedRow<String>>(&row)!
    mem.drop(row)
    assert(mapped.Text == "x" && mapped.n.is_none() && mapped.flag, "derived values outlive the row")
    let single = tx.query_one_as::<NamedRow<String>>("SELECT true AS flag, 'owned'::text AS \"Text\", 7::bigint AS n, 42 AS extra", [])!
    assert(single.Text == "owned" && single.n! == 7, "derived mapping ignores order and extra columns")
    let duplicate = tx.query_one("SELECT 9::bigint AS id, 11::bigint AS id", [])!
    assert(match duplicate.get_int64("id") { Err(AmbiguousColumn) => true, _ => false }, "ambiguous label")
    assert(match duplicate.get::<Int64>("id") { Err(Column(AmbiguousColumn)) => true, _ => false }, "generic ambiguous column")
    assert(match postgres.FromRow.from_row::<Identifier>(&duplicate) { Err(Column(AmbiguousColumn)) => true, _ => false }, "derived ambiguous column")
    assert(postgres.get_i64(&duplicate, 1)!! == 11, "duplicate labels retain their positions")
    let batch = tx.query("SELECT n+10 AS qty, n AS id FROM generate_series(1,2) AS series(n) ORDER BY n", [])!
    check_batch(&batch)
    let single = tx.query_one("SELECT 42", [])!
    assert(postgres.get_i64(&single, 0)!! == 42, "transaction remains usable")
    tx.commit()!
}
fn abandon(p: &postgres.Pool) @suspends {
    var tx = p.begin()!
    tx.execute("INSERT INTO joky_test_abandon VALUES (1)", [])!;
}
fn sleep_query(pool: &postgres.Pool) @suspends {
    var tx = pool.begin()!
    tx.execute("INSERT INTO joky_test_abandon VALUES (3)", [])!;
    tx.execute("SELECT pg_sleep(5) /*joky_cancel_probe*/", [])!;
}
fn queued(pool: &postgres.Pool) @suspends {
    pool.execute("INSERT INTO joky_test_abandon VALUES (4)", [])!;
}
fn await_sleep(observer: &postgres.Pool, pid: Int64) @suspends {
    while scalar(observer, "SELECT count(*) FROM pg_stat_activity WHERE pid={pid} AND state='active' AND query LIKE 'SELECT pg_sleep(5) /*joky_cancel_probe*/%'") == 0 { task.sleep(5ms) }
}
fn shared_session(pool: postgres.Pool) @suspends -> Int64 { scalar(&pool, "SELECT pg_backend_pid()") }
fn main() @suspends {
    let pool = postgres.open(1)!
    let observer = postgres.open(1)!
    types(&pool)
    scalar_queries(&pool)
    cardinality(&pool)
    binary_columns(pool.query_one("SELECT $1::bytea AS bytes, ''::bytea AS empty, NULL::bytea AS nullable, NULL::bigint AS wrong", [postgres.Value.BytesValue([0, 255, 42])])!)
    let binary = pool.query_one_as::<BinaryRow>("SELECT $1::bytea AS bytes, NULL::bytea AS nullable", [postgres.Value.BytesValue([42])])!
    assert(binary.bytes[0] == 42 && binary.nullable.is_none(), "mapped binary query returns independent owners across suspension")
    let wrapped = pool.query_one_as::<WrappedRow<OrderId>>("SELECT 42::bigint AS id", [])!
    assert(wrapped.id.value == 42, "custom FromSql with inferred derive bounds")
    let invalid = pool.query_one("SELECT -1::bigint AS id", [])!
    assert(match invalid.get_opt::<OrderId>("id") { Err(Invalid) => true, _ => false }, "optional custom decode preserves errors")
    let id = pool.query_one_as::<Identifier>("SELECT 42::bigint AS id", [])!
    assert(id.id == 42, "pool mapped query")
    pool.query_one_as::<EmptyRow>("SELECT 1 AS extra", [])!
    assert(match pool.query_one_as::<Identifier>("SELECT 1 AS id WHERE false", []) { Err(ResultRead(NoRows)) => true, _ => false }, "mapped empty query")
    assert(match pool.query_one_as::<Identifier>("SELECT generate_series(1,2) AS id", []) { Err(ResultRead(MultipleRows)) => true, _ => false }, "mapped multirow query")
    pool.execute("CREATE TABLE IF NOT EXISTS joky_result_probe (id bigint PRIMARY KEY)", [])!;
    pool.execute("DELETE FROM joky_result_probe", [])!;
    assert(match pool.query("INSERT INTO joky_result_probe VALUES (7) RETURNING id::numeric", []) {
        Err(ResultRead(UnsupportedType)) => true, _ => false }, "DML returned an unreadable result")
    assert(scalar(&pool, "SELECT count(*) FROM joky_result_probe") == 1, "DML already committed")

    pool.execute("CREATE TABLE IF NOT EXISTS joky_test_abandon (n bigint PRIMARY KEY)", [])!;
    abandon(&pool)
    assert(scalar(&pool, "SELECT count(*) FROM joky_test_abandon") == 0, "drop rolls back")
    var tx = pool.begin()!
    tx.execute("INSERT INTO joky_test_abandon VALUES (2)", [])!;
    assert(match tx.execute("INSERT INTO joky_test_abandon VALUES (2)", []) { Err(Database(code)) => code == "23505", _ => false }, "SQLSTATE")
    assert(tx.commit().is_err(), "failed transaction cannot commit")
    assert(scalar(&pool, "SELECT count(*) FROM joky_test_abandon") == 0, "failure rolls back")
    let before = scalar(&pool, "SELECT pg_backend_pid()")
    assert(scalar(&pool, "SELECT pg_backend_pid()") == before, "healthy connection reused")
    let (a, b) = join { shared_session(pool.share()), shared_session(pool.share()) }
    assert(a == before && b == before, "independent handles share one bounded pool")
    let held = pool.begin()!
    race { queued(&pool), task.sleep(25ms) }
    held.rollback()!
    assert(scalar(&pool, "SELECT pg_backend_pid()") == before, "cancelling pool wait leaves active connection intact")
    race { sleep_query(&pool), await_sleep(&observer, before) }
    assert(scalar(&pool, "SELECT pg_backend_pid()") != before, "cancelled connection retired")
    assert(scalar(&pool, "SELECT count(*) FROM joky_test_abandon") == 0, "cancelled writes did not commit")
}
