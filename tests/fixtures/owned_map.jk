import joky/map as maps.{type Map}
import joky/array.{type Array}
import joky/drop.{type Drop}
import joky/check.{require}
extern fn record_int(value: Int32)
struct Resource { id: Int32 ,first: Array<Int32> ,second: Array<UInt64> }
impl Drop for Resource { fn drop(&mut self) { record_int(self.id) } }
fn resource(id: Int32) -> Resource {
    var first = Array.with_capacity::<Int32>(1) first.push(id)
    let result = Resource { id: id ,first: first ,second: Array.with_capacity::<UInt64>(1) }
    record_int(-id)
    result
}
fn transitions<Tag>() -> Int32 {
    var m = Map.with_capacity::<Int32, Resource>(2)
    m.insert(1, resource(1)) m.insert(2, resource(2))
    record_int(101)
    m.reserve(5)
    record_int(102)
    { let assertion_condition = maps.test_invariant(&m) let assertion_message = "Owned rehash" require(assertion_condition, &assertion_message) }
    m.insert(3, resource(3))
    let old = m.insert(1, resource(4))
    let removed = m.remove(2)
    { let assertion_condition = m.len() == 2 && maps.test_invariant(&m) let assertion_message = "Owned removal" require(assertion_condition, &assertion_message) }
    let cap = m.capacity()
    m.clear()
    { let assertion_condition = m.is_empty() && m.capacity() == cap && maps.test_invariant(&m) let assertion_message = "Owned clear" require(assertion_condition, &assertion_message) }
    m.insert(5, resource(5))
    record_int(-90)
    m.release()
    match old {
        | Some(a) => match removed {
            | Some(b) => { { let assertion_condition = a.first.get(0).unwrap_or(0) == 1 && b.first.get(0).unwrap_or(0) == 2 let assertion_message = "Returned owner" require(assertion_condition, &assertion_message) } 42 }
            | None => 0
        }
        | None => 0
    }
}
fn task() @suspends -> Int32 { transitions::<Unit>() }
fn nested_values<Tag>() -> Int32 {
    var m = Map.new::<Int32, Option<(Resource, Resource)>>()
    m.insert(1, Some((resource(6), resource(7)))) m.insert(2, None)
    let pair = m.remove(1)
    m.release()
    match pair {
        | Some(value) => match value { | Some((a, b)) => a.first.get(0).unwrap_or(0) + b.first.get(0).unwrap_or(0) + 29 | None => 0 }
        | None => 0
    }
}
fn arrays<Tag>() -> Int32 {
    var m = Map.new::<Int32, Array<Int32>>()
    var first = Array.new::<Int32>() first.push(20)
    var second = Array.new::<Int32>() second.push(22)
    m.insert(1, first)
    let old = m.insert(1, second)
    let next = m.remove(1)
    m.release()
    match old { | Some(a) => match next { | Some(b) => a.get(0).unwrap_or(0) + b.get(0).unwrap_or(0) | None => 0 } | None => 0 }
}
fn make_map() -> Map<Int32, Resource> { var m = Map.new::<Int32, Resource>() m.insert(1, resource(8)) m }
fn forward(m: Map<Int32, Resource>) -> Map<Int32, Resource> { m }
fn return_move<Tag>() -> Int32 {
    var m = forward(make_map())
    let old = m.remove(1)
    m.release()
    match old { | Some(a) => a.first.get(0).unwrap_or(0) + 34 | None => 0 }
}
struct Failing { id: Int32 ,data: Array<Int32> }
impl Drop for Failing {
    fn drop(&mut self) { record_int(self.id) { let assertion_condition = self.id != 2 let assertion_message = "Map Drop failure" require(assertion_condition, &assertion_message) } }
}
fn clear_failure<Tag>() -> Int32 {
    var m = Map.new::<Int32, Failing>()
    m.insert(1, Failing { id: 1 ,data: Array.new::<Int32>() })
    m.insert(2, Failing { id: 2 ,data: Array.new::<Int32>() })
    m.insert(3, Failing { id: 3 ,data: Array.new::<Int32>() })
    m.clear()
    record_int(99)
    0
}
fn consume(old: Option<Failing>) {}
fn replacement_drop_failure<Tag>() -> Int32 {
    var m = Map.new::<Int32, Failing>()
    m.insert(1, Failing { id: 2 ,data: Array.new::<Int32>() })
    consume(m.insert(1, Failing { id: 4 ,data: Array.new::<Int32>() }))
    record_int(99)
    0
}
fn runtime_failure<Tag>() -> Int32 {
    var m = Map.new::<Int32, Resource>() m.insert(1, resource(1))
    { let assertion_condition = false let assertion_message = "Map operation failure" require(assertion_condition, &assertion_message) }
    0
}
fn reuse_budget<Tag>() -> Int32 {
    var m = Map.with_capacity::<Int32, Array<Int32>>(1)
    var i = 0
    while i < 96 {
        m.insert(1, Array.with_capacity::<Int32>(262144))
        m.clear()
        i = i + 1
    }
    m.release()
    var again = Map.new::<Int32, Array<Int32>>()
    again.insert(1, Array.with_capacity::<Int32>(262144))
    42
}
fn main() { record_int(transitions::<Unit>()) }
