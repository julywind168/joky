import joky/string
import joky/check.{assert, panic}
import joky/option.{type Option, Some, None}
import joky/drop.{type Drop}
fn expect(ok: Bool) { assert(ok, "Range pattern mismatch") }
extern fn record(x: Int32) -> Int32
extern fn delayed_value(x: Int32) @suspends -> Int32
fn signed8(x: Int8) -> Int32 { match x { -128..0 => 0, 0..=127 => 1 } }
fn signed16(x: Int16) -> Int32 { match x { -32768..0 => 0, 0..=32767 => 1 } }
fn signed32(x: Int32) -> Int32 { match x { -2147483648..0 => 0, 0..=2147483647 => 1 } }
fn signed64(x: Int64) -> Int32 { match x { -9223372036854775808..0 => 0, 0..=9223372036854775807 => 1 } }
type Byte = UInt8
fn unsigned8(x: Byte) -> Int32 { match x { 0..128 => 0, 128..=255 => 1 } }
fn unsigned16(x: UInt16) -> Int32 { match x { 0..65535 => 0, 65535..=65535 => 1 } }
fn unsigned32(x: UInt32) -> Int32 { match x { 0..4294967295 => 0, 4294967295..=4294967295 => 1 } }
fn unsigned64(x: UInt64) -> Int32 { match x { 0..18446744073709551615 => 0, 18446744073709551615..=18446744073709551615 => 1 } }
fn literal_edges(x: Int8) -> Int32 {
    match x { -128 => 0, -127..0 => 1, 0 => 2, 1..=127 => 3 }
}
fn overlap(x: Int32) -> Int32 { match x { 0..10 => 1, 5..=15 => 2, _ => 3 } }
fn correlated(flag: Bool, x: UInt8) -> Int32 {
    match (flag, x) {
        (true, 0..128) => 1,
        (true, 128..=255) => 2,
        (false, 0..=255) => 3
    }
}
struct Item { id: Int32, text: String }
impl Drop for Item { fn drop(&mut self) { record(self.id); } }
enum Packet { Data((Int32, Item)), Empty }
fn consume(packet: Packet) -> Int32 {
    match packet {
        Data((0..10, item)) if item.text == "skip" => -1,
        Data((0..10, item)) if item.id > 0 => item.id,
        Data((_, item)) => item.id + 1,
        Empty => 0
    }
}
fn borrowed() {
    var packet = Packet.Data((5, Item { id: 20, text: "owned" }))
    match &packet { Data((0..10, item)) => expect(item.id == 20), _ => expect(false) }
    match &mut packet { Data((0..=5, item)) if item.id == 20 => { item.id += 1 }, _ => expect(false) }
}
fn tuple_owners() {
    var pair = (3, Item { id: 30, text: "tuple" })
    match &pair { (0..=3, item) => expect(item.id == 30), _ => expect(false) }
    match &mut pair { (0..4, item) => { item.id += 1 }, _ => expect(false) }
    let id = match pair { (0..4, item) => item.id, _ => 0 }
    expect(id == 31)
}
fn classify(text: &String) -> Int32 {
    match text {
        "" => 0,
        "中🙂" => 1,
        "a\0b" => 2,
        _ => 3
    }
}
fn guarded_generic<T>(value: T) -> T {
    match Some(value) {
        Some(value) if { let witness: Option<T> = None; true } => value,
        _ => panic("missing value")
    }
}
fn guarded_return() -> Int32 {
    match Some("return") {
        Some(value) if { if value == "return" { return 42 }; false } => 0,
        _ => 1
    }
}
fn guarded_strings() -> Int32 {
    expect(classify("") == 0 && classify("中🙂") == 1 && classify("a\0b") == 2)
    expect(classify("a") == 3 && classify("中") == 3)
    // No normalization, including raw literals and Unicode escapes.
    expect(match "中🙂" { r"中🙂" => true, _ => false })
    expect(match "é" { "é" => false, "\u{e9}" => true, _ => false })
    expect(match Some(("join", "room")) { Some(("join", name)) if name.byte_length() == 4 => name == "room", _ => false })
    let text = match Some("kept") {
        Some(value) if value.is_empty() => value,
        Some(value) if value.byte_length() == 4 => value,
        _ => "wrong"
    }
    expect(text == "kept")
    expect(guarded_generic("generic") == "generic" && guarded_return() == 42)
    let limit: UInt64 = 4
    let accepts = |value: &String| -> Bool {
        match value { "kept" if value.byte_length() == limit => true, _ => false }
    }
    expect(accepts(&text))
    var indexed = 0
    for index, value in ["first", "second"] {
        match value { "second" if index == limit - 3 => { indexed += 1 }, _ => {} }
    }
    expect(indexed == 1)
    var mutable = "before"
    match &mut mutable { "before" if true => {}, _ => expect(false) }
    expect(mutable == "before")
    match ["first", "second"] { ["first", value] if value == "second" => expect(value == "second"), _ => expect(false) }
    var calls = 0
    let result = match { calls += 1; Some(7) } {
        Some(0) if { calls += 100; true } => 0,
        Some(n) if { calls += n; false } => 0,
        Some(n) if { calls += n; true } => n,
        _ => 0
    }
    expect(calls == 15 && result == 7)
    expect(match 1 { 1 if false => false, 1 => true, _ => false })
    expect(match true { true if false => false, true => true, false => false })
    if let Some("kept") = Some(text) { 42 } else { 0 }
}
fn compute() -> Int32 {
    expect(guarded_strings() == 42)
    expect(signed8(-128) == 0 && signed8(127) == 1)
    expect(signed16(-32768) == 0 && signed16(32767) == 1)
    expect(signed32(-2147483648) == 0 && signed32(2147483647) == 1)
    expect(signed64(-9223372036854775808) == 0 && signed64(9223372036854775807) == 1)
    for n in 0..256 { expect(unsigned8(uint8(n)) == if n < 128 { 0 } else { 1 }) }
    expect(unsigned16(0) == 0 && unsigned16(65535) == 1)
    expect(unsigned32(0) == 0 && unsigned32(4294967295) == 1)
    expect(unsigned64(0) == 0 && unsigned64(18446744073709551615) == 1)
    expect(literal_edges(-128) == 0 && literal_edges(-1) == 1 && literal_edges(0) == 2 && literal_edges(127) == 3)
    expect(overlap(-1) == 3 && overlap(0) == 1 && overlap(9) == 1)
    expect(overlap(10) == 2 && overlap(15) == 2 && overlap(16) == 3)
    expect(correlated(true, 127) == 1 && correlated(true, 128) == 2 && correlated(false, 255) == 3)
    match [2, 20] { [0..=3, 10..30] => {}, _ => expect(false) }
    var n = 0
    if let Some(0..=3) = Some(3) { n += 1 }
    while let Some(0..3) = Some(n) { n += 1 }
    expect(n == 3)
    borrowed()
    tuple_owners()
    expect(consume(Packet.Data((5, Item { id: 22, text: "owned" }))) == 22)
    expect(consume(Packet.Data((15, Item { id: 23, text: "owned" }))) == 24)
    expect(match record(2) { 0..=3 => true, _ => false })
    42
}
fn pending() @suspends -> Int32 {
    let item = Item { id: 99, text: "guard" }
    record(-99)
    match (record(1), item) {
        (0..=2, item) if delayed_value(1) == 2 && item.id == 99 => { let n = delayed_value(record(40)); expect(item.id == 99); n + 1 },
        _ => 0
    }
}
fn failure() {
    let item = Item { id: 99, text: "guard" }
    match record(3) { 0..=3 => panic("range failure"), _ => {} }
}
