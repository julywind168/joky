import joky/domain
import joky/task
import joky/check
struct Room { n:Int32 }
struct Input { pub amount:Int32, tag:UInt64 }
struct Reply { pub value:Int32, tag:UInt64 }
fn assert(ok:Bool) { let message="late binding Script"; check.assert(ok,&message) }
fn make(input:Input)->Room { Room{n:input.amount} }
fn read(room:&Room)->Int32 {room.n}
fn sum(a:&Room,b:&Room)->Reply {Reply{value:a.n+b.n,tag:18446744073709551615}}
fn transfer(a:&mut Room,b:&mut Room,input:Input)->Reply {
    a.n=a.n-input.amount
    b.n=b.n+input.amount
    Reply{value:a.n,tag:input.tag}
}
fn query_scalar(a:&Room,n:Int32)->Int32 {a.n+n}
fn query_packet(a:&Room,input:Input)->Reply {Reply{value:a.n+input.amount,tag:input.tag}}
fn query_pair_scalar(a:&Room,b:&Room,n:Int32)->Int32 {a.n+b.n+n}
fn query_pair_packet(a:&Room,b:&Room,input:Input)->Reply {Reply{value:a.n+b.n+input.amount,tag:input.tag}}
fn query_current(n:Int32) @suspends ->Int32 {
    let p=domain.query(query_packet,Input{amount:n,tag:18446744073709551615}).unwrap()
    assert(p.tag==18446744073709551615)
    assert(p.value==domain.query(query_scalar,n).unwrap())
    p.value
}
fn queries(a:domain.ReadHandle<Room>,b:domain.ReadHandle<Room>,extra:Int32) @suspends {
    assert(domain.query_from(a,query_scalar,3).unwrap()==43+extra)
    let p=domain.query_from(a,query_packet,Input{amount:3,tag:18446744073709551615}).unwrap()
    assert(p.value==43+extra && p.tag==18446744073709551615)
    assert(domain.request_read(a,query_current,3).unwrap_or(-1)==43+extra)
    assert(domain.query_pair(a,b,query_pair_scalar,3).unwrap()==45+extra)
    let q=domain.query_pair(a,b,query_pair_packet,Input{amount:3,tag:18446744073709551615}).unwrap()
    assert(q.value==45+extra && q.tag==18446744073709551615)
}
fn hold(directory:domain.DirectoryHandle) @suspends {
    let a=domain.create(make,Input{amount:40,tag:0})
    let b=domain.create(make,Input{amount:2,tag:0})
    assert(directory.insert(1,a.handle()).is_ok())
    assert(directory.insert(2,b.handle()).is_ok())
    while domain.lookup::<Room>(directory,1).is_some() {task.yield_now()}
    // Construction remains bound to this flow's module after publication.
    assert(construct_probe(7)==7)
    queries(a.read_handle(),b.read_handle(),100)
    // This v1 flow must resolve the v2 operation with its original signature.
    let reply=domain.write_pair(a.handle(),b.handle(),transfer,Input{amount:2,tag:18446744073709551615}).unwrap()
    assert(reply.value==20 && reply.tag==18446744073709551615)
    assert(domain.read_pair(a.read_handle(),b.read_handle(),sum).unwrap().value==142)
}
fn probe(directory:domain.DirectoryHandle) @suspends ->Int32 {
    match domain.lookup::<Room>(directory,1) {
        Some(a)=>match domain.lookup::<Room>(directory,2) {
            Some(b)=>{
                let result=domain.read_pair(a,b,sum).unwrap().value
                queries(a,b,result-42)
                result
            }, None=>-1
        }, None=>-1
    }
}
fn release(directory:domain.DirectoryHandle) @suspends ->Bool {
    match domain.lookup::<Room>(directory,1) {Some(a)=>directory.remove(1,a),None=>false}
}

fn construct_probe(n:Int32) @suspends ->Int32 {
    let owner=domain.create(make,Input{amount:n,tag:0})
    domain.read_from(owner.read_handle(),read).unwrap()
}
