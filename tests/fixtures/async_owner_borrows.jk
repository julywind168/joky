import joky/array.{type Array}
import joky/string.{type StringBuilder}
import joky/task
import joky/slice as slices
import joky/check.{assert}

struct Packet { bytes: Array<Int32>, tag: Int32 }
fn exercise() @suspends -> Int32 {
    var values = Array.new::<Int32>()
    values.push(20)
    let first = values.borrow_ref(0)
    let saved = *first
    task.yield_now()
    values.push(22)
    let sum = saved + values.get(1).unwrap_or(0)
    var packet = Packet { bytes: values, tag: 1 }
    packet.bytes.reserve(16)
    task.yield_now()
    packet.bytes.push(sum)
    let region = packet.bytes.slice(1, 3)
    let length = slices.len(region)
    let message = "short owner borrows in CPS"
    assert(length == 2 && packet.bytes.len() == 3, &message)
    var text = StringBuilder.new()
    text.push('x')
    task.yield_now()
    text.push('y')
    let finished = text.finish()
    assert(finished.byte_length() == 2, &message)
    packet.bytes.get(2).unwrap_or(0)
}
fn main() @suspends -> Int32 { if exercise() == 42 { 0 } else { 1 } }
