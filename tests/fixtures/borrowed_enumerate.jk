import joky/iter.{type Iter, type EnumerateIter}
import joky/array.{type Array}
import joky/map.{type Map}
import joky/slice
import joky/string
import joky/check.{assert}
import joky/drop.{type Drop}
extern fn record(x: Int32) -> Int32
extern fn delayed_value(x: Int32) @suspends -> Int32
fn expect(ok: Bool) { assert(ok, "Borrowed enumerate mismatch") }
fn wrap<T>(cursor: &Iter<T>) -> &EnumerateIter<T> { iter.enumerate_ref(cursor) }
fn arrays() {
    var values = [10, 20, 30]
    var total = 0
    for item in wrap(values.iter()) {
        total += int32(iter.index(item)) + *iter.value(item)
    }
    expect(total == 63)
    for item in iter.enumerate_mut(values.iter_mut()) {
        let index = iter.index(item)
        *iter.value_mut(item) += int32(index)
    }
    expect(values.get(1).unwrap_or(0) == 21 && values.get(2).unwrap_or(0) == 32)
}
fn slices() {
    var values = [10, 21, 32]
    for item in iter.enumerate_mut(slice.iter_mut(values.slice_mut(1, 3))) {
        let index = iter.index(item)
        *iter.value_mut(item) += int32(index) + 1
    }
    var total = 0
    for item in iter.enumerate_ref(slice.iter(values.slice(1, 3))) {
        total += *iter.value(item)
    }
    expect(total == 56)
}
fn other_elements() {
    let empty = Array.new::<Int32>()
    for _ in iter.enumerate_ref(empty.iter()) { expect(false) }
    var count: UInt64 = 0
    let units = [{}, {}]
    for item in iter.enumerate_ref(units.iter()) {
        expect(iter.index(item) == count)
        iter.value(item)
        count += 1
    }
    expect(count == 2)
    let texts = ["a", "bc"]
    for item in iter.enumerate_ref(texts.iter()) {
        expect(string.byte_length(iter.value(item)) == iter.index(item) + 1)
    }
    var nested = [[1], [2]]
    for item in iter.enumerate_mut(nested.iter_mut()) { iter.value_mut(item).push(7) }
    for item in iter.enumerate_ref(nested.iter()) { expect(iter.value(item).len() == 2) }
}
fn compute() -> Int32 {
    arrays()
    slices()
    other_elements()
    snapshots()
    entries()
    resumed()
    42
}
fn snapshots() {
    let values = [10, 20, 30, 40]
    let source = values.iter()
    expect(iter.advance(source))
    let cursor = iter.enumerate_ref(source)
    expect(*iter.current(source) == 10)
    expect(iter.enumerate_advance(cursor))
    let first = iter.enumerate_current(cursor)
    expect(iter.index(first) == 0 && *iter.value(first) == 20)
    expect(iter.advance(source))
    // The wrapper's current item remains the last item it advanced to.
    expect(*iter.value(iter.enumerate_current(cursor)) == 20)
    let alias = cursor
    expect(iter.enumerate_advance(alias))
    expect(iter.index(iter.enumerate_current(cursor)) == 1)
    expect(*iter.value(iter.enumerate_current(cursor)) == 40)
    expect(!iter.enumerate_advance(cursor) && !iter.enumerate_advance(alias))
    expect(iter.index(first) == 0 && *iter.value(first) == 20)
}
fn resumed() {
    var values = [1, 2, 3]
    let source = values.iter_mut()
    let cursor = iter.enumerate_mut(&mut *source)
    for item in &mut *cursor { *iter.value_mut(item) += 10; break }
    expect(iter.enumerate_advance(cursor))
    let second = iter.enumerate_current_mut(cursor)
    let index = iter.index(second)
    *iter.value_mut(second) += int32(index)
    for item in cursor { *iter.value_mut(item) += 20 }
    expect(!iter.advance(source))
    expect(values.get(0).unwrap_or(0) == 11 && values.get(1).unwrap_or(0) == 3 && values.get(2).unwrap_or(0) == 23)
}
fn entries() {
    var table = Map.new::<Int32, Int32>()
    for _ in iter.enumerate_entries(table.iter()) { expect(false) }
    table.insert(1, 10)
    table.insert(2, 20)
    table.insert(3, 30)
    var count: UInt64 = 0
    for item in iter.enumerate_entries_mut(table.iter_mut()) {
        expect(iter.entry_index(item) == count)
        let entry = iter.entry_mut(item)
        let key = *map.entry_key(entry)
        *map.entry_value_mut(entry) += key
        count += 1
    }
    expect(count == 3)
    let source = table.iter()
    let cursor = iter.enumerate_entries(source)
    expect(iter.enumerate_entries_advance(cursor))
    let first = iter.enumerate_entries_current(cursor)
    let key = *map.entry_key(iter.entry(first))
    expect(iter.entry_index(first) == 0)
    expect(iter.entries_advance(source))
    expect(*map.entry_key(iter.entry(iter.enumerate_entries_current(cursor))) == key)
    expect(iter.enumerate_entries_advance(cursor))
    expect(iter.entry_index(iter.enumerate_entries_current(cursor)) == 1)
    expect(*map.entry_key(iter.entry(first)) == key)
    expect(*map.entry_value(iter.entry(first)) == key * 11)
    expect(!iter.enumerate_entries_advance(cursor))
}
fn invalid_current(which: Int32) -> Int32 {
    let values = [1]
    let cursor = iter.enumerate_ref(values.iter())
    if which == 1 { expect(iter.enumerate_advance(cursor)); expect(!iter.enumerate_advance(cursor)) }
    if which < 2 { return *iter.value(iter.enumerate_current(cursor)) }
    var table = Map.new::<Int32, Int32>()
    table.insert(1, 2)
    let entries = iter.enumerate_entries(table.iter())
    if which == 3 { expect(iter.enumerate_entries_advance(entries)); expect(!iter.enumerate_entries_advance(entries)) }
    *map.entry_value(iter.entry(iter.enumerate_entries_current(entries)))
}
struct Owned { id: Int32, data: Array<Int32> }
impl Drop for Owned { fn drop(&mut self) { record(self.id); } }
fn owned(id: Int32) -> Owned {
    let value = Owned { id: id, data: [id] }
    record(-id)
    value
}
fn consume(action: Int32) -> Int32 {
    var values = [owned(1), owned(2)]
    var table = Map.new::<String, Owned>()
    table.insert("key", owned(3))
    for item in iter.enumerate_mut(slice.iter_mut(values.slice_mut(0, 2))) {
        let index = iter.index(item)
        let value = iter.value_mut(item)
        expect(value.id == int32(index) + 1)
        value.data.push(99)
        if action == 1 { continue }
        if action == 2 { break }
        if action == 3 { return 42 }
        if action == 4 { let invalid = value.id / 0 }
    }
    for item in iter.enumerate_entries_mut(table.iter_mut()) {
        expect(iter.entry_index(item) == 0)
        let entry = iter.entry_mut(item)
        expect(string.byte_length(map.entry_key(entry)) == 3)
        let value = map.entry_value_mut(entry)
        value.data.push(99)
        expect(value.data.len() == 2)
    }
    42
}
fn pending() @suspends -> Int32 {
    var values = [owned(1), owned(2)]
    var table = Map.new::<Int32, Owned>()
    table.insert(3, owned(3))
    for item in iter.enumerate_mut(values.iter_mut()) {
        let index = iter.index(item)
        let value = iter.value_mut(item)
        expect(value.id == int32(index) + 1)
        value.data.push(99)
        delayed_value(record(10 + value.id))
        expect(value.data.len() == 2 && value.id == int32(index) + 1)
        if index == 0 { continue }
        break
    }
    for item in iter.enumerate_entries_mut(table.iter_mut()) {
        let index = iter.entry_index(item)
        let entry = iter.entry_mut(item)
        let key = *map.entry_key(entry)
        let value = map.entry_value_mut(entry)
        value.data.push(99)
        delayed_value(record(10 + value.id))
        expect(index == 0 && key == 3 && value.id == key && value.data.len() == 2)
    }
    42
}
