import joky/domain
import joky/task
import joky/check
import joky/mem
import joky/array.{type Array}

fn assert(condition: Bool) { let message = "owned domain" check.assert(condition, &message) }
struct State { title: String, players: Array<Int32>, flags: Array<Bool>, value: Int32 }
fn make(value: Int32) -> State {
    var players = Array.new::<Int32>()
    players.push(value)
    players.push(value + 1)
    var flags = Array.new::<Bool>()
    flags.push(true)
    let title = if value == 7 { "old房间" } else { "new房间" }
    let temporary = alloc(value)
    State { title: title, players: players, flags: flags, value: *temporary }
}
fn read(state: &State) -> Int32 { state.value }
fn inspect(state: &State) -> Bool {
    let expected = if state.value == 7 { "old房间" } else { "new房间" }
    let temporary = alloc(state.value)
    state.title.equals(&expected) && state.players.len() == 2 && state.players.get(0).unwrap_or(-1) == *temporary && state.flags.get(0).unwrap_or(false)
}
fn change(state: &mut State, value: Int32) -> Int32 {
    var players = Array.new::<Int32>()
    players.push(value)
    players.push(value + 1)
    mem.swap(&mut state.players, &mut players)
    var title = "new房间"
    mem.swap(&mut state.title, &mut title)
    state.value = value
    value
}
struct TextOnly { title: String }
fn text(value: Int32) -> TextOnly { TextOnly { title: if value == 1 { "first" } else { "second" } } }
fn text_ok(state: &TextOnly) -> Bool { let value = "second" state.title.equals(&value) }
fn lifecycle() @suspends -> Int32 {
    let owner = domain.create(make, 7)
    let handle = owner.handle()
    let reader = handle.read_only()
    assert(domain.read_from(reader, inspect).unwrap())
    let snapshot = domain.snapshot_from(reader, read)
    let candidate = domain.candidate_from(snapshot, make, 12)
    task.yield_now()
    assert(domain.read_from(reader, read).unwrap() == 7)
    var receipt = domain.commit_to(handle, candidate)
    assert(match receipt.wait() { Committed(version) => version == 1, _ => false })
    assert(domain.read_from(reader, read).unwrap() == 12 && domain.read_from(reader, inspect).unwrap())
    let stale = domain.candidate_from(domain.snapshot_from(reader, read), make, 99)
    domain.write_to(handle, change, 15).unwrap()
    var conflict = domain.commit_to(handle, stale)
    assert(match conflict.wait() { Conflict => true, _ => false })
    assert(domain.read_from(reader, read).unwrap() == 15 && domain.read_from(reader, inspect).unwrap())
    let single = domain.create(text, 1)
    var published = domain.commit_to(single.handle(), domain.candidate_from(domain.snapshot_from(single.read_handle(), text_ok), text, 2))
    assert(match published.wait() { Committed(_) => true, _ => false })
    assert(domain.read_from(single.read_handle(), text_ok).unwrap())
    owner.close()
    assert(match receipt.wait() { Committed(version) => version == 1, _ => false })
    24
}
fn main() @suspends { assert(lifecycle() == 24) println("owned domains ok") }
