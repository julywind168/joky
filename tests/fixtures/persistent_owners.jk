import joky/mem
import joky/array.{type Array}

struct Resource { id: Int32, text: String }

fn resource(id: Int32) -> Resource { Resource { id: id, text: "payload" } }
enum Choice { Empty, Value(Resource) }
struct State { count: Int32, text: String, values: Array<Resource>, nested: (String, Choice) }
fn make_owner() -> State {
    let temporary = resource(-1)
    var values = Array.new::<Resource>()
    values.push(resource(1))
    State { count: 0, text: "initial", values: values, nested: ("nested", Choice.Value(resource(2))) }
}
fn advance_owner(state: &mut State, id: Int32) @noescape -> Int32 {
    let temporary = resource(-2)
    mem.replace(&mut state.text, "updated");
    state.values.replace(0, resource(id))
    state.count = state.count + 1
    state.count
}
fn owner_count(state: &State) @noescape -> Int32 { state.count }
fn owner_length(state: &State) @noescape -> UInt64 { state.values.len() }
fn owner_grow(state: &mut State, count: Int32) @noescape {
    var index = 0
    while index < count { state.values.push(resource(10 + index)); index = index + 1 }
}
fn owner_clear(state: &mut State) @noescape { state.values.clear() }
fn owner_fail(state: &mut State) @noescape -> Int32 { mem.replace(&mut state.text, "failure"); 1 / 0 }
struct Wrapper { text: String }
fn make_wrapper() -> Wrapper { Wrapper { text: "wrapped" } }
fn wrapper_touch(state: &mut Wrapper) @noescape -> Int32 { mem.replace(&mut state.text, "new"); 42 }

struct Broken { first: Resource, second: Resource }

fn make_broken() -> Broken { Broken { first: resource(4), second: resource(5) } }
fn broken_touch(state: &Broken) @noescape -> Int32 { state.first.id }
struct Generic<T> { id: Int32, values: Array<T> }

fn make_generic() -> Generic<String> {
    var values = Array.new::<String>()
    values.push("generic")
    Generic { id: 6, values: values }
}
fn generic_touch(state: &Generic<String>) @noescape -> UInt64 { state.values.len() }

fn failed_construct() -> State { let broken = make_broken(); make_owner() }
fn failed_touch(state: &mut State) @noescape -> Int32 { let broken = make_broken(); state.count }
fn owner_empty_choice(state: &mut State) @noescape { mem.replace(&mut state.nested, ("nested", Choice.Empty)); }
struct Tree { values: Array<Array<Array<String>>> }
fn branch_task() -> Array<Array<String>> {
    var leaf = Array.new::<String>()
    leaf.push("deep")
    var branch_task = Array.new::<Array<String>>()
    branch_task.push(leaf)
    branch_task
}
fn make_tree() -> Tree {
    var values = Array.new::<Array<Array<String>>>()
    values.push(branch_task())
    Tree { values: values }
}
fn tree_replace(state: &mut Tree) @noescape -> UInt64 { state.values.replace(0, branch_task()); state.values.len() }
fn tree_count(state: &Tree) @noescape -> UInt64 { state.values.len() }
