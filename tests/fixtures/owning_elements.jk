    values.push(failing_element(1))
    values.push(failing_element(2))
    values.push(failing_element(3))
    42
}
fn elements_transitions() -> Int32 {
    var values = Array.new::<ElementResource>()
    var i = 1
    while i <= 5 {
        let item = element_resource(i)
        record_drop(-i)
        values.push(item)
        i = i + 1
    }
    let next = element_resource(6)
    record_drop(-6)
    values.set(1, next)
    let selected = values.take_last()
    record_drop(-selected.id)
    if selected.id == 5 { 42 } else { 0 }
}
fn elements_task() @suspends -> Int32 { elements_transitions() }

struct GenericElement<T> { data: T, values: Array<Int32> }

fn generic_element<T>(data: T) -> Array<GenericElement<T>> {
    var values = Array.new::<GenericElement<T>>()
    values.push(GenericElement { data: data, values: Array.new::<Int32>() })
    values
}
fn elements_generic_metadata() -> Int32 {
    var values = generic_element(42)
    let result = values.take_last()
    result.data
}


enum Message { Empty, Count(Int32), Items(Array<Int32>), Resource(ElementResource), Pair(ElementPair) }
enum Envelope<T> { Absent, Present(T) }
struct EnumContainer { message: Envelope<Message>, id: Int32 }

fn enum_identity<T>(value: T) -> T { value }
fn enums_custom() -> Int32 {
    let unused = Message.Resource(element_resource(1))
    let empty = Message.Empty
    let count = Message.Count(42)
    let result = match count { Count(n) => n, _ => 0 }
