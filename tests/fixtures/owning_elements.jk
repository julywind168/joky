    values.push(FailingEnumContainer { message: Message.Empty, id: 1 })
    values.push(FailingEnumContainer { message: Message.Empty, id: 2 })
    values.push(FailingEnumContainer { message: Message.Empty, id: 3 })
    values.set(1, FailingEnumContainer { message: Message.Empty, id: 4 })
    0
}
fn enum_transform(value: ElementResource) -> ElementResource { value }
fn enum_flatten(value: ElementResource) -> Option<ElementResource> { Option.Some(value) }
fn enums_methods() -> Int32 {
    let option = Option.Some(element_resource(1)).map(enum_transform).and_then(enum_flatten)
    let discarded = option.and(Option.Some(element_resource(2))).is_some()
    let success: Result<ElementResource, ElementResource> = Result.Ok(element_resource(3))
    let success = success.map(enum_transform).and_then(enum_success)
    let result = success.or(Result.Err(element_resource(4))).unwrap_or(element_resource(5))
    let failure: Result<ElementResource, ElementResource> = Result.Err(element_resource(6))
    let error = failure.map_err(enum_transform).err().unwrap_or(element_resource(7))
    if discarded && result.id == 3 && error.id == 6 { 42 } else { 0 }
}
fn enum_success(value: ElementResource) -> Result<ElementResource, ElementResource> { Result.Ok(value) }

