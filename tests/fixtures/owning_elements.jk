fn enums_transitions() -> Int32 {
    let first = element_resource(1)
    record_drop(-1)
    let message = Message.Resource(first)
    let wrapped = Envelope.Present(message)
    record_drop(-1)
    let value = match wrapped { Absent => return 0, Present(value) => value }
    let selected = match value { Resource(item) => item, _ => return 0 }
    var values = Array.new::<ElementResource>()
    values.push(selected)
    let result = values.pop()
    match result { None => 0, Some(item) => { record_drop(-item.id); 42 } }
}
fn enums_task() @suspends -> Int32 { enums_transitions() }

struct FailingEnumContainer { message: Message, id: Int32 }

fn enums_empty_replacement_failure() -> Int32 {
