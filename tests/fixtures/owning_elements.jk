// Direct shared references inspect resources without detaching cleanup groups.
impl ElementResource {
    fn inspect(&self) -> Int32 { self.id + self.values.get(0).unwrap_or(0) }
}
fn borrowed_element<T>(values: &Array<T>, index: UInt64) -> &T { values.borrow_ref(index) }
fn borrowed_identity<T>(value: &T) -> &T { value }
fn borrowed_values(value: &ElementResource) -> &Array<Int32> { &value.values }
fn elements_borrow_shared() -> Int32 {
    var values = Array.new::<ElementResource>()
    values.push(element_resource(1))
    values.push(element_resource(2))
    let first = borrowed_identity(borrowed_element(&values, 0))
    let second = array.borrow_ref(&values, 1)
    let inner = borrowed_values(first)
    let answer = if first.inspect() == 2 && second.id == 2 && inner.len() == 1 && values.len() == 2 { 42 } else { 0 }
    values.reserve(10)
    values.set(0, element_resource(3))
    answer
}
fn elements_borrow_nested() -> Int32 {
    var values = Array.new::<ElementPair>()
    values.push(element_pair(10, 1, 2))
    let pair = values.borrow_ref(0)
    let child = &pair.second
    let inner = &child.values
    if pair.first.id == 1 && child.inspect() == 4 && inner.get(0).unwrap_or(0) == 2 { 42 } else { 0 }
}
