fn enums_cleanup_failure() -> Int32 {
    let first: Option<FailingElement> = Option.Some(failing_element(1))
    let second: Option<FailingElement> = Option.Some(failing_element(2))
    let third: Option<FailingElement> = Option.Some(failing_element(3))
    42
