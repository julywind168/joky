    let selected = enum_forward(success).ok().or(Option.Some(element_resource(2))).unwrap_or(element_resource(3))
    let failure: Result<ElementResource, ElementPair> = Result.Err(element_pair(10, 4, 5))
    let error = match failure { Ok(_) => return 0, Err(error) => error }
    if selected.id == 1 && error.second.id == 5 { 42 } else { 0 }
}
fn enums_overwrite() -> Int32 {
    var message = Message.Resource(element_resource(1))
    message = Message.Empty
    message = Message.Pair(element_pair(10, 2, 3))
    message = Message.Count(42)
    match message { Count(n) => n, _ => 0 }
}
