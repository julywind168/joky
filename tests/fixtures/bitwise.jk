type Word = UInt32
type Wide = UInt64
struct Bits { narrow: Word, wide: Wide }
enum Choice { Empty, Value((Wide, Word)) }
fn mask32(a: Word, b: Word) -> Word { (a & b) | (a ^ b) }
fn mask64(a: Wide, b: Wide) -> Wide { (a & b) | (a ^ b) }
fn max32() -> Word { 0xffff_ffff }
fn max64() -> Wide { 0xffff_ffff_ffff_ffff }
fn min32() -> Int32 { -0x8000_0000 }
fn min64() -> Int64 { -0x8000_0000_0000_0000 }
fn id(n: Wide) -> Wide { n }
fn choice(n: Wide) -> Choice { Choice.Value((~n, 0xffff_ffff)) }
fn arm(e: Choice) -> Wide {
    match e {
        | Empty => (0x80 | 0b11)
        | Value(pair) => { let (a, b) = pair; if b & 1 == 1 { a | 0b11 } else { 0 } }
    }
}
fn nested(e: Choice) -> Wide {
    match e { | Empty => id(0x80 | 0b11) | Value(pair) => match Choice.Empty { | Empty => ~0 | Value(other) => 0 } }
}
fn contexts() -> Wide {
    var p = Bits { narrow: ~0, wide: 1 << 63 }
    let snapshot = p
    p.narrow = p.narrow >> 31
    p.wide = p.wide >> 63
    var (a, (b,)): (Wide, (Word,)) = (~0, (~0,))
    a = a >> 63 b = b >> 31
    let c = 1 | { let n: Wide = 2 n }
    let d = if false { ~0 } else { a }
    if snapshot.narrow == max32() && snapshot.wide == 0x8000_0000_0000_0000 { a + p.wide + c + d } else { 0 }
}
fn snapshots() -> Word {
    var value: Word = 0b1010
    let a = value & { value = 0b0101 value }
    let b = value | { value = 0b1010 value }
    let c = value << { value = 1 value }
    a + b + c + value
}
fn loops() -> Wide {
    var bits: Wide = 0 var i: Wide = 0
    while i < 64 { bits = bits | 1 << i i = i + 1 }
    bits
}
fn precedence() -> Bool {
    1 | 2 ^ 3 & 6 << 1 + 1 == 3 &&
        8 >> 1 + 1 == 2 && 1 << 1 << 2 == 8 &&
        32 >> 1 >> 2 == 4 && ~0 & 0xff == 255 &&
        1 | 2 == 3 && 0b1111 ^ 3 & 6 == 13 &&
        6 & 3 * 2 == 6 && 1 + 2 << 2 == 12
}
fn check() -> Int32 {
    if precedence() && contexts() == 6 && snapshots() == 36 &&
        arm(Choice.Empty) == 131 && arm(choice(max64())) == 3 &&
        nested(Choice.Empty) == 131 && nested(choice(0)) == max64() &&
        loops() == max64() && mask32(0xf0, 0x0f) == 255 &&
        mask64(0xff00, 0xff) == 65_535 &&
        min32() >> 31 == -1 && min64() >> 63 == -1 &&
        max32() >> 31 == 1 && max64() >> 63 == 1 &&
        ~max32() == 0 && ~max64() == 0 &&
        ~min32() == 0x7fff_ffff && ~min64() == 0x7fff_ffff_ffff_ffff &&
        1_000 + 0xff + 0b1010 == 1_265 { 42 } else { -1 }
}
