import joky/array.{type Array}
import joky/drop.{type Drop}
import joky/task

extern fn record_drop(id: Int32)
struct Owned { bytes: Array<Int32>, id: Int32 }
impl Drop for Owned { fn drop(&mut self) { record_drop(self.id) } }
fn make(id: Int32) -> Owned { Owned { bytes: [id], id: id } }
fn hold(local: &mut Int32, value: &mut Owned) @suspends {
    let child = make(2)
    *local = 42
    value.id = *local
    value.bytes.push(*local)
    while true { task.yield_now() }
}
fn fail(local: &mut Int32, value: &mut Owned) @suspends {
    let child = make(2)
    *local = 42
    value.id = *local
    task.yield_now()
    let ignored = 1 / 0
}
fn instant() @suspends {}
fn pending() @suspends {
    var local = 0
    var values = [make(1)]
    hold(&mut local, values.borrow_mut_ref(0))
}
fn failed() @suspends {
    var local = 0
    var values = [make(1)]
    fail(&mut local, values.borrow_mut_ref(0))
}
fn cancelled() @suspends {
    var local = 0
    var values = [make(1)]
    race { | hold(&mut local, values.borrow_mut_ref(0)) | instant() }
    assert(local == 42, "cancelled child finished its mutation")
    values.clear()
}
fn unstarted() @suspends {
    var local = 0
    var values = [make(1)]
    race { | instant() | hold(&mut local, values.borrow_mut_ref(0)) }
    assert(local == 0, "unpolled child has no effects")
}
fn dynamic() @suspends {
    scope {
        var local = 0
        var values = [make(1)]
        let number = &mut local
        let value = values.borrow_mut_ref(0)
        branch { hold(number, value) }
        task.yield_now()
        task.yield_now()
    }
}
fn finish(local: &mut Int32, value: &mut Owned) @suspends {
    let child = make(2)
    task.yield_now()
    *local = 42
    value.id = *local
    value.bytes.push(*local)
}
fn joined(exit: Int32) @suspends {
    var count = 0
    while count < 1 {
        count += 1
        scope {
            var local = 0
            var values = [make(1)]
            let number = &mut local
            let value = values.borrow_mut_ref(0)
            branch { finish(number, value) }
            if exit == 1 { return }
            if exit == 2 { break }
            if exit == 3 { continue }
        }
    }
}
fn main() @suspends {
    cancelled()
    unstarted()
    joined(0)
    joined(1)
    joined(2)
    joined(3)
}
