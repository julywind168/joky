import joky/string
import joky/array.{type Array}
import joky/fixed_array.{type FixedArray}
import joky/slice.{type Slice}
import joky/task

fn check(ok: Bool) { assert(ok, "array literal/pattern regression") }
fn width<T: Copy, const N: UInt64>(values: FixedArray<T, N>) -> UInt64 { N }
fn first<T>(values: Array<T>) -> T {
    match values { [head, ..] => head, [] => panic("empty") }
}
fn pair<T: Copy>(values: FixedArray<T, 2>) -> T { let [first, last] = values; first }
fn matched_pair<T: Copy>(values: FixedArray<T, 2>) -> T { match values { [first, last] => first } }
fn byte_values() -> Array<UInt8> { [1, 255] }
fn fixed_values(flag: Bool) -> FixedArray<Bool, 2> {
    if flag { [true, false] } else { [false, true] }
}
fn next(count: &mut Int32) -> Int32 { *count = *count + 1; *count }
fn literal_checks() {
    var values = [1, 2, 3,]
    values.push(4)
    check(values.len() == 4)
    let narrow: UInt8 = 7
    let inferred = [1, narrow]
    let typed: Array<UInt8> = inferred
    check(typed.get(0).unwrap_or(0) == 1)
    let empty: Array<String> = []
    check(empty.is_empty())
    let zero: FixedArray<Int32, 0> = []
    check(zero.len() == 0)
    let nested: FixedArray<FixedArray<Int32, 2>, 2> = [[1, 2], [3, 4]]
    check(nested.get(1).unwrap_or_else(|| { panic("missing") }).get(0).unwrap_or_else(|| { panic("missing") }) == 3)
    check(width([1, 2, 3]) == 3)
    check(pair([42, 1]) == 42)
    check(matched_pair([42, 1]) == 42)
    let nested_pair: FixedArray<FixedArray<Int32, 2>, 2> = [[42, 1], [2, 3]]
    check(pair(nested_pair).get(0).unwrap_or(0) == 42)
    check(first([20, 22]) == 20)
    check(byte_values().len() == 2)
    check(fixed_values(true).get(0).unwrap_or(false))
    var count = 0
    let ordered = [next(&mut count), next(&mut count), next(&mut count)]
    match &ordered { [1, 2, 3] => {}, _ => panic("evaluation order") }
    let fixed_ordered: FixedArray<Int32, 2> = [next(&mut count), next(&mut count)]
    match fixed_ordered { [4, 5] => {}, _ => panic("fixed evaluation order") }
    let rows = [[1, 2], [3]]
    match &rows { [[1, 2], [3]] => {}, _ => panic("nested arrays") }
    let text = "literal {[1, 2]}"
    check(text == "literal [1, 2]")
}
fn shared(values: &Array<Int32>) -> Int32 {
    match values {
        [] => 0
        [0, ..] => 100
        [only] => only
        [first, ..middle, last] => first + last + slice.len(middle).to_i32().unwrap_or_else(|| { panic("missing") })
    }
}
fn slice_value(values: &Slice<Int32>) -> Int32 {
    match values { [] => 0, [first, .., last] => first + last, [x] => x }
}
fn patterns() {
    let a = [1, 2, 3, 4]
    check(shared(&a) == 7)
    check(slice_value(a.slice(1, 3)) == 5)
    let b: FixedArray<Int32, 3> = [1, 2, 3]
    let [x, ..middle, z] = b
    check(x + z + middle.get(0).unwrap_or_else(|| { panic("missing") }) == 6)
    let [p, q, r] = &b
    check(p + q + r == 6)
    match &b { [head, ..tail] => check(head + slice.get(tail, 0).unwrap_or_else(|| { panic("missing") }) == 3) }
}
fn mutable_patterns() {
    var c = [1, 2, 3]
    match &mut c {
        [first, ..rest, last] => { *first = 10; *last = 20; slice.set(rest, 0, 12); }
        _ => {}
    }
    check(c.get(0).unwrap_or_else(|| { panic("missing") }) + c.get(1).unwrap_or_else(|| { panic("missing") }) + c.get(2).unwrap_or_else(|| { panic("missing") }) == 42)
    var fixed_mut: FixedArray<Int32, 3> = [1, 2, 3]
    match &mut fixed_mut { [first, middle, last] => { *first = 10; *middle = 12; *last = 20; } }
    check(fixed_mut.get(0).unwrap_or_else(|| { panic("missing") }) + fixed_mut.get(1).unwrap_or_else(|| { panic("missing") }) + fixed_mut.get(2).unwrap_or_else(|| { panic("missing") }) == 42)
    var nested = [[1, 2], [3, 4]]
    match &mut nested { [[a, b], [c, d]] => { *a = 10; *b = 11; *c = 12; *d = 9; }, _ => {} }
    match nested { [[10, 11], [12, 9]] => {}, _ => panic("nested mutation") }
}
fn owned_patterns() {
    let names = ["a", "b", "c", "d"]
    match &names { [head, ..rest, last] => { check(head == "a"); check(slice.len(rest) == 2); check(last == "d"); }, _ => {} }
    match names {
        [head, ..rest, last] => {
            check(head == "a")
            check(last == "d")
            match rest { [a, b] => { check(a == "b"); check(b == "c"); }, _ => panic("rest order") }
        }
        _ => panic("owned sequence")
    }
    let optional = Some([Some(20), None, Some(22)])
    match optional { Some([Some(a), None, Some(b)]) => check(a + b == 42), _ => panic("nested enum") }
}
fn coverage_patterns() {
    let flags: FixedArray<Bool, 2> = [true, false]
    let answer = match flags { [true, true] => 1, [true, false] => 42, [false, ..] => 0 }
    check(answer == 42)
    let scalar = match -2 { -1 => 1, -2 => 42, _ => 0 }
    check(scalar == 42)
    check(match &scalar { 42 => true, _ => false })
    check(match true { true => true, false => false })
    check(match '界' { '界' => true, _ => false })
    var loop_values = [1, 2, 3]
    var sum = 0
    while let [head, ..] = &loop_values { sum = sum + head; loop_values.remove(0); }
    check(sum == 6)
    let single = [42]
    if let [one] = &single { check(one == 42) }
}
fn after(value: Int32) @suspends -> Int32 { task.yield_now(); value }
fn async_checks() @suspends {
    let values = [after(20), after(22)]
    let sum = match &values { [a, b] => a + b, _ => 0 }
    task.yield_now()
    check(sum == 42)
    let names = ["first", "middle", "last"]
    match names {
        [head, ..tail] => { task.yield_now(); check(head == "first"); check(tail.len() == 2); }
        [] => panic("empty async sequence")
    }
}
struct Packet<T> { values: T }
fn optional_fixed() -> Option<FixedArray<Bool, 2>> { Some([true, false]) }
fn generic_packet<T>(value: T) -> Packet<T> { Packet { values: value } }
fn contextual_checks() {
    let packet: Packet<FixedArray<Bool, 2>> = Packet { values: [true, false] }
    let Packet { values: [a, b] } = packet
    check(a && !b)
    match optional_fixed() { Some([true, false]) => {}, _ => panic("optional fixed context") }
    let packet = generic_packet([1, 2])
    check(packet.values.len() == 2)
    let zeros = [{}, {}, {}]
    match zeros { [a, ..tail, b] => check(tail.len() == 1), _ => panic("zero-sized sequence") }
    let zeros: FixedArray<Unit, 3> = [{}, {}, {}]
    let [a, ..tail, b] = zeros
    check(tail.len() == 1)
    let empty: FixedArray<Unit, 0> = []
    match empty { [] => {} }
    let empty: Array<Int32> = []
    match empty { [..tail] => check(tail.is_empty()) }
    let value = &*(alloc(42))
    let references = [value, value]
    let copied = match &references { [first, ..] => first, [] => panic("missing reference") }
    references.release()
    check(*copied == 42)
    let references = [value, value]
    let consumed = match references { [first, ..tail] => first, [] => panic("missing consumed reference") }
    check(*consumed == 42)
    let f = || { let values = [20, 22]; match values { [a, b] => a + b, _ => 0 } }
    check(f() == 42)
}
fn main() @suspends {
    literal_checks()
    contextual_checks()
    patterns()
    mutable_patterns()
    owned_patterns()
    coverage_patterns()
    async_checks()
    println("array patterns ok")
}
