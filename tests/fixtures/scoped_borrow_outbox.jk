import joky/outbox
import joky/domain
import joky/vm
import joky/task
import joky/check

struct Settings { messages: UInt64, bytes: UInt64 }
fn publish(engine: &vm.Vm, target: outbox.Handle) @suspends {
    engine.call::<outbox.Handle, Unit>("send", target)
}
fn closed(target: outbox.Handle) @suspends {
    task.yield_now()
    target.close()
}
fn exercise(settings: &Settings) @suspends -> Int32 {
    let directory = domain.directory(2)
    directory.handle();
    directory.close()
    let engine = vm.Vm.interpreter()
    engine.load_source("import joky/domain import joky/outbox\nstruct State {{ value: Int32 }}\nfn make(value: Int32) -> State {{ State {{ value }} }}\nfn send(target: outbox.Handle) @suspends {{ let owner = domain.create(make, 0); let handle = owner.handle(); when \"send\" (mut handle) {{ handle.value += 1; let bytes = \"中\\0🙂\".into_bytes(); target.send(&bytes); let empty = \"\".into_bytes(); target.send(&empty); let result: Result<Unit, Int32> = Ok({{}}); result }}.unwrap(); }}")!
    var queue = outbox.create(settings.messages, settings.bytes)
    let target = queue.handle()
    publish(&engine, target)
    let message = queue.receive()!
    let text = String.from_utf8(message)!
    if !text.equals("中\0🙂") { return -1 }
    if !queue.receive()!.is_empty() { return -5 }
    let (_, end) = join { closed(target), queue.receive() }
    if end.is_some() { return -2 }
    var control = outbox.create(1, 1)
    var other = outbox.create_with_policy(1, 1, outbox.Overflow.Disconnect(control.handle()))
    let other_handle = other.handle()
    other_handle.close()
    if other.receive().is_some() { return -3 }
    let control_handle = control.handle()
    control_handle.close()
    if control.receive().is_some() { return -4 }
    21
}
fn blocked(settings: &Settings) @suspends -> Int32 {
    var queue = outbox.create(settings.messages, settings.bytes)
    queue.receive();
    -1
}
fn nested(settings: &Settings) @suspends -> Int32 {
    let (a, b) = join { exercise(settings), exercise(settings) }
    a + b
}
fn main() @suspends -> Int32 {
    let settings = Settings { messages: 2, bytes: 64 }
    let (a, b) = join { nested(&settings), nested(&settings) }
    if a + b != 84 { return 1 }
    let view = &settings
    scope { branch { if exercise(view) != 21 { check.panic("bad outbox result") } } }
    if (race { blocked(view), exercise(view) }) != 21 { return 2 }
    0
}
fn parked() @suspends -> Int32 {
    let settings = Settings { messages: 2, bytes: 64 }
    let (a, b) = join { blocked(&settings), blocked(&settings) }
    a + b
}
fn allocate(settings: &Settings) @suspends -> Int32 {
    let directory = domain.directory(settings.messages)
    directory.handle();
    var queue = outbox.create(settings.messages, settings.bytes)
    let handle = queue.handle()
    handle.close()
    if queue.receive().is_some() { return -1 }
    21
}
fn allocation_budget() @suspends -> Int32 {
    let settings = Settings { messages: 2, bytes: 64 }
    let (a, b) = join { allocate(&settings), allocate(&settings) }
    a + b
}
