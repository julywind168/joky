import joky/domain
import joky/task
import joky/check
import joky/array.{type Array}
fn assert(value: Bool) { let message = "SC2 scalar Array matrix"; check.assert(value, &message) }
struct Matrix {
    count: Int32,
    units: Array<Unit>,
    bools: Array<Bool>,
    runes: Array<Rune>,
    i8: Array<Int8>,
    i16: Array<Int16>,
    i32: Array<Int32>,
    i64: Array<Int64>,
    u8: Array<UInt8>,
    u16: Array<UInt16>,
    u32: Array<UInt32>,
    u64: Array<UInt64>,
    f32: Array<Float32>,
    f64: Array<Float64>,
}
fn make(count: Int32) -> Matrix {
    var units = Array.new::<Unit>()
    if count != 0 { let low: Unit = {}; let high: Unit = {}; units.push(low); units.push(high) }
    var bools = Array.new::<Bool>()
    if count != 0 { let low: Bool = false; let high: Bool = true; bools.push(low); bools.push(high) }
    var runes = Array.new::<Rune>()
    if count != 0 { let low: Rune = '\0'; let high: Rune = '中'; runes.push(low); runes.push(high) }
    var i8 = Array.new::<Int8>()
    if count != 0 { let low: Int8 = -128; let high: Int8 = 127; i8.push(low); i8.push(high) }
    var i16 = Array.new::<Int16>()
    if count != 0 { let low: Int16 = -32768; let high: Int16 = 32767; i16.push(low); i16.push(high) }
    var i32 = Array.new::<Int32>()
    if count != 0 { let low: Int32 = -2147483648; let high: Int32 = 2147483647; i32.push(low); i32.push(high) }
    var i64 = Array.new::<Int64>()
    if count != 0 { let low: Int64 = -9223372036854775808; let high: Int64 = 9223372036854775807; i64.push(low); i64.push(high) }
    var u8 = Array.new::<UInt8>()
    if count != 0 { let low: UInt8 = 0; let high: UInt8 = 255; u8.push(low); u8.push(high) }
    var u16 = Array.new::<UInt16>()
    if count != 0 { let low: UInt16 = 0; let high: UInt16 = 65535; u16.push(low); u16.push(high) }
    var u32 = Array.new::<UInt32>()
    if count != 0 { let low: UInt32 = 0; let high: UInt32 = 4294967295; u32.push(low); u32.push(high) }
    var u64 = Array.new::<UInt64>()
    if count != 0 { let low: UInt64 = 0; let high: UInt64 = 18446744073709551615; u64.push(low); u64.push(high) }
    var f32 = Array.new::<Float32>()
    if count != 0 { let low: Float32 = Float32.from_bits(2147483648); let high: Float32 = Float32.from_bits(2143289410); f32.push(low); f32.push(high) }
    var f64 = Array.new::<Float64>()
    if count != 0 { let low: Float64 = Float64.from_bits(9223372036854775808); let high: Float64 = Float64.from_bits(9221120237041090626); f64.push(low); f64.push(high) }
    Matrix { count: count, units: units, bools: bools, runes: runes, i8: i8, i16: i16, i32: i32, i64: i64, u8: u8, u16: u16, u32: u32, u64: u64, f32: f32, f64: f64 }
}
fn count(state: &Matrix) -> Int32 { state.count }
fn valid(state: &Matrix) -> Bool {
    if state.units.len() != uint64(state.count) { return false }
    if state.bools.len() != uint64(state.count) { return false }
    if state.runes.len() != uint64(state.count) { return false }
    if state.i8.len() != uint64(state.count) { return false }
    if state.i16.len() != uint64(state.count) { return false }
    if state.i32.len() != uint64(state.count) { return false }
    if state.i64.len() != uint64(state.count) { return false }
    if state.u8.len() != uint64(state.count) { return false }
    if state.u16.len() != uint64(state.count) { return false }
    if state.u32.len() != uint64(state.count) { return false }
    if state.u64.len() != uint64(state.count) { return false }
    if state.f32.len() != uint64(state.count) { return false }
    if state.f64.len() != uint64(state.count) { return false }
    if state.count == 0 { return true }
    if !state.units.get(0).is_some() || !state.units.get(1).is_some() { return false }
    let low_bools: Bool = false
    let high_bools: Bool = true
    if state.bools.get(0).unwrap_or(high_bools) != low_bools || state.bools.get(1).unwrap_or(low_bools) != high_bools { return false }
    let low_runes: Rune = '\0'
    let high_runes: Rune = '中'
    if state.runes.get(0).unwrap_or(high_runes) != low_runes || state.runes.get(1).unwrap_or(low_runes) != high_runes { return false }
    let low_i8: Int8 = -128
    let high_i8: Int8 = 127
    if state.i8.get(0).unwrap_or(high_i8) != low_i8 || state.i8.get(1).unwrap_or(low_i8) != high_i8 { return false }
    let low_i16: Int16 = -32768
    let high_i16: Int16 = 32767
    if state.i16.get(0).unwrap_or(high_i16) != low_i16 || state.i16.get(1).unwrap_or(low_i16) != high_i16 { return false }
    let low_i32: Int32 = -2147483648
    let high_i32: Int32 = 2147483647
    if state.i32.get(0).unwrap_or(high_i32) != low_i32 || state.i32.get(1).unwrap_or(low_i32) != high_i32 { return false }
    let low_i64: Int64 = -9223372036854775808
    let high_i64: Int64 = 9223372036854775807
    if state.i64.get(0).unwrap_or(high_i64) != low_i64 || state.i64.get(1).unwrap_or(low_i64) != high_i64 { return false }
    let low_u8: UInt8 = 0
    let high_u8: UInt8 = 255
    if state.u8.get(0).unwrap_or(high_u8) != low_u8 || state.u8.get(1).unwrap_or(low_u8) != high_u8 { return false }
    let low_u16: UInt16 = 0
    let high_u16: UInt16 = 65535
    if state.u16.get(0).unwrap_or(high_u16) != low_u16 || state.u16.get(1).unwrap_or(low_u16) != high_u16 { return false }
    let low_u32: UInt32 = 0
    let high_u32: UInt32 = 4294967295
    if state.u32.get(0).unwrap_or(high_u32) != low_u32 || state.u32.get(1).unwrap_or(low_u32) != high_u32 { return false }
    let low_u64: UInt64 = 0
    let high_u64: UInt64 = 18446744073709551615
    if state.u64.get(0).unwrap_or(high_u64) != low_u64 || state.u64.get(1).unwrap_or(low_u64) != high_u64 { return false }
    let low_f32: Float32 = Float32.from_bits(2147483648)
    let high_f32: Float32 = Float32.from_bits(2143289410)
    if state.f32.get(0).unwrap_or(high_f32).to_bits() != low_f32.to_bits() || state.f32.get(1).unwrap_or(low_f32).to_bits() != high_f32.to_bits() { return false }
    let low_f64: Float64 = Float64.from_bits(9223372036854775808)
    let high_f64: Float64 = Float64.from_bits(9221120237041090626)
    if state.f64.get(0).unwrap_or(high_f64).to_bits() != low_f64.to_bits() || state.f64.get(1).unwrap_or(low_f64).to_bits() != high_f64.to_bits() { return false }
    true
}
fn clear(state: &mut Matrix, ignored: Unit) {
    state.units.clear()
    state.bools.clear()
    state.runes.clear()
    state.i8.clear()
    state.i16.clear()
    state.i32.clear()
    state.i64.clear()
    state.u8.clear()
    state.u16.clear()
    state.u32.clear()
    state.u64.clear()
    state.f32.clear()
    state.f64.clear()
    state.count = 0
}
fn lifecycle() @suspends -> Int32 {
    let owner = domain.create(make, 0)
    let handle = owner.handle()
    let reader = handle.read_only()
    assert(domain.read_from(reader, valid).unwrap())
    let candidate = domain.candidate_from(domain.snapshot_from(reader, count), handle, make, 2)
    task.yield_now()
    var first = domain.commit_to(handle, candidate)
    assert(match first.wait() { Ok(n) => n == 1, _ => false })
    assert(domain.read_from(reader, valid).unwrap())
    domain.write_to(handle, clear, {}).unwrap()
    assert(domain.read_from(reader, valid).unwrap())
    var second = domain.commit_to(handle, domain.candidate_from(domain.snapshot_from(reader, count), handle, make, 2))
    assert(match second.wait() { Ok(n) => n == 3, _ => false })
    assert(domain.read_from(reader, valid).unwrap())
    24
}
fn main() @suspends { assert(lifecycle() == 24); println("SC2 scalar Arrays ok") }
