import joky/admission
import joky/base64
import joky/domain
import joky/fs
import joky/hex
import joky/http
import joky/internal/resolve
import joky/json
import joky/json/typed
import joky/log
import joky/outbox
import joky/password
import joky/postgres
import joky/random
import joky/shutdown
import joky/task
import joky/tcp
import joky/tls
import joky/uuid
import joky/vm
import joky/string
import joky/show.{type Show}
import joky/check.{assert}
import joky/io.{eprintln}
import joky/result.{type Result, Ok, Err}
import joky/array.{type Array}

// Repeated formatting must leave owning error payloads available to the caller.
fn displays<T: Show>(value: &T, expected: &String) @noescape {
    assert(value.to_text() == expected, "error display")
    assert("{value}" == expected, "error interpolation")
}
fn diagnostic() -> vm.Diagnostic {
    vm.Diagnostic { message: "unknown name", has_span: true, start: 3, end: 7 }
}
fn main() @suspends {
    displays(task.Failure.Runtime, "runtime failure")
    displays(task.Failure.ResourceLimit, "resource limit")
    displays(task.Failure.Host, "host failure")
    displays(task.Failure.Io, "I/O failure")
    displays(task.Failure.InvalidState, "invalid state")
    displays(task.Failure.InvalidArgument, "invalid argument")
    displays(task.Failure.Other, "task failure")
    displays(task.Timeout {}, "operation timed out")
    displays(admission.AcquireError.WaitLimit, "admission wait limit exceeded")
    displays(shutdown.Reason.Interrupt, "interrupt")
    displays(shutdown.SignalError.Busy, "signal subscription busy")
    displays(outbox.StageError.Full, "outbox full")
    displays(domain.DomainAccessError.Missing(42), "missing domain entry: 42")
    displays(domain.DomainAccessError.OutboxFull(7), "outbox full: 7")
    displays(domain.DomainAccessError.DirectoryFull(9), "directory full: 9")
    displays(domain.SnapshotStatus.Conflict, "conflict")
    displays(domain.RequestError.Cancelled, "request cancelled")
    displays(domain.CommitError.Expired, "commit expired")
    displays(domain.RevisionError.Failed(domain.CommitError.Conflict), "commit conflict")
    displays(domain.DirectoryError.Occupied, "directory entry occupied")
    displays(domain.TimerStatus.Active, "active")
    displays(domain.TimerError.InvalidDelay, "invalid timer delay")
    displays(fs.FileKind.Symlink, "symbolic link")
    displays(log.Level.Warn, "WARN")
    displays(log.Emission.Filtered, "filtered")
    displays(postgres.Kind.Integer, "integer")
    displays(postgres.ReadFailure.NoRows, "query returned no rows")
    displays(postgres.DbError.ResultRead(postgres.ReadFailure.NoRows), "query returned no rows")
    displays(random.RandomError.Unavailable, "secure randomness unavailable")
    displays(password.PasswordError.InvalidHash, "invalid password hash")
    displays(base64.DecodeError.InvalidLength, "invalid base64 length")
    displays(base64.DecodeError.InvalidByte(4), "invalid base64 character at byte 4")
    displays(base64.DecodeError.InvalidPadding(8), "invalid base64 padding at byte 8")
    displays(base64.DecodeError.NonCanonical(3), "non-canonical base64 at byte 3")
    displays(hex.DecodeError.InvalidByte(1), "invalid hex digit at byte 1")
    displays(uuid.ParseError.InvalidByte(17), "invalid UUID character at byte 17")
    displays(uuid.V7Error.InvalidTimestamp, "timestamp outside UUID v7 range")
    displays(uuid.V7Error.Random(random.RandomError.Unavailable), "secure randomness unavailable")
    displays(string.Utf8ErrorCode.UnexpectedEnd, "truncated UTF-8 sequence")
    displays(string.SplitError.EmptySeparator, "empty string separator")

    displays(http.Method.Get, "GET")
    displays(http.Method.Head, "HEAD")
    displays(http.Method.Post, "POST")
    displays(http.Method.Put, "PUT")
    displays(http.Method.Patch, "PATCH")
    displays(http.Method.Delete, "DELETE")
    displays(http.ServeError.InvalidOptions, "invalid HTTP server options")
    displays(http.ServeError.AcceptFailed, "HTTP accept failed")
    displays(http.ServeError.Deadline, "HTTP shutdown deadline exceeded")
    displays(http.ClientError.Handshake(tls.TlsError.Certificate), "HTTP TLS handshake failed: TLS certificate verification failed")
    displays(http.ClientError.ConnectTimeout, "HTTP connection timed out")
    displays(http.ClientError.ExchangeTimeout, "HTTP exchange timed out")
    displays(http.ClientError.UnsupportedFraming, "unsupported HTTP framing")
    displays(tls.TlsError.UnexpectedEof, "unexpected TLS EOF")
    displays(tcp.ErrorKind.ConnectionRefused, "connection refused")
    displays(tcp.Shutdown.Both, "both")
    displays(tcp.ReadError.UnexpectedEof(3), "unexpected TCP EOF after 3 bytes")
    displays(tcp.ReadError.InvalidUtf8(string.Utf8Error { code: string.Utf8ErrorCode.InvalidSequence, offset: 2 }), "invalid UTF-8 sequence at byte 2")
    displays(resolve.ErrorKind.NoAddresses, "no addresses found")
    let lookup = resolve.ResolveError { kind: resolve.ErrorKind.InvalidInput, message: "bad host" }
    displays(lookup, "invalid host name: bad host")
    assert(lookup.message == "bad host", "resolver error remains owned")
    let connection = http.ClientError.Connect(tcp.EndpointError.Resolve(lookup))
    displays(connection, "HTTP connection failed: invalid host name: bad host")
    displays(tcp.EndpointError.Resolve(resolve.ResolveError { kind: resolve.ErrorKind.Busy, message: "" }), "resolver busy")

    // A second listener on an admitted local port gives a real opaque IoError.
    var listener = tcp.TcpListener.bind(tcp.Address.ipv4(0x7f000001, 0))!
    let address = listener.local_addr()!
    let io = tcp.TcpListener.bind(address).err()!
    assert(io.kind() == tcp.ErrorKind.AddrInUse, "occupied listener")
    assert(io.os_code() != 0, "OS error code retained")
    let expected = "address in use (OS error {io.os_code()})"
    displays(io, expected)
    displays(tcp.EndpointError.Io(io), expected)
    displays(tcp.ReadError.Io(io), expected)
    displays(tls.TlsError.Io(io), expected)
    listener.close()!

    displays(json.NumberErrorKind.NotInteger, "JSON number is not an integer")
    displays(json.NumberError { kind: json.NumberErrorKind.OutOfRange, offset: 4 }, "JSON number out of range at byte 4")
    displays(json.DecodeErrorKind.InvalidEscape, "invalid JSON escape")
    displays(json.DecodeError { kind: json.DecodeErrorKind.UnexpectedEof, offset: 0 }, "unexpected end of JSON input at byte 0")
    displays(json.EncodeError.OutputLimit, "JSON output limit exceeded")
    displays(typed.MappingErrorKind.MissingField, "missing field")
    let mapping = typed.MappingError {
        kind: typed.MappingErrorKind.ExpectedNumber,
        path: [typed.PathSegment.Field("a~/b"), typed.PathSegment.Index(2)]
    }
    displays(mapping, "expected number at /a~0~1b/2")
    assert(mapping.pointer() == "/a~0~1b/2", "mapping path remains owned")
    let codec = typed.CodecError.Mapping(mapping)
    displays(codec, "expected number at /a~0~1b/2")
    displays(typed.MappingError { kind: typed.MappingErrorKind.ExpectedObject, path: [] }, "expected object at root")
    displays(typed.CodecError.Syntax(json.DecodeError { kind: json.DecodeErrorKind.TrailingData, offset: 12 }), "trailing JSON data at byte 12")
    displays(typed.CodecError.Encoding(json.EncodeError.DepthLimit), "JSON depth limit exceeded")

    displays(vm.CallError.Incompatible, "incompatible script entry")
    displays(diagnostic(), "unknown name at bytes 3..7")
    displays(vm.LoadErrorKind.Compile(diagnostic()), "script compilation failed: unknown name at bytes 3..7")
    let load = vm.LoadError { path: "app.jk", kind: vm.LoadErrorKind.Compile(diagnostic()) }
    displays(load, "app.jk: script compilation failed: unknown name at bytes 3..7")
    assert(load.path == "app.jk", "load error remains owned")
    displays(vm.LoadError { path: "", kind: vm.LoadErrorKind.Io(fs.IoError { kind: fs.ErrorKind.NotFound, message: "missing" }) }, "NotFound: missing")
    displays(vm.Diagnostic { message: "failed", has_span: false, start: 0, end: 0 }, "failed")
    displays(vm.MigrationErrorKind.Busy, "migration busy")
    displays(vm.MigrationError { kind: vm.MigrationErrorKind.Compile, diagnostic: diagnostic() }, "migration compilation failed: unknown name at bytes 3..7")
    displays(vm.MigrationError { kind: vm.MigrationErrorKind.Busy, diagnostic: vm.Diagnostic { message: "", has_span: false, start: 0, end: 0 } }, "migration busy")

    let failures: Array<task.Failure> = [task.Failure.Io, task.Failure.Host]
    displays(failures, "[I/O failure, host failure]")
    let result: Result<Int32, http.ClientError> = Err(connection)
    displays(result, "Err(HTTP connection failed: invalid host name: bad host)")
    eprintln("connection {42}: {task.Failure.Io}")
    eprintln(codec)
}
