import joky/array.{type Array}
import joky/drop.{type Drop}

extern fn record_drop(value: Int32)

struct Resource { id: Int32, values: Array<Int32> }
impl Drop for Resource {
    fn drop(&mut self) { record_drop(self.id) }
}
fn resource(id: Int32) -> Resource { Resource { id: id, values: Array.new::<Int32>() } }
fn moved(value: Resource) -> Resource { value }
fn drop_scope() -> Int32 {
    let first = resource(1)
    {
        var second = resource(2)
        second.id = 3
    }
    42
}
fn drop_moves() -> Int32 {
    let first = resource(1)
    let second = moved(first)
    42
}
fn drop_replace() -> Int32 {
    var value = resource(1)
    value = resource(2)
    value.id = 3
    42
}
fn drop_return(flag: Bool) -> Int32 {
    let first = resource(1)
    if flag { let second = resource(2); return 42 }
    42
}
fn drop_loops() -> Int32 {
    var i = 0
    while i < 3 {
        let value = resource(i)
        i = i + 1
        if i == 1 { continue }
        if i == 3 { break }
    }
    42
}
fn drop_failure() -> Int32 {
    let first = resource(1)
    let second = resource(2)
    1 / 0
}
fn drop_task() @suspends -> Int32 { drop_scope() }

fn drop_early() -> Int32 { drop_return(true) }
struct Outer { id: Int32, inner: Resource }
impl Drop for Outer { fn drop(&mut self) { record_drop(self.id) } }
fn drop_nested() -> Int32 {
    let value = Outer { id: 1, inner: resource(2) }
    42
}
struct Generic<T> { id: Int32, values: Array<T> }
impl<T> Drop for Generic<T> { fn drop(&mut self) { record_drop(self.id) } }
fn drop_generic() -> Int32 {
    let value = Generic { id: 4, values: Array.new::<Int32>() }
    42
}
fn drop_discard() -> Int32 { resource(5); 42 }
fn drop_partial() -> Int32 { let value = Outer { inner: resource(2), id: 1 / 0 }; 42 }
struct Fails { id: Int32, values: Array<Int32> }
impl Drop for Fails { fn drop(&mut self) { record_drop(self.id); let bad = 1 / 0 } }
fn drop_failing_hook() -> Int32 {
    let first = resource(1)
    let second = Fails { id: 2, values: Array.new::<Int32>() }
    42
}

fn tracked(id: Int32) -> Resource {
    let value = resource(id)
    record_drop(0 - id)
    value
}
struct Empty { unit: Unit }
fn pass_pair(unit: Unit, empty: Empty, first: Resource, tag: Unit, second: Resource) -> Resource { first }
fn drop_transitions() -> Int32 {
    var value = pass_pair({}, Empty { unit: {} }, tracked(1), {}, tracked(2))
    value = tracked(3)
    let moved = { value }
    var i = 4
    while i < 7 {
        let item = tracked(i)
        i = i + 1
    }
    42
}
fn drop_transition_task() @suspends -> Int32 { drop_transitions() }
fn drop_return_failure() -> Resource {
    let bad = Fails { id: 2, values: Array.new::<Int32>() }
    tracked(1)
}
fn drop_failed_return() -> Int32 { let value = drop_return_failure(); 42 }

struct Leading { inner: Resource, extra: Int64, flag: Bool }
impl Drop for Leading { fn drop(&mut self) { if self.flag { record_drop(int32(self.extra)) } } }
fn drop_leading_owner() -> Int32 {
    let value = Leading { inner: resource(2), extra: 1, flag: true }
    42
}
fn drop_shadow() -> Int32 { let value = resource(1); let value = resource(2); 42 }
fn drop_reinitialize() -> Int32 {
    var first = resource(1)
    let second = first
    first = resource(2)
    42
}
fn drop_reinitialize_failure() -> Int32 {
    var first = resource(1)
    let second = first
    first = resource(2)
    1 / 0
}
fn select_resource(flag: Bool) -> Resource {
    let first = resource(1)
    let second = resource(2)
    if flag { first } else { second }
}
fn drop_branch() -> Int32 { let value = select_resource(true); 42 }
fn drop_original_failure() -> Int32 {
    let first = resource(1)
    let second = Fails { id: 2, values: Array.new::<Int32>() }
    1 << 32
}

struct Changes { inner: Resource, id: Int32 }
impl Drop for Changes {
    fn drop(&mut self) { record_drop(self.id); self.inner.id = 9; self.inner.values.push(42) }
}
fn drop_mutated_child() -> Int32 {
    let value = Changes { inner: resource(2), id: 1 }
    42
}
fn drop_reuse_budget() -> Int32 {
    var i = 0
    while i < 80 {
        let values = Array.with_capacity::<Int32>(262144)
        i = i + 1
    }
    let released = Array.new::<Int32>()
    released.release()
    42
}

// Failure must use declaration order after a moved binding is initialized again.
fn drop_reused_registration() -> Int32 {
    var first = resource(1)
    let middle = resource(2)
    let last = resource(3)
    let moved = first
    first = resource(4)
    1 / 0
}
