struct Node { value: Int32, next: Option<&Node> }
fn next(node: &Node) -> &Node { node.next.unwrap_or(node) }

fn cycle_self() -> Int32 {
    let root: &Node = graph {
        let node = graph.alloc(Node { value: 42, next: None })
        graph.link(node.next, node)
        node
    }
    next(next(root)).value
}

fn make_cycle(value: Int32) -> &Node {
    graph {
        let a = graph.alloc(Node { value: value, next: None });
        let b = graph.alloc(Node { value: 22, next: None });
        graph.link(a.next, b); graph.link(b.next, a);
        a
    }
}
fn cycle_pair() -> Int32 {
    let a = make_cycle(20)
    next(a).value + next(next(a)).value
}

struct Edges { left: Option<&Fork>, right: Option<&Fork> }
struct Fork { value: Int32, edges: Edges }
fn cycle_shared() -> Int32 {
    let root = graph {
        let a = graph.alloc(Fork { value: 0, edges: Edges { left: None, right: None } })
        let b = graph.alloc(Fork { value: 21, edges: Edges { left: None, right: None } })
        graph.link(a.edges.left, b)
        graph.link(a.edges.right, b)
        graph.link(b.edges.left, a)
        a
    }
    root.edges.left.unwrap_or(root).value + root.edges.right.unwrap_or(root).value
}

struct Left { value: Int32, next: Option<&Right> }
struct Right { value: Int32, previous: Option<&Left> }
fn cycle_mutual() -> Int32 {
    let root = graph {
        let a = graph.alloc(Left { value: 20, next: None })
        let b = graph.alloc(Right { value: 22, previous: None })
        graph.link(a.next, b)
        graph.link(b.previous, a)
        a
    }
    match root.next {
        | None => 0
        | Some(b) => b.value + b.previous.unwrap_or(root).value
    }
}

type View<T> = &GenericNode<T>
struct GenericNode<T> { value: T, next: Option<View<T>> }
fn generic_cycle<T>(value: T) -> View<T> {
    graph {
        let node = graph.alloc(GenericNode { value: value, next: None })
        graph.link(node.next, node)
        node
    }
}
fn cycle_generic() -> Int32 {
    let root = generic_cycle(42)
    root.next.unwrap_or(root).value
}

fn cycle_loop() -> Int32 {
    var total = 0
    var i = 0
    while i < 3 {
        let root = graph {
            let a = graph.alloc(Node { value: 7, next: None })
            let b = graph.alloc(Node { value: 7, next: None })
            graph.link(a.next, b)
            graph.link(b.next, a)
            a
        }
        total = total + root.value + next(root).value
        i = i + 1
    }
    total
}

fn cycle_data_control() -> Int32 {
    let root = graph {
        var value = 0
        while value < 42 {
            value = value + 1
            if value == 42 { break; }
            continue;
        }
        let node = graph.alloc(Node { value: if value == 42 { value } else { 0 }, next: None })
        graph.link(node.next, node)
        node
    }
    next(root).value
}

struct Point { value: Int32 }
struct External { value: &Point, next: Option<&External> }
fn cycle_external() -> Int32 {
    let point = alloc(Point { value: 21 })
    let root = graph {
        let node = graph.alloc(External { value: point, next: None })
        graph.link(node.next, node)
        node
    }
    root.value.value + root.next.unwrap_or(root).value.value
}

fn cycle_relink() -> Int32 {
    let root = graph {
        let a = graph.alloc(Node { value: 0, next: None })
        let b = graph.alloc(Node { value: 42, next: None })
        graph.link(a.next, a)
        graph.link(a.next, b)
        graph.link(b.next, b)
        a
    }
    next(next(root)).value
}

fn cycle_unlinked() -> Int32 {
    let root = graph {
        let orphan = graph.alloc(Node { value: 0, next: None })
        graph.link(orphan.next, orphan)
        let node = graph.alloc(Node { value: 42, next: None })
        node
    }
    if root.next.is_none() { root.value } else { 0 }
}

fn cycle_failure(divisor: Int32) -> Int32 {
    let root = graph {
        let a = graph.alloc(Node { value: 20, next: None })
        graph.link(a.next, a)
        let b = graph.alloc(Node { value: 22 / divisor, next: None })
        graph.link(a.next, b)
        graph.link(b.next, a)
        a
    }
    root.value + next(root).value
}

fn identity<T>(value: T) -> T { value }
fn cycle_hint() -> Int32 {
    identity(graph {
        let a = graph.alloc(Node { value: 42, next: None });
        graph.link(a.next, a); a
    }).value
}
fn cycle_evaluation_order() -> Int32 {
    var count = 0
    let root = graph {
        let a = graph.alloc(Node { value: { count = count + 1; 20 }, next: None })
        let b = graph.alloc(Node { value: { count = count + 1; 20 }, next: None })
        graph.link(a.next, b)
        graph.link(b.next, a)
        a
    }
    root.value + next(root).value + count
}
fn cycle_contextual_name() -> Int32 {
    let graph = true
    if graph { 42 } else { 0 }
}
