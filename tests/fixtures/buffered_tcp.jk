import joky/tcp.{type Address, type TcpListener, type TcpStream, type BufferedTcp, type Shutdown}
import joky/array.{type Array}
import joky/check.{assert}
import joky/integer
import joky/task

fn ensure(ok: Bool) { let message = "bounded TCP buffering"; assert(ok, &message) }
fn send(address: Address) @suspends {
    var stream = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    var bytes = Array.new::<UInt8>()
    var index: UInt64 = 0
    while index < 9 {
        bytes.push((index + 1).to_u8().unwrap_or(0))
        index = index + 1
    }
    ensure(stream.write_all(bytes).is_ok())
    ensure(stream.shutdown(Shutdown.Write).is_ok())
    let reply = match stream.read(1) { Ok(bytes) => bytes, Err(error) => { ensure(false); return } }
    ensure(reply.len() == 1 && reply.get(0).unwrap_or(0) == 42)
    ensure(stream.close().is_ok())
}
fn receive(listener: &mut TcpListener) @suspends {
    let stream = match listener.accept() { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    var buffered = match BufferedTcp.with_capacity(stream, 3) { Ok(buffered) => buffered, Err(error) => { ensure(false); return } }
    ensure(buffered.capacity() == 3 && buffered.buffered_len() == 0 && !buffered.is_eof())
    var expected: UInt64 = 1
    while expected <= 9 {
        let before = buffered.buffered_len()
        match buffered.read(0) { Err(InvalidLimit) => {}, _ => { ensure(false) } }
        match buffered.read(1048577) { Err(InvalidLimit) => {}, _ => { ensure(false) } }
        ensure(before == buffered.buffered_len() && !buffered.is_eof())
        let limit: UInt64 = if (expected & 1) == 0 { 1048576 } else { 1 }
        var bytes = match buffered.read(limit) { Ok(bytes) => bytes, Err(error) => { ensure(false); return } }
        ensure(bytes.len() > 0 && bytes.len() <= 3 && bytes.len() <= limit)
        ensure(buffered.buffered_len() <= 3)
        var index: UInt64 = 0
        while index < bytes.len() {
            ensure(bytes.get(index).unwrap_or(0).to_u64().unwrap_or(0) == expected)
            expected = expected + 1
            index = index + 1
        }
        // Returned arrays can be mutated without changing buffered bytes.
        bytes.set(0, 255);
    }
    ensure(expected == 10)
    let end = match buffered.read(1) { Ok(bytes) => bytes, Err(error) => { ensure(false); return } }
    ensure(end.is_empty() && buffered.is_eof() && buffered.buffered_len() == 0)
    let end_again = match buffered.read(3) { Ok(bytes) => bytes, Err(error) => { ensure(false); return } }
    ensure(end_again.is_empty() && buffered.is_eof())
    match buffered.read(0) { Err(InvalidLimit) => {}, _ => { ensure(false) } }
    ensure(buffered.is_eof())
    var reply = Array.new::<UInt8>()
    reply.push(42)
    ensure(buffered.write_all(reply).is_ok())
    ensure(buffered.close().is_ok())
}
fn invalid(address: Address) @suspends {
    let first = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    match BufferedTcp.with_capacity(first, 0) { Err(InvalidLimit) => {}, _ => { ensure(false) } }
    let second = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    match BufferedTcp.with_capacity(second, 1048577) { Err(InvalidLimit) => {}, _ => { ensure(false) } }
    let third = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    let maximum = match BufferedTcp.with_capacity(third, 1048576) { Ok(buffered) => buffered, Err(error) => { ensure(false); return } }
    ensure(maximum.capacity() == 1048576 && maximum.buffered_len() == 0)
    ensure(maximum.close().is_ok())
    let fourth = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    let defaults = BufferedTcp.new(fourth)
    ensure(defaults.capacity() == 16384 && defaults.buffered_len() == 0)
    ensure(defaults.close().is_ok())
}
fn pending() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return 1 } }
    let address = match listener.local_addr() { Ok(address) => address, Err(error) => { return 2 } }
    let stream = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { return 3 } }
    var peer = match listener.accept() { Ok(stream) => stream, Err(error) => { return 4 } }
    var buffered = BufferedTcp.new(stream)
    var bytes = Array.new::<UInt8>()
    bytes.push(42)
    ensure(peer.write_all(bytes).is_ok())
    let first = match buffered.read(1) { Ok(bytes) => bytes, Err(error) => { return 5 } }
    ensure(first.get(0).unwrap_or(0) == 42 && buffered.buffered_len() == 0)
    buffered.read(1);
    peer.close();
    42
}
fn wait(buffered: &mut BufferedTcp) @suspends { buffered.read(1); }
fn cancel() @suspends {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { ensure(false); return } }
    let address = match listener.local_addr() { Ok(address) => address, Err(error) => { ensure(false); return } }
    let stream = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    var peer = match listener.accept() { Ok(stream) => stream, Err(error) => { ensure(false); return } }
    var buffered = BufferedTcp.new(stream)
    var bytes = Array.new::<UInt8>()
    bytes.push(42)
    ensure(peer.write_all(bytes).is_ok())
    let first = match buffered.read(1) { Ok(bytes) => bytes, Err(error) => { ensure(false); return } }
    ensure(first.get(0).unwrap_or(0) == 42 && buffered.buffered_len() == 0)
    race { | wait(&mut buffered) | task.sleep_ms(1) }
    // Cancellation releases the loan; end this protocol connection explicitly.
    ensure(buffered.buffered_len() <= buffered.capacity())
    ensure(buffered.close().is_ok())
    ensure(peer.close().is_ok())
    ensure(listener.close().is_ok())
}
fn main() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return 1 } }
    let address = match listener.local_addr() { Ok(address) => address, Err(error) => { return 2 } }
    join { | receive(&mut listener) | send(address) }
    invalid(address)
    ensure(listener.close().is_ok())
    cancel()
    0
}
