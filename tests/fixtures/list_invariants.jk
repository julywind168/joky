fn same_slot(left: Option<UInt64>, right: Option<UInt64>) -> Bool {
    match left { | None => right.is_none() | Some(value) => match right { | None => false | Some(other) => value == other } }
}
// Test-only observations compiled in the production List definition scope.
pub fn test_invariant<T>(list: &List<T>) -> Bool {
    let length = len(list)
    let count = list.slots.len()
    if list.owners.len() != length || length > count { return false }
    var used: UInt64 = 0
    var slot: UInt64 = 0
    while slot < count {
        match list.slots.get(slot) {
            | Some(NodeSlot.Used(node)) => {
                if node.value_index >= length { return false }
                if list.owners.get(node.value_index).unwrap_or(count) != slot { return false }
                used = used + 1
            }
            | Some(NodeSlot.Free(_)) => {}
            | None => return false
        }
        slot = slot + 1
    }
    if used != length { return false }
    var current = list.head
    var previous: Option<UInt64> = None
    var visited: UInt64 = 0
    while current.is_some() {
        if visited >= length { return false }
        let slot = required_slot(current)
        match list.slots.get(slot) {
            | Some(NodeSlot.Used(node)) => {
                if !same_slot(node.prev, previous) { return false }
                previous = current current = node.next
            }
            | _ => return false
        }
        visited = visited + 1
    }
    if visited != length || !same_slot(previous, list.tail) { return false }
    current = list.tail previous = None visited = 0
    while current.is_some() {
        if visited >= length { return false }
        let slot = required_slot(current)
        match list.slots.get(slot) {
            | Some(NodeSlot.Used(node)) => {
                if !same_slot(node.next, previous) { return false }
                previous = current current = node.prev
            }
            | _ => return false
        }
        visited = visited + 1
    }
    if visited != length || !same_slot(previous, list.head) { return false }
    current = list.free visited = 0
    while current.is_some() {
        if visited >= count - length { return false }
        match list.slots.get(required_slot(current)) {
            | Some(NodeSlot.Free(next)) => { current = next }
            | _ => return false
        }
        visited = visited + 1
    }
    visited == count - length
}
pub fn test_slot_count<T>(list: &List<T>) -> UInt64 { list.slots.len() }
