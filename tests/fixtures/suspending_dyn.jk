import joky/drop.{type Drop}
import joky/fixed_array.{type FixedArray}
extern fn record(value: Int32) -> Int32
extern fn delayed_value(value: Int32) @suspends -> Int32
extern fn fail_now() @suspends

struct Resource { id: Int32, text: String }
impl Drop for Resource { fn drop(&mut self) { record(self.id); } }
fn resource(id: Int32) -> Resource {
    let value = Resource { id, text: "owned" }
    record(-id)
    value
}
trait Store {
    type Item
    fn fetch(&self, value: Self.Item) @suspends @noescape -> Self.Item { delayed_value(40); value }
    fn array(&self, value: FixedArray<String, 2>) @suspends @noescape -> FixedArray<String, 2> {
        delayed_value(40)
        value
    }
    fn nested(&self) @suspends @noescape -> Int32 {
        let child = resource(2)
        delayed_value(40) + child.id - 1
    }
    fn read(&self, value: Int32) @suspends @noescape -> Int32
    fn change(&mut self, value: Int32) @suspends @noescape
    fn current(&self) @noescape -> Int32
    fn current_async(&self) @suspends @noescape -> Int32 { self.current() }
    fn echo(&self, value: Resource) @suspends @noescape -> (Resource, Int32) {
        let n = delayed_value(40)
        (value, n)
    }
    fn fail(&self) @suspends @noescape {
        let child = resource(2)
        delayed_value(40)
        fail_now()
    }
}
struct Memory<T: Copy> { n: Int32, tag: T }
impl<T: Copy> Store for Memory<T> {
    type Item = String
    fn read(&self, value: Int32) @suspends @noescape -> Int32 { delayed_value(value) + self.n }
    fn change(&mut self, value: Int32) @suspends @noescape { self.n = delayed_value(value) }
    fn current(&self) @noescape -> Int32 { self.n }
}
struct Remote<T> { n: Int32, resource: T }
impl<T> Store for Remote<T> {
    type Item = String
    fn read(&self, value: Int32) @suspends @noescape -> Int32 { delayed_value(value) + self.n }
    fn change(&mut self, value: Int32) @suspends @noescape { self.n = delayed_value(value) }
    fn current(&self) @noescape -> Int32 { self.n }
}
fn open(remote: Bool) -> dyn Store<Item = String> {
    if remote { Remote { n: 1, resource: resource(1) } } else { Memory { n: 1, tag: true } }
}
fn run(remote: Bool) @suspends -> Int32 {
    var store = open(remote)
    let a = store.read(record(19))
    store.change(20)
    let b = store.read(0)
    let c = store.current()
    a + b - store.current_async() + c - c + 20
}
fn dyn_remote() @suspends -> Int32 { run(true) }
fn dyn_memory() @suspends -> Int32 { run(false) }
fn dyn_result() @suspends -> Int32 {
    let store = open(true)
    let (value, n) = store.echo(resource(2))
    n + value.id - 1
}
fn dyn_failure() @suspends -> Int32 {
    let store = open(true)
    store.fail()
    42
}
fn immediate() @suspends -> Int32 { 42 }
fn dyn_race() @suspends -> Int32 {
    let store = open(true)
    race { { store.read(40) }, immediate() }
}

fn dyn_nested() @suspends -> Int32 { let store = open(true); store.nested() }
fn dyn_text() @suspends -> Int32 {
    let store = open(true)
    let value = Store.fetch(store, "ok")
    int32(value.byte_length()) + 40
}
fn dyn_place() @suspends -> Int32 {
    let store = open(true)
    let input: FixedArray<String, 2> = ["ok", "owned"]
    let output = store.array(input)
    int32(output.borrow_ref(0).byte_length()) + 40
}

fn dyn_argument() @suspends -> Int32 {
    let store = open(true)
    store.read(delayed_value(39))
}
