enum Option<T> { None, Some(T) }
enum Result<T, E> { Ok(T), Err(E) }
enum Wrapper<T> { Wrapped(Option<(T, Bool)>), Empty }
enum Phantom<T> { Value }
struct Empty {}
struct Pair { low: Int32, high: UInt64 }
struct Holder { value: Option<Pair> }
type Wide = UInt64
type MaybeWide = Option<Wide>
fn id<T>(value: T) -> T { value }
fn some<T>(value: T) -> Option<T> { Option.Some(value) }
fn none<T>() -> Option<T> { Option.None }
fn unwrap_or<T>(value: Option<T>, fallback: T) -> T { match value { None => fallback, Some(value) => value } }
fn choose<T>(a: T, b: T) -> T { a }
fn ok<T, E>(value: T) -> Result<T, E> { Result.Ok(value) }
fn convert<T>(value: Option<T>) -> Result<T, Bool> { match value { Some(n) => Result.Ok(n), None => Result.Err(false) } }
fn duplicate<T: Copy>(value: Option<T>) -> (Option<T>, Option<T>) { (value, value) }
fn replace<T>(a: Option<T>, b: Option<T>) -> Option<T> { var value = a; let saved = value; value = b; saved }
fn recurse<T>(value: Option<T>, n: Int32) -> Option<T> { if n == 0 { value } else { recurse(value, n - 1) } }
fn wide() -> Wide { unwrap_or::<Wide>(Option.Some(0xffff_ffff_ffff_ffff), 0) }
fn check() -> Int32 {
    let a = Option.Some(42)
    let absent: Option<Int32>=Option.None
    let nested: Option<Option<Int32>>=Option.Some(Option.Some(7))
    let high: Wide = 0xffff_ffff_ffff_ffff
    let b: MaybeWide = Option.Some(high)
    let c = Option.Some::<Int64>(4294967295)
    let d = Result.Err::<Int32, Bool>(false)
    let pair = Pair { low: -1, high: high }
    var holder = Holder { value: some(pair) }
    let saved = choose(holder.value, { holder.value = Option.None; holder.value })
    let prior = replace(saved, none::<Pair>())
    let (left, right) = duplicate(prior)
    let p = unwrap_or(recurse(left, 5), pair)
    let unit: Option<Unit> = Option.Some({})
    let empty = Option.Some(Empty {})
    let ph = Phantom.Value::<(Unit, Empty)>
    let wrapped: Wrapper<Pair> = Wrapper.Wrapped(Option.Some((p, true)))
    let w = match wrapped { Empty => 0, Wrapped(inner) => { let (q, valid) = unwrap_or(inner, (pair, false)); if valid { q.low } else { 0 } } }
    let r = convert(id(a))
    let answer = match r { Ok(n) => n, Err(error) => 0 }
    let other: Result<Int32, Bool> = ok::<Int32, Bool>(9)
    let good = match other { Ok(n) => n == 9, Err(error) => false }
    let e = if true { Option.None } else { Option.Some(high) }
    let branch_task: Option<Int32> = match d { Ok(n) => Option.Some(n), Err(error) => Option.None }
    let z = match unit { None => false, Some(x) => true }
    let v = match empty { None => false, Some(x) => true }
    let t = match ph { Value => true }
    if answer == 42 && unwrap_or(absent, 6) == 6 &&
        unwrap_or(unwrap_or(nested, Option.None), 0) == 7 &&
        unwrap_or(b, 0) == high && unwrap_or(c, 0) == 4294967295 &&
        p.high == high && w == -1 && good && z && v && t &&
        unwrap_or(e, high) == high && unwrap_or(branch_task, 8) == 8 { 42 } else { -1 }
}
