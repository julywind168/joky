import joky/domain
import joky/task
import joky/check
import joky/option.{type Option}
struct Room {value:Int32,text:String}
struct Input<T> {value:T}
struct Empty<T> {}
fn make(value:Int32)->Room {Room{value:value,text:"periodic state"}}
fn read(room:&Room)->Int32 {room.value}
fn assert(ok:Bool) {check.assert(ok,"declared periodic operation")}
fn capture(count:&mut Int32)->Input<Option<(Int32,Bool)>> {
    *count+=1
    Input{value:Option.Some((2,true))}
}
#every(10)
fn tick(room:&mut Room,input:Input<Option<(Int32,Bool)>>) {
    match input.value {Some((amount,true))=>{room.value+=amount},_=>{}}
}
#every(100000)
fn idle(room:&mut Room) {room.value+=1}
#every(100000)
fn empty(room:&mut Room,p:(Empty<Bool>,Unit)) {room.value+=1}
#every(1)
fn quick(room:&mut Room) {room.value+=1}
fn live() @suspends {
    let room=domain.create(make,0) let timer=domain.timer() let t=timer.handle()
    domain.schedule(t,room.handle(),quick).unwrap()
    while domain.read_from(room.read_handle(),read).unwrap()<1 {task.yield_now()}
    t.cancel()
    assert(match t.status(){Cancelled=>true,_=>false})
}
fn live_input() @suspends {
    let room=domain.create(make,0) let timer=domain.timer() let t=timer.handle()
    domain.schedule_with(t,room.handle(),tick,Input{value:Option.Some((2,true))}).unwrap()
    while domain.read_from(room.read_handle(),read).unwrap()<2 {task.yield_now()}
    t.cancel()
}
fn lifecycle() @suspends {
    let room=domain.create(make,10) let owner=domain.timer() let t=owner.handle()
    assert(domain.read_from(room.read_handle(),read).unwrap()==10)
    assert(domain.schedule(t,room.handle(),idle).is_ok())
    assert(match domain.schedule(t,room.handle(),idle){Err(Busy)=>true,_=>false})
    t.cancel()
    assert(match t.status(){Cancelled=>true,_=>false})
    assert(domain.schedule_with(t,room.handle(),empty,(Empty{},{})).is_ok())
    t.cancel()
    var captures=0
    assert(domain.schedule_with(t,room.handle(),tick,capture(&mut captures)).is_ok())
    assert(captures==1)
    t.cancel()
    assert(domain.schedule_with(t,room.handle(),tick,Input{value:Option.None}).is_ok())
    room.close()
    assert(match t.status(){Closed=>true,_=>false})
    owner.close()
    let other=domain.create(make,1)
    let dangling={let o=domain.timer() let h=o.handle() domain.schedule(h,other.handle(),idle).unwrap() h}
    assert(match dangling.status(){Closed=>true,_=>false})
    assert(match domain.schedule(dangling,other.handle(),idle){Err(Closed)=>true,_=>false})
    assert(domain.read_from(other.read_handle(),read).unwrap()==1)
}
fn main() @suspends {lifecycle()}
