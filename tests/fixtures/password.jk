import joky/password.{ type PasswordError }
import joky/result.{ type Result, Ok, Err }
import joky/check.{ assert }
import joky/array.{ type Array }
import joky/task

// Published Argon2 reference vectors, also used by RustCrypto tests/kat.rs.
// https://github.com/P-H-C/phc-winner-argon2/blob/master/src/test.c
fn legacy() -> String { "$argon2id$v=19$m=256,t=2,p=1$c29tZXNhbHQ$nf65EOgLrQMR/uIPnA4rEsF5h7TKyQwu9U1bMCHGi/4" }
fn legacy_parallel() -> String { "$argon2id$v=19$m=256,t=2,p=2$c29tZXNhbHQ$bQk8UB/VmZZF4Oo79iDXuL5/0ttZwg2f/5U52iv1cDc" }
fn password_vectors() @suspends -> Int32 {
    assert(password.verify("password", legacy()).unwrap(), "reference password vector")
    assert(password.verify("password", legacy_parallel()).unwrap(), "reference multiple-lane vector")
    assert(!password.verify("sassword", legacy()).unwrap(), "incorrect password is false")
    assert(!password.verify("", legacy()).unwrap(), "empty password mismatch")
    let old = legacy()
    assert(password.needs_rehash(&old).unwrap(), "legacy parameters need upgrade")
    42
}
fn password_roundtrip() @suspends -> Int32 {
    let first = password.hash("密码\u{0} phrase").unwrap()
    let second = password.hash("密码\u{0} phrase").unwrap()
    assert(first != second, "fresh salt for each hash")
    assert(!password.needs_rehash(&first).unwrap(), "current policy")
    task.yield_now()
    assert(password.verify("密码\u{0} phrase", first.clone()).unwrap(), "Unicode and embedded NUL")
    assert(!password.verify("密码", first).unwrap(), "password is not truncated at NUL")
    let empty = password.hash("").unwrap()
    assert(password.verify("", empty).unwrap(), "empty password bytes allowed")
    42
}
fn invalid(result: Result<Bool, PasswordError>) {
    match result { Err(InvalidHash) => {}, _ => assert(false, "invalid PHC is an error") }
}
fn password_invalid() @suspends -> Int32 {
    let malformed = "not a PHC hash"
    invalid(password.needs_rehash(&malformed))
    invalid(password.verify("password", malformed))
    let unsupported = "$argon2i$v=19$m=256,t=2,p=1$c29tZXNhbHQ$nf65EOgLrQMR/uIPnA4rEsF5h7TKyQwu9U1bMCHGi/4"
    match password.verify("password", unsupported) { Err(UnsupportedAlgorithm) => {}, _ => assert(false, "unsupported algorithm") }
    let huge = "$argon2id$v=19$m=4294967295,t=2,p=1$c29tZXNhbHQ$nf65EOgLrQMR/uIPnA4rEsF5h7TKyQwu9U1bMCHGi/4"
    match password.verify("password", huge) { Err(ParametersOutOfRange) => {}, _ => assert(false, "bounded verification cost") }
    var bytes = Array.with_capacity::<UInt8>(1025)
    for i in 0 .. 1024 { bytes.push(97) }
    let exact = String.from_utf8(array.clone(&bytes)).unwrap()
    let encoded = password.hash(exact.clone()).unwrap()
    assert(password.verify(exact, encoded).unwrap(), "exact password byte limit")
    bytes.push(97)
    let long = String.from_utf8(bytes).unwrap()
    match password.hash(long) { Err(PasswordTooLong) => {}, _ => assert(false, "password byte limit") }
    42
}
fn password_metadata_repeated() -> Int32 {
    let old = legacy()
    for i in 0 .. 128 { assert(password.needs_rehash(&old).unwrap(), "bounded metadata inspection") }
    42
}
fn password_once() @suspends -> Int32 {
    assert(password.verify("password", legacy()).unwrap(), "bounded worker request")
    42
}
fn password_failed() @suspends -> Int32 {
    password.hash("discarded output").unwrap();
    assert(false, "failure after password completion")
    42
}
fn password_parallel() @suspends -> Int32 {
    let (left, right) = join { | password_once() | password_once() }
    assert(left == 42 && right == 42, "parallel password jobs")
    42
}
fn password_suite() @suspends -> Int32 {
    assert(password_vectors() == 42, "vectors")
    assert(password_roundtrip() == 42, "roundtrip")
    assert(password_invalid() == 42, "errors")
    assert(password_metadata_repeated() == 42, "metadata")
    password_parallel()
}
