import joky/mem
import joky/map as maps.{type Map}
import joky/array.{type Array}
import joky/element as element.{type Element}
import joky/eq.{type Eq}
import joky/hash.{type Hash}
import joky/check.{require}
import joky/drop.{type Drop}
extern fn record_int(value: Int32)

fn view<K: Eq + Hash, V>(m: &Map<K, V>, key: K) -> &Element<V> { maps.borrow(m, key) }
fn view_mut<K: Eq + Hash, V>(m: &mut Map<K, V>, key: K) -> &mut Element<V> { maps.borrow_mut(m, key) }
fn owner_view<K: Eq + Hash, V>(m: &Map<K, V>, key: K) -> &V { maps.borrow_ref(m, key) }
fn owner_view_mut<K: Eq + Hash, V>(m: &mut Map<K, V>, key: K) -> &mut V { maps.borrow_mut_ref(m, key) }

fn copy_views<Tag>() -> Int32 {
    var m = Map.new::<Int32, Int32>()
    m.insert(1, 20) m.insert(2, 22)
    let first = view(&m, 1)
    let second = m.borrow(2)
    { let assertion_condition = element.read(first) + element.read(second) == 42 && m.len() == 2 && m.contains_key(1) let assertion_message = "Shared views" require(assertion_condition, &assertion_message) }
    let write = view_mut(&mut m, 1)
    element.write(write, 40)
    { let assertion_condition = element.read(write) == 40 let assertion_message = "Exclusive view" require(assertion_condition, &assertion_message) }
    m.insert(3, 2) m.remove(2) m.reserve(20)
    let result = element.read(m.borrow(1)) + element.read(m.borrow(3))
    m.clear() m.release()
    result
}
struct Resource { id: Int32, values: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { record_int(self.id) } }
fn resource(id: Int32, n: Int32) -> Resource {
    var values = Array.new::<Int32>() values.push(n)
    let value = Resource { id: id, values: values }
    record_int(-id)
    value
}
fn owned_views<Tag>() -> Int32 {
    var m = Map.new::<Int32, Resource>()
    m.insert(1, resource(1, 20))
    let read = owner_view(&m, 1)
    { let assertion_condition = read.id == 1 && read.values.get(0).unwrap_or(0) == 20 let assertion_message = "Owned read" require(assertion_condition, &assertion_message) }
    let write = owner_view_mut(&mut m, 1)
    write.values.push(22)
    let old = mem.replace(write, resource(2, 42))
    { let assertion_condition = old.values.get(0).unwrap_or(0) + old.values.get(1).unwrap_or(0) == 42 let assertion_message = "Replaced owner" require(assertion_condition, &assertion_message) }
    let current = m.borrow_ref(1)
    let result = current.values.get(0).unwrap_or(0)
    m.reserve(20) m.clear() m.release()
    result
}
fn nested_views<Tag>() -> Int32 {
    var inner = Map.new::<Int32, Int32>() inner.insert(1, 20)
    var outer = Map.new::<Int32, Map<Int32, Int32>>() outer.insert(2, inner)
    let write = outer.borrow_mut_ref(2)
    write.insert(1, 42)
    let read = outer.borrow_ref(2)
    read.get(1).unwrap_or(0)
}
fn reference_values<Tag>() -> Int32 {
    var m = Map.new::<Int32, &Int32>()
    m.insert(1, (&*(alloc(20))))
    let old = m.insert(1, (&*(alloc(22))))
    let copied = m.get(1)
    let removed = m.remove(1)
    m.release()
    match old {
        | Some(a) => match copied {
            | Some(b) => match removed { | Some(c) => if (*b) == (*c) { (*a) + (*b) } else { 0 } | None => 0 }
            | None => 0
        }
        | None => 0
    }
}
struct Shared { first: &Int32, second: &Int32 }
fn shared_aggregate<Tag>() -> Int32 {
    var m = Map.new::<Int32, Shared>()
    m.insert(1, Shared { first: (&*(alloc(1))), second: (&*(alloc(2))) })
    let write = m.borrow_mut(1)
    element.write(write, Shared { first: (&*(alloc(20))), second: (&*(alloc(22))) })
    let copy = element.read(write)
    let moved = m
    moved.release();
    (*copy.first) + (*copy.second)
}
fn copied_reference<Tag>() -> Int32 {
    var m = Map.new::<Int32, &Int32>() m.insert(1, (&*(alloc(42))))
    let copy = element.read(m.borrow(1))
    m.release();
    (*copy)
}
fn reference_map() -> Map<Int32, &Int32> {
    var m = Map.new::<Int32, &Int32>() m.insert(1, (&*(alloc(42)))) m
}
fn forward(m: Map<Int32, &Int32>) -> Map<Int32, &Int32> { m }
fn returned_reference<Tag>() -> Int32 {
    let m = forward(reference_map())
    let copied = m.get(1)
    m.release()
    match copied { | Some(value) => (*value) | None => 0 }
}
fn aggregate_references<Tag>() -> Int32 {
    var m = Map.new::<Int32, Option<(&Int32, &Int32)>>()
    m.insert(1, Some(((&*(alloc(20))), (&*(alloc(22))))))
    let old = m.insert(1, None)
    m.release()
    match old { | Some(value) => match value { | Some((a, b)) => (*a) + (*b) | None => 0 } | None => 0 }
}
fn missing_copy<Tag>() -> Int32 {
    var m = Map.new::<Int32, Int32>() m.insert(1, 42)
    element.read(m.borrow(2))
}
fn missing_mut<Tag>() -> Int32 {
    var m = Map.new::<Int32, Int32>() m.insert(1, 42)
    element.write(m.borrow_mut(2), 0)
    0
}
fn missing_owner<Tag>() -> Int32 {
    var m = Map.new::<Int32, Resource>() m.insert(1, resource(1, 42))
    m.borrow_ref(2).id
}
fn missing_owner_mut<Tag>() -> Int32 {
    var m = Map.new::<Int32, Resource>() m.insert(1, resource(1, 42))
    let value = m.borrow_mut_ref(2)
    value.values.push(0)
    0
}
fn task() @suspends -> Int32 { owned_views::<Unit>() }
fn main() { record_int(copy_views::<Unit>()) }
