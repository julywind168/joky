import joky/domain
import joky/check
import joky/task
import joky/mem
import joky/option.{type Option}
import joky/result.{type Result}
#state
struct State { text:String, ticks:Int32 }
struct Input { text:String, optional:Option<String> }
enum Failure { Missing, Rejected(String) }
fn assert(ok:Bool) {check.assert(ok,"domain text values")}
fn make(text:String)->State {State{text:text,ticks:0}}
fn read(s:&State)->String {s.text.clone()}
fn edit(s:&mut State,text:String) {mem.replace(&mut s.text,text);}
fn update(s:&mut State,p:Input)->Result<String,Failure> {
    let Input{text,optional}=p
    match optional {
        Some(reason)=>Result.Err(Failure.Rejected(reason)),
        None=>Result.Ok(mem.replace(&mut s.text,text))
    }
}
fn tick(s:&mut State,text:String) {s.ticks+=1; edit(s,text)}
fn count(s:&State)->Int32 {s.ticks}
fn pair(a:&State,b:&State)->(String,String) {(a.text.clone(),b.text.clone())}
fn request(p:Input) @suspends ->Result<String,Failure> {
    task.yield_now()
    domain.write(update,p).unwrap()
}
fn echo(text:String) @suspends ->String {task.yield_now(); text}
fn slow(text:String) @suspends ->String {task.sleep_ms(10000); text}
fn pending(h:domain.WriteHandle<State>) @suspends {domain.request(h,slow,"cancel me");}
fn ready() @suspends {task.yield_now()}
impl State {
    fn value(&self)->String {read(self)}
    fn replace(&mut self,text:String)->String {mem.replace(&mut self.text,text)}
}
fn verify_values(x:domain.WriteHandle<State>,y:domain.WriteHandle<State>) @suspends {
    assert(x.value().unwrap().equals("初始🙂"))
    let input="跨域\0文本🙂"
    assert(x.replace(input.clone()).unwrap().equals("初始🙂"))
    assert(input.equals("跨域\0文本🙂"))
    let large="大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂大🙂"
    assert(x.replace(large.clone()).unwrap().equals(input))
    assert(x.replace(input.clone()).unwrap().equals(large))
    let captured="captured"
    let extra="extra"
    var captured_count=0
    let result=when "owned capture" (mut x,mut y) {
        captured_count+=1
        assert(captured_count==1 && extra.equals("extra"))
        edit(y,captured)
        (x.text.clone(),y.text.clone())
    }.unwrap()
    let (first,second)=result
    assert(first.equals(input) && second.equals("captured"))
    let absent:Option<String>=Option.None
    assert(when(x){absent}.unwrap().is_none())
    match domain.write_to(x,update,Input{text:"unused",optional:Option.Some("business error")}).unwrap() {
        Err(Rejected(reason))=>assert(reason.equals("business error")),_=>assert(false)
    }
    let p=Input{text:"async",optional:Option.None}
    assert(domain.request(x,request,p).unwrap().unwrap().equals(input))
    assert(domain.request(x,echo,"request result🙂").unwrap().equals("request result🙂"))
}
fn verify_snapshots(x:domain.WriteHandle<State>,y:domain.WriteHandle<State>) @suspends {
    let saved=domain.snapshot_from(x.read_only(),read)
    let one=saved.value(); let two=saved.value()
    assert(one.equals("async") && two.equals("async"))
    let candidate=domain.candidate_from(saved,x,make,"candidate")
    var receipt=domain.commit_to(x,candidate)
    assert(receipt.wait().is_ok())
    let both=domain.snapshot_pair(x.read_only(),y.read_only(),pair)
    let (left,right)=both.value()
    assert(left.equals("candidate") && right.equals("captured"))
    var set=domain.access_set(); set.include(x.read_only()); set.include(y.read_only())
    let snap=domain.snapshot_set(set)
    assert(domain.read_snapshot(&snap,x.read_only(),read).equals("candidate"))
    let candidate=domain.edit_snapshot(snap,x,edit,"edited")
    let candidate=domain.edit_candidate(candidate,y,edit,"")
    var receipt=domain.commit_set(candidate); assert(receipt.wait().is_ok())
    assert(x.value().unwrap().equals("edited") && y.value().unwrap().equals(""))
}
fn verify_timer(x:domain.WriteHandle<State>) @suspends {
    let timer=domain.timer(); let t=timer.handle()
    domain.every(t,x,1,tick,"repeated🙂").unwrap()
    while domain.read_from(x.read_only(),count).unwrap()<3 {task.sleep_ms(1)}
    t.cancel(); timer.close()
    assert(x.value().unwrap().equals("repeated🙂"))
}
fn lifecycle() @suspends ->Int32 {
    let a=domain.create(make,"初始🙂"); let b=domain.create(make,"")
    let x=a.handle(); let y=b.handle()
    verify_values(x,y); verify_snapshots(x,y); verify_timer(x)
    race {|pending(x)|ready()};
    a.close()
    match x.replace("closed input") {Err(Closed)=>{},_=>assert(false)}
    b.close()
    24
}
fn main() @suspends {assert(lifecycle()==24)}
