import joky/array as array.{type Array}
import joky/option.{type Option, Some, None}

struct RefPair<T> { flag: Bool first: &T second: &T }
struct RefNode<T> { value: T next: Option<&RefNode<T>> }
enum RefEvent { Empty Value((Bool, &Int32, Int64)) }

fn refs_forward<T>(values: Array<T>) -> Array<T> { values }
fn refs_view<T>(values: &Array<T>) -> &Array<T> { values }
fn refs_first<T>(values: &Array<T>) -> Option<T> { array.get(values, 0) }
fn refs_make<T>(value: T) -> Array<T> {
    var values = array.new::<T>()
    array.push(&mut values, value)
    refs_forward(values)
}
fn refs_copy<T>(destination: &mut Array<T>, source: &Array<T>) {
    var index: UInt64 = 0
    while index < array.len(source) {
        match array.get(source, index) {
            | None => {}
            | Some(value) => array.push(destination, value)
        }
        index = index + 1
    }
}
fn refs_clone<T>(source: &Array<T>) -> Array<T> {
    var result = array.new::<T>()
    refs_copy(&mut result, source)
    result
}
fn refs_set<T>(values: &mut Array<T>, value: T) -> Bool { array.set(values, 0, value) }

fn reference_array_growth() -> Int32 {
    let first = share(alloc(20))
    let second = share(alloc(22))
    var values = refs_make(first)
    let copied = refs_first(refs_view(&values))
    var i = 0
    while i < 40 { array.push(&mut values, second) i = i + 1 }
    if !refs_set(&mut values, second) { return 0 }
    let popped = array.pop(&mut values)
    array.reserve(&mut values, 128)
    let moved = refs_forward(values)
    let clones = refs_clone(&moved)
    if array.len(&clones) != 40 { return 0 }
    match copied {
        | None => 0
        | Some(a) => match popped { | None => 0 | Some(b) => memory.read(a) + memory.read(b) }
    }
}

fn reference_array_owner_end() -> Int32 {
    let copied = {
        var values = refs_make(share(alloc(42)))
        let result = array.get(&values, 0)
        array.pop(&mut values);
        values = array.new::<&Int32>()
        result
    }
    match copied { | None => 0 | Some(value) => memory.read(value) }
}

fn reference_array_records() -> Int32 {
    let a = share(alloc(20))
    let b = share(alloc(22))
    let pair = RefPair { flag: true, first: a, second: b }
    var values = refs_make(pair)
    var i = 0
    while i < 12 { array.push(&mut values, pair) i = i + 1 }
    let result = array.pop(&mut values)
    array.set(&mut values, 0, RefPair { flag: false, first: b, second: a });
    match result {
        | None => 0
        | Some(p) => if p.flag { memory.read(p.first) + memory.read(p.second) } else { 0 }
    }
}

fn reference_array_tuples() -> Int32 {
    let p = share(alloc(42))
    var values = refs_make::<(Unit, Bool, &Int32, Int64)>(({}, true, p, 4294967297))
    array.reserve(&mut values, 16)
    let result = array.pop(&mut values)
    match result {
        | None => 0
        | Some(payload) => {
            let (_, flag, value, wide) = payload
            if flag && wide == 4294967297 { memory.read(value) } else { 0 }
        }
    }
}

fn reference_array_enums() -> Int32 {
    let p = share(alloc(42))
    var values = refs_make(RefEvent.Empty)
    array.push(&mut values, RefEvent.Value((true, p, 4294967297)))
    array.reserve(&mut values, 16)
    let copied = array.get(&values, 1)
    array.set(&mut values, 1, RefEvent.Empty);
    array.pop(&mut values);
    match copied {
        | None => 0
        | Some(event) => match event {
            | Empty => 0
            | Value(payload) => {
                let (flag, value, wide) = payload
                if flag && wide == 4294967297 { memory.read(value) } else { 0 }
            }
        }
    }
}

fn reference_array_graphs() -> Int32 {
    let root = graph {
        let a = graph.alloc(RefNode { value: 20, next: None })
        let b = graph.alloc(RefNode { value: 22, next: None })
        graph.link(a.next, b)
        graph.link(b.next, a)
        a
    }
    var values = refs_make(root)
    array.reserve(&mut values, 32)
    let copied = array.pop(&mut values)
    array.push(&mut values, root)
    match copied {
        | None => 0
        | Some(node) => match node.next { | None => 0 | Some(next) => node.value + next.value }
    }
}

fn refs_read_numeric(values: &mut Array<Int32>, local: &Int32) -> Int32 {
    array.set(values, 0, memory.read(local));
    memory.read(local)
}
fn reference_array_numeric_contract() -> Int32 {
    var numbers = array.with_capacity::<Int32>(1)
    let local = 42
    refs_read_numeric(&mut numbers, &local)
}


fn refs_return() -> &Int32 {
    let values = refs_make(share(alloc(42)))
    match refs_first(&values) { | None => share(alloc(0)) | Some(p) => p }
}
fn reference_array_returned() -> Int32 { memory.read(refs_return()) }
