import joky/pgsql
import joky/socket/tcp
import joky/socket/tls
import joky/crypto/random
import joky/env
import joky/file

fn main() -> Result(Unit, String) effects { tcp, tls, random, env, file } {
    let port = env.get("JOKY_PG_PORT")?!.parse(UInt16)?
    let ca = file.read_bytes(env.get("JOKY_PG_CA")?!)?
    let config = pgsql.PgConfig(port: port, user: "scram_tls", database: "postgres", ssl: pgsql.SslMode.VerifyFull(ca), channel_binding: pgsql.ChannelBinding.Require)
    var connection = pgsql.connect(config, b"correct password")?
    match pgsql.connect_trust(config) {
        Ok(connection) => { connection.close(); panic("trust accepted required binding") }
        Err(message) => if message != "pgsql: channel binding requires SCRAM authentication" { panic(message) }
    }
    let secure = connection.query("SELECT ssl, version FROM pg_stat_ssl WHERE pid = pg_backend_pid()")?
    let row = secure.result?.head()!.rows.head()!
    if row.text(0)?! != "t" { panic("connection was not encrypted") }
    if !row.text(1)?!.starts_with("TLSv1.") { panic("TLS version") }
    connection = secure.connection
    let unicode = connection.query("SELECT 42, '中文', repeat('x', 100000)")?
    let row = unicode.result?.head()!.rows.head()!
    if (row.text(0)?! != "42") || (row.text(1)?! != "中文") || (row.text(2)?!.length() != 100000u64) { panic("TLS query") }
    connection = unicode.connection
    let failure = connection.query("SELECT 1/0")?
    if failure.result.is_ok() { panic("SQL error") }
    let recovered = failure.connection.query("SELECT 1")?
    let _ = recovered.result?
    recovered.connection.close()
    let disabled = pgsql.PgConfig(port: port, user: "scram_tls", database: "postgres", ssl: pgsql.SslMode.VerifyFull(ca), channel_binding: pgsql.ChannelBinding.Disable)
    let disabled_connection = pgsql.connect(disabled, b"correct password")?
    disabled_connection.close()
    match pgsql.connect(config, b"wrong password") {
        Ok(connection) => { connection.close(); panic("wrong password accepted") }
        Err(message) => if !message.contains("28P01") { panic(message) }
    }
    let untrusted = pgsql.PgConfig(port: port, user: "scram_tls", database: "postgres", ssl: pgsql.SslMode.VerifyFull(Bytes()))
    match pgsql.connect(untrusted, b"correct password") {
        Ok(connection) => { connection.close(); panic("untrusted server accepted") }
        Err(message) => if !message.contains("UnknownIssuer") { panic(message) }
    }
    let trust = pgsql.connect_trust(pgsql.PgConfig(port: port, user: "postgres", database: "postgres", ssl: pgsql.SslMode.VerifyFull(ca)))?
    trust.close()
    println("pgsql TLS live ok")
    Ok(())
}
