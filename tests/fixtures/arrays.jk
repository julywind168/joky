import joky/array as array.{type Array}

fn array_empty() -> Int32 {
    var a = array.new()
    if !array.is_empty(&a) || array.len(&a) != 0 || array.capacity(&a) != 0 { return 0 }
    if !array.get(&a, 0).is_none() || !array.pop(&mut a).is_none() { return 0 }
    if array.set(&mut a, 0, 9) { return 0 }
    array.reserve(&mut a, 0)
    if array.capacity(&a) != 0 { return 0 }
    array.push(&mut a, -42)
    if array.capacity(&a) != 4 || array.len(&a) != 1 { return 0 }
    if array.pop(&mut a).unwrap_or(0) != -42 { return 0 }
    if array.capacity(&a) != 4 || !array.is_empty(&a) { return 0 }
    array.push(&mut a, 42)
    array.get(&a, 0).unwrap_or(0)
}

fn array_growth() -> Int32 {
    var a = array.with_capacity(0)
    var index: Int32 = 0
    while index < 65 {
        array.push(&mut a, index - 32)
        index = index + 1
    }
    if array.len(&a) != 65 || array.capacity(&a) != 128 { return 0 }
    array.reserve(&mut a, 100)
    if array.len(&a) != 65 || array.capacity(&a) < 165 { return 0 }
    while index > 0 {
        index = index - 1
        if array.pop(&mut a).unwrap_or(1000) != index - 32 { return 0 }
    }
    if !array.pop(&mut a).is_none() { return 0 }
    42
}

fn array_access() -> Int32 {
    var a = array.with_capacity(3)
    if array.len(&a) != 0 || array.capacity(&a) != 3 { return 0 }
    if !array.get(&a, 2).is_none() { return 0 }
    array.push(&mut a, 20)
    array.push(&mut a, 30)
    if !array.set(&mut a, 1, 22) { return 0 }
    if array.set(&mut a, 2, 99) || array.set(&mut a, 18446744073709551615, 99) { return 0 }
    if !array.get(&a, 2).is_none() || !array.get(&a, 18446744073709551615).is_none() { return 0 }
    let first = array.get(&a, 0)
    let last = array.pop(&mut a)
    first.unwrap_or(0) + last.unwrap_or(0)
}

fn array_make(value: Int32) -> Array<Int32> {
    var result = array.new()
    array.push(&mut result, value)
    result
}

fn array_identity(value: Array<Int32>) -> Array<Int32> { value }

fn array_read(values: &Array<Int32>) -> &Array<Int32> { values }

fn array_change(values: &mut Array<Int32>) {
    array.push(values, 22)
    array.reserve(values, 4)
}

fn array_moves() -> Int32 {
    var a = array_identity(array_make(20))
    let view = array_read(&a)
    let other = view
    if array.get(view, 0).unwrap_or(0) != array.get(other, 0).unwrap_or(0) { return 0 }
    array_change(&mut a)
    let moved = a
    a = array_make(42)
    if array.get(&a, 0).unwrap_or(0) != 42 { return 0 }
    array.get(&moved, 0).unwrap_or(0) + array.get(&moved, 1).unwrap_or(0)
}

fn array_choose(value: Array<Int32>, other: Array<Int32>, flag: Bool) -> Array<Int32> {
    if flag { return value }
    other
}

fn array_branches() -> Int32 {
    var a = array_make(0)
    var i: Int32 = 0
    while i < 5 {
        i = i + 1
        a = array_choose(a, array_make(i), i == 3)
        if i == 2 { continue }
        if i == 4 { break }
    }
    if array.get(&a, 0).unwrap_or(0) != 4 { return 0 }
    42
}

fn array_reserve_existing() -> Int32 {
    var a = array.with_capacity(16)
    var i = 0
    while i < 100 {
        array.reserve(&mut a, 16)
        i = i + 1
    }
    if array.len(&a) != 0 || array.capacity(&a) != 16 { return 0 }
    42
}

fn array_capacity_overflow() -> Int32 {
    let a = array.with_capacity(18446744073709551615)
    0
}

fn array_reserve_overflow() -> Int32 {
    var a = array_make(1)
    array.reserve(&mut a, 18446744073709551615)
    0
}

fn array_budget_failure() -> Int32 {
    let a = array.with_capacity(16777216)
    0
}
