import joky/json as json.{type Value, type Limits, type DecodeError, type DecodeErrorKind}
import joky/array.{type Array}
import joky/string.{type StringBuilder}
import joky/check.{assert}
import joky/task

fn ensure(ok: Bool) { let message = "JSON2a decoder contract"; assert(ok, &message) }
fn error_code(error: DecodeError) -> Int32 {
    match error.kind {
        UnexpectedEof => 1, UnexpectedToken => 2, InvalidEscape => 3, InvalidUnicode => 4
        InvalidUtf8 => 5, InvalidNumber => 6, DuplicateKey => 7, TrailingData => 8
        InputLimit => 9, DepthLimit => 10, NodeLimit => 11, StringLimit => 12
        NumberLimit => 13, InvalidLimits => 14
    }
}
fn bad(input: String, expected: Int32, offset: UInt64) {
    match json.decode(&input) {
        Ok(_) => { ensure(false) }
        Err(error) => { ensure(error.offset == offset); ensure(error_code(error) == expected) }
    }
}
fn limited(input: String, limits: Limits, expected: Int32, offset: UInt64) {
    match json.decode_with_limits(&input, limits) {
        Ok(_) => { ensure(expected == 0) }
        Err(error) => { ensure(error.offset == offset); ensure(error_code(error) == expected) }
    }
}
fn text(input: String, expected: String) {
    match json.decode(&input) {
        Ok(Value.Text(actual)) => { ensure(actual.equals(&expected)) }
        _ => { ensure(false) }
    }
}
fn numeric(input: String, expected: String) {
    match json.decode(&input) {
        Ok(Value.Number(actual)) => { ensure(actual.as_text().equals(&expected)) }
        _ => { ensure(false) }
    }
}
fn positive() {
    let distinct = "{{\"é\":1,\"e\\u0301\":2}}"
    match json.decode(&distinct) { Ok(Value.Object(fields)) => { ensure(fields.len() == 2) }, _ => { ensure(false) } }
    let kind = DecodeErrorKind.NumberLimit
    ensure(error_code(DecodeError { kind: kind, offset: 0 }) == 13)
    let input = " \t\r\nnull \n"
    match json.decode(&input) { Ok(Value.Null) => {}, _ => { ensure(false) } }
    let input = "true"
    match json.decode(&input) { Ok(Value.Boolean(value)) => { ensure(value) }, _ => { ensure(false) } }
    let input = "false"
    match json.decode(&input) { Ok(Value.Boolean(value)) => { ensure(!value) }, _ => { ensure(false) } }
    numeric("18446744073709551616", "18446744073709551616")
    numeric("1e400", "1e400"); numeric("-0.1200E+004", "-0.1200E+004"); numeric("-0", "-0")
    text("\"\"", ""); text("\"你🙂\"", "你🙂")
    text("\"\\\"\\\\\\/\\b\\f\\n\\r\\t\"", "\"\\/\u{8}\u{c}\n\r\t")
    text("\"\\u0000\\u0061\\u4F60\\uD83D\\uDE42\"", "\0a你🙂")
    text("\"\\ud800\\udc00\\uDBFF\\uDFFF\"", "\u{10000}\u{10ffff}")
    let input = "{{\"a\":[null,true,false,\"x\",{{}},[],18446744073709551616],\"\":{{}},\"你\":\"🙂\"}}"
    match json.decode(&input) {
        Ok(Value.Object(fields)) => {
            ensure(fields.len() == 3)
            let key = "a"
            match fields.value_ref(&key) {
                Array(items) => {
                    ensure(items.len() == 7)
                    match items.borrow_ref(0) { Null => {}, _ => { ensure(false) } }
                    match items.borrow_ref(1) { Boolean(value) => { ensure(value) }, _ => { ensure(false) } }
                    match items.borrow_ref(2) { Boolean(value) => { ensure(!value) }, _ => { ensure(false) } }
                    match items.borrow_ref(4) { Object(empty) => { ensure(empty.is_empty()) }, _ => { ensure(false) } }
                    match items.borrow_ref(5) { Array(empty) => { ensure(empty.is_empty()) }, _ => { ensure(false) } }
                    match items.borrow_ref(6) {
                        Number(value) => { let expected = "18446744073709551616"; ensure(value.as_text().equals(&expected)) }
                        _ => { ensure(false) }
                    }
                }
                _ => { ensure(false) }
            }
        }
        _ => { ensure(false) }
    }
}
fn negative() {
    bad("", 1, 0); bad(" \t", 1, 2); bad("nul", 1, 3); bad("truX", 2, 3)
    bad("NaN", 2, 0); bad("Infinity", 2, 0); bad("+1", 2, 0); bad(".1", 2, 0)
    bad("-", 6, 1); bad("01", 6, 1); bad("1.", 6, 2); bad("1e+", 6, 3)
    bad("[1e-]", 6, 4); bad("[00]", 6, 2); bad("1x", 6, 1)
    bad("null true", 8, 5); bad("truex", 8, 4); bad("{{}}[]", 8, 2)
    bad("\u{feff}null", 2, 0); bad("\u{c}null", 2, 0)
    bad("[", 1, 1); bad("[1,", 1, 3); bad("[1,]", 2, 3); bad("[,1]", 2, 1)
    bad("[1 2]", 2, 3); bad("[}}", 2, 1); bad("{{]", 2, 1)
    bad("{{", 1, 1); bad("{{\"a\"", 1, 4); bad("{{\"a\":", 1, 5)
    bad("{{\"a\" 1}}", 2, 5); bad("{{a:1}}", 2, 1); bad("{{\"a\":1,}}", 2, 7)
    bad("{{\"a\":1 \"b\":2}}", 2, 7); bad("{{\"a\":]}}", 2, 5)
    bad("{{\"a\":1,\"a\":2}}", 7, 7); bad("{{\"a\":1,\"\\u0061\":2}}", 7, 7)
    bad("{{\"你\":1,\"你\":2}}", 7, 9)
    bad("\"", 1, 1); bad("\"a", 1, 2); bad("\"\\", 1, 2)
    bad("\"\\u12", 1, 5); bad("\"\\x\"", 3, 1); bad("\"\\u{{61}}\"", 3, 1)
    bad("\"\\u12xz\"", 3, 1); bad("\"a\n\"", 2, 2); bad("\"\0\"", 2, 1)
    bad("\"\\uD800\"", 4, 1); bad("\"\\uDC00\"", 4, 1); bad("\"\\uD800\\u0041\"", 4, 1)
    bad("\"\\uD800\\x\"", 4, 1); bad("\"\\uD800\\uD800\"", 4, 1)
    bad("\"\\uD800\\uDC", 1, 11)
    bad("{{\"🙂\":1,\"\\uD83D\\uDE42\":2}}", 7, 10)
}
fn boundaries() {
    var limits = Limits.defaults()
    limits.max_input_bytes = 4
    limited("0  ", limits, 0, 0); limited("null", limits, 0, 0); limited("null ", limits, 9, 4)
    limits.max_input_bytes = 0
    limited("", limits, 1, 0); limited("0", limits, 9, 0)
    limits = Limits.defaults()
    limits.max_depth = 2
    limited("[]", limits, 0, 0); limited("[{{}}]", limits, 0, 0); limited("[[[]]]", limits, 10, 2)
    limits.max_depth = 0
    limited("0", limits, 0, 0); limited("[]", limits, 10, 0)
    limits = Limits.defaults()
    limits.max_nodes = 3
    limited("[0]", limits, 0, 0); limited("[0,{{}}]", limits, 0, 0); limited("[0,0,0]", limits, 11, 5)
    limited("{{\"a\":null,\"b\":null}}", limits, 0, 0)
    limits.max_nodes = 0
    limited("null", limits, 11, 0)
    limits = Limits.defaults()
    limits.max_string_bytes = 4
    limited("\"你\"", limits, 0, 0); limited("\"🙂\"", limits, 0, 0); limited("\"你ab\"", limits, 12, 5)
    limited("\"\\uD83D\\uDE42\"", limits, 0, 0); limited("\"a\\uD83D\\uDE42\"", limits, 12, 2)
    limited("{{\"abcde\":0}}", limits, 12, 6)
    limits.max_string_bytes = 0
    limited("{{\"\":\"\"}}", limits, 0, 0); limited("\"a\"", limits, 12, 1)
    limits = Limits.defaults()
    limits.max_number_bytes = 3
    limited("10", limits, 0, 0); limited("100", limits, 0, 0); limited("1000", limits, 13, 3)
    limits.max_number_bytes = 0
    limited("null", limits, 0, 0); limited("0", limits, 13, 0)
    limits = Limits.defaults()
    limits.max_output_bytes = 0
    limited("[null]", limits, 0, 0)
    limits.max_output_bytes = 1048577
    limited("", limits, 14, 0)
    limits = Limits.defaults(); limits.max_input_bytes = 1048577; limited("0", limits, 14, 0)
    limits = Limits.defaults(); limits.max_depth = 129; limited("0", limits, 14, 0)
    limits = Limits.defaults(); limits.max_nodes = 65537; limited("0", limits, 14, 0)
    limits = Limits.defaults(); limits.max_string_bytes = 262145; limited("0", limits, 14, 0)
    limits = Limits.defaults(); limits.max_number_bytes = 1025; limited("0", limits, 14, 0)
    var builder = StringBuilder.new()
    var index: UInt64 = 0
    while index < 128 { builder.push('['); index = index + 1 }
    index = 0
    while index < 128 { builder.push(']'); index = index + 1 }
    let depth_limit = builder.finish()
    ensure(json.decode(&depth_limit).is_ok())
    var builder = StringBuilder.new()
    builder.push('['); builder.push_str(&depth_limit); builder.push(']')
    bad(builder.finish(), 10, 128)
}
fn bytes() {
    var source = Array.new::<UInt8>()
    source.push(34); source.push(0xf0); source.push(0x9f); source.push(0x99); source.push(0x82); source.push(34)
    match json.decode_bytes(source) {
        Ok(Value.Text(text)) => { let expected = "🙂"; ensure(text.equals(&expected)) }
        _ => { ensure(false) }
    }
    var source = Array.new::<UInt8>()
    source.push(34); source.push(0xed); source.push(0xa0); source.push(0x80); source.push(34)
    match json.decode_bytes(source) { Err(error) => { ensure(error.offset == 1); ensure(error_code(error) == 5) }, _ => { ensure(false) } }
    var source = Array.new::<UInt8>()
    source.push(0xc2)
    match json.decode_bytes(source) { Err(error) => { ensure(error.offset == 0); ensure(error_code(error) == 5) }, _ => { ensure(false) } }
    var source = Array.new::<UInt8>()
    source.push(0xff)
    var limits = Limits.defaults(); limits.max_input_bytes = 0
    match json.decode_bytes_with_limits(source, limits) { Err(error) => { ensure(error.offset == 0); ensure(error_code(error) == 9) }, _ => { ensure(false) } }
    var source = Array.new::<UInt8>(); source.push(0xff)
    limits.max_output_bytes = 1048577
    match json.decode_bytes_with_limits(source, limits) { Err(error) => { ensure(error_code(error) == 14) }, _ => { ensure(false) } }
}
fn main() @suspends { positive(); negative(); boundaries(); bytes(); json2a_probe(); json2a_failure(); json2a_work(); json2a_cancel_work(); }

fn owned_tree() -> Value {
    let input = "{{\"key\":[null,{{\"num\":18446744073709551616}},\"\\uD83D\\uDE42\\u0000\"]}}"
    match json.decode(&input) {
        Ok(value) => value
        Err(_) => { ensure(false); Value.Null }
    }
}
fn inspect(value: &Value) {
    match value {
        Object(fields) => {
            let key = "key"
            match fields.value_ref(&key) {
                Array(items) => {
                    ensure(items.len() == 3)
                    match items.borrow_ref(1) {
                        Object(nested) => {
                            let key = "num"
                            match nested.value_ref(&key) {
                                Number(number) => {
                                    let spelling = "18446744073709551616"
                                    ensure(number.as_text().equals(&spelling))
                                }
                                _ => { ensure(false) }
                            }
                        }
                        _ => { ensure(false) }
                    }
                    match items.borrow_ref(2) {
                        Text(text) => { let expected = "🙂\0"; ensure(text.equals(&expected)) }
                        _ => { ensure(false) }
                    }
                }
                _ => { ensure(false) }
            }
        }
        _ => { ensure(false) }
    }
}
fn json2a_probe() -> Int32 { let tree = owned_tree(); inspect(&tree); 42 }
fn json2a_failure() -> Int32 {
    bad("{{\"key\":[\"a\",{{\"num\":18446744073709551616}},\"\\uD800\"]}}", 4, 42)
    42
}
fn json2a_work() @suspends -> Int32 {
    let tree = owned_tree()
    task.yield_now()
    inspect(&tree)
    json2a_failure();
    task.yield_now()
    42
}

fn json2a_cancel_work() @suspends -> Int32 {
    let input = "{{\"x\":[\"\\u0000\",-0.0]}}"
    let value = match json.decode(&input) {
        Ok(value) => value, Err(_) => { ensure(false); Value.Null }
    }
    task.yield_now()
    let invalid = "{{\"x\":[\"\\u0000\",-0.0,]}}"
    match json.decode(&invalid) { Err(error) => { ensure(error_code(error) == 2) }, Ok(_) => { ensure(false) } }
    task.yield_now()
    match &value { Object(fields) => { ensure(fields.len() == 1) }, _ => { ensure(false) } }
    42
}
