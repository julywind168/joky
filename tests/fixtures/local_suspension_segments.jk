import joky/iter
import joky/task
import joky/fixed_array.{type FixedArray}

struct PatternPoint { x: Int32, y: Int32 }
struct PatternBox<T> { value: T }
struct PatternLeaf { value: Int32, text: String }
struct PatternRoot { leaf: PatternLeaf, ignored: String }
struct PatternBatch { values: FixedArray<Int32, 2> }

fn apply<F: Fn() -> Int32>(operation: F) -> Int32 { operation() }

fn local_closures() @suspends -> Int32 {
    let number = 20
    let read = || { number + 1 }
    let alias = read
    let first = apply(alias)
    task.yield_now()
    var second = 20
    var increment = || { second += 1 }
    increment()
    task.yield_now()
    first + second
}

fn local_owners() @suspends -> Int32 {
    let number = alloc(21)
    let first = {
        let first_values = [&*number]
        let read = move || { *first_values[0] }
        read()
    }
    task.yield_now()
    let second = {
        let second_values = [&*number]
        *second_values[0]
    }
    task.yield_now()
    first + second
}

fn local_consumed_owners() @suspends -> Int32 {
    let number = alloc(21)
    let consumed_values = [&*number]
    let other = 21
    let reference = &other
    let consume = move || {
        let result = *consumed_values[0] + *reference
        consumed_values.release()
        result
    }
    let consumed = consume()
    task.yield_now()
    let released = [&*number]
    released.release()
    task.yield_now()
    consumed
}

fn local_control_flow() @suspends -> Int32 {
    var answer = 0
    var index = 0
    while index < 3 {
        index += 1
        let delta = if index == 1 {
            let read = || { index + 20 }
            read()
        } else {
            if index == 3 { break }
            let read = || { index + 19 }
            read()
        }
        answer += delta
        task.yield_now()
        continue
    }
    answer
}

fn local_pipelines() @suspends -> Int32 {
    var answer = 0
    {
        let values = [20, 21]
        let limit = 20
        for value in iter.shared(&values).filter(|v| { *v > limit }) {
            answer += *value
        }
    }
    task.yield_now()
    {
        var values = [20]
        for value in iter.exclusive(&mut values) {
            *value += 1
            task.yield_now()
        }
        answer += values[0]
    }
    answer
}

fn local_without_suspension() @suspends -> Int32 {
    let number = alloc(42)
    let values = [&*number]
    let read = || { *values[0] }
    let point = PatternPoint { x: read(), y: 0 }
    let PatternPoint { x, .. } = &point
    x
}

fn local_borrowed_records() @suspends -> Int32 {
    let first = {
        let cell = alloc(21)
        let wrapped = PatternBox { value: [&*cell] }
        let PatternBox { value: values } = &wrapped
        *values[0]
    }
    task.yield_now()
    var point = PatternPoint { x: 20, y: 22 }
    var PatternPoint { x, .. } = &point
    point.x = 100
    x += 1
    task.yield_now()
    assert_eq(point.x, 100)
    first + x
}

fn borrowed_record_views() @suspends -> Int32 {
    let root = PatternRoot {
        leaf: PatternLeaf { value: 42, text: "alive" }
        ignored: "retained"
    }
    let PatternRoot { leaf: PatternLeaf { value, text }, .. } = &root
    task.yield_now()
    assert_eq(text, "alive")
    assert_eq(root.ignored, "retained")
    value
}

fn borrowed_sequence_views() @suspends -> Int32 {
    let values: FixedArray<String, 3> = ["first", "ignored", "last"]
    let [first, _, last] = &values
    let batch = PatternBatch { values: [20, 22] }
    let PatternBatch { values: [left, right] } = &batch
    task.yield_now()
    assert_eq(first, "first")
    assert_eq(last, "last")
    assert_eq(values.len(), 3)
    left + right
}
