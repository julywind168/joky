import joky/assertions.{assert_eq as equal, assert_ne as different}
import joky/check.{assert, panic}
import joky/eq.{type Eq}
import joky/show.{type Show}
import joky/string.{type StringBuilder}
import joky/float
import joky/task

struct Quiet { value: Int32 }
impl Quiet {
    fn eq(&self, other: &Self) -> Bool { panic("must use Eq") }
}
impl Eq for Quiet {
    fn eq(&self, other: &Self) -> Bool { self.value == other.value }
}
impl Show for Quiet {
    fn show(&self, output: &mut StringBuilder) @noescape {
        panic("successful assertions must not render values")
    }
}

fn text(calls: &mut Int32) -> String { *calls += 1; "owned" }

fn main() @suspends {
    var calls = 0
    equal({ calls += 1; 42 }, { assert(calls == 1, "left-to-right evaluation"); calls += 1; 42 })
    equal(calls, 2)
    different({ calls += 1; 1 }, { assert(calls == 3, "left-to-right inequality"); calls += 1; 2 })
    equal(calls, 4)
    equal(text(&mut calls), text(&mut calls))
    equal(calls, 6)
    var owner = "你好"
    equal(owner, "你好")
    different(&owner, "other")
    owner = "still available"
    task.yield_now()
    equal(owner, "still available")
    equal(Quiet { value: 1 }, Quiet { value: 1 })
    different(Quiet { value: 1 }, Quiet { value: 2 })

    equal(int8(-1), int8(-1))
    equal(int16(-2), int16(-2))
    equal(int32(-3), int32(-3))
    equal(int64(-4), int64(-4))
    equal(uint8(1), 1)
    equal(1, uint8(1))
    equal(uint16(2), uint16(2))
    equal(uint32(3), uint32(3))
    equal(uint64(4), uint64(4))
    equal(true, true)
    different(false, true)
    equal('中', '中')
    equal({}, {})
    equal(float32(1.5), float32(1.5))
    equal(1.5, 1.5)
    equal(-0.0, 0.0)
    different(Float32.NAN, Float32.NAN)
    different(Float64.NAN, Float64.NAN)
}
