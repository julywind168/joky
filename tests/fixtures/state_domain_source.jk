import joky/domain
import joky/task
import joky/check
import joky/array.{type Array}

fn require(condition: Bool, message: String) { check.require(condition, &message) }

fn status(result: Result<Int32, domain.RequestError>) -> Int32 {
    match result {
        Ok(_) => 0
        Err(domain.RequestError.Failed) => 1
        Err(domain.RequestError.Cancelled) => 2
        Err(domain.RequestError.Closed) => 3
        Err(domain.RequestError.ResourceLimit) => 4
        Err(domain.RequestError.InvalidAccess) => 5
        Err(domain.RequestError.DomainFailed) => 6
    }
}
struct State { count: Int32, scale: Float64, flag: Bool }
fn make(count: Int32) -> State { State { count: count, scale: 0.5, flag: true } }
fn add(state: &mut State, delta: Int32) -> Int32 { state.count = state.count + delta state.count }
fn read(state: &State) -> Int32 {
    if state.scale != 0.5 || !state.flag { return -999 }
    state.count
}
fn fail_write(state: &mut State, zero: Int32) -> Int32 { state.count = 99 state.count / zero }
fn work(delta: Int32) @suspends -> Int32 {
    domain.write(add, delta)
    task.yield_now()
    domain.read(read)
}
struct Other { count: Int32 }
fn wrong_read(state: &Other) -> Int32 { state.count }
fn wrong_request(input: Int32) @suspends -> Int32 { domain.read(wrong_read) }
fn broken(zero: Int32) @suspends -> Int32 { 1 / zero }
fn poison(zero: Int32) @suspends -> Int32 { domain.write(fail_write, zero) }
fn echo(value: Int32) @suspends -> Int32 { value }
fn delayed(delta: Int32) @suspends -> Int32 { task.sleep_ms(10000) domain.write(add, delta) }
fn launch(handle: domain.WriteHandle<State>, delta: Int32) @suspends {
    require(domain.request(handle, work, delta).is_ok(), "request completed")
}
fn wait_for_close(handle: domain.WriteHandle<State>) @suspends {
    match domain.request(handle, delayed, 100) {
        Err(domain.RequestError.Closed) => {}
        _ => { require(false, "close joined the request") }
    }
}
fn close_owner(owner: domain.Owner<State>) @suspends { owner.close() }
fn slow(handle: domain.WriteHandle<State>) @suspends { domain.request(handle, delayed, 100); }
fn ready() @suspends { task.yield_now() }

fn lifecycle() @suspends -> Int32 {
    let owner = domain.create(make, 10)
    let handle = owner.handle()
    let result = domain.request(handle, work, 2).unwrap_or(-1)
    task.yield_now()
    result + domain.read_from(handle.read_only(), read)
}
fn main() @suspends {
    let owner = domain.create(make, 10)
    let handle = owner.handle()
    let reader = owner.read_handle()
    var readers = Array.new::<domain.ReadHandle<State>>()
    readers.push(reader)
    let stored = readers.get(0).unwrap_or(reader)
    require(domain.read_from(stored, read) == 10, "copy handles in owned storage")
    parallel { | launch(handle, 2) | launch(handle, 3) }
    require(domain.read_from(reader, read) == 15, "serialized writes")
    require(status(domain.request(handle, broken, 0)) == 1, "request failure is isolated")
    require(status(domain.request_read(reader, work, 5)) == 5, "read grant cannot write")
    require(status(domain.request(handle, wrong_request, 0)) == 5, "nominal state mismatch")
    require(domain.read_from(reader, read) == 15, "failure preserved state")
    require(domain.request(handle, echo, -2147483648).unwrap_or(0) == -2147483648, "minimum scalar result")
    require(domain.request(handle, echo, 2147483647).unwrap_or(0) == 2147483647, "maximum scalar result")
    race { | slow(handle) | ready() }
    require(domain.read_from(reader, read) == 15, "race cancelled pending work")
    parallel { | wait_for_close(handle) | close_owner(owner) }
    require(status(domain.request(handle, work, 1)) == 3, "closed handles stay invalid")
    let stale = { let temporary = domain.create(make, 1) temporary.handle() }
    require(status(domain.request(stale, work, 1)) == 3, "drop closes state")
    let other = domain.create(make, 7)
    let poisoned = domain.create(make, 5)
    let poison_handle = poisoned.handle()
    require(status(domain.request(poison_handle, poison, 0)) == 6, "write failure isolates domain")
    require(status(domain.request(poison_handle, work, 1)) == 6, "failed domain remains distinct from closed")
    require(domain.read_from(other.read_handle(), read) == 7, "unrelated domain survives")
    require(lifecycle() == 24, "source lifecycle")
    println("source domains ok")
}
