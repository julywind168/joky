import joky/fs
import joky/array.{type Array}
import joky/check
import joky/string.{type Utf8ErrorCode}

fn expect(value: Bool) { let message = "File convenience assertion failed"; check.assert(value, &message) }
fn readable(path: String) @suspends -> fs.File { fs.open(path, fs.OpenOptions.default()).unwrap() }
fn writable(path: String) @suspends -> fs.File {
    var options = fs.OpenOptions.default()
    options.write = true
    fs.open(path, options).unwrap()
}
fn limited(path: String, limit: UInt64, position: UInt64) @suspends {
    var file = readable(path)
    match file.read_all_limited(limit) {
        Ok(_) => { expect(false) }
        Err(error) => { expect(match error.kind { fs.ErrorKind.LimitExceeded => true, _ => false }) }
    }
    expect(file.seek(fs.SeekFrom.Current(0)).unwrap() == position)
    file.close().unwrap()
}
fn write_failure(path: String, code: Int32) @suspends {
    var file = writable(path)
    match file.write_text("你好🙂") {
        Ok(_) => { expect(false) }
        Err(failure) => {
            if code == 10 {
                expect("{failure}" == "write failed after 3 confirmed bytes: SystemFailure: Injected failure after external progress")
            }
            expect(failure.written == 3)
            expect(match failure.error.kind {
                fs.ErrorKind.WriteZero => code == 9
                fs.ErrorKind.Busy => code == 6
                fs.ErrorKind.SystemFailure => code == 10
                _ => false
            })
        }
    }
    // A reported error need not identify all externally visible progress.
    let actual: UInt64 = if code == 10 { 4 } else { 3 }
    expect(file.seek(fs.SeekFrom.Current(0)).unwrap() == actual)
    file.close().unwrap()
}
fn read_boundaries() @suspends {
    var empty = readable("empty")
    expect(empty.read_all_limited(0).unwrap().is_empty())
    expect(empty.read_text_limited(0).unwrap().byte_length() == 0)
    empty.close().unwrap()
    limited("binary", 0, 1)
    limited("binary", 2, 3)
    var exact = readable("binary")
    let bytes = exact.read_all_limited(3).unwrap()
    expect(bytes.len() == 3 && bytes.get(0).unwrap_or(1) == 0 && bytes.get(1).unwrap_or(0) == 255)
    expect(exact.read_all_limited(18446744073709551615).unwrap().is_empty())
    exact.seek(fs.SeekFrom.Start(1)).unwrap()
    let remainder = exact.read_all_limited(18446744073709551615).unwrap()
    expect(remainder.len() == 2 && remainder.get(0).unwrap_or(0) == 255)
    exact.close().unwrap()

}
fn read_valid_text(bounded: Bool) @suspends {
    var short = readable("short_read")
    let text = text_case(&mut short, bounded, 100).unwrap()
    let expected = "你好🙂\0\r\n"
    expect(text == expected)
    short.close().unwrap()
    var cross = readable("cross_block")
    let text = text_case(&mut cross, bounded, 65541).unwrap()
    expect(text.byte_length() == 65541)
    let suffix = text.substring(65535, 65541).unwrap_or("")
    let expected = "你好"
    expect(suffix == expected)
    cross.close().unwrap()

}
fn read_invalid_text(bounded: Bool) @suspends {
    var invalid = readable("invalid")
    invalid.seek(fs.SeekFrom.Start(1)).unwrap()
    match text_case(&mut invalid, bounded, 10) {
        Err(fs.ReadTextError.Utf8(error)) => {
            expect(error.offset == 0)
            expect(match error.code { Utf8ErrorCode.InvalidSequence => true, _ => false })
        }
        _ => { expect(false) }
    }
    expect(invalid.seek(fs.SeekFrom.Current(0)).unwrap() == 2)
    invalid.close().unwrap()
    var truncated = readable("truncated")
    let result = text_case(&mut truncated, bounded, 3)
    expect("{result}" == "Err(truncated UTF-8 sequence at byte 1)")
    match result {
        Err(fs.ReadTextError.Utf8(error)) => {
            expect(error.offset == 1)
            expect(match error.code { Utf8ErrorCode.UnexpectedEnd => true, _ => false })
        }
        _ => { expect(false) }
    }
    truncated.close().unwrap()
    var limit_first = readable("invalid")
    match limit_first.read_text_limited(1) {
        Err(fs.ReadTextError.Io(error)) => { expect(match error.kind { fs.ErrorKind.LimitExceeded => true, _ => false }) }
        _ => { expect(false) }
    }
    limit_first.close().unwrap()
    var error_first = readable("read_error")
    match text_case(&mut error_first, bounded, 10) {
        Err(fs.ReadTextError.Io(error)) => { expect(match error.kind { fs.ErrorKind.SystemFailure => true, _ => false }) }
        _ => { expect(false) }
    }
    error_first.close().unwrap()

}
fn writes() @suspends {
    var partial = writable("write_partial")
    var bytes: Array<UInt8> = [99, 0, 255, 42, 0, 1, 2, 88]
    let end = bytes.len() - 1
    let written = partial.write(bytes.slice(1, end))!
    expect(written == 3)
    expect(partial.write(bytes.slice(1 + written, end))! == 3)
    bytes[1] = 7
    expect(bytes[0] == 99 && bytes[1] == 7 && bytes[end] == 88)
    partial.close()!
    var output = writable("write_short")
    output.write_text("你好🙂\0\r\n").unwrap()
    output.close().unwrap()
    write_failure("write_zero", 9)
    write_failure("write_error", 10)
    write_failure("write_busy", 6)
    var empty_write = writable("write_empty")
    empty_write.write_all(Array.new::<UInt8>()).unwrap()
    empty_write.write_text("").unwrap()
    empty_write.close().unwrap()

}
fn large_roundtrip() @suspends {
    var large = readable("large")
    let data = large.read_all().unwrap()
    expect(data.len() == 1048583)
    large.close().unwrap()
    var output = writable("write_large")
    let too_large = output.write(data.slice(1, 1048578)).err()!
    expect(too_large.kind == fs.ErrorKind.LimitExceeded)
    output.write_all(data).unwrap()
    output.close().unwrap()
}
fn run() @suspends -> Int32 {
    read_boundaries()
    read_defaults()
    read_valid_text(false)
    read_valid_text(true)
    read_invalid_text(false)
    read_invalid_text(true)
    writes()
    large_roundtrip()
    42
}

fn text_case(file: &mut fs.File, bounded: Bool, limit: UInt64) @suspends -> Result<String, fs.ReadTextError> {
    if bounded { file.read_text_limited(limit) } else { file.read_text() }
}
fn read_defaults() @suspends {
    var empty = readable("empty")
    expect(empty.read_all().unwrap().is_empty())
    expect(empty.read_text().unwrap().byte_length() == 0)
    empty.close().unwrap()
    var binary = readable("binary")
    binary.seek(fs.SeekFrom.Start(1)).unwrap()
    let bytes = binary.read_all().unwrap()
    expect(bytes.len() == 2 && bytes.get(0).unwrap_or(0) == 255 && bytes.get(1).unwrap_or(0) == 42)
    expect(binary.read_all().unwrap().is_empty())
    binary.close().unwrap()
}
