import joky/iter.{type Range, type Step, range, range_inclusive}
import joky/option.{type Option, Some, None}
import joky/check.{assert}
import joky/drop.{type Drop}
import joky/integer
extern fn record(x: Int32) -> Int32
extern fn delayed_value(x: Int32) @suspends -> Int32
fn expect(ok: Bool) { assert(ok, "Range mismatch") }
fn count<T: Copy + Step>(values: Range<T>) -> Int32 {
    var total = 0
    for _ in values { total += 1 }
    total
}
fn bounds<T: Copy + Step>(first: T, before: T, last: T) {
    expect(count(first..=first) == 1)
    expect(count(last..last) == 0)
    expect(count(last..=last) == 1)
    expect(count(last..before) == 0)
    expect(count(last..=before) == 0)
    expect(count(before..last) == 1)
    expect(count(before..=last) == 2)
    expect(Step.successor(last).is_none())
    var values = before..=last
    let a = iter.next(&mut values)!
    let b = iter.next(&mut values)!
    expect(!Step.less(a, before) && !Step.less(before, a))
    expect(!Step.less(b, last) && !Step.less(last, b))
    expect(iter.next(&mut values).is_none() && iter.next(&mut values).is_none())
}
type Small = UInt16
fn typed() -> Range<UInt64> { 0..=uint64(2) }
struct Tick { value: Int32 }
impl Step for Tick {
    fn less(self, other: Self) -> Bool { self.value < other.value }
    fn successor(self) -> Option<Self> {
        if self.value == 3 { None } else { Some(Tick { value: self.value + 1 }) }
    }
}
fn compute() -> Int32 {
    bounds::<Int8>(-128, 126, 127)
    bounds::<Int16>(-32768, 32766, 32767)
    bounds::<Int32>(-2147483648, 2147483646, 2147483647)
    bounds::<Int64>(-9223372036854775808, 9223372036854775806, 9223372036854775807)
    bounds::<UInt8>(0, 254, 255)
    bounds::<UInt16>(0, 65534, 65535)
    bounds::<UInt32>(0, 4294967294, 4294967295)
    bounds::<UInt64>(0, 18446744073709551614, 18446744073709551615)
    expect(count(range(1, 4)) == 3 && count(range_inclusive(1, 4)) == 4)
    expect(count(-3..2) == 5 && count(-3..=2) == 6)
    expect(count(1+2..2*3) == 3)
    expect(count(0..uint64(3)) == 3 && count(uint64(0)..3) == 3)
    expect(count(18446744073709551614..=UInt64.MAX) == 2)
    let saved: Range<Small> = 0..=uint16(2)
    expect(count(saved) == 3 && count(saved) == 3)
    expect(count(typed()) == 3)
    expect(count((Tick { value: 1 })..=(Tick { value: 3 })) == 3)
    let pair = (1, 4)
    expect(count(pair.0..pair.1) == 3)
    var total = 0
    for index, value in 1..=4 {
        if value == 2 { continue }
        total += index + value
        if value == 3 { break }
    }
    expect(total == 6)
    expect(count(record(1)..=record(3)) == 3)
    var changing = 1
    let stable = changing..{ changing = 4; changing }
    expect(count(stable) == 3)
    let values = [1, 2, 3]
    let expanded = [0, ..values, 4]
    match expanded {
        [head, ..middle, tail] => { expect(head == 0 && middle.len() == 3 && tail == 4) },
        _ => { expect(false) }
    }
    let Tick { value, .. } = Tick { value: 7 }
    expect(value == 7)
    42
}
struct Guard { id: Int32, text: String }
impl Drop for Guard { fn drop(&mut self) { record(self.id); } }
fn pending() @suspends -> Int32 {
    let guard = Guard { id: 99, text: "guard" }
    record(-99)
    var total = 0
    for index, value in delayed_value(record(0))..=delayed_value(record(2)) {
        expect(value == index + 1)
        total += delayed_value(record(value + 10))
    }
    expect(total == 39 && guard.id == 99)
    42
}
fn endpoint_failure() {
    let guard = Guard { id: 99, text: "guard" }
    for _ in (record(7) / 0)..record(8) {}
}
