import joky/array.{type Array}
import joky/drop.{type Drop}

extern fn record_drop(value: Int32)

struct Part<T> { flag: Bool id: Int32 values: Array<T> }
impl<T> Drop for Part<T> {
    fn drop(&mut self) { let length = self.values.len() record_drop(self.id) }
}
fn part<T>(id: Int32) -> Part<T> { Part { flag: true, id: id, values: Array.new::<T>() } }
fn tracked<T>(id: Int32) -> Part<T> {
    let result = part::<T>(id)
    record_drop(0 - id)
    result
}
struct Pack { tag: Int32 first: Part<Int32> flag: Bool middle: Part<Int64> empty: Unit last: Part<Bool> }
fn pack(start: Int32) -> Pack {
    Pack { tag: 42, first: part::<Int32>(start), flag: true, middle: part::<Int64>(start + 1), empty: {}, last: part::<Bool>(start + 2) }
}
fn fields_first() -> Int32 { let p = pack(1) let chosen = p.first 41 + chosen.id }
fn fields_middle() -> Int32 { let p = pack(1) let chosen = p.middle 40 + chosen.id }
fn fields_last() -> Int32 { let p = pack(1) let chosen = p.last 39 + chosen.id }
fn fields_temporary() -> Int32 { let chosen = pack(1).middle 40 + chosen.id }
fn select_middle() -> Part<Int64> { let p = pack(1) p.middle }
fn fields_return() -> Int32 { let chosen = select_middle() 40 + chosen.id }
fn fields_reinitialize() -> Int32 {
    var p = pack(1)
    let chosen = p.middle
    p = pack(4)
    p.tag + chosen.id - 2
}
fn fields_replace() -> Int32 {
    var p = pack(1)
    p.middle = part::<Int64>(5)
    p.middle = part::<Int64>(7)
    p.middle.id = 8
    p.middle.values.push(42)
    if p.first.id == 1 && p.last.id == 3 { int32(p.middle.values.get(0).unwrap_or(0)) } else { 0 }
}
fn fields_replace_edges() -> Int32 {
    var p = pack(1)
    p.first = part::<Int32>(4)
    p.last = part::<Bool>(6)
    p.first.values.push(42)
    p.first.values.get(0).unwrap_or(0)
}
struct Nest { head: Part<Int32> inner: Pack tail: Part<Int32> }
fn nest() -> Nest { Nest { head: part::<Int32>(9), inner: pack(1), tail: part::<Int32>(8) } }
fn fields_nested() -> Int32 { let p = nest() let chosen = p.inner.middle 40 + chosen.id }
fn fields_nested_temporary() -> Int32 { let chosen = nest().inner.middle 40 + chosen.id }
fn fields_nested_replace() -> Int32 {
    var p = nest()
    p.inner.middle = part::<Int64>(4)
    p.inner.middle.id = 5
    p.inner.tag
}
struct Group { id: Int32 inner: Pack }
impl Drop for Group { fn drop(&mut self) { record_drop(self.id) } }
struct Groups { first: Part<Int32> group: Group last: Part<Int32> }
fn groups() -> Groups { Groups { first: part::<Int32>(9), group: Group { id: 10, inner: pack(1) }, last: part::<Int32>(8) } }
fn fields_subtree() -> Int32 { let p = groups() let chosen = p.group chosen.inner.tag }
fn fields_subtree_temporary() -> Int32 { let chosen = groups().group chosen.inner.tag }
fn fields_subtree_replace() -> Int32 {
    var p = groups()
    p.group = Group { id: 20, inner: pack(4) }
    p.group.inner.tag
}
fn fields_rhs_failure() -> Int32 {
    var p = pack(1)
    p.middle = { let temporary = part::<Int64>(4) let bad = 1 << 32 part::<Int64>(5) }
    42
}
struct Bomb { id: Int32 values: Array<Int32> }
impl Drop for Bomb { fn drop(&mut self) { record_drop(self.id) let bad = 1 / 0 } }
struct BombPack { first: Part<Int32> middle: Bomb last: Part<Int32> }
fn fields_drop_failure() -> Int32 {
    var p = BombPack { first: part::<Int32>(1), middle: Bomb { id: 2, values: Array.new::<Int32>() }, last: part::<Int32>(3) }
    p.middle = Bomb { id: 4, values: Array.new::<Int32>() }
    42
}
fn fields_original_failure() -> Int32 {
    var p = BombPack { first: part::<Int32>(1), middle: Bomb { id: 2, values: Array.new::<Int32>() }, last: part::<Int32>(3) }
    p.middle = { let bad = 1 << 32 Bomb { id: 4, values: Array.new::<Int32>() } }
    42
}
struct Refs { first: Array<Int32> second: Array<&Int32> }
fn fields_references() -> Int32 {
    let fallback = share(alloc(0))
    let value = share(alloc(42))
    var p = Refs { first: Array.new::<Int32>(), second: Array.new::<&Int32>() }
    p.second.push(value)
    let selected = p.second
    let result = selected.get(0).unwrap_or(fallback)
    { let moved = selected }
    memory.read(result)
}
fn fields_replace_references() -> Int32 {
    let fallback = share(alloc(0))
    let value = share(alloc(42))
    var next = Array.new::<&Int32>()
    next.push(value)
    var p = Refs { first: Array.new::<Int32>(), second: Array.new::<&Int32>() }
    p.second = next
    let result = p.second.get(0).unwrap_or(fallback)
    { let moved = p }
    memory.read(result)
}
fn fields_transitions() -> Int32 {
    var p = Pack { tag: 42, first: tracked::<Int32>(1), flag: true, middle: tracked::<Int64>(2), empty: {}, last: tracked::<Bool>(3) }
    p.middle = tracked::<Int64>(4)
    let selected = p.middle
    p = Pack { tag: 42, first: tracked::<Int32>(5), flag: true, middle: tracked::<Int64>(6), empty: {}, last: tracked::<Bool>(7) }
    let last = p.last
    let temporary = Pack { tag: 42, first: tracked::<Int32>(8), flag: true, middle: tracked::<Int64>(9), empty: {}, last: tracked::<Bool>(10) }.middle
    selected.id + last.id + temporary.id + 22
}
fn fields_task() @suspends -> Int32 { fields_transitions() }

fn fields_loop() -> Int32 {
    var i = 1
    while i < 3 {
        var p = pack(i * 10)
        p.middle = part::<Int64>(i * 10 + 3)
        let chosen = p.last
        i = i + 1
        if i == 2 { continue }
        break
    }
    42
}
fn choose(flag: Bool) -> Part<Int64> { let p = pack(1) if flag { p.middle } else { p.middle } }
fn fields_branch_true() -> Int32 { let p = choose(true) p.id + 40 }
fn fields_branch_false() -> Int32 { let p = choose(false) p.id + 40 }
fn fields_early() -> Int32 { let p = pack(1) { let selected = p.middle return selected.id + 40 } }
struct Single { values: Array<Int32> }
fn single() -> Single { Single { values: Array.new::<Int32>() } }
fn fields_transparent() -> Int32 {
    var p = single()
    p.values = Array.new::<Int32>()
    let chosen = p.values
    p = single()
    let temporary = single().values
    42
}

fn fields_rhs_metadata() -> Int32 {
    var p = pack(1)
    p.middle.id = 22
    p.middle = part::<Int64>(p.middle.id + 1)
    p.middle.id + 19
}
fn bomb_pack(start: Int32) -> BombPack {
    BombPack { first: part::<Int32>(start), middle: Bomb { id: start + 1, values: Array.new::<Int32>() }, last: part::<Int32>(start + 2) }
}
fn fields_extract_failure() -> Int32 { let p = bomb_pack(1) let selected = p.first 42 }
fn fields_extract_original_failure() -> Int32 { let p = bomb_pack(1) let selected = p.middle 1 << 32 }
fn fields_reinitialize_failure() -> Int32 {
    var p = bomb_pack(1)
    let selected = p.first
    p = bomb_pack(4)
    42
}
