import joky/task

import joky/internal/output
fn write(text: &String) @suspends { output.__joky_write_stdout(text); }
fn emit(payload: &String, id: Int32) @suspends {
    var item = 0
    while item < 8 {
        let line = "worker={id};item={item};{payload}\0🙂\n"
        join { write(&line), task.yield_now() };
        task.yield_now()
        item += 1
    }
}
fn main() @suspends {
    let header = "42\n"
    join { write(&header), task.yield_now() };
    let payload = "__PAYLOAD__"
    let view = &payload
    scope {
        branch { emit(view, 0) }
        branch { emit(view, 1) }
        branch { emit(view, 2) }
        branch { emit(view, 3) }
    }
}
