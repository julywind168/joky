// Float32/Float64 literals, arithmetic, comparison, conversion and aggregates.
// Container storage lives in `float_storage.jk` so this fixture stays free of
// borrows that a `@suspends` rewrite would reject.
struct Pair { x: Float64 y: Float32 }
enum Shape { Empty Dot(Float64) Scale(Float32) }
type Point = (Float64, Float32)

fn add64(a: Float64, b: Float64) -> Float64 { a + b }
fn sub64(a: Float64, b: Float64) -> Float64 { a - b }
fn mul64(a: Float64, b: Float64) -> Float64 { a * b }
fn div64(a: Float64, b: Float64) -> Float64 { a / b }
fn neg64(a: Float64) -> Float64 { -a }
fn ordered64(a: Float64, b: Float64) -> Int32 {
    var bits: Int32 = 0
    if a == b { bits = bits + 1 }
    if a != b { bits = bits + 2 }
    if a < b { bits = bits + 4 }
    if a <= b { bits = bits + 8 }
    if a > b { bits = bits + 16 }
    if a >= b { bits = bits + 32 }
    bits
}

fn add32(a: Float32, b: Float32) -> Float32 { a + b }
fn mul32(a: Float32, b: Float32) -> Float32 { a * b }
fn neg32(a: Float32) -> Float32 { -a }
fn ordered32(a: Float32, b: Float32) -> Int32 {
    var bits: Int32 = 0
    if a == b { bits = bits + 1 }
    if a != b { bits = bits + 2 }
    if a < b { bits = bits + 4 }
    if a <= b { bits = bits + 8 }
    if a > b { bits = bits + 16 }
    if a >= b { bits = bits + 32 }
    bits
}

fn widen(v: Float32) -> Float64 { float64(v) }
fn narrow(v: Float64) -> Float32 { float32(v) }
fn from_int(n: Int32) -> Float64 { float64(n) }
fn from_int32(v: Int32) -> Float32 { float32(v) }

// Constant expressions must fold at the target precision.
fn folded64() -> Float64 { 0.1 + 0.2 }
fn folded32() -> Float32 { 0.1 + 0.2 }

fn literal_default() -> Float64 { 1.5e-3 }
fn literal_context() -> Float32 { 1.5e-3 }

fn neg_zero() -> Float64 { -0.0 }
fn infinity() -> Float64 { 1.0 / 0.0 }
fn neg_infinity() -> Float64 { -1.0 / 0.0 }
fn not_a_number() -> Float64 { 0.0 / 0.0 }
fn subnormal() -> Float64 { 5.0e-324 }
fn f32_max() -> Float32 { 3.4028235e38 }

fn identity<T>(value: T) -> T { value }

impl Float64 {
    const HALF: Float64 = 0.5
    const FOLDED: Float64 = 0.1 + 0.2
}

impl Float32 {
    const TINY: Float32 = 1.5e-3
}

fn aggregate() -> Int32 {
    let pair = Pair { x: 1.5 y: 2.5 }
    if pair.x != 1.5 { return 1 }
    if float64(pair.y) != 2.5 { return 2 }
    let dot = Shape.Dot(9.0)
    let from_dot = match dot {
        | Shape.Empty => 0.0
        | Shape.Dot(v) => v
        | Shape.Scale(v) => float64(v)
    }
    if from_dot != 9.0 { return 3 }
    let scale = Shape.Scale(0.25)
    let from_scale = match scale {
        | Shape.Empty => 0.0
        | Shape.Dot(v) => v
        | Shape.Scale(v) => float64(v)
    }
    if from_scale != 0.25 { return 4 }
    let point: Point = (1.25, 2.5)
    let (first, second) = point
    if first != 1.25 || float64(second) != 2.5 { return 5 }
    // Indirect calls go through a function value whose type must match exactly.
    if identity::<Float64>(7.5) != 7.5 { return 7 }
    if float64(identity::<Float32>(0.5)) != 0.5 { return 8 }
    0
}

// Signed zero is observable through division; NaN never compares equal.
fn semantics() -> Int32 {
    if neg_zero() != 0.0 { return 1 }
    if 1.0 / neg_zero() > 0.0 { return 2 }
    let inf = infinity()
    if inf < 0.0 { return 3 }
    if !(inf > 1.0e308) { return 4 }
    if neg_infinity() > 0.0 { return 5 }
    let nan = not_a_number()
    if nan == nan { return 6 }
    if !(nan != nan) { return 7 }
    if nan < 0.0 || nan > 0.0 || nan <= 0.0 || nan >= 0.0 { return 8 }
    if subnormal() <= 0.0 { return 9 }
    if float64(f32_max()) <= 0.0 { return 10 }
    0
}

fn conversions() -> Int32 {
    if from_int(-7) != -7.0 { return 1 }
    if from_int(2147483647) != 2147483647.0 { return 2 }
    if from_int32(255) != 255.0 { return 3 }
    if widen(1.5) != 1.5 { return 4 }
    if float64(narrow(1.5)) != 1.5 { return 5 }
    // Narrowing a finite overflow saturates to infinity, never negative.
    if float64(narrow(1.0e300)) < 0.0 { return 6 }
    if float64(narrow(-1.0e300)) > 0.0 { return 7 }
    if folded64() != 0.30000000000000004 { return 8 }
    if float64(folded32()) != 0.30000001192092896 { return 9 }
    if literal_default() != 1.5e-3 { return 10 }
    if float64(literal_context()) != 0.001500000013038516 { return 11 }
    // Associated constants fold at their declared precision.
    if Float64.HALF != 0.5 { return 12 }
    if Float64.FOLDED != 0.30000000000000004 { return 13 }
    if float64(Float32.TINY) != 0.001500000013038516 { return 14 }
    0
}

// Every entry below is called from the Rust test; `check` runs the composites.
fn check() -> Int32 {
    let a = semantics()
    if a != 0 { return a }
    let b = conversions()
    if b != 0 { return b }
    42
}

// `ordered*` returns a bitmask: 1 `==`, 2 `!=`, 4 `<`, 8 `<=`, 16 `>`, 32 `>=`.
fn ordering() -> Int32 {
    if ordered64(1.0, 2.0) != 14 { return 1 }
    if ordered64(2.0, 1.0) != 50 { return 2 }
    if ordered64(2.0, 2.0) != 41 { return 3 }
    // Signed zero compares equal: only `==`, `<=`, `>=` hold.
    if ordered64(0.0, neg_zero()) != 41 { return 4 }
    // NaN is unordered: `!=` alone holds.
    let nan = not_a_number()
    if ordered64(nan, 1.0) != 2 { return 5 }
    if ordered64(1.0, nan) != 2 { return 6 }
    if ordered32(1.5, 2.5) != 14 { return 7 }
    if ordered32(2.5, 2.5) != 41 { return 8 }
    if ordered32(2.5, 1.5) != 50 { return 9 }
    0
}

fn check_aggregate() -> Int32 { aggregate() }
fn check_ordering() -> Int32 { ordering() }

fn task64(v: Float64) @suspends -> Float64 { v * 0.5 }
fn task32(v: Float32) @suspends -> Float32 { v + 0.25 }

fn main() -> Int32 {
    let a = check()
    if a != 42 { return a }
    let b = check_aggregate()
    if b != 0 { return 100 + b }
    let c = check_ordering()
    if c != 0 { return 200 + c }
    42
}
