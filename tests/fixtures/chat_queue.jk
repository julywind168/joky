fn fixture_add_member(room: &mut Room, member: Member) { room.add_member(member) }
fn fixture_remove_member(room: &mut Room, id: UInt64) { room.remove_member(id) }
fn balance_view(state: &Account) -> UInt64 { state.balance_cents }
fn live_view(state: &Account) -> Bool { state.live }
fn room_name_view(state: &Account) -> Option<String> {
    match &state.room { Some(name) => Some(name.clone()), None => None }
}
fn account_view(state: &Account) -> Account {
    Account { member: state.member, live: state.live, room: room_name_view(state), balance_cents: state.balance_cents }
}
fn apply_account(state: &mut Account, account: Account) { var next=account; mem.swap(state,&mut next) }
fn set_room(state: &mut Account, room: String) { mem.replace(&mut state.room, Some(room)); }
// Test owners stay local, independently of the production owning directories.
struct Fixture { rooms: domain.Directory, accounts: domain.Directory, room: domain.Owner<Room>, other: domain.Owner<Room>, ctx: Host }
fn fixture() @suspends -> Fixture {
    let rooms = domain.directory(2)
    let accounts = domain.directory(4096)
    let room = domain.create(new_room, "r")
    let other = domain.create(new_room, "other")
    var config = Config.default()
    config.reclaim_empty = false
    let host = Host { config: config, rooms: rooms.handle(), accounts: accounts.handle() }
    let first = "r"
    let second = "other"
    host.rooms.insert_named(&first, room.handle())!
    host.rooms.insert_named(&second, other.handle())!
    Fixture { rooms: rooms, accounts: accounts, room: room, other: other, ctx: host }
}
fn room_handle(host: Host, name: &String) @suspends -> Option<domain.WriteHandle<Room>> {
    domain.lookup_named_write::<Room>(host.rooms, name)
}
fn fixture_room(host: Host, key: UInt64) @suspends -> Option<domain.WriteHandle<Room>> {
    if key == 0 { return None }
    let name = if key == 1 { "r" } else { "other" }
    room_handle(host, &name)
}
fn test_account(ctx: Host, id: UInt64, key: UInt64, output: session.Output) @suspends -> domain.Owner<Account> {
    let member = Member { id: id, output: output }
    let owner = domain.create(new_account, member)
    ctx.accounts.insert(id, owner.handle())!
    if key != 0 {
        let name = if key == 1 { "r" } else { "other" }
        domain.write_to(owner.handle(), set_room, name)!
        domain.write_to(fixture_room(ctx, key)!, fixture_add_member, member)!
    }
    owner
}
fn expect_message(queue: &mut outbox.Mailbox, expected: String) @suspends {
    let bytes = queue.receive()!
    let text = String.from_utf8(bytes)!
    check.assert(text.equals(&expected), "mailbox message and ordering")
}
fn balance(owner: &domain.Owner<Account>) @suspends -> UInt64 { domain.read_from(owner.read_handle(), balance_view)! }
fn unchanged(state: &mut Account, _: Unit) { state.balance_cents += 0 }
fn fund_capacity_test(state: &mut Account, _: Unit) { state.balance_cents = 10000 }
fn candidate(ctx: Host, account: domain.WriteHandle<Account>, text: String) @suspends -> domain.CandidateSet {
    let room = fixture_room(ctx, 1)!
    var access = domain.access_set(); access.include(account.read_only()); access.include(room.read_only())
    let snapshot = domain.snapshot_set(access)
    var value = domain.read_snapshot(&snapshot, account.read_only(), account_view)
    value.balance_cents -= 100
    var batch = outbox.batch(1, text.byte_length())
    outbox.stage(&mut batch, value.member.output, text.into_bytes())!
    domain.edit_snapshot(snapshot, account, apply_account, value).with_outbox(batch)
}
fn verify_conflicts_and_independence() @suspends {
    let f = fixture()
    let control = outbox.create(1, 0)
    var queue = outbox.create_with_policy(16, 1024, outbox.Overflow.Disconnect(control.handle()))
    let alice = test_account(f.ctx, 1, 1, queue.handle())
    let stale = candidate(f.ctx, alice.handle(), "ghost\n")
    domain.write_to(alice.handle(), unchanged, {})!
    var rejected = domain.commit_set(stale)
    check.assert(match rejected.wait() { Err(Conflict) => true, _ => false }, "stale debit and broadcast rejected together")
    check.assert(balance(&alice) == 500, "conflict never charges")
    let independent = candidate(f.ctx, alice.handle(), "independent\n")
    // Changing another room or directory cannot invalidate this send.
    domain.write_to(f.other.handle(), fixture_remove_member, 99)!
    let extra = domain.directory(1)
    let routes = extra.handle()
    let name = "independent"
    when (room: Room = routes.get_or_stage(name, new_room(name.clone()))) {}!
    var accepted = domain.commit_set(independent)
    accepted.wait()!
    check.assert(balance(&alice) == 400, "unrelated state writes do not conflict")
    expect_message(&mut queue, "independent\n")
}
fn paid_send(ctx: Host) @suspends { check.assert(handle_line(ctx, 1, "say concurrent"), "concurrent send handled") }
fn verify_balance_race() @suspends {
    let f = fixture()
    let control = outbox.create(1, 0)
    var queue = outbox.create_with_policy(16, 1024, outbox.Overflow.Disconnect(control.handle()))
    let alice = test_account(f.ctx, 1, 0, queue.handle())
    check.assert(handle_line(f.ctx, 1, "say outside"), "error is a handled command")
    expect_message(&mut queue, "error join a room first\n")
    check.assert(balance(&alice) == 500, "no-room send is free")
    check.assert(handle_line(f.ctx, 1, "join r"), "join")
    expect_message(&mut queue, "joined r 1\n")
    join { | paid_send(f.ctx) | paid_send(f.ctx) | paid_send(f.ctx) | paid_send(f.ctx) | paid_send(f.ctx) | paid_send(f.ctx) }
    var i: UInt64 = 0
    while i < 5 { expect_message(&mut queue, "message r 1 concurrent\n"); i += 1 }
    expect_message(&mut queue, "error insufficient balance\n")
    check.assert(balance(&alice) == 0, "six concurrent sends spend only five yuan")
    check.assert(handle_line(f.ctx, 1, "balance"), "query balance")
    expect_message(&mut queue, "balance 0\n")
}
fn verify_message_capacity() @suspends {
    let f = fixture()
    let alice_stop = outbox.create(1, 0)
    var alice_queue = outbox.create_with_policy(64, 65536, outbox.Overflow.Disconnect(alice_stop.handle()))
    var bob_stop = outbox.create(1, 0)
    var bob_queue = outbox.create_with_policy(64, 65536, outbox.Overflow.Disconnect(bob_stop.handle()))
    let carol_stop = outbox.create(1, 0)
    var carol_queue = outbox.create_with_policy(8, 256, outbox.Overflow.Disconnect(carol_stop.handle()))
    let alice = test_account(f.ctx, 1, 1, alice_queue.handle())
    let bob = test_account(f.ctx, 2, 1, bob_queue.handle())
    let carol = test_account(f.ctx, 3, 2, carol_queue.handle())
    domain.write_to(alice.handle(), fund_capacity_test, {})!
    var i: UInt64 = 0
    while i < 64 {
        check.assert(handle_line(f.ctx, 1, "say fill"), "fill slow target")
        expect_message(&mut alice_queue, "message r 1 fill\n")
        i += 1
    }
    check.assert(handle_line(f.ctx, 1, "say retry"), "overflow does not require replay")
    expect_message(&mut alice_queue, "message r 1 retry\n")
    forget(Client { host: f.ctx, id: 2 })
    expect_message(&mut alice_queue, "left r 2\n")
    check.assert(balance(&alice) == 3500, "overflowing send charges once")
    check.assert(bob_stop.receive().is_none(), "evicted session wakes")
    check.assert(bob_queue.receive().is_none(), "evicted output closes")
    check.assert(!domain.read_from(bob.read_handle(), live_view)!, "evicted account inactive")
    check.assert(handle_line(f.ctx, 3, "say alive"), "unrelated room survives")
    expect_message(&mut carol_queue, "message other 3 alive\n")
    check.assert(balance(&carol) == 400, "other account pays independently")
}
fn verify_byte_capacity() @suspends {
    let f = fixture()
    let alice_stop = outbox.create(1, 0)
    var alice_queue = outbox.create_with_policy(64, 65536, outbox.Overflow.Disconnect(alice_stop.handle()))
    var slow_stop = outbox.create(1, 0)
    var slow_queue = outbox.create_with_policy(64, 65536, outbox.Overflow.Disconnect(slow_stop.handle()))
    let alice = test_account(f.ctx, 1, 1, alice_queue.handle())
    let slow = test_account(f.ctx, 2, 1, slow_queue.handle())
    domain.write_to(alice.handle(), fund_capacity_test, {})!
    var builder = StringBuilder.new()
    var i: UInt64 = 0
    while i < 4091 { builder.push('x'); i += 1 }
    let payload = builder.finish()
    let expected = "message r 1 {payload}\n"
    let count = 65536 / expected.byte_length()
    i = 0
    while i < count {
        check.assert(handle_line(f.ctx, 1, "say {payload}"), "fill byte budget")
        expect_message(&mut alice_queue, expected.clone())
        i += 1
    }
    check.assert(handle_line(f.ctx, 1, "say {payload}"), "byte overflow commits")
    expect_message(&mut alice_queue, expected.clone())
    forget(Client { host: f.ctx, id: 2 })
    expect_message(&mut alice_queue, "left r 2\n")
    check.assert(balance(&alice) == 10000 - (count + 1) * 100, "byte overflow charges once")
    check.assert(slow_stop.receive().is_none() && slow_queue.receive().is_none(), "byte overload closes session")
    check.assert(balance(&slow) == 500, "recipient never pays")
}
fn verify_simultaneous_capacity() @suspends {
    let f = fixture()
    var alice_stop = outbox.create(1, 0)
    var alice_queue = outbox.create_with_policy(2, 128, outbox.Overflow.Disconnect(alice_stop.handle()))
    var bob_stop = outbox.create(1, 0)
    var bob_queue = outbox.create_with_policy(2, 128, outbox.Overflow.Disconnect(bob_stop.handle()))
    let alice = test_account(f.ctx, 1, 1, alice_queue.handle())
    let bob = test_account(f.ctx, 2, 1, bob_queue.handle())
    check.assert(handle_line(f.ctx, 1, "say full"), "first queued send")
    check.assert(handle_line(f.ctx, 1, "say full"), "second queued send")
    forget(Client { host: f.ctx, id: 1 })
    forget(Client { host: f.ctx, id: 1 })
    check.assert(domain.lookup_write::<Account>(f.ctx.accounts, 1).is_none(), "forgetting is idempotent")
    check.assert(alice_stop.receive().is_none() && bob_stop.receive().is_none(), "both sessions wake")
    check.assert(alice_queue.receive().is_none() && bob_queue.receive().is_none(), "both queues close")
    check.assert(balance(&alice) == 300 && balance(&bob) == 500, "disconnect is free")
}
fn verify_atomic_overflow_signal() @suspends {
    let f = fixture()
    var control = outbox.create(1, 0)
    var output = outbox.create_with_policy(1, 1, outbox.Overflow.Disconnect(control.handle()))
    let alice = test_account(f.ctx, 1, 1, output.handle())
    let text = "overflow"
    say(f.ctx, alice.handle(), text)!
    // No apply_command or post-commit close ran: publication closes the signal.
    check.assert(control.receive().is_none(), "overflow closes the independent signal at commit")
    check.assert(output.receive().is_none(), "oversized target batch is wholly discarded")
    check.assert(balance(&alice) == 400, "overflow still commits the debit")
    forget(Client { host: f.ctx, id: 1 })
    check.assert(!domain.query_from(f.room.read_handle(), member_value, 1)!, "cleanup removes membership")
}
fn verify_closed_output() @suspends {
    let f = fixture()
    let stop = outbox.create(1, 0)
    var queue = outbox.create_with_policy(4, 256, outbox.Overflow.Disconnect(stop.handle()))
    var closed_stop = outbox.create(1, 0)
    let closed = outbox.create_with_policy(4, 256, outbox.Overflow.Disconnect(closed_stop.handle()))
    let alice = test_account(f.ctx, 1, 1, queue.handle())
    let bob = test_account(f.ctx, 2, 1, closed.handle())
    outbox.close(closed.handle())
    check.assert(handle_line(f.ctx, 1, "say retry"), "closed target does not reject commit")
    expect_message(&mut queue, "message r 1 retry\n")
    forget(Client { host: f.ctx, id: 2 })
    expect_message(&mut queue, "left r 2\n")
    check.assert(closed_stop.receive().is_none(), "closed output signals session")
    check.assert(balance(&alice) == 400 && balance(&bob) == 500, "closed target never causes replay")
}
fn verify_wide_broadcast() @suspends {
    let f = fixture()
    let control = outbox.create(1, 0)
    var queues = Array.new::<outbox.Mailbox>()
    var accounts = Array.new::<domain.Owner<Account>>()
    var i: UInt64 = 0
    while i < 260 {
        let queue = outbox.create_with_policy(2, 128, outbox.Overflow.Disconnect(control.handle()))
        accounts.push(test_account(f.ctx, i + 1, 1, queue.handle()))
        queues.push(queue)
        i += 1
    }
    check.assert(handle_line(f.ctx, 1, "say beyond256"), "wide broadcast committed")
    while !queues.is_empty() {
        var queue = queues.pop()!
        expect_message(&mut queue, "message r 1 beyond256\n")
    }
    let alice = domain.lookup_write::<Account>(f.ctx.accounts, 1)!
    check.assert(domain.read_from(alice.read_only(), balance_view)! == 400, "wide broadcast costs one yuan")
}
fn verify_room_resolution_changes_before_operation() @suspends {
    let f = fixture()
    let control = outbox.create(1, 0)
    var queue = outbox.create_with_policy(8, 1024, outbox.Overflow.Disconnect(control.handle()))
    let alice = test_account(f.ctx, 1, 1, queue.handle())
    check.assert(handle_line(f.ctx, 1, "join other"), "concurrent room change")
    expect_message(&mut queue, "left r 1\n")
    expect_message(&mut queue, "joined other 1\n")
    let text = "stale"
    say(f.ctx, alice.handle(), text)!
    expect_message(&mut queue, "message other 1 stale\n")
    check.assert(balance(&alice) == 400, "dynamic path resolves current room and charges once")
    check.assert(handle_line(f.ctx, 1, "say resolved"), "resolve current membership")
    expect_message(&mut queue, "message other 1 resolved\n")
    check.assert(balance(&alice) == 300, "each dynamic operation charges exactly once")
}
fn verify_chat_queue_domain() @suspends {
    verify_move_rollback()
    verify_retired_rooms_and_cleanup_budget()
    verify_unavailable_control_eviction()
    verify_room_resolution_changes_before_operation()
    verify_conflicts_and_independence()
    verify_balance_race()
    verify_message_capacity()
    verify_byte_capacity()
    verify_simultaneous_capacity()
    verify_closed_output()
    verify_atomic_overflow_signal()
    verify_wide_broadcast()
}

fn verify_retired_rooms_and_cleanup_budget() @suspends {
    let f = fixture()
    var host = f.ctx
    host.config.reclaim_empty = true
    let ctx = host
    let stop = outbox.create(1, 0)
    var queue = outbox.create_with_policy(8, 1024, outbox.Overflow.Disconnect(stop.handle()))
    let alice = test_account(ctx, 1, 1, queue.handle())
    check.assert(handle_line(ctx, 1, "leave"), "leave before reclaim")
    expect_message(&mut queue, "left r 1\n")
    check.assert(fixture_room(ctx, 1).is_none(), "empty root removed from directory")
    let old = f.room.handle()
    check.assert(handle_line(ctx, 1, "join r"), "create replacement in the join transaction")
    expect_message(&mut queue, "joined r 1\n")
    let name = "r"
    check.assert(!host.rooms.remove_named(&name, old.read_only()), "old cleanup cannot delete a replacement")
    let bob_stop = outbox.create(1, 0)
    let bob_queue = outbox.create_with_policy(1, 64, outbox.Overflow.Disconnect(bob_stop.handle()))
    let bob = test_account(ctx, 2, 1, bob_queue.handle())
    check.assert(handle_line(ctx, 2, "balance"), "fill another recipient")
    forget(Client { host: host, id: 1 })
    check.assert(!domain.read_from(alice.read_handle(), live_view)!, "full recipient does not block departure")
    let room = fixture_room(ctx, 1)!
    check.assert(!domain.query_from(room.read_only(), member_value, 1).unwrap_or(true), "failed connection leaves no membership")
    check.assert(domain.read_from(bob.read_handle(), live_view)!, "unrelated account stays alive")
    let other_name = "other"
    check.assert(domain.remove_named_if(host.rooms, &other_name, empty)!, "conditional deletion frees directory capacity")
    let carol_stop = outbox.create(1, 0)
    var carol_queue = outbox.create_with_policy(4, 256, outbox.Overflow.Disconnect(carol_stop.handle()))
    let carol = test_account(ctx, 3, 0, carol_queue.handle())
    check.assert(handle_line(ctx, 3, "join fresh"), "room creation needs no manager or waiter")
    expect_message(&mut carol_queue, "joined fresh 3\n")
    let name = "fresh"
    let fresh = room_handle(ctx, &name)!
    check.assert(!domain.remove_named_if(host.rooms, &name, empty)!, "occupied rooms survive conditional deletion")
    let denied = "third"
    match join(ctx, carol.handle(), denied) { Failed(DirectoryFull(_)) => {}, _ => check.assert(false, "directory capacity rejects before departure") }
    check.assert(domain.query_from(fresh.read_only(), member_value, 3)!, "failed creation preserves old membership")
}

fn member_value(room: &Room, id: UInt64) -> Bool { room.has_member(id) }

fn verify_unavailable_control_eviction() @suspends {
    let f = fixture()
    let stop = outbox.create(1, 0)
    var output = outbox.create_with_policy(8, 1024, outbox.Overflow.Disconnect(stop.handle()))
    let slow_stop = outbox.create(1, 0)
    let slow_output = outbox.create_with_policy(1, 64, outbox.Overflow.Disconnect(slow_stop.handle()))
    let alice = test_account(f.ctx, 1, 1, output.handle())
    let bob = test_account(f.ctx, 2, 1, slow_output.handle())
    check.assert(handle_line(f.ctx, 2, "balance"), "fill slow queue")
    outbox.close(slow_stop.handle())
    check.assert(handle_line(f.ctx, 1, "say after-cleanup"), "closed control does not reject healthy delivery")
    expect_message(&mut output, "message r 1 after-cleanup\n")
    check.assert(balance(&alice) == 400, "send charges once before cleanup")
    forget(Client { host: f.ctx, id: 2 })
    check.assert(!domain.read_from(bob.read_handle(), live_view)!, "session cleanup removes recipient")
}

fn retire_test_room(room: &mut Room, _: Unit) { mem.replace(&mut room.name, "retired"); }
fn verify_move_rollback() @suspends {
    let f = fixture()
    let stop = outbox.create(1, 0)
    var output = outbox.create_with_policy(8, 1024, outbox.Overflow.Disconnect(stop.handle()))
    let next_stop = outbox.create(1, 0)
    var next_output = outbox.create_with_policy(1, 128, outbox.Overflow.Disconnect(next_stop.handle()))
    let alice = test_account(f.ctx, 1, 1, output.handle())
    let bob = test_account(f.ctx, 2, 2, next_output.handle())
    check.assert(handle_line(f.ctx, 2, "balance"), "fill destination queue")
    let name = "other"
    domain.write_to(f.other.handle(), retire_test_room, {})!
    match join(f.ctx, alice.handle(), name) {
        Rejected(Stale) => {}, _ => { check.assert(false, "retired destination rejects after preparing departure") }
    }
    check.assert(domain.read_from(alice.read_handle(), room_name_view)!!.equals("r"), "failed moves preserve account room")
    check.assert(domain.query_from(f.room.read_handle(), member_value, 1)!, "failed moves preserve old membership")
    check.assert(!domain.query_from(f.other.read_handle(), member_value, 1)!, "failed moves never add destination membership")
    check.assert(balance(&alice) == 500 && balance(&bob) == 500, "failed moves do not charge")
    check.assert(handle_line(f.ctx, 1, "balance"), "sentinel after rejected moves")
    expect_message(&mut output, "balance 5\n")
    expect_message(&mut next_output, "balance 5\n")
    check.assert(handle_line(f.ctx, 2, "balance"), "sentinel after rejected arrival")
    expect_message(&mut next_output, "balance 5\n")
}
