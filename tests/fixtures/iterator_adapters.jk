import joky/task
import joky/iter.{type Iterator, type IntoIterator, enumerate}
import joky/option.{type Option, Some, None}
import joky/array.{type Array}
import joky/check.{assert}
import joky/string.{type StringBuilder}
extern fn record(x: Int32) -> Int32
fn expect(ok: Bool) { assert(ok, "Iterator adapter mismatch") }

// Would resume after None unless the adapter remembers exhaustion.
struct Source { position: Int32, end: Int32, tag: Int32 }
impl Iterator for Source {
    type Item = Int32
    fn next(&mut self) -> Option<Int32> {
        record(self.tag)
        self.position += 1
        if self.position == self.end { None } else { Some(self.position) }
    }
}
struct Input { tag: Int32 }
impl IntoIterator for Input {
    type IntoIter = Source
    fn into_iter(self) -> Source {
        record(self.tag)
        Source { position: 0, end: 3, tag: self.tag + 10 }
    }
}
fn twice(x: Int32) -> Int32 { x * 2 }
fn even(x: &Int32) @noescape -> Bool { *x % 2 == 0 }
fn sum<I: IntoIterator>(input: I) -> Int32 {
    var n = 0
    for _ in input { n += 1 }
    n
}
fn compute() -> Int32 {
    expect(iter.count(0..0) == 0)
    expect(iter.count(iter.filter(0..5, even)) == 3)
    expect(iter.fold(1..4, 0, |acc, value| { acc * 10 + value }) == 123)
    expect(iter.fold(0..0, 42, |acc, value| { assert(false, "empty fold"); acc }) == 42)
    var calls = 0
    expect(iter.fold([1, 2, 3], 0, |acc, value| { calls += 1; acc + value }) == 6)
    expect(calls == 3)
    let built = iter.fold(["a", "中", "🙂"], StringBuilder.new(), |var acc, value| { acc.push_str(&value); acc })
    let text = built.finish()
    expect(text == "a中🙂")
    let zero = iter.take(0..10, 0)
    expect(sum(zero) == 0)
    expect(sum(iter.take(0..2, 18446744073709551615)) == 2)
    expect(sum(iter.skip(0..2, 0)) == 2)
    expect(sum(iter.skip(0..0, 1)) == 0)
    expect(iter.fold(iter.skip([1, 2, 3, 4], 2), 0, |acc, value| { acc * 10 + value }) == 34)
    expect(iter.count(enumerate(0..0)) == 0)
    let numbered = enumerate([owned(20), owned(21)])
    let total = iter.fold(numbered, 0, |acc, entry| {
        let (index, value) = entry
        acc + int32(index) + value.id
    })
    expect(total == 42)
    expect(iter.fold(iter.chain(1..3, [3, 4]), 0, |acc, value| { acc * 10 + value }) == 1234)
    expect(iter.fold(iter.chain(0..0, [42]), 0, |acc, value| { acc + value }) == 42)
    expect(iter.fold(iter.chain([42], 0..0), 0, |acc, value| { acc + value }) == 42)
    expect(sum(iter.zip(0..0, 0..3)) == 0)
    expect(sum(iter.zip(0..3, 0..0)) == 0)
    expect(sum(iter.filter(0..3, move |x| { *x > 10 })) == 0)
    expect(sum(iter.map(0..0, move |x| { x + 1 })) == 0)
    let mapped = iter.map([1, 2, 3, 4, 5], twice)
    let filtered = iter.filter(mapped, even)
    var result = 0
    for index, (left, right) in iter.zip(iter.take(filtered, 3), 10..20) {
        result += left + right - index
    }
    expect(result == 42)
    var offset = 0
    let stateful = iter.map(0..3, move |x| { offset += 1; x + offset })
    var total = 0
    for value in stateful { total += value }
    expect(total == 9)
    var calls = 0
    let selected = iter.filter(0..5, move |x| { calls += 1; calls == *x + 1 && calls % 2 == 1 })
    expect(sum(selected) == 3)
    42
}
fn lazy() {
    let unused = iter.map(Input { tag: 1 }, move |x| { record(x) })
    let zero = iter.take(Input { tag: 2 }, 0)
    expect(sum(zero) == 0)
    var zipped = iter.zip(Input { tag: 3 }, Input { tag: 4 })
    expect(iter.next(&mut zipped).is_some())
    expect(iter.next(&mut zipped).is_some())
    expect(iter.next(&mut zipped).is_none())
    expect(iter.next(&mut zipped).is_none())
    var short_right = iter.zip(Source { position: 0, end: 5, tag: 20 }, Source { position: 0, end: 1, tag: 21 })
    expect(iter.next(&mut short_right).is_none())
    expect(iter.next(&mut short_right).is_none())
    var mapped = iter.map(Source { position: 0, end: 1, tag: 30 }, move |x| { record(x) })
    expect(iter.next(&mut mapped).is_none())
    expect(iter.next(&mut mapped).is_none())
    var filtered = iter.filter(Source { position: 0, end: 1, tag: 31 }, move |x| { record(*x); true })
    expect(iter.next(&mut filtered).is_none())
    expect(iter.next(&mut filtered).is_none())
    var taken = iter.take(Source { position: 0, end: 1, tag: 32 }, 10)
    expect(iter.next(&mut taken).is_none())
    expect(iter.next(&mut taken).is_none())
    let unused_skip = iter.skip(Input { tag: 5 }, 1)
    var skipped = iter.skip(Source { position: 0, end: 3, tag: 33 }, 1)
    expect(iter.next(&mut skipped)! == 2)
    expect(iter.next(&mut skipped).is_none())
    expect(iter.next(&mut skipped).is_none())
    var overskipped = iter.skip(Source { position: 0, end: 1, tag: 34 }, 18446744073709551615)
    expect(iter.next(&mut overskipped).is_none())
    expect(iter.next(&mut overskipped).is_none())
    let unused_enumerate = enumerate(Input { tag: 6 })
    var numbered = enumerate(Source { position: 0, end: 2, tag: 35 })
    let (index, value) = iter.next(&mut numbered)!
    expect(index == 0 && value == 1)
    expect(iter.next(&mut numbered).is_none())
    expect(iter.next(&mut numbered).is_none())
    let unused_chain = iter.chain(Input { tag: 7 }, Input { tag: 8 })
    var chained = iter.chain(Source { position: 0, end: 2, tag: 36 }, Source { position: 3, end: 5, tag: 37 })
    expect(iter.next(&mut chained)! == 1)
    expect(iter.next(&mut chained)! == 4)
    expect(iter.next(&mut chained).is_none())
    expect(iter.next(&mut chained).is_none())
}
struct Owned { id: Int32, values: Array<Int32> }

fn owned(id: Int32) -> Owned { Owned { id, values: [id] } }
fn cleanup() {
    let capture = owned(9)
    let mapped = iter.map([owned(1), owned(2), owned(3)], move |value| {
        expect(capture.id == 9)
        value
    })
    let selected = iter.filter(mapped, move |value| { value.id != 1 })
    for value in iter.take(selected, 1) { expect(value.id == 2) }
}
fn terminal_cleanup() {
    expect(iter.count([owned(1), owned(2)]) == 2)
    let result = iter.fold([owned(3), owned(4)], owned(9), |acc, value| { value })
    expect(result.id == 4)
}
fn fail_fold() {
    let capture = owned(9)
    iter.fold([owned(1), owned(2)], 0, move |acc, value| {
        expect(capture.id == 9)
        assert(false, "Fold callback failure")
        acc + value.id
    });
}
fn zip_cleanup() {
    for _ in iter.zip([owned(1), owned(2)], [owned(3)]) {}
}
fn fail_map() {
    let capture = owned(9)
    let mapped = iter.map([owned(1), owned(2), owned(3)], move |value| {
        expect(capture.id == 9)
        assert(value.id != 2, "Map callback failure")
        value
    })
    for _ in iter.skip(iter.chain(mapped, [owned(4)]), 2) {}
}
fn fail_filter() {
    let capture = owned(9)
    for _ in iter.filter([owned(1), owned(2)], move |value| {
        expect(capture.id == 9 && value.id > 0)
        assert(false, "Filter callback failure")
        true
    }) {}
}
fn early() -> Int32 {
    let capture = owned(9)
    let mapped = iter.map([owned(0), owned(1), owned(2)], move |value| { expect(capture.id == 9); value })
    for (index, value) in enumerate(iter.skip(iter.chain(mapped, [owned(3)]), 1)) {
        expect(index == 0)
        return value.id
    }
    0
}
fn pending() @suspends -> Int32 {
    let source = iter.chain([owned(0), owned(1)], [owned(2)])
    let left = enumerate(iter.skip(source, 1))
    for ((index, left), right) in iter.zip(iter.take(left, 2), [owned(3), owned(4)]) {
        expect(int32(index) + 1 == left.id)
        record(left.id + right.id + 10)
        task.yield_now()
    }
    42
}
fn sync_pending() @suspends -> Int32 { cleanup(); 42 }
fn terminal_pending() @suspends -> Int32 { terminal_cleanup(); 42 }
struct Counter { value: Int32 }
struct Mixed { counter: Counter, items: Array<Int32> }
fn field(mixed: &Mixed) -> &Int32 { &mixed.counter.value }
fn bump(counter: &mut Counter) { *(&mut counter.value) += 1 }
fn fields() -> Int32 {
    var mixed = Mixed { counter: Counter { value: 40 }, items: [1] }
    bump(&mut mixed.counter)
    let value = &mut mixed.counter.value
    *value += 1
    let stored = alloc(Counter { value: 0 })
    let projected = &mut stored.value
    *projected = 1
    *field(&mixed) + *(&stored.value) - 1
}
