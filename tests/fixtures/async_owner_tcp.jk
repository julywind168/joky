import joky/tcp.{type Address, type TcpListener, type TcpStream, type Shutdown}
import joky/array.{type Array}
import joky/check.{assert}
import joky/integer
import joky/mem

struct BufferedStream { stream: TcpStream, bytes: Array<UInt8>, offset: UInt64 }
impl BufferedStream {
    fn next(&mut self) @suspends -> Int32 {
        if self.offset == self.bytes.len() {
            let bytes = match self.stream.read(2) {
                Ok(bytes) => bytes
                Err(error) => { return -2 }
            }
            mem.replace(&mut self.bytes, bytes);
            self.offset = 0
            if self.bytes.len() == 0 { return -1 }
        }
        let byte = self.bytes.get(self.offset).unwrap_or(0)
        self.offset = self.offset + 1
        byte.to_i32().unwrap_or(-2)
    }
}
fn send(address: Address) @suspends {
    var stream = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { return } }
    var bytes = Array.new::<UInt8>()
    bytes.push(10)
    bytes.push(12)
    bytes.push(20)
    stream.write_all(bytes);
    stream.shutdown(Shutdown.Write);
}
fn receive(listener: &mut TcpListener) @suspends {
    let stream = match listener.accept() { Ok(stream) => stream, Err(error) => { return } }
    var buffered = BufferedStream { stream: stream, bytes: Array.new::<UInt8>(), offset: 0 }
    let first = buffered.next()
    let second = buffered.next()
    let third = buffered.next()
    let end = buffered.next()
    let message = "buffered receiver retains fields through real TCP suspension"
    assert(first == 10 && second == 12 && third == 20 && end == -1, &message)
}
fn main() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return 1 } }
    let address = match listener.local_addr() { Ok(address) => address, Err(error) => { return 2 } }
    parallel { | receive(&mut listener) | send(address) }
    0
}
