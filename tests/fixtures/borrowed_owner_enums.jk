import joky/task
extern fn record_drop(id: Int32)
struct Failure { id: Int32, message: String }

fn lookup(text: &String, found: Bool, id: Int32) -> Result<&String, Failure> {
    if found { Ok(text) } else { Err(Failure { id, message: "owned decoding failure with a long message" }) }
}
fn forward(text: &String, found: Bool, id: Int32) -> Result<&String, Failure> {
    Ok(lookup(text, found, id)?)
}
fn identity<T>(value: T) -> T { value }
fn relay(value: Result<&String, Failure>) @suspends -> Result<&String, Failure> {
    task.yield_now()
    value
}
fn mapped(text: &String) -> Result<&String, String> {
    let value: Result<&String, Int32> = Ok(text)
    Ok(value.map_err(| code | { code.to_string() })?)
}
fn unwrap_borrow(value: Result<&String, Failure>) -> &String {
    match value { Ok(text) => text, Err(_) => panic("unexpected error") }
}
struct Envelope { value: Result<&String, Failure>, count: Int32 }
fn nested(text: &String) -> Option<Envelope> {
    Some(Envelope { value: forward(text, true, 0), count: 42 })
}
fn consume(value: Result<&String, Failure>) @suspends -> Int32 {
    task.yield_now()
    match value {
        Ok(text) => { assert(text.byte_length() > 20, "borrow survives call"); 42 },
        Err(error) => { assert(!error.message.is_empty(), "owning error survives call"); 42 }
    }
}
fn exercise() @suspends -> Int32 {
    let text = "original string with independent owning storage"
    assert(mapped(&text)! == text, "map_err keeps the success borrow")
    let result = relay(identity(forward(&text, true, 0)))
    assert(result.is_ok(), "shared match does not move the result")
    task.yield_now()
    let borrowed = unwrap_borrow(result)
    assert(borrowed == text, "consuming result keeps external borrow")
    let alias = forward(&text, true, 0)
    let packed = nested(&text)!
    task.yield_now()
    let Envelope { value, count } = packed
    assert(count == 42 && unwrap_borrow(value) == text, "nested aggregate preserves provenance")
    assert(unwrap_borrow(alias) == text, "shared alias survives destructuring")
    var replaced = forward(&text, false, 1)
    task.yield_now()
    replaced = forward(&text, true, 0)
    assert(consume(replaced) == 42, "assignment drops only the owning branch")
    assert(consume(forward(&text, false, 2)) == 42, "error propagation and cleanup")
    let values: Array<Int32> = [42]
    let view: Result<&Array<Int32>, String> = Ok(&values)
    task.yield_now()
    assert(match view { Ok(array) => array[0] == 42, Err(_) => false }, "borrowed array is not released")
    42
}
fn main() @suspends { assert(exercise() == 42, "mixed enum") }
