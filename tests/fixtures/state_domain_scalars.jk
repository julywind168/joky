struct StateUInt64 { value: UInt64 }
fn make_uint64(value: UInt64) -> StateUInt64 { StateUInt64 { value: value } }
fn get_uint64(state: &StateUInt64) -> UInt64 { state.value }
fn put_uint64(state: &mut StateUInt64, value: UInt64) -> UInt64 { state.value = value state.value }
fn work_uint64(value: UInt64) @suspends -> UInt64 { domain.write(put_uint64, value) task.yield_now() domain.read(get_uint64) }
fn test_uint64() @suspends {
    let low: UInt64 = 0
    let high: UInt64 = 18446744073709551615
    let owner = domain.create(make_uint64, low)
    let handle = owner.handle()
    let initial = domain.read_from(handle.read_only(), get_uint64)
    require(initial == low)
    let changed = domain.write_to(handle, put_uint64, high)
    require(changed == high)
    let previous_sentinel = domain.request(handle, echo::<UInt64>, 4294967297).unwrap_or(0)
    require(previous_sentinel == 4294967297)
    let result = domain.request(handle, work_uint64, low).unwrap_or(high)
    require(result == low)
    let echoed = domain.request_read(handle.read_only(), echo::<UInt64>, high).unwrap_or(low)
    require(echoed == high)
    let stored = domain.read_from(handle.read_only(), get_uint64)
    require(stored == low)
    owner.close()
}

struct StateFloat32 { value: Float32 }
fn make_float32(value: Float32) -> StateFloat32 { StateFloat32 { value: value } }
fn get_float32(state: &StateFloat32) -> Float32 { state.value }
fn put_float32(state: &mut StateFloat32, value: Float32) -> Float32 { state.value = value state.value }
fn work_float32(value: Float32) @suspends -> Float32 { domain.write(put_float32, value) task.yield_now() domain.read(get_float32) }
fn test_float32() @suspends {
    let low: Float32 = Float32.from_bits(2147483648)
    let high: Float32 = Float32.from_bits(2143289410)
    let owner = domain.create(make_float32, low)
    let handle = owner.handle()
    let initial = domain.read_from(handle.read_only(), get_float32)
    require(initial.to_bits() == low.to_bits())
    let changed = domain.write_to(handle, put_float32, high)
    require(changed.to_bits() == high.to_bits())
    let result = domain.request(handle, work_float32, low).unwrap_or(high)
    require(result.to_bits() == low.to_bits())
    let echoed = domain.request_read(handle.read_only(), echo::<Float32>, high).unwrap_or(low)
    require(echoed.to_bits() == high.to_bits())
    let stored = domain.read_from(handle.read_only(), get_float32)
    require(stored.to_bits() == low.to_bits())
    owner.close()
}

