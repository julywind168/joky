    let result = domain.request(handle, work_bool, low).unwrap_or(high)
    require(result == low)
    let echoed = domain.request_read(handle.read_only(), echo::<Bool>, high).unwrap_or(low)
    require(echoed == high)
    let stored = domain.read_from(handle.read_only(), get_bool)
    require(stored == low)
    owner.close()
}

struct StateRune { value: Rune }
fn make_rune(value: Rune) -> StateRune { StateRune { value: value } }
fn get_rune(state: &StateRune) -> Rune { state.value }
fn put_rune(state: &mut StateRune, value: Rune) -> Rune { state.value = value state.value }
fn work_rune(value: Rune) @suspends -> Rune { domain.write(put_rune, value) task.yield_now() domain.read(get_rune) }
fn test_rune() @suspends {
    let low: Rune = '中'
    let high: Rune = '🙂'
    let owner = domain.create(make_rune, low)
    let handle = owner.handle()
    let initial = domain.read_from(handle.read_only(), get_rune)
    require(initial == low)
    let changed = domain.write_to(handle, put_rune, high)
    require(changed == high)
    let result = domain.request(handle, work_rune, low).unwrap_or(high)
    require(result == low)
    let echoed = domain.request_read(handle.read_only(), echo::<Rune>, high).unwrap_or(low)
    require(echoed == high)
    let stored = domain.read_from(handle.read_only(), get_rune)
    require(stored == low)
    owner.close()
}

struct Marker { value: Int32 }
fn relay<T>(handle: domain.WriteHandle<Marker>, value: T) @suspends -> Result<T, domain.RequestError> {
    domain.request(handle, echo::<T>, value)
}
fn make_unit(input: Unit) -> Marker { Marker { value: 1 } }
fn read_unit(state: &Marker) {}
fn write_unit(state: &mut Marker, input: Unit) { state.value = 2 }
fn work_unit(input: Unit) @suspends { domain.write(write_unit, input) domain.read(read_unit) }
fn test_unit() @suspends {
    var evaluations = 0
    let owner = domain.create(make_unit, { evaluations = evaluations + 1 })
    let handle = owner.handle()
    domain.read_from(handle.read_only(), read_unit)
    domain.write_to(handle, write_unit, { evaluations = evaluations + 1 })
    require(domain.request(handle, work_unit, { evaluations = evaluations + 1 }).is_ok())
    require(domain.request_read(handle.read_only(), echo::<Unit>, {}).is_ok())
    require(relay(handle, true).unwrap_or(false))
    require(evaluations == 3)
    owner.close()
}
fn lifecycle() @suspends -> Int32 {
    test_uint64()
    test_float64()
    test_unit()
    24
}
fn main() @suspends {
    test_int8()
    test_int16()
    test_int32()
    test_int64()
    test_uint8()
    test_uint16()
    test_uint32()
    test_uint64()
    test_float32()
    test_float64()
    test_bool()
    test_rune()
    test_unit()
    println("scalar domains ok")
}
