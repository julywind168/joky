fn test_bool() @suspends {
    let low: Bool = false
    let high: Bool = true
    let owner = domain.create(make_bool, low)
    let handle = owner.handle()
    let initial = domain.read_from(handle.read_only(), get_bool)
    require(initial == low)
    let changed = domain.write_to(handle, put_bool, high)
