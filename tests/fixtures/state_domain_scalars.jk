import joky/domain
import joky/task
import joky/check

fn require(condition: Bool) { let message = "scalar domain round trip" check.require(condition, &message) }
fn echo<T>(value: T) @suspends -> T { task.yield_now() value }

struct StateInt8 { value: Int8 }
fn make_int8(value: Int8) -> StateInt8 { StateInt8 { value: value } }
fn get_int8(state: &StateInt8) -> Int8 { state.value }
fn put_int8(state: &mut StateInt8, value: Int8) -> Int8 { state.value = value state.value }
fn work_int8(value: Int8) @suspends -> Int8 { domain.write(put_int8, value) task.yield_now() domain.read(get_int8) }
fn test_int8() @suspends {
    let low: Int8 = -128
    let high: Int8 = 127
    let owner = domain.create(make_int8, low)
    let handle = owner.handle()
    let initial = domain.read_from(handle.read_only(), get_int8)
    require(initial == low)
    let changed = domain.write_to(handle, put_int8, high)
    require(changed == high)
    let result = domain.request(handle, work_int8, low).unwrap_or(high)
    require(result == low)
    let echoed = domain.request_read(handle.read_only(), echo::<Int8>, high).unwrap_or(low)
    require(echoed == high)
    let stored = domain.read_from(handle.read_only(), get_int8)
    require(stored == low)
    owner.close()
}

