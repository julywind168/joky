import joky/check
import joky/domain
import joky/mem
import joky/outbox
import joky/array.{type Array}

fn assert(ok:Bool) { check.assert(ok,"when") }

#state
struct State { n:Int32, text:String, values:Array<Int32> }
struct Input { n:Int32 }
struct Output { first:Int32, second:Int32 }
enum Decision { Rejected }
fn make(n:Int32)->State {
    var values=Array.new::<Int32>()
    values.push(n)
    State{n:n,text:"state",values:values}
}
impl State {
    fn add(&mut self, a:Int32, b:Input)->Int32 {self.n+=a+b.n; self.n}
    fn value(&self)->Int32 {self.n}
    fn reject(&mut self)->Result<String,String> {
        self.n=99
        var replacement="rejected"
        mem.swap(&mut self.text,&mut replacement)
        self.values.push(99)
        Err("denied")
    }
    fn read_only(&self)->Int32 {self.n}
}
fn when(n:Int32)->Int32 {n}
fn lifecycle() @suspends ->Int32 {
    let a=domain.create(make,1)
    let b=domain.create(make,2)
    let c=domain.create(make,3)
    let x=a.handle()
    let y=b.handle()
    let z=c.read_handle()
    var amount=4
    let extra=Input{n:2}
    let result=when "transfer" (mut x,mut y,z) {
        amount+=extra.n
        mem.swap(&mut x.text,&mut y.text)
        mem.swap(&mut x.values,&mut y.values)
        x.n+=amount
        y.n+=z.n
        Output{first:x.n,second:y.n}
    }
    assert(amount==4)
    match result {Ok(r)=>{assert(r.first==7 && r.second==5)},Err(_)=>{assert(false)}}
    let same=x.read_only()
    assert(when (x) {x.read_only()}.unwrap()==7)
    let duplicate=when (x,same) {x.n+same.n}
    match duplicate {Ok(n)=>{assert(n==14)},Err(_)=>{assert(false)}}
    let updated=x.add(1,Input{n:2})
    match updated {Ok(n)=>{assert(n==10)},Err(_)=>{assert(false)}}
    match same.value() {Ok(n)=>{assert(n==10)},Err(_)=>{assert(false)}}
    let alias=x
    match when (mut x,alias) {x.n+=1} {Err(InvalidAccess)=>{},_=>{assert(false)}}
    let unit=when (mut y) {
        var i=0
        while i<3 {i+=1; if i==1 {continue}; if i==3 {break}; y.n+=1}
    }
    match unit {Ok(_)=>{},Err(_)=>{assert(false)}}
    scope { branch {when "读取\u{0}状态" (x) {x.n};}; branch {when "another read" (y) {y.n};} }
    assert(!when (mut x) {x.n=11; false}.unwrap())
    assert(same.value().unwrap()==11)
    let rejected=same.value().unwrap()
    match x.reject() {domain.Outcome.Rejected(message)=>{assert(message.equals("denied"))},_=>{assert(false)}}
    assert(same.value().unwrap()==rejected)
    let rollback=when "reject transfer" (mut x,mut y,z) {
        mem.swap(&mut x.values,&mut y.values)
        mem.swap(&mut x.text,&mut y.text)
        x.n=99
        y.n=z.n
        x.values.push(99)
        let result:Result<Bool,Int32>=Err(42)
        result
    }
    match rollback {domain.Outcome.Rejected(n)=>{assert(n==42)},_=>{assert(false)}}
    assert(when(x,y){x.n==11 && y.n==6 && x.values.len()==1 && y.values.len()==1 && x.values.get(0)! ==2 && y.values.get(0)! ==1 && x.text.equals("state")}.unwrap())
    let success=when(mut x) {x.n=12; let result:Result<Bool,Int32>=Ok(false); result}
    assert(!success.unwrap())
    assert(same.value().unwrap()==12)
    match when(mut x){x.n=13; Decision.Rejected}.unwrap() {Rejected=>{}}
    assert(same.value().unwrap()==13)
    let nested=when(mut x){x.n=14; let inner:Result<Bool,Int32>=Err(7); let outer:Result<Result<Bool,Int32>,Int32>=Ok(inner); outer}
    assert(nested.unwrap().is_err())
    assert(same.value().unwrap()==14)
    a.close()
    match when (x) {x.n} {Err(Closed)=>{},_=>{assert(false)}}
    b.close()
    c.close()
    readonly_views()
    when(24)
}
fn notify(state:&mut State, target:outbox.Handle, bytes:&Array<UInt8>) {
    state.n+=1
    outbox.emit(target,bytes)
}
fn messages() @suspends {
    let owner=domain.create(make,1)
    let h=owner.handle()
    var first=outbox.create(2,8)
    var second=outbox.create(1,8)
    let a=first.handle()
    let b=second.handle()
    let bytes="one".into_bytes()
    let denied=when "deny message" (mut h) {
        notify(h,a,&bytes)
        let result:Result<Unit,Int32>=Err(7)
        result
    }
    assert(match denied { domain.Outcome.Rejected(7) => true, _ => false })
    assert(h.value().unwrap()==1)
    let bytes="two".into_bytes()
    when "publish message" (mut h) {notify(h,b,&bytes)}.unwrap()
    assert(h.value().unwrap()==2)
    let bytes="bad".into_bytes()
    match when "full message" (mut h) {notify(h,a,&bytes); notify(h,b,&bytes)} {
        Err(OutboxFull(target))=>{assert(target==b.identity())}, _=>{assert(false)}
    }
    assert(h.value().unwrap()==2)
    outbox.close(b)
    let bytes="bad".into_bytes()
    match when "closed message" (mut h) {notify(h,a,&bytes); notify(h,b,&bytes)} {
        Err(OutboxClosed(target))=>{assert(target==b.identity())}, _=>{assert(false)}
    }
    assert(h.value().unwrap()==2)
    let bytes="ok".into_bytes()
    when "publish ordered" (mut h) {notify(h,a,&bytes); outbox.emit(a,&bytes)}.unwrap()
    assert(h.value().unwrap()==3)
    let one=first.receive()!
    let two=first.receive()!
    assert(one.len()==2 && two.len()==2)
    assert(one.get(0)! ==111 && two.get(1)! ==107)
    owner.close()
}
fn readonly_views() @suspends {
    let a=domain.create(make,3)
    let b=domain.create(make,7)
    let read=a.read_handle()
    let same=read
    let write=b.handle()
    let single=when(read){read.text.clone()}!
    let (text,n)=when(read,mut write,same) {
        write.n+=read.n+same.values.get(0)!
        (read.text.clone(),write.n)
    }!
    assert(n==13)
    assert(when(read,same){read.n+same.n}! ==6)
    a.close()
    b.close()
    assert(single.equals("state") && text.equals("state"))
}
fn main() @suspends { assert(lifecycle()==24); messages() }
