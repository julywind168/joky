import joky/option as opt.{type Option as Maybe, Some as Present, None as Missing}
import joky/result.{type Result as Outcome, Ok as Success, Err as Failure} as result
import joky/integer

struct Packet { value: Maybe<Int64> result: result.Result<UInt64, Bool> }
type Saved = opt.Option<Int64>

fn unwrap<T>(value: opt.Option<T>, fallback: T) -> T {
    match value { | opt.Option.Some(n) => n | Missing => fallback }
}
fn wrap<T>(value: T) -> Maybe<T> { Present(value) }
fn status(value: Outcome<UInt64, Bool>) -> UInt64 {
    match value { | Success(n) => n | result.Result.Err(reason) => 0 }
}
fn absent<T>() -> Maybe<T> { Missing::<T> }
fn check() -> Int32 {
    let packet = Packet { value: Maybe.Some(4294967295) result: Success(42) }
    let none: Saved = opt.None::<Int64>
    let qualified = opt.Option.None::<Int64>
    let failed: result.Result<UInt64, Bool> = Failure(false)
    let checked: Maybe<UInt64> = (42).to_u64()
    let nested: Maybe<Maybe<Int32>> = Present(Present(42))
    let by_match = match Present(41) { | Present(n) => wrap(n + 1) | Missing => Missing }
    if unwrap(packet.value, 0) == 4294967295 && status(packet.result) == 42
        && unwrap(absent::<Int64>(), 7) == 7 && unwrap(none, 9) == 9 && unwrap(qualified, 8) == 8
        && status(failed) == 0 && unwrap(checked, 0) == 42
        && unwrap(unwrap(nested, Missing), 0) == 42 && unwrap(by_match, 0) == 42 {
        42
    } else { 0 }
}
