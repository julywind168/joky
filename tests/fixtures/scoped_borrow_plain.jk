import joky/array.{type Array}
import joky/fixed_array.{type FixedArray}
import joky/iter.{range}
import joky/task
import joky/check

struct Point { marker: UInt8, pair: (Int32, Float64) }
struct Empty { value: Unit }
fn scalar(value: &Int32) @suspends @noescape -> Int32 {
    task.yield_now()
    *value
}
fn point(value: &Point) @suspends -> Int32 {
    let before = value.pair.0
    task.yield_now()
    before + int32(value.marker)
}
fn relay(value: &Point) @suspends -> Int32 {
    let (a, b) = join { | point(value) | scalar(&value.pair.0) }
    a + b
}
fn main() @suspends -> Int32 {
    var value = Point { marker: 3, pair: (7, 1.5) }
    var number = 5
    let (a, b) = join { | relay(&value) | scalar(&number) }
    number = 11
    value.pair.0 = 99
    a + b + number
}
fn dynamic() @suspends -> Int32 {
    var value = Point { marker: 3, pair: (7, 1.5) }
    let view = &value
    scope { branch { if relay(view) != 17 { check.panic("bad point") } } }
    value.pair.0 = 42
    value.pair.0
}
fn row<const N: UInt64>(values: &FixedArray<Int32, N>) @suspends -> Int32 {
    var total = 0
    var index: UInt64 = 0
    while index < N {
        let value = values.borrow_ref(index)
        task.yield_now()
        total += *value
        index += 1
    }
    total
}
fn row_relay(values: &FixedArray<Int32, 3>) @suspends -> Int32 {
    let (a, b) = join { | row(values) | scalar(values.borrow_ref(1)) }
    a + b
}
fn arrays() @suspends -> Int32 {
    var values: FixedArray<Int32, 3> = [2, 3, 4]
    let (a, b) = join { | row_relay(&values) | row(&values) }
    values.set(0, 99)
    a + b
}
fn empty(value: &Empty) @suspends -> Int32 { task.yield_now(); 1 }
fn zero() @suspends -> Int32 {
    let value = Empty { value: {} }
    let values = fixed_array.repeat::<Int32, 0>(1)
    let (a, b) = join { | empty(&value) | row(&values) }
    a + b
}
fn forever(value: &Int32) @suspends -> Int32 { while true { scalar(value); } }
fn fail(value: &Int32) @suspends -> Int32 { task.yield_now(); check.panic("reader failed") }
fn failed() @suspends -> Int32 {
    let value = 7
    let (a, b) = join { | forever(&value) | fail(&value) }
    a + b
}
fn parked() @suspends {
    let value = 7
    let view = &value
    scope { branch { forever(view); } }
}
fn isolated() @suspends -> Int32 {
    let value = 7
    match isolate { race { | scalar(&value) | forever(&value) } } {
        Ok(value) => value, Err(_) => -1
    }
}
fn reuse() @suspends -> Int32 {
    var total = 0
    for index in range(0, 8) {
        let value = index
        let (a, b) = join { | scalar(&value) | scalar(&value) }
        total += a + b
    }
    total
}


struct Matrix { marker: UInt8, rows: FixedArray<(Int32, Float64), 2> }
fn matrix_reader(value: &Matrix) @suspends -> Int32 {
    task.yield_now()
    let first = value.rows.borrow_ref(0)
    let second = value.rows.borrow_ref(1)
    let (a, b) = join { | scalar(&first.0) | scalar(&second.0) }
    a + b + int32(value.marker)
}
fn matrices() @suspends -> Int32 {
    let value = Matrix { marker: 3, rows: [(7, 1.5), (11, 2.5)] }
    let (a, b) = join { | matrix_reader(&value) | matrix_reader(&value) }
    a + b
}
struct Box<T> { value: T }
fn box_reader(value: &Box<Int32>) @suspends -> Int32 { scalar(&value.value) }
fn generic() @suspends -> Int32 {
    let value = Box { value: 21 }
    let (a, b) = join { | box_reader(&value) | box_reader(&value) }
    a + b
}

fn moved_array(values: Array<Int32>, anchor: &Int32) @suspends -> Int32 {
    let item = values.borrow_ref(1)
    let (a, b) = join { | scalar(item) | scalar(item) }
    a + b
}
fn owned_source() @suspends -> Int32 {
    let values = [7, 21]
    let anchor = 0
    let (a, b) = join { | moved_array(values, &anchor) | task.yield_now() }
    a
}
