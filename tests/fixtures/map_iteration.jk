import joky/mem
import joky/map.{type Map}
import joky/array.{type Array}
import joky/slice.{type Slice}
import joky/check.{assert}
import joky/drop.{type Drop}
import joky/eq.{type Eq}
import joky/hash.{type Hash}
extern fn record_int(value: Int32)

fn copy_views<Tag>() -> Int32 {
    var m = Map.new::<Int32, Int32>()
    { let assertion_condition = slice.is_empty(m.keys()) && slice.is_empty(m.values()) && slice.is_empty(m.values_mut()); let assertion_message = "Empty views"; assert(assertion_condition, &assertion_message) }
    m.insert(1, 10); m.insert(2, 20); m.insert(3, 30); m.remove(2)
    let keys = map.keys(&m)
    let values = map.values(&m)
    var i: UInt64 = 0
    while i < slice.len(keys) {
        let key = slice.get(keys, i).unwrap_or(0)
        { let assertion_condition = slice.get(values, i).unwrap_or(0) == key * 10; let assertion_message = "Paired views"; assert(assertion_condition, &assertion_message) }
        i = i + 1
    }
    let edit = map.values_mut(&mut m)
    i = 0
    while i < slice.len(edit) {
        let previous = slice.get(edit, i).unwrap_or(0)
        slice.set(edit, i, previous + 1); i = i + 1
    }
    { let assertion_condition = m.get(1).unwrap_or(0) == 11 && m.get(3).unwrap_or(0) == 31; let assertion_message = "Value edits preserve keys"; assert(assertion_condition, &assertion_message) }
    m.get(1).unwrap_or(0) + m.get(3).unwrap_or(0)
}
fn consuming<Tag>() -> Int32 {
    var m = Map.new::<Int32, Int32>()
    { let assertion_condition = m.pop().is_none(); let assertion_message = "Empty pop"; assert(assertion_condition, &assertion_message) }
    m.insert(1, 10); m.insert(2, 20); m.insert(3, 30); m.remove(2)
    var sum = 0
    while !m.is_empty() {
        match map.pop(&mut m) {
            Some((key, value)) => { { let assertion_condition = value == key * 10 && !m.contains_key(key); let assertion_message = "Popped entry"; assert(assertion_condition, &assertion_message) }; sum = sum + value }
            None => { { let assertion_condition = false; let assertion_message = "Missing entry"; assert(assertion_condition, &assertion_message) } }
        }
    }
    { let assertion_condition = m.pop().is_none(); let assertion_message = "Drained pop"; assert(assertion_condition, &assertion_message) }
    m.insert(4, 2)
    var entries = map.into_entries(m)
    { let assertion_condition = entries.len() == 1; let assertion_message = "Singleton export"; assert(assertion_condition, &assertion_message) }
    let (key, value) = entries.take_last()
    { let assertion_condition = key == 4; let assertion_message = "Exported key"; assert(assertion_condition, &assertion_message) }
    let empty = Map.new::<Int32, Int32>().into_entries()
    { let assertion_condition = empty.is_empty(); let assertion_message = "Empty export"; assert(assertion_condition, &assertion_message) }
    sum + value
}
struct Key { id: Int32, tag: Int32 }
impl Eq for Key { fn eq(&self, other: &Key) -> Bool { self.id == other.id } }
impl Hash for Key { fn hash(&self) -> UInt64 { 0 } }
fn batches<Tag>() -> Int32 {
    var input = Array.new::<(Key, Int32)>()
    input.push((Key { id: 1, tag: 10 }, 1)); input.push((Key { id: 2, tag: 20 }, 2))
    input.push((Key { id: 1, tag: 30 }, 20))
    var m = Map.from_entries(input)
    var more = Array.new::<(Key, Int32)>()
    more.push((Key { id: 2, tag: 40 }, 21)); more.push((Key { id: 2, tag: 50 }, 22))
    map.extend(&mut m, more)
    m.extend(Array.new::<(Key, Int32)>())
    { let assertion_condition = m.len() == 2; let assertion_message = "Duplicate input"; assert(assertion_condition, &assertion_message) }
    let keys = m.keys()
    var i: UInt64 = 0
    while i < slice.len(keys) {
        match slice.get(keys, i) { Some(k) => { { let assertion_condition = k.tag == k.id * 10; let assertion_message = "Original key retained"; assert(assertion_condition, &assertion_message) } }, None => {} }
        i = i + 1
    }
    var exported = m.into_entries()
    var result = 0
    while !exported.is_empty() { let (key, value) = exported.take_last(); result = result + value }
    let empty = map.from_entries(Array.new::<(Key, Int32)>())
    { let assertion_condition = empty.is_empty(); let assertion_message = "Empty import"; assert(assertion_condition, &assertion_message) }
    result
}
struct Resource { id: Int32, fail: Bool, data: Array<Int32> }
impl Drop for Resource {
    fn drop(&mut self) { record_int(self.id); { let assertion_condition = !self.fail; let assertion_message = "Batch drop failure"; assert(assertion_condition, &assertion_message) } }
}
fn resource(id: Int32, fail: Bool) -> Resource {
    var data = Array.new::<Int32>(); data.push(id)
    let result = Resource { id: id, fail: fail, data: data }
    record_int(-id)
    result
}
fn owned_pipeline<Tag>() -> Int32 {
    var input = Array.new::<(Int32, Resource)>()
    input.push((1, resource(1, false))); input.push((1, resource(2, false))); input.push((2, resource(3, false)))
    var m = map.from_entries(input)
    let read = slice.borrow_ref(m.values(), 0)
    { let assertion_condition = read.data.get(0).unwrap_or(0) == read.id; let assertion_message = "Owned slice"; assert(assertion_condition, &assertion_message) }
    let edit = m.values_mut()
    {
        let value = slice.borrow_mut_ref(edit, 0)
        value.data.push(42)
        let old = mem.replace(value, resource(4, false))
    }
    var total = 0
    match m.pop() {
        Some((key, value)) => { { let assertion_condition = value.data.get(0).unwrap_or(0) == value.id; let assertion_message = "Popped owner remains usable"; assert(assertion_condition, &assertion_message) }; total = total + value.id }
        None => { { let assertion_condition = false; let assertion_message = "Missing owner"; assert(assertion_condition, &assertion_message) } }
    }
    record_int(900)
    var exported = m.into_entries()
    record_int(901)
    while !exported.is_empty() {
        let (key, value) = exported.take_last()
        { let assertion_condition = value.data.get(0).unwrap_or(0) == value.id; let assertion_message = "Exported owner remains usable"; assert(assertion_condition, &assertion_message) }
        total = total + value.id
    }
    { let assertion_condition = total == 7; let assertion_message = "All owners exported"; assert(assertion_condition, &assertion_message) }
    42
}
fn references<Tag>() -> Int32 {
    var input = Array.new::<(Int32, &Int32)>()
    input.push((1, (&*(alloc(1))))); input.push((1, (&*(alloc(20)))))
    var m = Map.from_entries(input)
    slice.set(m.values_mut(), 0, (&*(alloc(42))))
    let copied = slice.get(m.values(), 0)
    var exported = m.into_entries()
    let (key, value) = exported.take_last()
    exported.release()
    { let assertion_condition = key == 1 && (*value) == 42; let assertion_message = "Exported reference"; assert(assertion_condition, &assertion_message) }
    match copied { Some(n) => (*n), None => 0 }
}
// These operations need no key protocols, even through generic helpers.
struct Plain { id: Int32 }
fn no_protocols<K, V>(m: Map<K, V>) -> Array<(K, V)> {
    var m = m
    slice.len(m.keys()); slice.len(m.values()); slice.len(m.values_mut()); m.pop()
    m.into_entries()
}
fn unbounded<Tag>() -> Int32 {
    let entries = no_protocols(Map.new::<Plain, Int32>())
    if entries.is_empty() { 42 } else { 0 }
}
struct LoggedKey { id: Int32 }
impl Eq for LoggedKey { fn eq(&self, other: &LoggedKey) -> Bool { self.id == other.id } }
impl Hash for LoggedKey { fn hash(&self) -> UInt64 { record_int(100 + self.id); 0 } }
fn protocol_free_export<Tag>() -> Int32 {
    var m = Map.new::<LoggedKey, Int32>()
    m.insert(LoggedKey { id: 1 }, 20); m.insert(LoggedKey { id: 2 }, 22)
    var total = 0
    match m.pop() { Some((key, value)) => { total = total + value }, None => {} }
    var output = m.into_entries()
    let (key, value) = output.take_last()
    total + value
}
fn drop_failure<Tag>() -> Int32 {
    var m = Map.new::<LoggedKey, Resource>()
    m.insert(LoggedKey { id: 1 }, resource(1, true))
    var input = Array.new::<(LoggedKey, Resource)>()
    input.push((LoggedKey { id: 1 }, resource(2, false)))
    input.push((LoggedKey { id: 2 }, resource(3, false)))
    input.push((LoggedKey { id: 3 }, resource(4, false)))
    m.extend(input)
    record_int(999)
    0
}
fn main() { record_int(copy_views::<Unit>()) }
