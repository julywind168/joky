import joky/domain
import joky/array.{type Array}
struct Player { name:String, score:Int64 }
struct Room { players:Array<Player>, score:Int64, level:Int32 }
fn start(old:&PreviousRoom)->Room {
    Room{players:Array.new::<Player>(),score:int64(old.score),level:1}
}
fn advance(next:&mut Room,old:&PreviousRoom,budget:UInt64)->Bool {
    var count:UInt64=0
    while count<budget && next.players.len()<old.players.len() {
        let player=old.players.borrow_ref(next.players.len())
        next.players.push(Player{name:player.name.clone(),score:int64(player.score)})
        count=count+1
    }
    next.players.len()==old.players.len()
}
fn read(room:&Room)->Int32 {
    if room.players.len()!=12 {return -100}
    let name="玩家"
    var i:UInt64=0
    while i<room.players.len() {
        let player=room.players.borrow_ref(i)
        if !player.name.equals(&name) || player.score!=42+int64(i) {return -101}
        i=i+1
    }
    int32(room.score)+room.level
}
fn version()->Int32 {2}
struct Ledger { text:String, total:Int64, generation:Int32 }
struct Rules { limit:Int32 }
fn upgrade_ledger(old:&PreviousLedger)->Ledger {Ledger{text:old.text.clone(),total:int64(old.total),generation:1}}
fn ledger_read(s:&Ledger)->Int32 {let text="ledger" if s.text.equals(&text) {int32(s.total)+s.generation} else {-100}}
fn rules_read(s:&Rules)->Int32 {s.limit}
fn probe(directory:domain.DirectoryHandle) @suspends ->Int32 {
    let a=match domain.lookup::<Room>(directory,1) {Some(h)=>domain.read_from(h,read).unwrap(),None=>return -1}
    let b=match domain.lookup::<Room>(directory,2) {Some(h)=>domain.read_from(h,read).unwrap(),None=>return -1}
    let c=match domain.lookup::<Ledger>(directory,3) {Some(h)=>domain.read_from(h,ledger_read).unwrap(),None=>return -1}
    let d=match domain.lookup::<Rules>(directory,4) {Some(h)=>domain.read_from(h,rules_read).unwrap(),None=>return -1}
    a+b+c+d
}
