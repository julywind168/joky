extern fn delayed_value(value: Int32) @suspends -> Int32
extern fn record(value: Int32) -> Int32
fn mutable_pending(divisor: Int32) @suspends -> Int32 {
    let value = alloc(Some((int32(0), uint64(0))))
    match value {
        | Some((left, right)) => {
            memory.write(left, 40)
            let next = delayed_value(record(memory.read(left)))
            memory.write(right, uint64(next + 1))
            memory.write(left, int32(memory.read(right)))
        }
        | None => return 0
    }
    match share(value) { | Some((answer, _)) => answer / divisor | None => 0 }
}
