import joky/array.{type Array, type IntoIter}
import joky/iter.{type Iterator, next, range}
import joky/option.{type Option, Some, None}
import joky/check.{assert}
import joky/mem
extern fn record(x: Int32) -> Int32

fn expect(ok: Bool) { assert(ok, "Array iterator mismatch") }
struct Point { value: Int32 }
struct Owned { id: Int32, data: Array<Int32> }

fn owned(id: Int32) -> Owned {
    let value = Owned { id: id, data: [id] }
    record(-id)
    value
}
fn values() -> Array<Owned> { [owned(1), owned(2), owned(3), owned(4)] }

fn consume(action: Int32) -> Int32 {
    var sum = 0
    for value in values() {
        record(10 + value.id)
        if action == 1 && value.id == 1 { continue }
        sum += value.id
        if action == 2 { break }
        if action == 3 { return value.id }
        if action == 4 { let invalid = value.id % 0 }
    }
    sum
}
fn retained() -> Int32 {
    var iterator = values().into_iter()
    let first = next(&mut iterator)!
    mem.drop(iterator)
    record(10 + first.id)
    first.id + first.data.get(0).unwrap_or(0)
}
fn unstarted() { let iterator = array.into_iter(values()) }
fn count<I: Iterator>(iterator: I) -> Int32 {
    var n = 0
    for _ in iterator { n += 1 }
    n
}
fn compute() -> Int32 {
    // Both even and odd lengths retain original index order.
    for size in range(0, 7) {
        var input = Array.new::<Int32>()
        for n in range(0, size) { input.push(n) }
        var iterator: IntoIter<Int32> = input.into_iter()
        for n in range(0, size) { expect(next(&mut iterator)! == n) }
        expect(next(&mut iterator).is_none())
        expect(next(&mut iterator).is_none())
    }
    expect(count([{}, {}, {}].into_iter()) == 3)
    expect(count(["a", "b"].into_iter()) == 2)
    expect(count(Array.new::<String>().into_iter()) == 0)
    var total = 0
    for inner in [[1, 2], [3, 4]] {
        for n in inner { total = total * 10 + n }
    }
    expect(total == 1234)
    let point = alloc(Point { value: 42 })
    for value in [&*point].into_iter() { expect(value.value == 42) }
    // The saved item outlives the iterator and its unconsumed storage.
    let text = {
        var iterator = ["retained", "discarded"].into_iter()
        next(&mut iterator)!
    }
    let moved = text
    42
}
