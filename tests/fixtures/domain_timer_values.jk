import joky/domain
import joky/check
import joky/task
struct Room {value:Int32,text:String}
struct Empty {}
struct Bits {wide:UInt64,tiny:Int8,real:Float64,flag:Bool,rune:Rune}
struct Input {amount:Int32,bits:Bits,empty:Empty,unit:Unit}
fn make(value:Int32)->Room {Room{value:value,text:"owned timer root"}}
fn read(room:&Room)->Int32 {room.value}
fn input(amount:Int32)->Input {Input{amount:amount,bits:Bits{wide:18446744073709551615,tiny:-128,real:Float64.from_bits(9221120237041090626),flag:true,rune:'界'},empty:Empty{},unit:{}}}
fn assert(ok:Bool) {let message="timer record input" check.assert(ok,&message)}
fn tick(room:&mut Room,p:Input) {
    assert(p.bits.wide==18446744073709551615 && p.bits.tiny == -128)
    assert(p.bits.real.to_bits()==9221120237041090626 && p.bits.flag && p.bits.rune=='界')
    room.value=room.value+p.amount
}
fn empty_tick(room:&mut Room,p:Empty) {room.value=room.value+1}
fn generic_tick<T>(room:&mut Room,p:T) {room.value=room.value+1}
fn arm<T>(t:domain.TimerHandle,h:domain.WriteHandle<Room>,p:T) @suspends -> Result<Unit,domain.TimerError> {domain.after(t,h,0,generic_tick::<T>,p)}
fn next(n:&mut Int32)->Input {(*(n)=(*n)+1); input(*n)}
fn wait(t:domain.TimerHandle) @suspends {
    while match t.status(){Active=>true,_=>false} {task.yield_now()}
    assert(match t.status(){Completed=>true,_=>false})
}
fn budget() @suspends ->Int32 {
    let room=domain.create(make,10) let owner=domain.timer() let t=owner.handle()
    match domain.after(t,room.handle(),0,tick,input(2)) {
        Err(domain.TimerError.ResourceLimit)=>4
        Ok(_)=>{wait(t) domain.read_from(room.read_handle(),read).unwrap()}
        _=>99
    }
}
fn main() @suspends ->Int32 {
    let room=domain.create(make,10) let h=room.handle() let owner=domain.timer() let t=owner.handle()
    assert(match domain.every(t,h,0,tick,input(1)){Err(InvalidDelay)=>true,_=>false})
    assert(match domain.after(t,h,-1,tick,input(1)){Err(InvalidDelay)=>true,_=>false})
    var n=0
    assert(domain.after(t,h,0,tick,next(&mut n)).is_ok())
    assert(n==1) wait(t)
    assert(domain.read_from(room.read_handle(),read).unwrap()==11)
    assert(domain.after(t,h,0,empty_tick,Empty{}).is_ok()) wait(t)
    assert(arm(t,h,input(100)).is_ok()) wait(t)
    assert(domain.read_from(room.read_handle(),read).unwrap()==13)
    var p=input(2)
    assert(domain.every(t,h,100000,tick,p).is_ok()) p.amount=99
    assert(match domain.after(t,h,0,tick,p){Err(Busy)=>true,_=>false})
    t.cancel()
    assert(match t.status(){Cancelled=>true,_=>false})
    assert(domain.after(t,h,0,tick,p).is_ok()) wait(t)
    assert(domain.read_from(room.read_handle(),read).unwrap()==112)
    assert(domain.every(t,h,100000,tick,input(1000)).is_ok()) room.close()
    assert(match t.status(){Closed=>true,_=>false}) owner.close()
    let other=domain.create(make,1)
    let dangling={let o=domain.timer() let t=o.handle() assert(domain.after(t,other.handle(),100000,tick,input(2)).is_ok()) t}
    assert(match dangling.status(){Closed=>true,_=>false})
    assert(domain.read_from(other.read_handle(),read).unwrap()==1)
    0
}
