import joky/drop.{type Drop}
import joky/fixed_array as fixed.{type FixedArray}
import joky/array.{type Array}
import joky/slice as slices.{type Slice}
extern fn note(value:Int32)
struct Guard { id:Int32, text:String }
impl Drop for Guard { fn drop(&mut self) { note(self.id) } }
type Row=FixedArray<Int32,3>
fn tail(a:&Row)->&Slice<Int32>{a.slice(1,3)}
fn exercise()->Int32 {
    let guard=Guard{id:-1,text:"views"}
    var a=fixed.repeat::<Row,2>(fixed.repeat::<Int32,3>(21))
    var dynamic=Array.new::<Row>()
    dynamic.push(fixed.repeat::<Int32,3>(1))
    note(1)
    let s=a.slice_mut(0,2)
    let r=slices.borrow_mut_ref(s,1)
    *r.borrow_mut_ref(2)=42
    note(2)
    let sub=tail(r)
    let n=*slices.borrow_ref(sub,1)
    let outer=dynamic.borrow_mut_ref(0)
    let d=outer.slice_mut(0,3)
    *slices.borrow_mut_ref(d,0)=n
    note(3)
    let out=*slices.borrow_ref(d,0)
    dynamic.reserve(16)
    a=fixed.repeat::<Row,2>(fixed.repeat::<Int32,3>(0))
    note(4)
    out+guard.id+1
}
fn failure()->Int32 {
    let guard=Guard{id:-1,text:"bounds"}
    let a=fixed.repeat::<Int32,3>(1)
    let s=a.slice(0,3)
    note(1)
    slices.len(s)
    *a.borrow_ref(3)+guard.id
}
fn payload_reuse()->Int32 {
    var i=0
    while i<64 {
        let a=fixed.repeat::<Int32,1024>(42)
        let s=a.slice(0,1024)
        if *slices.borrow_ref(s,1023)!=42 {return 0}
        i=i+1
    }
    42
}
fn headers()->Int32 {
    let a=fixed.repeat::<Int32,3>(42)
    var i=0
    while i<1000 { slices.len(a.slice(0,0)); i=i+1 }
    42
}
fn references()->Int32 {
    let a=fixed.repeat::<Int32,3>(42)
    var i=0
    while i<1000 { if *a.borrow_ref(0)!=42 {return 0}; i=i+1 }
    42
}
fn task() @suspends -> Int32 { exercise() }
