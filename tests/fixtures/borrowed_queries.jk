import joky/array.{type Array}
import joky/map.{type Map}
import joky/slice.{type Slice}
import joky/list.{type List}
import joky/fixed_array.{type FixedArray}
import joky/element

type View = &Later
struct Holder { value: View }
enum Choice { Value(&Later) }
type Hidden = Option<&Later>
struct Later { value: Array<String> }

struct Item { text: String, children: Array<String> }
fn wrapped<T>(values: &Array<T>, index: UInt64) -> Option<&T> { values.get_ref(index) }
fn forwarded<T>(value: Option<&T>) -> Option<&T> { value }
fn from_slice<T>(values: &Slice<T>) -> Option<&T> { values.get_ref(0) }
fn check_container_queries() {
    let fixed: FixedArray<String, 2> = ["left", "right"]
    assert(fixed.get_ref(1)! == "right" && fixed_array.get_ref(&fixed, 2).is_none(), "fixed array lookup")
    var sequence = List.from_array(["first", "removed", "last"])
    sequence.remove(1)
    sequence.reverse()
    assert(list.get_ref(&sequence, 0)! == "last" && sequence.get_ref(2).is_none(), "logical list lookup")
    var counts = Map.new::<String, Int32>()
    counts.insert("key", 41)
    let counter_key = "key"
    let counter = counts.borrow_mut(&counter_key)
    counter_key.release()
    element.write(counter, 42)
    assert(element.read(counts.borrow("key")) == 42 && counts.get("absent").is_none(), "element views with an owning key")
}
fn compute() -> Int32 {
    check_container_queries()
    let later = Later { value: ["forward"] }
    let holder = Holder { value: &later }
    let choice = Choice.Value(holder.value)
    let hidden: Hidden = match choice { Choice.Value(value) => Some(value) }
    let chosen = hidden!
    assert(chosen.value.len() == 1, "forward shared aggregate layouts")
    var values = ["first", "second"]
    let found = forwarded(wrapped(&values, 1))
    assert(match found { Some(value) => value == "second", None => false }, "array hit")
    assert(values.get_ref(2).is_none(), "array miss")
    assert(match from_slice(values.slice(0, 1)) { Some(value) => value == "first", None => false }, "slice hit")
    assert(values.slice(0, 0).get_ref(0).is_none(), "slice miss")
    values.push("third")
    let records = [Item { text: "record", children: ["nested"] }]
    let record = records.get_ref(0)!
    assert(record.text == "record", "owning record")
    assert(match record.children.get_ref(0) { Some(value) => value == "nested", None => false }, "nested owner")
    var table: Map<String, Array<String>> = Map.new()
    table.insert("key", ["value"])
    let query = "key"
    let result = table.get_ref(&query)
    query.release()
    let data = result!
    assert(data.len() == 1, "map result does not depend on key")
    assert(match data.get_ref(0) { Some(value) => value == "value", None => false }, "map nested value")
    assert(table.get_ref("absent").is_none(), "map miss and temporary key")
    table.clear()
    assert(table.is_empty() && values.len() == 3, "last use ends borrow")
    42
}
fn main() { assert(compute() == 42, "borrowed queries") }
