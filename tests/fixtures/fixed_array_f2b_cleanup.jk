import joky/drop.{type Drop}
import joky/fixed_array as fixed.{type FixedArray}
import joky/array.{type Array}
extern fn note(value: Int32)
type Row = FixedArray<Int32,3>
struct Guard { id:Int32, text:String }
impl Drop for Guard { fn drop(&mut self) {note(self.id)} }
fn identity(a:Row)->Row {a}
fn exercise()->Int32 {
    var values=Array.new::<Option<Row>>()
    let guard=Guard{id:-1,text:"callback"}
    let nested=fixed.from_fn::<Row,4>(move |index:UInt64| {
        note(int32(index)+1)
        fixed.repeat::<Int32,3>(43+guard.id)
    })
    let f=identity
    var i:UInt64=0
    while i<4 {
        match nested.get(i) {Some(r)=>{values.push(Some(f(r)))},None=>{}}
        i=i+1
    }
    values.reserve(16)
    let out=values.take_last()
    match out { Some(r)=>match r.get(0) {Some(n)=>n,None=>0},None=>0 }
}
fn fail_init()->Int32 {
    let guard=Guard{id:-1,text:"failed"}
    let nested=fixed.from_fn::<Row,4>(move |index:UInt64| {
        note(int32(index)+1)
        fixed.repeat::<Int32,3>(guard.id/(int32(index)-2))
    })
    note(99)
    0
}
fn task() @suspends -> Int32 {exercise()}
