import joky/domain
import joky/check
import joky/task
import joky/outbox
import joky/array.{type Array}
struct State {n:Int32}
struct Rules {limit:Int32}
struct Input {n:Int32}
fn make(n:Int32)->State {State{n:n}}
fn make_value(p:Input)->State {State{n:p.n}}
fn rules(n:Int32)->Rules {Rules{limit:n}}
fn total(a:&State,b:&Rules)->Int32 {a.n+b.limit}
fn sum(a:&State,b:&State)->Int32 {a.n+b.n}
fn read(a:&State)->Int32 {a.n}
fn read_rules(a:&Rules)->Int32 {a.limit}
fn change(a:&mut State,n:Int32) {a.n=n}
fn assert(ok:Bool) {let message="submission contract"; check.assert(ok,&message)}
fn choose<B,R>(snapshot:domain.Snapshot<B,R>,target:domain.WriteHandle<Rules>,n:Int32) @suspends ->domain.Candidate<Rules> {
    domain.candidate_from(snapshot,target,rules,n)
}
fn batch(target:outbox.Handle) @suspends ->outbox.Batch {
    var batch=outbox.batch(1,1)
    var bytes=Array.new::<UInt8>(); bytes.push(7)
    assert(outbox.stage(&mut batch,target,bytes).is_ok())
    batch
}
fn wait_single(r:&mut domain.CommitReceipt) @suspends {r.wait();}
fn wait_pair(r:&mut domain.PairCommitReceipt) @suspends {r.wait();}
fn wait_set(r:&mut domain.SetCommitReceipt) @suspends {r.wait();}
fn stop_wait() @suspends {}
fn lifecycle() @suspends ->Int32 {
    let a=domain.create(make,1); let b=domain.create(rules,10)
    let ah=a.handle(); let bh=b.handle(); let ar=a.read_handle()
    // The second, differently typed dependency can be the sole write target.
    let snapshot=domain.snapshot_pair(a.read_handle(),b.read_handle(),total)
    let candidate=choose(snapshot,bh,20)
    var single=domain.commit_to(bh,candidate)
    race { | wait_single(&mut single) | stop_wait() };
    assert(single.wait().unwrap()==1)
    assert(domain.read_from(a.read_handle(),read).unwrap()==1)
    assert(domain.read_from(b.read_handle(),read_rules).unwrap()==20)
    // Candidate order determines the success tuple, independently of read order.
    let snapshot=domain.snapshot_pair(a.read_handle(),b.read_handle(),total)
    let first=domain.candidate_from(snapshot,bh,rules,30)
    let pair=domain.candidate_pair_from(first,ah,make_value,Input{n:2})
    var pair_receipt=domain.commit_pair_to(bh,ah,pair)
    race { | wait_pair(&mut pair_receipt) | stop_wait() };
    assert(match pair_receipt.wait(){Ok((x,y))=>x==2 && y==1,_=>false})
    // A read-only dependency is retained when selecting the second target.
    let snapshot=domain.snapshot_pair(a.read_handle(),b.read_handle(),total)
    let candidate=domain.candidate_from(snapshot,bh,rules,99)
    domain.write_to(ah,change,3).unwrap()
    var stale=domain.commit_to(bh,candidate)
    assert(match stale.wait(){Err(Conflict)=>true,_=>false})
    assert(domain.read_from(b.read_handle(),read_rules).unwrap()==30)
    let other=domain.create(make,5)
    var accesses=domain.access_set()
    accesses.include(a.read_handle()); accesses.include(b.read_handle()); accesses.include(other.read_handle())
    let snapshot=domain.snapshot_set(accesses)
    let candidate=domain.candidate_set_from(snapshot,bh,rules,40)
    let candidate=domain.candidate_set_add(candidate,ah,make_value,Input{n:4})
    var mailbox=outbox.create(1,1)
    var receipt=domain.commit_set(candidate.with_outbox(batch(mailbox.handle())))
    race { | wait_set(&mut receipt) | stop_wait() };
    assert(receipt.wait().is_ok())
    assert(receipt.revision(a.read_handle()).unwrap().unwrap_or(0)==3)
    assert(receipt.revision(b.read_handle()).unwrap().unwrap_or(0)==3)
    assert(receipt.revision(other.read_handle()).unwrap().is_none())
    assert(match mailbox.receive(){Some(bytes)=>bytes.get(0).unwrap_or(0)==7,None=>false})
    domain.write_to(ah,change,8).unwrap()
    assert(receipt.revision(a.read_handle()).unwrap().unwrap_or(0)==3)
    a.close(); b.close(); receipt.cancel()
    assert(receipt.wait().is_ok())
    assert(receipt.revision(ar).unwrap().unwrap_or(0)==3)
    assert(single.wait().unwrap()==1)
    assert(match pair_receipt.wait(){Ok((x,y))=>x==2 && y==1,_=>false})
    24
}
fn main() @suspends {assert(lifecycle()==24)}
