import joky/iter.{type Iterator, type IntoIterator, type Enumerate, range, next, enumerate}
import joky/array.{type Array}
import joky/option.{type Option, Some, None}
import joky/check.{assert}
import joky/drop.{type Drop}
import joky/mem
extern fn record(x: Int32) -> Int32
extern fn delayed_value(x: Int32) @suspends -> Int32

fn expect(ok: Bool) { assert(ok, "Enumerate mismatch") }
struct Intermittent { step: Int32 }
impl Iterator for Intermittent {
    type Item = Int32
    fn next(&mut self) -> Option<Int32> {
        self.step += 1
        record(self.step + 100)
        if self.step == 2 { None } else { Some(self.step) }
    }
}
impl Intermittent {
    fn next(&mut self) -> Option<Int32> { Some(-1) }
}
fn wrap<I: Iterator>(input: I) -> Enumerate<I> { input.enumerate() }
fn count_input<I: IntoIterator>(input: I) -> UInt64 {
    var count: UInt64 = 0
    for (index, _) in input.enumerate() { expect(index == count); count += 1 }
    count
}
fn dynamic_next(input: &mut dyn Iterator<Item = Int32>) -> Int32 { input.next().unwrap_or(0) }
struct Point { value: Int32 }
fn compute() -> Int32 {
    var digits = 0
    for (index, value) in range(4, 7).enumerate() {
        expect(value == int32(index) + 4)
        digits = digits * 10 + value
    }
    expect(digits == 456)
    for _ in enumerate(range(0, 0)) { expect(false) }
    var total: UInt64 = 0
    for (outer, (inner, value)) in wrap([10, 20].into_iter()).enumerate() {
        expect(outer == inner)
        total += outer + uint64(value)
    }
    expect(total == 31)
    expect(count_input([10, 20]) == 2)
    expect(count_input(Array.new::<Int32>()) == 0)
    var dynamic_source = range(40, 43)
    let dynamic_view: &mut dyn Iterator<Item = Int32> = &mut dynamic_source
    expect(dynamic_next(dynamic_view) == 40 && dynamic_next(dynamic_view) == 41)
    var cursor = enumerate(Intermittent { step: 0 })
    record(100)
    let (first_index, first) = next(&mut cursor)!
    expect(first_index == 0 && first == 1)
    expect(next(&mut cursor).is_none())
    let (second_index, second) = next(&mut cursor)!
    expect(second_index == 1 && second == 3)
    var partial = range(10, 13)
    expect(next(&mut partial)! == 10)
    for (index, value) in partial.enumerate() { expect(value == int32(index) + 11) }
    var ended = range(0, 0).enumerate()
    expect(next(&mut ended).is_none() && next(&mut ended).is_none())
    var count: UInt64 = 0
    for (index, _) in [{}, {}].into_iter().enumerate() { expect(index == count); count += 1 }
    expect(count == 2)
    let point = alloc(Point { value: 42 })
    for (index, value) in [&*point].into_iter().enumerate() {
        expect(index == 0 && value.value == 42)
    }
    42
}

struct Owned { id: Int32, data: Array<Int32> }
impl Drop for Owned { fn drop(&mut self) { record(self.id); } }
fn owned(id: Int32) -> Owned {
    let value = Owned { id: id, data: [id] }
    record(-id)
    value
}
fn values() -> Array<Owned> { [owned(1), owned(2), owned(3)] }
fn consume(action: Int32) -> Int32 {
    var total = 0
    for (index, value) in values().into_iter().enumerate() {
        expect(value.id == int32(index) + 1)
        record(10 + value.id)
        if action == 1 && index == 0 { continue }
        total += value.id
        if action == 2 { break }
        if action == 3 { return value.id }
        if action == 4 { let invalid = value.id / 0 }
    }
    total
}
fn unstarted() { let cursor = values().into_iter().enumerate() }
fn retained() -> Int32 {
    var cursor = values().into_iter().enumerate()
    let (index, value) = next(&mut cursor)!
    mem.drop(cursor)
    record(10 + value.id)
    int32(index) + value.id + value.data.get(0).unwrap_or(0)
}
fn pending() @suspends -> Int32 {
    for (index, value) in values().into_iter().enumerate() {
        expect(value.id == int32(index) + 1)
        delayed_value(record(10 + value.id))
        if index == 0 { continue }
        break
    }
    42
}
