import joky/pgsql
import joky/socket/tls
import joky/socket/tcp
import joky/crypto/random
import joky/env
import joky/mut_bytes

fn succeeds(port: UInt16, user: String, password: Bytes) -> Result(Unit, String) effects { tcp, tls, random } {
    let connection = pgsql.connect(pgsql.PgConfig(port: port, user: user, database: "postgres"), password)?
    let response = connection.query("SELECT 42, '中文'")?
    let row = response.result?.head()!.rows.head()!
    if (row.text(0)?! != "42") || (row.text(1)?! != "中文") { panic("SCRAM query result") }
    response.connection.close()
    Ok(())
}

fn main() -> Result(Unit, String) effects { tcp, tls, random, env } {
    let port = env.get("JOKY_PG_PORT")?!.parse(UInt16)?
    succeeds(port, "scram_ascii", b"correct password")?
    succeeds(port, "scram_unicode", Bytes.from_string("ＩＸ密码"))?
    let fallback = MutBytes()
    fallback.extend(b"bad")
    fallback.push(7)
    fallback.extend(b"password")
    succeeds(port, "scram_fallback", fallback.to_bytes())?
    let config = pgsql.PgConfig(port: port, user: "scram_ascii", database: "postgres")
    match pgsql.connect(config, b"wrong password") {
        Ok(connection) => { connection.close(); panic("wrong password accepted") }
        Err(message) => if !message.contains("28P01") { panic("expected password SQLSTATE") }
    }
    println("pgsql SCRAM live ok")
    Ok(())
}
