import joky/array.{type Array, type IntoIter}
import joky/iter.{type IntoIterator, type Iterator, type Range, range}
import joky/check.{assert}
extern fn record(x: Int32) -> Int32

struct Batch { values: Array<Int32> }
impl IntoIterator for Batch {
    type IntoIter = IntoIter<Int32>
    fn into_iter(self) -> IntoIter<Int32> {
        record(101)
        self.values.into_iter()
    }
}
impl Batch {
    // The loop must select the standard trait, not this inherent method.
    fn into_iter(self) -> Range { range(0, 0) }
}
fn batch() -> Batch { record(100); Batch { values: [1, 2, 3] } }
fn count<I: IntoIterator>(input: I) -> Int32 {
    var result = 0
    for _ in input { result += 1 }
    result
}
fn ordinary<I: Iterator>(input: I) -> Int32 { count(input) }
struct Broken { values: Array<String> }
impl IntoIterator for Broken {
    type IntoIter = IntoIter<String>
    fn into_iter(self) -> IntoIter<String> {
        let invalid = 1 / record(0)
        self.values.into_iter()
    }
}
fn conversion_failure() { for _ in (Broken { values: ["owned"] }) {} }
fn compute() -> Int32 {
    var sum = 0
    for value in batch() { sum += value }
    assert(sum == 6, "Protocol dispatch mismatch")
    assert(count(Batch { values: [4, 5] }) == 2, "Generic conversion mismatch")
    assert(count(Array.new::<Int32>()) == 0, "Empty conversion mismatch")
    assert(ordinary(range(0, 3)) == 3, "Iterator identity mismatch")
    assert(count(iter.into_iter([1, 2])) == 2, "Explicit conversion mismatch")
    var calls = 0
    for value in { calls += 1; [7, 8] } { sum += value }
    assert(calls == 1 && sum == 21, "Input evaluated more than once")
    42
}
