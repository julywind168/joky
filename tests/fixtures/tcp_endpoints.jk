import joky/tcp
import joky/dns.{type ErrorKind}
import joky/check

fn receive(listener: &mut tcp.TcpListener) @suspends {
    var stream = listener.accept()!
    let bytes = stream.read(1)!
    check.assert(bytes.len() == 1 && bytes[0] == 42, "host endpoint transfers bytes")
}
fn send(port: UInt16) @suspends {
    var stream = tcp.connect("localhost", port)!
    stream.write_all([42])!
}
fn endpoint(host: String) @suspends {
    var listener = tcp.listen(host, 0)!
    let port = listener.local_addr()!.port()
    check.assert(port != 0, "port zero allocates an endpoint")
    join { receive(&mut listener), send(port) }
}
fn invalid(kind: ErrorKind) -> Bool { match kind { InvalidInput => true, _ => false } }
fn errors() @suspends {
    check.assert(match tcp.listen("bad host", 0) {
        Err(Resolve(error)) => invalid(error.kind),
        _ => false
    }, "listen preserves DNS error identity")
    check.assert(match tcp.connect("localhost:80", 80) {
        Err(Resolve(error)) => invalid(error.kind),
        _ => false
    }, "connect distinguishes resolution failure")
    var listener = tcp.listen("127.0.0.1", 0)!
    check.assert(match tcp.listen("127.0.0.1", listener.local_addr()!.port()) {
        Err(Io(error)) => match error.kind() { AddrInUse => true, _ => false },
        _ => false
    }, "listen preserves socket failure")
    listener.close()!
}
fn main() @suspends -> Int32 {
    errors()
    endpoint("127.0.0.1")
    endpoint("localhost")
    0
}
