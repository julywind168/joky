import joky/check as check.{assert}
import joky/array.{type Array}
import joky/drop.{type Drop}
extern fn record_int(value: Int32)
struct Resource { id: Int32, data: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { record_int(self.id) } }
fn condition(value: Bool) -> Bool { record_int(10) value }
fn message() -> String { record_int(20) "Requested failure" }
fn check_success() -> Int32 {
    { let assertion_condition = condition(true) let assertion_message = message() check.assert(assertion_condition, &assertion_message) }
    { let assertion_condition = true let assertion_message = "Unused failure" assert(assertion_condition, &assertion_message) }
    42
}
fn check_failure() -> Int32 {
    let owned = Resource { id: 1, data: Array.new::<Int32>() }
    { let assertion_condition = condition(false) let assertion_message = message() check.assert(assertion_condition, &assertion_message) }
    record_int(99)
    0
}
fn failing_condition() -> Bool {
    { let assertion_condition = false let assertion_message = "Condition failure" assert(assertion_condition, &assertion_message) }
    true
}
fn check_argument_failure() -> Int32 {
    let owned = Resource { id: 2, data: Array.new::<Int32>() }
    { let assertion_condition = failing_condition() let assertion_message = message() check.assert(assertion_condition, &assertion_message) }
    0
}
struct Failing { id: Int32, data: Array<Int32> }
impl Drop for Failing {
    fn drop(&mut self) {
        record_int(self.id)
        { let assertion_condition = false let assertion_message = "Drop failure" assert(assertion_condition, &assertion_message) }
    }
}
fn check_drop_failure() -> Int32 {
    var a = Array.new::<Failing>()
    a.push(Failing { id: 3, data: Array.new::<Int32>() })
    a.push(Failing { id: 4, data: Array.new::<Int32>() })
    a.clear()
    record_int(99)
    0
}
fn check_first_failure() -> Int32 {
    let a = Failing { id: 5, data: Array.new::<Int32>() }
    { let assertion_condition = false let assertion_message = "First failure" assert(assertion_condition, &assertion_message) }
    0
}
fn check_indirect() -> Int32 {
    let f = assert
    let message = "Indirect failure"
    f(false, &message)
    0
}
fn check_task() @suspends -> Int32 { check_failure() }
fn main() { record_int(check_success()) }
