import joky/tcp.{type Address, type TcpListener, type TcpStream, type IoError, type ErrorKind, type Shutdown}
import joky/array.{type Array}
import joky/result.{type Result}
import joky/check.{assert}
import joky/task
fn assert_ok(result: Result<Unit, IoError>) { let message = "TCP status"; assert(result.is_ok(), &message) }
fn check_bytes(bytes: Array<UInt8>, expected: UInt64) {
    let message = "TCP bytes"
    assert(bytes.len() == expected, &message)
    if expected > 0 { assert(bytes.get(0).unwrap_or(99) == 0, &message) }
}
fn server(listener: &mut TcpListener) @suspends -> Int32 {
    var stream = match listener.accept() { Ok(stream) => stream, Err(error) => { return 1 } }
    let first = match stream.read(1) { Ok(bytes) => bytes, Err(error) => { return 2 } }
    check_bytes(first, 1)
    var offset: UInt64 = 0
    while offset < 3 {
        let rest = match stream.read(3 - offset) { Ok(bytes) => bytes, Err(error) => { return 3 } }
        offset = offset + check_tail(rest, offset)
    }
    let eof = match stream.read(16) { Ok(bytes) => bytes, Err(error) => { return 4 } }
    check_bytes(eof, 0)
    assert_ok(stream.close())
    42
}
fn check_tail(bytes: Array<UInt8>, offset: UInt64) -> UInt64 {
    let message = "TCP non-UTF8 tail"
    assert(bytes.len() > 0, &message)
    var i: UInt64 = 0
    while i < bytes.len() {
        let expected: UInt8 = if offset + i == 0 { 128 } else { if offset + i == 1 { 255 } else { 42 } }
        assert(bytes.get(i).unwrap_or(0) == expected, &message)
        i = i + 1
    }
    i
}
fn payload() -> Array<UInt8> { var bytes = Array.new::<UInt8>(); bytes.push(0); bytes.push(128); bytes.push(255); bytes.push(42); bytes }
fn client(address: Address) @suspends -> Int32 {
    var stream = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { return 5 } }
    let peer = match stream.peer_addr() { Ok(peer) => peer, Err(error) => { return 6 } }
    let message = "TCP endpoints"
    assert(peer.port() == address.port() && peer.is_ipv6() == address.is_ipv6() && peer.low() == address.low(), &message)
    let local = match stream.local_addr() { Ok(local) => local, Err(error) => { return 7 } }
    assert(local.port() != 0, &message)
    assert(match stream.read(0) { Err(error) => match error.kind() { InvalidInput => true, _ => false }, Ok(bytes) => false }, &message)
    assert(match stream.read(1048577) { Err(error) => match error.kind() { InvalidInput => true, _ => false }, Ok(bytes) => false }, &message)
    let bytes = payload()
    let empty = match stream.write(bytes.slice(0, 0)) { Ok(count) => count, Err(error) => { return 8 } }
    assert(empty == 0, &message)
    var offset: UInt64 = 0
    while offset < bytes.len() {
        let count = match stream.write(bytes.slice(offset, bytes.len())) { Ok(n) => n, Err(_) => return 9 }
        assert(count > 0 && count <= bytes.len() - offset, &message)
        offset += count
    }
    assert_ok(stream.shutdown(Shutdown.Write))
    // A shutdown writer must report Err, without confusing the reader's EOF.
    let rejected = match stream.write(bytes.slice(1, 2)) { Err(error) => true, Ok(count) => false }
    assert(rejected, &message)
    assert_ok(stream.close())
    42
}
fn roundtrip(address: Address) @suspends -> Int32 {
    var listener = match TcpListener.bind(address) { Ok(listener) => listener, Err(error) => { return 10 } }
    let bound = match listener.local_addr() { Ok(bound) => bound, Err(error) => { return 11 } }
    join { | serve(&mut listener) | send(bound) }
    assert_ok(listener.close())
    42
}
fn ipv4() @suspends -> Int32 { roundtrip(Address.ipv4(0x7f000001, 0)) }
fn ipv6() @suspends -> Int32 { roundtrip(Address.ipv6(0, 1, 0)) }
fn errors() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return 1 } }
    let bound = match listener.local_addr() { Ok(bound) => bound, Err(error) => { return 2 } }
    let message = "TCP bind collision"
    assert(match TcpListener.bind(bound) { Err(error) => match error.kind() { AddrInUse => error.os_code() != 0, _ => false }, Ok(other) => false }, &message)
    assert_ok(listener.close())

    42
}
fn pending() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return 1 } }
    listener.accept();
    42
}
fn reuse() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return 1 } }
    let bound = match listener.local_addr() { Ok(bound) => bound, Err(error) => { return 2 } }
    race { | wait_accept(&mut listener) | task.yield_now() }
    join { | serve(&mut listener) | send(bound) }
    42
}
fn main() @suspends -> Int32 { addresses(); if ipv4() != 42 {return 1}; if ipv6() != 42 {return 2}; if errors() != 42 {return 3}; if reuse() != 42 {return 4}; if all() != 42 {return 5}; 0 }

fn assert_value(value: Int32) { let message = "TCP roundtrip"; assert(value == 42, &message) }
fn serve(listener: &mut TcpListener) @suspends { assert_value(server(listener)) }
fn send(address: Address) @suspends { assert_value(client(address)) }
fn wait_accept(listener: &mut TcpListener) @suspends { listener.accept(); }

fn addresses() {
    let endpoint = Address.ipv6(0xfe80000000000000, 1, 443).with_scope(42)
    let message = "TCP numeric address"
    assert(endpoint.scope_id() == 42 && endpoint.port() == 443 && endpoint.high() == 0xfe80000000000000 && endpoint.low() == 1 && endpoint.is_ipv6(), &message)
}

fn send_all(address: Address) @suspends {
    var stream = match TcpStream.connect(address) { Ok(stream) => stream, Err(error) => { assert_value(0); return } }
    assert_ok(stream.write_all(payload()))
    assert_ok(stream.shutdown(Shutdown.Write))
}
fn all() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, Err(error) => { return 1 } }
    let bound = match listener.local_addr() { Ok(bound) => bound, Err(error) => { return 2 } }
    join { | serve(&mut listener) | send_all(bound) }
    42
}
