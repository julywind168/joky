import joky/drop.{ type Drop }
extern fn record(value: Int32) -> Int32
extern fn delayed_value(value: Int32) @suspends -> Int32
extern fn fail_now() @suspends

struct Resource { id: Int32, text: String, count: Int32 }
impl Drop for Resource {
    fn drop(&mut self) { record(self.id); }
}
fn resource(id: Int32) -> Resource {
    let value = Resource { id, text: "owned capture", count: 0 }
    record(-id)
    value
}
fn apply<T, F: FnOnce() @suspends -> T>(operation: F) @suspends -> T { operation() }
fn forward<T, F: FnOnce() @suspends -> T>(operation: F) @suspends -> T { apply(operation) }
struct Holder<F> { operation: F }
fn store<F>(operation: F) -> Holder<F> { Holder { operation } }
fn take<F>(holder: Holder<F>) -> F { holder.operation }

fn closure_direct() @suspends -> Int32 {
    let owner = resource(1)
    let operation = move || @suspends {
        record(100)
        let answer = delayed_value(40)
        answer + owner.id
    }
    operation()
}
fn closure_transfer() @suspends -> Int32 {
    let owner = resource(1)
    let operation = move || @suspends {
        delayed_value(40)
        owner
    }
    let result = forward(take(store(operation)))
    result.id + 41
}
fn closure_nested() @suspends -> Int32 {
    let first = resource(1)
    let inner = move || @suspends { delayed_value(40) + first.id }
    let second = resource(2)
    forward(move || @suspends { let result = apply(inner); result + second.id - 2 })
}
fn closure_argument() @suspends -> Int32 {
    let owner = resource(1)
    let operation = move | value: Int32 | @suspends {
        delayed_value(value) + owner.id
    }
    operation(delayed_value(39))
}
fn closure_pointer() @suspends -> Int32 {
    let operation: fn(Int32) @suspends -> Int32 = move | value | @suspends { delayed_value(value) }
    operation(41)
}
fn named() @suspends -> Int32 { delayed_value(41) }
fn closure_named() @suspends -> Int32 { forward(named) }
fn closure_unused() @suspends -> Int32 {
    let owner = resource(1)
    let operation = move || @suspends { delayed_value(40) + owner.id }
    delayed_value(41)
}
fn closure_failure() @suspends -> Int32 {
    let owner = resource(1)
    apply(move || @suspends -> Int32 { delayed_value(40); fail_now(); owner.id })
}
fn immediate() @suspends -> Int32 { 42 }
fn closure_race() @suspends -> Int32 {
    let owner = resource(1)
    let operation = move || @suspends { delayed_value(40) + owner.id }
    race { apply(operation), immediate() }
}
fn apply_ref<F: FnOnce(&Int32) @suspends @noescape -> Int32>(operation: F, value: &Int32) @suspends @noescape -> Int32 {
    operation(value)
}
fn closure_reference_argument() @suspends -> Int32 {
    let number = 1
    let result = apply_ref(move | value | @suspends { delayed_value(40) + *value }, &number)
    result
}
fn closure_factory() @suspends -> Int32 {
    let factory = move | number: Int32 | { move || @suspends { delayed_value(number) } }
    forward(factory(41))
}

fn closure_borrowed() @suspends -> Int32 {
    let owner = resource(1)
    let operation = || @suspends { delayed_value(40) + owner.id }
    let result = forward(operation)
    assert(owner.text == "owned capture", "borrowed owner remains usable")
    result
}
fn closure_borrowed_mut() @suspends -> Int32 {
    var owner = resource(1)
    let operation = || @suspends {
        let result = delayed_value(40)
        owner.count += 1
        result + owner.id
    }
    let result = apply(operation)
    assert(owner.count == 1, "exclusive capture updates caller storage")
    result
}
fn closure_borrowed_reference() @suspends -> Int32 {
    let owner = resource(1)
    let view = &owner.text
    let result = apply_ref(|value| @suspends {
        delayed_value(40)
        assert(view == "owned capture", "reference capture remains live")
        *value + 41
    }, &owner.id)
    assert(owner.id == 1, "noescape callback releases capture loans")
    result
}
fn closure_borrowed_unused() @suspends -> Int32 {
    let owner = resource(1)
    let operation = || @suspends { delayed_value(40) + owner.id }
    delayed_value(41)
}
fn closure_borrowed_failure() @suspends -> Int32 {
    let owner = resource(1)
    apply(|| @suspends -> Int32 { delayed_value(40); fail_now(); owner.id })
}
fn closure_borrowed_race() @suspends -> Int32 {
    let owner = resource(1)
    let operation = || @suspends { delayed_value(40) + owner.id }
    let result = race { operation(), immediate() }
    assert(owner.id == 1, "race stops borrowed callback before resuming parent")
    result
}
fn closure_borrowed_empty() @suspends -> Int32 {
    let operation = || @suspends { delayed_value(41) }
    operation()
}
