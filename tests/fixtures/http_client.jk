import joky/http
import joky/tcp.{type BufferedTcp, type TcpListener, type Address}
import joky/task
import joky/tls

fn inspect_headers(stream: &mut BufferedTcp, port: UInt16) @suspends -> (String, String, Bool) {
    var length = ""
    var media = ""
    var key = false
    var host = false
    while true {
        let h = stream.read_line(256)!!
        if h.is_empty() { break }
        if h == "Host: 127.0.0.1:{port}" { host = true }
        if h == "Idempotency-Key: abc" { key = true }
        if h.starts_with("Content-Length: ") { length = h.substring(16, h.byte_length())! }
        if h.starts_with("Content-Type: ") { media = h.substring(14, h.byte_length())! }
    }
    assert(host, "correct authority")
    (length, media, key)
}
fn inspect(stream: &mut BufferedTcp, i: Int32, port: UInt16) @suspends {
    let first = stream.read_line(256)!!
    let expected = match i { 0 => "POST", 4 => "POST", 9 => "PUT", 10 => "HEAD", 11 => "OPTIONS", _ => "GET" }
    assert(first == "{expected} / HTTP/1.1", "one request per call")
    let (length, media, key) = inspect_headers(stream, port)
    if i == 0 {
        assert(key && media == "text/plain" && length == "6", "text POST headers")
        assert(String.from_utf8(stream.read_exact(6)!!)! == "你好", "UTF-8 body")
    } else if i == 4 { assert(media == "application/json" && length == "0", "empty JSON POST") }
    else if i == 9 {
        assert(media == "application/octet-stream" && length == "2", "binary PUT headers")
        let bytes = stream.read_exact(2)!!
        assert(bytes[0] == 255 && bytes[1] == 0, "binary PUT body")
    }
}
fn payload(i: Int32) -> String {
    match i {
        0 => "HTTP/1.1 103 Early Hints\r\n\r\nHTTP/1.1 409 Conflict\r\nTransfer-Encoding: Chunked\r\nX-Test: yes\r\n\r\n2\r\nab\r\n1\r\nc\r\n0\r\n\r\n",
        1 => "HTTP/1.1 200 OK\r\nContent-Length: 3\r\nTransfer-Encoding: chunked\r\n\r\n",
        2 => "HTTP/1.1 200 OK\r\nContent-Length: 4\r\n\r\n",
        3 => "HTTP/1.1 200 OK\r\n\r\nabc",
        4 => "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\na",
        5 => "HTTP/1.1 304 Not Modified\r\nContent-Length: 4294967296\r\n\r\n",
        6 => "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n4\r\n",
        7 => "HTTP/1.1 200 OK\r\n\r\nabcd",
        9 => "HTTP/1.1 204 No Content\r\n\r\n",
        11 => "HTTP/1.1 204 No Content\r\n\r\n",
        10 => "HTTP/1.1 200 OK\r\nContent-Length: 4294967296\r\n\r\n",
        _ => "HTTP/1.1 200 OK\r\nContent-Length: 3\r\n\r\na"
    }
}
fn peer(var listener: TcpListener, port: UInt16) @suspends {
    for i in 0 .. 12 {
        var stream = BufferedTcp.new(listener.accept()!)
        inspect(&mut stream, i, port)
        stream.write_all(payload(i).into_bytes())!
        if i == 8 { task.sleep(250ms) }
    }
    var silent = listener.accept()!
    assert(!silent.read(1024)!.is_empty(), "client started TLS handshake")
    while !silent.read(16384)!.is_empty() {}
}
fn check_methods(client: &http.Client) @suspends {
    let put = client.request(http.Method.Put, "/", [http.Header { name: "Content-Type", value: "application/octet-stream" }], [255, 0])!
    assert(put.status == 204, "binary PUT accepted")
    let head = client.request(http.Method.Head, "/", [], [])!
    assert(head.status == 200 && head.body.is_empty(), "HEAD length describes the representation")
    let options = client.request(http.Method.Options, "/", [], [])!
    assert(options.status == 204, "OPTIONS accepted")
}
fn calls(port: UInt16) @suspends {
    var client = http.Client.http("127.0.0.1", port)!
    client.max_body = 3
    assert(client.get("/\r\nX: bad").is_err(), "reject injected target before dialing")
    assert(client.request(http.Method.Get, "/", [http.Header { name: "Foo", value: "x\r\ny" }], []).is_err(), "reject injected header")
    assert(match client.request(http.Method.Post, "/", [
        http.Header { name: "content-TYPE", value: "text/plain" }, http.Header { name: "Content-Type", value: "image/png" }
    ], []) { Err(InvalidRequest) => true, _ => false }, "reject duplicate media types before dialing")
    let r = client.request(http.Method.Post, "/", [http.Header { name: "Idempotency-Key", value: "abc" },
        http.Header { name: "Content-Type", value: "text/plain" }], "你好".into_bytes())!
    assert(r.status == 409 && String.from_utf8(r.body)! == "abc", "non-2xx and chunked body")
    assert(match client.get("/") { Err(InvalidResponse) => true, _ => false }, "ambiguous response")
    assert(match client.get("/") { Err(SizeLimit) => true, _ => false }, "fixed length limit")
    assert(String.from_utf8(client.get("/")!.body)! == "abc", "close-delimited body")
    assert(client.post_json("/", "").is_err(), "truncated POST response is returned without retry")
    assert(client.get("/")!.body.is_empty(), "304 has no body")
    assert(match client.get("/") { Err(SizeLimit) => true, _ => false }, "chunk size limit")
    assert(match client.get("/") { Err(SizeLimit) => true, _ => false }, "close-delimited size limit")
    client.exchange_timeout = 50ms
    assert(match client.get("/") { Err(ExchangeTimeout) => true, _ => false }, "whole response deadline")
    client.exchange_timeout = 2s
    check_methods(&client)
    var secure = http.Client.https("127.0.0.1", port, tls.ClientConfig.web_roots()!)!
    secure.connect_timeout = 40ms
    assert(match secure.get("/") { Err(ConnectTimeout) => true, _ => false }, "connect deadline covers handshake")
}
fn main() @suspends {
    var listener = TcpListener.bind(Address.ipv4(0x7f000001, 0))!
    let port = listener.local_addr()!.port()
    join { peer(listener, port), calls(port) }
}
