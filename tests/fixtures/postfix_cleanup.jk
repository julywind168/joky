import joky/drop.{type Drop}
import joky/option.{type Option, Some, None}
import joky/result.{type Result, Ok, Err}

extern fn record(n: Int32) -> Int32
struct Resource { text: String, id: Int32 }
impl Drop for Resource { fn drop(&mut self) { record(self.id); } }
fn make(ok: Bool) -> Result<Resource, Resource> {
    if ok { let value = Resource { text: "success", id: 42 }; record(-42); Ok(value) }
    else { let value = Resource { text: "failure", id: 7 }; record(-7); Err(value) }
}
fn propagate(ok: Bool) -> Result<Int32, Resource> {
    let local = Resource { text: "local", id: 1 }
    record(-1)
    let value = make(ok)?
    Ok(value.id)
}
fn check() -> Int32 {
    let success = propagate(true)!
    let failure = match propagate(false) { Ok(n) => n, Err(value) => value.id }
    record(99)
    if success == 42 && failure == 7 { 42 } else { 0 }
}
fn force_failure() -> Int32 {
    let local = Resource { text: "local", id: 1 }
    record(-1)
    make(false)!.id
}
