type Wide = UInt64
struct Empty {}
struct Pair { low: Int32 ,high: Wide }
enum Choice { Empty Value((Pair, Bool)) }
fn identity<T>(value: T) -> T { value }
fn first<T, U>(left: T, right: U) -> T { left }
fn choose<T>(left: T, right: T, flag: Bool) -> T { if flag { left } else { right } }
fn swap<T, U>(pair: (T, U)) -> (U, T) { let (a, b) = pair; (b, a) }
fn duplicate<T>(value: T) -> (T, T) { (value, value) }
fn compose<T>(value: T) -> T { identity::<T>(identity(value)) }
fn rotate<T, U>(pair: (T, U)) -> (T, U) { swap(swap(pair)) }
fn mutable<T>(a: T, b: T) -> T { var x: T = a let saved = x x = b saved }
fn recurse<T>(value: T, count: Int32) -> T { if count == 0 { return value } recurse(value, count - 1) }
fn even<T>(value: T, count: Int32) -> T { if count == 0 { value } else { odd(value, count - 1) } }
fn odd<U>(value: U, count: Int32) -> U { if count == 0 { value } else { even(value, count - 1) } }
fn unused<T>() -> Int32 { 7 }
fn discard<T>(value: T) -> Unit { let _ = value }
fn fixed<T>(n: Int32) -> Int32 { n + 1 }
fn inferred() -> Int32 {
    let wide: Int64 = 4294967295
    let a = choose(1, wide, true)
    let b = choose(wide, 2, false)
    let c = first(3, true)
    let d = identity::<Int64>(4294967295)
    let e = identity::<UInt64>(0xffff_ffff_ffff_ffff)
    let f = first::<Int64, Bool>(4, true)
    let g = 1 + identity::<Int64>(2)
    let h = if true { 4294967295 } else { identity(wide) }
    let tuple: (Wide, Bool) = identity::<(Wide, Bool)>((0xffff_ffff_ffff_ffff, true))
    let (n, flag) = tuple
    let shadow = first( (let local: Int64 = 9; local), local)
    if a == 1 && b == 2 && c == 3 && d == wide && e == 0xffff_ffff_ffff_ffff
        && f == 4 && g == 3 && h == wide && n == e && flag && shadow == 9 { 42 } else { -1 }
}
fn aggregates() -> Int32 {
    let p = Pair { low: -1 ,high: 0xffff_ffff_ffff_ffff }
    let e = identity(Choice.Value((p, true)))
    let (saved, _) = duplicate(e)
    let value = match saved {
        | Empty => 0
        | Value(payload) => { let (pair, flag) = rotate(payload) if flag { pair.low } else { 0 } }
    }
    let pair = compose(p)
    let empty = identity(Empty {})
    let unit = identity({})
    let z = identity((unit, empty))
    let (_, blank) = duplicate(z)
    discard(blank)
    let (a, b) = swap((1, false))
    if value == -1 && pair.high == 0xffff_ffff_ffff_ffff && !a && b == 1 { 42 } else { -1 }
}
fn snapshots() -> Int32 {
    var p = Pair { low: 7 ,high: 8 }
    let saved = mutable(p, { p.low = 99 p })
    var n: Int64 = 0 var i = 0
    while i < 5 {
        let old = identity(n)
        n = choose(old, n + 1, false)
        i = i + 1
    }
    if saved.low == 7 && p.low == 99 && n == 5 { 42 } else { -1 }
}
fn check() -> Int32 {
    if inferred() == 42 && aggregates() == 42 && snapshots() == 42
        && recurse(identity(42), 12) == 42 && even(42, 13) == 42
        && unused::<Bool>() == 7 && fixed::<Unit>(41) == 42 { 42 } else { -1 }
}
