import joky/array.{type Array}
import joky/check.{assert}

struct Scalars { first: Rune, second: Rune }
enum ScalarChoice { Empty, Value(Rune) }
impl Scalars {
    const SAME: Bool = '中' == '\u{4e2d}'
    const DIFFERENT: Bool = '中' != '文'
}
fn identity<T>(value: T) -> T { value }
fn relay(value: Rune) -> Rune { value }
fn invoke(f: fn(Rune) -> Rune, value: Rune) -> Rune { f(value) }
fn task(value: Rune) @suspends -> Rune { relay(value) }
fn rune_check() -> Int32 {
    assert(classify('\n') == 1, "Rune literal arm")
    assert(classify('中') == 2, "Unicode literal arm")
    assert(classify('\0') == 3 && classify('\u{10ffff}') == 3, "Rune wildcard endpoints")
    assert(match ('中', true) { ('中', false) => false, ('中', true) => true, _ => false }, "Nested Rune coverage")
    { let assertion_condition = Scalars.SAME && Scalars.DIFFERENT; let assertion_message = "Rune constant comparison"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = '\"' == '"' && '\'' == '\u{27}'; let assertion_message = "Character quote escapes"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = '\0'.to_u32() == 0 && '\u{10ffff}'.to_u32() == 0x10ffff; let assertion_message = "Scalar endpoints"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Rune.from_u32(0xd800).is_none() && Rune.from_u32(0xdfff).is_none(); let assertion_message = "Surrogate endpoints"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = Rune.from_u32(0x110000).is_none() && Rune.from_u32(UInt32.MAX).is_none(); let assertion_message = "Scalar upper limit"; assert(assertion_condition, &assertion_message) }
    var values = Array.new::<Rune>()
    values.push('中')
    values.push('🙂')
    let pair = Scalars { first: values.get(0).unwrap_or('\0'), second: values.get(1).unwrap_or('\0') }
    { let assertion_condition = pair.first == '中' && pair.second == '🙂'; let assertion_message = "Four-byte Rune storage"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = values.set(0, '\u{d7ff}'); let assertion_message = "Rune store"; assert(assertion_condition, &assertion_message) }
    { let assertion_condition = values.get(0).unwrap_or('\0').to_u32() == 0xd7ff; let assertion_message = "Rune load"; assert(assertion_condition, &assertion_message) }
    let choice = ScalarChoice.Value(identity::<Rune>(invoke(relay, '🙂')))
    let value = match choice { ScalarChoice.Empty => '\0', ScalarChoice.Value(value) => value }
    { let assertion_condition = value == '🙂'; let assertion_message = "Rune aggregate and indirect calls"; assert(assertion_condition, &assertion_message) }
    42
}

fn classify(value: Rune) -> Int32 {
    match value { '\n' => 1, '中' => 2, _ => 3 }
}
