type Wide = Int64
struct Number { value: Wide, small: Int32, flag: Bool }
enum Choice { Empty, Value((Wide, Bool)) }
fn add(a: Wide, b: Wide) -> Wide { a + b }
fn sub(a: Wide, b: Wide) -> Wide { a - b }
fn mul(a: Wide, b: Wide) -> Wide { a * b }
fn divide(a: Wide, b: Wide) -> Wide { a / b }
fn negate(a: Wide) -> Wide { -a }
fn max() -> Wide { 9223372036854775807 }
fn min() -> Wide { -9223372036854775808 }
fn literals() -> Wide {
    let base: Wide = 3000000000
    add(base, 42)
}
fn contexts() -> Wide {
    var n: Wide = 3000000000
    n = 4000000000
    var p = Number { value: 5000000000, small: 2, flag: true }
    p.value = 6000000000
    let (a, (b,)): (Wide, (Wide,)) = (7000000000, (8000000000,))
    let c = match Choice.Value((9000000000, true)) {
        | Empty => 10000000000
        | Value(pair) => { let (value, _) = pair value }
    }
    n + p.value + a + b + c
}
fn tuple_result() -> (Wide, (Wide, Bool)) { (3000000000, (4000000000, true)) }
fn tuple_branch(flag: Bool) -> (Wide, (Wide, Bool)) {
    if flag { (5000000000, (6000000000, true)) } else { tuple_result() }
}
fn aggregate_calls() -> Wide {
    let (a, (b, flag)) = tuple_branch(true)
    let p = Number { value: a, small: 7, flag: flag }
    match Choice.Value((p.value + b, flag)) { | Empty => 0 | Value(pair) => { let (n, _) = pair n } }
}
fn comparisons(n: Wide) -> Wide {
    if !(0 < n && n > -1 && n >= 1 && 1 <= n && n != 0 && n == n) { return -1 }
    if n < 0 || n <= -1 || 0 >= n || 1 > n || n == 0 || n != n { return -2 }
    42
}
fn operand_context() -> Wide {
    let n: Wide = 4000000000
    let a = 3000000000 + n
    let b = (3000000000 + 1) + n
    let c = 3000000000 + (let inner: Wide = n; inner)
    let d = if false { 3000000000 } else { n }
    a + b + c + d
}
fn branch_returns(flag: Bool) -> Wide {
    if flag { return 3000000000 + 42 }
    if false { 9223372036854775807 } else { -9223372036854775808 }
}
fn loops() -> Wide {
    var n: Wide = 3000000000
    var i: Wide = 0
    while i < 5 { i = i + 1 if i == 2 { continue } n = n + i if i == 4 { break } }
    n
}
fn recurse(n: Wide) -> Wide {
    if n == 0 { return 3000000000 }
    recurse(n - 1) + 1
}
fn snapshots() -> Wide {
    var n: Wide = 3000000000
    let (a, b) = (n, { n = n + 1 n })
    add(a, { n = n + 1 b }) + n
}
fn ordered(a: Wide, b: Wide) -> Wide {
    var score: Wide = 0
    if a == b { score = score + 1 }
    if a != b { score = score + 2 }
    if a < b { score = score + 4 }
    if a <= b { score = score + 8 }
    if a > b { score = score + 16 }
    if a >= b { score = score + 32 }
    score
}
fn many(a: Wide, small: Int32, b: Wide, c: Wide, d: Wide, flag: Bool, e: Wide, f: Wide, g: Wide, h: Wide, i: Wide, unit: Unit, j: Wide) -> (Wide, Int32) {
    if flag { (a + b + c + d + e + f + g + h + i + j, small) } else { (0, 0) }
}
fn stack_arguments() -> Wide {
    let (sum, small) = many(3000000000, 7, -4000000000, 5000000000, -6000000000, true, 7000000000, -8000000000, 9000000000, -10000000000, 11000000000, {}, -12000000000)
    if small == 7 { sum } else { 0 }
}
fn check() -> Int32 {
    if literals() == 3000000042 && contexts() == 34000000000
        && aggregate_calls() == 11000000000 && comparisons(4000000000) == 42
        && operand_context() == 25000000001 && branch_returns(true) == 3000000042
        && branch_returns(false) == min() && loops() == 3000000008
        && recurse(5) == 3000000005 && snapshots() == 9000000003
        && divide(min(), -1) == min() && negate(min()) == min()
        && add(max(), 1) == min() && sub(min(), 1) == max()
        && stack_arguments() == -5000000000
        && ordered(min(), max()) == 14 && ordered(max(), min()) == 50 && ordered(min(), min()) == 41
        && mul(max(), 2) == -2 && divide(-7, 3) == -2
        && divide(7, -3) == -2 { 42 } else { -1 }
}
