import joky/json/typed as typed.{type ToJson, type FromJson}
import joky/result.{Ok, Err}
import joky/option.{type Option}
import joky/check.{require}
import joky/array.{type Array}
import joky/map.{type Map}

fn ensure(ok: Bool) { let message = "typed JSON contract" require(ok, &message) }
fn decoded<T: FromJson>(text: String) -> T {
    match typed.decode::<T>(&text) {
        | Ok(value) => value
        | Err(_) => { ensure(false) decoded::<T>("null") }
    }
}
fn encoded<T: ToJson>(value: &T) -> String {
    match typed.encode(value) { | Ok(text) => text | Err(_) => { ensure(false) "" } }
}
fn verify_fields(fields: &Map<String, Array<Option<UInt64>>>) {
    ensure(fields.len() == 2)
    let key = "items"
    let values = fields.value_ref(&key)
    ensure(values.len() == 3)
    ensure(values.get(0).unwrap_or(Option.Some(1)).is_none())
    ensure(values.get(1).unwrap_or(Option.None).unwrap_or(0) == 18446744073709551615)
    ensure(values.get(2).unwrap_or(Option.None).unwrap_or(1) == 0)
    let empty = ""
    ensure(fields.value_ref(&empty).is_empty())
}
fn main() {
    let fields = decoded::<Map<String, Array<Option<UInt64>>>>("{{\"items\":[null,18446744073709551615,0],\"\":[]}}")
    verify_fields(&fields)
    let output = encoded(&fields)
    let recovered = decoded::<Map<String, Array<Option<UInt64>>>>(output)
    verify_fields(&recovered)
    verify_fields(&fields)
    let again = decoded::<Map<String, Array<Option<UInt64>>>>(encoded(&recovered))
    verify_fields(&again)
}
