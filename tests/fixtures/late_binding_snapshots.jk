import joky/domain
import joky/task
import joky/check
struct State {n:Int32}
struct Reply {pub n:Int32,tag:UInt64}
fn assert(ok:Bool) {let message="snapshot record versions" check.assert(ok,&message)}
fn make(n:Int32)->State {State{n:n}}
fn one(s:&State)->Reply {Reply{n:s.n,tag:18446744073709551615}}
fn two(a:&State,b:&State)->Reply {Reply{n:a.n+b.n,tag:18446744073709551615}}
fn verify(p:Reply,n:Int32) {assert(p.n==n && p.tag==18446744073709551615)}
fn hold(directory:domain.DirectoryHandle) @suspends {
    let a=domain.create(make,7) let b=domain.create(make,10)
    let ar=a.read_handle() let br=b.read_handle()
    let single=domain.snapshot_from(ar,one)
    let joint=domain.snapshot_pair(ar,br,two)
    var access=domain.access_set() access.include(ar) access.include(br)
    let set=domain.snapshot_set(access)
    assert(directory.insert(1,a.handle()).is_ok())
    while domain.lookup::<State>(directory,1).is_some() {task.yield_now()}
    verify(single.value(),7)
    verify(joint.value(),17)
    verify(domain.read_snapshot(&set,ar,one),7)
    verify(domain.read_snapshot(&set,br,one),10)
    assert(match single.check(){Conflict=>true,_=>false})
    assert(match joint.check(){Conflict=>true,_=>false})
    assert(match set.check(){Conflict=>true,_=>false})
    let fresh=domain.snapshot_from(ar,one)
    let fresh_pair=domain.snapshot_pair(ar,br,two)
    verify(fresh.value(),107)
    verify(fresh_pair.value(),117)
    a.close() b.close()
    verify(domain.read_snapshot(&set,ar,one),7)
    verify(single.value(),7)
}
fn ready(directory:domain.DirectoryHandle) @suspends ->Bool {domain.lookup::<State>(directory,1).is_some()}
fn release(directory:domain.DirectoryHandle) @suspends ->Bool {
    match domain.lookup::<State>(directory,1) {Some(a)=>directory.remove(1,a),None=>false}
}
