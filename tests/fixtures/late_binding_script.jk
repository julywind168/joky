import joky/domain
import joky/task
import joky/check
struct Room { n:Int32 }
fn assert(ok:Bool) { let message="late binding Script" check.assert(ok,&message) }
fn make(n:Int32)->Room { Room{n:n} }
fn read(room:&Room)->Int32 {room.n}
fn sum(a:&Room,b:&Room)->Int32 {a.n+b.n}
fn transfer(a:&mut Room,b:&mut Room,n:Int32)->Int32 {
    a.n=a.n-n
    b.n=b.n+n
    a.n
}
fn hold(directory:domain.DirectoryHandle) @suspends {
    let a=domain.create(make,40)
    let b=domain.create(make,2)
    assert(directory.insert(1,a.handle()).is_ok())
    assert(directory.insert(2,b.handle()).is_ok())
    while domain.lookup::<Room>(directory,1).is_some() {task.yield_now()}
    // This v1 flow must resolve the v2 operation with its original signature.
    assert(domain.write_pair(a.handle(),b.handle(),transfer,2)==20)
    assert(domain.read_pair(a.read_handle(),b.read_handle(),sum)==142)
}
fn probe(directory:domain.DirectoryHandle) @suspends ->Int32 {
    match domain.lookup::<Room>(directory,1) {
        Some(a)=>match domain.lookup::<Room>(directory,2) {
            Some(b)=>domain.read_pair(a,b,sum), None=>-1
        }, None=>-1
    }
}
fn release(directory:domain.DirectoryHandle) @suspends ->Bool {
    match domain.lookup::<Room>(directory,1) {Some(a)=>directory.remove(1,a),None=>false}
}
