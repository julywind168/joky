import joky/dns as dns
import joky/check.{require}
import joky/string

// A finite system lookup using local name service, without public DNS access.
fn main() @suspends -> Int32 {
    let addresses = match dns.lookup("localhost", 443) {
        | Ok(addresses) => addresses
        | Err(error) => { println(error.message) return 1 }
    }
    let message = "localhost returns at least one address"
    require(addresses.len() > 0, &message)
    println("localhost resolved")
    0
}
