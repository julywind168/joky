struct Resource { id: Int32, values: Array<Int32> }

fn main() {
    var values = [Some(Resource { id: 1, values: [] })]
    // Borrow the enum in place, then borrow its resource payload exclusively.
    match &mut values[0] {
        Some(item) => { item.id = 42; item.values.push(42) }
        None => {}
    }
    match &values[0] {
        Some(item) => println(item.values[0])
        None => println(0)
    }
    var count = Some(0)
    // Copy payloads also become mutable references in an exclusive match.
    match &mut count { Some(n) => *n = 42, None => {} }
    match count { Some(n) => println(n), None => println(0) }
    // The resource storage is reclaimed automatically after its scope ends.
    values.pop();
}
