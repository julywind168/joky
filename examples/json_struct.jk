import joky/json/typed.{type ToJson, type FromJson, type Context, type MappingError}
import joky/json.{type Value}
import joky/result.{type Result, Ok, Err}
import joky/option.{type Option}
import joky/check.{assert, panic}

struct User { name: String, age: UInt8, nickname: Option<String> }
impl ToJson for User {
    fn to_json(&self, context: &mut Context) @noescape -> Result<Value, MappingError> {
        var fields = context.object()?
        context.put_field(&mut fields, "name", &self.name)?
        context.put_field(&mut fields, "age", self.age)?
        context.put_field(&mut fields, "nickname", &self.nickname)?
        Ok(Value.Object(fields))
    }
}
impl FromJson for User {
    fn from_json(value: Value, context: &mut Context) @noescape -> Result<Self, MappingError> {
        var fields = context.read_object(value)?
        let name = context.take_field::<String>(&mut fields, "name")?
        let age = context.take_field::<UInt8>(&mut fields, "age")?
        let nickname = context.take_field::<Option<String>>(&mut fields, "nickname")?
        context.finish_object(fields)?
        Ok(User { name, age, nickname })
    }
}
fn ensure(ok: Bool) { assert(ok, "typed JSON example") }
fn main() {
    let input = "{{\"name\":\"Ada\",\"age\":37}}"
    match typed.decode::<User>(&input) {
        Ok(user) => {
            println(user.name)
            println(user.age)
            match typed.encode(&user) {
                Ok(output) => { ensure(typed.decode::<User>(&output).is_ok()) }
                Err(_) => panic("typed JSON example")
            }
        }
        Err(_) => panic("typed JSON example")
    }
    let invalid = "{{\"name\":\"Ada\",\"age\":256}}"
    match typed.decode::<User>(&invalid) {
        Err(typed.CodecError.Mapping(error)) => { println(error.pointer()) }
        _ => panic("typed JSON example")
    }
}
