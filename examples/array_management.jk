import joky/io.{println}

import joky/array.{type Array}
struct Resource { id: Int32, values: Array<Int32> }
fn resource(id: Int32) -> Resource { Resource { id: id, values: Array.new::<Int32>() } }
fn main() {
    var values = Array.with_capacity::<Resource>(4)
    values.push(resource(20)); values.push(resource(21)); values.push(resource(22))
    values.swap(0, 2)
    println(values.borrow_ref(0).id)
    values.truncate(1)
    println(int32(values.len()))
    values.clear()
    println(int32(values.capacity()))
    values.push(resource(42))
    println(values.borrow_ref(0).id)
    println(if values.swap(0, 99) { 1 } else { 0 })
}
