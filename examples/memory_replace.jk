import joky/array.{type Array}
extern fn print_int(value: Int32)

struct Resource { id: Int32 values: Array<Int32> }
fn resource(id: Int32) -> Resource {
    Resource { id: id values: Array.new::<Int32>() }
}
fn exchange<T>(value: &mut T, next: T) -> T {
    memory.replace(value, next)
}
fn main() {
    var pending = Some(resource(42))
    match pending.take() {
        | Some(item) => print_int(item.id)
        | None => print_int(0)
    }
    print_int(if pending.is_none() { 1 } else { 0 })

    var resources = Array.new::<Resource>()
    resources.push(resource(20))
    let previous = exchange(resources.borrow_mut_ref(0), resource(22))
    print_int(previous.id + resources.borrow_ref(0).id)
}
