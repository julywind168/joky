import joky/mem

struct Resource { id: Int32, values: Array<Int32> }
fn resource(id: Int32) -> Resource {
    Resource { id, values: [] }
}
fn exchange<T>(value: &mut T, next: T) -> T {
    mem.replace(value, next)
}
fn main() {
    var pending = Some(resource(42))
    match pending.take() {
        Some(item) => println(item.id)
        None => println(0)
    }
    println(if pending.is_none() { 1 } else { 0 })

    var resources = [resource(20)]
    let previous = exchange(&mut resources[0], resource(22))
    println(previous.id + resources[0].id)
}
