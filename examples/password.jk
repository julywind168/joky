import joky/password
import joky/result
import joky/io.{ println }

fn main() @suspends {
    let encoded = password.hash("example password").unwrap()
    println(&encoded)
    println(password.verify("example password", encoded.clone()).unwrap())
    println(password.verify("wrong password", encoded.clone()).unwrap())
    println(password.needs_rehash(&encoded).unwrap())
}
