// Synchronous closures infer their callable capability and borrowing contract.
fn apply<T, U, F: FnOnce(T) -> U>(value: T, transform: F) -> U { transform(value) }

fn main() {
    let offset = 10
    let result = Option.Some(32).map(|x| { x + offset }).unwrap_or(0)
    println(result)

    var count = 0
    {
        var increment = || { count = count + 1 }
        increment()
        increment()
    }
    println(count)

    let value = "closure"
    let take = move || -> String { value }
    let result = apply(0, move |x| { let owned = take() owned })
    println(result)
}
