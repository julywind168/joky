import joky/io.{print, println}
import joky/show.{type Show}
import joky/string.{type StringBuilder}
import joky/array.{type Array}

struct Player { name: String score: Int32 }
impl Show for Player {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(&self.name)
        output.push(':')
        let score = self.score
        score.show(output)
    }
}
fn main() {
    let player = Player { name: "Joky" score: 42 }
    let message = f"player={player}, next={player.score + 1}"
    println(&message)
    var scores = Array.new::<Int32>() scores.push(41) scores.push(42)
    let prefix = "scores=" print(&prefix) println(&scores)
    println(&player)
}
