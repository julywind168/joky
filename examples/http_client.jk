// Start a loopback HTTP service, make two requests, then drain it.
import http_server.{handle}
import joky/http
import joky/shutdown
import joky/tcp

fn call_service(port: UInt16, stop: &shutdown.Controller) @suspends {
    let client = http.Client.http("127.0.0.1", port)!
    let health = client.get("/health")!
    println("health {health.status}")
    let reply = client.post_json("/echo", "{{\"message\":\"hello\"}}")!
    println(String.from_utf8(reply.body)!)
    stop.request();
}
fn main() @suspends {
    var listener = tcp.listen("127.0.0.1", 0)!
    let port = listener.local_addr()!.port()
    let stop = shutdown.create()
    let (served, _) = join { | http.serve(listener, &stop, http.defaults(), handle) | call_service(port, &stop) }
    served!
}
