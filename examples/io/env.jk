import joky/env

fn main() -> Result(Unit, String) effects { env } {
    let directory = env.current_dir()?
    let temporary = env.temp_dir()?
    println("current: {directory}")
    println("temp: {temporary}")
    for argument in env.args()? { println("arg: {argument}") }
    match env.get("PATH")? {
        Some(path) => println("PATH: {path}")
        None => println("PATH is unset")
    }
    Ok(())
}
