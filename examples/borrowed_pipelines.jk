import joky/iter

fn nonempty(value: &String) @noescape -> Bool { value != "" }
fn byte_length(value: &String) @noescape -> UInt64 { value.byte_length() }

fn shared_demo() {
    let names = ["Alice", "", "Bob", "Carol"]
    let lengths = iter.shared(&names)
        .filter(nonempty)
        .map(byte_length)
        .take(2)

    for index, length in lengths { println("{index}: {length}") }
    println(names.len()) // The source still owns all four strings.
}

fn exclusive_demo() {
    var scores = [1, 0, 2, 3]
    let threshold = 1
    for score in iter.exclusive(&mut scores)
        .filter(|score| { *score >= threshold })
        .take(2)
    {
        *score += 10
    }
    for score in &scores { println(score) }
}

fn main() {
    shared_demo()
    exclusive_demo()
}
