import joky/iter

fn shared_demo() {
    let names = ["Alice", "", "Bob", "Carol"]
    let lengths = iter.shared(&names)
        .filter(|value| { value != "" })
        .map(|value| { value.byte_length() })
        .take(2)

    for index, length in lengths { println("{index}: {length}") }
    println(names.len()) // The source still owns all four strings.

    let greetings = {
        let labels = ["Alice", "Bob"]
        iter.shared(&labels).map(|label| { "Hello, {label}!" }).collect()
    }
    assert(greetings[0] == "Hello, Alice!" && greetings[1] == "Hello, Bob!", "collected greetings")
}

fn exclusive_demo() {
    var scores = [1, 0, 2, 3]
    let threshold = 1
    for score in iter.exclusive(&mut scores)
        .filter(|score| { *score >= threshold })
        .take(2)
    {
        *score += 10
    }
    for score in &scores { println(score) }
}

fn main() {
    shared_demo()
    exclusive_demo()
}
