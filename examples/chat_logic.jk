import chat_contract.{type Host, type Action, type Call, type RoomInit, type RoomKey, type AccountInit, type Client}
import joky/domain
import joky/outbox
import joky/mem
import joky/task
import joky/array.{type Array}
import joky/option.{type Option, Some, None}

struct Route { live: Bool, id: UInt64, output: outbox.Handle, stop: outbox.Handle }
#state
struct Account { route: Route, room: UInt64, balance_cents: UInt64 }
#state
struct Room { name: String, members: Array<Route>, retired: Bool }
enum RoomStatus { Pending, Starting, Ready, Dormant }
struct RoomEntry { name: String, status: RoomStatus, waiters: Array<outbox.Handle> }
#state
struct Catalog { rooms: Array<RoomEntry> }
enum Command { Welcome, Balance, Join(String), Leave, Say(String), Invalid, Disconnect }
fn make_catalog(_: Unit) -> Catalog { Catalog { rooms: Array.new::<RoomEntry>() } }
fn make_room(name: String) -> Room { Room { name: name, members: Array.new::<Route>(), retired: false } }
fn make_account(account: Account) -> Account { account }
fn account_view(state: &Account) -> Account { *state }

// Protocol: decode once, then run one command through bounded recovery.
impl Command {
    fn clone(&self) -> Command {
        match self {
            Welcome => Command.Welcome, Balance => Command.Balance, Join(room) => Command.Join(room.clone()),
            Leave => Command.Leave, Say(text) => Command.Say(text.clone()),
            Invalid => Command.Invalid, Disconnect => Command.Disconnect
        }
    }
}
fn parse(line: String) -> Command {
    let separator = line.find(" ").unwrap_or(line.byte_length())
    let verb = line.substring(0, separator)!
    let argument = if separator < line.byte_length() { line.substring(separator + 1, line.byte_length())! } else { "" }
    if verb.equals("join") && !argument.is_empty() && argument.find(" ").is_none() && argument.find("\t").is_none() {
        Command.Join(argument)
    } else if line.equals("balance") { Command.Balance }
    else if line.equals("leave") { Command.Leave }
    else if verb.equals("say") && !argument.is_empty() { Command.Say(argument) }
    else { Command.Invalid }
}

fn handle_line(ctx: Host, id: UInt64, line: String) @suspends -> Bool {
    run_command(ctx, id, parse(line))
}
fn split(request: Call) -> (Host, UInt64, Action) {
    let Call { host, id, action } = request
    (host, id, action)
}
fn dispatch(request: Call) @suspends -> Bool {
    let (ctx, id, action) = split(request)
    match action {
        Action.Welcome => run_command(ctx, id, Command.Welcome),
        Action.Line(line) => handle_line(ctx, id, line),
        Action.Disconnect => run_command(ctx, id, Command.Disconnect)
    }
}

// Command operations keep validation, business rules and messages in one version.
enum Retry { Changed, Stopped }
type Attempt = Result<Result<Route, Retry>, domain.DomainAccessError>
fn check_account(account: &Account, expected: UInt64) -> Result<Route, Retry> {
    if !account.route.live { Err(Retry.Stopped) }
    else if account.room != expected { Err(Retry.Changed) }
    else { Ok(account.route) }
}
fn check_member(account: &Account, room: &Room, expected: UInt64) -> Result<Route, Retry> {
    let route = check_account(account, expected)?
    if member(room, route.id) { Ok(route) } else { Err(Retry.Stopped) }
}
fn reply(account: domain.WriteHandle<Account>, command: &Command, excluded: &Array<UInt64>) @suspends -> Attempt {
    let command = command.clone()
    let excluded = copy_ids(excluded)
    when "reply" (mut account) {
        if !account.route.live { Result.Err::<Route, Retry>(Retry.Stopped) }
        else {
            let id = account.route.id
            let message = match command {
                Welcome => "welcome {id}\n",
                Balance => { let yuan = account.balance_cents / 100; "balance {yuan}\n" },
                _ => "error use join <room>, leave, say <message>, or balance\n"
            }
            deliver(account.route, &message, &excluded)
            Result.Ok::<Route, Retry>(account.route)
        }
    }
}
fn say(ctx: Host, account: domain.WriteHandle<Account>, expected: UInt64, text: &String, excluded: &Array<UInt64>) @suspends -> Attempt {
    let text = text.clone()
    let excluded = copy_ids(excluded)
    if expected == 0 {
        return when "outside" (mut account) {
            let route = check_account(account, expected)?
            deliver(route, "error join a room first\n", &excluded)
            Result.Ok::<Route, Retry>(route)
        }
    }
    let room = match room_handle(ctx, expected) { Some(room) => room, None => return Err(domain.DomainAccessError.Closed) }
    when "say" (mut account, room) {
        let route = check_member(account, room, expected)?
        if account.balance_cents < 100 { deliver(route, "error insufficient balance\n", &excluded) }
        else {
            account.balance_cents -= 100
            let message = say_message(&room.name, route.id, &text)
            broadcast(room, &message, 0, &excluded)
        }
        Result.Ok::<Route, Retry>(route)
    }
}
fn enter(account: &mut Account, room: &mut Room, key: UInt64, name: &String, excluded: &Array<UInt64>) -> Result<Route, Retry> {
    if room.retired || !room.name.equals(name) { return Err(Retry.Changed) }
    let route = account.route
    let message = event("joined", &room.name, route.id, "")
    broadcast(room, &message, 0, excluded)
    deliver(route, &message, excluded)
    add_member(room, route)
    account.room = key
    Ok(route)
}
fn depart(account: &mut Account, room: &mut Room, closing: Bool, excluded: &Array<UInt64>) {
    let id = account.route.id
    let message = event("left", &room.name, id, "")
    broadcast(room, &message, if closing { id } else { 0 }, excluded)
    remove_member(room, id)
    account.room = 0
}
fn join(ctx: Host, account: domain.WriteHandle<Account>, expected: UInt64, key: UInt64, name: &String, excluded: &Array<UInt64>) @suspends -> Attempt {
    let next = match room_handle(ctx, key) { Some(room) => room, None => return Err(domain.DomainAccessError.Closed) }
    let name = name.clone()
    let excluded = copy_ids(excluded)
    if expected == key {
        return when "already joined" (mut account, next) {
            let route = check_member(account, next, expected)?
            deliver(route, "error already joined\n", &excluded)
            Result.Ok::<Route, Retry>(route)
        }
    }
    if expected == 0 {
        return when "join" (mut account, mut next) {
            check_account(account, expected)?
            enter(account, next, key, &name, &excluded)
        }
    }
    let old = match room_handle(ctx, expected) { Some(room) => room, None => return Err(domain.DomainAccessError.Closed) }
    when "move" (mut account, mut old, mut next) {
        check_member(account, old, expected)?
        depart(account, old, false, &excluded)
        enter(account, next, key, &name, &excluded)
    }
}
fn stop(account: &mut Account) {
    account.route.live = false
    let signal = Array.new::<UInt8>()
    outbox.emit(account.route.stop, &signal)
}
fn leave(ctx: Host, account: domain.WriteHandle<Account>, expected: UInt64, closing: Bool, excluded: &Array<UInt64>) @suspends -> Attempt {
    let excluded = copy_ids(excluded)
    if expected == 0 {
        return when "outside" (mut account) {
            let route = check_account(account, expected)?
            if closing { stop(account) } else { deliver(route, "error join a room first\n", &excluded) }
            Result.Ok::<Route, Retry>(route)
        }
    }
    let room = match room_handle(ctx, expected) { Some(room) => room, None => return Err(domain.DomainAccessError.Closed) }
    when "leave" (mut account, mut room) {
        let route = check_member(account, room, expected)?
        depart(account, room, closing, &excluded)
        if closing { stop(account) }
        Result.Ok::<Route, Retry>(route)
    }
}

// Recovery: retry complete resolutions and remove slow recipients before replay.
struct Request { ctx: Host, id: UInt64, command: Command, excluded: Array<UInt64> }
fn split_request(input: Request) -> (Host, UInt64, Command, Array<UInt64>) {
    let Request { ctx, id, command, excluded } = input
    (ctx, id, command, excluded)
}
enum Step { Done(Bool), Slow(UInt64) }
struct Work { id: UInt64, command: Command }
fn split_work(work: Work) -> (UInt64, Command) { let Work { id, command } = work; (id, command) }
fn run_command(ctx: Host, id: UInt64, command: Command) @suspends -> Bool {
    var pending = Array.new::<Work>()
    pending.push(Work { id: id, command: command })
    var excluded = Array.new::<UInt64>()
    var evictions: UInt64 = 0
    var answer = false
    while !pending.is_empty() {
        let (current, command) = split_work(pending.pop()!)
        let account = match domain.lookup_write::<Account>(ctx.accounts, current) { Some(h) => h, None => return false }
        let input = Request { ctx: ctx, id: current, command: command.clone(), excluded: copy_ids(&excluded) }
        let step = match domain.request(account, retry_command, input) { Ok(step) => step, Err(_) => return false }
        match step {
            Done(value) => {
                if !value && !pending.is_empty() {
                    // A failed eviction cannot silently turn into a skipped recipient.
                    forget(Client { host: ctx, id: current })
                    if domain.lookup_write::<Account>(ctx.accounts, current).is_some() { return false }
                }
                answer = value
            },
            Slow(slow) => {
                if evictions >= ctx.config.max_evictions || contains(&excluded, slow) { return false }
                evictions += 1
                match &command { Disconnect => { if !contains(&excluded, current) { excluded.push(current) } }, _ => {} }
                excluded.push(slow)
                pending.push(Work { id: current, command: command })
                pending.push(Work { id: slow, command: Command.Disconnect })
            }
        }
    }
    answer
}
fn target_member(room: &Room, token: UInt64) -> UInt64 {
    var i: UInt64 = 0
    while i < room.members.len() {
        let route = room.members.get(i)!
        if route.live && route.output.identity() == token { return route.id }
        i += 1
    }
    0
}
fn slow_client(ctx: Host, value: Account, next_key: UInt64, token: UInt64) @suspends -> UInt64 {
    if value.route.output.identity() == token { return value.route.id }
    match room_handle(ctx, value.room) {
        Some(room) => { let id = domain.query_from(room.read_only(), target_member, token).unwrap_or(0); if id != 0 { return id } }, None => {}
    }
    match room_handle(ctx, next_key) {
        Some(room) => domain.query_from(room.read_only(), target_member, token).unwrap_or(0), None => 0
    }
}
fn retry_command(input: Request) @suspends -> Step {
    let (ctx, id, command, excluded) = split_request(input)
    var tries: UInt64 = 0
    while tries < ctx.config.retries {
        tries += 1
        // Directory resolution and room creation belong to the complete retry boundary.
        let next_key = match &command { Join(name) => ensure_room(ctx, name), _ => 0 }
        if match &command { Join(_) => next_key == 0, _ => false } { return Step.Done(false) }
        let account = match domain.lookup_write::<Account>(ctx.accounts, id) { Some(handle) => handle, None => return Step.Done(false) }
        let value = match domain.read_from(account.read_only(), account_view) { Ok(value) => value, Err(_) => return Step.Done(false) }
        if !value.route.live { return Step.Done(false) }
        let result = match &command {
            Say(text) => say(ctx, account, value.room, text, &excluded),
            Join(name) => join(ctx, account, value.room, next_key, name, &excluded),
            Leave => leave(ctx, account, value.room, false, &excluded),
            Disconnect => leave(ctx, account, value.room, true, &excluded),
            _ => reply(account, &command, &excluded)
        }
        let failed = match result {
            Ok(Ok(route)) => {
                match &command { Disconnect => { outbox.close(route.stop); outbox.close(route.output) }, _ => {} }
                match &command { Join(_) => reclaim(ctx, value.room), Leave => reclaim(ctx, value.room), Disconnect => reclaim(ctx, value.room), _ => {} }
                return Step.Done(true)
            },
            Ok(Err(Changed)) => continue,
            Err(Closed) => continue,
            Err(OutboxFull(token)) => token, Err(OutboxClosed(token)) => token,
            _ => return Step.Done(false)
        }
        let slow = slow_client(ctx, value, next_key, failed)
        if slow == 0 { return Step.Done(false) }
        return Step.Slow(slow)
    }
    Step.Done(false)
}

// Membership cleanup has no queue dependency, including after a failed Script call.
fn forget(client: Client) @suspends {
    let ctx = client.host
    let id = client.id
    var tries: UInt64 = 0
    while tries < ctx.config.retries {
        tries += 1
        let account = match domain.lookup_write::<Account>(ctx.accounts, id) { Some(h) => h, None => return }
        let value = match domain.read_from(account.read_only(), account_view) { Ok(v) => v, Err(_) => return }
        let key = value.room
        let removed = match room_handle(ctx, key) {
            Some(room) => when "forget member" (mut account, mut room) {
                if account.room != key { false }
                else { remove_member(room, id); account.room = 0; account.route.live = false; true }
            },
            None => when "forget account" (mut account) {
                if account.room != key { false }
                else { account.room = 0; account.route.live = false; true }
            }
        }
        if removed.unwrap_or(false) {
            outbox.close(value.route.stop); outbox.close(value.route.output)
            ctx.accounts.remove(id, account.read_only());
            reclaim(ctx, key)
            return
        }
    }
}

// Room lifetime: reserve, create, publish readiness, and retire by identity.
fn init_account(input: AccountInit) @suspends {
    let initial = Account { route: Route { live: true, id: input.id, output: input.output, stop: input.stop }, room: 0, balance_cents: 500 }
    let owner = domain.create(make_account, initial)
    input.host.accounts.insert(input.id, owner.handle())!
    input.owners.insert_owned(input.id, owner)!
}
fn initialize(host: Host) @suspends {
    host.directory.insert_owned(1, domain.create(make_catalog, {}))!
}

fn room_handle(ctx: Host, key: UInt64) @suspends -> Option<domain.WriteHandle<Room>> {
    if key == 0 { None } else { domain.lookup_write::<Room>(ctx.rooms, key) }
}
// Catalog writes only resolve/create rooms. Ordinary sends never read this root.
fn find_room(state: &Catalog, name: String) -> (UInt64, Bool) {
    var i: UInt64 = 0
    while i < state.rooms.len() {
        let entry = state.rooms.borrow_ref(i)
        if entry.name.equals(&name) { return (i + 1, match entry.status { Ready => true, _ => false }) }
        i += 1
    }
    (0, false)
}
fn take_room(state: &mut Catalog, host: Host) -> Option<RoomInit> {
    var i: UInt64 = 0
    while i < state.rooms.len() {
        let entry = state.rooms.borrow_mut_ref(i)
        if match entry.status { Pending => true, _ => false } {
            entry.status = RoomStatus.Starting
            return Some(RoomInit { host: host, key: i + 1, name: entry.name.clone() })
        }
        i += 1
    }
    None
}
fn finish_room(state: &mut Catalog, result: (UInt64, Bool)) -> Array<outbox.Handle> {
    let (key, available) = result
    let entry = state.rooms.borrow_mut_ref(key - 1)
    entry.status = if available { RoomStatus.Ready } else { RoomStatus.Dormant }
    var waiters = Array.new::<outbox.Handle>()
    mem.swap(&mut entry.waiters, &mut waiters)
    waiters
}
fn resolve_room(catalog: &mut Catalog, room_name: String, waiter: outbox.Handle, request: outbox.Handle, limit: UInt64, clients: UInt64) -> Result<UInt64, Unit> {
    let (key, available) = find_room(catalog, room_name.clone())
    if available { return Ok(key) }
    if key == 0 {
        if catalog.rooms.len() >= limit { return Err({}) }
        var waiters = Array.new::<outbox.Handle>(); waiters.push(waiter)
        catalog.rooms.push(RoomEntry { name: room_name, status: RoomStatus.Pending, waiters: waiters })
    } else {
        let entry = catalog.rooms.borrow_mut_ref(key - 1)
        if entry.waiters.len() >= clients { return Err({}) }
        if match entry.status { Dormant => true, _ => false } { entry.status = RoomStatus.Pending }
        entry.waiters.push(waiter)
    }
    let signal = Array.new::<UInt8>(); outbox.emit(request, &signal)
    Ok(0)
}
fn room_ready(ready: &mut outbox.Mailbox) @suspends { ready.receive(); }
fn discard_waiter(catalog: &mut Catalog, input: (String, UInt64)) {
    let (name, identity) = input
    let (key, _) = find_room(catalog, name)
    if key == 0 { return }
    let entry = catalog.rooms.borrow_mut_ref(key - 1)
    var i: UInt64 = 0
    while i < entry.waiters.len() {
        if entry.waiters.get(i)!.identity() == identity { entry.waiters.remove(i); return }
        i += 1
    }
}
fn ensure_room(ctx: Host, name: &String) @suspends -> UInt64 {
    let catalog = match domain.lookup_write::<Catalog>(ctx.directory, 1) { Some(handle) => handle, None => return 0 }
    var ready = outbox.create(1, 0)
    let waiter = ready.handle()
    let request = ctx.requests
    let room_name = name.clone()
    let limit = ctx.config.max_rooms
    let clients = ctx.config.max_clients
    let result = when "resolve room" (mut catalog) {
        resolve_room(catalog, room_name, waiter, request, limit, clients)
    }
    let key = match result { Ok(Ok(key)) => key, _ => return 0 }
    if key != 0 { return key }
    race { | room_ready(&mut ready) | task.sleep_ms(ctx.config.room_wait_ms) }
    domain.write_to(catalog, discard_waiter, (name.clone(), waiter.identity()));
    match domain.query_from(catalog.read_only(), find_room, name.clone()) { Ok((key, true)) => key, _ => 0 }
}
fn next_room(host: Host) @suspends -> Option<RoomInit> {
    let catalog = domain.lookup_write::<Catalog>(host.directory, 1)!
    domain.write_to(catalog, take_room, host)!
}
fn split_room(input: RoomInit) -> (Host, UInt64, String) {
    let RoomInit { host, key, name } = input
    (host, key, name)
}
fn init_room(input: RoomInit) @suspends {
    let (host, key, name) = split_room(input)
    host.rooms.insert_owned(key, domain.create(make_room, name))!
}
fn complete_room(input: RoomKey, available: Bool) @suspends -> Result<Unit, domain.DomainAccessError> {
    let catalog = match domain.lookup_write::<Catalog>(input.host.directory, 1) { Some(h) => h, None => return Err(domain.DomainAccessError.Closed) }
    let key = input.key
    let waiters = when "complete room" (mut catalog) { finish_room(catalog, (key, available)) }?
    var i: UInt64 = 0
    while i < waiters.len() { outbox.close(waiters.get(i)!); i += 1 }
    Ok({})
}
fn open_room(input: RoomKey) @suspends { complete_room(input, true)!; }
fn fail_room(input: RoomKey) @suspends { complete_room(input, false); }
fn empty(room: &Room) -> Bool {
    var i: UInt64 = 0
    while i < room.members.len() { if room.members.get(i)!.live { return false }; i += 1 }
    true
}
fn reclaim(ctx: Host, key: UInt64) @suspends {
    if !ctx.config.reclaim_empty || key == 0 { return }
    let room = match room_handle(ctx, key) { Some(h) => h, None => return }
    let catalog = match domain.lookup_write::<Catalog>(ctx.directory, 1) { Some(h) => h, None => return }
    let retired = when "retire room" (mut room, mut catalog) {
        if empty(room) && !room.retired {
            room.retired = true
            let entry = catalog.rooms.borrow_mut_ref(key - 1)
            entry.status = RoomStatus.Dormant
            true
        } else { false }
    }
    if retired.unwrap_or(false) { ctx.rooms.remove(key, room.read_only()); }
}

// State and message helpers used inside atomic operations.
fn event(kind: &String, room: &String, id: UInt64, message: &String) -> String {
    if message.is_empty() { "{kind} {room} {id}\n" }
    else { "{kind} {room} {id} {message}\n" }
}
fn copy_ids(ids: &Array<UInt64>) -> Array<UInt64> {
    var copy = Array.new::<UInt64>()
    var i: UInt64 = 0
    while i < ids.len() { copy.push(ids.get(i)!); i += 1 }
    copy
}
fn contains(ids: &Array<UInt64>, id: UInt64) -> Bool {
    var i: UInt64 = 0
    while i < ids.len() { if ids.get(i)! == id { return true }; i += 1 }
    false
}

fn deliver(route: Route, message: &String, excluded: &Array<UInt64>) {
    if route.live && !contains(excluded, route.id) {
        let bytes = message.clone().into_bytes()
        outbox.emit(route.output, &bytes)
    }
}
fn broadcast(room: &Room, message: &String, skip: UInt64, excluded: &Array<UInt64>) {
    let bytes = message.clone().into_bytes()
    var i: UInt64 = 0
    while i < room.members.len() {
        let route = room.members.get(i)!
        if route.live && route.id != skip && !contains(excluded, route.id) { outbox.emit(route.output, &bytes) }
        i += 1
    }
}
fn say_message(room: &String, id: UInt64, text: &String) -> String { event("message", room, id, text) }
fn remove_member(state: &mut Room, id: UInt64) {
    var i: UInt64 = 0
    while i < state.members.len() {
        let route = state.members.borrow_mut_ref(i)
        if route.id == id { route.live = false }
        i += 1
    }
}
fn add_member(state: &mut Room, route: Route) {
    var i: UInt64 = 0
    while i < state.members.len() {
        if !state.members.get(i)!.live { state.members.replace(i, route); return }
        i += 1
    }
    state.members.push(route)
}
fn member(room: &Room, id: UInt64) -> Bool {
    var i: UInt64 = 0
    while i < room.members.len() {
        let route = room.members.get(i)!
        if route.live && route.id == id { return true }
        i += 1
    }
    false
}
