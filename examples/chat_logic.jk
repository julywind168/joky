import chat_contract.{type Host, type Action, type Call, type RoomInit, type RoomKey, type AccountInit, type Client}
import joky/domain
import joky/outbox
import joky/mem
import joky/task
import joky/iter.{range}
import joky/array.{type Array}
import joky/option.{type Option, Some, None}

const NO_ROOM: UInt64 = 0
const NO_CLIENT: UInt64 = 0
const CATALOG_KEY: UInt64 = 1
const FIRST_ROOM_KEY: UInt64 = 1

fn room_index(key: UInt64) -> UInt64 { key - FIRST_ROOM_KEY }

struct Route { live: Bool, id: UInt64, output: outbox.Handle, stop: outbox.Handle }
#state
struct Account { route: Route, room: UInt64, balance_cents: UInt64 }
#state
struct Room { name: String, members: Array<Route>, retired: Bool }
enum RoomError { RoomLimit, WaiterLimit }
enum RoomStatus { Pending, Starting, Ready, Dormant }
struct RoomEntry { name: String, status: RoomStatus, waiters: Array<outbox.Handle> }
#state
struct Catalog { rooms: Array<RoomEntry> }
#derive(Clone)
enum Command { Welcome, Balance, Join(String), Leave, Say(String), Invalid, Disconnect }
fn make_catalog(_: Unit) -> Catalog { Catalog { rooms: Array.new::<RoomEntry>() } }
fn make_room(name: String) -> Room { Room { name: name, members: Array.new::<Route>(), retired: false } }
fn make_account(account: Account) -> Account { account }
fn account_view(state: &Account) -> Account { *state }

// Protocol: decode once, then run one command through bounded recovery.
fn parse(line: String) -> Command {
    let separator = line.find(" ").unwrap_or(line.byte_length())
    let verb = line.substring(0, separator)!
    let argument = if separator < line.byte_length() { line.substring(separator + 1, line.byte_length())! } else { "" }
    if verb.equals("join") && !argument.is_empty() && argument.find(" ").is_none() && argument.find("\t").is_none() {
        Command.Join(argument)
    } else if line.equals("balance") { Command.Balance }
    else if line.equals("leave") { Command.Leave }
    else if verb.equals("say") && !argument.is_empty() { Command.Say(argument) }
    else { Command.Invalid }
}

fn handle_line(host: Host, id: UInt64, line: String) @suspends -> Bool {
    run_command(host, id, parse(line))
}
fn dispatch(request: Call) @suspends -> Bool {
    let Call { host, id, action } = request
    match action {
        Action.Welcome => run_command(host, id, Command.Welcome),
        Action.Line(line) => handle_line(host, id, line),
        Action.Disconnect => run_command(host, id, Command.Disconnect)
    }
}

// Command operations keep validation, business rules and messages in one version.
enum Retry { Changed, Stopped }
type Attempt = Result<Result<Route, Retry>, domain.DomainAccessError>
fn check_account(account: &Account, expected: UInt64) -> Result<Route, Retry> {
    if !account.route.live { Err(Retry.Stopped) }
    else if account.room != expected { Err(Retry.Changed) }
    else { Ok(account.route) }
}
fn check_member(account: &Account, room: &Room, expected: UInt64) -> Result<Route, Retry> {
    let route = check_account(account, expected)?
    if member(room, route.id) { Ok(route) } else { Err(Retry.Stopped) }
}
fn reply(
    account: domain.WriteHandle<Account>,
    command: &Command,
    excluded: &Array<UInt64>,
) @suspends -> Attempt {
    let command = command.clone()
    let excluded = excluded.clone()
    when "reply" (mut account) {
        if !account.route.live { Err(Retry.Stopped) }
        else {
            let id = account.route.id
            let message = match command {
                Welcome => "welcome {id}\n",
                Balance => { let yuan = account.balance_cents / 100; "balance {yuan}\n" },
                _ => "error use join <room>, leave, say <message>, or balance\n"
            }
            deliver(account.route, &message, &excluded)
            Ok(account.route)
        }
    }
}
fn say(
    host: Host,
    account: domain.WriteHandle<Account>,
    expected: UInt64,
    text: &String,
    excluded: &Array<UInt64>,
) @suspends -> Attempt {
    let text = text.clone()
    let excluded = excluded.clone()
    if expected == NO_ROOM {
        return when "outside" (mut account) {
            let route = check_account(account, expected)?
            deliver(route, "error join a room first\n", &excluded)
            Ok(route)
        }
    }
    let room = match room_handle(host, expected) {
        Some(room) => room,
        None => return Err(domain.DomainAccessError.Closed)
    }
    when "say" (mut account, room) {
        let route = check_member(account, room, expected)?
        if account.balance_cents < 100 { deliver(route, "error insufficient balance\n", &excluded) }
        else {
            account.balance_cents -= 100
            let message = say_message(&room.name, route.id, &text)
            broadcast(room, &message, NO_CLIENT, &excluded)
        }
        Ok(route)
    }
}
fn enter(
    account: &mut Account,
    room: &mut Room,
    key: UInt64,
    name: &String,
    excluded: &Array<UInt64>,
) -> Result<Route, Retry> {
    if room.retired || !room.name.equals(name) { return Err(Retry.Changed) }
    let route = account.route
    let message = event("joined", &room.name, route.id, "")
    broadcast(room, &message, NO_CLIENT, excluded)
    deliver(route, &message, excluded)
    add_member(room, route)
    account.room = key
    Ok(route)
}
fn depart(account: &mut Account, room: &mut Room, closing: Bool, excluded: &Array<UInt64>) {
    let id = account.route.id
    let message = event("left", &room.name, id, "")
    broadcast(room, &message, if closing { id } else { NO_CLIENT }, excluded)
    remove_member(room, id)
    account.room = NO_ROOM
}
fn join(
    host: Host,
    account: domain.WriteHandle<Account>,
    expected: UInt64,
    key: UInt64,
    name: &String,
    excluded: &Array<UInt64>,
) @suspends -> Attempt {
    let next = match room_handle(host, key) {
        Some(room) => room,
        None => return Err(domain.DomainAccessError.Closed)
    }
    let name = name.clone()
    let excluded = excluded.clone()
    if expected == key {
        return when "already joined" (mut account, next) {
            let route = check_member(account, next, expected)?
            deliver(route, "error already joined\n", &excluded)
            Ok(route)
        }
    }
    if expected == NO_ROOM {
        return when "join" (mut account, mut next) {
            check_account(account, expected)?
            enter(account, next, key, &name, &excluded)
        }
    }
    let old = match room_handle(host, expected) {
        Some(room) => room,
        None => return Err(domain.DomainAccessError.Closed)
    }
    when "move" (mut account, mut old, mut next) {
        check_member(account, old, expected)?
        depart(account, old, false, &excluded)
        enter(account, next, key, &name, &excluded)
    }
}
fn stop(account: &mut Account) {
    account.route.live = false
    let signal = Array.new::<UInt8>()
    outbox.emit(account.route.stop, &signal)
}
fn leave(
    host: Host,
    account: domain.WriteHandle<Account>,
    expected: UInt64,
    closing: Bool,
    excluded: &Array<UInt64>,
) @suspends -> Attempt {
    let excluded = excluded.clone()
    if expected == NO_ROOM {
        return when "outside" (mut account) {
            let route = check_account(account, expected)?
            if closing { stop(account) } else { deliver(route, "error join a room first\n", &excluded) }
            Ok(route)
        }
    }
    let room = match room_handle(host, expected) {
        Some(room) => room,
        None => return Err(domain.DomainAccessError.Closed)
    }
    when "leave" (mut account, mut room) {
        let route = check_member(account, room, expected)?
        depart(account, room, closing, &excluded)
        if closing { stop(account) }
        Ok(route)
    }
}

// Recovery: retry complete resolutions and remove slow recipients before replay.
struct Request { host: Host, id: UInt64, command: Command, excluded: Array<UInt64> }
enum CommandFailure { Unavailable, Stopped, Rejected, UnknownRecipient, RetryLimit }
enum Step { Done, Failed(CommandFailure), Slow(UInt64) }
struct Work { id: UInt64, command: Command }
fn run_command(host: Host, id: UInt64, command: Command) @suspends -> Bool {
    var pending = Array.new::<Work>()
    pending.push(Work { id: id, command: command })
    var excluded = Array.new::<UInt64>()
    var evictions: UInt64 = 0
    var answer = false
    while !pending.is_empty() {
        let Work { id: current, command } = pending.pop()!
        let account = match domain.lookup_write::<Account>(host.accounts, current) {
            Some(handle) => handle,
            None => return false
        }
        let input = Request {
            host: host, id: current, command: command.clone(), excluded: excluded.clone()
        }
        let step = match domain.request(account, retry_command, input) { Ok(step) => step, Err(_) => return false }
        match step {
            Done => { answer = true },
            Failed(_) => {
                if !pending.is_empty() {
                    // A failed eviction cannot silently turn into a skipped recipient.
                    forget(Client { host: host, id: current })
                    if domain.lookup_write::<Account>(host.accounts, current).is_some() { return false }
                }
                answer = false
            },
            Slow(slow) => {
                if evictions >= host.config.max_evictions || excluded.contains(&slow) { return false }
                evictions += 1
                if let Command.Disconnect = &command {
                    if !excluded.contains(&current) { excluded.push(current) }
                }
                excluded.push(slow)
                pending.push(Work { id: current, command: command })
                pending.push(Work { id: slow, command: Command.Disconnect })
            }
        }
    }
    answer
}
fn target_member(room: &Room, token: UInt64) -> UInt64 {
    for route in &room.members {
        if route.live && route.output.identity() == token { return route.id }
    }
    NO_CLIENT
}
fn slow_client(host: Host, value: Account, next_key: UInt64, token: UInt64) @suspends -> UInt64 {
    if value.route.output.identity() == token { return value.route.id }
    match room_handle(host, value.room) {
        Some(room) => {
            let id = domain.query_from(room.read_only(), target_member, token).unwrap_or(NO_CLIENT)
            if id != NO_CLIENT { return id }
        },
        None => {}
    }
    match room_handle(host, next_key) {
        Some(room) => domain.query_from(room.read_only(), target_member, token).unwrap_or(NO_CLIENT), None => NO_CLIENT
    }
}
fn retry_command(input: Request) @suspends -> Step {
    let Request { host, id, command, excluded } = input
    var tries: UInt64 = 0
    while tries < host.config.retries {
        tries += 1
        // Directory resolution and room creation belong to the complete retry boundary.
        let next_key = match &command {
            Join(name) => {
                let key = ensure_room(host, name)
                if key == NO_ROOM { return Step.Failed(CommandFailure.Unavailable) }
                key
            },
            _ => NO_ROOM
        }
        let account = match domain.lookup_write::<Account>(host.accounts, id) {
            Some(handle) => handle,
            None => return Step.Failed(CommandFailure.Unavailable)
        }
        let value = match domain.read_from(account.read_only(), account_view) {
            Ok(value) => value,
            Err(_) => return Step.Failed(CommandFailure.Unavailable)
        }
        if !value.route.live { return Step.Failed(CommandFailure.Stopped) }
        let result = match &command {
            Say(text) => say(host, account, value.room, text, &excluded),
            Join(name) => join(host, account, value.room, next_key, name, &excluded),
            Leave => leave(host, account, value.room, false, &excluded),
            Disconnect => leave(host, account, value.room, true, &excluded),
            _ => reply(account, &command, &excluded)
        }
        let failed = match result {
            Ok(Ok(route)) => {
                match &command {
                    Disconnect => {
                        outbox.close(route.stop)
                        outbox.close(route.output)
                        reclaim(host, value.room)
                    },
                    Join(_) => reclaim(host, value.room),
                    Leave => reclaim(host, value.room),
                    _ => {}
                }
                return Step.Done
            },
            Ok(Err(Changed)) => continue,
            Err(Closed) => continue,
            Err(OutboxFull(token)) => token, Err(OutboxClosed(token)) => token,
            _ => return Step.Failed(CommandFailure.Rejected)
        }
        let slow = slow_client(host, value, next_key, failed)
        if slow == NO_CLIENT { return Step.Failed(CommandFailure.UnknownRecipient) }
        return Step.Slow(slow)
    }
    Step.Failed(CommandFailure.RetryLimit)
}

// Membership cleanup has no queue dependency, including after a failed Script call.
fn forget(client: Client) @suspends {
    let host = client.host
    let id = client.id
    var tries: UInt64 = 0
    while tries < host.config.retries {
        tries += 1
        let account = match domain.lookup_write::<Account>(host.accounts, id) { Some(h) => h, None => return }
        let value = match domain.read_from(account.read_only(), account_view) { Ok(v) => v, Err(_) => return }
        let key = value.room
        let removed = match room_handle(host, key) {
            Some(room) => when "forget member" (mut account, mut room) {
                if account.room != key { false }
                else {
                    remove_member(room, id)
                    account.room = NO_ROOM
                    account.route.live = false
                    true
                }
            },
            None => when "forget account" (mut account) {
                if account.room != key { false }
                else {
                    account.room = NO_ROOM
                    account.route.live = false
                    true
                }
            }
        }
        if removed.unwrap_or(false) {
            outbox.close(value.route.stop)
            outbox.close(value.route.output)
            host.accounts.remove(id, account.read_only());
            reclaim(host, key)
            return
        }
    }
}

// Room lifetime: reserve, create, publish readiness, and retire by identity.
fn init_account(input: AccountInit) @suspends {
    let initial = Account {
        route: Route { live: true, id: input.id, output: input.output, stop: input.stop },
        room: NO_ROOM,
        balance_cents: 500
    }
    let owner = domain.create(make_account, initial)
    input.host.accounts.insert(input.id, owner.handle())!
    input.owners.insert_owned(input.id, owner)!
}
fn initialize(host: Host) @suspends {
    host.directory.insert_owned(CATALOG_KEY, domain.create(make_catalog, {}))!
}

fn room_handle(host: Host, key: UInt64) @suspends -> Option<domain.WriteHandle<Room>> {
    if key == NO_ROOM { None } else { domain.lookup_write::<Room>(host.rooms, key) }
}
// Catalog writes only resolve/create rooms. Ordinary sends never read this root.
fn find_room(state: &Catalog, name: String) -> (UInt64, Bool) {
    var key = FIRST_ROOM_KEY
    for entry in &state.rooms {
        if entry.name.equals(&name) { return (key, entry.status == RoomStatus.Ready) }
        key += 1
    }
    (NO_ROOM, false)
}
fn take_room(state: &mut Catalog, host: Host) -> Option<RoomInit> {
    var key = FIRST_ROOM_KEY
    for entry in &mut state.rooms {
        if entry.status == RoomStatus.Pending {
            entry.status = RoomStatus.Starting
            return Some(RoomInit { host: host, key: key, name: entry.name.clone() })
        }
        key += 1
    }
    None
}
fn finish_room(state: &mut Catalog, result: (UInt64, Bool)) -> Array<outbox.Handle> {
    let (key, available) = result
    let entry = state.rooms.borrow_mut_ref(room_index(key))
    entry.status = if available { RoomStatus.Ready } else { RoomStatus.Dormant }
    var waiters = Array.new::<outbox.Handle>()
    mem.swap(&mut entry.waiters, &mut waiters)
    waiters
}
fn resolve_room(
    catalog: &mut Catalog,
    room_name: String,
    waiter: outbox.Handle,
    request: outbox.Handle,
    limit: UInt64,
    clients: UInt64,
) -> Result<UInt64, RoomError> {
    let (key, available) = find_room(catalog, room_name.clone())
    if available { return Ok(key) }
    if key == NO_ROOM {
        if catalog.rooms.len() >= limit { return Err(RoomError.RoomLimit) }
        var waiters = Array.new::<outbox.Handle>()
        waiters.push(waiter)
        catalog.rooms.push(RoomEntry { name: room_name, status: RoomStatus.Pending, waiters: waiters })
    } else {
        let entry = catalog.rooms.borrow_mut_ref(room_index(key))
        if entry.waiters.len() >= clients { return Err(RoomError.WaiterLimit) }
        if entry.status == RoomStatus.Dormant { entry.status = RoomStatus.Pending }
        entry.waiters.push(waiter)
    }
    let signal = Array.new::<UInt8>()
    outbox.emit(request, &signal)
    Ok(NO_ROOM)
}
fn room_ready(ready: &mut outbox.Mailbox) @suspends { ready.receive(); }
fn discard_waiter(catalog: &mut Catalog, input: (String, UInt64)) {
    let (name, identity) = input
    let (key, _) = find_room(catalog, name)
    if key == NO_ROOM { return }
    let entry = catalog.rooms.borrow_mut_ref(room_index(key))
    for i in range(0, entry.waiters.len()) {
        if entry.waiters.get(i)!.identity() == identity {
            entry.waiters.remove(i)
            return
        }
    }
}
fn ensure_room(host: Host, name: &String) @suspends -> UInt64 {
    let catalog = match domain.lookup_write::<Catalog>(host.directory, CATALOG_KEY) {
        Some(handle) => handle,
        None => return NO_ROOM
    }
    var ready = outbox.create(1, 0)
    let waiter = ready.handle()
    let request = host.requests
    let room_name = name.clone()
    let limit = host.config.max_rooms
    let clients = host.config.max_clients
    let result = when "resolve room" (mut catalog) {
        resolve_room(catalog, room_name, waiter, request, limit, clients)
    }
    let key = match result { Ok(Ok(key)) => key, _ => return NO_ROOM }
    if key != NO_ROOM { return key }
    race { | room_ready(&mut ready) | task.sleep_ms(host.config.room_wait_ms) }
    domain.write_to(catalog, discard_waiter, (name.clone(), waiter.identity()));
    match domain.query_from(catalog.read_only(), find_room, name.clone()) { Ok((key, true)) => key, _ => NO_ROOM }
}
fn next_room(host: Host) @suspends -> Option<RoomInit> {
    let catalog = domain.lookup_write::<Catalog>(host.directory, CATALOG_KEY)!
    domain.write_to(catalog, take_room, host)!
}
fn init_room(input: RoomInit) @suspends {
    let RoomInit { host, key, name } = input
    host.rooms.insert_owned(key, domain.create(make_room, name))!
}
fn complete_room(input: RoomKey, available: Bool) @suspends -> Result<Unit, domain.DomainAccessError> {
    let catalog = match domain.lookup_write::<Catalog>(input.host.directory, CATALOG_KEY) {
        Some(handle) => handle,
        None => return Err(domain.DomainAccessError.Closed)
    }
    let key = input.key
    let waiters = when "complete room" (mut catalog) { finish_room(catalog, (key, available)) }?
    for waiter in waiters { outbox.close(waiter) }
    Ok({})
}
fn open_room(input: RoomKey) @suspends { complete_room(input, true)!; }
fn fail_room(input: RoomKey) @suspends { complete_room(input, false); }
fn empty(room: &Room) -> Bool {
    for route in &room.members { if route.live { return false } }
    true
}
fn reclaim(host: Host, key: UInt64) @suspends {
    if !host.config.reclaim_empty || key == NO_ROOM { return }
    let room = match room_handle(host, key) { Some(h) => h, None => return }
    let catalog = match domain.lookup_write::<Catalog>(host.directory, CATALOG_KEY) {
        Some(handle) => handle,
        None => return
    }
    let retired = when "retire room" (mut room, mut catalog) {
        if empty(room) && !room.retired {
            room.retired = true
            let entry = catalog.rooms.borrow_mut_ref(room_index(key))
            entry.status = RoomStatus.Dormant
            true
        } else { false }
    }
    if retired.unwrap_or(false) { host.rooms.remove(key, room.read_only()); }
}

// State and message helpers used inside atomic operations.
fn event(kind: &String, room: &String, id: UInt64, message: &String) -> String {
    if message.is_empty() { "{kind} {room} {id}\n" }
    else { "{kind} {room} {id} {message}\n" }
}
fn deliver(route: Route, message: &String, excluded: &Array<UInt64>) {
    if route.live && !excluded.contains(&route.id) {
        let bytes = message.clone().into_bytes()
        outbox.emit(route.output, &bytes)
    }
}
fn broadcast(room: &Room, message: &String, skip: UInt64, excluded: &Array<UInt64>) {
    let bytes = message.clone().into_bytes()
    for route in &room.members {
        if route.live && route.id != skip && !excluded.contains(&route.id) { outbox.emit(route.output, &bytes) }
    }
}
fn say_message(room: &String, id: UInt64, text: &String) -> String { event("message", room, id, text) }
fn remove_member(state: &mut Room, id: UInt64) {
    for route in &mut state.members {
        if route.id == id { route.live = false }
    }
}
fn add_member(state: &mut Room, route: Route) {
    for member in &mut state.members {
        if !member.live {
            *member = route
            return
        }
    }
    state.members.push(route)
}
fn member(room: &Room, id: UInt64) -> Bool {
    for route in &room.members {
        if route.live && route.id == id { return true }
    }
    false
}
