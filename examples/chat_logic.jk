import chat_contract.{type Host, type Action, type Call, type AccountInit, type Client}
import joky/domain
import joky/session
import joky/mem
import joky/iter.{range}
import joky/array.{type Array}
import joky/option.{type Option, Some, None}

const NO_CLIENT: UInt64 = 0
struct Route { live: Bool, id: UInt64, output: session.Output }
impl Clone for Route { fn clone(&self) -> Self { *self } }
#state
#derive(Clone)
struct Account { route: Route, room: String, balance_cents: UInt64 }
#state
struct Room { name: String, members: Array<Route> }
#derive(Clone)
enum Command { Welcome, Balance, Join(String), Leave, Say(String), Invalid, Disconnect }
fn make_room(name: String) -> Room { Room { name: name, members: Array.new::<Route>() } }
fn make_account(account: Account) -> Account { account }

// Protocol: decode once, then queue one atomic command.
fn parse(line: String) -> Command {
    let separator = line.find(" ").unwrap_or(line.byte_length())
    let verb = line.substring(0, separator)!
    let argument = if separator < line.byte_length() { line.substring(separator + 1, line.byte_length())! } else { "" }
    if verb.equals("join") && !argument.is_empty() && argument.find(" ").is_none() && argument.find("\t").is_none() {
        Command.Join(argument)
    } else if line.equals("balance") { Command.Balance }
    else if line.equals("leave") { Command.Leave }
    else if verb.equals("say") && !argument.is_empty() { Command.Say(argument) }
    else { Command.Invalid }
}

fn handle_line(host: Host, id: UInt64, line: String) @suspends -> Bool {
    run_command(host, id, parse(line))
}
fn dispatch(request: Call) @suspends -> Bool {
    let Call { host, id, action } = request
    match action {
        Action.Welcome => run_command(host, id, Command.Welcome),
        Action.Line(line) => handle_line(host, id, line),
        Action.Disconnect => run_command(host, id, Command.Disconnect)
    }
}

// Command operations keep validation, business rules and messages in one version.
enum CommandError { Stopped }
type Attempt = Result<Result<(Route, String), CommandError>, domain.DomainAccessError>
fn check_account(account: &Account) -> Result<Route, CommandError> {
    if !account.route.live { Err(CommandError.Stopped) } else { Ok(account.route) }
}
fn check_member(account: &Account, room: &Room) -> Result<Route, CommandError> {
    let route = check_account(account)?
    if member(room, route.id) { Ok(route) } else { Err(CommandError.Stopped) }
}
fn reply(
    account: domain.WriteHandle<Account>,
    command: &Command,
) @suspends -> Attempt {
    let command = command.clone()
    when "reply" (mut account) {
        if !account.route.live { Err(CommandError.Stopped) }
        else {
            let id = account.route.id
            let message = match command {
                Welcome => "welcome {id}\n",
                Balance => { let yuan = account.balance_cents / 100; "balance {yuan}\n" },
                _ => "error use join <room>, leave, say <message>, or balance\n"
            }
            deliver(account.route, &message)
            Ok((account.route, ""))
        }
    }
}
fn say(host: Host, account: domain.WriteHandle<Account>, text: &String) @suspends -> Attempt {
    let text = text.clone()
    when "say" (mut account, room?: Room = host.rooms[account.room]) {
        let route = check_member(account, room)?
        if account.balance_cents < 100 { deliver(route, "error insufficient balance\n") }
        else {
            account.balance_cents -= 100
            let message = say_message(&room.name, route.id, text)
            broadcast(room, &message, NO_CLIENT)
        }
        Ok((route, ""))
    } else {
        let route = check_account(account)?
        deliver(route, "error join a room first\n")
        Ok((route, ""))
    }
}
fn enter(
    account: &mut Account,
    room: &mut Room,
    name: &String,
) -> Result<Route, CommandError> {
    if !room.name.equals(name) { return Err(CommandError.Stopped) }
    let route = account.route
    let message = event("joined", &room.name, route.id, "")
    broadcast(room, &message, NO_CLIENT)
    deliver(route, &message)
    add_member(room, route)
    mem.replace(&mut account.room, name.clone());
    Ok(route)
}
fn depart(account: &mut Account, room: &mut Room, closing: Bool) -> String {
    let id = account.route.id
    let message = event("left", &room.name, id, "")
    broadcast(room, &message, if closing { id } else { NO_CLIENT })
    remove_member(room, id)
    mem.replace(&mut account.room, "")
}
fn join(host: Host, account: domain.WriteHandle<Account>, name: &String) @suspends -> Attempt {
    let name = name.clone()
    when "move" (mut account,
                 mut next: Room = host.rooms.get_or_stage(name, make_room(name.clone())),
                 mut old?: Room = host.rooms[account.room]) {
        check_member(account, old)?
        let previous = depart(account, old, false)
        Ok((enter(account, next, name)?, previous))
    } else {
        check_account(account)?
        Ok((enter(account, next, name)?, ""))
    } alias {
        let route = check_member(account, next)?
        deliver(route, "error already joined\n")
        Ok((route, ""))
    }
}
fn leave(host: Host, account: domain.WriteHandle<Account>, closing: Bool) @suspends -> Attempt {
    when "leave" (mut account, mut room?: Room = host.rooms[account.room]) {
        let route = check_member(account, room)?
        let previous = depart(account, room, closing)
        if closing { account.route.live = false }
        Ok((route, previous))
    } else {
        let route = check_account(account)?
        if closing { account.route.live = false } else { deliver(route, "error join a room first\n") }
        Ok((route, ""))
    }
}

// A command queues one complete access-path operation; the runtime revalidates routes.
struct Request { host: Host, id: UInt64, command: Command }
enum CommandFailure { Unavailable, Rejected }
enum Step { Done, Failed(CommandFailure) }
fn run_command(host: Host, id: UInt64, command: Command) @suspends -> Bool {
    let account = match domain.lookup_write::<Account>(host.accounts, id) {
        Some(handle) => handle,
        None => return false
    }
    let input = Request { host: host, id: id, command: command }
    match domain.request(account, apply_command, input) { Ok(Done) => true, _ => false }
}
fn apply_command(input: Request) @suspends -> Step {
    let Request { host, id, command } = input
    let account = match domain.lookup_write::<Account>(host.accounts, id) {
        Some(handle) => handle,
        None => return Step.Failed(CommandFailure.Unavailable)
    }
    let result = match &command {
        Say(text) => say(host, account, text),
        Join(name) => join(host, account, name),
        Leave => leave(host, account, false),
        Disconnect => leave(host, account, true),
        _ => reply(account, &command)
    }
    match result {
        Ok(Ok((route, previous))) => {
            match &command { Disconnect => route.output.close(), _ => {} }
            reclaim(host, &previous)
            Step.Done
        },
        _ => Step.Failed(CommandFailure.Rejected)
    }
}

// Membership cleanup has no queue dependency, including after a failed Script call.
fn forget(client: Client) @suspends {
    let host = client.host
    let id = client.id
    let account = match domain.lookup_write::<Account>(host.accounts, id) { Some(h) => h, None => return }
    let removed = when "forget" (mut account, mut room?: Room = host.rooms[account.room]) {
        remove_member(room, id)
        let previous = mem.replace(&mut account.room, "")
        account.route.live = false
        (account.route, previous)
    } else {
        mem.replace(&mut account.room, "");
        account.route.live = false
        (account.route, "")
    }
    match removed {
        Ok((route, previous)) => {
            route.output.close()
            host.accounts.remove(id, account.read_only());
            reclaim(host, &previous)
        },
        _ => {}
    }
}

// The connection directory owns its account; the shared account route stays weak.
fn init_account(input: AccountInit) @suspends {
    let initial = Account { route: Route { live: true, id: input.id, output: input.output },
        room: "", balance_cents: 500 }
    when "create account" (account: Account = input.owners.get_or_stage(input.id, make_account(initial.clone()))) {}!
    let account = domain.lookup_write::<Account>(input.owners, input.id)!
    input.host.accounts.insert(input.id, account)!
}
fn room_handle(host: Host, name: &String) @suspends -> Option<domain.WriteHandle<Room>> {
    domain.lookup_named_write::<Room>(host.rooms, name)
}
fn empty(room: &Room) -> Bool {
    for route in &room.members { if route.live { return false } }
    true
}
fn reclaim(host: Host, name: &String) @suspends {
    if host.config.reclaim_empty && !name.is_empty() {
        domain.remove_named_if(host.rooms, name, empty);
    }
}

// State and message helpers used inside atomic operations.
fn event(kind: &String, room: &String, id: UInt64, message: &String) -> String {
    if message.is_empty() { "{kind} {room} {id}\n" }
    else { "{kind} {room} {id} {message}\n" }
}
fn deliver(route: Route, message: &String) {
    if route.live {
        let bytes = message.clone().into_bytes()
        route.output.send(&bytes)
    }
}
fn broadcast(room: &Room, message: &String, skip: UInt64) {
    let bytes = message.clone().into_bytes()
    for route in &room.members {
        if route.live && route.id != skip { route.output.send(&bytes) }
    }
}
fn say_message(room: &String, id: UInt64, text: &String) -> String { event("message", room, id, text) }
fn remove_member(state: &mut Room, id: UInt64) {
    for route in &mut state.members {
        if route.id == id { route.live = false }
    }
}
fn add_member(state: &mut Room, route: Route) {
    for member in &mut state.members {
        if !member.live {
            *member = route
            return
        }
    }
    state.members.push(route)
}
fn member(room: &Room, id: UInt64) -> Bool {
    for route in &room.members {
        if route.live && route.id == id { return true }
    }
    false
}
