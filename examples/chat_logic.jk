import chat_contract.{type Host, type Action, type Call, type RoomInit, type RoomKey, type AccountInit}
import joky/domain
import joky/outbox
import joky/mem
import joky/array.{type Array}
import joky/option.{type Option, Some, None}


struct Route { live: Bool, id: UInt64, output: outbox.Handle, stop: outbox.Handle }
#state
struct Account { route: Route, room: UInt64, balance_cents: UInt64 }
#state
struct Room { name: String, members: Array<Route> }
enum RoomStatus { Pending, Starting, Ready }
struct RoomEntry { name: String, status: RoomStatus, waiters: Array<outbox.Handle> }
#state
struct Catalog { rooms: Array<RoomEntry> }
struct Context { host: Host }
enum Command { Welcome, Balance, Join(String), Leave, Say(String), Invalid, Disconnect, Notice(String) }
fn make_catalog(_: Unit) -> Catalog { Catalog { rooms: Array.new::<RoomEntry>() } }
fn make_room(name: String) -> Room { Room { name: name, members: Array.new::<Route>() } }
fn make_account(account: Account) -> Account { account }
fn account_view(state: &Account) -> Account { *state }
fn event(kind: &String, room: &String, id: UInt64, message: &String) -> String {
    if message.is_empty() { "{kind} {room} {id}\n" }
    else { "{kind} {room} {id} {message}\n" }
}
impl Command {
    fn clone(&self) -> Command {
        match self {
            Welcome => Command.Welcome, Balance => Command.Balance, Join(room) => Command.Join(room.clone()),
            Leave => Command.Leave, Say(text) => Command.Say(text.clone()),
            Invalid => Command.Invalid, Disconnect => Command.Disconnect, Notice(text) => Command.Notice(text.clone())
        }
    }
}
fn copy_ids(ids: &Array<UInt64>) -> Array<UInt64> {
    var copy = Array.new::<UInt64>()
    var i: UInt64 = 0
    while i < ids.len() { copy.push(ids.get(i)!); i += 1 }
    copy
}
fn contains(ids: &Array<UInt64>, id: UInt64) -> Bool {
    var i: UInt64 = 0
    while i < ids.len() { if ids.get(i)! == id { return true }; i += 1 }
    false
}

// Catalog writes only resolve/create rooms. Ordinary sends never read this root.
fn find_room(state: &Catalog, name: String) -> (UInt64, Bool) {
    var i: UInt64 = 0
    while i < state.rooms.len() {
        let entry = state.rooms.borrow_ref(i)
        if entry.name.equals(&name) { return (i + 1, match entry.status { Ready => true, _ => false }) }
        i += 1
    }
    (0, false)
}
fn reserve_room(state: &mut Catalog, input: (String, outbox.Handle)) {
    let (name, waiter) = input
    let (key, _) = find_room(state, name.clone())
    if key == 0 {
        var waiters = Array.new::<outbox.Handle>(); waiters.push(waiter)
        state.rooms.push(RoomEntry { name: name, status: RoomStatus.Pending, waiters: waiters })
    } else { let entry = state.rooms.borrow_mut_ref(key - 1); entry.waiters.push(waiter) }
}
fn take_room(state: &mut Catalog, host: Host) -> Option<RoomInit> {
    var i: UInt64 = 0
    while i < state.rooms.len() {
        let entry = state.rooms.borrow_mut_ref(i)
        if match entry.status { Pending => true, _ => false } {
            entry.status = RoomStatus.Starting
            return Some(RoomInit { host: host, key: i + 1, name: entry.name.clone() })
        }
        i += 1
    }
    None
}
fn finish_room(state: &mut Catalog, key: UInt64) -> Array<outbox.Handle> {
    let entry = state.rooms.borrow_mut_ref(key - 1)
    entry.status = RoomStatus.Ready
    var waiters = Array.new::<outbox.Handle>()
    mem.swap(&mut entry.waiters, &mut waiters)
    waiters
}
fn ensure_room(ctx: Context, name: &String) @suspends -> UInt64 {
    let catalog = match domain.lookup_write::<Catalog>(ctx.host.directory, 1) { Some(handle) => handle, None => return 0 }
    var ready = outbox.create(1, 0)
    let waiter = ready.handle()
    let request = ctx.host.requests
    let room_name = name.clone()
    let result = when "resolve room" (mut catalog) {
        let (key, available) = find_room(catalog, room_name.clone())
        if available { key }
        else {
            reserve_room(catalog, (room_name, waiter))
            if key == 0 { let signal = Array.new::<UInt8>(); outbox.emit(request, &signal) }
            0
        }
    }
    let key = match result { Ok(key) => key, Err(_) => return 0 }
    if key != 0 { return key }
    ready.receive();
    match domain.query_from(catalog.read_only(), find_room, name.clone()) { Ok((key, true)) => key, _ => 0 }
}
fn next_room(host: Host) @suspends -> Option<RoomInit> {
    let catalog = domain.lookup_write::<Catalog>(host.directory, 1)!
    domain.write_to(catalog, take_room, host)!
}
fn split_room(input: RoomInit) -> (Host, UInt64, String) {
    let RoomInit { host, key, name } = input
    (host, key, name)
}
fn init_room(input: RoomInit) @suspends {
    let (host, key, name) = split_room(input)
    host.rooms.insert_owned(key, domain.create(make_room, name))!
}
fn open_room(input: RoomKey) @suspends {
    let catalog = domain.lookup_write::<Catalog>(input.host.directory, 1)!
    let waiters = domain.write_to(catalog, finish_room, input.key)!
    var i: UInt64 = 0
    while i < waiters.len() { outbox.close(waiters.get(i)!); i += 1 }
}
fn deliver(route: Route, message: &String, excluded: &Array<UInt64>) {
    if route.live && !contains(excluded, route.id) {
        let bytes = message.clone().into_bytes()
        outbox.emit(route.output, &bytes)
    }
}
fn broadcast(room: &Room, message: &String, skip: UInt64, excluded: &Array<UInt64>) {
    let bytes = message.clone().into_bytes()
    var i: UInt64 = 0
    while i < room.members.len() {
        let route = room.members.get(i)!
        if route.live && route.id != skip && !contains(excluded, route.id) { outbox.emit(route.output, &bytes) }
        i += 1
    }
}
fn say_message(room: &String, id: UInt64, text: &String) -> String { event("message", room, id, text) }
fn remove_member(state: &mut Room, id: UInt64) {
    var i: UInt64 = 0
    while i < state.members.len() {
        let route = state.members.borrow_mut_ref(i)
        if route.id == id { route.live = false }
        i += 1
    }
}
fn add_member(state: &mut Room, route: Route) {
    var i: UInt64 = 0
    while i < state.members.len() {
        if !state.members.get(i)!.live { state.members.replace(i, route); return }
        i += 1
    }
    state.members.push(route)
}
fn member(room: &Room, id: UInt64) -> Bool {
    var i: UInt64 = 0
    while i < room.members.len() {
        let route = room.members.get(i)!
        if route.live && route.id == id { return true }
        i += 1
    }
    false
}
enum Retry { Changed, Stopped }
fn changes_membership(command: &Command) -> Bool {
    match command { Join(_) => true, Leave => true, Disconnect => true, _ => false }
}
fn speak(account: &mut Account, old: &Room, expected: UInt64, command: &Command, excluded: &Array<UInt64>) -> Result<Route, Retry> {
    if !account.route.live { return Err(Retry.Stopped) }
    if account.room != expected { return Err(Retry.Changed) }
    if expected != 0 && !member(old, account.route.id) { return Err(Retry.Stopped) }
    let route = account.route
    let id = route.id
    match command {
        Say(text) => {
            if account.room == 0 { deliver(route, "error join a room first\n", excluded) }
            else if account.balance_cents < 100 { deliver(route, "error insufficient balance\n", excluded) }
            else {
                account.balance_cents -= 100
                let message = say_message(&old.name, id, text)
                broadcast(old, &message, 0, excluded)
            }
        },
        Welcome => { let message = "welcome {id}\n"; deliver(route, &message, excluded) },
        Balance => { let yuan = account.balance_cents / 100; let message = "balance {yuan}\n"; deliver(route, &message, excluded) },
        Notice(text) => { deliver(route, text, excluded) },
        Invalid => { deliver(route, "error use join <room>, leave, say <message>, or balance\n", excluded) },
        _ => return Err(Retry.Stopped)
    }
    Ok(route)
}
// All decisions, mutations and message construction run in the selected operation version.
fn change_membership(account: &mut Account, old: &mut Room, next: &mut Room, expected: UInt64, next_key: UInt64, command: &Command, excluded: &Array<UInt64>) -> Result<Route, Retry> {
    if !account.route.live { return Err(Retry.Stopped) }
    if account.room != expected { return Err(Retry.Changed) }
    if expected != 0 && !member(old, account.route.id) { return Err(Retry.Stopped) }
    let route = account.route
    let id = route.id
    match command {
        Join(_) => {
            if account.room == next_key { deliver(route, "error already joined\n", excluded) }
            else {
                if account.room != 0 {
                    let message = event("left", &old.name, id, "")
                    broadcast(old, &message, 0, excluded)
                    remove_member(old, id)
                }
                let message = event("joined", &next.name, id, "")
                broadcast(next, &message, 0, excluded)
                deliver(route, &message, excluded)
                add_member(next, route)
                account.room = next_key
            }
        },
        Leave => {
            if account.room == 0 { deliver(route, "error join a room first\n", excluded) }
            else {
                let message = event("left", &old.name, id, "")
                broadcast(old, &message, 0, excluded)
                remove_member(old, id)
                account.room = 0
            }
        },
        Disconnect => {
            if account.room != 0 {
                let message = event("left", &old.name, id, "")
                broadcast(old, &message, id, excluded)
                remove_member(old, id)
            }
            account.room = 0
            account.route.live = false
            let signal = Array.new::<UInt8>()
            outbox.emit(route.stop, &signal)
        },
        _ => return Err(Retry.Stopped)
    }
    Ok(route)
}
fn room_handle(ctx: Context, key: UInt64) @suspends -> Option<domain.WriteHandle<Room>> {
    if key == 0 { None } else { domain.lookup_write::<Room>(ctx.host.rooms, key) }
}
struct Request { ctx: Context, id: UInt64, command: Command, excluded: Array<UInt64> }
fn split_request(input: Request) -> (Context, UInt64, Command, Array<UInt64>) {
    let Request { ctx, id, command, excluded } = input
    (ctx, id, command, excluded)
}
fn publish(ctx: Context, id: UInt64, command: Command, excluded: &Array<UInt64>) @suspends -> Bool {
    let account = match domain.lookup_write::<Account>(ctx.host.accounts, id) { Some(handle) => handle, None => return false }
    let input = Request { ctx: ctx, id: id, command: command, excluded: copy_ids(excluded) }
    match domain.request(account, execute, input) { Ok(value) => value, Err(_) => false }
}
fn attempt(ctx: Context, account: domain.WriteHandle<Account>, expected: UInt64, next_key: UInt64, command: &Command, excluded: &Array<UInt64>) @suspends -> Result<Result<Route, Retry>, domain.DomainAccessError> {
    let old_handle = room_handle(ctx, expected)
    let next_handle = if next_key == expected { None } else { room_handle(ctx, next_key) }
    if expected != 0 && old_handle.is_none() { return Err(domain.DomainAccessError.Closed) }
    if next_key != 0 && next_key != expected && next_handle.is_none() { return Err(domain.DomainAccessError.Closed) }
    let command = command.clone()
    let excluded = copy_ids(excluded)
    if !changes_membership(&command) {
        return match old_handle {
            Some(old) => when "send" (mut account, old) {
                speak(account, old, expected, &command, &excluded)
            },
            None => when "unjoined" (mut account) {
                let empty = make_room("")
                speak(account, &empty, expected, &command, &excluded)
            }
        }
    }
    match old_handle {
        Some(old) => match next_handle {
            Some(next) => when "move" (mut account, mut old, mut next) {
                change_membership(account, old, next, expected, next_key, &command, &excluded)
            },
            None => when "in room" (mut account, mut old) {
                var empty = make_room("")
                change_membership(account, old, &mut empty, expected, next_key, &command, &excluded)
            }
        },
        None => match next_handle {
            Some(next) => when "first join" (mut account, mut next) {
                var empty = make_room("")
                change_membership(account, &mut empty, next, expected, next_key, &command, &excluded)
            },
            None => when "account" (mut account) {
                var old = make_room("")
                var next = make_room("")
                change_membership(account, &mut old, &mut next, expected, next_key, &command, &excluded)
            }
        }
    }
}
fn target_member(room: &Room, token: UInt64) -> UInt64 {
    var i: UInt64 = 0
    while i < room.members.len() {
        let route = room.members.get(i)!
        if route.live && route.output.identity() == token { return route.id }
        i += 1
    }
    0
}
fn slow_client(ctx: Context, value: Account, next_key: UInt64, token: UInt64) @suspends -> UInt64 {
    if value.route.output.identity() == token { return value.route.id }
    match room_handle(ctx, value.room) {
        Some(room) => { let id = domain.query_from(room.read_only(), target_member, token).unwrap_or(0); if id != 0 { return id } }, None => {}
    }
    match room_handle(ctx, next_key) {
        Some(room) => domain.query_from(room.read_only(), target_member, token).unwrap_or(0), None => 0
    }
}
fn execute(input: Request) @suspends -> Bool {
    let (ctx, id, command, excluded) = split_request(input)
    var tries: UInt64 = 0
    while tries < 64 {
        tries += 1
        // Directory resolution and room creation belong to the complete retry boundary.
        let next_key = match &command { Join(name) => ensure_room(ctx, name), _ => 0 }
        if match &command { Join(_) => next_key == 0, _ => false } { return false }
        let account = match domain.lookup_write::<Account>(ctx.host.accounts, id) { Some(handle) => handle, None => return false }
        let value = match domain.read_from(account.read_only(), account_view) { Ok(value) => value, Err(_) => return false }
        if !value.route.live { return false }
        let result = attempt(ctx, account, value.room, next_key, &command, &excluded)
        let failed = match result {
            Ok(Ok(route)) => {
                match &command { Disconnect => { outbox.close(route.stop); outbox.close(route.output) }, _ => {} }
                return true
            },
            Ok(Err(Changed)) => continue,
            Err(OutboxFull(token)) => token, Err(OutboxClosed(token)) => token,
            _ => return false
        }
        let slow = slow_client(ctx, value, next_key, failed)
        if slow == 0 { return false }
        var ancestors = copy_ids(&excluded)
        match &command { Disconnect => ancestors.push(id), _ => {} }
        publish(ctx, slow, Command.Disconnect, &ancestors);
    }
    false
}

fn parse(line: String) -> Command {
    let separator = line.find(" ").unwrap_or(line.byte_length())
    let verb = line.substring(0, separator)!
    let argument = if separator < line.byte_length() { line.substring(separator + 1, line.byte_length())! } else { "" }
    if verb.equals("join") && !argument.is_empty() && argument.find(" ").is_none() && argument.find("\t").is_none() {
        Command.Join(argument)
    } else if line.equals("balance") { Command.Balance }
    else if line.equals("leave") { Command.Leave }
    else if verb.equals("say") && !argument.is_empty() { Command.Say(argument) }
    else { Command.Invalid }
}

fn process(ctx: Context, id: UInt64, line: String) @suspends -> Bool {
    let excluded = Array.new::<UInt64>()
    publish(ctx, id, parse(line), &excluded)
}
fn split(request: Call) -> (Host, UInt64, Action) {
    let Call { host, id, action } = request
    (host, id, action)
}
fn dispatch(request: Call) @suspends -> UInt64 {
    let (host, id, action) = split(request)
    let ctx = Context { host: host }
    let excluded = Array.new::<UInt64>()
    match action {
        Action.Welcome => if publish(ctx, id, Command.Welcome, &excluded) { 1 } else { 0 },
        Action.Line(line) => if process(ctx, id, line) { 1 } else { 0 },
        Action.Disconnect => {
            publish(ctx, id, Command.Disconnect, &excluded);
            match domain.lookup_write::<Account>(host.accounts, id) {
                Some(account) => { host.accounts.remove(id, account.read_only()); },
                None => {}
            }
            0
        },
        Action.Notice(text) => if publish(ctx, id, Command.Notice(text), &excluded) { 1 } else { 0 }
    }
}
fn init_account(input: AccountInit) @suspends {
    let initial = Account { route: Route { live: true, id: input.id, output: input.output, stop: input.stop }, room: 0, balance_cents: 500 }
    let owner = domain.create(make_account, initial)
    input.host.accounts.insert(input.id, owner.handle())!
    input.owners.insert_owned(input.id, owner)!
}
fn initialize(host: Host) @suspends {
    host.directory.insert_owned(1, domain.create(make_catalog, {}))!
}
