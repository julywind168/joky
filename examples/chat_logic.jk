// Chat business rules. examples/chat.jk loads this script and republishes it on `reload`.
// Every command is one named `when`: checks, balance changes and outgoing messages commit
// together or not at all. Read top to bottom: state, protocol, commands, lifetime, helpers.
import chat_contract.{type Host, type Call, type AccountInit, type Client}
import joky/domain
import joky/session
import joky/mem
import joky/iter.{range}
import joky/array.{type Array}
import joky/option.{type Option, Some, None}

const START_BALANCE_CENTS: UInt64 = 500
const SAY_PRICE_CENTS: UInt64 = 100

struct Member { id: UInt64, output: session.Output }
// No room membership is represented explicitly, independently of valid room names.
#state
struct Account { member: Member, live: Bool, room: Option<String>, balance_cents: UInt64 }
#state
struct Room { name: String, members: Array<Member> }
fn new_account(member: Member) -> Account {
    Account { member: member, live: true, room: None, balance_cents: START_BALANCE_CENTS }
}
fn new_room(name: String) -> Room { Room { name: name, members: Array.new::<Member>() } }

// A command whose account or membership changed underneath it is refused as a whole.
enum Rejection { Stale }
type Outcome<T> = domain.Outcome<T, Rejection>

// Protocol: one line is one command; any rejection closes the connection.
enum Command { Balance, Join(String), Leave, Say(String), Invalid }
fn parse(line: String) -> Command {
    let separator = line.find(" ").unwrap_or(line.byte_length())
    let verb = line.substring(0, separator)!
    let argument = if separator < line.byte_length() {
        line.substring(separator + 1, line.byte_length())!
    } else { "" }
    let room = !argument.is_empty() && argument.find(" ").is_none() && argument.find("\t").is_none()
    if verb.equals("join") && room { Command.Join(argument) }
    else if line.equals("balance") { Command.Balance }
    else if line.equals("leave") { Command.Leave }
    else if verb.equals("say") && !argument.is_empty() { Command.Say(argument) }
    else { Command.Invalid }
}
fn dispatch(call: Call) @suspends -> Bool {
    let Call { host, id, line } = call
    handle_line(host, id, line)
}
fn handle_line(host: Host, id: UInt64, line: String) @suspends -> Bool {
    let account = match domain.lookup_write::<Account>(host.accounts, id) {
        Some(account) => account,
        None => return false
    }
    let command = parse(line)
    match command {
        Say(text) => committed(say(host, account, text)),
        Join(name) => vacated(host, join(host, account, name)),
        Leave => vacated(host, leave(host, account)),
        Balance => committed(reply(account, Reply.Balance)),
        Invalid => committed(reply(account, Reply.Usage))
    }
}
fn committed<T>(outcome: Outcome<T>) -> Bool { outcome.is_committed() }
// Commands that leave a room hand its name back so an empty room can be reclaimed.
fn vacated(host: Host, outcome: Outcome<Option<String>>) @suspends -> Bool {
    match outcome {
        Committed(room) => { reclaim(host, &room); true },
        _ => false
    }
}

// Commands.
enum Reply { Balance, Usage }
fn reply(account: domain.WriteHandle<Account>, reply: Reply) @suspends -> Outcome<Unit> {
    when "reply" (account) {
        let member = check_live(account)?
        let text = match reply {
            Balance => { let yuan = account.balance_cents / 100; "balance {yuan}\n" },
            Usage => "error use join <room>, leave, say <message>, or balance\n"
        }
        send(member, &text)
        Ok({})
    }
}
fn say(host: Host, account: domain.WriteHandle<Account>, text: String) @suspends -> Outcome<Unit> {
    when "say" (mut account, room?: Room = host.rooms[account.room]) {
        let member = check_member(account, room)?
        if account.balance_cents < SAY_PRICE_CENTS { send(member, "error insufficient balance\n") }
        else {
            account.balance_cents -= SAY_PRICE_CENTS
            broadcast(room, chat_line(&room.name, member.id, text))
        }
        Ok({})
    } else {
        let member = check_live(account)?
        send(member, "error join a room first\n")
        Ok({})
    }
}
// Moving checks and leaves the old room, then enters the new one; a failure undoes both.
fn join(host: Host, account: domain.WriteHandle<Account>, name: String) @suspends -> Outcome<Option<String>> {
    when "move" (mut account,
                 mut next: Room = host.rooms.get_or_stage(name, new_room(name.clone())),
                 mut old?: Room = host.rooms[account.room]) {
        check_member(account, old)?
        let previous = depart(account, old, true)
        enter(account, next, name)?
        Ok(previous)
    } else {
        check_live(account)?
        enter(account, next, name)?
        Ok(None)
    } alias {
        let member = check_member(account, next)?
        send(member, "error already joined\n")
        Ok(None)
    }
}
fn leave(host: Host, account: domain.WriteHandle<Account>) @suspends -> Outcome<Option<String>> {
    when "leave" (mut account, mut room?: Room = host.rooms[account.room]) {
        check_member(account, room)?
        Ok(depart(account, room, true))
    } else {
        let member = check_live(account)?
        send(member, "error join a room first\n")
        Ok(None)
    }
}

// Connection lifetime: the host opens an account before its session and forgets it after.
// The connection-local directory owns the account; the shared route stays weak.
fn init_account(input: AccountInit) @suspends {
    let AccountInit { host, owners, id, output } = input
    let member = Member { id: id, output: output }
    when "open account" (account: Account = owners.get_or_stage(id, new_account(member))) {
        send(member, "welcome {id}\n")
    }!
    host.accounts.insert(id, domain.lookup_write::<Account>(owners, id)!)!
}
// Runs once after every session, including after script failures in its commands.
fn forget(client: Client) @suspends {
    let Client { host, id } = client
    let account = match domain.lookup_write::<Account>(host.accounts, id) {
        Some(account) => account,
        None => return
    }
    let ended = when "forget" (mut account, mut room?: Room = host.rooms[account.room]) {
        account.live = false
        (account.member.output, depart(account, room, false))
    } else {
        account.live = false
        (account.member.output, None)
    }
    if let Ok((output, room)) = ended {
        output.close()
        host.accounts.remove(id, account.read_only());
        reclaim(host, &room)
    }
}
fn reclaim(host: Host, room: &Option<String>) @suspends {
    if host.config.reclaim_empty {
        if let Some(name) = room { domain.remove_named_if(host.rooms, name, empty); }
    }
}

// State and message helpers used inside atomic operations.
fn check_live(account: &Account) -> Result<Member, Rejection> {
    if account.live { Ok(account.member) } else { Err(Rejection.Stale) }
}
fn check_member(account: &Account, room: &Room) -> Result<Member, Rejection> {
    let member = check_live(account)?
    if is_member(room, member.id) { Ok(member) } else { Err(Rejection.Stale) }
}
fn enter(account: &mut Account, room: &mut Room, name: &String) -> Result<Member, Rejection> {
    if !room.name.equals(name) { return Err(Rejection.Stale) }
    let member = account.member
    add_member(room, member)
    broadcast(room, notice("joined", &room.name, member.id))
    mem.replace(&mut account.room, Some(name.clone()));
    Ok(member)
}
// Leaves the room and returns its name. A closed connection does not hear its own departure.
fn depart(account: &mut Account, room: &mut Room, notify_self: Bool) -> Option<String> {
    let member = account.member
    remove_member(room, member.id)
    let message = notice("left", &room.name, member.id)
    broadcast(room, &message)
    if notify_self { send(member, &message) }
    account.room.take()
}
fn add_member(room: &mut Room, member: Member) { room.members.push(member) }
fn remove_member(room: &mut Room, id: UInt64) {
    for index in range(0, room.members.len()) {
        if room.members.get(index)!.id == id {
            room.members.swap_remove(index);
            return
        }
    }
}
fn is_member(room: &Room, id: UInt64) -> Bool {
    for member in &room.members { if member.id == id { return true } }
    false
}
fn empty(room: &Room) -> Bool { room.members.is_empty() }
fn notice(kind: &String, room: &String, id: UInt64) -> String { "{kind} {room} {id}\n" }
fn chat_line(room: &String, id: UInt64, text: &String) -> String { "message {room} {id} {text}\n" }
fn send(member: Member, message: &String) { member.output.send(message.clone().into_bytes()) }
fn broadcast(room: &Room, message: &String) {
    let bytes = message.clone().into_bytes()
    for member in &room.members { member.output.send(&bytes) }
}
