// Loopback demo with a fixed customer. Use a dedicated demo database.
import joky/process
import postgres_orders as orders
import joky/log
import joky/postgres
import joky/http.{type ContextSource}
import joky/shutdown
import joky/tcp

#derive(FromJson)
struct Purchase { qty: Int64 }
#derive(ToJson)
struct ErrorBody { error: String }
#derive(ToJson)
struct OrderBody { order_id: Int64 }
pub struct Orders { pool: postgres.Pool }
impl ContextSource for Orders {
    type Context = Orders
    fn share(&self) @suspends @noescape -> Self { Orders { pool: self.pool.share() } }
    fn for_request(&self) @suspends @noescape -> Orders { self.share() }
}
pub fn routes(pool: postgres.Pool) -> http.ContextRouter<Orders, Orders> {
    var router = http.with_context(Orders { pool })
    router.post("/orders", create_order)!
    router
}
fn error_reply(status: http.Status, error: String) -> http.Response {
    let body = ErrorBody { error }
    match http.json(status, &body) {
        Ok(response) => response
        Err(_) => http.empty(http.Status.InternalServerError)
    }
}
fn order_key(request: &http.Request<Orders>) -> Result<String, http.Response> {
    let key = match request.header_unique("Idempotency-Key") {
        Ok(Some(key)) => key
        Ok(None) => return Err(error_reply(http.Status.BadRequest, "missing Idempotency-Key"))
        Err(_) => return Err(error_reply(http.Status.BadRequest, "invalid Idempotency-Key"))
    }
    if key.is_empty() || key.byte_length() > 128 { return Err(error_reply(http.Status.BadRequest, "invalid Idempotency-Key")) }
    Ok(key.clone())
}
fn create_order(request: http.Request<Orders>) @suspends -> http.Response {
    let key = match order_key(&request) { Ok(key) => key, Err(response) => return response }
    let input = match request.json::<Purchase>() {
        Ok(input) => input, Err(_) => return error_reply(http.Status.BadRequest, "expected a positive integer qty")
    }
    if input.qty <= 0 { return error_reply(http.Status.BadRequest, "expected a positive integer qty") }
    let outcome = orders.place(&request.ctx.pool, 1, key, input.qty)
    order_reply(request.log, outcome)
}
fn order_reply(context: http.RequestLog, result: Result<orders.Order, postgres.DbError>) -> http.Response {
    match result {
        Ok(Confirmed(id)) => {
            let body = OrderBody { order_id: id }
            match http.json(http.Status.Ok, &body) {
                Ok(response) => response
                Err(_) => http.empty(http.Status.InternalServerError)
            }
        },
        Ok(Conflict) => error_reply(http.Status.Conflict, "key already used with another quantity"),
        Ok(Insufficient) => error_reply(http.Status.Conflict, "insufficient stock"),
        Err(OutcomeUnknown) => {
            context.warn("order.commit_unknown", [log.field("method", "POST"), log.field("path", "/orders")])
            error_reply(http.Status.ServiceUnavailable, "outcome unknown; retry with the same Idempotency-Key")
        },
        Err(AcquireFailed) => error_reply(http.Status.ServiceUnavailable, "database checkout failed"),
        Err(AcquireTimeout) => error_reply(http.Status.ServiceUnavailable, "database checkout timed out"),
        Err(Unavailable) => error_reply(http.Status.ServiceUnavailable, "database unavailable; retry with the same Idempotency-Key"),
        Err(_) => error_reply(http.Status.InternalServerError, "order failed")
    }
}
fn main() @suspends -> Int32 {
    let options = http.Options { max_connections: 4, ..http.Options.default() }
    let url = process.env("JOKY_POSTGRES_URL")!!
    let pool = postgres.open(url, postgres.Options.default())!
    orders.setup(&pool)
    let signals = shutdown.with_signals()!
    let stop = signals.controller()
    var listener = tcp.listen("127.0.0.1", 0)!
    println("listening {listener.local_addr()!.port()}")
    if http.serve_with(listener, stop, options, routes(pool)).is_ok() { 0 } else { 1 }
}
