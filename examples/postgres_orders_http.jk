// Loopback demo with a fixed customer. Use a dedicated demo database.
import postgres_orders as orders
import joky/log
import joky/postgres
import joky/http.{type Service}
import joky/json/typed
import joky/shutdown
import joky/tcp

#derive(FromJson)
struct Purchase { qty: Int64 }
#derive(ToJson)
struct ErrorBody { error: String }
#derive(ToJson)
struct OrderBody { order_id: Int64 }
pub struct Orders { pool: postgres.Pool }
impl Orders {
    pub fn new(pool: postgres.Pool) -> Self { Orders { pool } }
}
fn error_reply(status: http.Status, error: String) -> http.Response {
    let body = ErrorBody { error }
    match http.json(status, &body) {
        Ok(response) => response
        Err(_) => http.empty(http.Status.InternalServerError)
    }
}
impl Service for Orders {
    fn share(&self) @suspends -> Self { Orders { pool: self.pool.share() } }
    fn route(&self, request: &http.Request) -> Option<String> {
        if request.method == http.Method.Post && request.path() == "/orders" { Some("/orders") } else { None }
    }
    fn handle(&self, request: http.Request) @suspends -> http.Response {
        if request.method != http.Method.Post || request.path() != "/orders" { return error_reply(http.Status.NotFound, "not found") }
        var keys = request.header_all("Idempotency-Key")
        if keys.is_empty() { return error_reply(http.Status.BadRequest, "missing Idempotency-Key") }
        if keys.len() != 1 { return error_reply(http.Status.BadRequest, "invalid Idempotency-Key") }
        let key = keys.take_last()
        if key.is_empty() || key.byte_length() > 128 { return error_reply(http.Status.BadRequest, "invalid Idempotency-Key") }
        let http.Request { context, method, target, headers, body } = request
        let input = match typed.decode_bytes::<Purchase>(body) {
            Ok(input) => input, Err(_) => return error_reply(http.Status.BadRequest, "expected a positive integer qty")
        }
        if input.qty <= 0 { return error_reply(http.Status.BadRequest, "expected a positive integer qty") }
        order_reply(context, orders.place(&self.pool, 1, key, input.qty))
    }
}
fn order_reply(context: http.RequestContext, result: Result<orders.Order, postgres.DbError>) -> http.Response {
    match result {
        Ok(Confirmed(id)) => {
            let body = OrderBody { order_id: id }
            match http.json(http.Status.Ok, &body) {
                Ok(response) => response
                Err(_) => http.empty(http.Status.InternalServerError)
            }
        },
        Ok(Conflict) => error_reply(http.Status.Conflict, "key already used with another quantity"),
        Ok(Insufficient) => error_reply(http.Status.Conflict, "insufficient stock"),
        Err(OutcomeUnknown) => {
            context.warn("order.commit_unknown", [log.field("route", "/orders")])
            error_reply(http.Status.ServiceUnavailable, "outcome unknown; retry with the same Idempotency-Key")
        },
        Err(AcquireFailed) => error_reply(http.Status.ServiceUnavailable, "database checkout failed"),
        Err(AcquireTimeout) => error_reply(http.Status.ServiceUnavailable, "database checkout timed out"),
        Err(Unavailable) => error_reply(http.Status.ServiceUnavailable, "database unavailable; retry with the same Idempotency-Key"),
        Err(_) => error_reply(http.Status.InternalServerError, "order failed")
    }
}
fn main() @suspends -> Int32 {
    let options = http.Options { max_connections: 4, ..http.Options.default() }
    let pool = postgres.open(options.max_connections)!
    orders.setup(&pool)
    let stop = shutdown.create()
    // Keep signal handling active until all admitted requests finish draining.
    let signals = stop.subscribe_unix()!
    var listener = tcp.listen("127.0.0.1", 0)!
    println("listening {listener.local_addr()!.port()}")
    if http.serve_with(listener, &stop, options, Orders.new(pool)).is_ok() { 0 } else { 1 }
}
