import joky/tcp.{type Address, type TcpListener, type TcpStream, type BufferedTcp, type BufferedTcpReader, type TcpWriter}
import joky/check.{assert}
import joky/integer
import joky/string
import joky/task
import joky/iter.{range}

fn ensure(ok: Bool) { assert(ok, "Duplex message session") }
// Receive commands independently of the server's unsolicited pushes.
fn commands(reader: &mut BufferedTcpReader) @suspends {
    for expected in range(1, 4) {
        let bytes = reader.read_message(16).expect("Duplex message session").expect("Duplex message session")
        let text = String.from_utf8(bytes).expect("Duplex message session")
        let command = expected.to_string()
        ensure(text == command)
    }
    ensure(reader.read_message(0).expect("Duplex message session").is_none())
}
fn pushes(writer: &mut TcpWriter) @suspends {
    for index in range(1, 4) {
        task.sleep_ms(2)
        ensure(writer.write_message(index.to_string().into_bytes(), 16).is_ok())
    }
    ensure(writer.shutdown().is_ok())
}
fn serve(listener: &mut TcpListener) @suspends {
    let stream = listener.accept().expect("Duplex message session")
    var (reader, writer) = BufferedTcp.new(stream).split()
    join { commands(&mut reader), pushes(&mut writer) }
    reader.close();
    writer.close();
}
fn send(writer: &mut TcpWriter) @suspends {
    for index in range(1, 4) {
        ensure(writer.write_message(index.to_string().into_bytes(), 16).is_ok())
        task.yield_now()
    }
    ensure(writer.shutdown().is_ok())
}
fn receive(reader: &mut BufferedTcpReader) @suspends {
    var expected: Int32 = 1
    while true {
        let bytes = match reader.read_message(16).expect("Duplex message session") {
            Some(bytes) => bytes
            None => break
        }
        let text = String.from_utf8(bytes).expect("Duplex message session")
        let value = expected.to_string()
        ensure(text == value)
        println(text)
        expected += 1
    }
    ensure(expected == 4)
}
fn client(address: Address) @suspends {
    let stream = TcpStream.connect(address).expect("Duplex message session")
    var (reader, writer) = BufferedTcp.new(stream).split()
    // Both halves stay owned by this task until the entire session ends.
    join { receive(&mut reader), send(&mut writer) }
    reader.close();
    writer.close();
}
fn main() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, _ => { return 1 } }
    let address = match listener.local_addr() { Ok(address) => address, _ => { return 2 } }
    join { serve(&mut listener), client(address) }
    ensure(listener.close().is_ok())
    0
}
