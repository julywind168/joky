import joky/drop.{type Drop}

struct Resource { id: Int32, values: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { println(self.id) } }
fn resource(id: Int32) -> Resource {
    Resource { id, values: [id] }
}
fn main() {
    let zipped = Some(resource(1)).zip(Some(resource(2)))
    match zipped {
        None => println(0)
        Some((left, right)) => println(left.id + right.id)
    }
    // Discarded members are cleaned up before the retained binding is used.
    let (_, (kept, answer)) = (resource(4), (resource(5), 42))
    println(answer)
    println(kept.values[0])
}
