import joky/array.{type Array}
import joky/iter
import joky/io.{println}

fn main() {
    let scores = [55, 80, 65, 90]
    let threshold = 60
    let passed = iter.shared(&scores)
        .filter(|score| { *score >= threshold })
        .take(2)

    for score in passed { println(*score) }

    let bonus = 5
    for score in iter.shared(&scores)
        .filter(|score| { *score >= threshold })
        .map(|score| { *score + bonus })
        .take(2)
    {
        println(score)
    }
    println(scores.len()) // Captures and the source are borrowed, not consumed.
}
