extern fn print_int(value: Int32)

fn sum_until(n: Int32, limit: Int32) -> Int32 {
    if n <= 0 { return 0 }
    var i = 0
    var total = 0
    while i < n {
        i = i + 1
        if i == 2 { continue }
        if i > limit { break }
        total = total + i
    }
    total
}

fn main() {
    print_int(sum_until(0, 5))
    print_int(sum_until(3, 5))
    print_int(sum_until(10, 5))
    return
}
