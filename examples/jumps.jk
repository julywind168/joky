fn sum_until(n: Int32, limit: Int32) -> Int32 {
    if n <= 0 { return 0 }
    var total = 0
    for i in 1 ..= n {
        if i == 2 { continue }
        if i > limit { break }
        total += i
    }
    total
}

fn main() {
    println(sum_until(0, 5))
    println(sum_until(3, 5))
    println(sum_until(10, 5))
    return
}
