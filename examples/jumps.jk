import joky/io.{println}

fn sum_until(n: Int32, limit: Int32) -> Int32 {
    if n <= 0 { return 0 }
    var i = 0
    var total = 0
    while i < n {
        i = i + 1
        if i == 2 { continue }
        if i > limit { break }
        total = total + i
    }
    total
}

fn main() {
    { let displayed: Int32 = sum_until(0, 5) println(&displayed) }
    { let displayed: Int32 = sum_until(3, 5) println(&displayed) }
    { let displayed: Int32 = sum_until(10, 5) println(&displayed) }
    return
}
