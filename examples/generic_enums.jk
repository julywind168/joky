// Option, Result and their constructors come from the default prelude.

fn unwrap_or<T>(value: Option<T>, fallback: T) -> T {
    match value {
        None => fallback
        Some(value) => value
    }
}

fn checked_divide(a: Int32, b: Int32) -> Result<Int32, Bool> {
    if b == 0 { Err(false) } else { Ok(a / b) }
}

fn main() {
    println(unwrap_or(Some(42), 0))
    let absent: Option<Int32> = None
    println(unwrap_or(absent, 7))
    let nested: Option<Option<UInt64>> = Some(Some(0xffff_ffff_ffff_ffff))
    println(unwrap_or(unwrap_or(nested, None), 0))
    println(match checked_divide(84, 2) { Ok(n) => n, Err(reason) => -1 })
    println(match checked_divide(84, 0) { Ok(n) => n, Err(reason) => -1 })
}
