import joky/io.{println}

// The root call owns the arena. Helpers need no allocator parameter.
struct Point { x: Int32, y: Int32 }
fn make_point() -> &mut Point { alloc(Point { x: 1, y: 2 }) }
fn move_point(point: &mut Point, distance: Int32) { point.x = point.x + distance }
fn sum(point: &Point) -> Int32 { point.x + point.y }
fn main() -> Int32 {
    let point = make_point()
    move_point(point, 10)
    let view: &Point = point
    println(sum(view))        // 13
    point.y = 5                // the last shared use has ended
    println(sum(point))       // 16; the call borrows a shared view
    0
}
