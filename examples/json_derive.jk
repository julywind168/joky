import joky/json/typed
import joky/result.{Ok, Err}
import joky/option.{type Option}
import joky/check.{assert, panic}

#derive(ToJson, FromJson)
struct User { name: String, age: UInt8, nickname: Option<String> }
fn main() {
    let input = r#"{"name":"Ada","age":37}"#
    let user = typed.decode::<User>(&input)!
    println(user.name)
    println(user.age)
    let output = typed.encode(&user)!
    assert(typed.decode::<User>(&output).is_ok(), "typed JSON roundtrip")

    // Invalid input remains an ordinary error that callers can inspect.
    let invalid = r#"{"name":"Ada","age":256}"#
    match typed.decode::<User>(&invalid) {
        Err(typed.CodecError.Mapping(error)) => println(error.pointer())
        _ => panic("Expected an out-of-range age")
    }
}
