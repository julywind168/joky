import joky/json/typed as typed
import joky/result.{Ok, Err}
import joky/option.{type Option}
import joky/check.{require}

#derive(ToJson, FromJson)
struct User { name: String, age: UInt8, nickname: Option<String> }
fn ensure(ok: Bool) { let message = "typed JSON example" require(ok, &message) }
fn main() {
    let input = "{{\"name\":\"Ada\",\"age\":37}}"
    match typed.decode::<User>(&input) {
        Ok(user) => {
            println(user.name)
            println(user.age)
            match typed.encode(&user) {
                Ok(output) => { ensure(typed.decode::<User>(&output).is_ok()) }
                Err(_) => { ensure(false) }
            }
        }
        Err(_) => { ensure(false) }
    }
    let invalid = "{{\"name\":\"Ada\",\"age\":256}}"
    match typed.decode::<User>(&invalid) {
        Err(typed.CodecError.Mapping(error)) => { println(error.pointer()) }
        _ => { ensure(false) }
    }
}
