import joky/io.{println}

type Count = Int64
struct Counters { total: Count, pending: Count }

fn add(a: Count, b: Count) -> Count { a + b }
fn minimum() -> Count { -9223372036854775808 }

fn main() {
    let base: Count = 3000000000
    println(add(base, 42))
    let counts = Counters { total: 6000000000, pending: 1000000000 }
    let (total, pending): (Count, Count) = (counts.total, counts.pending)
    println(total - pending)
    println(minimum() / -1)
}
