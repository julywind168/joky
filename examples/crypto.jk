import joky/crypto.{type Sha256, type HmacSha256}
import joky/hex
import joky/random
import joky/task

fn main() @suspends {
    let message = "hello"
    let head = "hel"
    let tail = "lo"
    var hash = Sha256.new()
    hash.update(head.bytes())
    task.yield_now()
    hash.update(tail.bytes())
    let digest = hash.finish()
    println(hex.encode(&digest[..]))

    match random.secure_bytes(32) {
        Ok(key) => {
            var mac = HmacSha256.new(&key[..])
            mac.update(head.bytes())
            task.yield_now()
            mac.update(tail.bytes())
            let tag = mac.finish()
            println(hex.encode(&tag[..]))
            var verifier = HmacSha256.new(&key[..])
            verifier.update(message.bytes())
            println(verifier.verify(&tag[..]))
            let changed = "hello!"
            println(crypto.verify_hmac_sha256(&key[..], changed.bytes(), &tag[..]))
        }
        Err(_) => println("Secure randomness unavailable")
    }
}
