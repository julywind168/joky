import joky/io.{println}

import joky/string as text
import joky/array.{type Array}

fn main() {
    let input = "|中||🙂|"
    let separator = "|"
    match input.split(&separator) {
        | Err(text.SplitError.EmptySeparator) => { { let displayed: Int32 = -1 println(&displayed) } }
        | Ok(parts) => {
            input.release()
            { let displayed: Int32 = int32(parts.len()) println(&displayed) }
            let joined = text.join(&parts, &separator)
            parts.release()
            { let displayed: Int32 = int32(joined.byte_length()) println(&displayed) }
            { let displayed: Int32 = int32(joined.rune_count()) println(&displayed) }
        }
    }
}
