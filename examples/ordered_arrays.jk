import joky/io.{println}

import joky/array.{type Array}
struct Resource { id: Int32, values: Array<Int32> }
fn resource(id: Int32) -> Resource { Resource { id: id, values: Array.new::<Int32>() } }
fn main() {
    var values = Array.new::<Resource>()
    values.insert(0, resource(20))
    values.insert(0, resource(22))
    values.insert(1, resource(21))
    match values.remove(1) { Some(item) => { let displayed: Int32 = item.id println(&displayed) }, None => { let displayed: Int32 = 0 println(&displayed) } }
    { let displayed: Int32 = values.borrow_ref(0).id println(&displayed) }
    { let displayed: Int32 = values.borrow_ref(1).id println(&displayed) }
    { let displayed: Int32 = if values.insert(99, resource(0)) { 1 } else { 0 } println(&displayed) }
}
