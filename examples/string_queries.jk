// Byte offsets and Unicode scalar counts are deliberately different.
fn main() {
    let input: Array<UInt8> = [0xe4, 0xb8, 0xad]
    match String.from_utf8(input) {
        Err(error) => { println(error.offset) }
        Ok(value) => {
            let combined = value.concat("🙂e\u{301}")
            let piece = combined.substring(0, 7).unwrap_or("")
            println(piece.byte_length())
            println(combined.rune_count())
            for rune in combined.runes() {
                println(rune.to_u32())
            }
            let number: Int64 = -9223372036854775808
            let decimal = number.to_string()
            println(decimal.byte_length())
        }
    }
}
