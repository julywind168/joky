import joky/list.{type List}

fn main() {
    var words = List.new::<String>()
    words.push_back("first"); words.push_front("before"); words.push_back("last")
    words.remove(1)
    // Logical position zero follows the links, including after a reversal.
    words.reverse()
    for first in &words { println(first); break }
    words.extend(["extra"])
    var other = List.new::<String>(); other.push_back("tail")
    words.append(&mut other)
    println(other.len())
    for word in &words { println(word) }
}
