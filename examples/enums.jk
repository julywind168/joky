extern fn print_int(value: Int32)

struct Point { x: Int32 y: Int32 }
enum Lookup { Missing Found(Point) }
type Result = Lookup

fn find(found: Bool) -> Result {
    if found { Lookup.Found(Point { x: 19 y: 23 }) } else { Lookup.Missing }
}
fn value(result: Result) -> Int32 {
    match result {
        | Lookup.Missing => 0
        | Found(point) => point.x + point.y
    }
}
fn main() {
    print_int(value(find(false)))
    print_int(value(find(true)))
}
