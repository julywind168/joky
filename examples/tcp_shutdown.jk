// One request per connection. Send `shutdown` to drain, or `slow` to exercise the deadline.
import joky/shutdown
import joky/task
import joky/tcp.{type TcpListener, type TcpStream, type BufferedTcp}

fn connection(stream: TcpStream, stop: &shutdown.Controller) @suspends {
    var stream = BufferedTcp.new(stream)
    let input = &mut stream
    let result: Option<String> = race { { stop.wait(); None }, { input.read_line(128).unwrap_or(None) } }
    let line = match result {
        Some(line) => line,
        None => return,
    }
    // This final state observation is the request admission point.
    if stop.requested() { return }
    if line == "shutdown" {
        stream.write_all("shutting down\n".into_bytes());
        stop.request();
        return
    }
    println("accepted")
    if line == "slow" { task.sleep(60s) } else { task.sleep(250ms) }
    stream.write_all("done\n".into_bytes());
}
fn serve(stop: &shutdown.Controller, var listener: TcpListener) @suspends -> Int32 {
    scope {
        while !stop.requested() {
            let stream = match listener.accept_until(stop) {
                Ok(Some(stream)) => stream,
                _ => break,
            }
            if stop.requested() { break }
            branch { connection(stream, stop) }
        }
        // Close before scope waits for existing connections, not after it returns.
        listener.close();
        println("stopped accepting")
    }
    0
}
fn deadline(stop: &shutdown.Controller) @suspends -> Int32 {
    stop.wait();
    task.sleep(1s)
    1
}
fn main() @suspends -> Int32 {
    let signals = match shutdown.with_signals() {
        Ok(signals) => signals,
        Err(_) => { eprintln("Could not subscribe to Unix signals"); return 2 },
    }
    let stop = signals.controller()
    var listener = tcp.listen("127.0.0.1", 0).unwrap()
    println("listening {listener.local_addr().unwrap().port()}")
    let result = race { serve(stop, listener), deadline(stop) }
    println(if result == 0 { "drained" } else { "deadline reached" })
    result
}
