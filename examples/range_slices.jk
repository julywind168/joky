import joky/io.{println}
import joky/slice
import joky/fixed_array.{type FixedArray}

fn main() {
    var values = [10, 20, 30, 40]
    let middle = &values[1..3]
    for value in middle { println(*value) } // 20, 30

    let writable = &mut values[1..=2]
    for value in &mut *writable { *value += 1 }
    for value in &values { println(*value) } // 10, 21, 31, 40

    let tail = &values[2..4]
    let first = &tail[0..1]
    println(first[0]) // 31; subslice indices are relative to tail.

    let fixed: FixedArray<Int32, 3> = [1, 2, 3]
    println(slice.len(&fixed[0..=1])) // 2
    println(slice.len(&values[4..4])) // 0; an empty half-open slice is valid.
}
