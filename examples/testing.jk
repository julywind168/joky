import joky/iter
import joky/task

fn add(left: Int32, right: Int32) -> Int32 { left + right }

#test
fn adds_numbers() {
    assert_eq(add(2, 3), 5)
}

#test
fn filters_with_local_threshold() {
    let scores = [55, 80, 65, 90]
    let threshold = 60
    let bonus = 5
    var total = 0
    for score in iter.shared(&scores)
    .filter(| score | { *score >= threshold })
    .map(| score | { *score + bonus })
    .take(2)
    {
        total += score
    }
    assert_eq(total, 155)
    assert_eq(scores.len(), 4)
}

#test
fn preserves_values_across_suspension() @suspends {
    let value = add(20, 22)
    task.yield_now()
    assert_eq(value, 42)
    let text = "ready"
    assert_eq(text, "ready")
    assert_ne(text, "")
    assert_eq(text.byte_length(), 5)
}
