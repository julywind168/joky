import joky/tcp.{type Address, type TcpListener, type TcpStream, type BufferedTcp, type BufferedTcpReader, type TcpWriter}
import joky/json.{type Value, type Number, type Limits}
import joky/array.{type Array}
import joky/option.{type Option}
import joky/mem
import joky/check.{assert}
import joky/task

fn ensure(ok: Bool) { assert(ok, "JSON message session") }
fn limits() -> Limits {
    var value = Limits.defaults()
    value.max_input_bytes = 65536; value.max_output_bytes = 65536
    value.max_depth = 16; value.max_nodes = 4096; value.max_string_bytes = 32768
    value
}
fn decoded(text: String) -> Value {
    match json.decode_with_limits(&text, limits()) { Ok(value) => value, Err(_) => { ensure(false); Value.Null } }
}
fn envelope(kind: String, id: UInt64, payload: Value) -> Value {
    var items = Array.new::<Value>()
    items.push(Value.Text(kind)); items.push(Value.Number(Number.from_u64(id))); items.push(payload)
    Value.Array(items)
}
// Only integer IDs and exactly three fields belong to this application protocol.
fn message_id(value: &Value, kind: &String) -> Option<UInt64> {
    match value {
        Array(items) => {
            if items.len() != 3 { return Option.None }
            match items.borrow_ref(0) { Text(text) => { if !text.equals(kind) { return Option.None } }, _ => { return Option.None } }
            match items.borrow_ref(1) { Number(number) => number.to_u64().ok(), _ => Option.None }
        }
        _ => Option.None
    }
}
fn send_value(writer: &mut TcpWriter, value: &Value) @suspends -> Bool {
    // Finish bounded encoding before writing any part of the frame.
    match json.encode_with_limits(value, limits()) {
        Ok(text) => writer.write_message(text.into_bytes(), 65536).is_ok()
        Err(_) => false
    }
}
fn reply(value: Value) -> Value {
    var value = value
    match &mut value { Array(items) => { mem.replace(items.borrow_mut_ref(0), Value.Text("reply")); }, _ => ensure(false) }
    value
}
// Complete malformed JSON/schema frames are recoverable. A transport error ends the session.
fn exchange(reader: &mut BufferedTcpReader, writer: &mut TcpWriter) @suspends -> Int32 {
    let push = envelope("push", 0, decoded("{{\"ready\":true,\"text\":\"你🙂\\u0000\"}}"))
    if !send_value(writer, &push) { return -1 }
    var replies: Int32 = 0
    while true {
        let bytes = match reader.read_message(65536) {
            Ok(Some(bytes)) => bytes, Ok(None) => { break }, Err(_) => { return -2 }
        }
        let output = match json.decode_bytes_with_limits(bytes, limits()) {
            Err(_) => envelope("error", 0, Value.Text("invalid-json"))
            Ok(value) => {
                match message_id(&value, "request") {
                    Some(_) => { replies = replies + 1; reply(value) }
                    None => envelope("error", 0, Value.Text("invalid-request"))
                }
            }
        }
        if !send_value(writer, &output) { return -3 }
    }
    if !writer.shutdown().is_ok() { return -4 }
    replies
}
fn serve(listener: &mut TcpListener) @suspends {
    let stream = match listener.accept() { Ok(stream) => stream, _ => { ensure(false); return } }
    var (reader, writer) = BufferedTcp.new(stream).split()
    ensure(exchange(&mut reader, &mut writer) == 2)
    reader.close(); writer.close();
}
fn send(writer: &mut TcpWriter) @suspends {
    ensure(writer.write_message("[".into_bytes(), 65536).is_ok())
    let first = envelope("request", 1, decoded("[18446744073709551616,1e400,\"你🙂\\u0000\",{{\"items\":[null,true]}}]"))
    ensure(send_value(writer, &first))
    let invalid = decoded("[\"request\",1.5,null]")
    ensure(send_value(writer, &invalid))
    let second = envelope("request", 2, Value.Boolean(true))
    ensure(send_value(writer, &second))
    ensure(writer.shutdown().is_ok())
}
fn receive(reader: &mut BufferedTcpReader) @suspends {
    var index: Int32 = 0
    while true {
        let bytes = match reader.read_message(65536) { Ok(Some(bytes)) => bytes, Ok(None) => { break }, Err(_) => { ensure(false); return } }
        let value = match json.decode_bytes_with_limits(bytes, limits()) { Ok(value) => value, Err(_) => { ensure(false); return } }
        let kind = if index == 0 { "push" } else if index == 1 || index == 3 { "error" } else { "reply" }
        let expected: UInt64 = if index == 2 { 1 } else if index == 4 { 2 } else { 0 }
        ensure(message_id(&value, &kind).unwrap_or(99) == expected)
        println(kind)
        index = index + 1
    }
    ensure(index == 5)
}
fn client(address: Address) @suspends {
    let stream = match TcpStream.connect(address) { Ok(stream) => stream, _ => { ensure(false); return } }
    var (reader, writer) = BufferedTcp.new(stream).split()
    parallel { | receive(&mut reader) | send(&mut writer) }
    reader.close(); writer.close();
}
fn main() @suspends -> Int32 {
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 0)) { Ok(listener) => listener, _ => { return 1 } }
    let address = match listener.local_addr() { Ok(address) => address, _ => { return 2 } }
    parallel { | serve(&mut listener) | client(address) }
    ensure(listener.close().is_ok())
    0
}
