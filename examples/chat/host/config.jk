import joky/process

pub fn port(name: String, fallback: UInt16) @suspends -> Result<UInt16, String> {
    let text = match process.env(name) {
        Ok(Some(value)) => value
        Ok(None) => { return Ok(fallback) }
        Err(error) => { return Err(error.message) }
    }
    match UInt16.parse(&text) {
        Ok(port) => Ok(port)
        Err(_) => Err("{name} must be a decimal port in 0..65535")
    }
}
