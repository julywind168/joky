// AOT chat host: owns sockets, directories and the script VM; business rules live in
// script/main.jk and are republished through the admin port without dropping connections.
import host/config as startup
import host/admin
import contract.{type Contract, type Host, type Call, type AccountInit, type Client, type Config, require_contract}
import joky/vm
import joky/domain
import joky/session
import joky/admission
import joky/shutdown
import joky/task
import joky/tcp.{type TcpListener, type TcpStream}

struct Script { vm: vm.Vm, entries: Contract }

fn script_path() -> String { "script/main.jk" }

// Each handler owns its script handle and client identity.
struct ClientHandler { script: Script, client: Client }
impl session.Handler for ClientHandler {
    type Message = String
    fn on_message(&self, text: String) @suspends @noescape -> Bool {
        let script = &self.script
        let call = Call { host: self.client.host, id: self.client.id, line: text }
        script.entries.dispatch.try_call(&script.vm, call).unwrap_or(false)
    }
    fn on_close(&self) @suspends @noescape {
        let script = &self.script
        script.entries.forget.try_call(&script.vm, self.client);
    }
}

// Normal exit runs membership cleanup; deadline cancellation releases outer owners.
fn connection(script: Script, host: Host, id: UInt64, stream: TcpStream, permit: admission.Permit, stop: shutdown.Controller) @suspends {
    let owners = domain.directory(1)
    let connection = session.create(host.config.connection)
    let client = Client { host, id }
    let account = AccountInit { host, owners: owners.handle(), id, output: connection.output() }
    let initialized = script.entries.init_account.try_call(&script.vm, account).is_ok()
    let handler = ClientHandler { script, client }
    if initialized {
        if let Err(error) = session.run_draining(connection, stream, host.config.input, &handler, &stop) {
            match error {
                Read(error) => eprintln("connection {id}: read: {error}"),
                Write(error) => eprintln("connection {id}: write: {error}"),
                ReadAndWrite((read, write)) => eprintln("connection {id}: read: {read}; write: {write}")
            }
        }
    } else {
        handler.on_close()
    }
    permit.release()
}
// Each connection runs in its own failure boundary; one failing client never stops the rest.
fn serve(script: &Script, host: Host, var listener: TcpListener, stop: &shutdown.Controller) @suspends -> Int32 {
    let admission = admission.create(host.config.max_clients, 0)
    let entrants = admission.handle()
    var next_id: UInt64 = 1
    scope {
        while !stop.requested() {
            let Ok(Some(stream)) = listener.accept_until(stop) else { break }
            if stop.requested() { break }
            let Ok(permit) = entrants.try_acquire() else { continue }
            let id = next_id
            next_id += 1
            let copy = Script { vm: script.vm.share(), entries: script.entries.clone() }
            let connection_stop = stop.share()
            branch {
                if let Err(failure) = isolate { connection(copy, host, id, stream, permit, connection_stop) } {
                    eprintln("connection {id}: {failure}")
                }
            }
        }
        admission.close();
        listener.close();
        stop.request();
    }
    0
}
fn services(script: &Script, host: Host, chat: TcpListener, admin_listener: TcpListener, stop: &shutdown.Controller) @suspends -> Int32 {
    let (business, admin_status) = join {
        serve(script, host, chat, stop)
        admin.serve(&script.vm, script_path(), admin_listener, stop)
    }
    if business != 0 || admin_status != 0 { 1 } else { 0 }
}
fn deadline(stop: &shutdown.Controller) @suspends -> Int32 {
    stop.wait(); task.sleep(5s); 1
}
fn main() @suspends -> Int32 {
    let chat_port = match startup.port("JOKY_CHAT_PORT", 7777) {
        Ok(port) => port, Err(error) => { eprintln(error); return 2 }
    }
    let admin_port = match startup.port("JOKY_ADMIN_PORT", 7778) {
        Ok(port) => port, Err(error) => { eprintln(error); return 2 }
    }
    let engine = vm.Vm.new()
    engine.module_file("contract", "contract.jk")!
    let entries = require_contract(&engine)
    match engine.load_file(script_path()) {
        Ok(_) => {},
        Err(error) => {
            admin.report(error)
            return 1
        }
    }
    let config = Config.default()
    let rooms = domain.directory(config.max_rooms)
    let accounts = domain.directory(config.max_clients)
    let host = Host { config, rooms: rooms.handle(), accounts: accounts.handle() }
    var chat = match tcp.listen("127.0.0.1", chat_port) {
        Ok(listener) => listener, Err(_) => { eprintln("Could not bind chat listener"); return 1 }
    }
    var admin_listener = match tcp.listen("127.0.0.1", admin_port) {
        Ok(listener) => listener, Err(_) => { eprintln("Could not bind admin listener"); return 1 }
    }
    let signals = match shutdown.with_signals() {
        Ok(signals) => signals,
        Err(_) => { eprintln("Could not subscribe to Unix signals"); return 2 }
    }
    let stop = signals.controller()
    println("chat {chat.local_addr()!.port()}")
    println("admin {admin_listener.local_addr()!.port()}")
    let script = Script { vm: engine, entries }
    race {
        services(&script, host, chat, admin_listener, stop)
        deadline(stop)
    }
}
