extern fn print_int(value: Int32)
extern fn print_int64(value: Int64)
extern fn print_uint32(value: UInt32)
extern fn print_uint64(value: UInt64)

fn main() {
    let bits: UInt32 = 0xffff_ffff
    print_int(int32(bits))
    print_int64(int64(bits))
    print_uint32(uint32(-1))
    print_uint64(uint64(-1))
    let wide: UInt64 = 0x1_0000_002a
    print_int(int32(wide))
    print_int64(int64(0x7fff_ffff + 1))
}
