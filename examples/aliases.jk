import joky/vm

type Count = Total
type Total = Int32
type Nothing = Unit
type Handle = vm.Vm

fn add(a: Count, b: Total) -> Count { a + b }

fn main() -> Nothing {
    let engine: Handle = vm.Vm.interpreter()
    vm.load_source(engine, "type Count = Int32 fn value() -> Count {{ 42 }}")
    println(add(vm.call_int32_0(engine, "value"), 1))
    vm.close(engine);
}
