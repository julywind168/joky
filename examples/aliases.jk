import joky/io.{println}

import joky/vm

type Count = Total
type Total = Int32
type Nothing = Unit
type Handle = vm.Vm


fn add(a: Count, b: Total) -> Count { a + b }

fn main() -> Nothing {
    let engine: Handle = vm.Vm.interpreter()
    { let vm_text = "type Count = Int32 fn value() -> Count {{ 42 }}"; vm.load_source(engine, &vm_text) }
    println(add({ let vm_text = "value"; vm.call_int32_0(engine, &vm_text) }, 1))
    vm.close(engine);
}
