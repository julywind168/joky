import joky/vm

type Count = Total
type Total = Int32
type Nothing = Unit
type Handle = vm.Handle

extern fn print_int(value: Count) -> Nothing

fn add(a: Count, b: Total) -> Count { a + b }

fn main() -> Nothing {
    let engine: Handle = vm.create_interpreter()
    vm.load_source(engine, "type Count = Int32 fn value() -> Count { 42 }")
    print_int(add(vm.call_int32(engine, "value"), 1))
    vm.close(engine);
}
