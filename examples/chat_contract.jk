import joky/domain
import joky/vm
import joky/session

pub struct Config {
    pub connection: session.Options,
    pub max_rooms: UInt64,
    pub max_clients: UInt64,
    pub reclaim_empty: Bool
}
pub fn defaults() -> Config {
    Config { connection: session.defaults(),
        max_rooms: 4096, max_clients: 512, reclaim_empty: true }
}
pub struct Host {
    pub config: Config,
    pub rooms: domain.DirectoryHandle,
    pub accounts: domain.DirectoryHandle,
}
pub enum Action { Welcome, Line(String), Disconnect }
pub struct Client { pub host: Host, pub id: UInt64 }
pub struct Call { pub host: Host, pub id: UInt64, pub action: Action }
pub struct AccountInit {
    pub host: Host,
    pub owners: domain.DirectoryHandle,
    pub id: UInt64,
    pub output: session.Output,
}

#derive(Clone)
pub struct Contract {
    pub dispatch: vm.Entry<Call, Bool>,
    pub init_account: vm.Entry<AccountInit, Unit>,
    pub forget: vm.Entry<Client, Unit>
}
pub fn require_contract(engine: &vm.Vm) @suspends -> Contract {
    Contract {
        dispatch: engine.require::<Call, Bool>("dispatch")!,
        init_account: engine.require::<AccountInit, Unit>("init_account")!,
        forget: engine.require::<Client, Unit>("forget")!
    }
}
