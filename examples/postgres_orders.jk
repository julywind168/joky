// Run against a dedicated demo database selected by this application's environment.
import joky/process
import joky/postgres

#derive(FromRow)
struct StoredOrder { id: Int64, qty: Int64 }

pub enum Order { Confirmed(Int64), Conflict, Insufficient }
pub fn setup(pool: &postgres.Pool) @suspends {
    pool.execute("CREATE TABLE IF NOT EXISTS joky_demo_stock (sku integer PRIMARY KEY, available bigint NOT NULL CHECK (available >= 0))", [])!
    pool.execute("INSERT INTO joky_demo_stock VALUES (1, 100) ON CONFLICT DO NOTHING", [])!
    pool.execute("CREATE TABLE IF NOT EXISTS joky_demo_orders (id bigserial PRIMARY KEY, customer bigint NOT NULL, request_id text NOT NULL, qty bigint NOT NULL CHECK (qty > 0), UNIQUE(customer, request_id))", [])!;
}
pub fn place(pool: &postgres.Pool, customer: Int64, key: String, qty: Int64) @suspends -> Result<Order, postgres.DbError> {
    if qty <= 0 || key.is_empty() { return Err(postgres.DbError.InvalidRequest) }
    pool.transaction(move |tx| @suspends {
        let inserted = tx.execute("INSERT INTO joky_demo_orders (customer, request_id, qty) VALUES ($1,$2,$3) ON CONFLICT (customer, request_id) DO NOTHING",
            [postgres.param(&customer), postgres.param(&key), postgres.param(&qty)])?
        let row = tx.query_one_as::<StoredOrder>("SELECT qty, id FROM joky_demo_orders WHERE customer=$1 AND request_id=$2", [postgres.param(&customer), postgres.param(&key)])?
        let id = row.id
        if row.qty != qty { return Ok(postgres.TxOutcome.Rollback(Order.Conflict)) }
        if inserted == 1 {
            let updated = tx.execute("UPDATE joky_demo_stock SET available=available-$1 WHERE sku=1 AND available >= $1", [postgres.param(&qty)])?
            if updated == 0 { return Ok(postgres.TxOutcome.Rollback(Order.Insufficient)) }
        }
        Ok(postgres.TxOutcome.Commit(Order.Confirmed(id)))
    })
}
fn main() @suspends {
    let url = process.env("JOKY_POSTGRES_URL")!!
    let pool = postgres.open(url, postgres.Options { max_connections: 2, ..postgres.Options.default() })!
    setup(&pool)
    match place(&pool, 1, "example-order-1", 10)! {
        Confirmed(id) => println("order {id}"), Conflict => println("key conflict"), Insufficient => println("insufficient stock")
    }
}
