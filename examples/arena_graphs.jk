// Shared fields connect objects in the current task's implicit arena.
struct Node { value: Int32, next: Option<&Node> }
fn push(head: Option<&Node>, value: Int32) -> &Node {
    &*alloc(Node { value: value, next: head })
}
fn sum(head: Option<&Node>) -> Int32 {
    match head { None => 0, Some(node) => node.value + sum(node.next) }
}

// Both edges share the same leaf. Publication seals the object for reading.
enum Expr { Number(Int32), Add((&Expr, &Expr)) }
fn evaluate(tree: &Expr) -> Int32 {
    match *tree {
        Number(value) => value
        Add(pair) => { let (left, right) = pair; evaluate(left) + evaluate(right) }
    }
}
fn main() -> Int32 {
    let first = push(None, 20)
    let second = push(Some(first), 22)
    println(sum(Some(second))) // 42
    let leaf = &*alloc(Expr.Number(21))
    let tree = &*alloc(Expr.Add((leaf, leaf)))
    println(evaluate(tree))    // 42
    0
}
