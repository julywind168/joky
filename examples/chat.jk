// AOT chat host: owns sockets, directories and the script VM; business rules live in
// chat_logic.jk and are republished through the admin port without dropping connections.
import chat_admin
import chat_contract.{type Contract, type Host, type Call, type AccountInit, type Client, defaults, require_contract}
import joky/vm
import joky/domain
import joky/session
import joky/admission
import joky/task
import joky/tcp.{type TcpListener, type TcpStream}

struct Script { vm: vm.Vm, entries: Contract }

fn script_path() -> String { "examples/chat_logic.jk" }

// Session callbacks forward to the current script version.
fn line(script: &Script, client: &Client, text: String) @suspends @noescape -> Bool {
    let call = Call { host: client.host, id: client.id, line: text }
    script.entries.dispatch.try_call(&script.vm, call).unwrap_or(false)
}
fn closed(script: &Script, client: &Client) @suspends @noescape {
    script.entries.forget.try_call(&script.vm, *client);
}

// One connection: open its account, run the session, then always forget the account.
fn connection(script: Script, host: Host, id: UInt64, stream: TcpStream, permit: admission.Permit) @suspends {
    let owners = domain.directory(1)
    let connection = session.create(host.config.connection)
    let client = Client { host, id }
    let account = AccountInit { host, owners: owners.handle(), id, output: connection.output() }
    if script.entries.init_account.try_call(&script.vm, account).is_ok() {
        session.run(connection, stream, &script, &client, line, closed)
    } else {
        closed(&script, &client)
    }
    permit.release()
}
fn report_failure(id: UInt64, failure: &task.Failure) {
    let reason = match failure {
        Runtime => "runtime failure"
        ResourceLimit => "resource limit"
        Host => "host failure"
        Io => "I/O failure"
        InvalidState => "invalid state"
        InvalidArgument => "invalid argument"
        Other => "task failure"
    }
    println("connection {id}: {reason}")
}
// Each connection runs in its own failure boundary; one failing client never stops the rest.
fn serve(script: &Script, host: Host, var listener: TcpListener) @suspends -> Int32 {
    let admission = admission.create(host.config.max_clients, 0)
    let entrants = admission.handle()
    var next_id: UInt64 = 1
    scope {
        while true {
            let stream = match listener.accept() { Ok(stream) => stream, Err(_) => break }
            let permit = match entrants.try_acquire() { Ok(permit) => permit, Err(_) => continue }
            let id = next_id
            next_id += 1
            let copy = Script { vm: script.vm.share(), entries: script.entries.clone() }
            branch {
                if let Err(failure) = isolate { connection(copy, host, id, stream, permit) } {
                    report_failure(id, &failure)
                }
            }
        }
    }
    0
}
fn main() @suspends -> Int32 {
    let engine = vm.Vm.new()
    engine.module_file("chat_contract", "examples/chat_contract.jk")!
    let entries = require_contract(&engine)
    match engine.load_file(script_path()) {
        Ok(_) => {},
        Err(error) => {
            chat_admin.report(error)
            return 1
        }
    }
    let config = defaults()
    let rooms = domain.directory(config.max_rooms)
    let accounts = domain.directory(config.max_clients)
    let host = Host { config, rooms: rooms.handle(), accounts: accounts.handle() }
    var chat = match tcp.listen("127.0.0.1", 7777) {
        Ok(listener) => listener, Err(_) => { println("Could not bind chat listener"); return 1 }
    }
    var admin = match tcp.listen("127.0.0.1", 7778) {
        Ok(listener) => listener, Err(_) => { println("Could not bind admin listener"); return 1 }
    }
    println("chat {chat.local_addr()!.port()}")
    println("admin {admin.local_addr()!.port()}")
    let script = Script { vm: engine, entries }
    race {
        | serve(&script, host, chat)
        | chat_admin.serve(&script.vm, script_path(), admin)
    }
}
