import chat_admin
import chat_contract.{type Host, type Action, type Call, type RoomInit, type RoomKey, type AccountInit, type Client, defaults, require_contract}
import joky/vm
import joky/domain
import joky/outbox
import joky/session
import joky/admission
import joky/option.{type Option}
import joky/tcp.{type Address, type TcpListener, type TcpStream}

fn script_path() -> String { "examples/chat_logic.jk" }
fn dispatch(engine: &vm.Vm, client: Client, action: Action) @suspends -> Bool {
    engine.try_call::<Call, Bool>("dispatch", Call { host: client.host, id: client.id, action: action }).unwrap_or(false)
}
fn line(engine: &vm.Vm, client: &Client, text: String) @suspends @noescape -> Bool {
    dispatch(engine, *client, Action.Line(text))
}
fn disconnected(engine: &vm.Vm, client: &Client) @suspends @noescape {
    dispatch(engine, *client, Action.Disconnect);
    engine.try_call::<Client, Unit>("forget", *client);
}
fn connection(engine: &vm.Vm, host: Host, id: UInt64, stream: TcpStream, permit: admission.Permit) @suspends {
    let owners = domain.directory(1)
    let connection = session.create(host.config.connection)
    let input = AccountInit { host: host, owners: owners.handle(), id: id, output: connection.output(), stop: connection.stop_handle() }
    let client = Client { host: host, id: id }
    if engine.try_call::<AccountInit, Unit>("init_account", input).is_err() || !refresh(engine) {
        disconnected(engine, &client)
        return
    }
    if !dispatch(engine, client, Action.Welcome) { disconnected(engine, &client); return }
    session.run(connection, stream, engine, &client, line, disconnected)
    permit.release()
}
// Creation may have started in an older module while publication was in flight.
// Bring newly created roots to the current module before exposing them to clients.
fn refresh(engine: &vm.Vm) -> Bool { vm.publish_domain_code(engine) >= 0 }
fn create_room(engine: &vm.Vm, input: RoomInit) @suspends {
    let key = RoomKey { host: input.host, key: input.key }
    if engine.try_call::<RoomInit, Unit>("init_room", input).is_err() || !refresh(engine) {
        engine.try_call::<RoomKey, Unit>("fail_room", key);
        return
    }
    if engine.try_call::<RoomKey, Unit>("open_room", key).is_err() {
        engine.try_call::<RoomKey, Unit>("fail_room", key);
    }
}
fn manage_rooms(engine: &vm.Vm, host: Host, requests: &mut outbox.Mailbox) @suspends -> Int32 {
    while true {
        let request = requests.receive()
        if request.is_none() { break }
        while true {
            let pending = match engine.try_call::<Host, Option<RoomInit>>("next_room", host) { Ok(value) => value, Err(_) => break }
            match pending { Some(input) => create_room(engine, input), None => break }
        }
    }
    0
}
fn serve(engine: &vm.Vm, host: Host, listener: TcpListener) @suspends -> Int32 {
    var listener = listener
    let admission = admission.create(host.config.max_clients, 0)
    let entrants = admission.handle()
    var next_id: UInt64 = 1
    scope {
        while true {
            let stream = match listener.accept() { Ok(stream) => stream, Err(_) => break }
            let permit = match entrants.try_acquire() { Ok(permit) => permit, Err(_) => continue }
            let id = next_id
            next_id += 1
            branch { connection(engine, host, id, stream, permit) }
        }
    }
    0
}
fn main() @suspends -> Int32 {
    let engine = vm.Vm.new()
    engine.module_file("chat_contract", "examples/chat_contract.jk")!
    require_contract(&engine)
    match engine.load_file(script_path()) { Ok(_) => {}, Err(error) => { chat_admin.report(error); return 1 } }
    let directory = domain.directory(1)
    let config = defaults()
    let rooms = domain.directory(config.max_rooms)
    let accounts = domain.directory(config.max_clients)
    var requests = outbox.create(config.max_rooms, 0)
    let host = Host { config: config, directory: directory.handle(), rooms: rooms.handle(), accounts: accounts.handle(), requests: requests.handle() }
    engine.call::<Host, Unit>("initialize", host)
    var chat = match TcpListener.bind(Address.ipv4(0x7f000001, 7777)) {
        Ok(listener) => listener, Err(_) => { println("Could not bind chat listener"); return 1 }
    }
    var admin = match TcpListener.bind(Address.ipv4(0x7f000001, 7778)) {
        Ok(listener) => listener, Err(_) => { println("Could not bind admin listener"); return 1 }
    }
    println("chat {chat.local_addr()!.port()}")
    println("admin {admin.local_addr()!.port()}")
    race {
        | serve(&engine, host, chat)
        | manage_rooms(&engine, host, &mut requests)
        | chat_admin.serve(&engine, script_path(), admin)
    }
}
