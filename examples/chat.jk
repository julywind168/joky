import joky/vm
import joky/domain
import joky/outbox
import joky/admission
import joky/tcp.{type Address, type TcpListener, type TcpStream, type BufferedTcp, type BufferedTcpReader, type TcpWriter}

// Keep this entry contract identical in the host and each published version.
enum Action { Connect((outbox.Handle, outbox.Handle)), Line(String), Disconnect, Notice(String) }
struct Call { directory: domain.DirectoryHandle, id: UInt64, action: Action }
struct Bootstrap { directory: domain.DirectoryHandle, ready: outbox.Handle }

struct Host { directory: domain.DirectoryHandle, gate: admission.Handle }
fn script_path() -> String { "examples/chat_logic.jk" }
fn report(error: vm.LoadError) {
    match error.kind {
        Io(error) => println(error.message), Utf8(_) => println("Script is not UTF-8"),
        Compile(error) => println(error.message), Incompatible(error) => println(error.message),
        Conflict(error) => println(error.message), Runtime(error) => println(error.message)
    }
}
fn call(engine: &vm.Vm, host: Host, id: UInt64, action: Action) @suspends -> UInt64 {
    let permit = host.gate.acquire()!
    let result = engine.call::<Call, UInt64>("dispatch", Call { directory: host.directory, id: id, action: action })
    permit.release()
    result
}
fn reload(engine: &vm.Vm, host: Host, id: UInt64) @suspends {
    // Existing commands finish before publication; queued commands use the new entry.
    let permit = host.gate.acquire()!
    let message = match engine.publish_file(script_path()) {
        Ok(_) => "reloaded\n",
        Err(error) => { report(error) "reload failed\n" }
    }
    engine.call::<Call, UInt64>("dispatch", Call { directory: host.directory, id: id, action: Action.Notice(message) });
    permit.release()
}
fn receive(engine: &vm.Vm, host: Host, id: UInt64, reader: BufferedTcpReader) @suspends {
    var reader = reader
    while true {
        let line = match reader.read_line(4096) { Ok(Some(line)) => line, _ => return }
        if line.equals("reload") { reload(engine, host, id) }
        else if call(engine, host, id, Action.Line(line)) == 0 { return }
    }
}
fn send(queue: &mut outbox.Mailbox, writer: TcpWriter) @suspends {
    var writer = writer
    while true {
        let bytes = match queue.receive() { Some(bytes) => bytes, None => return }
        if writer.write_all(bytes).is_err() { return }
    }
}
fn stop(queue: &mut outbox.Mailbox) @suspends { queue.receive(); }
fn session(engine: &vm.Vm, host: Host, id: UInt64, queue: outbox.Mailbox, control: outbox.Mailbox, stream: TcpStream) @suspends {
    var queue = queue
    var control = control
    let (reader, writer) = BufferedTcp.new(stream).split()
    // Retain both mailbox owners until membership removal has committed.
    race { | receive(engine, host, id, reader) | send(&mut queue, writer) | stop(&mut control) }
    call(engine, host, id, Action.Disconnect);
}
fn serve(engine: &vm.Vm, directory: domain.DirectoryHandle, ready: &mut outbox.Mailbox) @suspends -> Int32 {
    ready.receive()!
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 7777)) {
        Ok(listener) => listener, Err(_) => { println("Could not bind chat listener") return 1 }
    }
    println(listener.local_addr()!.port())
    let gate = admission.create(1, 4096)
    let host = Host { directory: directory, gate: gate.handle() }
    scope {
        while true {
            let stream = match listener.accept() { Ok(stream) => stream, Err(_) => break }
            let queue = outbox.create(64, 65536)
            let control = outbox.create(1, 0)
            let id = call(engine, host, 0, Action.Connect((queue.handle(), control.handle())))
            branch { session(engine, host, id, queue, control, stream) }
        }
    }
    0
}
fn bootstrap(engine: &vm.Vm, input: Bootstrap) @suspends -> Int32 {
    engine.call::<Bootstrap, Unit>("hold", input)
    0
}
fn main() @suspends -> Int32 {
    let engine = vm.Vm.new()
    match engine.load_file(script_path()) { Ok(_) => {}, Err(error) => { report(error) return 1 } }
    let directory = domain.directory(1)
    let ready = outbox.create(1, 0)
    let input = Bootstrap { directory: directory.handle(), ready: ready.handle() }
    var ready = ready
    race {
        | bootstrap(&engine, input)
        | serve(&engine, directory.handle(), &mut ready)
    }
}
