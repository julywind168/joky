import joky/vm
import joky/domain
import joky/outbox
import joky/option.{type Option}
import joky/tcp.{type Address, type TcpListener, type TcpStream, type BufferedTcp, type BufferedTcpReader, type TcpWriter}

// Keep these entry contracts identical in the host and each published version.
struct Host { directory: domain.DirectoryHandle, rooms: domain.DirectoryHandle, accounts: domain.DirectoryHandle, requests: outbox.Handle }
enum Action { Welcome, Line(String), Disconnect, Notice(String), Release }
struct Call { host: Host, id: UInt64, action: Action }
struct Bootstrap { host: Host, ready: outbox.Handle }
struct RoomInit { host: Host, key: UInt64, name: String, ready: outbox.Handle }
struct RoomKey { host: Host, key: UInt64 }
struct AccountInit { host: Host, id: UInt64, output: outbox.Handle, stop: outbox.Handle, ready: outbox.Handle }
fn script_path() -> String { "examples/chat_logic.jk" }
fn report(error: vm.LoadError) {
    match error.kind {
        Io(error) => println(error.message), Utf8(_) => println("Script is not UTF-8"),
        Compile(error) => println(error.message), Incompatible(error) => println(error.message),
        Conflict(error) => println(error.message), Runtime(error) => println(error.message)
    }
}
fn call(engine: &vm.Vm, host: Host, id: UInt64, action: Action) @suspends -> UInt64 {
    engine.call::<Call, UInt64>("dispatch", Call { host: host, id: id, action: action })
}
fn reload(engine: &vm.Vm, host: Host, id: UInt64) @suspends {
    // Publication neither acquires a business permit nor drains any output mailbox.
    let message = match engine.publish_file(script_path()) {
        Ok(_) => "reloaded\n",
        Err(error) => { report(error) "reload failed\n" }
    }
    call(engine, host, id, Action.Notice(message));
}
fn receive(engine: &vm.Vm, host: Host, id: UInt64, reader: BufferedTcpReader) @suspends {
    var reader = reader
    while true {
        let line = match reader.read_line(4096) { Ok(Some(line)) => line, _ => return }
        if line.equals("reload") { reload(engine, host, id) }
        else if call(engine, host, id, Action.Line(line)) == 0 { return }
    }
}
fn send(queue: &mut outbox.Mailbox, writer: TcpWriter) @suspends {
    var writer = writer
    while true {
        let bytes = match queue.receive() { Some(bytes) => bytes, None => return }
        if writer.write_all(bytes).is_err() { return }
    }
}
fn stop(queue: &mut outbox.Mailbox) @suspends { queue.receive(); }
fn session(engine: &vm.Vm, host: Host, id: UInt64, queue: outbox.Mailbox, control: outbox.Mailbox, stream: TcpStream) @suspends {
    var queue = queue
    var control = control
    let (reader, writer) = BufferedTcp.new(stream).split()
    // Retain both mailbox owners until membership removal has committed.
    race { | receive(engine, host, id, reader) | send(&mut queue, writer) | stop(&mut control) }
    call(engine, host, id, Action.Disconnect);
    call(engine, host, id, Action.Release);
}
fn account(engine: &vm.Vm, input: AccountInit) @suspends { engine.call::<AccountInit, Unit>("hold_account", input) }
fn connected(engine: &vm.Vm, host: Host, id: UInt64, ready: outbox.Mailbox, queue: outbox.Mailbox, control: outbox.Mailbox, stream: TcpStream) @suspends {
    var ready = ready
    ready.receive();
    refresh(engine)
    call(engine, host, id, Action.Welcome);
    session(engine, host, id, queue, control, stream)
}
fn connection(engine: &vm.Vm, host: Host, id: UInt64, stream: TcpStream) @suspends {
    let queue = outbox.create(64, 65536)
    let control = outbox.create(1, 0)
    let ready = outbox.create(1, 0)
    let input = AccountInit { host: host, id: id, output: queue.handle(), stop: control.handle(), ready: ready.handle() }
    parallel {
        | account(engine, input)
        | connected(engine, host, id, ready, queue, control, stream)
    }
}
// Creation may have started in an older module while publication was in flight.
// Bring newly created roots to the current module before exposing them to clients.
fn refresh(engine: &vm.Vm) { assert(vm.publish_domain_code(engine) >= 0, "Could not publish code for a newly created state") }
fn room_input(input: RoomInit, signal: outbox.Handle) -> RoomInit {
    let RoomInit { host, key, name, ready } = input
    RoomInit { host: host, key: key, name: name, ready: signal }
}
fn room_owner(engine: &vm.Vm, input: RoomInit) @suspends { engine.call::<RoomInit, Unit>("hold_room", input) }
fn room_ready(engine: &vm.Vm, input: RoomKey, ready: &mut outbox.Mailbox) @suspends {
    ready.receive();
    refresh(engine)
    engine.call::<RoomKey, Unit>("open_room", input)
}
fn room(engine: &vm.Vm, input: RoomInit) @suspends {
    var ready = outbox.create(1, 0)
    let key = RoomKey { host: input.host, key: input.key }
    let input = room_input(input, ready.handle())
    parallel { | room_owner(engine, input) | room_ready(engine, key, &mut ready) }
}
fn manage(engine: &vm.Vm, host: Host, requests: &mut outbox.Mailbox) @suspends -> Int32 {
    scope {
        while true {
            let request = requests.receive()
            if request.is_none() { break }
            while true {
                let pending = engine.call::<Host, Option<RoomInit>>("next_room", host)
                match pending { Some(input) => { branch { room(engine, input) } }, None => break }
            }
        }
    }
    0
}
fn serve(engine: &vm.Vm, host: Host, ready: &mut outbox.Mailbox) @suspends -> Int32 {
    ready.receive()!
    var listener = match TcpListener.bind(Address.ipv4(0x7f000001, 7777)) {
        Ok(listener) => listener, Err(_) => { println("Could not bind chat listener") return 1 }
    }
    println(listener.local_addr()!.port())
    var next_id: UInt64 = 1
    scope {
        while true {
            let stream = match listener.accept() { Ok(stream) => stream, Err(_) => break }
            let id = next_id
            next_id += 1
            branch { connection(engine, host, id, stream) }
        }
    }
    0
}
fn bootstrap(engine: &vm.Vm, input: Bootstrap) @suspends -> Int32 {
    engine.call::<Bootstrap, Unit>("hold", input)
    0
}
fn main() @suspends -> Int32 {
    let engine = vm.Vm.new()
    match engine.load_file(script_path()) { Ok(_) => {}, Err(error) => { report(error) return 1 } }
    let directory = domain.directory(1)
    let rooms = domain.directory(4096)
    let accounts = domain.directory(4096)
    var requests = outbox.create(4096, 0)
    let host = Host { directory: directory.handle(), rooms: rooms.handle(), accounts: accounts.handle(), requests: requests.handle() }
    var ready = outbox.create(1, 0)
    let input = Bootstrap { host: host, ready: ready.handle() }
    race {
        | bootstrap(&engine, input)
        | serve(&engine, host, &mut ready)
        | manage(&engine, host, &mut requests)
    }
}
