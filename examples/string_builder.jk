import joky/io.{println}
import joky/string.{type StringBuilder}

fn greeting(name: &String) -> String {
    var builder = StringBuilder.new()
    builder.push_str("Hello, ")
    builder.push_str(name)
    builder.push('!')
    builder.finish()
}

fn main() {
    let text = greeting("中🙂")
    println(int32(text.byte_length()))
}
