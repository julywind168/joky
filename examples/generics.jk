fn identity<T>(value: T) -> T { value }
fn first<T, U>(left: T, right: U) -> T { left }
fn swap<T, U>(pair: (T, U)) -> (U, T) {
    let (a, b) = pair;
    (b, a)
}
struct Reading { value: UInt64, valid: Bool }

fn main() {
    println(identity(42))
    println(identity::<Int64>(4294967295))
    let reading = identity(Reading { value: 0xffff_ffff_ffff_ffff, valid: true })
    println(reading.value)
    let (valid, value) = swap((first(7, reading), reading.valid))
    if valid { println(value) }
}
