extern fn print_int(value: Int32)
extern fn print_int64(value: Int64)

fn main() {
    let maybe = Some(42)
    if maybe.is_some() { print_int(maybe.unwrap_or(0)) }
    print_int(None::<Int32>.or(Some(7)).unwrap_or(0))
    print_int64(maybe.and::<Int64>(Some(4294967295)).unwrap_or(0))

    let result: Result<Int32, Bool> = Ok(42)
    print_int(result.ok().unwrap_or(0))
    let failed: Result<Int32, Bool> = Err(false)
    if failed.is_err() { print_int(failed.unwrap_or(9)) }
    let recovered = failed.or::<Unit>(Ok(7))
    print_int(recovered.unwrap_or(0))

    // Defaults and alternatives are eager, even if the receiver succeeds.
    var evaluated = 0
    let retained = maybe.unwrap_or({ evaluated = evaluated + 1 0 })
    print_int(evaluated)
}
