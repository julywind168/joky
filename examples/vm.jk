import joky/io.{println}

import joky/vm

fn host_add(x: Int32, y: Int32) -> Int32 { x + y }

fn main() -> Int32 {
    let engine: vm.Vm = vm.Vm.new()
    vm.register_int32_2(engine, "host_add", host_add)
    vm.load_source(engine, "extern fn host_add(x: Int32, y: Int32) -> Int32 fn add(x: Int32, y: Int32) -> Int32 {{ host_add(x, y) }}")
    println(vm.call_int32_2(engine, "add", 20, 22))

    vm.reload_source(engine, "extern fn host_add(x: Int32, y: Int32) -> Int32 fn add(x: Int32, y: Int32) -> Int32 {{ host_add(x, y) * 4 }}")
    println(vm.call_int32_2(engine, "add", 20, 5))
    vm.close(engine)
}
