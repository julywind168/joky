extern fn print_uint32(value: UInt32)
extern fn print_uint64(value: UInt64)
extern fn print_int(value: Int32)
fn main() {
    let flags: UInt32 = 0b1010_0000 | 0b0000_0011
    print_uint32(flags)
    print_uint32(flags & 0x0f)
    print_uint32(~flags & 0xff)
    let high: UInt64 = 1 << 63
    print_uint64(high)
    print_uint64(high >> 63)
    let signed: Int32 = -0x8000_0000
    print_int(signed >> 31)
}
