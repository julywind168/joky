extern fn print_uint32(value: UInt32)
extern fn print_uint64(value: UInt64)
struct Counter { value: UInt64 }
fn main() {
    let small: UInt32 = 4294967295
    let counter = Counter { value: 18446744073709551615 }
    print_uint32(small)
    print_uint64(counter.value)
    print_uint64(counter.value / 2)
    print_uint32(small + 1)
    print_uint64(counter.value + 1)
}
