import joky/http
import joky/json
import joky/shutdown
import joky/tcp

#derive(ToJson)
struct Health { ok: Bool }

fn health(request: http.Request) @suspends -> http.Response {
    let body = Health { ok: true }
    http.json(http.Status.Ok, &body)!
}
fn echo(request: http.Request) @suspends -> http.Response {
    if let Ok(value) = json.decode_bytes(&request.body) {
        return http.Response { headers: [], status: http.Status.Ok, content_type: http.ContentType.Json, body: json.encode(&value)!.into_bytes() }
    }
    http.text(http.Status.BadRequest, "invalid JSON")
}
pub fn routes() -> http.Router {
    var router = http.Router.new()
    router.get("/health", health)!
    router.post("/echo", echo)!
    router
}
fn main() @suspends -> Int32 {
    let stop = shutdown.create()
    // Keep the signal subscription until the server has finished draining.
    let signals = stop.subscribe_unix()!
    var listener = tcp.listen("127.0.0.1", 0)!
    println("listening {listener.local_addr()!.port()}")
    if http.serve_with(listener, &stop, http.Options.default(), routes()).is_ok() { 0 } else { 1 }
}
