import joky/http
import joky/json
import joky/shutdown
import joky/tcp

#derive(ToJson)
struct Health { ok: Bool }

pub fn handle(request: http.Request) @suspends -> http.Response {
    let path = request.path()
    let http.Request { context, method, target, headers, body } = request
    if (method == http.Method.Get || method == http.Method.Head) && path == "/health" {
        let health = Health { ok: true }
        return http.json(http.Status.Ok, &health)!
    }
    if method == http.Method.Post && path == "/echo" {
        if let Ok(value) = json.decode_bytes(&body) {
            return http.Response { headers: [], status: http.Status.Ok, content_type: http.ContentType.Json, body: json.encode(&value)!.into_bytes() }
        }
        return http.text(http.Status.BadRequest, "invalid JSON")
    }
    http.text(http.Status.NotFound, "not found")
}
fn main() @suspends -> Int32 {
    let stop = shutdown.create()
    // Keep the signal subscription until the server has finished draining.
    let signals = stop.subscribe_unix()!
    var listener = tcp.listen("127.0.0.1", 0)!
    println("listening {listener.local_addr()!.port()}")
    if http.serve(listener, &stop, http.Options.default(), handle).is_ok() { 0 } else { 1 }
}
