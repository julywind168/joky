import joky/io.{println}
import joky/map.{type Map}
import joky/array.{type Array}
import joky/element
import joky/eq.{type Eq}
import joky/hash.{type Hash}

// Core synchronous Map operations; keys are reference-free Copy values.
fn frequencies() -> Int32 {
    var counts = Map.new::<Int32, Int32>()
    for i in 0..42 {
        let key = i & 3
        let count = counts.get(key).unwrap_or(0)
        counts.insert(key, count + 1)
    }
    counts.get(0).unwrap_or(0) + counts.get(1).unwrap_or(0) +
        counts.get(2).unwrap_or(0) + counts.get(3).unwrap_or(0)
}
struct Coordinate { x: Int32, y: Int32 }
impl Eq for Coordinate { fn eq(self, other: Self) -> Bool { self.x == other.x && self.y == other.y } }
impl Hash for Coordinate { fn hash(self) -> UInt64 { Hash.hash(self.x) ^ (Hash.hash(self.y) >> 1) } }
fn custom_keys() -> Int32 {
    var scores = Map.new::<Coordinate, Int32>()
    scores.insert(Coordinate { x: 3, y: 7 }, 20)
    let old = scores.insert(Coordinate { x: 3, y: 7 }, 22)
    old.unwrap_or(0) + scores.remove(Coordinate { x: 3, y: 7 }).unwrap_or(0)
}
fn owning_values() -> Int32 {
    let row = [20, 22]
    var rows = Map.new::<Int32, Array<Int32>>()
    rows.insert(1, row)
    // Explicit early release demonstrates that the removed row owns its storage.
    let moved = match rows.remove(1) { Some(value) => value, None => return 0 }
    rows.release()
    moved.get(0).unwrap_or(0) + moved.get(1).unwrap_or(0)
}
fn borrowed_values() -> Int32 {
    var counts = Map.new::<Int32, Int32>()
    counts.insert(1, 20)
    let count = counts.borrow_mut_ref(1)
    *count += 22
    *count
}
fn shared_values() -> Int32 {
    var values = Map.new::<Int32, &Int32>()
    values.insert(1, &*alloc(42))
    let copy = element.read(values.borrow(1))
    values.release()
    *copy
}
fn main() {
    println(frequencies())
    println(custom_keys())
    println(owning_values())
    println(borrowed_values())
    println(shared_values())
}
