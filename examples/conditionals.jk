import joky/io.{println}

fn classify(value: Int32) -> Int32 {
    if value < 0 { -1 } else if value == 0 { 0 } else { 1 }
}

fn safe_divide(value: Int32, divisor: Int32) -> Int32 {
    if divisor != 0 && value / divisor > 0 {
        value / divisor
    } else { 0 }
}

fn main() {
    { let displayed: Int32 = classify(-5) println(&displayed) }
    { let displayed: Int32 = classify(0) println(&displayed) }
    { let displayed: Int32 = classify(5) println(&displayed) }
    { let displayed: Int32 = safe_divide(12, 0) println(&displayed) }
    { let displayed: Int32 = safe_divide(12, 3) println(&displayed) }
}
