import joky/io.{println}

import joky/array.{type Array}
import joky/drop.{type Drop}
struct Item { id: Int32 ,values: Array<Int32> }
impl Drop for Item {
    fn drop(&mut self) { { let displayed: Int32 = self.id println(&displayed) } }
}
impl Item {
    fn stored(&self) -> Int32 { self.values.get(0).unwrap_or(0) }
}
fn item(id: Int32) -> Item {
    var values = Array.new::<Int32>()
    values.push(id)
    Item { id: id ,values: values }
}
fn main() {
    var items = Array.new::<Item>()
    items.push(item(20))
    items.push(item(22))
    // Shared element borrows inspect both resources while they stay in the array.
    let answer = items.borrow_ref(0).stored() + items.borrow_ref(1).stored()
    let last = items.take_last()
    let first = items.take_last()
    println(&answer)
    // first and last run Drop in reverse declaration order: 20, then 22.
}
