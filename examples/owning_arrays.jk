import joky/array
struct Item { id: Int32, values: Array<Int32> }

impl Item {
    fn stored(&self) -> Int32 { self.values[0] }
}
fn item(id: Int32) -> Item {
    Item { id, values: [id] }
}
fn main() {
    var items = [item(20), item(22)]
    // Shared element borrows inspect both resources while they stay in the array.
    let answer = items[0].stored() + items[1].stored()
    let last = items.take_last()
    let first = items.take_last()
    println(answer)
    // Removed elements keep their own storage until their scope ends.
}
