import joky/tcp.{type Address, type TcpListener, type TcpStream, type BufferedTcp}

// A finite loopback echo service. Both sides use the same bounded message format.
fn serve(listener: &mut TcpListener) @suspends {
    var connection = BufferedTcp.new(listener.accept()!)
    // EOF ends the session; unexpected I/O errors report their original cause.
    while let Some(message) = connection.read_message(4096)! {
        connection.write_message(message, 4096)!
        }
    connection.close()!
    }

fn exchange(connection: &mut BufferedTcp, text: String) @suspends {
    connection.write_message(text.into_bytes(), 4096)!
    let message = connection.read_message(4096)!.expect("Expected an echo reply")
    println(String.from_utf8(message)!)
}

fn client(address: Address) @suspends {
    var connection = BufferedTcp.new(TcpStream.connect(address)!)
    exchange(&mut connection, "hello")
    exchange(&mut connection, "你好")
    exchange(&mut connection, "")
    connection.close()!
}

fn main() @suspends -> Int32 {
    var listener = tcp.listen("127.0.0.1", 0)!
    let address = listener.local_addr()!
    join { serve(&mut listener), client(address) }
    listener.close()!
    0
}
