import joky/hex
import joky/base64
import joky/random
import joky/result.{ Ok, Err }
import joky/io.{ println }

fn main() {
    let text = "hello"
    println(hex.encode(text.bytes()))
    println(base64.encode(text.bytes()))
    let decoded = base64.decode("aGVsbG8=").unwrap()
    println(hex.encode(decoded.slice(0, decoded.len())))

    match random.secure_bytes(32) {
        Ok(bytes) => println(base64.url_safe_no_pad().encode(bytes.slice(0, bytes.len())))
        Err(_) => println("Secure randomness unavailable")
    }
}
