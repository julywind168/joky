import joky/hex
import joky/base64
import joky/random

fn main() {
    let text = "hello"
    println(hex.encode(text.bytes()))
    println(base64.encode(text.bytes()))
    let decoded = base64.decode("aGVsbG8=").unwrap()
    println(hex.encode(&decoded[..]))

    match random.secure_bytes(32) {
        Ok(bytes) => println(base64.url_safe_no_pad().encode(&bytes[..]))
        Err(_) => println("Secure randomness unavailable")
    }
}
