import joky/fs
import joky/io.{println}
// Creates joky-file-example.txt in the process working directory.
fn main() @suspends -> Int32 {
    var options = fs.OpenOptions.new()
    options.write = true
    options.create = true
    options.truncate = true
    var file = match fs.open("joky-file-example.txt", options) {
        Ok(file) => file
        Err(error) => { println(&error.message) return 1 }
    }
    let text = "Hello, Joky 文件！\n"
    let size = text.byte_length()
    match file.write(text.into_bytes()) {
        Ok(count) => { if count != size { return 2 } }
        Err(error) => { println(&error.message) return 1 }
    }
    match file.seek(fs.SeekFrom.Start(0)) {
        Ok(_) => {}
        Err(error) => { println(&error.message) return 1 }
    }
    let bytes = match file.read(1024) {
        Ok(bytes) => bytes
        Err(error) => { println(&error.message) return 1 }
    }
    let text = match String.from_utf8(bytes) {
        Ok(text) => text
        Err(_) => { return 3 }
    }
    println(&text)
    match file.close() {
        Ok(_) => 0
        Err(error) => { println(&error.message) 1 }
    }
}
