import joky/process
import joky/fs

// Optional first argument selects a file relative to the caller directory.
fn main() @suspends -> Int32 {
    var arguments = process.args()!
    if arguments.len() > 1 { eprintln("usage: files [path]"); return 2 }
    let path = process.resolve_path(arguments.pop().unwrap_or("joky-file-example.txt"))!
    let options = fs.OpenOptions {
        write: true
        create: true
        truncate: true
        ..fs.OpenOptions.default()
    }
    var file = match fs.open(path, options) {
        Ok(file) => file
        Err(error) => { eprintln(error.message); return 1 }
    }
    let text = "Hello, Joky 文件！\n"
    match file.write_text(text) {
        Ok(_) => {}
        Err(failure) => { eprintln(failure.error.message); return 1 }
    }
    match file.seek(fs.SeekFrom.Start(0)) {
        Ok(_) => {}
        Err(error) => { eprintln(error.message); return 1 }
    }
    let text = match file.read_text() {
        Ok(text) => text
        Err(fs.ReadTextError.Io(error)) => { eprintln(error.message); return 1 }
        Err(fs.ReadTextError.Utf8(_)) => { return 3 }
    }
    println(text)
    match file.close() {
        Ok(_) => 0
        Err(error) => { eprintln(error.message); 1 }
    }
}
