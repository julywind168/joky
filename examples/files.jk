import joky/fs
import joky/io.{println}
// Creates joky-file-example.txt in the process working directory.
fn main() @suspends -> Int32 {
    var options = fs.OpenOptions.new()
    options.write = true
    options.create = true
    options.truncate = true
    var file = match fs.open("joky-file-example.txt", options) {
        Ok(file) => file
        Err(error) => { println(&error.message) return 1 }
    }
    let text = "Hello, Joky 文件！\n"
    match file.write_text(text) {
        Ok(_) => {}
        Err(failure) => { println(&failure.error.message) return 1 }
    }
    match file.seek(fs.SeekFrom.Start(0)) {
        Ok(_) => {}
        Err(error) => { println(&error.message) return 1 }
    }
    let text = match file.read_text(1024) {
        Ok(text) => text
        Err(fs.ReadTextError.Io(error)) => { println(&error.message) return 1 }
        Err(fs.ReadTextError.Utf8(_)) => { return 3 }
    }
    println(&text)
    match file.close() {
        Ok(_) => 0
        Err(error) => { println(&error.message) 1 }
    }
}
