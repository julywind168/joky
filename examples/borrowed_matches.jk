import joky/io.{println}

import joky/array.{type Array}
import joky/drop.{type Drop}
struct Resource { id: Int32, values: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { { let displayed: Int32 = self.id println(&displayed) } } }
fn resource(id: Int32) -> Resource {
    var values = Array.new::<Int32>()
    values.push(id)
    Resource { id: id, values: values }
}
fn main() {
    let zipped = Some((resource(20), resource(22)))
    // Owning bindings are shared references; the match leaves zipped intact.
    match &zipped {
        | Some((left, right)) => { let displayed: Int32 = left.id + right.id println(&displayed) }
        | None => { let displayed: Int32 = 0 println(&displayed) }
    }
    // The same enum can still be consumed after the shared references expire.
    match zipped {
        | Some((left, right)) => { let displayed: Int32 = left.values.get(0).unwrap_or(0) + right.id println(&displayed) }
        | None => { let displayed: Int32 = 0 println(&displayed) }
    }
}
