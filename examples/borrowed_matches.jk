import joky/array.{type Array}
import joky/drop.{type Drop}
extern fn print_int(value: Int32)

struct Resource { id: Int32 values: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { print_int(self.id) } }
fn resource(id: Int32) -> Resource {
    var values = Array.new::<Int32>()
    values.push(id)
    Resource { id: id values: values }
}
fn main() {
    let zipped = Some((resource(20), resource(22)))
    // Owning bindings are shared references; the match leaves zipped intact.
    match &zipped {
        | Some((left, right)) => print_int(left.id + right.id)
        | None => print_int(0)
    }
    // The same enum can still be consumed after the shared references expire.
    match zipped {
        | Some((left, right)) => print_int(left.values.get(0).unwrap_or(0) + right.id)
        | None => print_int(0)
    }
}
