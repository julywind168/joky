import joky/array.{type Array}
import joky/drop.{type Drop}
extern fn print_int(value: Int32)

struct Resource { id: Int32 values: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { print_int(self.id) } }
enum Message { Empty Ready(Resource) Count(Int32) }
fn resource(id: Int32) -> Resource {
    var values = Array.new::<Int32>()
    values.push(id)
    Resource { id: id values: values }
}
fn main() {
    var queue = Array.new::<Message>()
    queue.push(Message.Empty)
    queue.push(Message.Ready(resource(42)))
    let optional = queue.pop()
    match optional {
        | None => print_int(0)
        | Some(message) => match message {
            | Empty => print_int(0)
            | Count(value) => print_int(value)
            | Ready(value) => print_int(value.values.get(0).unwrap_or(0))
        }
    }
    // The bound resource is dropped once when its match arm ends.
}
