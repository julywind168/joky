import joky/drop.{type Drop}

struct Resource { id: Int32, values: Array<Int32> }
impl Drop for Resource { fn drop(&mut self) { println(self.id) } }
enum Message { Empty, Ready(Resource), Count(Int32) }
fn resource(id: Int32) -> Resource {
    Resource { id, values: [id] }
}
fn main() {
    var queue = [Message.Empty, Message.Ready(resource(42))]
    let optional = queue.pop()
    match optional {
        None => println(0)
        Some(message) => match message {
            Empty => println(0)
            Count(value) => println(value)
            Ready(value) => println(value.values[0])
        }
    }
    // The bound resource is dropped once when its match arm ends.
}
