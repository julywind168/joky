import joky/array as array.{type Array}
extern fn print_int(value: Int32)

fn answer() -> Int32 {
    var values: Array<Int32> = Array.new::<Int32>()
    values.push(20)
    let view = &values
    let first = view.get(0).unwrap_or(0)
    // The last use of view ends its borrow, so another push is allowed.
    array.push(&mut values, 22)
    let moved = values
    let result = first + moved.get(1).unwrap_or(0)
    moved.release()
    result
}

fn main() -> Int32 {
    print_int(answer()) // 42
    0
}
