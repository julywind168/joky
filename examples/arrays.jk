import joky/io.{println}
import joky/array.{type Array}

fn answer() -> Int32 {
    var values: Array<Int32> = [20]
    let view = &values
    let first = view.get(0).unwrap_or(0)
    // The last use of view ends its borrow, so another push is allowed.
    values.push(22)
    let moved = values
    // The moved array is cleaned up automatically on return.
    first + moved.get(1).unwrap_or(0)
}

fn main() -> Int32 {
    println(answer()) // 42
    0
}
