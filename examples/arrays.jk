fn answer() -> Int32 {
    var values = [20]
    let view = &values
    let first = view[0]
    // The last use of view ends its borrow, so another push is allowed.
    values.push(22)
    let moved = values
    // The moved array is cleaned up automatically on return.
    first + moved[1]
}

fn main() {
    println(answer()) // 42
}
