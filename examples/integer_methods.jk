import joky/io.{println}
import joky/integer

fn main() {
    let n = 42
    match n.to_u64() {
        Some(value) => println(value)
        None => println(-1)
    }
    let negative = -1
    println(match negative.to_u64() { Some(value) => 0, None => 1 })
    println(uint64(negative))
    println(Int32.MAX)
    let wide: Int64 = 2147483648
    println(match wide.to_i32() { Some(value) => value, None => -1 })
}
