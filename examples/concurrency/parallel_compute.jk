// Structured parallel computation: the arms of `parallel` run concurrently on
// worker threads, and once all arms finish the result tuple is returned in
// source order
//
// Run: joky run examples/concurrency/parallel_compute.jk

fn square(value: Int32) -> Int32 {
    value * value
}

fn main() {
    let results = parallel {
        | square(2)
        | square(3)
        | square(4)
        | square(5)
    }

    let total = results.0 + results.1 + results.2 + results.3
    println(total)
    // 2² + 3² + 4² + 5² = 54
}
