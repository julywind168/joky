import joky/arena.{type Arena}
import joky/task

fn request() @suspends -> Int32 {
    let arena = Arena.new()
    let value = arena.alloc(40)
    task.sleep(1ms)
    *value += 2
    *value
}

fn main() @suspends {
    for _ in 0 .. 3 { assert_eq(request(), 42) }
    println("requests completed")
}
