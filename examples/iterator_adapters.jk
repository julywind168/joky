import joky/iter
import joky/array.{type Array}
import joky/io.{println}

fn nonempty(value: &String) @noescape -> Bool { value != "" }

fn main() {
    let offset = 10
    // Ordinary adapters accept owning closures, including captured values.
    let mapped = iter.map(0..10, move |value| { value + offset })
    let even = iter.filter(mapped, move |value| { *value % 2 == 0 })
    for index, value in iter.take(even, 3) {
        println("{index}: {value}")
    }

    for (name, score) in iter.zip(["Alice", "Bob"], [80, 90]) {
        println("{name}: {score}")
    }

    let names = ["Alice", "", "Bob", "Carol"]
    // Shared callbacks may borrow read-only locals; named functions declare @noescape.
    let selected = iter.shared(&names).filter(nonempty).take(2)
    for name in selected { println(name) }
    println(names.len()) // The source still owns all four strings.
}
