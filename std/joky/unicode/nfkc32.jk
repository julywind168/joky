// Unicode 3.2 NFKC. Data is pinned, independent of the host Unicode version.
import joky/unicode/utf8
import joky/unicode/tables32
import joky/bytes
import joky/mut_list

struct Limits {
    let max_input_bytes: UInt64 = 16384
    let max_output_bytes: UInt64 = 65536
    let max_scalars: UInt64 = 65536
    let max_reorderings: UInt64 = 1048576
}

// Internal big-endian reader; record boundaries are generator-checked.
pub fn read(data: tables32.Table, offset: UInt64, width: UInt64) -> UInt32 {
    var value = 0u32
    var index = 0u64
    while index < width {
        let byte = data.data.get(data.start + offset + index)!
        value = (value << 8) | (byte as UInt32)
        index += 1
    }
    value
}

fn find(data: tables32.Table, stride: UInt64, code: UInt32) -> Option(UInt64) {
    var low = 0u64
    var high = data.length / stride
    while low < high {
        let mid = low + (high - low) / 2
        let value = read(data, mid * stride, 3)
        if value < code { low = mid + 1 } else { high = mid }
    }
    if (low < data.length / stride) && (read(data, low * stride, 3) == code) { Some(low * stride) } else { None }
}

pub fn in_ranges(data: tables32.Table, code: UInt32) -> Bool {
    var low = 0u64
    var high = data.length / 6
    while low < high {
        let mid = low + (high - low) / 2
        if read(data, mid * 6 + 3, 3) < code { low = mid + 1 } else { high = mid }
    }
    (low < data.length / 6) && (read(data, low * 6, 3) <= code)
}

fn combining(data: tables32.Table, code: UInt32) -> UInt32 {
    match find(data, 4, code) {
        Some(offset) => read(data, offset + 3, 1)
        None => 0u32
    }
}

fn compose(data: tables32.Table, first: UInt32, second: UInt32) -> Option(UInt32) {
    // Algorithmic Hangul L+V and LV+T composition, including ccc=0 pairs.
    if (first >= 0x1100u32) && (first < 0x1113u32) && (second >= 0x1161u32) && (second < 0x1176u32) {
        Some(0xac00 + ((first - 0x1100) * 21 + second - 0x1161) * 28)
    } else if (first >= 0xac00u32) && (first < 0xd7a4u32) && ((first - 0xac00) % 28 == 0u32) && (second > 0x11a7u32) && (second < 0x11c3u32) {
        Some(first + second - 0x11a7)
    } else {
        let key = ((first as UInt64) << 21) | (second as UInt64)
        var low = 0u64
        var high = data.length / 9
        while low < high {
            let mid = low + (high - low) / 2
            let a = read(data, mid * 9, 3)
            let b = read(data, mid * 9 + 3, 3)
            let candidate = ((a as UInt64) << 21) | (b as UInt64)
            if candidate < key { low = mid + 1 } else { high = mid }
        }
        if (low < data.length / 9) && (read(data, low * 9, 3) == first) && (read(data, low * 9 + 3, 3) == second) {
            Some(read(data, low * 9 + 6, 3))
        } else { None }
    }
}

class Decomposed {
    let points: MutList(UInt32)
    let classes: MutList(UInt32)
    let limits: Limits
    let combining_data: tables32.Table
    let decomposition_data: tables32.Table
    let scalar_data: tables32.Table
    let composition_data: tables32.Table
    var reorderings: UInt64 = 0

    fn append(&self, code: UInt32) -> Result(Unit, utf8.Error) {
        if self.points.length() == self.limits.max_scalars { Err(utf8.Error.LimitExceeded)? }
        let ccc = combining(self.combining_data, code)
        var index = self.points.length()
        self.points.push(code); self.classes.push(ccc)
        // Stable canonical ordering. Bound swaps to cap adversarial quadratic work.
        while (ccc != 0u32) && (index > 0u64) {
            let previous = self.classes.get(index - 1)!
            if previous <= ccc { break }
            if self.reorderings == self.limits.max_reorderings { Err(utf8.Error.LimitExceeded)? }
            self.reorderings += 1
            let previous_point = self.points.get(index - 1)!
            self.points.set(index, previous_point)
            self.classes.set(index, previous)
            index -= 1
        }
        self.points.set(index, code); self.classes.set(index, ccc)
        Ok(())
    }

    fn decompose(&self, code: UInt32) -> Result(Unit, utf8.Error) {
        if (code > 0x10ffffu32) || ((code >= 0xd800u32) && (code <= 0xdfffu32)) { Err(utf8.Error.InvalidScalar)? }
        if (code >= 0xac00u32) && (code < 0xd7a4u32) {
            let syllable = code - 0xac00
            self.append(0x1100 + syllable / 588)?
            self.append(0x1161 + (syllable % 588) / 28)?
            if syllable % 28 != 0u32 { self.append(0x11a7 + syllable % 28)? }
        } else {
            match find(self.decomposition_data, 6, code) {
                None => { self.append(code)? }
                Some(offset) => {
                    let start = read(self.decomposition_data, offset + 3, 2) as UInt64
                    let count = read(self.decomposition_data, offset + 5, 1) as UInt64
                    var index = 0u64
                    while index < count {
                        let decomposed = read(self.scalar_data, (start + index) * 3, 3)
                        self.append(decomposed)?
                        index += 1
                    }
                }
            }
        }
        Ok(())
    }

    fn finish(self) -> MutList(UInt32) {
        let result = MutList(UInt32)()
        var starter_index = 0u64
        var starter = 0u32
        var has_starter = false
        var last_class = 0u32
        var index = 0u64
        while index < self.points.length() {
            let code = self.points.get(index)!
            let ccc = self.classes.get(index)!
            var combined = false
            if has_starter && ((last_class == 0u32) || (last_class < ccc)) {
                match compose(self.composition_data, starter, code) {
                    Some(value) => { starter = value; result.set(starter_index, value); combined = true }
                    None => {}
                }
            }
            if !combined {
                if ccc == 0u32 { starter_index = result.length(); starter = code; has_starter = true }
                result.push(code)
                last_class = ccc
            }
            index += 1
        }
        result
    }
}

// Low-level scalar entry point used by string preparation profiles.
pub fn normalize_scalars(input: &MutList(UInt32), limits: Limits) -> Result(MutList(UInt32), utf8.Error) {
    normalize_scalars_with_data(input, limits, tables32.data())
}

// Internal profile entry point sharing the same binary allocation.
pub fn normalize_scalars_with_data(input: &MutList(UInt32), limits: Limits, data: Bytes) -> Result(MutList(UInt32), utf8.Error) {
    if input.length() > limits.max_scalars { Err(utf8.Error.LimitExceeded)? }
    let state = Decomposed(points: MutList(UInt32)(), classes: MutList(UInt32)(), limits: limits, combining_data: tables32.combining(data), decomposition_data: tables32.decompositions(data), scalar_data: tables32.decomposed_scalars(data), composition_data: tables32.compositions(data))
    var index = 0u64
    while index < input.length() { state.decompose(input.get(index)!)?; index += 1 }
    Ok(state.finish())
}

pub fn normalize(input: Bytes, limits: Limits) -> Result(Bytes, utf8.Error) {
    if input.length() > limits.max_input_bytes { Err(utf8.Error.LimitExceeded)? }
    let decoded = utf8.decode(input, limits.max_scalars)?
    let normalized = normalize_scalars(decoded, limits)?
    utf8.encode(normalized, limits.max_output_bytes)
}
