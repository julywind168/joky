// Process environment and invocation context.

eff env {
    @suspends
    fn get(name: String) -> Result(Option(String), String)

    @suspends
    fn vars() -> Result(Map(String, String), String)

    @suspends
    fn args() -> Result(List(String), String)

    @suspends
    fn current_dir() -> Result(String, String)

    @suspends
    fn temp_dir() -> Result(String, String)
}
