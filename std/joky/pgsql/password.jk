// PostgreSQL SCRAM password bytes. Resource limits never trigger fallback.
import joky/crypto/saslprep
import joky/unicode/nfkc32
import joky/bytes

enum Error { EmbeddedNul, LimitExceeded }

pub fn prepare(input: Bytes, limits: nfkc32.Limits) -> Result(Bytes, Error) {
    let PrepError: type = saslprep.Error
    if input.length() > limits.max_input_bytes { Err(Error.LimitExceeded)? }
    // C-string password interfaces cannot represent NUL. Never truncate it.
    for byte in input.iter() { if byte == 0u8 { Err(Error.EmbeddedNul)? } }
    match saslprep.prepare_postgres(input, limits) {
        Ok(value) => Ok(value)
        Err(PrepError.LimitExceeded) => Err(Error.LimitExceeded)
        Err(_) => {
            if input.length() > limits.max_output_bytes { Err(Error.LimitExceeded) }
            else { Ok(input) }
        }
    }
}
