import joky/fs
import joky/check.{assert}
import godot/task
struct State { completed: Int32, ticks: Int32 }
fn create() -> State { State { completed: 0, ticks: 0 } }
fn completed(state: &State) -> Int32 { state.completed }
fn ticks(state: &State) -> Int32 { state.ticks }
fn record(state: &mut State) { state.completed = state.completed + 1 }
fn tick(state: &mut State) { state.ticks = state.ticks + 1 }
fn task_files(count: Int32) @suspends {
    let message = "Godot file operation"
    let method = "record"
    var index: Int32 = 0
    while index < count {
        var input = match fs.open("res://files_payload.txt", fs.OpenOptions.new()) { Ok(f) => f, Err(_) => { assert(false, &message) return } }
        let text = match input.read_text(128) { Ok(t) => t, Err(_) => { assert(false, &message) return } }
        assert(text.byte_length() == 15, &message)
        match input.close() { Ok(_) => {}, Err(_) => assert(false, &message) }
        var options = fs.OpenOptions.new()
        options.write = true
        options.create = true
        options.truncate = true
        var output = match fs.open("user://joky_fs.bin", options) { Ok(f) => f, Err(_) => { assert(false, &message) return } }
        match output.write_text(text) { Ok(_) => {}, Err(_) => assert(false, &message) }
        match output.seek(fs.SeekFrom.Start(0)) { Ok(n) => assert(n == 0, &message), Err(_) => assert(false, &message) }
        let saved = match output.read_all(128) { Ok(b) => b, Err(_) => { assert(false, &message) return } }
        assert(saved.len() == 15, &message)
        match output.sync_all() { Err(e) => match e.kind { fs.ErrorKind.Unsupported => {}, _ => assert(false, &message) }, Ok(_) => assert(false, &message) }
        match output.close() { Ok(_) => {}, Err(_) => assert(false, &message) }
        task.call(&method)
        task.next_frame()
        index = index + 1
    }
}
fn task_frames(count: Int32) @suspends {
    let method = "tick"
    var index: Int32 = 0
    while index < count { task.next_frame() task.call(&method) index = index + 1 }
}
