struct State { count: Int32 }

fn create() -> State { State { count: 0 } }

fn _ready(state: &mut State) {
	state.count = state.count + 1
}

fn count(state: &State) -> Int32 { state.count }

fn bump(state: &mut State, amount: Int32) -> Int32 {
	state.count = state.count + amount
	state.count
}

fn echo_float(state: &State, value: Float64) -> Float64 { value }
fn echo_rune(state: &State, value: Rune) -> Rune { value }
fn echo_byte(state: &State, value: UInt8) -> UInt8 { value }
fn echo_small(state: &State, value: Int8) -> Int8 { value }
fn echo_short(state: &State, value: Int16) -> Int16 { value }
fn echo_long(state: &State, value: Int64) -> Int64 { value }
fn echo_ushort(state: &State, value: UInt16) -> UInt16 { value }
fn echo_uint(state: &State, value: UInt32) -> UInt32 { value }
fn echo_ulong(state: &State, value: UInt64) -> UInt64 { value }
fn echo_single(state: &State, value: Float32) -> Float32 { value }
fn echo_bool(state: &State, value: Bool) -> Bool { value }
fn echo_unit(state: &State, value: Unit) { value }
