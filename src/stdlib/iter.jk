import joky/internal/buffer as storage
import joky/option.{type Option, Some, None}

pub trait Iterator {
    type Item
    fn next(&mut self) @noescape -> Option<Self.Item>
}

// This entry fixes protocol selection even in the presence of inherent next methods.
pub fn next<I: Iterator>(iterator: &mut I) @noescape -> Option<I.Item> {
    Iterator.next(iterator)
}

pub struct Range { current: Int32, end: Int32 }

// Ascending, half-open range. Reversed bounds produce an empty iterator.
pub fn range(start: Int32, end: Int32) -> Range {
    Range { current: start, end: end }
}

impl Iterator for Range {
    type Item = Int32
    fn next(&mut self) -> Option<Int32> {
        if self.current >= self.end { return None }
        let value = self.current
        self.current += 1
        Some(value)
    }
}

// Borrowed cursors use separate advance/current operations, so exclusive
// references never enter Option or another aggregate.
pub type Iter<T> = storage.Iter<T>
pub fn advance<T>(iterator: &Iter<T>) -> Bool { storage.iter_advance(iterator) }
pub fn current<T>(iterator: &Iter<T>) -> &T { storage.iter_current(iterator) }
pub fn current_mut<T>(iterator: &mut Iter<T>) -> &mut T { storage.iter_current_mut(iterator) }

pub type Entries<K, V> = storage.PairIter<(K, V)>
pub type Entry<K, V> = storage.Entry<(K, V)>
pub fn entries_advance<K, V>(cursor: &Entries<K, V>) -> Bool { storage.pair_advance(cursor) }
pub fn entries_current<K, V>(cursor: &Entries<K, V>) -> &Entry<K, V> { storage.pair_current(cursor) }
pub fn entries_current_mut<K, V>(cursor: &mut Entries<K, V>) -> &mut Entry<K, V> { storage.pair_current_mut(cursor) }
