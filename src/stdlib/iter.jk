import joky/internal/buffer
import joky/option.{type Option, Some, None}

pub trait Iterator {
    type Item
    fn next(&mut self) @noescape -> Option<Self.Item>
}

pub trait IntoIterator {
    type IntoIter: Iterator
    fn into_iter(self) -> Self.IntoIter
}

impl<I: Iterator> IntoIterator for I {
    type IntoIter = I
    fn into_iter(self) -> I { self }
}

pub fn into_iter<I: IntoIterator>(value: I) -> I.IntoIter {
    IntoIterator.into_iter(value)
}

// This entry fixes protocol selection even in the presence of inherent next methods.
pub fn next<I: Iterator>(iterator: &mut I) @noescape -> Option<I.Item> {
    Iterator.next(iterator)
}

// A strict order and its immediate successor; None marks the greatest value.
// Implementations must advance monotonically without wrapping.
pub trait Step {
    fn less(self, other: Self) -> Bool
    fn successor(self) -> Option<Self>
}

impl Step for Int8 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 127 { None } else { Some(self + 1) } }
}
impl Step for Int16 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 32767 { None } else { Some(self + 1) } }
}
impl Step for Int32 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 2147483647 { None } else { Some(self + 1) } }
}
impl Step for Int64 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 9223372036854775807 { None } else { Some(self + 1) } }
}
impl Step for UInt8 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 255 { None } else { Some(self + 1) } }
}
impl Step for UInt16 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 65535 { None } else { Some(self + 1) } }
}
impl Step for UInt32 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 4294967295 { None } else { Some(self + 1) } }
}
impl Step for UInt64 {
    fn less(self, other: Self) -> Bool { self < other }
    fn successor(self) -> Option<Self> { if self == 18446744073709551615 { None } else { Some(self + 1) } }
}

pub struct Range<T: Copy> { current: T, end: T, inclusive: Bool, done: Bool }

// Ascending, bounded ranges. Reversed bounds produce an empty iterator.
pub fn range<T: Copy + Step>(start: T, end: T) -> Range<T> {
    Range { current: start, end: end, inclusive: false, done: false }
}
pub fn range_inclusive<T: Copy + Step>(start: T, end: T) -> Range<T> {
    Range { current: start, end: end, inclusive: true, done: false }
}

impl<T: Copy + Step> Iterator for Range<T> {
    type Item = T
    fn next(&mut self) -> Option<T> {
        if self.done { return None }
        if Step.less(self.end, self.current) || (!self.inclusive && !Step.less(self.current, self.end)) {
            self.done = true
            return None
        }
        let value = self.current
        if !Step.less(self.current, self.end) {
            self.done = true
        } else {
            match Step.successor(self.current) {
                Some(next) => { self.current = next },
                None => { self.done = true }
            }
        }
        Some(value)
    }
}

// Borrowed cursors use separate advance/current operations, so exclusive
// references never enter Option or another aggregate.
pub type Iter<T> = buffer.Iter<T>
pub fn slice_iter<T>(values: &buffer.Slice<T>) -> &Iter<T> { buffer.slice_iter(values) }
pub fn slice_iter_mut<T>(values: &mut buffer.Slice<T>) -> &mut Iter<T> { buffer.slice_iter_mut(values) }
pub fn advance<T>(iterator: &Iter<T>) -> Bool { buffer.iter_advance(iterator) }
pub fn current<T>(iterator: &Iter<T>) -> &T { buffer.iter_current(iterator) }
pub fn current_mut<T>(iterator: &mut Iter<T>) -> &mut T { buffer.iter_current_mut(iterator) }

pub type Entries<K, V> = buffer.PairIter<(K, V)>
pub type Entry<K, V> = buffer.Entry<(K, V)>
pub fn entries_advance<K, V>(cursor: &Entries<K, V>) -> Bool { buffer.pair_advance(cursor) }
pub fn entries_current<K, V>(cursor: &Entries<K, V>) -> &Entry<K, V> { buffer.pair_current(cursor) }
pub fn entries_current_mut<K, V>(cursor: &mut Entries<K, V>) -> &mut Entry<K, V> { buffer.pair_current_mut(cursor) }
