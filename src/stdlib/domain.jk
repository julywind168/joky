import joky/string.{type StringBuilder}
import joky/show.{type Show}
import joky/internal/buffer.{type Buffer}
import joky/option.{type Option, Some, None}
import joky/outbox.{type Batch}
import joky/result.{type Result, Ok, Err}
import joky/check
import joky/time.{type Duration}

// Trusted call-site intrinsics. The runtime resolves state only after admission.
extern fn __domain_read_scalar(method: String) @suspends -> (Int32, UInt64)
extern fn __domain_query_scalar(method: String, input: UInt64) @suspends -> (Int32, UInt64)
extern fn __domain_write_scalar(method: String, input: UInt64) @suspends -> (Int32, UInt64)

struct ValuePacket { storage: Buffer<UInt64> }
#intrinsic("domain.value_pack")
fn pack_value<A>(value:A) -> ValuePacket
#intrinsic("domain.value_unpack")
fn unpack_value<R>(packet:&ValuePacket) -> R
extern fn __domain_values(module:domain.Module,first:domain.Handle,second:domain.Handle,count:UInt64,name:String,packet:&mut Buffer<UInt64>) @suspends -> Int32
#intrinsic("domain.finish_value")
fn finish_value<A,R>(module:domain.Module,first:domain.Handle,second:domain.Handle,count:UInt64,name:String,input:A) @suspends -> Result<R,DomainAccessError> {
    var packet=pack_value(input)
    let status=__domain_values(module,first,second,count,name,&mut packet.storage)
    if status != 0 { return Err(access_error(status)) }
    Ok(unpack_value::<R>(&packet))
}

extern fn __domain_current_values(name:String,packet:&mut Buffer<UInt64>) @suspends -> Int32
#intrinsic("domain.finish_current_value")
fn finish_current_value<A,R>(name:String,input:A) @suspends -> Result<R,DomainAccessError> {
    var packet=pack_value(input)
    let status=__domain_current_values(name,&mut packet.storage)
    if status != 0 { return Err(access_error(status)) }
    Ok(unpack_value::<R>(&packet))
}

// In-place access rejects before entry; candidate operations may also reject
// resource exhaustion after calculation without publishing state.
pub enum DomainAccessError { Closed, DomainFailed, InvalidAccess, Incompatible, ResourceLimit, OutboxFull(UInt64), OutboxClosed(UInt64), Missing(UInt64), Aliased(UInt64), RetryLimit, DirectoryFull(UInt64) }
impl Show for DomainAccessError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            Closed => output.push_str("domain closed")
            DomainFailed => output.push_str("domain failed")
            InvalidAccess => output.push_str("invalid domain access")
            Incompatible => output.push_str("incompatible domain access")
            ResourceLimit => output.push_str("resource limit")
            OutboxFull(id) => { output.push_str("outbox full: "); id.show(output) }
            OutboxClosed(id) => { output.push_str("outbox closed: "); id.show(output) }
            Missing(id) => { output.push_str("missing domain entry: "); id.show(output) }
            Aliased(id) => { output.push_str("aliased domain entry: "); id.show(output) }
            RetryLimit => output.push_str("domain retry limit exceeded")
            DirectoryFull(id) => { output.push_str("directory full: "); id.show(output) }
        }
    }
}

// Candidate operations distinguish business rejection from access/commit failure.
pub enum Outcome<T, E> { Committed(T), Rejected(E), Failed(DomainAccessError) }
impl<T, E> Outcome<T, E> {
    pub fn is_committed(&self) -> Bool {
        match self { Committed(_) => true, _ => false }
    }
    // Explicitly discard either failure and consume the successful payload.
    pub fn committed(self) -> Option<T> {
        match self { Committed(value) => Some(value), _ => None }
    }
    pub fn unwrap(self) -> T {
        match self {
            Committed(value) => value,
            Rejected(_) => check.panic("Called Outcome.unwrap on Rejected"),
            Failed(_) => check.panic("Called Outcome.unwrap on Failed")
        }
    }
    pub fn into_result<F, R: FnOnce(E) -> F, A: FnOnce(DomainAccessError) -> F>(self, rejected: R, failed: A) -> Result<T, F> {
        match self {
            Committed(value) => Ok(value),
            Rejected(error) => Err(rejected(error)),
            Failed(error) => Err(failed(error))
        }
    }
}
// Compiler-authored conversion runs after candidate commit or rollback.
fn __when_outcome<T, E>(value: Result<Result<T, E>, DomainAccessError>) -> Outcome<T, E> {
    match value {
        Ok(Ok(value)) => Outcome.Committed(value),
        Ok(Err(error)) => Outcome.Rejected(error),
        Err(error) => Outcome.Failed(error)
    }
}

fn access_error(status:Int32) -> DomainAccessError {
    if status == 1 { return DomainAccessError.Closed }
    if status == 2 { return DomainAccessError.DomainFailed }
    if status == 3 { return DomainAccessError.InvalidAccess }
    if status == 4 { return DomainAccessError.Incompatible }
    DomainAccessError.ResourceLimit
}
#intrinsic("domain.finish_scalar")
fn finish_scalar<R: Copy>(module:domain.Module,first:domain.Handle,second:domain.Handle,count:UInt64,name:String,input:UInt64,write:Bool,query:Bool) @suspends -> Result<R,DomainAccessError> {
    let (status,bits) = if count == 2 { __domain_pair(module,first,second,name,input) }
        else if query { __domain_query_at(module,first,name,input) }
        else if write { __domain_write_at(module,first,name,input) }
        else { __domain_read_at(module,first,name) }
    if status != 0 { return Err(access_error(status)) }
    Ok(unpack::<R>(bits))
}
#intrinsic("domain.finish_current_scalar")
fn finish_current_scalar<R: Copy>(name:String,input:UInt64,write:Bool,query:Bool) @suspends -> Result<R,DomainAccessError> {
    let (status,bits) = if query { __domain_query_scalar(name,input) }
        else if write { __domain_write_scalar(name,input) } else { __domain_read_scalar(name) }
    if status != 0 { return Err(access_error(status)) }
    Ok(unpack::<R>(bits))
}

// Only trusted call-site lowering can encode or decode a checked scalar type.
#intrinsic("domain.pack")
fn pack<A: Copy>(value: A) -> UInt64
#intrinsic("domain.unpack")
fn unpack<R: Copy>(bits: UInt64) -> R
#intrinsic("domain.read")
pub fn read<S, R>(operation: fn(&S) -> R) @suspends -> Result<R,DomainAccessError> {
    finish_current_value::<Unit,R>("",{})
}
#intrinsic("domain.query")
pub fn query<S, A, R>(operation: fn(&S, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_current_value::<A,R>("",input)
}
#intrinsic("domain.write")
pub fn write<S, A, R>(operation: fn(&mut S, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_current_value::<A,R>("",input)
}

extern fn __domain_module() -> domain.Module
extern fn __domain_create(module: domain.Module, name: String, input: UInt64) @suspends -> domain.StateOwner
extern fn __domain_handle(owner: &domain.StateOwner) @suspends -> domain.Handle
#intrinsic("domain.readonly")
fn readonly(handle: domain.Handle) -> domain.Handle
extern fn __domain_close(owner: &mut domain.StateOwner) @suspends
extern fn __domain_request(module: domain.Module, handle: domain.Handle, name: String, input: UInt64) @suspends -> (Int32, UInt64)
extern fn __domain_read_at(module: domain.Module, handle: domain.Handle, name: String) @suspends -> (Int32, UInt64)
extern fn __domain_query_at(module: domain.Module, handle: domain.Handle, name: String, input: UInt64) @suspends -> (Int32, UInt64)
extern fn __domain_write_at(module: domain.Module, handle: domain.Handle, name: String, input: UInt64) @suspends -> (Int32, UInt64)
extern fn __domain_snapshot(module: domain.Module, handle: domain.Handle, name: String) @suspends -> domain.SnapshotOwner
extern fn __domain_snapshot_value(snapshot: &domain.SnapshotOwner) @suspends -> UInt64
extern fn __domain_snapshot_values(module:domain.Module,handle:domain.Handle,name:String) @suspends -> domain.SnapshotOwner
extern fn __domain_snapshot_read_values(snapshot:&domain.SnapshotOwner,packet:&mut Buffer<UInt64>) @suspends
#intrinsic("domain.snapshot_value")
fn snapshot_value<R>(snapshot:&domain.SnapshotOwner) @suspends -> R {
    var packet=pack_value({})
    __domain_snapshot_read_values(snapshot,&mut packet.storage)
    unpack_value::<R>(&packet)
}
extern fn __domain_snapshot_check(snapshot: &domain.SnapshotOwner) @suspends -> Int32
#intrinsic("domain.module")
fn module() -> domain.Module
pub struct Owner<S> { value: domain.StateOwner }
pub struct ReadHandle<S> { token: domain.Handle }
pub struct WriteHandle<S> { token: domain.Handle }
pub struct Snapshot<S, R> { storage: domain.SnapshotOwner }
pub enum SnapshotStatus { Current, Conflict, Closed, DomainFailed, InvalidAccess }
impl Show for SnapshotStatus {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Current => "current"
            Conflict => "conflict"
            Closed => "closed"
            DomainFailed => "domain failed"
            InvalidAccess => "invalid access"
        })
    }
}

impl<S, R> Snapshot<S, R> {
    pub fn value(&self) @suspends -> R { snapshot_value::<R>(&self.storage) }
    pub fn check(&self) @suspends -> SnapshotStatus {
        let status = __domain_snapshot_check(&self.storage)
        if status == 0 { return SnapshotStatus.Current }
        if status == 1 { return SnapshotStatus.Conflict }
        if status == 2 { return SnapshotStatus.Closed }
        if status == 3 { return SnapshotStatus.DomainFailed }
        SnapshotStatus.InvalidAccess
    }
}
#intrinsic("domain.snapshot_from")
pub fn snapshot_from<S, R>(handle: ReadHandle<S>, projection: fn(&S) -> R) @suspends -> Snapshot<S, R> {
    Snapshot::<S, R> { storage: __domain_snapshot(module(), handle.token, "") }
}
pub enum RequestError { Failed, Cancelled, Closed, ResourceLimit, InvalidAccess, DomainFailed }
impl Show for RequestError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Failed => "request failed"
            Cancelled => "request cancelled"
            Closed => "request closed"
            ResourceLimit => "resource limit"
            InvalidAccess => "invalid access"
            DomainFailed => "domain failed"
        })
    }
}

impl<S> Owner<S> {
    pub fn handle(&self) @suspends -> WriteHandle<S> { WriteHandle::<S> { token: __domain_handle(&self.value) } }
    pub fn read_handle(&self) @suspends -> ReadHandle<S> { self.handle().read_only() }
    pub fn close(self) @suspends { var value = self.value; __domain_close(&mut value) }
}
impl<S> WriteHandle<S> {
    pub fn read_only(self) -> ReadHandle<S> { ReadHandle::<S> { token: readonly(self.token) } }
}
#intrinsic("domain.create")
pub fn create<S, A>(constructor: fn(A) -> S, input: A) @suspends -> Owner<S> {
    finish_create::<S,A>(module(),"",input)
}
extern fn __domain_create_values(module:domain.Module,name:String,packet:&Buffer<UInt64>) @suspends -> domain.StateOwner
#intrinsic("domain.finish_create")
fn finish_create<S,A>(module:domain.Module,name:String,input:A) @suspends -> Owner<S> {
    let packet=pack_value(input)
    Owner::<S>{value:__domain_create_values(module,name,&packet.storage)}
}
#intrinsic("domain.read_from")
pub fn read_from<S, R>(handle: ReadHandle<S>, operation: fn(&S) -> R) @suspends -> Result<R,DomainAccessError> {
    finish_value::<Unit,R>(module(),handle.token,handle.token,1,"",{})
}
#intrinsic("domain.query_from")
pub fn query_from<S, A, R>(handle: ReadHandle<S>, operation: fn(&S, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),handle.token,handle.token,1,"",input)
}
#intrinsic("domain.write_to")
pub fn write_to<S, A, R>(handle: WriteHandle<S>, operation: fn(&mut S, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),handle.token,handle.token,1,"",input)
}
#intrinsic("domain.finish_request")
fn finish_request<R: Copy>(module: domain.Module, token: domain.Handle, name: String, input: UInt64) @suspends -> Result<R, RequestError> {
    let (status, bits) = __domain_request(module, token, name, input)
    if status == 0 { return Ok(unpack::<R>(bits)) }
    if status == 1 { return Err(RequestError.Failed) }
    if status == 2 { return Err(RequestError.Cancelled) }
    if status == 3 { return Err(RequestError.Closed) }
    if status == 4 { return Err(RequestError.ResourceLimit) }
    if status == 5 { return Err(RequestError.InvalidAccess) }
    Err(RequestError.DomainFailed)
}
extern fn __domain_request_values(module:domain.Module,token:domain.Handle,name:String,packet:&mut Buffer<UInt64>) @suspends -> Int32
#intrinsic("domain.finish_request_value")
fn finish_request_value<A,R>(module:domain.Module,token:domain.Handle,name:String,input:A) @suspends -> Result<R,RequestError> {
    var packet=pack_value(input)
    let status=__domain_request_values(module,token,name,&mut packet.storage)
    if status == 0 { return Ok(unpack_value::<R>(&packet)) }
    if status == 1 { return Err(RequestError.Failed) }
    if status == 2 { return Err(RequestError.Cancelled) }
    if status == 3 { return Err(RequestError.Closed) }
    if status == 4 { return Err(RequestError.ResourceLimit) }
    if status == 5 { return Err(RequestError.InvalidAccess) }
    Err(RequestError.DomainFailed)
}
#intrinsic("domain.request")
pub fn request<S, A, R>(handle: WriteHandle<S>, operation: fn(A) @suspends -> R, input: A) @suspends -> Result<R, RequestError> {
    finish_request_value::<A,R>(module(), handle.token, "", input)
}
#intrinsic("domain.request_read")
pub fn request_read<S, A, R>(handle: ReadHandle<S>, operation: fn(A) @suspends -> R, input: A) @suspends -> Result<R, RequestError> {
    finish_request_value::<A,R>(module(), handle.token, "", input)
}

// Candidate construction consumes the snapshot and its complete, opaque read set.
extern fn __domain_candidate_at(module: domain.Module, snapshot: &domain.SnapshotOwner, target:domain.Handle, name: String, input: UInt64) @suspends -> domain.CandidateOwner
extern fn __domain_candidate_at_values(module: domain.Module, snapshot: &domain.SnapshotOwner, target:domain.Handle, name: String, input: &Buffer<UInt64>) @suspends -> domain.CandidateOwner
extern fn __domain_commit(handle: domain.Handle, candidate: &mut domain.CandidateOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_wait(receipt: &mut domain.CommitOwner) @suspends -> Int32
extern fn __domain_commit_failed_outbox(receipt: &domain.CommitOwner) @suspends -> UInt64
extern fn __domain_commit_revision(receipt: &domain.CommitOwner) @suspends -> UInt64
extern fn __domain_commit_identity(receipt: &domain.CommitOwner) @suspends -> UInt64
extern fn __domain_commit_cancel(receipt: &domain.CommitOwner) @suspends
pub struct Candidate<S> { storage: domain.CandidateOwner }
pub struct CommitReceipt { storage: domain.CommitOwner }
// Deadlines use the creating executor's monotonic clock, not wall time.
extern fn __domain_deadline_after(nanoseconds: UInt64) @suspends -> domain.DeadlineOwner
extern fn __domain_commit_before(handle: domain.Handle, candidate: &mut domain.CandidateOwner, deadline: &domain.DeadlineOwner) @suspends -> domain.CommitOwner
pub struct CommitDeadline { storage: domain.DeadlineOwner }
pub fn deadline_after(duration: Duration) @suspends -> CommitDeadline {
    CommitDeadline { storage: __domain_deadline_after(duration.as_nanos()) }
}
pub enum CommitError { Conflict, Closed, DomainFailed, InvalidAccess, Cancelled, ResourceLimit, Expired, OutboxFull, OutboxClosed }
impl Show for CommitError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Conflict => "commit conflict"
            Closed => "domain closed"
            DomainFailed => "domain failed"
            InvalidAccess => "invalid access"
            Cancelled => "commit cancelled"
            ResourceLimit => "resource limit"
            Expired => "commit expired"
            OutboxFull => "outbox full"
            OutboxClosed => "outbox closed"
        })
    }
}

pub enum RevisionError { Pending, Failed(CommitError), InvalidAccess }
impl Show for RevisionError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            Pending => output.push_str("revision pending")
            Failed(error) => error.show(output)
            InvalidAccess => output.push_str("invalid revision access")
        }
    }
}

fn commit_error(status:Int32)->CommitError {
    if status==1 { return CommitError.Conflict }
    if status==2 { return CommitError.Closed }
    if status==3 { return CommitError.DomainFailed }
    if status==4 { return CommitError.InvalidAccess }
    if status==5 { return CommitError.Cancelled }
    if status==7 { return CommitError.Expired }
    if status==8 { return CommitError.OutboxFull }
    if status==9 { return CommitError.OutboxClosed }
    CommitError.ResourceLimit
}
#intrinsic("domain.finish_candidate")
fn finish_candidate<B, R, S>(module: domain.Module, snapshot: Snapshot<B, R>, target:domain.Handle, name: String, input: UInt64) @suspends -> Candidate<S> {
    Candidate::<S> { storage: __domain_candidate_at(module, &snapshot.storage, target, name, input) }
}
#intrinsic("domain.finish_candidate_values")
fn finish_candidate_values<B,R,S,A>(module:domain.Module,snapshot:Snapshot<B,R>,target:domain.Handle,name:String,input:A) @suspends -> Candidate<S> {
    let packet=pack_value(input)
    Candidate::<S>{storage:__domain_candidate_at_values(module,&snapshot.storage,target,name,&packet.storage)}
}
#intrinsic("domain.candidate_from")
pub fn candidate_from<B, R, S, A>(snapshot: Snapshot<B, R>, target:WriteHandle<S>, constructor: fn(A) -> S, input: A) @suspends -> Candidate<S> {
    finish_candidate_values::<B, R, S, A>(module(), snapshot, target.token, "", input)
}
pub fn commit_to<S>(handle: WriteHandle<S>, candidate: Candidate<S>) @suspends -> CommitReceipt {
    var storage = candidate.storage
    CommitReceipt { storage: __domain_commit(handle.token, &mut storage) }
}
pub fn commit_before<S>(handle: WriteHandle<S>, candidate: Candidate<S>, deadline: &CommitDeadline) @suspends -> CommitReceipt {
    var storage = candidate.storage
    CommitReceipt { storage: __domain_commit_before(handle.token, &mut storage, &deadline.storage) }
}
impl CommitReceipt {
    pub fn wait(&mut self) @suspends -> Result<UInt64,CommitError> {
        let status=__domain_commit_wait(&mut self.storage)
        if status==0 { return Ok(__domain_commit_revision(&self.storage)) }
        Err(commit_error(status))
    }
    pub fn failed_outbox(&self) @suspends -> Option<UInt64> {
        let identity = __domain_commit_failed_outbox(&self.storage)
        if identity == 0 { None } else { Some(identity) }
    }
    pub fn identity(&self) @suspends -> UInt64 { __domain_commit_identity(&self.storage) }
    pub fn cancel(&self) @suspends { __domain_commit_cancel(&self.storage) }
}

// Pair operations acquire their entire access set in one synchronous turn.
extern fn __domain_pair(module: domain.Module, first: domain.Handle, second: domain.Handle, name: String, input: UInt64) @suspends -> (Int32, UInt64)
#intrinsic("domain.read_pair")
pub fn read_pair<S, T, R>(first: ReadHandle<S>, second: ReadHandle<T>, operation: fn(&S, &T) -> R) @suspends -> Result<R,DomainAccessError> {
    finish_value::<Unit,R>(module(),first.token,second.token,2,"",{})
}
#intrinsic("domain.query_pair")
pub fn query_pair<S, T, A, R>(first: ReadHandle<S>, second: ReadHandle<T>, operation: fn(&S, &T, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),first.token,second.token,2,"",input)
}
#intrinsic("domain.update_pair")
pub fn update_pair<S, T, A, R>(first: ReadHandle<S>, second: WriteHandle<T>, operation: fn(&S, &mut T, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),first.token,second.token,2,"",input)
}
#intrinsic("domain.write_pair")
pub fn write_pair<S, T, A, R>(first: WriteHandle<S>, second: WriteHandle<T>, operation: fn(&mut S, &mut T, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),first.token,second.token,2,"",input)
}

// Both read dependencies stay opaque; candidate construction selects its target.
extern fn __domain_snapshot_pair(module: domain.Module, first: domain.Handle, second: domain.Handle, name: String) @suspends -> domain.SnapshotOwner
extern fn __domain_snapshot_pair_values(module: domain.Module, first: domain.Handle, second: domain.Handle, name: String) @suspends -> domain.SnapshotOwner
#intrinsic("domain.snapshot_pair")
pub fn snapshot_pair<S, T, R>(first: ReadHandle<S>, second: ReadHandle<T>, projection: fn(&S, &T) -> R) @suspends -> Snapshot<S, R> {
    Snapshot::<S, R> { storage: __domain_snapshot_pair(module(), first.token, second.token, "") }
}

// Extending consumes the candidate and selects another target from its complete read set.
extern fn __domain_candidate_pair_at(module: domain.Module, first: &mut domain.CandidateOwner, target:domain.Handle, name: String, input: UInt64) @suspends -> domain.CandidatePairOwner
extern fn __domain_candidate_pair_at_values(module: domain.Module, first: &mut domain.CandidateOwner, target:domain.Handle, name: String, input: &Buffer<UInt64>) @suspends -> domain.CandidatePairOwner
extern fn __domain_commit_pair(first: domain.Handle, second: domain.Handle, candidates: &mut domain.CandidatePairOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_pair_before(first: domain.Handle, second: domain.Handle, candidates: &mut domain.CandidatePairOwner, deadline: &domain.DeadlineOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_second_revision(receipt: &domain.CommitOwner) @suspends -> UInt64
pub struct CandidatePair<S, T> { storage: domain.CandidatePairOwner }
pub struct PairCommitReceipt { storage: domain.CommitOwner }
#intrinsic("domain.finish_candidate_pair")
fn finish_candidate_pair<S, T>(module: domain.Module, first: Candidate<S>, target:domain.Handle, name: String, input: UInt64) @suspends -> CandidatePair<S, T> {
    var storage = first.storage
    CandidatePair::<S, T> { storage: __domain_candidate_pair_at(module, &mut storage, target, name, input) }
}
#intrinsic("domain.finish_candidate_pair_values")
fn finish_candidate_pair_values<S,T,A>(module:domain.Module,first:Candidate<S>,target:domain.Handle,name:String,input:A) @suspends -> CandidatePair<S,T> {
    let packet=pack_value(input)
    var storage=first.storage
    CandidatePair::<S,T>{storage:__domain_candidate_pair_at_values(module,&mut storage,target,name,&packet.storage)}
}
#intrinsic("domain.candidate_pair_from")
pub fn candidate_pair_from<S, T, A>(first: Candidate<S>, target:WriteHandle<T>, constructor: fn(A) -> T, input: A) @suspends -> CandidatePair<S, T> {
    finish_candidate_pair_values::<S, T, A>(module(), first, target.token, "", input)
}
pub fn commit_pair_to<S, T>(first: WriteHandle<S>, second: WriteHandle<T>, candidates: CandidatePair<S, T>) @suspends -> PairCommitReceipt {
    var storage = candidates.storage
    PairCommitReceipt { storage: __domain_commit_pair(first.token, second.token, &mut storage) }
}
pub fn commit_pair_before<S, T>(first: WriteHandle<S>, second: WriteHandle<T>, candidates: CandidatePair<S, T>, deadline: &CommitDeadline) @suspends -> PairCommitReceipt {
    var storage = candidates.storage
    PairCommitReceipt { storage: __domain_commit_pair_before(first.token, second.token, &mut storage, &deadline.storage) }
}
impl PairCommitReceipt {
    pub fn wait(&mut self) @suspends -> Result<(UInt64,UInt64),CommitError> {
        let status=__domain_commit_wait(&mut self.storage)
        if status==0 { return Ok((__domain_commit_revision(&self.storage),__domain_commit_second_revision(&self.storage))) }
        Err(commit_error(status))
    }
    pub fn failed_outbox(&self) @suspends -> Option<UInt64> {
        let identity = __domain_commit_failed_outbox(&self.storage)
        if identity == 0 { None } else { Some(identity) }
    }
    pub fn identity(&self) @suspends -> UInt64 { __domain_commit_identity(&self.storage) }
    pub fn cancel(&self) @suspends { __domain_commit_cancel(&self.storage) }
}

// A bounded read set captures independent hook-free owning roots in one executor turn.
extern fn __domain_access_set() @suspends -> domain.AccessSetOwner
extern fn __domain_access_include(set:&mut domain.AccessSetOwner,handle:domain.Handle) @suspends
extern fn __domain_snapshot_set(set:&mut domain.AccessSetOwner) @suspends -> domain.SnapshotSetOwner
extern fn __domain_set_read(module:domain.Module,snapshot:&domain.SnapshotSetOwner,handle:domain.Handle,name:String) @suspends -> UInt64
extern fn __domain_set_check(snapshot:&domain.SnapshotSetOwner) @suspends -> Int32
extern fn __domain_set_candidate(module:domain.Module,snapshot:&mut domain.SnapshotSetOwner,handle:domain.Handle,name:String,input:UInt64) @suspends -> domain.CandidateSetOwner
extern fn __domain_set_candidate_values(module:domain.Module,snapshot:&mut domain.SnapshotSetOwner,handle:domain.Handle,name:String,input:&Buffer<UInt64>) @suspends -> domain.CandidateSetOwner
extern fn __domain_set_add(module:domain.Module,set:&mut domain.CandidateSetOwner,handle:domain.Handle,name:String,input:UInt64) @suspends -> domain.CandidateSetOwner
extern fn __domain_set_add_values(module:domain.Module,set:&mut domain.CandidateSetOwner,handle:domain.Handle,name:String,input:&Buffer<UInt64>) @suspends -> domain.CandidateSetOwner
extern fn __domain_commit_set(set:&mut domain.CandidateSetOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_set_before(set:&mut domain.CandidateSetOwner,deadline:&domain.DeadlineOwner) @suspends -> domain.CommitOwner
extern fn __domain_set_revision_checked(receipt:&domain.CommitOwner,handle:domain.Handle) @suspends -> (Int32,UInt64)
pub struct AccessSet { storage:domain.AccessSetOwner }
pub struct SnapshotSet { storage:domain.SnapshotSetOwner }
pub struct CandidateSet { storage:domain.CandidateSetOwner }
pub struct SetCommitReceipt { storage:domain.CommitOwner }
pub fn access_set() @suspends -> AccessSet { AccessSet{storage:__domain_access_set()} }
impl AccessSet {
    pub fn include<S>(&mut self,handle:ReadHandle<S>) @suspends { include_handle(self,handle.token) }
}
pub fn snapshot_set(set:AccessSet) @suspends -> SnapshotSet {
    var storage=set.storage
    SnapshotSet{storage:__domain_snapshot_set(&mut storage)}
}
fn include_handle(set:&mut AccessSet,handle:domain.Handle) @suspends { __domain_access_include(&mut set.storage,handle) }
extern fn __domain_set_read_values(module:domain.Module,snapshot:&domain.SnapshotSetOwner,handle:domain.Handle,name:String,packet:&mut Buffer<UInt64>) @suspends
#intrinsic("domain.finish_snapshot_read")
fn finish_snapshot_read<A,R>(module:domain.Module,snapshot:&domain.SnapshotSetOwner,handle:domain.Handle,name:String,input:A) @suspends -> R {
    var packet=pack_value(input)
    __domain_set_read_values(module,snapshot,handle,name,&mut packet.storage)
    unpack_value::<R>(&packet)
}
#intrinsic("domain.read_snapshot")
pub fn read_snapshot<S,R>(snapshot:&SnapshotSet,handle:ReadHandle<S>,projection:fn(&S)->R) @suspends -> R {
    finish_snapshot_read::<Unit,R>(module(),&snapshot.storage,handle.token,"",{})
}
#intrinsic("domain.read_snapshot")
pub fn query_snapshot<S,A,R>(snapshot:&SnapshotSet,handle:ReadHandle<S>,projection:fn(&S,A)->R,input:A) @suspends -> R {
    finish_snapshot_read::<A,R>(module(),&snapshot.storage,handle.token,"",input)
}
impl SnapshotSet {
    pub fn check(&self) @suspends -> SnapshotStatus {
        let status=__domain_set_check(&self.storage)
        if status==0 { return SnapshotStatus.Current }
        if status==1 { return SnapshotStatus.Conflict }
        if status==2 { return SnapshotStatus.Closed }
        if status==3 { return SnapshotStatus.DomainFailed }
        SnapshotStatus.InvalidAccess
    }
}
#intrinsic("domain.finish_set_candidate")
fn finish_set_candidate(module:domain.Module,snapshot:SnapshotSet,handle:domain.Handle,name:String,input:UInt64) @suspends -> CandidateSet {
    var storage=snapshot.storage
    CandidateSet{storage:__domain_set_candidate(module,&mut storage,handle,name,input)}
}
#intrinsic("domain.finish_set_add")
fn finish_set_add(module:domain.Module,set:CandidateSet,handle:domain.Handle,name:String,input:UInt64) @suspends -> CandidateSet {
    var storage=set.storage
    CandidateSet{storage:__domain_set_add(module,&mut storage,handle,name,input)}
}
#intrinsic("domain.finish_set_candidate_values")
fn finish_set_candidate_values<A>(module:domain.Module,snapshot:SnapshotSet,handle:domain.Handle,name:String,input:A) @suspends -> CandidateSet {
    let packet=pack_value(input)
    var storage=snapshot.storage
    CandidateSet{storage:__domain_set_candidate_values(module,&mut storage,handle,name,&packet.storage)}
}
#intrinsic("domain.candidate_set_from")
pub fn candidate_set_from<S,A>(snapshot:SnapshotSet,handle:WriteHandle<S>,constructor:fn(A)->S,input:A) @suspends -> CandidateSet {
    finish_set_candidate_values::<A>(module(),snapshot,handle.token,"",input)
}
#intrinsic("domain.finish_set_add_values")
fn finish_set_add_values<A>(module:domain.Module,set:CandidateSet,handle:domain.Handle,name:String,input:A) @suspends -> CandidateSet {
    let packet=pack_value(input)
    var storage=set.storage
    CandidateSet{storage:__domain_set_add_values(module,&mut storage,handle,name,&packet.storage)}
}
#intrinsic("domain.candidate_set_add")
pub fn candidate_set_add<S,A>(set:CandidateSet,handle:WriteHandle<S>,constructor:fn(A)->S,input:A) @suspends -> CandidateSet {
    finish_set_add_values::<A>(module(),set,handle.token,"",input)
}
extern fn __domain_set_edit_snapshot(module:domain.Module,snapshot:&mut domain.SnapshotSetOwner,handle:domain.Handle,name:String,input:&Buffer<UInt64>) @suspends -> domain.CandidateSetOwner
extern fn __domain_set_edit_candidate(module:domain.Module,set:&mut domain.CandidateSetOwner,handle:domain.Handle,name:String,input:&Buffer<UInt64>) @suspends -> domain.CandidateSetOwner
#intrinsic("domain.finish_edit_snapshot")
