    let packet=pack_value(input)
    var storage=snapshot.storage
    CandidateSet{storage:__domain_set_edit_snapshot(module,&mut storage,handle,name,&packet.storage)}
}
#intrinsic("domain.edit_snapshot")
pub fn edit_snapshot<S,A>(snapshot:SnapshotSet,handle:WriteHandle<S>,editor:fn(&mut S,A)->Unit,input:A) @suspends -> CandidateSet {
    finish_edit_snapshot::<A>(module(),snapshot,handle.token,"",input)
}
#intrinsic("domain.finish_edit_candidate")
fn finish_edit_candidate<A>(module:domain.Module,set:CandidateSet,handle:domain.Handle,name:String,input:A) @suspends -> CandidateSet {
    let packet=pack_value(input)
    var storage=set.storage
    CandidateSet{storage:__domain_set_edit_candidate(module,&mut storage,handle,name,&packet.storage)}
}
#intrinsic("domain.edit_candidate")
pub fn edit_candidate<S,A>(set:CandidateSet,handle:WriteHandle<S>,editor:fn(&mut S,A)->Unit,input:A) @suspends -> CandidateSet {
    finish_edit_candidate::<A>(module(),set,handle.token,"",input)
}
pub fn commit_set(set:CandidateSet) @suspends -> SetCommitReceipt {
    var storage=set.storage
    SetCommitReceipt{storage:__domain_commit_set(&mut storage)}
}
pub fn commit_set_before(set:CandidateSet,deadline:&CommitDeadline) @suspends -> SetCommitReceipt {
    var storage=set.storage
    SetCommitReceipt{storage:__domain_commit_set_before(&mut storage,&deadline.storage)}
}
impl SetCommitReceipt {
    pub fn wait(&mut self) @suspends -> Result<Unit,CommitError> {
        let status=__domain_commit_wait(&mut self.storage)
        if status==0 { return Ok({}) }
        Err(commit_error(status))
    }
    pub fn revision<S>(&self,handle:ReadHandle<S>) @suspends -> Result<Option<UInt64>,RevisionError> { set_revision(self,handle.token) }
    pub fn failed_outbox(&self) @suspends -> Option<UInt64> {
        let identity = __domain_commit_failed_outbox(&self.storage)
        if identity == 0 { None } else { Some(identity) }
    }
    pub fn identity(&self) @suspends -> UInt64 { __domain_commit_identity(&self.storage) }
    pub fn cancel(&self) @suspends { __domain_commit_cancel(&self.storage) }
}

fn set_revision(receipt:&SetCommitReceipt,handle:domain.Handle) @suspends -> Result<Option<UInt64>,RevisionError> {
    let (status,value)=__domain_set_revision_checked(&receipt.storage,handle)
    if status==0 { return Ok(Some(value)) }
    if status==10 { return Ok(None) }
    if status==11 { return Err(RevisionError.Pending) }
    if status==12 { return Err(RevisionError.InvalidAccess) }
    Err(RevisionError.Failed(commit_error(status)))
}

// Attaching consumes the batch. Only candidate commits can publish its messages.
extern fn __outbox_attach(candidate:&mut domain.CandidateOwner, batch:&mut outbox.BatchOwner) @suspends
extern fn __outbox_attach_pair(candidate:&mut domain.CandidatePairOwner, batch:&mut outbox.BatchOwner) @suspends
extern fn __outbox_attach_set(candidate:&mut domain.CandidateSetOwner, batch:&mut outbox.BatchOwner) @suspends
impl<S> Candidate<S> {
    pub fn with_outbox(var self, var batch:Batch) @suspends -> Candidate<S> {
        __outbox_attach(&mut self.storage,&mut batch)
        self
    }
}
impl<S,T> CandidatePair<S,T> {
    pub fn with_outbox(var self, var batch:Batch) @suspends -> CandidatePair<S,T> {
        __outbox_attach_pair(&mut self.storage,&mut batch)
        self
    }
}
impl CandidateSet {
    pub fn with_outbox(var self, var batch:Batch) @suspends -> CandidateSet {
        __outbox_attach_set(&mut self.storage,&mut batch)
        self
    }
}

// Directories own bounded routing storage, never the addressed domains or code.
extern fn __directory_create(capacity:UInt64) @suspends -> domain.DirectoryOwner
extern fn __directory_handle(owner:&domain.DirectoryOwner) @suspends -> UInt64
extern fn __directory_close(directory:UInt64) @suspends
extern fn __directory_insert(directory:UInt64, key:UInt64, target:domain.Handle) @suspends -> Int32
extern fn __directory_insert_owned(directory:UInt64, key:UInt64, target:&mut domain.StateOwner) @suspends -> Int32
extern fn __directory_replace(directory:UInt64, key:UInt64, expected:domain.Handle, target:domain.Handle) @suspends -> Int32
extern fn __directory_remove(directory:UInt64, key:UInt64, expected:domain.Handle) @suspends -> Bool
extern fn __directory_lookup(module:domain.Module, directory:UInt64, key:UInt64, operation:String, writable:Bool) @suspends -> domain.Handle
extern fn __directory_found(target:domain.Handle) @suspends -> Bool

pub struct Directory { storage:domain.DirectoryOwner }
// A flat, non-owning capability suitable for AOT/Script entry contracts.
pub struct DirectoryHandle { identity:UInt64 }
pub enum DirectoryError { Closed, Full, Occupied, InvalidTarget, Conflict, ResourceLimit }
impl Show for DirectoryError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Closed => "directory closed"
            Full => "directory full"
            Occupied => "directory entry occupied"
            InvalidTarget => "invalid directory target"
            Conflict => "directory conflict"
            ResourceLimit => "resource limit"
        })
    }
}

pub fn directory(capacity:UInt64) @suspends -> Directory {
    Directory { storage:__directory_create(capacity) }
}
impl Directory {
    pub fn handle(&self) @suspends -> DirectoryHandle {
        DirectoryHandle { identity:__directory_handle(&self.storage) }
    }
    pub fn close(self) @suspends { __directory_close(self.handle().identity) }
}
fn directory_status(status:Int32) -> Result<Unit,DirectoryError> {
    if status==0 { return Ok({}) }
    if status==1 { return Err(DirectoryError.Closed) }
    if status==2 { return Err(DirectoryError.Full) }
    if status==3 { return Err(DirectoryError.Occupied) }
    if status==4 { return Err(DirectoryError.InvalidTarget) }
    if status==6 { return Err(DirectoryError.ResourceLimit) }
    Err(DirectoryError.Conflict)
}
impl DirectoryHandle {
    // Consumes the owner on every outcome; a failed insertion closes its state.
    // Successful insertion transfers close responsibility to the directory.
    pub fn insert_owned<S>(self, key:UInt64, target:Owner<S>) @suspends -> Result<Unit,DirectoryError> {
        var value=target.value
        directory_status(__directory_insert_owned(self.identity,key,&mut value))
    }
    pub fn insert<S>(self, key:UInt64, target:WriteHandle<S>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_insert(self.identity,key,target.token))
    }
    pub fn insert_read<S>(self, key:UInt64, target:ReadHandle<S>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_insert(self.identity,key,target.token))
    }
    pub fn replace<S,T>(self, key:UInt64, expected:ReadHandle<S>, target:WriteHandle<T>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_replace(self.identity,key,expected.token,target.token))
    }
    pub fn replace_read<S,T>(self, key:UInt64, expected:ReadHandle<S>, target:ReadHandle<T>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_replace(self.identity,key,expected.token,target.token))
    }
    // Comparing identity prevents stale connection cleanup from deleting a new route.
    pub fn remove<S>(self, key:UInt64, expected:ReadHandle<S>) @suspends -> Bool {
        __directory_remove(self.identity,key,expected.token)
    }
}
// Specialization supplies checked state metadata without a user operation.
// The private witness is never invoked and does not borrow a live root.
#intrinsic("domain.lookup_type")
fn lookup_type<S>() -> String
#intrinsic("domain.lookup_witness")
fn lookup_witness<S>(state: &S) {}
pub fn lookup<S>(directory:DirectoryHandle, key:UInt64) @suspends -> Option<ReadHandle<S>> {
    finish_lookup::<S>(module(),directory.identity,key,lookup_type::<S>())
}
pub fn lookup_write<S>(directory:DirectoryHandle, key:UInt64) @suspends -> Option<WriteHandle<S>> {
    finish_lookup_write::<S>(module(),directory.identity,key,lookup_type::<S>())
}
fn finish_lookup<S>(module:domain.Module, directory:UInt64, key:UInt64, operation:String) @suspends -> Option<ReadHandle<S>> {
    let token=__directory_lookup(module,directory,key,operation,false)
    if __directory_found(token) { Some(ReadHandle::<S>{token:token}) } else { None }
}
fn finish_lookup_write<S>(module:domain.Module, directory:UInt64, key:UInt64, operation:String) @suspends -> Option<WriteHandle<S>> {
    let token=__directory_lookup(module,directory,key,operation,true)
    if __directory_found(token) { Some(WriteHandle::<S>{token:token}) } else { None }
}

// A timer owner is independent of the Script invocation that arms it.
extern fn __timer_create() @suspends -> domain.TimerOwner
extern fn __timer_handle(owner:&domain.TimerOwner) @suspends -> UInt64
extern fn __timer_close(timer:UInt64) @suspends
extern fn __timer_cancel(timer:UInt64) @suspends
extern fn __timer_status(timer:UInt64) @suspends -> Int32
extern fn __domain_periodic_status(target:domain.Handle,method:String) @suspends -> Int32
extern fn __timer_start(module:domain.Module, timer:UInt64, target:domain.Handle, nanoseconds:UInt64, operation:String, input:UInt64, periodic:Bool) @suspends -> Int32
pub struct Timer { storage:domain.TimerOwner }
pub struct TimerHandle { identity:UInt64 }
pub enum TimerStatus { Idle, Active, Completed, Cancelled, Closed, InvalidAccess, ResourceLimit, Failed }
impl Show for TimerStatus {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Idle => "idle"
            Active => "active"
            Completed => "completed"
            Cancelled => "cancelled"
            Closed => "closed"
            InvalidAccess => "invalid access"
            ResourceLimit => "resource limit"
            Failed => "failed"
        })
    }
}

pub enum TimerError { Closed, Busy, InvalidDelay, InvalidAccess, ResourceLimit }
impl Show for TimerError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Closed => "timer closed"
            Busy => "timer busy"
            InvalidDelay => "invalid timer delay"
            InvalidAccess => "invalid access"
            ResourceLimit => "resource limit"
        })
    }
}

pub fn timer() @suspends -> Timer { Timer{storage:__timer_create()} }
pub fn periodic_status<S>(target:ReadHandle<S>,method:String) @suspends -> TimerStatus {
    timer_status(__domain_periodic_status(target.token,method))
}
fn timer_status(status:Int32)->TimerStatus {
    if status==0 { return TimerStatus.Idle }
    if status==1 { return TimerStatus.Active }
    if status==2 { return TimerStatus.Completed }
    if status==3 { return TimerStatus.Cancelled }
    if status==4 { return TimerStatus.Closed }
    if status==5 { return TimerStatus.InvalidAccess }
    if status==6 { return TimerStatus.ResourceLimit }
    TimerStatus.Failed
}
impl Timer {
    pub fn handle(&self) @suspends -> TimerHandle { TimerHandle{identity:__timer_handle(&self.storage)} }
    pub fn close(self) @suspends { __timer_close(self.handle().identity) }
}
impl TimerHandle {
    pub fn cancel(self) @suspends { __timer_cancel(self.identity) }
    pub fn status(self) @suspends -> TimerStatus {
        timer_status(__timer_status(self.identity))
    }
}
#intrinsic("domain.finish_timer")
fn finish_timer(module:domain.Module, timer:UInt64, target:domain.Handle, duration:Duration, operation:String, input:UInt64, periodic:Bool) @suspends -> Result<Unit,TimerError> {
    let status=__timer_start(module,timer,target,duration.as_nanos(),operation,input,periodic)
    if status==0 { return Ok({}) }
    if status==1 { return Err(TimerError.Closed) }
    if status==2 { return Err(TimerError.Busy) }
    if status==3 { return Err(TimerError.InvalidDelay) }
    if status==4 { return Err(TimerError.InvalidAccess) }
    Err(TimerError.ResourceLimit)
}
extern fn __timer_start_values(module:domain.Module,timer:UInt64,target:domain.Handle,nanoseconds:UInt64,operation:String,input:&Buffer<UInt64>,periodic:Bool) @suspends -> Int32
#intrinsic("domain.finish_timer_value")
fn finish_timer_value<A>(module:domain.Module,timer:UInt64,target:domain.Handle,duration:Duration,operation:String,input:A,periodic:Bool) @suspends -> Result<Unit,TimerError> {
    let packet=pack_value(input)
    let status=__timer_start_values(module,timer,target,duration.as_nanos(),operation,&packet.storage,periodic)
    if status==0 { return Ok({}) }
    if status==1 { return Err(TimerError.Closed) }
    if status==2 { return Err(TimerError.Busy) }
    if status==3 { return Err(TimerError.InvalidDelay) }
    if status==4 { return Err(TimerError.InvalidAccess) }
    Err(TimerError.ResourceLimit)
}
#intrinsic("domain.after")
pub fn after<S,A>(timer:TimerHandle, target:WriteHandle<S>, duration:Duration, operation:fn(&mut S,A)->Unit, input:A) @suspends -> Result<Unit,TimerError> {
    finish_timer_value::<A>(module(),timer.identity,target.token,duration,"",input,false)
}
#intrinsic("domain.every")
pub fn every<S,A>(timer:TimerHandle, target:WriteHandle<S>, duration:Duration, operation:fn(&mut S,A)->Unit, input:A) @suspends -> Result<Unit,TimerError> {
    finish_timer_value::<A>(module(),timer.identity,target.token,duration,"",input,true)
}

// Compiler-generated when and handle-method calls use a variable-size access packet.
extern fn __domain_when(module:domain.Module,name:String,handles:&Buffer<UInt64>,packet:&mut Buffer<UInt64>) @suspends -> (Int32,UInt64)
#intrinsic("domain.finish_when")
fn finish_when<H,A,R>(module:domain.Module,name:String,handles:H,input:A) @suspends -> Result<R,DomainAccessError> {
    let access=pack_value(handles)
    var packet=pack_value(input)
    let (status,target)=__domain_when(module,name,&access.storage,&mut packet.storage)
    if status==6 { return Err(DomainAccessError.OutboxFull(target)) }
    if status==7 { return Err(DomainAccessError.OutboxClosed(target)) }
    if status != 0 { return Err(access_error(status)) }
    Ok(unpack_value::<R>(&packet))
}

extern fn __domain_when_paths(module:domain.Module,name:String,handles:&Buffer<UInt64>,packet:&mut Buffer<UInt64>) @suspends -> (Int32,UInt64)
#intrinsic("domain.finish_paths")
fn finish_paths<H,A,R>(module:domain.Module,name:String,handles:H,input:A) @suspends -> Result<R,DomainAccessError> {
    let access=pack_value(handles)
    var packet=pack_value(input)
    let (status,target)=__domain_when_paths(module,name,&access.storage,&mut packet.storage)
    if status==6 { return Err(DomainAccessError.OutboxFull(target)) }
    if status==7 { return Err(DomainAccessError.OutboxClosed(target)) }
    if status==8 { return Err(DomainAccessError.Missing(target)) }
    if status==9 { return Err(DomainAccessError.Aliased(target)) }
    if status==10 { return Err(DomainAccessError.RetryLimit) }
    if status==11 { return Err(DomainAccessError.DirectoryFull(target)) }
    if status != 0 { return Err(access_error(status)) }
    Ok(unpack_value::<R>(&packet))
}

extern fn __directory_lookup_named(module:domain.Module, directory:UInt64, key:&String, operation:String, writable:Bool) @suspends -> domain.Handle
extern fn __directory_insert_named(directory:UInt64, key:&String, target:domain.Handle) @suspends -> Int32
extern fn __directory_insert_owned_named(directory:UInt64, key:&String, target:&mut domain.StateOwner) @suspends -> Int32
extern fn __directory_remove_named(directory:UInt64, key:&String, expected:domain.Handle) @suspends -> Bool
pub fn lookup_named<S>(directory:DirectoryHandle, key:&String) @suspends -> Option<ReadHandle<S>> {
    let token=__directory_lookup_named(module(),directory.identity,key,lookup_type::<S>(),false)
    if __directory_found(token) { Some(ReadHandle::<S>{token:token}) } else { None }
}
pub fn lookup_named_write<S>(directory:DirectoryHandle, key:&String) @suspends -> Option<WriteHandle<S>> {
    let token=__directory_lookup_named(module(),directory.identity,key,lookup_type::<S>(),true)
    if __directory_found(token) { Some(WriteHandle::<S>{token:token}) } else { None }
}
impl DirectoryHandle {
    pub fn insert_named<S>(self,key:&String,target:WriteHandle<S>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_insert_named(self.identity,key,target.token))
    }
    pub fn insert_owned_named<S>(self,key:&String,target:Owner<S>) @suspends -> Result<Unit,DirectoryError> {
        var value=target.value
        directory_status(__directory_insert_owned_named(self.identity,key,&mut value))
    }
    pub fn remove_named<S>(self,key:&String,expected:ReadHandle<S>) @suspends -> Bool {
        __directory_remove_named(self.identity,key,expected.token)
    }
}

extern fn __directory_remove_named_if(module:domain.Module,directory:UInt64,key:&String,predicate:String) @suspends -> UInt64
#intrinsic("domain.remove_named_if")
pub fn remove_named_if<S>(directory:DirectoryHandle,key:&String,predicate:fn(&S)->Bool) @suspends -> Result<Bool,DomainAccessError> {
    Err(DomainAccessError.InvalidAccess)
}
#intrinsic("domain.finish_remove_named_if")
fn finish_remove_named_if(module:domain.Module,directory:UInt64,key:&String,predicate:String) @suspends -> Result<Bool,DomainAccessError> {
    let result=__directory_remove_named_if(module,directory,key,predicate)
    let status=unpack::<Int32>(result & 0xffffffff)
    if status!=0 { return Err(access_error(status)) }
    Ok(result >> 32 != 0)
}
