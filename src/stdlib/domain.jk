import joky/internal/buffer.{type Buffer}
import joky/option.{type Option}
import joky/outbox.{type Batch}
import joky/result.{type Result}
// Trusted call-site intrinsics. The runtime resolves state only after admission.
extern fn __domain_read_scalar(method: String) @suspends -> (Int32, UInt64)
extern fn __domain_write_scalar(method: String, input: UInt64) @suspends -> (Int32, UInt64)

struct ValuePacket { storage: Buffer<UInt64> }
#intrinsic("domain.value_pack")
fn pack_value<A>(value:A) -> ValuePacket;
#intrinsic("domain.value_unpack")
fn unpack_value<R>(packet:&ValuePacket) -> R;
extern fn __domain_values(module:domain.Module,first:domain.Handle,second:domain.Handle,count:UInt64,name:String,packet:&mut Buffer<UInt64>) @suspends -> Int32
#intrinsic("domain.finish_value")
fn finish_value<A,R>(module:domain.Module,first:domain.Handle,second:domain.Handle,count:UInt64,name:String,input:A) @suspends -> Result<R,DomainAccessError> {
    var packet=pack_value(input)
    let status=__domain_values(module,first,second,count,name,&mut packet.storage)
    if status != 0 { return Result.Err(access_error(status)) }
    Result.Ok(unpack_value::<R>(&packet))
}

extern fn __domain_current_values(name:String,packet:&mut Buffer<UInt64>) @suspends -> Int32
#intrinsic("domain.finish_current_value")
fn finish_current_value<A,R>(name:String,input:A) @suspends -> Result<R,DomainAccessError> {
    var packet=pack_value(input)
    let status=__domain_current_values(name,&mut packet.storage)
    if status != 0 { return Result.Err(access_error(status)) }
    Result.Ok(unpack_value::<R>(&packet))
}

// Access errors are rejections before the operation body starts.
pub enum DomainAccessError { Closed, DomainFailed, InvalidAccess, Incompatible, ResourceLimit }
fn access_error(status:Int32) -> DomainAccessError {
    if status == 1 { return DomainAccessError.Closed }
    if status == 2 { return DomainAccessError.DomainFailed }
    if status == 3 { return DomainAccessError.InvalidAccess }
    if status == 4 { return DomainAccessError.Incompatible }
    DomainAccessError.ResourceLimit
}
#intrinsic("domain.finish_scalar")
fn finish_scalar<R>(module:domain.Module,first:domain.Handle,second:domain.Handle,count:UInt64,name:String,input:UInt64,write:Bool) @suspends -> Result<R,DomainAccessError> {
    let (status,bits) = if count == 2 { __domain_pair(module,first,second,name,input) }
        else if write { __domain_write_at(module,first,name,input) }
        else { __domain_read_at(module,first,name) }
    if status != 0 { return Result.Err(access_error(status)) }
    Result.Ok(unpack::<R>(bits))
}
#intrinsic("domain.finish_current_scalar")
fn finish_current_scalar<R>(name:String,input:UInt64,write:Bool) @suspends -> Result<R,DomainAccessError> {
    let (status,bits) = if write { __domain_write_scalar(name,input) } else { __domain_read_scalar(name) }
    if status != 0 { return Result.Err(access_error(status)) }
    Result.Ok(unpack::<R>(bits))
}

// Only trusted call-site lowering can encode or decode a checked scalar type.
#intrinsic("domain.pack")
fn pack<A>(value: A) -> UInt64;
#intrinsic("domain.unpack")
fn unpack<R>(bits: UInt64) -> R;
#intrinsic("domain.read")
pub fn read<S, R>(operation: fn(&S) -> R) @suspends -> Result<R,DomainAccessError> {
    finish_current_value::<Unit,R>("",{})
}
#intrinsic("domain.write")
pub fn write<S, A, R>(operation: fn(&mut S, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_current_value::<A,R>("",input)
}

extern fn __domain_module() -> domain.Module
extern fn __domain_create(module: domain.Module, name: String, input: UInt64) @suspends -> domain.StateOwner
extern fn __domain_handle(owner: &domain.StateOwner) @suspends -> domain.Handle
extern fn __domain_readonly(handle: domain.Handle) @suspends -> domain.Handle
extern fn __domain_close(owner: &mut domain.StateOwner) @suspends
extern fn __domain_request(module: domain.Module, handle: domain.Handle, name: String, input: UInt64) @suspends -> (Int32, UInt64)
extern fn __domain_read_at(module: domain.Module, handle: domain.Handle, name: String) @suspends -> (Int32, UInt64)
extern fn __domain_write_at(module: domain.Module, handle: domain.Handle, name: String, input: UInt64) @suspends -> (Int32, UInt64)
extern fn __domain_snapshot(module: domain.Module, handle: domain.Handle, name: String) @suspends -> domain.SnapshotOwner
extern fn __domain_snapshot_value(snapshot: &domain.SnapshotOwner) @suspends -> UInt64
extern fn __domain_snapshot_check(snapshot: &domain.SnapshotOwner) @suspends -> Int32
#intrinsic("domain.module")
fn module() -> domain.Module;
pub struct Owner<S> { value: domain.StateOwner }
pub struct ReadHandle<S> { token: domain.Handle }
pub struct WriteHandle<S> { token: domain.Handle }
pub struct Snapshot<S, R> { storage: domain.SnapshotOwner }
pub enum SnapshotStatus { Current, Conflict, Closed, DomainFailed, InvalidAccess }
impl<S, R> Snapshot<S, R> {
    pub fn value(&self) @suspends -> R { unpack::<R>(__domain_snapshot_value(&self.storage)) }
    pub fn check(&self) @suspends -> SnapshotStatus {
        let status = __domain_snapshot_check(&self.storage)
        if status == 0 { return SnapshotStatus.Current }
        if status == 1 { return SnapshotStatus.Conflict }
        if status == 2 { return SnapshotStatus.Closed }
        if status == 3 { return SnapshotStatus.DomainFailed }
        SnapshotStatus.InvalidAccess
    }
}
#intrinsic("domain.snapshot_from")
pub fn snapshot_from<S, R>(handle: ReadHandle<S>, projection: fn(&S) -> R) @suspends -> Snapshot<S, R> {
    Snapshot::<S, R> { storage: __domain_snapshot(module(), handle.token, "") }
}
pub enum RequestError { Failed, Cancelled, Closed, ResourceLimit, InvalidAccess, DomainFailed }
impl<S> Owner<S> {
    pub fn handle(&self) @suspends -> WriteHandle<S> { WriteHandle::<S> { token: __domain_handle(&self.value) } }
    pub fn read_handle(&self) @suspends -> ReadHandle<S> { self.handle().read_only() }
    pub fn close(self) @suspends { var value = self.value __domain_close(&mut value) }
}
impl<S> WriteHandle<S> {
    pub fn read_only(self) @suspends -> ReadHandle<S> { ReadHandle::<S> { token: __domain_readonly(self.token) } }
}
#intrinsic("domain.create")
pub fn create<S, A>(constructor: fn(A) -> S, input: A) @suspends -> Owner<S> {
    Owner::<S> { value: __domain_create(module(), "", pack(input)) }
}
#intrinsic("domain.read_from")
pub fn read_from<S, R>(handle: ReadHandle<S>, operation: fn(&S) -> R) @suspends -> Result<R,DomainAccessError> {
    finish_value::<Unit,R>(module(),handle.token,handle.token,1,"",{})
}
#intrinsic("domain.write_to")
pub fn write_to<S, A, R>(handle: WriteHandle<S>, operation: fn(&mut S, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),handle.token,handle.token,1,"",input)
}
#intrinsic("domain.finish_request")
fn finish_request<R>(module: domain.Module, token: domain.Handle, name: String, input: UInt64) @suspends -> Result<R, RequestError> {
    let (status, bits) = __domain_request(module, token, name, input)
    if status == 0 { return Result.Ok(unpack::<R>(bits)) }
    if status == 1 { return Result.Err(RequestError.Failed) }
    if status == 2 { return Result.Err(RequestError.Cancelled) }
    if status == 3 { return Result.Err(RequestError.Closed) }
    if status == 4 { return Result.Err(RequestError.ResourceLimit) }
    if status == 5 { return Result.Err(RequestError.InvalidAccess) }
    Result.Err(RequestError.DomainFailed)
}
#intrinsic("domain.request")
pub fn request<S, A, R>(handle: WriteHandle<S>, operation: fn(A) @suspends -> R, input: A) @suspends -> Result<R, RequestError> {
    finish_request::<R>(module(), handle.token, "", pack(input))
}
#intrinsic("domain.request_read")
pub fn request_read<S, A, R>(handle: ReadHandle<S>, operation: fn(A) @suspends -> R, input: A) @suspends -> Result<R, RequestError> {
    finish_request::<R>(module(), handle.token, "", pack(input))
}

// Candidate construction consumes the snapshot and its complete, opaque read set.
extern fn __domain_candidate(module: domain.Module, snapshot: &domain.SnapshotOwner, name: String, input: UInt64) @suspends -> domain.CandidateOwner
extern fn __domain_commit(handle: domain.Handle, candidate: &mut domain.CandidateOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_wait(receipt: &mut domain.CommitOwner) @suspends -> Int32
extern fn __domain_commit_revision(receipt: &domain.CommitOwner) @suspends -> UInt64
extern fn __domain_commit_identity(receipt: &domain.CommitOwner) @suspends -> UInt64
extern fn __domain_commit_cancel(receipt: &domain.CommitOwner) @suspends
pub struct Candidate<S> { storage: domain.CandidateOwner }
pub struct CommitReceipt { storage: domain.CommitOwner }
// Deadlines use the creating executor's monotonic clock, not wall time.
extern fn __domain_deadline_after(milliseconds: Int32) @suspends -> domain.DeadlineOwner
extern fn __domain_commit_before(handle: domain.Handle, candidate: &mut domain.CandidateOwner, deadline: &domain.DeadlineOwner) @suspends -> domain.CommitOwner
pub struct CommitDeadline { storage: domain.DeadlineOwner }
pub fn deadline_after(milliseconds: Int32) @suspends -> CommitDeadline {
    CommitDeadline { storage: __domain_deadline_after(milliseconds) }
}
pub enum CommitOutcome { Committed(UInt64), Conflict, Closed, DomainFailed, InvalidAccess, Cancelled, ResourceLimit, Expired, OutboxFull, OutboxClosed }
#intrinsic("domain.finish_candidate")
fn finish_candidate<S, R>(module: domain.Module, snapshot: Snapshot<S, R>, name: String, input: UInt64) @suspends -> Candidate<S> {
    Candidate::<S> { storage: __domain_candidate(module, &snapshot.storage, name, input) }
}
#intrinsic("domain.candidate_from")
pub fn candidate_from<S, R, A>(snapshot: Snapshot<S, R>, constructor: fn(A) -> S, input: A) @suspends -> Candidate<S> {
    finish_candidate::<S, R>(module(), snapshot, "", pack(input))
}
pub fn commit_to<S>(handle: WriteHandle<S>, candidate: Candidate<S>) @suspends -> CommitReceipt {
    var storage = candidate.storage
    CommitReceipt { storage: __domain_commit(handle.token, &mut storage) }
}
pub fn commit_before<S>(handle: WriteHandle<S>, candidate: Candidate<S>, deadline: &CommitDeadline) @suspends -> CommitReceipt {
    var storage = candidate.storage
    CommitReceipt { storage: __domain_commit_before(handle.token, &mut storage, &deadline.storage) }
}
impl CommitReceipt {
    pub fn wait(&mut self) @suspends -> CommitOutcome {
        let status = __domain_commit_wait(&mut self.storage)
        if status == 0 { return CommitOutcome.Committed(__domain_commit_revision(&self.storage)) }
        if status == 1 { return CommitOutcome.Conflict }
        if status == 2 { return CommitOutcome.Closed }
        if status == 3 { return CommitOutcome.DomainFailed }
        if status == 4 { return CommitOutcome.InvalidAccess }
        if status == 5 { return CommitOutcome.Cancelled }
        if status == 7 { return CommitOutcome.Expired }
        if status == 8 { return CommitOutcome.OutboxFull }
        if status == 9 { return CommitOutcome.OutboxClosed }
        CommitOutcome.ResourceLimit
    }
    pub fn identity(&self) @suspends -> UInt64 { __domain_commit_identity(&self.storage) }
    pub fn cancel(&self) @suspends { __domain_commit_cancel(&self.storage) }
}

// Pair operations acquire their entire access set in one synchronous turn.
extern fn __domain_pair(module: domain.Module, first: domain.Handle, second: domain.Handle, name: String, input: UInt64) @suspends -> (Int32, UInt64)
#intrinsic("domain.read_pair")
pub fn read_pair<S, T, R>(first: ReadHandle<S>, second: ReadHandle<T>, operation: fn(&S, &T) -> R) @suspends -> Result<R,DomainAccessError> {
    finish_value::<Unit,R>(module(),first.token,second.token,2,"",{})
}
#intrinsic("domain.update_pair")
pub fn update_pair<S, T, A, R>(first: ReadHandle<S>, second: WriteHandle<T>, operation: fn(&S, &mut T, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),first.token,second.token,2,"",input)
}
#intrinsic("domain.write_pair")
pub fn write_pair<S, T, A, R>(first: WriteHandle<S>, second: WriteHandle<T>, operation: fn(&mut S, &mut T, A) -> R, input: A) @suspends -> Result<R,DomainAccessError> {
    finish_value::<A,R>(module(),first.token,second.token,2,"",input)
}

// The first domain is the candidate target; both read dependencies stay opaque.
extern fn __domain_snapshot_pair(module: domain.Module, first: domain.Handle, second: domain.Handle, name: String) @suspends -> domain.SnapshotOwner
#intrinsic("domain.snapshot_pair")
pub fn snapshot_pair<S, T, R>(first: ReadHandle<S>, second: ReadHandle<T>, projection: fn(&S, &T) -> R) @suspends -> Snapshot<S, R> {
    Snapshot::<S, R> { storage: __domain_snapshot_pair(module(), first.token, second.token, "") }
}

// Extending a candidate consumes it and uses the second domain of its joint read set.
extern fn __domain_candidate_pair(module: domain.Module, first: &mut domain.CandidateOwner, name: String, input: UInt64) @suspends -> domain.CandidatePairOwner
extern fn __domain_commit_pair(first: domain.Handle, second: domain.Handle, candidates: &mut domain.CandidatePairOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_pair_before(first: domain.Handle, second: domain.Handle, candidates: &mut domain.CandidatePairOwner, deadline: &domain.DeadlineOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_second_revision(receipt: &domain.CommitOwner) @suspends -> UInt64
pub struct CandidatePair<S, T> { storage: domain.CandidatePairOwner }
pub struct PairCommitReceipt { storage: domain.CommitOwner }
pub enum PairCommitOutcome { Committed((UInt64, UInt64)), Conflict, Closed, DomainFailed, InvalidAccess, Cancelled, ResourceLimit, Expired, OutboxFull, OutboxClosed }
#intrinsic("domain.finish_candidate_pair")
fn finish_candidate_pair<S, T>(module: domain.Module, first: Candidate<S>, name: String, input: UInt64) @suspends -> CandidatePair<S, T> {
    var storage = first.storage
    CandidatePair::<S, T> { storage: __domain_candidate_pair(module, &mut storage, name, input) }
}
#intrinsic("domain.candidate_pair_from")
pub fn candidate_pair_from<S, T, A>(first: Candidate<S>, constructor: fn(A) -> T, input: A) @suspends -> CandidatePair<S, T> {
    finish_candidate_pair::<S, T>(module(), first, "", pack(input))
}
pub fn commit_pair_to<S, T>(first: WriteHandle<S>, second: WriteHandle<T>, candidates: CandidatePair<S, T>) @suspends -> PairCommitReceipt {
    var storage = candidates.storage
    PairCommitReceipt { storage: __domain_commit_pair(first.token, second.token, &mut storage) }
}
pub fn commit_pair_before<S, T>(first: WriteHandle<S>, second: WriteHandle<T>, candidates: CandidatePair<S, T>, deadline: &CommitDeadline) @suspends -> PairCommitReceipt {
    var storage = candidates.storage
    PairCommitReceipt { storage: __domain_commit_pair_before(first.token, second.token, &mut storage, &deadline.storage) }
}
impl PairCommitReceipt {
    pub fn wait(&mut self) @suspends -> PairCommitOutcome {
        let status = __domain_commit_wait(&mut self.storage)
        if status == 0 { return PairCommitOutcome.Committed((__domain_commit_revision(&self.storage), __domain_commit_second_revision(&self.storage))) }
        if status == 1 { return PairCommitOutcome.Conflict }
        if status == 2 { return PairCommitOutcome.Closed }
        if status == 3 { return PairCommitOutcome.DomainFailed }
        if status == 4 { return PairCommitOutcome.InvalidAccess }
        if status == 5 { return PairCommitOutcome.Cancelled }
        if status == 7 { return PairCommitOutcome.Expired }
        if status == 8 { return PairCommitOutcome.OutboxFull }
        if status == 9 { return PairCommitOutcome.OutboxClosed }
        PairCommitOutcome.ResourceLimit
    }
    pub fn identity(&self) @suspends -> UInt64 { __domain_commit_identity(&self.storage) }
    pub fn cancel(&self) @suspends { __domain_commit_cancel(&self.storage) }
}

// A bounded read set captures independent scalar roots in one executor turn.
extern fn __domain_access_set() @suspends -> domain.AccessSetOwner
extern fn __domain_access_include(set:&mut domain.AccessSetOwner,handle:domain.Handle) @suspends
extern fn __domain_snapshot_set(set:&mut domain.AccessSetOwner) @suspends -> domain.SnapshotSetOwner
extern fn __domain_set_read(module:domain.Module,snapshot:&domain.SnapshotSetOwner,handle:domain.Handle,name:String) @suspends -> UInt64
extern fn __domain_set_check(snapshot:&domain.SnapshotSetOwner) @suspends -> Int32
extern fn __domain_set_candidate(module:domain.Module,snapshot:&mut domain.SnapshotSetOwner,handle:domain.Handle,name:String,input:UInt64) @suspends -> domain.CandidateSetOwner
extern fn __domain_set_add(module:domain.Module,set:&mut domain.CandidateSetOwner,handle:domain.Handle,name:String,input:UInt64) @suspends -> domain.CandidateSetOwner
extern fn __domain_commit_set(set:&mut domain.CandidateSetOwner) @suspends -> domain.CommitOwner
extern fn __domain_commit_set_before(set:&mut domain.CandidateSetOwner,deadline:&domain.DeadlineOwner) @suspends -> domain.CommitOwner
extern fn __domain_set_revision(receipt:&domain.CommitOwner,handle:domain.Handle) @suspends -> UInt64
pub struct AccessSet { storage:domain.AccessSetOwner }
pub struct SnapshotSet { storage:domain.SnapshotSetOwner }
pub struct CandidateSet { storage:domain.CandidateSetOwner }
pub struct SetCommitReceipt { storage:domain.CommitOwner }
pub enum SetCommitOutcome { Committed, Conflict, Closed, DomainFailed, InvalidAccess, Cancelled, ResourceLimit, Expired, OutboxFull, OutboxClosed }
pub fn access_set() @suspends -> AccessSet { AccessSet{storage:__domain_access_set()} }
impl AccessSet {
    pub fn include<S>(&mut self,handle:ReadHandle<S>) @suspends { include_handle(self,handle.token) }
}
pub fn snapshot_set(set:AccessSet) @suspends -> SnapshotSet {
    var storage=set.storage
    SnapshotSet{storage:__domain_snapshot_set(&mut storage)}
}
fn include_handle(set:&mut AccessSet,handle:domain.Handle) @suspends { __domain_access_include(&mut set.storage,handle) }
fn read_snapshot_bits(snapshot:&SnapshotSet,handle:domain.Handle) @suspends -> UInt64 { __domain_set_read(module(),&snapshot.storage,handle,"") }
#intrinsic("domain.read_snapshot")
pub fn read_snapshot<S,R>(snapshot:&SnapshotSet,handle:ReadHandle<S>,projection:fn(&S)->R) @suspends -> R {
    unpack::<R>(read_snapshot_bits(snapshot,handle.token))
}
impl SnapshotSet {
    pub fn check(&self) @suspends -> SnapshotStatus {
        let status=__domain_set_check(&self.storage)
        if status==0 { return SnapshotStatus.Current }
        if status==1 { return SnapshotStatus.Conflict }
        if status==2 { return SnapshotStatus.Closed }
        if status==3 { return SnapshotStatus.DomainFailed }
        SnapshotStatus.InvalidAccess
    }
}
#intrinsic("domain.finish_set_candidate")
fn finish_set_candidate(module:domain.Module,snapshot:SnapshotSet,handle:domain.Handle,name:String,input:UInt64) @suspends -> CandidateSet {
    var storage=snapshot.storage
    CandidateSet{storage:__domain_set_candidate(module,&mut storage,handle,name,input)}
}
#intrinsic("domain.finish_set_add")
fn finish_set_add(module:domain.Module,set:CandidateSet,handle:domain.Handle,name:String,input:UInt64) @suspends -> CandidateSet {
    var storage=set.storage
    CandidateSet{storage:__domain_set_add(module,&mut storage,handle,name,input)}
}
#intrinsic("domain.candidate_set_from")
pub fn candidate_set_from<S,A>(snapshot:SnapshotSet,handle:WriteHandle<S>,constructor:fn(A)->S,input:A) @suspends -> CandidateSet {
    finish_set_candidate(module(),snapshot,handle.token,"",pack(input))
}
#intrinsic("domain.candidate_set_add")
pub fn candidate_set_add<S,A>(set:CandidateSet,handle:WriteHandle<S>,constructor:fn(A)->S,input:A) @suspends -> CandidateSet {
    finish_set_add(module(),set,handle.token,"",pack(input))
}
pub fn commit_set(set:CandidateSet) @suspends -> SetCommitReceipt {
    var storage=set.storage
    SetCommitReceipt{storage:__domain_commit_set(&mut storage)}
}
pub fn commit_set_before(set:CandidateSet,deadline:&CommitDeadline) @suspends -> SetCommitReceipt {
    var storage=set.storage
    SetCommitReceipt{storage:__domain_commit_set_before(&mut storage,&deadline.storage)}
}
impl SetCommitReceipt {
    pub fn wait(&mut self) @suspends -> SetCommitOutcome {
        let status=__domain_commit_wait(&mut self.storage)
        if status==0 { return SetCommitOutcome.Committed }
        if status==1 { return SetCommitOutcome.Conflict }
        if status==2 { return SetCommitOutcome.Closed }
        if status==3 { return SetCommitOutcome.DomainFailed }
        if status==4 { return SetCommitOutcome.InvalidAccess }
        if status==5 { return SetCommitOutcome.Cancelled }
        if status==7 { return SetCommitOutcome.Expired }
        if status==8 { return SetCommitOutcome.OutboxFull }
        if status==9 { return SetCommitOutcome.OutboxClosed }
        SetCommitOutcome.ResourceLimit
    }
    pub fn revision<S>(&self,handle:ReadHandle<S>) @suspends -> UInt64 { set_revision(self,handle.token) }
    pub fn identity(&self) @suspends -> UInt64 { __domain_commit_identity(&self.storage) }
    pub fn cancel(&self) @suspends { __domain_commit_cancel(&self.storage) }
}

fn set_revision(receipt:&SetCommitReceipt,handle:domain.Handle) @suspends -> UInt64 { __domain_set_revision(&receipt.storage,handle) }

// Attaching consumes the batch. Only candidate commits can publish its messages.
extern fn __outbox_attach(candidate:&mut domain.CandidateOwner, batch:&mut outbox.BatchOwner) @suspends
extern fn __outbox_attach_pair(candidate:&mut domain.CandidatePairOwner, batch:&mut outbox.BatchOwner) @suspends
extern fn __outbox_attach_set(candidate:&mut domain.CandidateSetOwner, batch:&mut outbox.BatchOwner) @suspends
pub fn with_outbox<S>(candidate:Candidate<S>, batch:Batch) @suspends -> Candidate<S> {
    var candidate=candidate
    var batch=batch
    __outbox_attach(&mut candidate.storage,&mut batch)
    candidate
}
pub fn pair_with_outbox<S,T>(candidate:CandidatePair<S,T>, batch:Batch) @suspends -> CandidatePair<S,T> {
    var candidate=candidate
    var batch=batch
    __outbox_attach_pair(&mut candidate.storage,&mut batch)
    candidate
}
pub fn set_with_outbox(candidate:CandidateSet, batch:Batch) @suspends -> CandidateSet {
    var candidate=candidate
    var batch=batch
    __outbox_attach_set(&mut candidate.storage,&mut batch)
    candidate
}

// Directories own bounded routing storage, never the addressed domains or code.
extern fn __directory_create(capacity:UInt64) @suspends -> domain.DirectoryOwner
extern fn __directory_handle(owner:&domain.DirectoryOwner) @suspends -> UInt64
extern fn __directory_close(directory:UInt64) @suspends
extern fn __directory_insert(directory:UInt64, key:UInt64, target:domain.Handle) @suspends -> Int32
extern fn __directory_replace(directory:UInt64, key:UInt64, expected:domain.Handle, target:domain.Handle) @suspends -> Int32
extern fn __directory_remove(directory:UInt64, key:UInt64, expected:domain.Handle) @suspends -> Bool
extern fn __directory_lookup(module:domain.Module, directory:UInt64, key:UInt64, operation:String, writable:Bool) @suspends -> domain.Handle
extern fn __directory_found(target:domain.Handle) @suspends -> Bool

pub struct Directory { storage:domain.DirectoryOwner }
// A flat, non-owning capability suitable for AOT/Script entry contracts.
pub struct DirectoryHandle { identity:UInt64 }
pub enum DirectoryError { Closed, Full, Occupied, InvalidTarget, Conflict }
pub fn directory(capacity:UInt64) @suspends -> Directory {
    Directory { storage:__directory_create(capacity) }
}
impl Directory {
    pub fn handle(&self) @suspends -> DirectoryHandle {
        DirectoryHandle { identity:__directory_handle(&self.storage) }
    }
    pub fn close(self) @suspends { __directory_close(self.handle().identity) }
}
fn directory_status(status:Int32) -> Result<Unit,DirectoryError> {
    if status==0 { return Result.Ok({}) }
    if status==1 { return Result.Err(DirectoryError.Closed) }
    if status==2 { return Result.Err(DirectoryError.Full) }
    if status==3 { return Result.Err(DirectoryError.Occupied) }
    if status==4 { return Result.Err(DirectoryError.InvalidTarget) }
    Result.Err(DirectoryError.Conflict)
}
impl DirectoryHandle {
    pub fn insert<S>(self, key:UInt64, target:WriteHandle<S>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_insert(self.identity,key,target.token))
    }
    pub fn insert_read<S>(self, key:UInt64, target:ReadHandle<S>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_insert(self.identity,key,target.token))
    }
    pub fn replace<S,T>(self, key:UInt64, expected:ReadHandle<S>, target:WriteHandle<T>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_replace(self.identity,key,expected.token,target.token))
    }
    pub fn replace_read<S,T>(self, key:UInt64, expected:ReadHandle<S>, target:ReadHandle<T>) @suspends -> Result<Unit,DirectoryError> {
        directory_status(__directory_replace(self.identity,key,expected.token,target.token))
    }
    // Comparing identity prevents stale connection cleanup from deleting a new route.
    pub fn remove<S>(self, key:UInt64, expected:ReadHandle<S>) @suspends -> Bool {
        __directory_remove(self.identity,key,expected.token)
    }
}
// Specialization supplies checked state metadata without a user operation.
// The private witness is never invoked and does not borrow a live root.
#intrinsic("domain.lookup_type")
fn lookup_type<S>() -> String;
#intrinsic("domain.lookup_witness")
fn lookup_witness<S>(state: &S) {}
pub fn lookup<S>(directory:DirectoryHandle, key:UInt64) @suspends -> Option<ReadHandle<S>> {
    finish_lookup::<S>(module(),directory.identity,key,lookup_type::<S>())
}
pub fn lookup_write<S>(directory:DirectoryHandle, key:UInt64) @suspends -> Option<WriteHandle<S>> {
    finish_lookup_write::<S>(module(),directory.identity,key,lookup_type::<S>())
}
fn finish_lookup<S>(module:domain.Module, directory:UInt64, key:UInt64, operation:String) @suspends -> Option<ReadHandle<S>> {
    let token=__directory_lookup(module,directory,key,operation,false)
    if __directory_found(token) { Option.Some(ReadHandle::<S>{token:token}) } else { Option.None }
}
fn finish_lookup_write<S>(module:domain.Module, directory:UInt64, key:UInt64, operation:String) @suspends -> Option<WriteHandle<S>> {
    let token=__directory_lookup(module,directory,key,operation,true)
    if __directory_found(token) { Option.Some(WriteHandle::<S>{token:token}) } else { Option.None }
}

// A timer owner is independent of the Script invocation that arms it.
extern fn __timer_create() @suspends -> domain.TimerOwner
extern fn __timer_handle(owner:&domain.TimerOwner) @suspends -> UInt64
extern fn __timer_close(timer:UInt64) @suspends
extern fn __timer_cancel(timer:UInt64) @suspends
extern fn __timer_status(timer:UInt64) @suspends -> Int32
extern fn __timer_start(module:domain.Module, timer:UInt64, target:domain.Handle, milliseconds:Int32, operation:String, input:UInt64, periodic:Bool) @suspends -> Int32
pub struct Timer { storage:domain.TimerOwner }
pub struct TimerHandle { identity:UInt64 }
pub enum TimerStatus { Idle, Active, Completed, Cancelled, Closed, InvalidAccess, ResourceLimit, Failed }
pub enum TimerError { Closed, Busy, InvalidDelay, InvalidAccess, ResourceLimit }
pub fn timer() @suspends -> Timer { Timer{storage:__timer_create()} }
impl Timer {
    pub fn handle(&self) @suspends -> TimerHandle { TimerHandle{identity:__timer_handle(&self.storage)} }
    pub fn close(self) @suspends { __timer_close(self.handle().identity) }
}
impl TimerHandle {
    pub fn cancel(self) @suspends { __timer_cancel(self.identity) }
    pub fn status(self) @suspends -> TimerStatus {
        let status=__timer_status(self.identity)
        if status==0 { return TimerStatus.Idle }
        if status==1 { return TimerStatus.Active }
        if status==2 { return TimerStatus.Completed }
        if status==3 { return TimerStatus.Cancelled }
        if status==4 { return TimerStatus.Closed }
        if status==5 { return TimerStatus.InvalidAccess }
        if status==6 { return TimerStatus.ResourceLimit }
        TimerStatus.Failed
    }
}
#intrinsic("domain.finish_timer")
fn finish_timer(module:domain.Module, timer:UInt64, target:domain.Handle, milliseconds:Int32, operation:String, input:UInt64, periodic:Bool) @suspends -> Result<Unit,TimerError> {
    let status=__timer_start(module,timer,target,milliseconds,operation,input,periodic)
    if status==0 { return Result.Ok({}) }
    if status==1 { return Result.Err(TimerError.Closed) }
    if status==2 { return Result.Err(TimerError.Busy) }
    if status==3 { return Result.Err(TimerError.InvalidDelay) }
    if status==4 { return Result.Err(TimerError.InvalidAccess) }
    Result.Err(TimerError.ResourceLimit)
}
#intrinsic("domain.after")
pub fn after<S,A>(timer:TimerHandle, target:WriteHandle<S>, milliseconds:Int32, operation:fn(&mut S,A)->Unit, input:A) @suspends -> Result<Unit,TimerError> {
    finish_timer(module(),timer.identity,target.token,milliseconds,"",pack(input),false)
}
#intrinsic("domain.every")
pub fn every<S,A>(timer:TimerHandle, target:WriteHandle<S>, milliseconds:Int32, operation:fn(&mut S,A)->Unit, input:A) @suspends -> Result<Unit,TimerError> {
    finish_timer(module(),timer.identity,target.token,milliseconds,"",pack(input),true)
}
