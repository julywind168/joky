//! The `Drop` trait for resource cleanup.
//!
//! Implement `Drop` for synchronous cleanup when an owning value leaves scope.
//! Fields are cleaned up after the hook. Use an explicit suspending close method
//! for cleanup that must wait for I/O.
//!
//! ```joky
//! import joky/drop.{type Drop}
//! import joky/mem
//!
//! struct Notice { name: String }
//! impl Drop for Notice {
//!     fn drop(&mut self) {
//!         println("closing {self.name}")
//!     }
//! }
//!
//! fn main() {
//!     let notice = Notice { name: "example" }
//!     mem.drop(notice)
//! }
//! ```

/// Compiler-recognized synchronous destruction hook. Fields are cleaned afterward.
pub trait Drop {
    fn drop(&mut self)
}
