//! Optional values and transformations that preserve absence.
//!
//! An option owns either a value (`Some`) or no value (`None`). Transformations
//! consume the option; queries such as `is_some` only borrow it. Use lazy
//! fallbacks when computing a default is expensive or has side effects.
//!
//! ```joky
//! fn main() {
//!     let answer = Some(21).map(
//!         |n| {
//!             n * 2
//!         }
//!     )
//!     assert_eq(answer.unwrap(), 42)
//!     println(answer.unwrap())
//! }
//! ```

import joky/mem
import joky/check

/// The standard optional value. Qualified and imported constructors
/// retain the enum's nominal identity.
pub enum Option<T> { None, Some(T) }

impl<T> Option<T> {
    /// An explicit assertion for callers that consider absence a task failure.
    pub fn unwrap(self) -> T {
        match self {
            Some(value) => value
            None => {
                check.panic("Called Option.unwrap on None")
            }
        }
    }

    /// Returns the value, or fails with the supplied message.
    pub fn expect(self, message: &String) @noescape(message) -> T {
        match self {
            Some(value) => value
            None => {
                check.panic(message)
            }
        }
    }

    /// Replaces this option with `None` and returns its previous value.
    pub fn take(&mut self) -> Option<T> {
        mem.replace(self, None)
    }

    /// Transforms the contained value; `None` skips the callback.
    pub fn map<U, F: FnOnce(T) -> U>(self, transform: F) -> Option<U> {
        match self {
            None => None,
            Some(value) => Some(transform(value))
        }
    }

    /// Calls a transformation that can itself return `None`.
    pub fn and_then<U, F: FnOnce(T) -> Option<U>>(self, transform: F) -> Option<U> {
        match self {
            None => None,
            Some(value) => transform(value)
        }
    }

    /// Transforms the value, or returns the eagerly evaluated fallback.
    pub fn map_or<U, F: FnOnce(T) -> U>(self, fallback: U, transform: F) @noescape(transform) -> U {
        match self {
            Some(value) => transform(value),
            None => fallback
        }
    }

    /// Keeps the value only when the borrowed predicate returns true.
    pub fn filter<F: FnOnce(&T) @noescape -> Bool>(
        self,
        predicate: F
    ) @noescape(predicate) -> Self {
        match self {
            Some(value) => if predicate(&value) {
                Some(value)
            } else {
                None
            }
            None => None
        }
    }

    /// Tests the contained value, returning false for `None`.
    pub fn is_some_and<F: FnOnce(&T) @noescape -> Bool>(
        self,
        predicate: F
    ) @noescape(predicate) -> Bool {
        match self {
            Some(value) => predicate(&value),
            None => false
        }
    }

    /// Returns true when a value is present.
    pub fn is_some(&self) -> Bool {
        self is Some(_)
    }

    /// Returns true when no value is present.
    pub fn is_none(&self) -> Bool {
        self is None
    }

    /// Only the missing branch invokes the consuming callback.
    pub fn unwrap_or_else<F: FnOnce() -> T>(self, fallback: F) -> T {
        match self {
            None => fallback(),
            Some(value) => value
        }
    }

    /// The fallback is evaluated even when this option already contains a value.
    pub fn unwrap_or(self, fallback: T) -> T {
        match self {
            None => fallback,
            Some(value) => value
        }
    }

    /// Returns the next option when this option contains a value.
    pub fn and<U>(self, next: Option<U>) -> Option<U> {
        match self {
            None => None,
            Some(_) => next
        }
    }

    /// Returns this option when present, otherwise the fallback.
    pub fn or(self, fallback: Self) -> Self {
        match self {
            None => fallback,
            Some(value) => Some(value)
        }
    }

    /// Both operands are evaluated before this ordinary by-value method call.
    pub fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {
        let left = match self {
            None => return None
            Some(value) => value
        }
        let right = match other {
            None => return None
            Some(value) => value
        }
        Some((left, right))
    }
}

impl<T> Option<Option<T>> {
    /// Removes one layer of optional wrapping.
    pub fn flatten(self) -> Option<T> {
        match self {
            Some(value) => value,
            None => None
        }
    }
}
