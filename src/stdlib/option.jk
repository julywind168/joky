// The standard optional value. Constructors are provided by the enum
// namespace, so both Option.Some and imported Some retain enum identity.
enum Option<T> { None Some(T) }

impl<T> Option<T> {
    fn map<U>(self, transform: fn(T) -> U) -> Option<U> {
        match self { | None => Option.None | Some(value) => Option.Some(transform(value)) }
    }

    fn and_then<U>(self, transform: fn(T) -> Option<U>) -> Option<U> {
        match self { | None => Option.None | Some(value) => transform(value) }
    }

    fn is_some(self) -> Bool {
        match self { | None => false | Some(_) => true }
    }

    fn is_none(self) -> Bool {
        match self { | None => true | Some(_) => false }
    }

    // The fallback is evaluated even when this option already contains a value.
    fn unwrap_or(self, fallback: T) -> T {
        match self { | None => fallback | Some(value) => value }
    }

    fn and<U>(self, next: Option<U>) -> Option<U> {
        match self { | None => Option.None | Some(_) => next }
    }

    fn or(self, fallback: Self) -> Self {
        match self { | None => fallback | Some(value) => Option.Some(value) }
    }

    // Both operands are evaluated before this ordinary by-value method call.
    fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {
        let left = match self {
            | None => return Option.None
            | Some(value) => value
        }
        let right = match other {
            | None => return Option.None
            | Some(value) => value
        }
        Option.Some((left, right))
    }
}
