import joky/mem

// The standard optional value. Qualified and imported constructors
// retain the enum's nominal identity.
enum Option<T> { None, Some(T) }

impl<T> Option<T> {
    fn take(&mut self) -> Option<T> { mem.replace(self, None) }

    fn map<U, F: FnOnce(T) -> U>(self, transform: F) -> Option<U> {
        match self { None => None, Some(value) => Some(transform(value)) }
    }

    fn and_then<U, F: FnOnce(T) -> Option<U>>(self, transform: F) -> Option<U> {
        match self { None => None, Some(value) => transform(value) }
    }

    fn is_some(&self) -> Bool {
        match self { None => false, Some(_) => true }
    }

    fn is_none(&self) -> Bool {
        match self { None => true, Some(_) => false }
    }

    // Only the missing branch invokes the consuming callback.
    fn unwrap_or_else<F: FnOnce() -> T>(self, fallback: F) -> T {
        match self { None => fallback(), Some(value) => value }
    }

    // The fallback is evaluated even when this option already contains a value.
    fn unwrap_or(self, fallback: T) -> T {
        match self { None => fallback, Some(value) => value }
    }

    fn and<U>(self, next: Option<U>) -> Option<U> {
        match self { None => None, Some(_) => next }
    }

    fn or(self, fallback: Self) -> Self {
        match self { None => fallback, Some(value) => Some(value) }
    }

    // Both operands are evaluated before this ordinary by-value method call.
    fn zip<U>(self, other: Option<U>) -> Option<(T, U)> {
        let left = match self {
            None => return None
            Some(value) => value
        }
        let right = match other {
            None => return None
            Some(value) => value
        }
        Some((left, right))
    }
}
