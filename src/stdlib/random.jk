import joky/array.{ type Array }
import joky/internal/buffer
import joky/result.{ type Result, Ok, Err }
import joky/option.{ type Option, Some, None }
import joky/check

pub enum RandomError { Unavailable }

// OS entropy only. No partially filled array escapes a failed request.
pub fn secure_bytes(length: UInt64) -> Result<Array<UInt8>, RandomError> {
    var bytes = Array.with_capacity::<UInt8>(length)
    var i: UInt64 = 0
    while i < length { bytes.push(0); i += 1 }
    if buffer.random_fill(bytes.slice_mut(0, length)) { Ok(bytes) }
    else { Err(RandomError.Unavailable) }
}

// xoshiro256++ 1.0, seeded by four consecutive SplitMix64 outputs.
// Public-domain reference: https://prng.di.unimi.it/xoshiro256plusplus.c
// This generator is reproducible, not cryptographically secure.
pub struct Rng { a: UInt64, b: UInt64, c: UInt64, d: UInt64 }
fn seed_word(state: &mut UInt64) -> UInt64 {
    *state = *state + 0x9e3779b97f4a7c15
    var word = *state
    word = (word ^ (word >> 30)) * 0xbf58476d1ce4e5b9
    word = (word ^ (word >> 27)) * 0x94d049bb133111eb
    word ^ (word >> 31)
}
fn rotate(word: UInt64, count: UInt64) -> UInt64 {(word << count) | (word >> (64 - count)) }
impl Rng {
    pub fn seeded(var seed: UInt64) -> Rng {
        let a = seed_word(&mut seed)
        let b = seed_word(&mut seed)
        let c = seed_word(&mut seed)
        let d = seed_word(&mut seed)
        Rng { a: a, b: b, c: c, d: d }
    }
    pub fn next_u64(&mut self) -> UInt64 {
        let result = rotate(self.a + self.d, 23) + self.a
        let shifted = self.b << 17
        self.c = self.c ^ self.a
        self.d = self.d ^ self.b
        self.b = self.b ^ self.c
        self.a = self.a ^ self.d
        self.c = self.c ^ shifted
        self.d = rotate(self.d, 45)
        result
    }
    // Empty or reversed half-open ranges do not consume generator state.
    pub fn range(&mut self, lower: UInt64, upper: UInt64) -> Option<UInt64> {
        if lower >= upper { return None }
        let width = upper - lower
        // UInt64 arithmetic wraps: 2^64 mod width, without representing 2^64.
        let threshold = (0 - width) % width
        while true {
            let value = self.next_u64()
            if value >= threshold { return Some(lower + value % width) }
        }
    }
}

// Fisher-Yates exchanges whole elements, preserving owning payloads.
pub fn shuffle<T>(rng: &mut Rng, values: &mut Array<T>) {
    var remaining = values.len()
    while remaining > 1 {
        let index = match rng.range(0, remaining) {
            Some(value) => value
            None => check.panic("Invalid shuffle range")
        }
        remaining -= 1
        values.swap(remaining, index)
    }
}
