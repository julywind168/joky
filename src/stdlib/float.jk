import joky/option.{type Option, Some, None}

// Backend-shared IEEE primitives. These private definitions are bound by
// annotation in this embedded module; the compiler supplies their implementation.
#intrinsic("float.sqrt")
fn float64_sqrt(v: Float64) -> Float64;
#intrinsic("float.floor")
fn float64_floor(v: Float64) -> Float64;
#intrinsic("float.ceil")
fn float64_ceil(v: Float64) -> Float64;
#intrinsic("float.trunc")
fn float64_trunc(v: Float64) -> Float64;
#intrinsic("float.round_ties_even")
fn float64_round(v: Float64) -> Float64;
#intrinsic("float.to_bits")
fn float64_to_bits(v: Float64) -> UInt64;
#intrinsic("float.from_bits")
fn float64_from_bits(bits: UInt64) -> Float64;
#intrinsic("float.to_text")
fn float64_to_text(v: Float64) -> String;
#intrinsic("float.int_from_valid")
fn i8_from_valid_f64(v: Float64) -> Int8;
#intrinsic("float.int_from_valid")
fn i16_from_valid_f64(v: Float64) -> Int16;
#intrinsic("float.int_from_valid")
fn i32_from_valid_f64(v: Float64) -> Int32;
#intrinsic("float.int_from_valid")
fn i64_from_valid_f64(v: Float64) -> Int64;
#intrinsic("float.int_from_valid")
fn u8_from_valid_f64(v: Float64) -> UInt8;
#intrinsic("float.int_from_valid")
fn u16_from_valid_f64(v: Float64) -> UInt16;
#intrinsic("float.int_from_valid")
fn u32_from_valid_f64(v: Float64) -> UInt32;
#intrinsic("float.int_from_valid")
fn u64_from_valid_f64(v: Float64) -> UInt64;

#intrinsic("float.sqrt")
fn float32_sqrt(v: Float32) -> Float32;
#intrinsic("float.floor")
fn float32_floor(v: Float32) -> Float32;
#intrinsic("float.ceil")
fn float32_ceil(v: Float32) -> Float32;
#intrinsic("float.trunc")
fn float32_trunc(v: Float32) -> Float32;
#intrinsic("float.round_ties_even")
fn float32_round(v: Float32) -> Float32;
#intrinsic("float.to_bits")
fn float32_to_bits(v: Float32) -> UInt32;
#intrinsic("float.from_bits")
fn float32_from_bits(bits: UInt32) -> Float32;
#intrinsic("float.to_text")
fn float32_to_text(v: Float32) -> String;
#intrinsic("float.int_from_valid")
fn i8_from_valid_f32(v: Float32) -> Int8;
#intrinsic("float.int_from_valid")
fn i16_from_valid_f32(v: Float32) -> Int16;
#intrinsic("float.int_from_valid")
fn i32_from_valid_f32(v: Float32) -> Int32;
#intrinsic("float.int_from_valid")
fn i64_from_valid_f32(v: Float32) -> Int64;
#intrinsic("float.int_from_valid")
fn u8_from_valid_f32(v: Float32) -> UInt8;
#intrinsic("float.int_from_valid")
fn u16_from_valid_f32(v: Float32) -> UInt16;
#intrinsic("float.int_from_valid")
fn u32_from_valid_f32(v: Float32) -> UInt32;
#intrinsic("float.int_from_valid")
fn u64_from_valid_f32(v: Float32) -> UInt64;

// Checked bounds are exact powers of two, so a float comparison decides
// precisely even where an integer limit is not representable; NaN and the
// infinities fail every bound and map to None. Values in [-1, 0) round or
// truncate to negative zero and are accepted as zero for unsigned targets.
impl Float64 {
    const INFINITY: Float64 = 1.0 / 0.0
    const NAN: Float64 = 0.0 / 0.0

    fn is_nan(self) -> Bool { self != self }
    fn is_finite(self) -> Bool {
        self > -Float64.INFINITY && self < Float64.INFINITY
    }
    fn abs(self) -> Float64 {
        if self < 0.0 { return -self }
        if self == 0.0 { return 0.0 }
        self
    }
    fn sqrt(self) -> Float64 { float64_sqrt(self) }
    fn floor(self) -> Float64 { float64_floor(self) }
    fn ceil(self) -> Float64 { float64_ceil(self) }
    fn trunc(self) -> Float64 { float64_trunc(self) }
    fn round(self) -> Float64 { float64_round(self) }
    fn to_bits(self) -> UInt64 { float64_to_bits(self) }
    fn from_bits(bits: UInt64) -> Float64 { float64_from_bits(bits) }
    fn to_text(self) -> String { float64_to_text(self) }

    fn trunc_to_i8(self) -> Option<Int8> {
        let t = self.trunc()
        if t >= -128.0 && t < 128.0 { Some(i8_from_valid_f64(t)) } else { None }
    }
    fn round_to_i8(self) -> Option<Int8> {
        let r = self.round()
        if r >= -128.0 && r < 128.0 { Some(i8_from_valid_f64(r)) } else { None }
    }
    fn trunc_to_i16(self) -> Option<Int16> {
        let t = self.trunc()
        if t >= -32768.0 && t < 32768.0 { Some(i16_from_valid_f64(t)) } else { None }
    }
    fn round_to_i16(self) -> Option<Int16> {
        let r = self.round()
        if r >= -32768.0 && r < 32768.0 { Some(i16_from_valid_f64(r)) } else { None }
    }
    fn trunc_to_i32(self) -> Option<Int32> {
        let t = self.trunc()
        if t >= -2147483648.0 && t < 2147483648.0 { Some(i32_from_valid_f64(t)) } else { None }
    }
    fn round_to_i32(self) -> Option<Int32> {
        let r = self.round()
        if r >= -2147483648.0 && r < 2147483648.0 { Some(i32_from_valid_f64(r)) } else { None }
    }
    fn trunc_to_i64(self) -> Option<Int64> {
        let t = self.trunc()
        if t >= -9223372036854775808.0 && t < 9223372036854775808.0 {
            Some(i64_from_valid_f64(t))
        } else {
            None
        }
    }
    fn round_to_i64(self) -> Option<Int64> {
        let r = self.round()
        if r >= -9223372036854775808.0 && r < 9223372036854775808.0 {
            Some(i64_from_valid_f64(r))
        } else {
            None
        }
    }
    fn trunc_to_u8(self) -> Option<UInt8> {
        let t = self.trunc()
        if t >= 0.0 && t < 256.0 { Some(u8_from_valid_f64(t)) } else { None }
    }
    fn round_to_u8(self) -> Option<UInt8> {
        let r = self.round()
        if r >= 0.0 && r < 256.0 { Some(u8_from_valid_f64(r)) } else { None }
    }
    fn trunc_to_u16(self) -> Option<UInt16> {
        let t = self.trunc()
        if t >= 0.0 && t < 65536.0 { Some(u16_from_valid_f64(t)) } else { None }
    }
    fn round_to_u16(self) -> Option<UInt16> {
        let r = self.round()
        if r >= 0.0 && r < 65536.0 { Some(u16_from_valid_f64(r)) } else { None }
    }
    fn trunc_to_u32(self) -> Option<UInt32> {
        let t = self.trunc()
        if t >= 0.0 && t < 4294967296.0 { Some(u32_from_valid_f64(t)) } else { None }
    }
    fn round_to_u32(self) -> Option<UInt32> {
        let r = self.round()
        if r >= 0.0 && r < 4294967296.0 { Some(u32_from_valid_f64(r)) } else { None }
    }
    fn trunc_to_u64(self) -> Option<UInt64> {
        let t = self.trunc()
        if t >= 0.0 && t < 18446744073709551616.0 {
            Some(u64_from_valid_f64(t))
        } else {
            None
        }
    }
    fn round_to_u64(self) -> Option<UInt64> {
        let r = self.round()
        if r >= 0.0 && r < 18446744073709551616.0 {
            Some(u64_from_valid_f64(r))
        } else {
            None
        }
    }
}

impl Float32 {
    const INFINITY: Float32 = 1.0 / 0.0
    const NAN: Float32 = 0.0 / 0.0

    fn is_nan(self) -> Bool { self != self }
    fn is_finite(self) -> Bool {
        self > -Float32.INFINITY && self < Float32.INFINITY
    }
    fn abs(self) -> Float32 {
        if self < 0.0 { return -self }
        if self == 0.0 { return 0.0 }
        self
    }
    fn sqrt(self) -> Float32 { float32_sqrt(self) }
    fn floor(self) -> Float32 { float32_floor(self) }
    fn ceil(self) -> Float32 { float32_ceil(self) }
    fn trunc(self) -> Float32 { float32_trunc(self) }
    fn round(self) -> Float32 { float32_round(self) }
    fn to_bits(self) -> UInt32 { float32_to_bits(self) }
    fn from_bits(bits: UInt32) -> Float32 { float32_from_bits(bits) }
    fn to_text(self) -> String { float32_to_text(self) }

    fn trunc_to_i8(self) -> Option<Int8> {
        let t = self.trunc()
        if t >= -128.0 && t < 128.0 { Some(i8_from_valid_f32(t)) } else { None }
    }
    fn round_to_i8(self) -> Option<Int8> {
        let r = self.round()
        if r >= -128.0 && r < 128.0 { Some(i8_from_valid_f32(r)) } else { None }
    }
    fn trunc_to_i16(self) -> Option<Int16> {
        let t = self.trunc()
        if t >= -32768.0 && t < 32768.0 { Some(i16_from_valid_f32(t)) } else { None }
    }
    fn round_to_i16(self) -> Option<Int16> {
        let r = self.round()
        if r >= -32768.0 && r < 32768.0 { Some(i16_from_valid_f32(r)) } else { None }
    }
    fn trunc_to_i32(self) -> Option<Int32> {
        let t = self.trunc()
        if t >= -2147483648.0 && t < 2147483648.0 { Some(i32_from_valid_f32(t)) } else { None }
    }
    fn round_to_i32(self) -> Option<Int32> {
        let r = self.round()
        if r >= -2147483648.0 && r < 2147483648.0 { Some(i32_from_valid_f32(r)) } else { None }
    }
    fn trunc_to_i64(self) -> Option<Int64> {
        let t = self.trunc()
        if t >= -9223372036854775808.0 && t < 9223372036854775808.0 {
            Some(i64_from_valid_f32(t))
        } else {
            None
        }
    }
    fn round_to_i64(self) -> Option<Int64> {
        let r = self.round()
        if r >= -9223372036854775808.0 && r < 9223372036854775808.0 {
            Some(i64_from_valid_f32(r))
        } else {
            None
        }
    }
    fn trunc_to_u8(self) -> Option<UInt8> {
        let t = self.trunc()
        if t >= 0.0 && t < 256.0 { Some(u8_from_valid_f32(t)) } else { None }
    }
    fn round_to_u8(self) -> Option<UInt8> {
        let r = self.round()
        if r >= 0.0 && r < 256.0 { Some(u8_from_valid_f32(r)) } else { None }
    }
    fn trunc_to_u16(self) -> Option<UInt16> {
        let t = self.trunc()
        if t >= 0.0 && t < 65536.0 { Some(u16_from_valid_f32(t)) } else { None }
    }
    fn round_to_u16(self) -> Option<UInt16> {
        let r = self.round()
        if r >= 0.0 && r < 65536.0 { Some(u16_from_valid_f32(r)) } else { None }
    }
    fn trunc_to_u32(self) -> Option<UInt32> {
        let t = self.trunc()
        if t >= 0.0 && t < 4294967296.0 { Some(u32_from_valid_f32(t)) } else { None }
    }
    fn round_to_u32(self) -> Option<UInt32> {
        let r = self.round()
        if r >= 0.0 && r < 4294967296.0 { Some(u32_from_valid_f32(r)) } else { None }
    }
    fn trunc_to_u64(self) -> Option<UInt64> {
        let t = self.trunc()
        if t >= 0.0 && t < 18446744073709551616.0 {
            Some(u64_from_valid_f32(t))
        } else {
            None
        }
    }
    fn round_to_u64(self) -> Option<UInt64> {
        let r = self.round()
        if r >= 0.0 && r < 18446744073709551616.0 {
            Some(u64_from_valid_f32(r))
        } else {
            None
        }
    }
}
