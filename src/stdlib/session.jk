//! Session state and lifecycle helpers.

import joky/shutdown
import joky/outbox
import joky/time.{type Duration}
import joky/task
import joky/result.{type Result, Ok, Err}
import joky/array.{type Array}
import joky/option.{type Option, Some, None}
import joky/tcp.{type TcpStream, type BufferedTcp, type BufferedTcpReader, type TcpWriter, type ReadError, type IoError}

pub struct Options {
    pub queue_messages: UInt64,
    pub queue_bytes: UInt64,
    pub idle_timeout: Duration
}
impl Options {
    pub fn default() -> Self {
        Options { queue_messages: 64, queue_bytes: 65536, idle_timeout: 0ns }
    }
}
// Copyable output endpoint; send stages bytes in when, close stops the session.
pub type Output = outbox.Handle
// A reader owns protocol state; each call returns one complete message or EOF.
// Cancellation terminates the session, so a partially consumed read is never retried.
pub trait Reader {
    type Message
    type Error
    fn read(&mut self, input: &mut BufferedTcpReader) @suspends @noescape -> Result<Option<Self.Message>, Self.Error>
}
pub struct Lines { pub max_bytes: UInt64 }
impl Lines {
    pub fn default() -> Self { Lines { max_bytes: 4096 } }
}
impl Reader for Lines {
    type Message = String
    type Error = ReadError
    fn read(&mut self, input: &mut BufferedTcpReader) @suspends @noescape -> Result<Option<String>, ReadError> {
        input.read_line(self.max_bytes)
    }
}
// Four-byte big-endian payload length, compatible with TcpWriter.write_message.
pub struct LengthPrefixed { pub max_bytes: UInt64 }
impl LengthPrefixed {
    pub fn default() -> Self { LengthPrefixed { max_bytes: 65536 } }
}
impl Reader for LengthPrefixed {
    type Message = Array<UInt8>
    type Error = ReadError
    fn read(&mut self, input: &mut BufferedTcpReader) @suspends @noescape -> Result<Option<Array<UInt8>>, ReadError> {
        input.read_message(self.max_bytes)
    }
}
// One handler holds the shared service and per-connection context.
pub trait Handler {
    type Message
    fn on_message(&self, message: Self.Message) @suspends @noescape -> Bool
    fn on_close(&self) @suspends @noescape
}
pub struct Connection { outgoing: outbox.Mailbox, control: outbox.Mailbox, options: Options }
pub fn create(options: Options) @suspends -> Connection {
    let control = outbox.create(1, 0)
    let outgoing = outbox.create_with_policy(options.queue_messages, options.queue_bytes, outbox.Overflow.Disconnect(control.handle()))
    Connection { outgoing: outgoing, control: control, options: options }
}
impl Connection {
    pub fn output(&self) @suspends -> Output { self.outgoing.handle() }
    pub fn stop_handle(&self) @suspends -> outbox.Handle { self.control.handle() }
}
// Typed exits are returned after on_close; structural cancellation does not return.
pub enum End { Eof, HandlerStopped, IdleTimeout, Shutdown, Stopped, OutputClosed }
pub enum Error<E> { Read(E), Write(IoError), ReadAndWrite((E, IoError)) }

enum Next<M, E> { Message(M), End(End), Failed(E) }
fn read<R: Reader>(protocol: &mut R, input: &mut BufferedTcpReader) @suspends @noescape -> Next<R.Message, R.Error> {
    match Reader.read(protocol, input) {
        Ok(Some(message)) => Next.Message(message),
        Ok(None) => Next.End(End.Eof),
        Err(error) => Next.Failed(error)
    }
}
fn timeout<M, E>(duration: Duration) @suspends -> Next<M, E> { task.sleep(duration); Next.End(End.IdleTimeout) }
fn receive<R: Reader, H: Handler<Message = R.Message>>(handler: &H, var reader: BufferedTcpReader, var protocol: R, options: Options) @suspends @noescape -> Result<End, Error<R.Error>> {
    while true {
        let next = if options.idle_timeout.is_zero() { read(&mut protocol, &mut reader) }
        else { race { read(&mut protocol, &mut reader), timeout::<R.Message, R.Error>(options.idle_timeout) } }
        let message = match next {
            Next.Message(message) => message,
            Next.End(end) => return Ok(end),
            Next.Failed(error) => return Err(Error.Read(error))
        }
        if !handler.on_message(message) { return Ok(End.HandlerStopped) }
    }
}
fn send(queue: &mut outbox.Mailbox, var writer: TcpWriter) @suspends -> Result<Unit, IoError> {
    while true {
        let bytes = match queue.receive() { Some(bytes) => bytes, None => return Ok({}) }
        writer.write_all(bytes)?
    }
}
fn finish<E>(received: Result<End, E>, sent: Result<Unit, IoError>) -> Result<End, Error<E>> {
    match (received, sent) {
        (Ok(end), Ok(_)) => Ok(end),
        (Err(error), Ok(_)) => Err(Error.Read(error)),
        (Ok(_), Err(error)) => Err(Error.Write(error)),
        (Err(read), Err(write)) => Err(Error.ReadAndWrite((read, write)))
    }
}
fn send_result<E>(queue: &mut outbox.Mailbox, writer: TcpWriter) @suspends -> Result<End, Error<E>> {
    finish(Ok(End.OutputClosed), send(queue, writer))
}
fn stop<E>(queue: &mut outbox.Mailbox) @suspends -> Result<End, Error<E>> { queue.receive(); Ok(End.Stopped) }
pub fn run<R: Reader, H: Handler<Message = R.Message>>(connection: Connection, stream: TcpStream, protocol: R, handler: &H) @suspends @noescape -> Result<End, Error<R.Error>> {
    var Connection { outgoing, control, options } = connection
    let (reader, writer) = BufferedTcp.new(stream).split()
    let outcome = race {
        receive(handler, reader, protocol, options)
        send_result::<R.Error>(&mut outgoing, writer)
        stop::<R.Error>(&mut control)
    }
    // Both mailbox owners remain alive until application cleanup finishes.
    handler.on_close()
    outcome
}

// Shutdown only competes with reading, never with an admitted on_message callback.
fn shutdown_read<M, E>(stop: &shutdown.Controller) @suspends -> Next<M, E> { stop.wait(); Next.End(End.Shutdown) }
fn receive_until_shutdown<R: Reader, H: Handler<Message = R.Message>>(handler: &H, var reader: BufferedTcpReader, var protocol: R, options: Options, stop: &shutdown.Controller) @suspends @noescape -> Result<End, R.Error> {
    while !stop.requested() {
        let next = if options.idle_timeout.is_zero() {
            race { shutdown_read::<R.Message, R.Error>(stop), read(&mut protocol, &mut reader) }
        } else {
            race { shutdown_read::<R.Message, R.Error>(stop), read(&mut protocol, &mut reader), timeout::<R.Message, R.Error>(options.idle_timeout) }
        }
        let message = match next {
            Next.Message(message) => message,
            Next.End(end) => return Ok(end),
            Next.Failed(error) => return Err(error)
        }
        if stop.requested() { return Ok(End.Shutdown) }
        if !handler.on_message(message) { return Ok(End.HandlerStopped) }
    }
    Ok(End.Shutdown)
}
fn receive_draining<R: Reader, H: Handler<Message = R.Message>>(handler: &H, reader: BufferedTcpReader, protocol: R, options: Options, stop: &shutdown.Controller, output: Output) @suspends @noescape -> Result<End, R.Error> {
    let outcome = receive_until_shutdown(handler, reader, protocol, options, stop)
    output.seal()
    outcome
}
fn send_draining(queue: &mut outbox.Mailbox, writer: TcpWriter, done: &shutdown.Controller) @suspends -> Result<Unit, IoError> {
    let outcome = send(queue, writer)
    done.request();
    outcome
}
fn output_closed<E>(done: &shutdown.Controller) @suspends -> Result<End, E> { done.wait(); Ok(End.OutputClosed) }
fn receive_or_output_closed<R: Reader, H: Handler<Message = R.Message>>(handler: &H, reader: BufferedTcpReader, protocol: R, options: Options, stop: &shutdown.Controller, output: Output, done: &shutdown.Controller) @suspends @noescape -> Result<End, R.Error> {
    race {
        receive_draining(handler, reader, protocol, options, stop, output)
        output_closed::<R.Error>(done)
    }
}
fn drain<R: Reader, H: Handler<Message = R.Message>>(handler: &H, reader: BufferedTcpReader, protocol: R, writer: TcpWriter, queue: &mut outbox.Mailbox, options: Options, stop: &shutdown.Controller, output: Output) @suspends @noescape -> Result<End, Error<R.Error>> {
    let done = shutdown.create()
    let (received, sent) = join {
        receive_or_output_closed(handler, reader, protocol, options, stop, output, &done)
        send_draining(queue, writer, &done)
    }
    // A completed read error survives a later drain failure. Writer completion also
    // interrupts a pending read or callback, without racing away the write error.
    finish(received, sent)
}
pub fn run_draining<R: Reader, H: Handler<Message = R.Message>>(connection: Connection, stream: TcpStream, protocol: R, handler: &H, shutdown: &shutdown.Controller) @suspends @noescape -> Result<End, Error<R.Error>> {
    var Connection { outgoing, control, options } = connection
    let output = outgoing.handle()
    let (reader, writer) = BufferedTcp.new(stream).split()
    let outcome = race {
        drain(handler, reader, protocol, writer, &mut outgoing, options, shutdown, output)
        stop::<R.Error>(&mut control)
    }
    // The queue may be sealed: cleanup must not depend on sending more to it.
    handler.on_close()
    outcome
}
