import joky/shutdown
import joky/outbox
import joky/time.{type Duration}
import joky/task
import joky/result.{Ok, Err}
import joky/option.{type Option, Some, None}
import joky/tcp.{type TcpStream, type BufferedTcp, type BufferedTcpReader, type TcpWriter}

pub struct Options {
    pub max_line_bytes: UInt64,
    pub queue_messages: UInt64,
    pub queue_bytes: UInt64,
    pub idle_timeout: Duration
}
impl Options {
    pub fn default() -> Self {
        Options { max_line_bytes: 4096, queue_messages: 64, queue_bytes: 65536, idle_timeout: 0ns }
    }
}
// Copyable output endpoint; send stages bytes in when, close stops the session.
pub type Output = outbox.Handle
pub struct Connection { outgoing: outbox.Mailbox, control: outbox.Mailbox, options: Options }
pub fn create(options: Options) @suspends -> Connection {
    let control = outbox.create(1, 0)
    let outgoing = outbox.create_with_policy(options.queue_messages, options.queue_bytes, outbox.Overflow.Disconnect(control.handle()))
    Connection { outgoing: outgoing, control: control, options: options }
}
impl Connection {
    pub fn output(&self) @suspends -> Output { self.outgoing.handle() }
    pub fn stop_handle(&self) @suspends -> outbox.Handle { self.control.handle() }
}
fn read(reader: &mut BufferedTcpReader, limit: UInt64) @suspends -> Option<String> {
    match reader.read_line(limit) { Ok(line) => line, Err(_) => None }
}
fn timeout(duration: Duration) @suspends -> Option<String> { task.sleep(duration); None }
fn receive<S, T>(shared: &S, ctx: &T, var reader: BufferedTcpReader, on_line: fn(&S, &T, String) @suspends @noescape -> Bool, options: Options) @suspends @noescape {
    while true {
        let next = if options.idle_timeout.is_zero() { read(&mut reader, options.max_line_bytes) }
        else { race { | read(&mut reader, options.max_line_bytes) | timeout(options.idle_timeout) } }
        let line = match next { Some(line) => line, None => return }
        if !on_line(shared, ctx, line) { return }
    }
}
fn send(queue: &mut outbox.Mailbox, var writer: TcpWriter) @suspends {
    while true {
        let bytes = match queue.receive() { Some(bytes) => bytes, None => return }
        if writer.write_all(bytes).is_err() { return }
    }
}
fn stop(queue: &mut outbox.Mailbox) @suspends { queue.receive(); }
pub fn run<S, T>(connection: Connection, stream: TcpStream, shared: &S, ctx: &T, on_line: fn(&S, &T, String) @suspends @noescape -> Bool, on_close: fn(&S, &T) @suspends @noescape -> Unit) @suspends @noescape {
    var (outgoing, control, options) = split(connection)
    let (reader, writer) = BufferedTcp.new(stream).split()
    race {
        | receive(shared, ctx, reader, on_line, options)
        | send(&mut outgoing, writer)
        | stop(&mut control)
    }
    // Both mailbox owners remain alive until application cleanup finishes.
    on_close(shared, ctx)
}

fn split(connection: Connection) -> (outbox.Mailbox, outbox.Mailbox, Options) {
    let Connection { outgoing, control, options } = connection
    (outgoing, control, options)
}

// Shutdown only competes with reading, never with an admitted on_line callback.
fn shutdown_read(stop: &shutdown.Controller) @suspends -> Option<String> { stop.wait(); None }
fn receive_draining<S, T>(shared: &S, ctx: &T, var reader: BufferedTcpReader, on_line: fn(&S, &T, String) @suspends @noescape -> Bool, options: Options, stop: &shutdown.Controller, output: Output) @suspends @noescape {
    while !stop.requested() {
        let next = if options.idle_timeout.is_zero() {
            race { | shutdown_read(stop) | read(&mut reader, options.max_line_bytes) }
        } else {
            race { | shutdown_read(stop) | read(&mut reader, options.max_line_bytes) | timeout(options.idle_timeout) }
        }
        let line = match next { Some(line) => line, None => break }
        if stop.requested() { break }
        if !on_line(shared, ctx, line) { break }
    }
    output.seal()
}
fn send_draining(queue: &mut outbox.Mailbox, var writer: TcpWriter, control: outbox.Handle) @suspends {
    while true {
        let bytes = match queue.receive() { Some(bytes) => bytes, None => return }
        if writer.write_all(bytes).is_err() { control.close(); return }
    }
}
fn drain<S, T>(shared: &S, ctx: &T, reader: BufferedTcpReader, writer: TcpWriter, queue: &mut outbox.Mailbox, on_line: fn(&S, &T, String) @suspends @noescape -> Bool, options: Options, stop: &shutdown.Controller, output: Output, control: outbox.Handle) @suspends @noescape {
    join {
        | receive_draining(shared, ctx, reader, on_line, options, stop, output)
        | send_draining(queue, writer, control)
    }
}
pub fn run_draining<S, T>(connection: Connection, stream: TcpStream, shared: &S, ctx: &T, on_line: fn(&S, &T, String) @suspends @noescape -> Bool, on_close: fn(&S, &T) @suspends @noescape -> Unit, shutdown: &shutdown.Controller) @suspends @noescape {
    var (outgoing, control, options) = split(connection)
    let output = outgoing.handle()
    let abort = control.handle()
    let (reader, writer) = BufferedTcp.new(stream).split()
    race {
        | drain(shared, ctx, reader, writer, &mut outgoing, on_line, options, shutdown, output, abort)
        | stop(&mut control)
    }
    // The queue may be sealed: cleanup must not depend on sending more to it.
    on_close(shared, ctx)
}
