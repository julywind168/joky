impl ToJson for Float64 {
    fn to_json(&self, context: &mut Context) @noescape -> Result<Value, MappingError> {
        context.scalar()?
        let number = match Number.from_f64(float64(*self)) { Ok(number) => number, Err(error) => { return Err(number_error(context, error)) } }
        write_number(number, context)
    }
}
impl FromJson for Float64 {
    fn from_json(value: Value, context: &mut Context) @noescape -> Result<Self, MappingError> {
        let number = read_number(value, context)?
        let value = match number.to_f64() { Ok(value) => value, Err(error) => { return Err(number_error(context, error)) } }
        let result = float64(value)
        if !result.is_finite() { return Err(context.error(MappingErrorKind.OutOfRange)) }
        Ok(result)
    }
}
