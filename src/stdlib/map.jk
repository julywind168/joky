// Single-owner, unordered Map. All table policies execute in Joky.
import joky/array.{type Array}
import joky/element.{type Element}
import joky/option.{type Option, Some, None}
import joky/internal/buffer as storage
import joky/check.{require}
import joky/eq.{type Eq}
import joky/hash.{type Hash}
import joky/internal/types as types

enum Bucket { Empty Deleted Full(UInt64) }
pub struct Map<K, V> {
    private buckets: Array<Bucket>
    private keys: Array<K>
    private values: Array<V>
    private hashes: Array<UInt64>
    private positions: Array<UInt64>
    private deleted: UInt64
}
impl<K, V> Map<K, V> {
    pub fn new() -> Self { new::<K, V>() }
    pub fn with_capacity(n: UInt64) -> Self { with_capacity::<K, V>(n) }
    pub fn len(&self) -> UInt64 { len(self) }
    pub fn is_empty(&self) -> Bool { is_empty(self) }
    pub fn capacity(&self) -> UInt64 { capacity(self) }
    pub fn reserve(&mut self, additional: UInt64) { reserve(self, additional) }
    pub fn clear(&mut self) { clear(self) }
    pub fn release(self) { release(self) }
}
impl<K: Eq + Hash, V> Map<K, V> {
    pub fn contains_key(&self, key: K) -> Bool { contains_key(self, key) }
    pub fn get(&self, key: K) -> Option<V> { get(self, key) }
    pub fn insert(&mut self, key: K, value: V) -> Option<V> { insert(self, key, value) }
    pub fn remove(&mut self, key: K) -> Option<V> { remove(self, key) }
    pub fn borrow(&self, key: K) -> &Element<V> { borrow(self, key) }
    pub fn borrow_mut(&mut self, key: K) -> &mut Element<V> { borrow_mut(self, key) }
    pub fn borrow_ref(&self, key: K) -> &V { borrow_ref(self, key) }
    pub fn borrow_mut_ref(&mut self, key: K) -> &mut V { borrow_mut_ref(self, key) }
}
pub fn new<K, V>() -> Map<K, V> {
    types.require_plain_copy::<K>()
    Map {
        buckets: Array.new::<Bucket>() keys: Array.new::<K>() values: Array.new::<V>()
        hashes: Array.new::<UInt64>() positions: Array.new::<UInt64>() deleted: 0
    }
}
pub fn with_capacity<K, V>(n: UInt64) -> Map<K, V> {
    var table = new::<K, V>()
    reserve(&mut table, n)
    table
}
pub fn len<K, V>(table: &Map<K, V>) -> UInt64 { table.values.len() }
pub fn is_empty<K, V>(table: &Map<K, V>) -> Bool { len(table) == 0 }
pub fn release<K, V>(table: Map<K, V>) {}
fn minimum(a: UInt64, b: UInt64) -> UInt64 { if a < b { a } else { b } }
fn load_limit(count: UInt64) -> UInt64 { count - count / 4 }
pub fn capacity<K, V>(table: &Map<K, V>) -> UInt64 {
    let index = minimum(table.hashes.capacity(), table.positions.capacity())
    let payload = minimum(table.keys.capacity(), table.values.capacity())
    let load = load_limit(table.buckets.len())
    minimum(load, minimum(payload, index))
}
// No unchecked arithmetic produces a buffer capacity or a probe bound.
fn bucket_count(required: UInt64, limit: UInt64) -> UInt64 {
    if required == 0 { return 0 }
    require(limit >= 8, "Map capacity exceeds the supported limit")
    var count: UInt64 = 8
    while required > load_limit(count) {
        require(count <= limit / 2, "Map capacity exceeds the supported limit")
        count = count + count
    }
    count
}
fn rehash<K, V>(table: &mut Map<K, V>, count: UInt64, required: UInt64) {
    var buckets = Array.with_capacity::<Bucket>(count)
    var i: UInt64 = 0
    while i < count { buckets.push(Bucket.Empty) i = i + 1 }
    let old_capacity = table.positions.capacity()
    let positions_capacity = if required > old_capacity { required } else { old_capacity }
    var positions = Array.with_capacity::<UInt64>(positions_capacity)
    i = 0
    while i < len(table) {
        let cached_hash = table.hashes.get(i).unwrap_or(0)
        let position = index_position(&buckets, cached_hash)
        buckets.set(position, Bucket.Full(i))
        positions.push(position)
        i = i + 1
    }
    // Only index owners are exchanged. Cached hashes avoid user protocol calls.
    let old_buckets = memory.replace(&mut table.buckets, buckets)
    let old_positions = memory.replace(&mut table.positions, positions)
    table.deleted = 0
}
pub fn reserve<K, V>(table: &mut Map<K, V>, additional: UInt64) {
    let length = len(table)
    require(additional <= 18446744073709551615 - length, "Map capacity exceeds the supported limit")
    let required = length + additional
    let payload_limit = minimum(storage.capacity_limit::<K>(), storage.capacity_limit::<V>())
    let limit = minimum(payload_limit, storage.capacity_limit::<UInt64>())
    require(required <= limit, "Map capacity exceeds the supported limit")
    let count = table.buckets.len()
    let target = bucket_count(required, storage.capacity_limit::<Bucket>())
    table.keys.reserve(additional)
    table.values.reserve(additional)
    table.hashes.reserve(additional)
    require(table.deleted <= 18446744073709551615 - required, "Map capacity exceeds the supported limit")
    if target > count {
        rehash(table, target, required)
    } else {
        if required + table.deleted > load_limit(count) { rehash(table, count, required) }
        else { table.positions.reserve(additional) }
    }
}
// A full traversal terminates even with adversarial protocol implementations.
fn find<K: Eq + Hash, V>(table: &Map<K, V>, key: K, cached_hash: UInt64) -> Option<UInt64> {
    let count = table.buckets.len()
    if count == 0 { return None }
    let mask = count - 1
    var position = cached_hash & mask
    var probes: UInt64 = 0
    while probes < count {
        let bucket = table.buckets.get(position).unwrap_or(Bucket.Empty)
        if bucket_is_empty(bucket) { return None }
        let candidate = lookup_bucket(table, bucket, key, cached_hash)
        if !candidate.is_none() { return candidate }
        position = (position + 1) & mask
        probes = probes + 1
    }
    None
}
fn bucket_is_empty(bucket: Bucket) -> Bool {
    match bucket { | Bucket.Empty => true | Bucket.Deleted => false | Bucket.Full(_) => false }
}
fn entry_matches<K: Eq + Hash, V>(table: &Map<K, V>, i: UInt64, key: K, cached_hash: UInt64) -> Bool {
    let stored_hash = table.hashes.get(i).unwrap_or(0)
    match table.keys.get(i) {
        | Some(stored) => stored_hash == cached_hash && Eq.eq(stored, key)
        | None => false
    }
}
fn lookup_bucket<K: Eq + Hash, V>(table: &Map<K, V>, bucket: Bucket, key: K, cached_hash: UInt64) -> Option<UInt64> {
    match bucket {
        | Bucket.Full(i) => if entry_matches(table, i, key, cached_hash) { Some(i) } else { None }
        | Bucket.Empty => None
        | Bucket.Deleted => None
    }
}
pub fn contains_key<K: Eq + Hash, V>(table: &Map<K, V>, key: K) -> Bool { !find(table, key, Hash.hash(key)).is_none() }
pub fn get<K: Eq + Hash, V>(table: &Map<K, V>, key: K) -> Option<V> {
    match find(table, key, Hash.hash(key)) { | Some(i) => table.values.get(i) | None => None }
}
fn require_entry<K: Eq + Hash, V>(table: &Map<K, V>, key: K) -> UInt64 {
    match find(table, key, Hash.hash(key)) {
        | Some(i) => i
        | None => { require(false, "Map key not found") 0 }
    }
}
pub fn borrow<K: Eq + Hash, V>(table: &Map<K, V>, key: K) -> &Element<V> {
    let i = require_entry(table, key)
    table.values.borrow(i)
}
pub fn borrow_mut<K: Eq + Hash, V>(table: &mut Map<K, V>, key: K) -> &mut Element<V> {
    let i = require_entry(table, key)
    table.values.borrow_mut(i)
}
pub fn borrow_ref<K: Eq + Hash, V>(table: &Map<K, V>, key: K) -> &V {
    let i = require_entry(table, key)
    table.values.borrow_ref(i)
}
pub fn borrow_mut_ref<K: Eq + Hash, V>(table: &mut Map<K, V>, key: K) -> &mut V {
    let i = require_entry(table, key)
    table.values.borrow_mut_ref(i)
}
fn index_position(buckets: &Array<Bucket>, cached_hash: UInt64) -> UInt64 {
    let count = buckets.len()
    let mask = count - 1
    var position = cached_hash & mask
    var probes: UInt64 = 0
    while probes < count {
        match buckets.get(position).unwrap_or(Bucket.Empty) {
            | Bucket.Full(_) => {}
            | Bucket.Empty => { return position }
            | Bucket.Deleted => { return position }
        }
        position = (position + 1) & mask
        probes = probes + 1
    }
    require(false, "Map index has no free bucket")
    0
}
pub fn insert<K: Eq + Hash, V>(table: &mut Map<K, V>, key: K, value: V) -> Option<V> {
    types.require_plain_copy::<K>()
    // All user protocol calls finish before storage or metadata is modified.
    let cached_hash = Hash.hash(key)
    match find(table, key, cached_hash) {
        | Some(i) => { return table.values.replace(i, value) }
        | None => {}
    }
    reserve(table, 1)
    let position = index_position(&table.buckets, cached_hash)
    let reused = match table.buckets.get(position).unwrap_or(Bucket.Empty) {
        | Bucket.Deleted => true | Bucket.Empty => false | Bucket.Full(_) => false
    }
    let i = len(table)
    table.keys.push(key)
    table.values.push(value)
    table.hashes.push(cached_hash)
    table.positions.push(position)
    table.buckets.set(position, Bucket.Full(i))
    if reused { table.deleted = table.deleted - 1 }
    None
}
fn remove_entry<K, V>(table: &mut Map<K, V>, i: UInt64) -> Option<V> {
    let position = table.positions.get(i).unwrap_or(0)
    let value = table.values.swap_remove(i)
    table.keys.swap_remove(i) table.hashes.swap_remove(i) table.positions.swap_remove(i)
    table.buckets.set(position, Bucket.Deleted)
    table.deleted = table.deleted + 1
    if i < len(table) {
        let moved_position = table.positions.get(i).unwrap_or(0)
        table.buckets.set(moved_position, Bucket.Full(i));
    }
    value
}
pub fn remove<K: Eq + Hash, V>(table: &mut Map<K, V>, key: K) -> Option<V> {
    match find(table, key, Hash.hash(key)) { | None => None | Some(i) => remove_entry(table, i) }
}
pub fn clear<K, V>(table: &mut Map<K, V>) {
    table.values.clear() table.keys.clear() table.hashes.clear() table.positions.clear()
    var i: UInt64 = 0
    while i < table.buckets.len() { table.buckets.set(i, Bucket.Empty) i = i + 1 }
    table.deleted = 0
}
