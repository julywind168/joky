import joky/mem
import joky/array as arrays.{type Array}
import joky/element.{type Element}
import joky/slice.{type Slice}
import joky/option.{type Option, Some, None}
import joky/internal/buffer as storage
import joky/check.{assert}
import joky/eq.{type Eq, type BorrowEq}
import joky/hash.{type Hash, type BorrowHash}
import joky/internal/types

// Single-owner, unordered Map. All table policies execute in Joky.
enum Bucket { Empty, Deleted, Full(UInt64) }
pub struct Map<K, V> {
    buckets: Array<Bucket>
    keys: Array<K>
    values: Array<V>
    hashes: Array<UInt64>
    positions: Array<UInt64>
    deleted: UInt64
}
impl<K, V> Map<K, V> {
    pub fn new() -> Self { new::<K, V>() }
    pub fn with_capacity(n: UInt64) -> Self { with_capacity::<K, V>(n) }
    pub fn len(&self) -> UInt64 { len(self) }
    pub fn is_empty(&self) -> Bool { is_empty(self) }
    pub fn capacity(&self) -> UInt64 { capacity(self) }
    pub fn reserve(&mut self, additional: UInt64) { reserve(self, additional) }
    pub fn clear(&mut self) { clear(self) }
    pub fn release(self) { release(self) }
    pub fn keys(&self) -> &Slice<K> { keys(self) }
    pub fn values(&self) -> &Slice<V> { values(self) }
    pub fn values_mut(&mut self) -> &mut Slice<V> { values_mut(self) }
    pub fn pop(&mut self) -> Option<(K, V)> { pop(self) }
    pub fn into_entries(self) -> Array<(K, V)> { into_entries(self) }
}
impl<K: Copy + Eq + Hash, V> Map<K, V> {
    pub fn contains_key(&self, key: K) -> Bool { contains_key(self, key) }
    pub fn remove(&mut self, key: K) -> Option<V> { remove(self, key) }
    pub fn borrow_ref(&self, key: K) -> &V { borrow_ref(self, key) }
    pub fn borrow_mut_ref(&mut self, key: K) -> &mut V { borrow_mut_ref(self, key) }
}
impl<K: BorrowEq + BorrowHash, V> Map<K, V> {
    pub fn from_entries(entries: Array<(K, V)>) -> Self { from_entries(entries) }
    pub fn extend(&mut self, entries: Array<(K, V)>) { extend(self, entries) }
    pub fn insert(&mut self, key: K, value: V) -> Option<V> { insert(self, key, value) }
    pub fn contains_key_by_ref(&self, key: &K) @noescape(key) -> Bool { contains_key_by_ref(self, key) }
    pub fn remove_by_ref(&mut self, key: &K) @noescape(key) -> Option<V> { remove_by_ref(self, key) }
    pub fn value_ref(&self, key: &K) @noescape(key) -> &V { value_ref(self, key) }
    pub fn value_mut(&mut self, key: &K) @noescape(key) -> &mut V { value_mut(self, key) }
}
pub fn new<K, V>() -> Map<K, V> {
    types.require_reference_free::<K>()
    Map {
        buckets: Array.new::<Bucket>(), keys: Array.new::<K>(), values: Array.new::<V>()
        hashes: Array.new::<UInt64>(), positions: Array.new::<UInt64>(), deleted: 0
    }
}
pub fn with_capacity<K, V>(n: UInt64) -> Map<K, V> {
    var table = new::<K, V>()
    reserve(&mut table, n)
    table
}
pub fn len<K, V>(table: &Map<K, V>) -> UInt64 { table.values.len() }
pub fn is_empty<K, V>(table: &Map<K, V>) -> Bool { len(table) == 0 }
pub fn release<K, V>(table: Map<K, V>) {}
pub fn keys<K, V>(table: &Map<K, V>) -> &Slice<K> { table.keys.slice(0, len(table)) }
pub fn values<K, V>(table: &Map<K, V>) -> &Slice<V> { table.values.slice(0, len(table)) }
pub fn values_mut<K, V>(table: &mut Map<K, V>) -> &mut Slice<V> {
    let length = len(table)
    table.values.slice_mut(0, length)
}
// Taking the dense tail needs neither key protocols nor a moved-entry repair.
pub fn pop<K, V>(table: &mut Map<K, V>) -> Option<(K, V)> {
    if is_empty(table) { return None }
    let position = table.positions.take_last()
    let key = table.keys.take_last()
    let value = table.values.take_last()
    table.hashes.take_last()
    table.buckets.set(position, Bucket.Deleted)
    table.deleted = table.deleted + 1
    Some((key, value))
}
pub fn into_entries<K, V>(table: Map<K, V>) -> Array<(K, V)> {
    var table = table
    var entries = Array.with_capacity::<(K, V)>(len(&table))
    while let Some(entry) = pop(&mut table) { entries.push(entry) }
    entries
}
pub fn from_entries<K: BorrowEq + BorrowHash, V>(entries: Array<(K, V)>) -> Map<K, V> {
    var table = new::<K, V>()
    extend(&mut table, entries)
    table
}
pub fn extend<K: BorrowEq + BorrowHash, V>(table: &mut Map<K, V>, entries: Array<(K, V)>) {
    var entries = entries
    let count = entries.len()
    reserve(table, count)
    // Reverse in place so tail consumption visits the original input order.
    var i: UInt64 = 0
    while i < count / 2 { entries.swap(i, count - 1 - i); i = i + 1 }
    while !entries.is_empty() {
        let (key, value) = entries.take_last()
        // Drop an overwritten value before processing the next input entry.
        let old = insert(table, key, value)
    }
}
fn minimum(a: UInt64, b: UInt64) -> UInt64 { if a < b { a } else { b } }
fn load_limit(count: UInt64) -> UInt64 { count - count / 4 }
pub fn capacity<K, V>(table: &Map<K, V>) -> UInt64 {
    let index = minimum(table.hashes.capacity(), table.positions.capacity())
    let payload = minimum(table.keys.capacity(), table.values.capacity())
    let load = load_limit(table.buckets.len())
    minimum(load, minimum(payload, index))
}
// No unchecked arithmetic produces a buffer capacity or a probe bound.
fn bucket_count(required: UInt64, limit: UInt64) -> UInt64 {
    if required == 0 { return 0 }
    if limit < 8 { assert(false, "Map capacity exceeds the supported limit") }
    var count: UInt64 = 8
    while required > load_limit(count) {
        if count > limit / 2 { assert(false, "Map capacity exceeds the supported limit") }
        count = count + count
    }
    count
}
fn rehash<K, V>(table: &mut Map<K, V>, count: UInt64, required: UInt64) {
    var buckets = Array.with_capacity::<Bucket>(count)
    var i: UInt64 = 0
    while i < count { buckets.push(Bucket.Empty); i = i + 1 }
    let old_capacity = table.positions.capacity()
    let positions_capacity = if required > old_capacity { required } else { old_capacity }
    var positions = Array.with_capacity::<UInt64>(positions_capacity)
    i = 0
    while i < len(table) {
        let cached_hash = table.hashes.get(i).unwrap_or(0)
        let position = index_position(&buckets, cached_hash)
        buckets.set(position, Bucket.Full(i))
        positions.push(position)
        i = i + 1
    }
    // Only index owners are exchanged. Cached hashes avoid user protocol calls.
    let old_buckets = mem.replace(&mut table.buckets, buckets)
    let old_positions = mem.replace(&mut table.positions, positions)
    table.deleted = 0
}
pub fn reserve<K, V>(table: &mut Map<K, V>, additional: UInt64) {
    let length = len(table)
    if additional > 18446744073709551615 - length { assert(false, "Map capacity exceeds the supported limit") }
    let required = length + additional
    let payload_limit = minimum(storage.capacity_limit::<K>(), storage.capacity_limit::<V>())
    let limit = minimum(payload_limit, storage.capacity_limit::<UInt64>())
    if required > limit { assert(false, "Map capacity exceeds the supported limit") }
    let count = table.buckets.len()
    let target = bucket_count(required, storage.capacity_limit::<Bucket>())
    table.keys.reserve(additional)
    table.values.reserve(additional)
    table.hashes.reserve(additional)
    if table.deleted > 18446744073709551615 - required { assert(false, "Map capacity exceeds the supported limit") }
    if target > count {
        rehash(table, target, required)
    } else {
        if required + table.deleted > load_limit(count) { rehash(table, count, required) }
        else { table.positions.reserve(additional) }
    }
}
// A full traversal terminates even with adversarial protocol implementations.
fn find<K: BorrowEq + BorrowHash, V>(table: &Map<K, V>, key: &K, cached_hash: UInt64) @noescape -> Option<UInt64> {
    let count = table.buckets.len()
    if count == 0 { return None }
    let mask = count - 1
    var position = cached_hash & mask
    var probes: UInt64 = 0
    while probes < count {
        let bucket = table.buckets.get(position).unwrap_or(Bucket.Empty)
        match bucket {
            Bucket.Empty => { return None }
            Bucket.Deleted => {}
            Bucket.Full(i) => {
                let stored_hash = table.hashes.get(i).unwrap_or(0)
                if stored_hash == cached_hash && BorrowEq.eq_ref(arrays.borrow_ref(&table.keys, i), key) {
                    return Some(i)
                }
            }
        }
        position = (position + 1) & mask
        probes = probes + 1
    }
    None
}
pub fn contains_key<K: Copy + Eq + Hash, V>(table: &Map<K, V>, key: K) -> Bool { !find(table, &key, BorrowHash.hash_ref(&key)).is_none() }
pub fn get<K: Copy + Eq + Hash, V: Copy>(table: &Map<K, V>, key: K) -> Option<V> {
    match find(table, &key, BorrowHash.hash_ref(&key)) { Some(i) => table.values.get(i), None => None }
}
fn require_entry<K: BorrowEq + BorrowHash, V>(table: &Map<K, V>, key: &K) @noescape(key) -> UInt64 {
    match find(table, key, BorrowHash.hash_ref(key)) {
        Some(i) => i
        None => { assert(false, "Map key not found"); 0 }
    }
}
pub fn borrow<K: Copy + Eq + Hash, V: Copy>(table: &Map<K, V>, key: K) -> &Element<V> {
    let i = require_entry(table, &key)
    table.values.borrow(i)
}
pub fn borrow_mut<K: Copy + Eq + Hash, V: Copy>(table: &mut Map<K, V>, key: K) -> &mut Element<V> {
    let i = require_entry(table, &key)
    table.values.borrow_mut(i)
}
pub fn borrow_ref<K: Copy + Eq + Hash, V>(table: &Map<K, V>, key: K) -> &V {
    let i = require_entry(table, &key)
    table.values.borrow_ref(i)
}
pub fn borrow_mut_ref<K: Copy + Eq + Hash, V>(table: &mut Map<K, V>, key: K) -> &mut V {
    let i = require_entry(table, &key)
    table.values.borrow_mut_ref(i)
}
pub fn contains_key_by_ref<K: BorrowEq + BorrowHash, V>(table: &Map<K, V>, key: &K) @noescape(key) -> Bool {
    !find(table, key, BorrowHash.hash_ref(key)).is_none()
}
pub fn get_by_ref<K: BorrowEq + BorrowHash, V: Copy>(table: &Map<K, V>, key: &K) @noescape(key) -> Option<V> {
    match find(table, key, BorrowHash.hash_ref(key)) { Some(i) => table.values.get(i), None => None }
}
pub fn remove_by_ref<K: BorrowEq + BorrowHash, V>(table: &mut Map<K, V>, key: &K) @noescape(key) -> Option<V> {
    match find(table, key, BorrowHash.hash_ref(key)) { Some(i) => remove_entry(table, i), None => None }
}
pub fn value_ref<K: BorrowEq + BorrowHash, V>(table: &Map<K, V>, key: &K) @noescape(key) -> &V {
    let i = require_entry(table, key)
    table.values.borrow_ref(i)
}
pub fn value_mut<K: BorrowEq + BorrowHash, V>(table: &mut Map<K, V>, key: &K) @noescape(key) -> &mut V {
    let i = require_entry(table, key)
    table.values.borrow_mut_ref(i)
}
fn index_position(buckets: &Array<Bucket>, cached_hash: UInt64) @noescape -> UInt64 {
    let count = buckets.len()
    let mask = count - 1
    var position = cached_hash & mask
    var probes: UInt64 = 0
    while probes < count {
        match buckets.get(position).unwrap_or(Bucket.Empty) {
            Bucket.Full(_) => {}
            Bucket.Empty => { return position }
            Bucket.Deleted => { return position }
        }
        position = (position + 1) & mask
        probes = probes + 1
    }
    assert(false, "Map index has no free bucket")
    0
}
pub fn insert<K: BorrowEq + BorrowHash, V>(table: &mut Map<K, V>, key: K, value: V) -> Option<V> {
    types.require_reference_free::<K>()
    // All user protocol calls finish before storage or metadata is modified.
    let cached_hash = BorrowHash.hash_ref(&key)
    if let Some(i) = find(table, &key, cached_hash) {
        return table.values.replace(i, value)
    }
    reserve(table, 1)
    let position = index_position(&table.buckets, cached_hash)
    let reused = match table.buckets.get(position).unwrap_or(Bucket.Empty) {
        Bucket.Deleted => true, Bucket.Empty => false, Bucket.Full(_) => false
    }
    let i = len(table)
    table.keys.push(key)
    table.values.push(value)
    table.hashes.push(cached_hash)
    table.positions.push(position)
    table.buckets.set(position, Bucket.Full(i))
    if reused { table.deleted = table.deleted - 1 }
    None
}
fn remove_entry<K, V>(table: &mut Map<K, V>, i: UInt64) -> Option<V> {
    let position = table.positions.get(i).unwrap_or(0)
    let value = table.values.swap_remove(i)
    // Repair the index before the removed key can run a fallible destructor.
    let removed_key = table.keys.swap_remove(i)
    table.hashes.swap_remove(i); table.positions.swap_remove(i)
    table.buckets.set(position, Bucket.Deleted)
    table.deleted = table.deleted + 1
    if i < len(table) {
        let moved_position = table.positions.get(i).unwrap_or(0)
        table.buckets.set(moved_position, Bucket.Full(i));
    }
    value
}
pub fn remove<K: Copy + Eq + Hash, V>(table: &mut Map<K, V>, key: K) -> Option<V> {
    match find(table, &key, BorrowHash.hash_ref(&key)) { None => None, Some(i) => remove_entry(table, i) }
}
pub fn clear<K, V>(table: &mut Map<K, V>) {
    table.values.clear(); table.keys.clear(); table.hashes.clear(); table.positions.clear()
    var i: UInt64 = 0
    while i < table.buckets.len() { table.buckets.set(i, Bucket.Empty); i = i + 1 }
    table.deleted = 0
}

impl<K: Copy + Eq + Hash, V: Copy> Map<K, V> {
    pub fn get(&self, key: K) -> Option<V> { get(self, key) }
    pub fn borrow(&self, key: K) -> &Element<V> { borrow(self, key) }
    pub fn borrow_mut(&mut self, key: K) -> &mut Element<V> { borrow_mut(self, key) }
}

impl<K: BorrowEq + BorrowHash, V: Copy> Map<K, V> {
    pub fn get_by_ref(&self, key: &K) @noescape(key) -> Option<V> { get_by_ref(self, key) }
}
