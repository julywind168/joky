import joky/string as text.{type StringBuilder}
import joky/integer
import joky/float
import joky/array.{type Array}
import joky/map.{type Map}
import joky/slice as slices
import joky/option.{type Option, Some, None}
import joky/result.{type Result, Ok, Err}

// Display writes into caller-owned storage without consuming its input.
pub trait Show {
    fn show(&self, output: &mut StringBuilder) @noescape
    fn to_text(&self) @noescape -> String {
        var output = StringBuilder.new()
        self.show(&mut output)
        output.finish()
    }
}
pub fn append<T: Show>(value: &T, output: &mut StringBuilder) @noescape { value.show(output) }
pub fn to_text<T: Show>(value: &T) @noescape -> String { Show.to_text(value) }
impl Show for String { fn show(&self, output: &mut StringBuilder) @noescape { output.push_str(self) } }
impl Show for Bool { fn show(&self, output: &mut StringBuilder) @noescape { let value = if memory.read(self) { "true" } else { "false" } output.push_str(&value) } }
impl Show for Rune { fn show(&self, output: &mut StringBuilder) @noescape { output.push(memory.read(self)) } }
impl Show for Unit { fn show(&self, output: &mut StringBuilder) @noescape { let value = "()" output.push_str(&value) } }
impl Show for Int8 { fn show(&self, output: &mut StringBuilder) @noescape { let value = int64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for Int16 { fn show(&self, output: &mut StringBuilder) @noescape { let value = int64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for Int32 { fn show(&self, output: &mut StringBuilder) @noescape { let value = int64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for Int64 { fn show(&self, output: &mut StringBuilder) @noescape { let value = int64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for UInt8 { fn show(&self, output: &mut StringBuilder) @noescape { let value = uint64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for UInt16 { fn show(&self, output: &mut StringBuilder) @noescape { let value = uint64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for UInt32 { fn show(&self, output: &mut StringBuilder) @noescape { let value = uint64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for UInt64 { fn show(&self, output: &mut StringBuilder) @noescape { let value = uint64(memory.read(self)).to_string() output.push_str(&value) } }
impl Show for Float32 { fn show(&self, output: &mut StringBuilder) @noescape { let value = memory.read(self).to_text() output.push_str(&value) } }
impl Show for Float64 { fn show(&self, output: &mut StringBuilder) @noescape { let value = memory.read(self).to_text() output.push_str(&value) } }
impl<T: Show> Show for Array<T> {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push('[')
        var index: UInt64 = 0
        while index < self.len() {
            if index != 0 { let separator = ", " output.push_str(&separator) }
            Show.show(self.borrow_ref(index), output)
            index = index + 1
        }
        output.push(']')
    }
}
impl<T: Show> Show for Option<T> {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            | Some(value) => { let prefix = "Some(" output.push_str(&prefix) value.show(output) output.push(')') }
            | None => { let text = "None" output.push_str(&text) }
        }
    }
}
impl<T: Show, E: Show> Show for Result<T, E> {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            | Ok(value) => { let prefix = "Ok(" output.push_str(&prefix) value.show(output) output.push(')') }
            | Err(error) => { let prefix = "Err(" output.push_str(&prefix) error.show(output) output.push(')') }
        }
    }
}
impl<K: Show, V: Show> Show for Map<K, V> {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push('{')
        let keys = self.keys()
        let values = self.values()
        var index: UInt64 = 0
        while index < self.len() {
            if index != 0 { let separator = ", " output.push_str(&separator) }
            Show.show(slices.borrow_ref(keys, index), output)
            let separator = ": " output.push_str(&separator)
            Show.show(slices.borrow_ref(values, index), output)
            index = index + 1
        }
        output.push('}')
    }
}
