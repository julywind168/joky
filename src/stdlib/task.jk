//! Task scheduling and suspension.

import joky/string.{type StringBuilder}
import joky/show.{type Show}
import joky/result.{ type Result, Ok, Err }
import joky/time.{ type Duration, type Instant }
import joky/internal/time as clock

extern fn __joky_public_task_yield_now() @suspends
extern fn __joky_public_task_sleep_ns(nanoseconds: UInt64) @suspends
pub fn yield_now() @suspends { __joky_public_task_yield_now() }

// A timeout is distinct from the operation's own result or runtime failure.
pub struct Timeout {}
impl Show for Timeout {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str("operation timed out")
    }
}

pub fn sleep_until(deadline: Instant) @suspends { clock.sleep_until(deadline) }
pub fn sleep(duration: Duration) @suspends { __joky_public_task_sleep_ns(duration.as_nanos()) }
pub fn timeout<T, F: FnOnce() @suspends -> T>(duration: Duration, operation: F) @suspends -> Result<T, Timeout> {
    race {
        { Ok(operation()) }
        { sleep(duration); Err(Timeout {}) }
    }
}

// Fixed-size failure categories: constructing an isolated failure needs no heap storage.
pub enum Failure { Runtime, ResourceLimit, Host, Io, InvalidState, InvalidArgument, Other }
impl Show for Failure {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Runtime => "runtime failure"
            ResourceLimit => "resource limit"
            Host => "host failure"
            Io => "I/O failure"
            InvalidState => "invalid state"
            InvalidArgument => "invalid argument"
            Other => "task failure"
        })
    }
}

fn __isolate_success<T>(value: T) -> Result<T, Failure> { Ok(value) }
fn __isolate_failure<T>(code: UInt64) -> Result<T, Failure> {
    Err(match code {
        1 => Failure.Runtime
        2 => Failure.ResourceLimit
        3 => Failure.Host
        4 => Failure.Io
        5 => Failure.InvalidState
        6 => Failure.InvalidArgument
        _ => Failure.Other
    })
}
