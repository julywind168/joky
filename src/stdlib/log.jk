//! Application logging.

// Structured events use a single stderr write. The caller selects every business field.
import joky/array.{type Array}
import joky/map.{type Map}
import joky/json
import joky/string.{type StringBuilder}
import joky/show.{type Show}
import joky/time
import joky/uuid.{type Uuid}
import joky/result.{type Result, Ok, Err}
extern fn __joky_try_write_stderr(text: &String) -> Int32
pub enum LogError { InvalidEvent, TooManyFields, InvalidField, DuplicateField, ValueTooLong, Encoding(json.EncodeError), WriteFailed }

impl Show for LogError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            InvalidEvent => "invalid log event name", TooManyFields => "too many log fields",
            InvalidField => "invalid log field name", DuplicateField => "duplicate or reserved log field",
            ValueTooLong => "log field value too long", Encoding(_) => "log JSON encoding failed",
            WriteFailed => "log write to stderr failed"
        })
    }
}
pub enum Level { Debug, Info, Warn, Error }
impl Show for Level {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Debug => "DEBUG"
            Info => "INFO"
            Warn => "WARN"
            Error => "ERROR"
        })
    }
}

pub enum Emission { Written, Filtered }
impl Show for Emission {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Written => "written"
            Filtered => "filtered"
        })
    }
}

pub struct Logger { pub minimum: Level }
fn rank(level: Level) -> UInt8 {
    match level { Debug => 0, Info => 1, Warn => 2, Error => 3 }
}
impl Logger {
    pub fn new(minimum: Level) -> Logger { Logger { minimum } }
    pub fn enabled(&self, level: Level) -> Bool { rank(level) >= rank(self.minimum) }
    pub fn emit(&self, level: Level, event: String, fields: Array<Field>) -> Result<Emission, LogError> {
        if !self.enabled(level) { return Ok(Filtered) }
        emit(level, event, fields)?
        Ok(Written)
    }
    pub fn debug(&self, event: String, fields: Array<Field>) { self.emit(Level.Debug, event, fields); }
    pub fn info(&self, event: String, fields: Array<Field>) { self.emit(Level.Info, event, fields); }
    pub fn warn(&self, event: String, fields: Array<Field>) { self.emit(Level.Warn, event, fields); }
    pub fn error(&self, event: String, fields: Array<Field>) { self.emit(Level.Error, event, fields); }
}
pub struct Field { name: String, value: json.Value }
pub fn text(name: String, value: String) -> Field { Field { name, value: json.Value.Text(value) } }
pub fn uint(name: String, value: UInt64) -> Field { Field { name, value: json.Value.Number(json.Number.from_u64(value)) } }
pub fn integer(name: String, value: Int64) -> Field { Field { name, value: json.Value.Number(json.Number.from_i64(value)) } }
pub fn boolean(name: String, value: Bool) -> Field { Field { name, value: json.Value.Boolean(value) } }

// Conversion preserves JSON scalar types; callers choose duration units explicitly.
pub trait ToField {
    fn to_field(self, name: String) -> Field
}
pub fn field<T: ToField>(name: String, value: T) -> Field { value.to_field(name) }
impl ToField for String { fn to_field(self, name: String) -> Field { text(name, self) } }
impl ToField for Bool { fn to_field(self, name: String) -> Field { boolean(name, self) } }
impl ToField for Uuid { fn to_field(self, name: String) -> Field { text(name, self.to_text()) } }
impl ToField for Int8 { fn to_field(self, name: String) -> Field { integer(name, int64(self)) } }
impl ToField for Int16 { fn to_field(self, name: String) -> Field { integer(name, int64(self)) } }
impl ToField for Int32 { fn to_field(self, name: String) -> Field { integer(name, int64(self)) } }
impl ToField for Int64 { fn to_field(self, name: String) -> Field { integer(name, self) } }
impl ToField for UInt8 { fn to_field(self, name: String) -> Field { uint(name, uint64(self)) } }
impl ToField for UInt16 { fn to_field(self, name: String) -> Field { uint(name, uint64(self)) } }
impl ToField for UInt32 { fn to_field(self, name: String) -> Field { uint(name, uint64(self)) } }
impl ToField for UInt64 { fn to_field(self, name: String) -> Field { uint(name, self) } }

fn add(record: &mut Map<String, json.Value>, field: Field) -> Result<Unit, LogError> {
    let Field { name, value } = field
    if name.is_empty() || name.byte_length() > 64 { return Err(InvalidField) }
    if record.contains_key(&name) { return Err(DuplicateField) }
    if let Text(s) = &value { if s.byte_length() > 4096 { return Err(ValueTooLong) } }
    record.insert(name, value);
    Ok({})
}

pub fn emit(level: Level, event: String, fields: Array<Field>) -> Result<Unit, LogError> {
    if event.is_empty() || event.byte_length() > 128 { return Err(InvalidEvent) }
    if fields.len() > 32 { return Err(TooManyFields) }
    var record = Map.new::<String, json.Value>()
    let severity = match level { Debug => "debug", Info => "info", Warn => "warn", Error => "error" }
    record.insert("level", json.Value.Text(severity))
    record.insert("event", json.Value.Text(event))
    record.insert("timestamp", json.Value.Text(time.Timestamp.now().to_text()))
    for field in fields { add(&mut record, field)? }
    let value = json.Value.Object(record)
    let line = match json.encode(&value) { Ok(text) => text, Err(e) => return Err(Encoding(e)) }
    var output = StringBuilder.from(&line)
    output.push('\n')
    let message = output.finish()
    if __joky_try_write_stderr(&message) == 0 { Ok({}) } else { Err(WriteFailed) }
}

pub fn debug(event: String, fields: Array<Field>) { emit(Level.Debug, event, fields); }
pub fn info(event: String, fields: Array<Field>) { emit(Level.Info, event, fields); }
pub fn warn(event: String, fields: Array<Field>) { emit(Level.Warn, event, fields); }
pub fn error(event: String, fields: Array<Field>) { emit(Level.Error, event, fields); }
