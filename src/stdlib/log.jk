//! Application logging.
//!
//! Events are emitted as structured JSON on standard error. A `Logger` filters
//! by its minimum level. Use `emit` when write or validation errors matter;
//! `debug`, `info`, `warn` and `error` intentionally discard those results.
//!
//! ```joky
//! import joky/log
//!
//! fn main() {
//!     let logger = log.Logger.new(log.Level.Info)
//!     assert(!logger.enabled(log.Level.Debug), "debug is filtered")
//!     logger.emit(log.Level.Info, "started", [log.text("service", "example")]).unwrap();
//! }
//! ```

// Structured events use a single stderr write. The caller selects every business field.
import joky/array.{type Array}
import joky/map.{type Map}
import joky/json
import joky/string.{type StringBuilder}
import joky/show.{type Show}
import joky/time
import joky/uuid.{type Uuid}
import joky/result.{type Result, Ok, Err}
extern fn __joky_try_write_stderr(text: &String) -> Int32
/// Reasons a structured event could not be encoded or written.
pub enum LogError {
    /// The event name failed validation.
    InvalidEvent,
    /// The event contains more fields than the logger allows.
    TooManyFields,
    /// A field name failed validation.
    InvalidField,
    /// More than one field has the same name.
    DuplicateField,
    /// A log field value exceeds its permitted size.
    ValueTooLong,
    /// Encoding the structured event as JSON failed.
    Encoding(json.EncodeError),
    /// Writing the structured event failed.
    WriteFailed
}

impl Show for LogError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(
            match self {
                InvalidEvent => "invalid log event name",
                TooManyFields => "too many log fields",
                InvalidField => "invalid log field name",
                DuplicateField => "duplicate or reserved log field",
                ValueTooLong => "log field value too long",
                Encoding(_) => "log JSON encoding failed",
                WriteFailed => "log write to stderr failed"
            }
        )
    }
}
/// Severity of a structured log event.
pub enum Level {
    /// Diagnostic detail intended for debugging.
    Debug,
    /// Normal operational information.
    Info,
    /// A condition that merits attention.
    Warn,
    /// A failed operation or error condition.
    Error
}
impl Show for Level {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(
            match self {
                Debug => "DEBUG"
                Info => "INFO"
                Warn => "WARN"
                Error => "ERROR"
            }
        )
    }
}

/// Whether a log event was written or filtered by severity.
pub enum Emission {
    /// The event was encoded and written.
    Written,
    /// The event's severity was below the configured threshold.
    Filtered
}
impl Show for Emission {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(
            match self {
                Written => "written"
                Filtered => "filtered"
            }
        )
    }
}

/// A structured logger with a severity threshold.
pub struct Logger {
    /// Lowest severity eligible for emission.
    pub minimum: Level
}

fn rank(level: Level) -> UInt8 {
    match level {
        Debug => 0,
        Info => 1,
        Warn => 2,
        Error => 3
    }
}

impl Logger {
    /// Creates a logger with the supplied minimum severity.
    pub fn new(minimum: Level) -> Logger {
        Logger { minimum }
    }
    /// Checks whether a severity meets the logger's threshold.
    pub fn enabled(&self, level: Level) -> Bool {
        rank(level) >= rank(self.minimum)
    }
    /// Attempts to write one structured event and reports whether it was emitted or filtered.
    pub fn emit(
        &self,
        level: Level,
        event: String,
        fields: Array<Field>
    ) -> Result<Emission, LogError> {
        if !self.enabled(level) {
            return Ok(Filtered)
        }
        emit(level, event, fields)?
        Ok(Written)
    }
    /// Attempts to emit a structured event at debug severity.
    pub fn debug(&self, event: String, fields: Array<Field>) {
        let _ = self.emit(Level.Debug, event, fields)
    }
    /// Attempts to emit a structured event at informational severity.
    pub fn info(&self, event: String, fields: Array<Field>) {
        let _ = self.emit(Level.Info, event, fields)
    }
    /// Attempts to emit a structured event at warning severity.
    pub fn warn(&self, event: String, fields: Array<Field>) {
        let _ = self.emit(Level.Warn, event, fields)
    }
    /// Attempts to emit a structured event at error severity.
    pub fn error(&self, event: String, fields: Array<Field>) {
        let _ = self.emit(Level.Error, event, fields)
    }
}
/// A named value added to a structured log event.
pub struct Field { name: String, value: json.Value }

/// Creates a text-valued field payload.
pub fn text(name: String, value: String) -> Field {
    Field { name, value: json.Value.Text(value) }
}

/// Creates an unsigned integer field payload.
pub fn uint(name: String, value: UInt64) -> Field {
    Field { name, value: json.Value.Number(json.Number.from_u64(value)) }
}

/// Creates a signed integer field payload.
pub fn integer(name: String, value: Int64) -> Field {
    Field { name, value: json.Value.Number(json.Number.from_i64(value)) }
}

/// Creates a Boolean field payload.
pub fn boolean(name: String, value: Bool) -> Field {
    Field { name, value: json.Value.Boolean(value) }
}

// Conversion preserves JSON scalar types; callers choose duration units explicitly.
/// Converts an application value into a structured log field value.
pub trait ToField {
    /// Consumes the value and converts it to the JSON representation of a log field.
    fn to_field(self, name: String) -> Field
}

/// Builds a named field using the value's ToField conversion.
pub fn field<T: ToField>(name: String, value: T) -> Field {
    value.to_field(name)
}

impl ToField for String {
    fn to_field(self, name: String) -> Field {
        text(name, self)
    }
}
impl ToField for Bool {
    fn to_field(self, name: String) -> Field {
        boolean(name, self)
    }
}
impl ToField for Uuid {
    fn to_field(self, name: String) -> Field {
        text(name, self.to_text())
    }
}
impl ToField for Int8 {
    fn to_field(self, name: String) -> Field {
        integer(name, int64(self))
    }
}
impl ToField for Int16 {
    fn to_field(self, name: String) -> Field {
        integer(name, int64(self))
    }
}
impl ToField for Int32 {
    fn to_field(self, name: String) -> Field {
        integer(name, int64(self))
    }
}
impl ToField for Int64 {
    fn to_field(self, name: String) -> Field {
        integer(name, self)
    }
}
impl ToField for UInt8 {
    fn to_field(self, name: String) -> Field {
        uint(name, uint64(self))
    }
}
impl ToField for UInt16 {
    fn to_field(self, name: String) -> Field {
        uint(name, uint64(self))
    }
}
impl ToField for UInt32 {
    fn to_field(self, name: String) -> Field {
        uint(name, uint64(self))
    }
}
impl ToField for UInt64 {
    fn to_field(self, name: String) -> Field {
        uint(name, self)
    }
}

fn add(record: &mut Map<String, json.Value>, field: Field) -> Result<Unit, LogError> {
    let Field { name, value } = field
    if name.is_empty() || name.byte_length() > 64 {
        return Err(InvalidField)
    }
    if record.contains_key(&name) {
        return Err(DuplicateField)
    }
    if let Text(s) = &value && s.byte_length() > 4096 {
        return Err(ValueTooLong)
    }
    record.insert(name, value)
    Ok({})
}

/// Attempts to write one structured event and reports whether it was emitted or filtered.
pub fn emit(level: Level, event: String, fields: Array<Field>) -> Result<Unit, LogError> {
    if event.is_empty() || event.byte_length() > 128 {
        return Err(InvalidEvent)
    }
    if fields.len() > 32 {
        return Err(TooManyFields)
    }
    var record = Map.new::<String, json.Value>()
    let severity = match level {
        Debug => "debug",
        Info => "info",
        Warn => "warn",
        Error => "error"
    }
    record.insert("level", json.Value.Text(severity))
    record.insert("event", json.Value.Text(event))
    record.insert("timestamp", json.Value.Text(time.Timestamp.now().to_text()))
    for field in fields {
        add(&mut record, field)?
    }
    let value = json.Value.Object(record)
    let line = match json.encode(&value) {
        Ok(text) => text,
        Err(e) => return Err(Encoding(e))
    }
    var output = StringBuilder.from(&line)
    output.push('\n')
    let message = output.finish()
    if __joky_try_write_stderr(&message) == 0 {
        Ok({})
    } else {
        Err(WriteFailed)
    }
}

/// Attempts to emit a structured event at debug severity.
pub fn debug(event: String, fields: Array<Field>) {
    let _ = emit(Level.Debug, event, fields)
}

/// Attempts to emit a structured event at informational severity.
pub fn info(event: String, fields: Array<Field>) {
    let _ = emit(Level.Info, event, fields)
}

/// Attempts to emit a structured event at warning severity.
pub fn warn(event: String, fields: Array<Field>) {
    let _ = emit(Level.Warn, event, fields)
}

/// Attempts to emit a structured event at error severity.
pub fn error(event: String, fields: Array<Field>) {
    let _ = emit(Level.Error, event, fields)
}
