// Homogeneous, consuming addition. Operator dispatch is static.
pub trait Add { fn add(self, other: Self) -> Self }
impl Add for Int8 { fn add(self, other: Self) -> Self { self + other } }
impl Add for Int16 { fn add(self, other: Self) -> Self { self + other } }
impl Add for Int32 { fn add(self, other: Self) -> Self { self + other } }
impl Add for Int64 { fn add(self, other: Self) -> Self { self + other } }
impl Add for UInt8 { fn add(self, other: Self) -> Self { self + other } }
impl Add for UInt16 { fn add(self, other: Self) -> Self { self + other } }
impl Add for UInt32 { fn add(self, other: Self) -> Self { self + other } }
impl Add for UInt64 { fn add(self, other: Self) -> Self { self + other } }
impl Add for Float32 { fn add(self, other: Self) -> Self { self + other } }
impl Add for Float64 { fn add(self, other: Self) -> Self { self + other } }
