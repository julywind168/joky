import joky/show.{type Show}
import joky/string.{type StringBuilder}
extern fn __joky_write_stdout(text: &String) -> Int32

pub fn print<T: Show>(value: &T) @noescape {
    var output = StringBuilder.new()
    value.show(&mut output)
    let text = output.finish()
    __joky_write_stdout(&text);
}
pub fn println<T: Show>(value: &T) @noescape {
    var output = StringBuilder.new()
    value.show(&mut output)
    output.push('\n')
    let text = output.finish()
    __joky_write_stdout(&text);
}
