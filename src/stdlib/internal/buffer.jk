// Compiler-owned signatures. Only the embedded storage definition receives
// the internal Buffer identity and primitive bodies; this text grants neither.
type Buffer<T> = T

fn allocate<T>(capacity: UInt64) -> Buffer<T> {}
fn len<T>(buffer: &Buffer<T>) -> UInt64 {}
fn capacity<T>(buffer: &Buffer<T>) -> UInt64 {}
fn capacity_limit<T>() -> UInt64 {}
fn load<T>(buffer: &Buffer<T>, index: UInt64) -> T {}
fn store<T>(buffer: &mut Buffer<T>, index: UInt64, value: T) {}
fn initialize_next<T>(buffer: &mut Buffer<T>, value: T) {}
fn truncate<T>(buffer: &mut Buffer<T>, new_len: UInt64) {}
fn replace<T>(destination: &mut Buffer<T>, source: Buffer<T>) {}
