// Compiler-owned signatures. Only the embedded storage definition receives
// the internal Buffer identity and primitive bodies; this text grants neither.
type Buffer<T> = T
type Element<T> = T
type Slice<T> = T

#intrinsic("buffer.transfer")
fn transfer<T>(source: &mut Buffer<T>, destination: &mut Buffer<T>)
#intrinsic("buffer.take_last")
fn take_last<T>(source: &mut Buffer<T>) -> T
#intrinsic("buffer.allocate")
fn allocate<T>(capacity: UInt64) -> Buffer<T>
#intrinsic("buffer.len")
fn len<T>(buffer: &Buffer<T>) -> UInt64
#intrinsic("buffer.capacity")
fn capacity<T>(buffer: &Buffer<T>) -> UInt64
#intrinsic("buffer.capacity_limit")
fn capacity_limit<T>() -> UInt64
#intrinsic("buffer.load")
fn load<T: Copy>(buffer: &Buffer<T>, index: UInt64) -> T
#intrinsic("buffer.store")
fn store<T>(buffer: &mut Buffer<T>, index: UInt64, value: T)
#intrinsic("buffer.initialize_next")
fn initialize_next<T>(buffer: &mut Buffer<T>, value: T)
#intrinsic("buffer.truncate")
fn truncate<T>(buffer: &mut Buffer<T>, new_len: UInt64)
#intrinsic("buffer.replace")
fn replace<T>(destination: &mut Buffer<T>, source: Buffer<T>)
#intrinsic("buffer.release")
fn release<T>(buffer: Buffer<T>)

#intrinsic("buffer.borrow")
fn borrow<T: Copy>(buffer: &Buffer<T>, index: UInt64) -> &Element<T>
#intrinsic("buffer.borrow_ref")
fn borrow_ref<T>(buffer: &Buffer<T>, index: UInt64) -> &T
#intrinsic("buffer.borrow_mut_ref")
fn borrow_mut_ref<T>(buffer: &mut Buffer<T>, index: UInt64) -> &mut T
#intrinsic("buffer.borrow_mut")
fn borrow_mut<T: Copy>(buffer: &mut Buffer<T>, index: UInt64) -> &mut Element<T>
#intrinsic("buffer.slice")
fn slice<T>(buffer: &Buffer<T>, start: UInt64, end: UInt64) -> &Slice<T>
#intrinsic("buffer.slice_mut")
fn slice_mut<T>(buffer: &mut Buffer<T>, start: UInt64, end: UInt64) -> &mut Slice<T>
#intrinsic("buffer.element_load")
fn element_load<T: Copy>(value: &Element<T>) -> T
#intrinsic("buffer.element_store")
fn element_store<T: Copy>(value: &mut Element<T>, next: T)
#intrinsic("buffer.slice_len")
fn slice_len<T>(values: &Slice<T>) -> UInt64
#intrinsic("buffer.slice_load")
fn slice_load<T: Copy>(values: &Slice<T>, index: UInt64) -> T
#intrinsic("buffer.slice_store")
fn slice_store<T: Copy>(values: &mut Slice<T>, index: UInt64, next: T)
#intrinsic("buffer.slice_borrow")
fn slice_borrow<T: Copy>(values: &Slice<T>, index: UInt64) -> &Element<T>
#intrinsic("buffer.slice_borrow_mut")
fn slice_borrow_mut<T: Copy>(values: &mut Slice<T>, index: UInt64) -> &mut Element<T>
#intrinsic("buffer.subslice")
fn subslice<T>(values: &Slice<T>, start: UInt64, end: UInt64) -> &Slice<T>
#intrinsic("buffer.subslice_mut")
fn subslice_mut<T>(values: &mut Slice<T>, start: UInt64, end: UInt64) -> &mut Slice<T>

#intrinsic("buffer.slice_borrow_ref")
fn slice_borrow_ref<T>(values: &Slice<T>, index: UInt64) -> &T
#intrinsic("buffer.slice_borrow_mut_ref")
fn slice_borrow_mut_ref<T>(values: &mut Slice<T>, index: UInt64) -> &mut T

#intrinsic("buffer.swap_elements")
fn swap_elements<T>(buffer: &mut Buffer<T>, first: UInt64, second: UInt64)
