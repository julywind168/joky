// Minimal text operations used below the public String/Array libraries.
import joky/internal/buffer.{type Slice}
#intrinsic("text.clone")
pub fn clone(value: &String) @noescape -> String
#intrinsic("text.bytes")
pub fn bytes(value: &String) -> &Slice<UInt8>
pub fn equals(left: &String, right: &String) @noescape -> Bool {
    let left = bytes(left)
    let right = bytes(right)
    if buffer.slice_len(left) != buffer.slice_len(right) { return false }
    var index: UInt64 = 0
    while index < buffer.slice_len(left) {
        if buffer.slice_load(left, index) != buffer.slice_load(right, index) { return false }
        index += 1
    }
    true
}
