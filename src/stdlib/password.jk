//! Password hashing and verification.
//!
//! `hash` creates an Argon2id hash with a fresh salt. Store the returned encoded
//! hash, then pass it to `verify`; a wrong password returns `Ok(false)`, while
//! malformed hashes and service failures return `Err`. `needs_rehash` identifies
//! stored hashes whose cost, salt length or output length is below the current policy.
//!
//! ```joky
//! import joky/password
//!
//! fn main() @suspends {
//!     let encoded = password.hash("example passphrase").unwrap()
//!     assert(password.verify("example passphrase", encoded.clone()).unwrap(), "matches")
//!     assert(!password.verify("wrong passphrase", encoded.clone()).unwrap(), "does not match")
//!     assert(!password.needs_rehash(encoded).unwrap(), "current parameters")
//! }
//! ```

import joky/show.{type Show}
import joky/array.{type Array}
import joky/result.{type Result, Ok, Err}
import joky/string
import joky/check
import joky/internal/buffer

pub enum PasswordError {
    InvalidHash,
    UnsupportedAlgorithm,
    ParametersOutOfRange,
    PasswordTooLong,
    Busy,
    RandomUnavailable
}
impl Show for PasswordError {
    fn show(&self, output: &mut string.StringBuilder) @noescape {
        output.push_str(
            match self {
                InvalidHash => "invalid password hash"
                UnsupportedAlgorithm => "unsupported password algorithm"
                ParametersOutOfRange => "password parameters out of range"
                PasswordTooLong => "password too long"
                Busy => "password service busy"
                RandomUnavailable => "secure randomness unavailable"
            }
        )
    }
}

fn error(code: UInt64) -> PasswordError {
    match code {
        1 => PasswordError.InvalidHash
        2 => PasswordError.UnsupportedAlgorithm
        3 => PasswordError.ParametersOutOfRange
        4 => PasswordError.PasswordTooLong
        5 => PasswordError.Busy
        6 => PasswordError.RandomUnavailable
        _ => check.panic("Invalid password runtime status")
    }
}

extern fn __password_compute(
    operation: UInt64,
    password: String,
    encoded: String,
    error: &mut UInt64
) @suspends -> Array<UInt8>

/// Fresh 16-byte random salt; Argon2id v19, m=19456 KiB, t=2, p=1, 32-byte output.
pub fn hash(password: String) @suspends -> Result<String, PasswordError> {
    var code: UInt64 = 0
    let bytes = __password_compute(0, password, "", &mut code)
    if code != 0 {
        return Err(error(code))
    }
    Ok(String.from_utf8(bytes).unwrap())
}

/// Verifies an encoded password hash. A mismatch is `Ok(false)`, not an error.
pub fn verify(password: String, encoded: String) @suspends -> Result<Bool, PasswordError> {
    var code: UInt64 = 0
    let bytes = __password_compute(1, password, encoded, &mut code)
    if code != 0 {
        return Err(error(code))
    }
    Ok(bytes[0] != 0)
}

/// Checks whether a valid encoded hash falls below the current hashing policy.
pub fn needs_rehash(encoded: &String) -> Result<Bool, PasswordError> {
    let code = buffer.password_needs_rehash(encoded.bytes())
    if code < 2 {
        Ok(code == 1)
    } else {
        Err(error(code - 2))
    }
}
