//! Base64 encoding and decoding.
//!
//! The module functions use the standard alphabet with padding. Choose an
//! `Encoding` explicitly for URL-safe or unpadded data. Decoding rejects invalid
//! padding and noncanonical trailing bits rather than silently accepting them.
//!
//! ```joky
//! import joky/base64
//!
//! fn main() {
//!     let input = "hello"
//!     let encoded = base64.encode((&input).bytes())
//!     assert_eq(encoded, "aGVsbG8=")
//!     let decoded = String.from_utf8(base64.decode(encoded).unwrap()).unwrap()
//!     assert_eq(decoded, "hello")
//! }
//! ```

import joky/show.{type Show}
import joky/array.{type Array}
import joky/slice.{type Slice}
import joky/string
import joky/result.{type Result, Ok, Err}

pub enum DecodeError {
    InvalidLength,
    InvalidByte(UInt64),
    InvalidPadding(UInt64),
    NonCanonical(UInt64)
}
impl Show for DecodeError {
    fn show(&self, output: &mut string.StringBuilder) @noescape {
        match self {
            InvalidLength => output.push_str("invalid base64 length")
            InvalidByte(offset) => {
                output.push_str("invalid base64 character at byte ")
                offset.show(output)
            }
            InvalidPadding(offset) => {
                output.push_str("invalid base64 padding at byte ")
                offset.show(output)
            }
            NonCanonical(offset) => {
                output.push_str("non-canonical base64 at byte ")
                offset.show(output)
            }
        }
    }
}

pub struct Encoding { url: Bool, padding: Bool }

pub fn standard() -> Encoding {
    Encoding { url: false, padding: true }
}

pub fn standard_no_pad() -> Encoding {
    Encoding { url: false, padding: false }
}

pub fn url_safe() -> Encoding {
    Encoding { url: true, padding: true }
}

pub fn url_safe_no_pad() -> Encoding {
    Encoding { url: true, padding: false }
}

/// Encodes bytes with the standard alphabet and padding.
pub fn encode(bytes: &Slice<UInt8>) -> String {
    standard().encode(bytes)
}

/// Decodes strictly, rejecting invalid padding and noncanonical trailing bits.
pub fn decode(text: &String) -> Result<Array<UInt8>, DecodeError> {
    standard().decode(text)
}

fn symbol(value: UInt8, url: Bool) -> UInt8 {
    match (value, url) {
        (0 .. 26, _) => b'A' + value,
        (26 .. 52, _) => b'a' + value - 26,
        (52 .. 62, _) => b'0' + value - 52,
        (62, true) => b'-',
        (62, false) => b'+',
        (_, true) => b'_',
        _ => b'/'
    }
}

fn sextet(byte: UInt8, url: Bool) -> UInt32 {
    match (byte, url) {
        (b'A' ..= b'Z', _) => uint32(byte - b'A'),
        (b'a' ..= b'z', _) => uint32(byte - b'a') + 26,
        (b'0' ..= b'9', _) => uint32(byte - b'0') + 52,
        (b'+', false) | (b'-', true) => 62,
        (b'/', false) | (b'_', true) => 63,
        _ => 64
    }
}

impl Encoding {
    /// Encodes bytes with this alphabet and padding policy.
    pub fn encode(self, bytes: &Slice<UInt8>) -> String {
        let length = slice.len(bytes)
        let tail = length % 3
        let extra = if tail == 0 {
            uint64(0)
        } else if self.padding {
            uint64(4)
        } else {
            tail + 1
        }
        // Divide before multiplying; live byte lengths cannot exceed isize::MAX.
        var output = Array.with_capacity::<UInt8>((length / 3) * 4 + extra)
        var accumulator: UInt32 = 0
        var bits: UInt32 = 0
        var i: UInt64 = 0
        while i < length {
            accumulator = (accumulator << 8) | uint32(*slice.borrow_ref(bytes, i))
            bits += 8
            while bits >= 6 {
                bits -= 6
                output.push(symbol(uint8((accumulator >> bits) & 63), self.url))
            }
            i += 1
        }
        if bits != 0 {
            output.push(symbol(uint8((accumulator << (6 - bits)) & 63), self.url))
        }
        if self.padding {
            while output.len() % 4 != 0 {
                output.push(b'=')
            }
        }
        string.from_utf8(output).unwrap()
    }
    /// Decodes strictly, rejecting invalid padding and noncanonical trailing bits.
    pub fn decode(self, text: &String) -> Result<Array<UInt8>, DecodeError> {
        let bytes = text.bytes()
        let length = slice.len(bytes)
        if (self.padding && length % 4 != 0) || (!self.padding && length % 4 == 1) {
            return Err(DecodeError.InvalidLength)
        }
        var data_length = length
        // Only the last two symbols may be padding. Remaining '=' bytes fail below.
        if self.padding && length != 0 {
            if *slice.borrow_ref(bytes, length - 1) == b'=' {
                data_length -= 1
                if *slice.borrow_ref(bytes, length - 2) == b'=' {
                    data_length -= 1
                }
            }
        }
        var output = Array.with_capacity::<UInt8>((data_length / 4) * 3 + (data_length % 4) * 6 / 8)
        var accumulator: UInt32 = 0
        var bits: UInt32 = 0
        var i: UInt64 = 0
        while i < data_length {
            let byte = *slice.borrow_ref(bytes, i)
            let value = sextet(byte, self.url)
            if value == 64 {
                if byte == b'=' {
                    return Err(DecodeError.InvalidPadding(i))
                }
                return Err(DecodeError.InvalidByte(i))
            }
            accumulator = (accumulator << 6) | value
            bits += 6
            if bits >= 8 {
                bits -= 8
                output.push(uint8(accumulator >> bits))
            }
            i += 1
        }
        if bits != 0 && (accumulator & ((1 << bits) - 1)) != 0 {
            return Err(DecodeError.NonCanonical(data_length - 1))
        }
        Ok(output)
    }
}
