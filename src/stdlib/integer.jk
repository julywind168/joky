    /// Converts to UInt16, returning None if the value is out of range.
    pub fn to_u16(self) -> Option<UInt16> {
        if self > 65535 {
            return None
        };
        Some(uint16(self))
    }
    /// Returns the Unicode scalar value as an unsigned integer.
    pub fn to_u32(self) -> Option<UInt32> {
        if self > 4294967295 {
            return None
        };
        Some(uint32(self))
    }
    /// Converts to UInt64, returning None if the value is out of range.
    pub fn to_u64(self) -> Option<UInt64> {
        Some(uint64(self))
    }
}

// This private definition is bound by identity only in this embedded module.
#intrinsic("integer.rune_from_valid_u32")
fn rune_from_valid_u32(value: UInt32) -> Rune

impl Rune {
    /// Converts a Unicode scalar value to a Rune, rejecting surrogate values and values above U+10FFFF.
    pub fn from_u32(value: UInt32) -> Option<Rune> {
        if value > 0x10ffff {
            return None
        }
        if value >= 0xd800 && value <= 0xdfff {
            return None
        }
        Some(rune_from_valid_u32(value))
    }
    /// Returns the Unicode scalar value as an unsigned integer.
    pub fn to_u32(self) -> UInt32 {
        uint32(self)
    }
}
