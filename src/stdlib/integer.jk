//! Integer bounds, checked arithmetic, conversions and decimal parsing.
//!
//! Integer methods are available through the default prelude. `parse` accepts
//! decimal text and reports a byte offset for syntax or range errors.
//! Use `checked_add`, `checked_sub`, `checked_mul` and `to_i*` / `to_u*`
//! conversions when an out-of-range value should become `None`.
//!
//! ```joky
//! fn main() {
//!     let value = Int32.parse("42").unwrap()
//!     assert_eq(value.checked_add(8).unwrap(), 50)
//!     assert(Int32.MAX.checked_add(1).is_none(), "overflow is explicit")
//!     assert(Int32.parse("256").unwrap().to_u8().is_none(), "conversion is checked")
//! }
//! ```

import joky/option.{type Option, Some, None}
import joky/result
import joky/internal/text
import joky/internal/buffer

/// Reasons decimal text could not be parsed into the requested integer type.
pub enum ParseIntError {
    /// The decimal syntax is invalid at the indicated byte offset.
    InvalidSyntax(UInt64),
    /// The digit at the given byte offset would exceed the target type's range.
    OutOfRange(UInt64)
}

// Return the checked value's bit pattern so Int64.MIN never needs a positive Int64.
fn parse_decimal(
    input: &String,
    maximum: UInt64,
    signed: Bool
) -> result.Result<UInt64, ParseIntError> {
    let bytes = text.bytes(input)
    let length = buffer.slice_len(bytes)
    if length == 0 {
        return result.Err(ParseIntError.InvalidSyntax(0))
    }
    let first = buffer.slice_load(bytes, 0)
    let negative = first == 45
    if negative && !signed {
        return result.Err(ParseIntError.InvalidSyntax(0))
    }
    var offset: UInt64 = if negative || first == 43 {
        1
    } else {
        0
    }
    if offset == length {
        return result.Err(ParseIntError.InvalidSyntax(offset))
    }
    let limit = if negative {
        maximum + 1
    } else {
        maximum
    }
    let cutoff = limit / 10
    let last_digit = limit % 10
    var value: UInt64 = 0
    while offset < length {
        let byte = buffer.slice_load(bytes, offset)
        if byte < 48 || byte > 57 {
            return result.Err(ParseIntError.InvalidSyntax(offset))
        }
        let digit = uint64(byte - 48)
        if value > cutoff || (value == cutoff && digit > last_digit) {
            return result.Err(ParseIntError.OutOfRange(offset))
        }
        value = value * 10 + digit
        offset += 1
    }
    result.Ok(
        if negative {
            0 - value
        } else {
            value
        }
    )
}

// Checked integer conversions are ordinary Joky methods generated as a
// full matrix over the eight integer types; every range bound is written
// in the source type's own context.

impl Int8 {
    /// The least representable value of this integer type.
    pub const MIN: Int8 = -128
    /// The greatest representable value of this integer type.
    pub const MAX: Int8 = 127

    /// Parses decimal text and checks that the result fits the requested integer type.
    pub fn parse(input: &String) -> result.Result<Int8, ParseIntError> {
        result.Ok(int8(parse_decimal(input, uint64(Int8.MAX), true)?))
    }

    /// Returns the sum, or None if it overflows this integer type.
    pub fn checked_add(self, other: Self) -> Option<Self> {
        (int64(self) + int64(other)).to_i8()
    }
    /// Returns the difference, or None if it overflows this integer type.
    pub fn checked_sub(self, other: Self) -> Option<Self> {
        (int64(self) - int64(other)).to_i8()
    }
    /// Returns the product, or None if it overflows this integer type.
    pub fn checked_mul(self, other: Self) -> Option<Self> {
        (int64(self) * int64(other)).to_i8()
    }

    /// Converts to Int8, returning None if the value is out of range.
    pub fn to_i8(self) -> Option<Int8> {
        Some(int8(self))
    }
    /// Converts to Int16, returning None if the value is out of range.
    pub fn to_i16(self) -> Option<Int16> {
        Some(int16(self))
    }
    /// Converts to Int32, returning None if the value is out of range.
    pub fn to_i32(self) -> Option<Int32> {
        Some(int32(self))
    }
    /// Converts to Int64, returning None if the value is out of range.
    pub fn to_i64(self) -> Option<Int64> {
        Some(int64(self))
    }
    /// Converts to UInt8, returning None if the value is out of range.
    pub fn to_u8(self) -> Option<UInt8> {
        if self < 0 {
            return None
        };
        Some(uint8(self))
    }
    /// Converts to UInt16, returning None if the value is out of range.
    pub fn to_u16(self) -> Option<UInt16> {
        if self < 0 {
            return None
        };
        Some(uint16(self))
    }
    /// Returns the Unicode scalar value as an unsigned integer.
    pub fn to_u32(self) -> Option<UInt32> {
        if self < 0 {
            return None
        };
        Some(uint32(self))
    }
    /// Converts to UInt64, returning None if the value is out of range.
    pub fn to_u64(self) -> Option<UInt64> {
        if self < 0 {
            return None
        };
        Some(uint64(self))
    }
}

impl Int16 {
    /// The least representable value of this integer type.
    pub const MIN: Int16 = -32768
    /// The greatest representable value of this integer type.
    pub const MAX: Int16 = 32767

    /// Parses decimal text and checks that the result fits the requested integer type.
    pub fn parse(input: &String) -> result.Result<Int16, ParseIntError> {
        result.Ok(int16(parse_decimal(input, uint64(Int16.MAX), true)?))
    }

    /// Returns the sum, or None if it overflows this integer type.
    pub fn checked_add(self, other: Self) -> Option<Self> {
        (int64(self) + int64(other)).to_i16()
    }
    /// Returns the difference, or None if it overflows this integer type.
    pub fn checked_sub(self, other: Self) -> Option<Self> {
        (int64(self) - int64(other)).to_i16()
    }
    /// Returns the product, or None if it overflows this integer type.
    pub fn checked_mul(self, other: Self) -> Option<Self> {
        (int64(self) * int64(other)).to_i16()
    }

    /// Converts to Int8, returning None if the value is out of range.
    pub fn to_i8(self) -> Option<Int8> {
        if self < -128 {
            return None
        };
        if self > 127 {
            return None
        };
        Some(int8(self))
    }
    /// Converts to Int16, returning None if the value is out of range.
    pub fn to_i16(self) -> Option<Int16> {
        Some(int16(self))
    }
    /// Converts to Int32, returning None if the value is out of range.
    pub fn to_i32(self) -> Option<Int32> {
        Some(int32(self))
    }
    /// Converts to Int64, returning None if the value is out of range.
    pub fn to_i64(self) -> Option<Int64> {
        Some(int64(self))
    }
    /// Converts to UInt8, returning None if the value is out of range.
    pub fn to_u8(self) -> Option<UInt8> {
        if self < 0 {
            return None
        };
        if self > 255 {
            return None
        };
        Some(uint8(self))
    }
    /// Converts to UInt16, returning None if the value is out of range.
    pub fn to_u16(self) -> Option<UInt16> {
        if self < 0 {
            return None
        };
        Some(uint16(self))
    }
    /// Returns the Unicode scalar value as an unsigned integer.
    pub fn to_u32(self) -> Option<UInt32> {
        if self < 0 {
            return None
        };
        Some(uint32(self))
    }
    /// Converts to UInt64, returning None if the value is out of range.
    pub fn to_u64(self) -> Option<UInt64> {
        if self < 0 {
            return None
        };
        Some(uint64(self))
    }
}

