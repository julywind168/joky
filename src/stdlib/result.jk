//! Success and error values with propagation and transformation methods.

// The standard fallible value. Either payload may own resources.
import joky/option.{type Option, Some, None}
import joky/check

enum Result<T, E> { Ok(T), Err(E) }

impl<T, E> Result<T, E> {
    // An explicit assertion for callers that consider rejection a task failure.
    fn unwrap(self) -> T {
        match self {
            Ok(value) => value
            Err(_) => { check.panic("Called Result.unwrap on Err") }
        }
    }

    fn expect(self, message: &String) @noescape(message) -> T {
        match self {
            Ok(value) => value
            Err(_) => { check.panic(message) }
        }
    }

    fn map<U, F: FnOnce(T) -> U>(self, transform: F) -> Result<U, E> {
        match self { Ok(value) => Ok(transform(value)), Err(error) => Err(error) }
    }

    fn map_or<U, F: FnOnce(T) -> U>(self, fallback: U, transform: F) @noescape(transform) -> U {
        match self { Ok(value) => transform(value), Err(_) => fallback }
    }

    fn map_err<U, F: FnOnce(E) -> U>(self, transform: F) -> Result<T, U> {
        match self { Ok(value) => Ok(value), Err(error) => Err(transform(error)) }
    }

    fn inspect_err<F: FnOnce(&E) @noescape -> Unit>(self, inspect: F) @noescape(inspect) -> Self {
        match self {
            Ok(value) => Ok(value)
            Err(error) => { inspect(&error); Err(error) }
        }
    }

    fn and_then<U, F: FnOnce(T) -> Result<U, E>>(self, transform: F) -> Result<U, E> {
        match self { Ok(value) => transform(value), Err(error) => Err(error) }
    }

    fn is_ok(&self) -> Bool {
        match self { Ok(_) => true, Err(_) => false }
    }

    fn is_err(&self) -> Bool {
        match self { Ok(_) => false, Err(_) => true }
    }

    // Only the error branch invokes the consuming callback.
    fn unwrap_or_else<F: FnOnce(E) -> T>(self, fallback: F) -> T {
        match self { Ok(value) => value, Err(error) => fallback(error) }
    }

    // The fallback is evaluated even when this result already contains a value.
    fn unwrap_or(self, fallback: T) -> T {
        match self { Ok(value) => value, Err(_) => fallback }
    }

    fn ok(self) -> Option<T> {
        match self { Ok(value) => Some(value), Err(_) => None }
    }

    fn err(self) -> Option<E> {
        match self { Ok(_) => None, Err(error) => Some(error) }
    }

    // The next result is evaluated eagerly; the receiver's error takes priority.
    fn and<U>(self, next: Result<U, E>) -> Result<U, E> {
        match self {
            Ok(value) => next
            Err(error) => Err(error)
        }
    }

    // Both arguments are evaluated; an existing success keeps its payload.
    fn or<F>(self, fallback: Result<T, F>) -> Result<T, F> {
        match self { Ok(value) => Ok(value), Err(_) => fallback }
    }
}

impl<T, E> Result<Result<T, E>, E> {
    fn flatten(self) -> Result<T, E> {
        match self { Ok(value) => value, Err(error) => Err(error) }
    }
}

// Option depends on this module's Result constructors, so these methods live
// in the Result module and extend the standard Option type without a source
// import cycle.
impl<T> Option<T> {
    fn ok_or<E>(self, error: E) -> Result<T, E> {
        match self { Some(value) => Ok(value), None => Err(error) }
    }

    fn ok_or_else<E, F: FnOnce() -> E>(self, make_error: F) @noescape(make_error) -> Result<T, E> {
        match self { Some(value) => Ok(value), None => Err(make_error()) }
    }
}
