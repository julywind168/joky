import joky/string as text
// By-value equality for reference-free Copy keys. Equality must be stable.
pub trait Eq { fn eq(self, other: Self) -> Bool }
impl Eq for Int32 { fn eq(self, other: Self) -> Bool { self == other } }
impl Eq for Int64 { fn eq(self, other: Self) -> Bool { self == other } }
impl Eq for UInt32 { fn eq(self, other: Self) -> Bool { self == other } }
impl Eq for UInt64 { fn eq(self, other: Self) -> Bool { self == other } }
impl Eq for Bool { fn eq(self, other: Self) -> Bool { self == other } }
impl Eq for Unit { fn eq(self, other: Self) -> Bool { true } }

// Borrowed equality must not retain either argument beyond this call.
pub trait BorrowEq { fn eq_ref(&self, other: &Self) @noescape -> Bool }
impl<T: Eq> BorrowEq for T {
    fn eq_ref(&self, other: &Self) -> Bool { Eq.eq(memory.read(self), memory.read(other)) }
}
impl BorrowEq for String {
    fn eq_ref(&self, other: &String) -> Bool { text.equals(self, other) }
}
