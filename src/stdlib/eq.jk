//! Equality comparison traits.

import joky/internal/text

// Equality borrows both values. Map/Set keys additionally require an equivalence relation.
pub trait Eq { fn eq(&self, other: &Self) @noescape -> Bool }
impl Eq for Int8 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for Int16 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for Int32 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for Int64 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for UInt8 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for UInt16 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for UInt32 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for UInt64 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for Bool { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for Rune { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for Unit { fn eq(&self, other: &Self) -> Bool { true } }
impl Eq for String { fn eq(&self, other: &Self) -> Bool { text.equals(self, other) } }
// IEEE equality is available without granting floats a Hash implementation.
impl Eq for Float32 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
impl Eq for Float64 { fn eq(&self, other: &Self) -> Bool { (*self) == (*other) } }
