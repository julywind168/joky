//! Embedded Joky virtual machines and scripts.
//!
//! A `Vm` owns an embedded compiler and module registry. Prefer typed
//! `load_source`, `require` and `try_call` methods over the legacy status-code
//! functions. Shared owners refer to the same registry; explicitly closing one
//! closes all aliases. Typed script entries take one input and use `@suspends`.
//!
//! ```joky
//! import joky/vm
//!
//! fn main() @suspends {
//!     let engine = vm.Vm.interpreter()
//!     let answer = engine.require::<Int32, Int32>("answer").unwrap()
//!     engine.load_source(r"pub fn answer(value: Int32) @suspends -> Int32 { value * 2 }").unwrap()
//!     assert_eq(answer.try_call(engine, 21).unwrap(), 42)
//! }
//! ```

// A VM owns its registry entry; shared borrows allow calls during hot reload.
import joky/show.{type Show}
import joky/internal/buffer.{type Buffer}
import joky/fs
import joky/result.{type Result, Ok, Err}
import joky/string.{type StringBuilder, type Utf8Error}
import joky/iter.{range}

extern fn __vm_create(mode: UInt64) -> vm.Owner
extern fn __vm_share(owner: &vm.Owner) @suspends -> vm.Owner
extern fn __vm_close(owner: &vm.Owner) -> Int32
extern fn __vm_error_code() -> Int32
extern fn __vm_print_error()
/// A VM-managed function handle for dynamically calling loaded code.
pub type Function = vm.Function
/// Owns an embedded Joky virtual machine and its loaded modules.
pub struct Vm { owner: vm.Owner }
impl Vm {
    /// Creates an embedded VM using the JIT backend.
    pub fn new() -> Self {
        Vm { owner: __vm_create(0) }
    }
    /// Creates an embedded VM using the bytecode interpreter.
    pub fn interpreter() -> Self {
        Vm { owner: __vm_create(1) }
    }
    /// Share the control identity; closing any owner closes all aliases.
    pub fn share(&self) @suspends -> Self {
        Vm { owner: __vm_share(&self.owner) }
    }
    /// Consumes and closes the VM owner, returning the host status code.
    pub fn close(self) -> Int32 {
        __vm_close(&self.owner)
    }
}

/// Consumes and closes the VM owner, returning the host status code.
pub fn close(value: Vm) -> Int32 {
    value.close()
}

/// Returns the current embedded-VM error code.
pub fn error_code() -> Int32 {
    __vm_error_code()
}

/// Writes the current embedded-VM error message to diagnostic output.
pub fn print_error() {
    __vm_print_error()
}

extern fn __vm_domain_schema(owner: &vm.Owner) -> UInt64

/// Returns the current state-domain schema identity for this VM.
pub fn domain_schema(value: &Vm) -> UInt64 {
    __vm_domain_schema(&value.owner)
}

extern fn __vm_prepare_migration(
    owner: &vm.Owner,
    schema: UInt64,
    source: &String,
    method: &String
) -> Int32

/// Prepares a state-domain migration from the specified source and transform.
pub fn prepare_migration(value: &Vm, schema: UInt64, source: &String, method: &String) -> Int32 {
    __vm_prepare_migration(&value.owner, schema, source, method)
}

extern fn __vm_begin_migration(
    owner: &vm.Owner,
    schema: UInt64,
    source: &String,
    start: &String,
    advance: &String
) -> Int32

/// Starts an incremental state-domain migration using the named entry functions.
pub fn begin_migration(
    value: &Vm,
    schema: UInt64,
    source: &String,
    start: &String,
    advance: &String
) -> Int32 {
    __vm_begin_migration(&value.owner, schema, source, start, advance)
}

extern fn __vm_step_migration(owner: &vm.Owner, budget: UInt64) -> Int32

/// Advances the current migration with the supplied work budget.
pub fn step_migration(value: &Vm, budget: UInt64) -> Int32 {
    __vm_step_migration(&value.owner, budget)
}

extern fn __vm_begin_migration_batch(owner: &vm.Owner, source: &String) -> Int32

/// Begins a batch of migrations from the supplied source.
pub fn begin_migration_batch(value: &Vm, source: &String) -> Int32 {
    __vm_begin_migration_batch(&value.owner, source)
}

extern fn __vm_stage_migration(owner: &vm.Owner, start: &String, advance: &String) -> Int32

/// Stages another incremental migration in the active batch.
pub fn stage_migration(value: &Vm, start: &String, advance: &String) -> Int32 {
    __vm_stage_migration(&value.owner, start, advance)
}

extern fn __vm_publish_migration(owner: &vm.Owner) -> Int32

/// Attempts to publish the prepared migration or migration batch.
pub fn publish_migration(value: &Vm) -> Int32 {
    __vm_publish_migration(&value.owner)
}

extern fn __vm_cancel_migration(owner: &vm.Owner) -> Int32

/// Cancels the VM's pending migration.
pub fn cancel_migration(value: &Vm) -> Int32 {
    __vm_cancel_migration(&value.owner)
}

extern fn __vm_module_count(owner: &vm.Owner) -> Int32

/// Reports the number of modules currently loaded in the VM.
pub fn module_count(value: &Vm) -> Int32 {
    __vm_module_count(&value.owner)
}

extern fn __vm_print_modules(owner: &vm.Owner) -> Int32

/// Writes the VM's loaded-module diagnostics and returns the host status.
pub fn print_modules(value: &Vm) -> Int32 {
    __vm_print_modules(&value.owner)
}

extern fn __vm_publish_domain_code(owner: &vm.Owner) -> Int32

/// Publishes loaded state-domain code for the VM.
pub fn publish_domain_code(value: &Vm) -> Int32 {
    __vm_publish_domain_code(&value.owner)
}

extern fn __vm_load_source(owner: &vm.Owner, source: &String) -> Int32

/// Loads source into the embedded VM. The module function returns a host status code.
pub fn load_source(value: &Vm, source: &String) -> Int32 {
    __vm_load_source(&value.owner, source)
}

extern fn __vm_reload_source(owner: &vm.Owner, source: &String) -> Int32

/// Replaces loaded source in the embedded VM and returns the host status.
pub fn reload_source(value: &Vm, source: &String) -> Int32 {
    __vm_reload_source(&value.owner, source)
}

