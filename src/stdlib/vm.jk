struct Packet { storage: Buffer<UInt64> }

#intrinsic("vm.schema")
fn schema<T>() -> String

#intrinsic("vm.pack")
fn pack<T>(value: T) -> Packet

#intrinsic("vm.unpack")
fn unpack<T>(packet: &Packet) -> T

extern fn __vm_call(
    owner: &vm.Owner,
    name: String,
    input_schema: String,
    result_schema: String,
    packet: &mut Buffer<UInt64>,
    checked: Bool
) @suspends -> Int32
pub enum CallError { Unavailable, Incompatible, Failed }
impl Show for CallError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(
            match self {
                Unavailable => "script entry unavailable"
                Incompatible => "incompatible script entry"
                Failed => "script call failed"
            }
        )
    }
}

impl Vm {
    pub fn call<A, R>(&self, name: String, input: A) @suspends -> R {
        var packet = pack(input)
        __vm_call(&self.owner, name, schema::<A>(), schema::<R>(), &mut packet.storage, false)
        unpack::<R>(&packet)
    }
}

impl Vm {
    pub fn try_call<A, R>(&self, name: String, input: A) @suspends -> Result<R, CallError> {
        var packet = pack(input)
        let status = __vm_call(
            &self.owner,
            name,
            schema::<A>(),
            schema::<R>(),
            &mut packet.storage,
            true
        )
        if status == 0 {
            Ok(unpack::<R>(&packet))
        } else if status == 1 {
            Err(CallError.Unavailable)
        } else if status == 2 {
            Err(CallError.Incompatible)
        } else {
            Err(CallError.Failed)
        }
    }
}

pub struct Diagnostic {
    pub message: String,
    pub has_span: Bool,
    pub start: UInt64,
    pub end: UInt64
}
impl Show for Diagnostic {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(&self.message)
        if self.has_span {
            output.push_str(" at bytes ")
            self.start.show(output)
            output.push_str("..")
            self.end.show(output)
        }
    }
}

pub enum LoadErrorKind {
    Io(fs.IoError),
    Utf8(Utf8Error),
    Compile(Diagnostic),
    Incompatible(Diagnostic),
    Conflict(Diagnostic),
    Runtime(Diagnostic)
}
impl Show for LoadErrorKind {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            Io(error) => error.show(output)
            Utf8(error) => error.show(output)
            Compile(error) => {
                output.push_str("script compilation failed: ")
                error.show(output)
            }
            Incompatible(error) => {
                output.push_str("incompatible script: ")
                error.show(output)
            }
            Conflict(error) => {
                output.push_str("script publication conflict: ")
                error.show(output)
            }
            Runtime(error) => {
                output.push_str("script runtime failure: ")
                error.show(output)
            }
        }
    }
}

pub struct LoadError { pub path: String, pub kind: LoadErrorKind }
impl Show for LoadError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        if !self.path.is_empty() {
            output.push_str(&self.path)
            output.push_str(": ")
        }
        self.kind.show(output)
    }
}

extern fn __vm_source(
    owner: &vm.Owner,
    name: String,
    source: String,
    mode: UInt64,
    packet: &mut Buffer<UInt64>
) @suspends -> String

fn source_result(value: &Vm, path: String, source: String, mode: UInt64) @suspends -> Result<
    UInt64,
    LoadError
> {
    var packet = buffer.allocate::<UInt64>(5)
    for _ in range(0, 5) {
        buffer.initialize_next(&mut packet, 0)
    }
    let message = __vm_source(&value.owner, path.clone(), source, mode, &mut packet)
    let code = buffer.load(&packet, 0)
    if code == 0 {
        return Ok(buffer.load(&packet, 4))
    }
    let diagnostic = Diagnostic {
        message: message,
        has_span: buffer.load(&packet, 3) != 0,
        start: buffer.load(&packet, 1),
        end: buffer.load(&packet, 2)
    }
    let kind = match code {
        1 => LoadErrorKind.Compile(diagnostic)
        2 => LoadErrorKind.Incompatible(diagnostic)
        3 => LoadErrorKind.Conflict(diagnostic)
        _ => LoadErrorKind.Runtime(diagnostic)
    }
    Err(LoadError { path: path, kind: kind })
}

fn file_text(path: String) @suspends -> Result<String, LoadError> {
    var file = match fs.open(&path, fs.OpenOptions.default()) {
        Ok(file) => file
        Err(error) => {
            return Err(LoadError { path: path, kind: LoadErrorKind.Io(error) })
        }
    }
    let read = file.read_text()
    // Close before compilation/publication, including read and decoding failures.
    let closed = file.close()
    let source = match read {
        Ok(source) => source
        Err(error) => {
            let kind = match error {
                fs.ReadTextError.Io(error) => LoadErrorKind.Io(error)
                fs.ReadTextError.Utf8(error) => LoadErrorKind.Utf8(error)
            }
            return Err(LoadError { path: path, kind: kind })
        }
    }
    match closed {
        Ok(_) => {}
        Err(error) => {
            return Err(LoadError { path: path, kind: LoadErrorKind.Io(error) })
        }
    }
    Ok(source)
}

fn file_result(value: &Vm, path: String, publish: Bool) @suspends -> Result<UInt64, LoadError> {
    let source = match file_text(path.clone()) {
        Ok(source) => source,
        Err(error) => return Err(error)
    }
    source_result(
        value,
        path,
        source,
        if publish {
            1
        } else {
            0
        }
    )
}

fn loaded(result: Result<UInt64, LoadError>) -> Result<Unit, LoadError> {
    match result {
        Ok(_) => Ok({}),
        Err(error) => Err(error)
    }
}

impl Vm {
    pub fn load_source(&self, source: String) @suspends -> Result<Unit, LoadError> {
        loaded(source_result(self, "<source>", source, 0))
    }
    pub fn publish_source(&self, source: String) @suspends -> Result<UInt64, LoadError> {
        source_result(self, "<source>", source, 1)
    }
    pub fn load_file(&self, path: String) @suspends -> Result<Unit, LoadError> {
        loaded(file_result(self, path, false))
    }
    pub fn publish_file(&self, path: String) @suspends -> Result<UInt64, LoadError> {
        file_result(self, path, true)
    }
}

impl Vm {
    /// Register all host contracts before the initial load. Future loads and
    /// publications validate the complete set before installing any code.
    pub fn require<A, R>(&self, name: String) @suspends -> Result<Entry<A, R>, LoadError> {
        let input = schema::<A>()
        let output = schema::<R>()
        source_result(self, name.clone(), "{input}\n{output}", 2)?
        Ok(Entry { name: name })
    }
    pub fn module_source(&self, name: String, source: String) @suspends -> Result<Unit, LoadError> {
        loaded(source_result(self, name, source, 3))
    }
    pub fn module_file(&self, name: String, path: String) @suspends -> Result<Unit, LoadError> {
        let source = match file_text(path) {
            Ok(source) => source,
            Err(error) => return Err(error)
        }
        self.module_source(name, source)
    }
}

// A typed entry name. Each invocation validates the selected VM's current code;
// this descriptor neither owns a VM nor pins a code generation.
#derive(Clone)
pub struct Entry<A, R> { name: String }
impl<A, R> Entry<A, R> {
    pub fn call(&self, engine: &Vm, input: A) @suspends -> R {
        engine.call::<A, R>(self.name.clone(), input)
    }
    pub fn try_call(&self, engine: &Vm, input: A) @suspends -> Result<R, CallError> {
        engine.try_call::<A, R>(self.name.clone(), input)
    }
}
impl LoadError {
    pub fn message(&self) -> String {
        match &self.kind {
            Io(error) => error.message.clone(),
            Utf8(_) => "Script is not UTF-8",
            Compile(error) => error.message.clone(),
            Incompatible(error) => error.message.clone(),
            Conflict(error) => error.message.clone(),
            Runtime(error) => error.message.clone()
        }
    }
}

/// One owning session reserves the VM's migration slot until it is dropped.
pub struct Migration { owner: vm.MigrationOwner }
pub enum MigrationErrorKind { Compile, Incompatible, Conflict, Runtime, Busy, Unavailable }
impl Show for MigrationErrorKind {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(
            match self {
                Compile => "migration compilation failed"
                Incompatible => "incompatible migration"
                Conflict => "migration conflict"
                Runtime => "migration runtime failure"
                Busy => "migration busy"
                Unavailable => "migration unavailable"
            }
        )
    }
}

pub struct MigrationError { pub kind: MigrationErrorKind, pub diagnostic: Diagnostic }
impl Show for MigrationError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        self.kind.show(output)
        if !self.diagnostic.message.is_empty() {
            output.push_str(": ")
            self.diagnostic.show(output)
        }
    }
}

extern fn __vm_migration_open(owner: &vm.Owner) @suspends -> vm.MigrationOwner
extern fn __vm_migration_command(
    owner: &mut vm.MigrationOwner,
    operation: UInt64,
    number: UInt64,
    source: String,
    start: String,
    advance: String,
    packet: &mut Buffer<UInt64>
) @suspends -> UInt64
extern fn __vm_migration_diagnostic(owner: &mut vm.MigrationOwner) @suspends -> String

impl Vm {
    pub fn migration(&self) @suspends -> Result<Migration, MigrationError> {
        var session = Migration { owner: __vm_migration_open(&self.owner) }
        session.command(0, 0, "", "", "")?
        Ok(session)
    }
}
impl Migration {
    fn command(
        &mut self,
        operation: UInt64,
        number: UInt64,
        source: String,
        start: String,
        advance: String
    ) @suspends -> Result<UInt64, MigrationError> {
        var packet = buffer.allocate::<UInt64>(4)
        for _ in range(0, 4) {
            buffer.initialize_next(&mut packet, 0)
        }
        let status = __vm_migration_command(
            &mut self.owner,
            operation,
            number,
            source,
            start,
            advance,
            &mut packet
        )
        if status == 0 {
            return Ok(buffer.load(&packet, 0))
        }
        let kind = match status {
            1 => MigrationErrorKind.Compile
            2 => MigrationErrorKind.Incompatible
            3 => MigrationErrorKind.Conflict
            5 => MigrationErrorKind.Busy
            6 => MigrationErrorKind.Unavailable
            _ => MigrationErrorKind.Runtime
        }
        Err(MigrationError { kind: kind, diagnostic: Diagnostic {
                    message: __vm_migration_diagnostic(&mut self.owner),
                    has_span: buffer.load(&packet, 3) != 0,
                    start: buffer.load(&packet, 1),
                    end: buffer.load(&packet, 2)
                } })
    }
    pub fn schema(&mut self) @suspends -> Result<UInt64, MigrationError> {
        self.command(1, 0, "", "", "")
    }
    pub fn prepare(&mut self, schema: UInt64, source: String, method: String) @suspends -> Result<
        Unit,
        MigrationError
    > {
        self.command(2, schema, source, method, "")?
        Ok({})
    }
    pub fn begin(&mut self, schema: UInt64, source: String, start: String, advance: String) @suspends ->
        Result<Unit, MigrationError> {
        self.command(3, schema, source, start, advance)?
        Ok({})
    }
    pub fn begin_batch(&mut self, source: String) @suspends -> Result<Unit, MigrationError> {
        self.command(4, 0, source, "", "")?
        Ok({})
    }
    pub fn stage(&mut self, start: String, advance: String) @suspends -> Result<
        Unit,
        MigrationError
    > {
        self.command(5, 0, "", start, advance)?
        Ok({})
    }
    /// true means complete; budget is a hint to the synchronous migration callback.
    pub fn step(&mut self, budget: UInt64) @suspends -> Result<Bool, MigrationError> {
        Ok(self.command(6, budget, "", "", "")? == 0)
    }
    pub fn publish(var self) @suspends -> Result<Unit, MigrationError> {
        self.command(7, 0, "", "", "")?
        Ok({})
    }
    pub fn cancel(var self) @suspends -> Result<Unit, MigrationError> {
        self.command(8, 0, "", "", "")?
        Ok({})
    }
}
