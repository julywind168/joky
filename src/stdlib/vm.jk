//! Embedded Joky virtual machines and scripts.
//!
//! A `Vm` owns an embedded compiler and module registry. Prefer typed
//! `load_source`, `require` and `try_call` methods over the legacy status-code
//! functions. Shared owners refer to the same registry; explicitly closing one
//! closes all aliases. Typed script entries take one input and use `@suspends`.
//!
//! ```joky
//! import joky/vm
//!
//! fn main() @suspends {
//!     let engine = vm.Vm.interpreter()
//!     let answer = engine.require::<Int32, Int32>("answer").unwrap()
//!     engine.load_source(r"pub fn answer(value: Int32) @suspends -> Int32 { value * 2 }").unwrap()
//!     assert_eq(answer.try_call(engine, 21).unwrap(), 42)
//! }
//! ```

// A VM owns its registry entry; shared borrows allow calls during hot reload.
import joky/show.{type Show}
import joky/internal/buffer.{type Buffer}
import joky/fs
import joky/result.{type Result, Ok, Err}
import joky/string.{type StringBuilder, type Utf8Error}
import joky/iter.{range}

extern fn __vm_create(mode: UInt64) -> vm.Owner
extern fn __vm_share(owner: &vm.Owner) @suspends -> vm.Owner
extern fn __vm_close(owner: &vm.Owner) -> Int32
extern fn __vm_error_code() -> Int32
extern fn __vm_print_error()
pub type Function = vm.Function
pub struct Vm { owner: vm.Owner }
impl Vm {
    pub fn new() -> Self {
        Vm { owner: __vm_create(0) }
    }
    pub fn interpreter() -> Self {
        Vm { owner: __vm_create(1) }
    }
    /// Share the control identity; closing any owner closes all aliases.
    pub fn share(&self) @suspends -> Self {
        Vm { owner: __vm_share(&self.owner) }
    }
    pub fn close(self) -> Int32 {
        __vm_close(&self.owner)
    }
}

pub fn close(value: Vm) -> Int32 {
    value.close()
}

pub fn error_code() -> Int32 {
    __vm_error_code()
}

pub fn print_error() {
    __vm_print_error()
}

