// A VM owns its registry entry; shared borrows allow calls during hot reload.
import joky/internal/buffer as storage.{type Buffer}
import joky/fs
import joky/result.{type Result, Ok, Err}
import joky/string.{type Utf8Error}

extern fn __vm_create(mode: UInt64) -> vm.Owner
extern fn __vm_close(owner: &vm.Owner) -> Int32
extern fn __vm_error_code() -> Int32
extern fn __vm_print_error()
pub type Function = vm.Function
pub struct Vm { owner: vm.Owner }
impl Vm {
    pub fn new() -> Self { Vm { owner: __vm_create(0) } }
    pub fn interpreter() -> Self { Vm { owner: __vm_create(1) } }
    pub fn close(self) -> Int32 { __vm_close(&self.owner) }
}
pub fn close(value: Vm) -> Int32 { value.close() }
pub fn error_code() -> Int32 { __vm_error_code() }
pub fn print_error() { __vm_print_error() }
extern fn __vm_domain_schema(owner: &vm.Owner) -> UInt64
pub fn domain_schema(value: &Vm) -> UInt64 { __vm_domain_schema(&value.owner) }
extern fn __vm_prepare_migration(owner: &vm.Owner, schema: UInt64, source: &String, method: &String) -> Int32
pub fn prepare_migration(value: &Vm, schema: UInt64, source: &String, method: &String) -> Int32 { __vm_prepare_migration(&value.owner, schema, source, method) }
extern fn __vm_begin_migration(owner: &vm.Owner, schema: UInt64, source: &String, start: &String, advance: &String) -> Int32
pub fn begin_migration(value: &Vm, schema: UInt64, source: &String, start: &String, advance: &String) -> Int32 { __vm_begin_migration(&value.owner, schema, source, start, advance) }
extern fn __vm_step_migration(owner: &vm.Owner, budget: UInt64) -> Int32
pub fn step_migration(value: &Vm, budget: UInt64) -> Int32 { __vm_step_migration(&value.owner, budget) }
extern fn __vm_begin_migration_batch(owner: &vm.Owner, source: &String) -> Int32
pub fn begin_migration_batch(value: &Vm, source: &String) -> Int32 { __vm_begin_migration_batch(&value.owner, source) }
extern fn __vm_stage_migration(owner: &vm.Owner, start: &String, advance: &String) -> Int32
pub fn stage_migration(value: &Vm, start: &String, advance: &String) -> Int32 { __vm_stage_migration(&value.owner, start, advance) }
extern fn __vm_publish_migration(owner: &vm.Owner) -> Int32
pub fn publish_migration(value: &Vm) -> Int32 { __vm_publish_migration(&value.owner) }
extern fn __vm_cancel_migration(owner: &vm.Owner) -> Int32
pub fn cancel_migration(value: &Vm) -> Int32 { __vm_cancel_migration(&value.owner) }
extern fn __vm_module_count(owner: &vm.Owner) -> Int32
pub fn module_count(value: &Vm) -> Int32 { __vm_module_count(&value.owner) }
extern fn __vm_print_modules(owner: &vm.Owner) -> Int32
pub fn print_modules(value: &Vm) -> Int32 { __vm_print_modules(&value.owner) }
extern fn __vm_publish_domain_code(owner: &vm.Owner) -> Int32
pub fn publish_domain_code(value: &Vm) -> Int32 { __vm_publish_domain_code(&value.owner) }
extern fn __vm_load_source(owner: &vm.Owner, source: &String) -> Int32
pub fn load_source(value: &Vm, source: &String) -> Int32 { __vm_load_source(&value.owner, source) }
extern fn __vm_reload_source(owner: &vm.Owner, source: &String) -> Int32
pub fn reload_source(value: &Vm, source: &String) -> Int32 { __vm_reload_source(&value.owner, source) }
extern fn __vm_register_int32_0(owner: &vm.Owner, name: &String, function: vm.Function) -> Int32
pub fn register_int32_0(value: &Vm, name: &String, function: vm.Function) -> Int32 { __vm_register_int32_0(&value.owner, name, function) }
extern fn __vm_register_int32_1(owner: &vm.Owner, name: &String, function: vm.Function) -> Int32
pub fn register_int32_1(value: &Vm, name: &String, function: vm.Function) -> Int32 { __vm_register_int32_1(&value.owner, name, function) }
extern fn __vm_register_int32_2(owner: &vm.Owner, name: &String, function: vm.Function) -> Int32
pub fn register_int32_2(value: &Vm, name: &String, function: vm.Function) -> Int32 { __vm_register_int32_2(&value.owner, name, function) }
extern fn __vm_call_int32_0(owner: &vm.Owner, name: &String) -> Int32
pub fn call_int32_0(value: &Vm, name: &String) -> Int32 { __vm_call_int32_0(&value.owner, name) }
extern fn __vm_call_int32_1(owner: &vm.Owner, name: &String, arg0: Int32) -> Int32
pub fn call_int32_1(value: &Vm, name: &String, arg0: Int32) -> Int32 { __vm_call_int32_1(&value.owner, name, arg0) }
extern fn __vm_call_int32_2(owner: &vm.Owner, name: &String, arg0: Int32, arg1: Int32) -> Int32
pub fn call_int32_2(value: &Vm, name: &String, arg0: Int32, arg1: Int32) -> Int32 { __vm_call_int32_2(&value.owner, name, arg0, arg1) }
extern fn __vm_call_float64_0(owner: &vm.Owner, name: &String) -> Float64
pub fn call_float64_0(value: &Vm, name: &String) -> Float64 { __vm_call_float64_0(&value.owner, name) }
extern fn __vm_call_float64_1(owner: &vm.Owner, name: &String, arg0: Float64) -> Float64
pub fn call_float64_1(value: &Vm, name: &String, arg0: Float64) -> Float64 { __vm_call_float64_1(&value.owner, name, arg0) }
extern fn __vm_call_float64_2(owner: &vm.Owner, name: &String, arg0: Float64, arg1: Float64) -> Float64
pub fn call_float64_2(value: &Vm, name: &String, arg0: Float64, arg1: Float64) -> Float64 { __vm_call_float64_2(&value.owner, name, arg0, arg1) }
struct Packet { storage: Buffer<UInt64> }
#intrinsic("vm.schema")
fn schema<T>() -> String
#intrinsic("vm.pack")
fn pack<T>(value: T) -> Packet
#intrinsic("vm.unpack")
fn unpack<T>(packet: &Packet) -> T
extern fn __vm_call(owner: &vm.Owner, name: String, input_schema: String, result_schema: String, packet: &mut Buffer<UInt64>) @suspends
impl Vm {
    pub fn call<A, R>(&self, name: String, input: A) @suspends -> R {
        var packet = pack(input)
        __vm_call(&self.owner, name, schema::<A>(), schema::<R>(), &mut packet.storage)
        unpack::<R>(&packet)
    }
}

pub struct Diagnostic { pub message: String, pub has_span: Bool, pub start: UInt64, pub end: UInt64 }
pub enum LoadErrorKind {
    Io(fs.IoError), Utf8(Utf8Error), Compile(Diagnostic), Incompatible(Diagnostic),
    Conflict(Diagnostic), Runtime(Diagnostic)
}
pub struct LoadError { pub path: String, pub kind: LoadErrorKind }
extern fn __vm_source(owner: &vm.Owner, name: String, source: String, publish: Bool, packet: &mut Buffer<UInt64>) @suspends -> String

fn source_result(value: &Vm, path: String, source: String, publish: Bool) @suspends -> Result<UInt64, LoadError> {
    var packet = storage.allocate::<UInt64>(5)
    var index: UInt64 = 0
    while index < 5 { storage.initialize_next(&mut packet, 0); index += 1 }
    let message = __vm_source(&value.owner, path.clone(), source, publish, &mut packet)
    let code = storage.load(&packet, 0)
    if code == 0 { return Ok(storage.load(&packet, 4)) }
    let diagnostic = Diagnostic { message: message, has_span: storage.load(&packet, 3) != 0,
        start: storage.load(&packet, 1), end: storage.load(&packet, 2) }
    let kind = match code {
        1 => LoadErrorKind.Compile(diagnostic)
        2 => LoadErrorKind.Incompatible(diagnostic)
        3 => LoadErrorKind.Conflict(diagnostic)
        _ => LoadErrorKind.Runtime(diagnostic)
    }
    Err(LoadError { path: path, kind: kind })
}
fn file_result(value: &Vm, path: String, publish: Bool) @suspends -> Result<UInt64, LoadError> {
    var file = match fs.open(path.clone(), fs.OpenOptions.new()) {
        Ok(file) => file
        Err(error) => { return Err(LoadError { path: path, kind: LoadErrorKind.Io(error) }) }
    }
    let read = file.read_text()
    // Close before compilation/publication, including read and decoding failures.
    let closed = file.close()
    let source = match read {
        Ok(source) => source
        Err(error) => {
            let kind = match error {
                fs.ReadTextError.Io(error) => LoadErrorKind.Io(error)
                fs.ReadTextError.Utf8(error) => LoadErrorKind.Utf8(error)
            }
            return Err(LoadError { path: path, kind: kind })
        }
    }
    match closed {
        Ok(_) => {}
        Err(error) => { return Err(LoadError { path: path, kind: LoadErrorKind.Io(error) }) }
    }
    source_result(value, path, source, publish)
}
fn loaded(result: Result<UInt64, LoadError>) -> Result<Unit, LoadError> {
    match result { Ok(_) => Ok({}), Err(error) => Err(error) }
}
impl Vm {
    pub fn load_source(&self, source: String) @suspends -> Result<Unit, LoadError> {
        loaded(source_result(self, "<source>", source, false))
    }
    pub fn publish_source(&self, source: String) @suspends -> Result<UInt64, LoadError> {
        source_result(self, "<source>", source, true)
    }
    pub fn load_file(&self, path: String) @suspends -> Result<Unit, LoadError> {
        loaded(file_result(self, path, false))
    }
    pub fn publish_file(&self, path: String) @suspends -> Result<UInt64, LoadError> {
        file_result(self, path, true)
    }
}
