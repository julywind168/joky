// Owned JSON values. Codec entry points are delivered separately.
import joky/array.{type Array}
import joky/map.{type Map}
import joky/result.{type Result, Ok, Err}
import joky/string
import joky/slice as slices.{type Slice}
import joky/integer
import joky/float

pub enum Value {
    Null,
    Boolean(Bool),
    Number(Number),
    Text(String),
    Array(Array<Value>),
    Object(Map<String, Value>),
}

pub enum NumberErrorKind { InvalidSyntax, NotInteger, OutOfRange, NonFinite, NumberLimit }
pub struct NumberError { pub kind: NumberErrorKind, pub offset: UInt64 }
pub struct Number { text: String }

// Compiler-bound shared conversion. Its placeholder never executes. Only
// bounded, grammar-validated text reaches it through Number.to_f64.
fn parse_float64(text: &String) -> Float64 { 0.0 }
fn error(kind: NumberErrorKind, offset: UInt64) -> NumberError {
    NumberError { kind: kind, offset: offset }
}
fn digit(byte: UInt8) -> Bool { byte >= 48 && byte <= 57 }
fn byte_at(bytes: &Slice<UInt8>, index: UInt64) -> UInt8 {
    *slices.borrow_ref(bytes, index)
}

// The first unexpected byte (or EOF) identifies a syntax error. Length is
// checked before scanning or copying so oversized inputs need no allocation.
fn validate(text: &String) -> Result<Unit, NumberError> {
    let length = text.byte_length()
    if length > 1024 { return Err(error(NumberErrorKind.NumberLimit, 1024)) }
    let bytes = text.bytes()
    var index: UInt64 = 0
    if index < length && byte_at(bytes, index) == 45 { index = index + 1 }
    if index == length { return Err(error(NumberErrorKind.InvalidSyntax, index)) }
    let first = byte_at(bytes, index)
    if first == 48 { index = index + 1 } else {
        if first < 49 || first > 57 { return Err(error(NumberErrorKind.InvalidSyntax, index)) }
        index = index + 1
        while index < length && digit(byte_at(bytes, index)) { index = index + 1 }
    }
    if index < length && byte_at(bytes, index) == 46 {
        index = index + 1
        if index == length || !digit(byte_at(bytes, index)) {
            return Err(error(NumberErrorKind.InvalidSyntax, index))
        }
        while index < length && digit(byte_at(bytes, index)) { index = index + 1 }
    }
    if index < length && (byte_at(bytes, index) == 101 || byte_at(bytes, index) == 69) {
        index = index + 1
        if index < length && (byte_at(bytes, index) == 43 || byte_at(bytes, index) == 45) {
            index = index + 1
        }
        if index == length || !digit(byte_at(bytes, index)) {
            return Err(error(NumberErrorKind.InvalidSyntax, index))
        }
        while index < length && digit(byte_at(bytes, index)) { index = index + 1 }
    }
    if index != length { return Err(error(NumberErrorKind.InvalidSyntax, index)) }
    Ok({})
}

// Check the spelling before accumulating: a fraction/exponent is NotInteger
// even when the preceding digits exceed the requested machine range.
fn integer_end(text: &String) -> Result<Unit, NumberError> {
    let bytes = text.bytes()
    var index: UInt64 = 0
    while index < text.byte_length() {
        let byte = byte_at(bytes, index)
        if byte == 46 || byte == 101 || byte == 69 {
            return Err(error(NumberErrorKind.NotInteger, index))
        }
        index = index + 1
    }
    Ok({})
}
fn magnitude(text: &String, start: UInt64, limit: UInt64) -> Result<UInt64, NumberError> {
    let bytes = text.bytes()
    var value: UInt64 = 0
    var index = start
    while index < text.byte_length() {
        let next = uint64(byte_at(bytes, index) - 48)
        if value > limit / 10 || (value == limit / 10 && next > limit - (limit / 10) * 10) {
            return Err(error(NumberErrorKind.OutOfRange, index))
        }
        value = value * 10 + next
        index = index + 1
    }
    Ok(value)
}

impl Number {
    pub fn from_text(input: &String) -> Result<Number, NumberError> {
        match validate(input) {
            | Err(failure) => Err(failure)
            | Ok(_) => Ok(Number { text: input.clone() })
        }
    }
    pub fn from_i64(value: Int64) -> Number { Number { text: value.to_string() } }
    pub fn from_u64(value: UInt64) -> Number { Number { text: value.to_string() } }
    pub fn from_f64(value: Float64) -> Result<Number, NumberError> {
        if !value.is_finite() { return Err(error(NumberErrorKind.NonFinite, 0)) }
        let text = value.to_text()
        // The shared formatter's finite output satisfies JSON grammar and fits
        // the bound, including fixed decimal subnormals and negative zero.
        match validate(&text) {
            | Err(failure) => Err(failure)
            | Ok(_) => Ok(Number { text: text })
        }
    }
    pub fn as_text(&self) -> &String { &self.text }
    pub fn to_i64(&self) -> Result<Int64, NumberError> {
        match integer_end(&self.text) { | Err(failure) => { return Err(failure) } | Ok(_) => {} }
        let negative = byte_at(self.text.bytes(), 0) == 45
        let start: UInt64 = if negative { 1 } else { 0 }
        let limit: UInt64 = if negative { 9223372036854775808 } else { 9223372036854775807 }
        match magnitude(&self.text, start, limit) {
            | Err(failure) => Err(failure)
            | Ok(value) => {
                if negative {
                    if value == 0 { Ok(0) } else { Ok(-int64(value - 1) - 1) }
                } else { Ok(int64(value)) }
            }
        }
    }
    pub fn to_u64(&self) -> Result<UInt64, NumberError> {
        match integer_end(&self.text) { | Err(failure) => { return Err(failure) } | Ok(_) => {} }
        if byte_at(self.text.bytes(), 0) == 45 { return Err(error(NumberErrorKind.OutOfRange, 0)) }
        magnitude(&self.text, 0, 18446744073709551615)
    }
    pub fn to_f64(&self) -> Result<Float64, NumberError> {
        let value = parse_float64(&self.text)
        if !value.is_finite() { return Err(error(NumberErrorKind.OutOfRange, 0)) }
        Ok(value)
    }
}
