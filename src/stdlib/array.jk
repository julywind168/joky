// Array is a nominal, single-owner wrapper. Its storage field remains private;
// all container policies live in Joky and use checked storage/move primitives.
import joky/internal/buffer.{type Buffer}
import joky/clone as cloning.{type Clone}
import joky/eq.{type BorrowEq}
import joky/element.{type Element}
import joky/slice as slices.{type Slice}
import joky/option.{type Option, Some, None}
import joky/iter as iteration.{type Iterator, type IntoIterator, type Iter}

pub struct Array<T> { storage: Buffer<T> }
pub struct IntoIter<T> { values: Array<T> }

impl<T> IntoIterator for Array<T> {
    type IntoIter = IntoIter<T>
    fn into_iter(self) -> IntoIter<T> { into_iter(self) }
}

impl<T> Iterator for IntoIter<T> {
    type Item = T
    fn next(&mut self) -> Option<T> { pop(&mut self.values) }
}

// Reverse once so tail removal yields the original forward order. The buffer
// retains a fully initialized prefix throughout conversion and iteration;
// ordinary owner cleanup handles every early exit, including cancellation.
pub fn into_iter<T>(var values: Array<T>) -> IntoIter<T> {
    let length = len(&values)
    var index: UInt64 = 0
    while index < length / 2 {
        buffer.swap_elements(&mut values.storage, index, length - 1 - index)
        index += 1
    }
    IntoIter { values: values }
}

// Both APIs share the module algorithms without duplicating their specializations.
pub fn iter<T>(values: &Array<T>) -> &Iter<T> { buffer.iter(&values.storage) }
pub fn iter_mut<T>(values: &mut Array<T>) -> &mut Iter<T> { buffer.iter_mut(&mut values.storage) }

impl<T> Array<T> {
    pub fn iter(&self) -> &Iter<T> { iter(self) }
    pub fn iter_mut(&mut self) -> &mut Iter<T> { iter_mut(self) }

    pub fn new() -> Self { new::<T>() }
    pub fn with_capacity(capacity: UInt64) -> Self { with_capacity::<T>(capacity) }
    pub fn release(self) { release(self) }
    pub fn into_iter(self) -> IntoIter<T> { into_iter(self) }
    pub fn len(&self) -> UInt64 { len(self) }
    pub fn capacity(&self) -> UInt64 { capacity(self) }
    pub fn is_empty(&self) -> Bool { is_empty(self) }
    pub fn set(&mut self, index: UInt64, value: T) -> Bool { set(self, index, value) }
    pub fn replace(&mut self, index: UInt64, next: T) -> Option<T> { replace(self, index, next) }
    pub fn reserve(&mut self, additional: UInt64) { reserve(self, additional) }
    pub fn truncate(&mut self, length: UInt64) { truncate(self, length) }
    pub fn clear(&mut self) { clear(self) }
    pub fn swap(&mut self, first: UInt64, second: UInt64) -> Bool { swap(self, first, second) }
    pub fn push(&mut self, value: T) { push(self, value) }
    pub fn pop(&mut self) -> Option<T> { pop(self) }
    pub fn swap_remove(&mut self, index: UInt64) -> Option<T> { swap_remove(self, index) }
    pub fn remove(&mut self, index: UInt64) -> Option<T> { remove(self, index) }
    pub fn insert(&mut self, index: UInt64, value: T) -> Bool { insert(self, index, value) }
    pub fn take_last(&mut self) -> T { take_last(self) }
    pub fn borrow_ref(&self, index: UInt64) -> &T { borrow_ref(self, index) }
    pub fn borrow_mut_ref(&mut self, index: UInt64) -> &mut T { borrow_mut_ref(self, index) }
    pub fn slice(&self, start: UInt64, end: UInt64) -> &Slice<T> { slice(self, start, end) }
    pub fn slice_mut(&mut self, start: UInt64, end: UInt64) -> &mut Slice<T> { slice_mut(self, start, end) }
}

pub fn new<T>() -> Array<T> { Array { storage: buffer.allocate::<T>(0) } }
pub fn with_capacity<T>(capacity: UInt64) -> Array<T> { Array { storage: buffer.allocate::<T>(capacity) } }
pub fn release<T>(values: Array<T>) { buffer.release(values.storage) }
pub fn len<T>(values: &Array<T>) -> UInt64 { buffer.len(&values.storage) }
pub fn capacity<T>(values: &Array<T>) -> UInt64 { buffer.capacity(&values.storage) }
pub fn is_empty<T>(values: &Array<T>) -> Bool { len(values) == 0 }
pub fn get<T: Copy>(values: &Array<T>, index: UInt64) -> Option<T> {
    let values = &values.storage
    if index < buffer.len(values) { Some(buffer.load(values, index)) } else { None }
}
pub fn set<T>(values: &mut Array<T>, index: UInt64, value: T) -> Bool {
    let values = &mut values.storage
    if index < buffer.len(values) {
        buffer.store(values, index, value)
        true
    } else { false }
}
pub fn reserve<T>(values: &mut Array<T>, additional: UInt64) {
    let values = &mut values.storage
    let length = buffer.len(values)
    let capacity = buffer.capacity(values)
    let limit = buffer.capacity_limit::<T>()
    // The target layout limit is below UInt64.MAX. An unrepresentable request
    // becomes limit + 1 and fails in allocate, without wrapping any arithmetic.
    let required = if additional > limit - length { limit + 1 } else { length + additional }
    if required <= capacity { return }
    let candidate = if capacity == 0 {
        if limit < 4 { limit } else { 4 }
    } else {
        if capacity > limit - capacity { limit } else { capacity + capacity }
    }
    let next_capacity = if required > candidate { required } else { candidate }
    var next = buffer.allocate::<T>(next_capacity)
    buffer.transfer(values, &mut next)
    buffer.replace(values, next)
}
pub fn push<T>(values: &mut Array<T>, value: T) {
    reserve(values, 1)
    buffer.initialize_next(&mut values.storage, value)
}
pub fn take_last<T>(values: &mut Array<T>) -> T { buffer.take_last(&mut values.storage) }
pub fn pop<T>(values: &mut Array<T>) -> Option<T> {
    let values = &mut values.storage
    let length = buffer.len(values)
    if length == 0 { return None }
    let value = buffer.take_last(values)
    Some(value)
}
pub fn borrow<T: Copy>(values: &Array<T>, index: UInt64) -> &Element<T> { buffer.borrow(&values.storage, index) }
pub fn borrow_ref<T>(values: &Array<T>, index: UInt64) -> &T { buffer.borrow_ref(&values.storage, index) }
pub fn borrow_mut_ref<T>(values: &mut Array<T>, index: UInt64) -> &mut T { buffer.borrow_mut_ref(&mut values.storage, index) }
pub fn borrow_mut<T: Copy>(values: &mut Array<T>, index: UInt64) -> &mut Element<T> { buffer.borrow_mut(&mut values.storage, index) }
pub fn slice<T>(values: &Array<T>, start: UInt64, end: UInt64) -> &Slice<T> { buffer.slice(&values.storage, start, end) }
pub fn slice_mut<T>(values: &mut Array<T>, start: UInt64, end: UInt64) -> &mut Slice<T> { buffer.slice_mut(&mut values.storage, start, end) }

// Fill the removed position with the last element; capacity stays unchanged.
pub fn swap_remove<T>(values: &mut Array<T>, index: UInt64) -> Option<T> {
    let values = &mut values.storage
    let length = buffer.len(values)
    if index >= length { return None }
    buffer.swap_elements(values, index, length - 1)
    Some(buffer.take_last(values))
}

// Move the old element through the tail, reusing the vacated capacity.
// Owner cleanup snapshots may assert temporary runtime memory.
pub fn replace<T>(values: &mut Array<T>, index: UInt64, next: T) -> Option<T> {
    let length = len(values)
    if index >= length { return None }
    swap(values, index, length - 1)
    let old = take_last(values)
    push(values, next)
    swap(values, index, length - 1)
    Some(old)
}

// Rotate the removed element to the tail while preserving its successors.
pub fn remove<T>(values: &mut Array<T>, index: UInt64) -> Option<T> {
    let values = &mut values.storage
    let length = buffer.len(values)
    if index >= length { return None }
    var position = index
    while position < length - 1 {
        buffer.swap_elements(values, position, position + 1)
        position = position + 1
    }
    Some(buffer.take_last(values))
}

// Append first so allocation succeeds before any existing element is shifted.
pub fn insert<T>(values: &mut Array<T>, index: UInt64, value: T) -> Bool {
    let length = len(values)
    if index > length { return false }
    push(values, value)
    let values = &mut values.storage
    var position = length
    while position > index {
        buffer.swap_elements(values, position, position - 1)
        position = position - 1
    }
    true
}

// Truncation never grows the initialized prefix or reduces capacity.
pub fn truncate<T>(values: &mut Array<T>, length: UInt64) {
    let values = &mut values.storage
    if length < buffer.len(values) { buffer.truncate(values, length) }
}
pub fn clear<T>(values: &mut Array<T>) { truncate(values, 0) }
pub fn swap<T>(values: &mut Array<T>, first: UInt64, second: UInt64) -> Bool {
    let values = &mut values.storage
    let length = buffer.len(values)
    if first >= length || second >= length { return false }
    buffer.swap_elements(values, first, second)
    true
}

impl<T: Copy> Array<T> {
    pub fn get(&self, index: UInt64) -> Option<T> { get(self, index) }
    pub fn borrow(&self, index: UInt64) -> &Element<T> { borrow(self, index) }
    pub fn borrow_mut(&mut self, index: UInt64) -> &mut Element<T> { borrow_mut(self, index) }
}

impl<T: Clone> Clone for Array<T> {
    fn clone(&self) -> Self { clone(self) }
}
pub fn clone<T: Clone>(values: &Array<T>) -> Array<T> {
    var copy = with_capacity::<T>(values.len())
    for value in values { copy.push(Clone.clone(value)) }
    copy
}
impl<T: BorrowEq> Array<T> {
    pub fn contains(&self, value: &T) -> Bool { contains(self, value) }
}
pub fn contains<T: BorrowEq>(values: &Array<T>, value: &T) -> Bool {
    for item in values { if BorrowEq.eq_ref(item, value) { return true } }
    false
}
