// Array is a nominal, single-owner wrapper. Its storage field remains private;
// all container policies live in Joky and use checked storage/move primitives.
import joky/internal/buffer as storage.{type Buffer}
import joky/element.{type Element}
import joky/slice as slices.{type Slice}
import joky/option.{type Option, Some, None}

struct Array<T> { private storage: Buffer<T> }

// Both APIs share the module algorithms without duplicating their specializations.
impl<T> Array<T> {
    fn new() -> Self { new::<T>() }
    fn with_capacity(capacity: UInt64) -> Self { with_capacity::<T>(capacity) }
    fn release(self) { release(self) }
    fn len(&self) -> UInt64 { len(self) }
    fn capacity(&self) -> UInt64 { capacity(self) }
    fn is_empty(&self) -> Bool { is_empty(self) }
    fn get(&self, index: UInt64) -> Option<T> { get(self, index) }
    fn set(&mut self, index: UInt64, value: T) -> Bool { set(self, index, value) }
    fn reserve(&mut self, additional: UInt64) { reserve(self, additional) }
    fn push(&mut self, value: T) { push(self, value) }
    fn pop(&mut self) -> Option<T> { pop(self) }
    fn take_last(&mut self) -> T { take_last(self) }
    fn borrow(&self, index: UInt64) -> &Element<T> { borrow(self, index) }
    fn borrow_ref(&self, index: UInt64) -> &T { borrow_ref(self, index) }
    fn borrow_mut(&mut self, index: UInt64) -> &mut Element<T> { borrow_mut(self, index) }
    fn slice(&self, start: UInt64, end: UInt64) -> &Slice<T> { slice(self, start, end) }
    fn slice_mut(&mut self, start: UInt64, end: UInt64) -> &mut Slice<T> { slice_mut(self, start, end) }
}

fn new<T>() -> Array<T> { Array { storage: storage.allocate::<T>(0) } }
fn with_capacity<T>(capacity: UInt64) -> Array<T> { Array { storage: storage.allocate::<T>(capacity) } }
fn release<T>(values: Array<T>) { storage.release(values.storage) }
fn len<T>(values: &Array<T>) -> UInt64 { storage.len(&values.storage) }
fn capacity<T>(values: &Array<T>) -> UInt64 { storage.capacity(&values.storage) }
fn is_empty<T>(values: &Array<T>) -> Bool { len(values) == 0 }
fn get<T>(values: &Array<T>, index: UInt64) -> Option<T> {
    let values = &values.storage
    if index < storage.len(values) { Some(storage.load(values, index)) } else { None }
}
fn set<T>(values: &mut Array<T>, index: UInt64, value: T) -> Bool {
    let values = &mut values.storage
    if index < storage.len(values) {
        storage.store(values, index, value)
        true
    } else { false }
}
fn reserve<T>(values: &mut Array<T>, additional: UInt64) {
    let values = &mut values.storage
    let length = storage.len(values)
    let capacity = storage.capacity(values)
    let limit = storage.capacity_limit::<T>()
    // The target layout limit is below UInt64.MAX. An unrepresentable request
    // becomes limit + 1 and fails in allocate, without wrapping any arithmetic.
    let required = if additional > limit - length { limit + 1 } else { length + additional }
    if required <= capacity { return }
    let candidate = if capacity == 0 {
        if limit < 4 { limit } else { 4 }
    } else {
        if capacity > limit - capacity { limit } else { capacity + capacity }
    }
    let next_capacity = if required > candidate { required } else { candidate }
    var next = storage.allocate::<T>(next_capacity)
    storage.transfer(values, &mut next)
    storage.replace(values, next)
}
fn push<T>(values: &mut Array<T>, value: T) {
    reserve(values, 1)
    storage.initialize_next(&mut values.storage, value)
}
fn take_last<T>(values: &mut Array<T>) -> T { storage.take_last(&mut values.storage) }
fn pop<T>(values: &mut Array<T>) -> Option<T> {
    let values = &mut values.storage
    let length = storage.len(values)
    if length == 0 { return None }
    let value = storage.take_last(values)
    Some(value)
}
fn borrow<T>(values: &Array<T>, index: UInt64) -> &Element<T> { storage.borrow(&values.storage, index) }
fn borrow_ref<T>(values: &Array<T>, index: UInt64) -> &T { storage.borrow_ref(&values.storage, index) }
fn borrow_mut<T>(values: &mut Array<T>, index: UInt64) -> &mut Element<T> { storage.borrow_mut(&mut values.storage, index) }
fn slice<T>(values: &Array<T>, start: UInt64, end: UInt64) -> &Slice<T> { storage.slice(&values.storage, start, end) }
fn slice_mut<T>(values: &mut Array<T>, start: UInt64, end: UInt64) -> &mut Slice<T> { storage.slice_mut(&mut values.storage, start, end) }
