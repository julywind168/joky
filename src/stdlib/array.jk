// Copy-element arrays own an arena-backed buffer. All policies and copying loops live
// here; the private storage primitives enforce layout and initialization.
import joky/internal/buffer as storage.{type Buffer}
import joky/element.{type Element}
import joky/slice as slices.{type Slice}
import joky/option.{type Option, Some, None}

type Array<T> = Buffer<T>

fn new<T>() -> Array<T> { storage.allocate::<T>(0) }

fn with_capacity<T>(capacity: UInt64) -> Array<T> { storage.allocate::<T>(capacity) }

// Consume an unborrowed owner and reclaim its header and current payload.
fn release<T>(values: Array<T>) { storage.release(values) }

fn len<T>(values: &Array<T>) -> UInt64 { storage.len(values) }

fn capacity<T>(values: &Array<T>) -> UInt64 { storage.capacity(values) }

fn is_empty<T>(values: &Array<T>) -> Bool { storage.len(values) == 0 }

fn get<T>(values: &Array<T>, index: UInt64) -> Option<T> {
    if index < storage.len(values) { Some(storage.load(values, index)) } else { None }
}

fn set<T>(values: &mut Array<T>, index: UInt64, value: T) -> Bool {
    if index < storage.len(values) {
        storage.store(values, index, value)
        true
    } else { false }
}

fn reserve<T>(values: &mut Array<T>, additional: UInt64) {
    let length = storage.len(values)
    let capacity = storage.capacity(values)
    let limit = storage.capacity_limit::<T>()
    // The target layout limit is below UInt64.MAX. An unrepresentable request
    // becomes limit + 1 and fails in allocate, without wrapping any arithmetic.
    let required = if additional > limit - length { limit + 1 } else { length + additional }
    if required <= capacity { return }
    let candidate = if capacity == 0 {
        if limit < 4 { limit } else { 4 }
    } else {
        if capacity > limit - capacity { limit } else { capacity + capacity }
    }
    let next_capacity = if required > candidate { required } else { candidate }
    var next = storage.allocate::<T>(next_capacity)
    var index: UInt64 = 0
    while index < length {
        let value = storage.load(values, index)
        storage.initialize_next(&mut next, value)
        index = index + 1
    }
    storage.replace(values, next)
}

fn push<T>(values: &mut Array<T>, value: T) {
    reserve(values, 1)
    storage.initialize_next(values, value)
}

fn pop<T>(values: &mut Array<T>) -> Option<T> {
    let length = storage.len(values)
    if length == 0 { return None }
    let last = length - 1
    let value = storage.load(values, last)
    storage.truncate(values, last)
    Some(value)
}

// Views borrow storage; copying a value with get/pop remains independent.
fn borrow<T>(values: &Array<T>, index: UInt64) -> &Element<T> { storage.borrow(values, index) }
fn borrow_mut<T>(values: &mut Array<T>, index: UInt64) -> &mut Element<T> { storage.borrow_mut(values, index) }
fn slice<T>(values: &Array<T>, start: UInt64, end: UInt64) -> &Slice<T> { storage.slice(values, start, end) }
fn slice_mut<T>(values: &mut Array<T>, start: UInt64, end: UInt64) -> &mut Slice<T> { storage.slice_mut(values, start, end) }
