//! Hexadecimal encoding and decoding.
//!
//! Encoding produces two ASCII digits per byte; `encode` uses lowercase and
//! `encode_upper` uses uppercase. Decoding accepts either case and reports an
//! odd length or the byte offset of an invalid digit.
//!
//! ```joky
//! import joky/hex
//!
//! fn main() {
//!     let input = "Joky"
//!     let encoded = hex.encode((&input).bytes())
//!     assert_eq(encoded, "4a6f6b79")
//!     assert_eq(String.from_utf8(hex.decode(encoded).unwrap()).unwrap(), "Joky")
//!     assert(hex.decode("0g").is_err(), "invalid hex digit")
//! }
//! ```

import joky/show.{type Show}
import joky/array.{type Array}
import joky/slice.{type Slice}
import joky/string
import joky/result.{type Result, Ok, Err}

pub enum DecodeError { InvalidLength, InvalidByte(UInt64) }
impl Show for DecodeError {
    fn show(&self, output: &mut string.StringBuilder) @noescape {
        match self {
            InvalidLength => output.push_str("invalid hex length")
            InvalidByte(offset) => {
                output.push_str("invalid hex digit at byte ")
                offset.show(output)
            }
        }
    }
}

fn digit(value: UInt8, upper: Bool) -> UInt8 {
    if value < 10 {
        48 + value
    } else {
        (
            if upper {
            uint8(65)
        } else {
            uint8(97)
        }
        ) + value - 10
    }
}

fn nibble(byte: UInt8) -> UInt8 {
    if byte >= 48 && byte <= 57 {
        byte - 48
    } else if byte >= 65 && byte <= 70 {
        byte - 65 + 10
    } else if byte >= 97 && byte <= 102 {
        byte - 97 + 10
    } else {
        16
    }
}

fn encode_case(bytes: &Slice<UInt8>, upper: Bool) -> String {
    // A live slice is bounded by the runtime's isize-sized storage limit.
    var output = Array.with_capacity::<UInt8>(slice.len(bytes) * 2)
    var i: UInt64 = 0
    while i < slice.len(bytes) {
        let value = *slice.borrow_ref(bytes, i)
        output.push(digit(value >> 4, upper))
        output.push(digit(value & 15, upper))
        i += 1
    }
    string.from_utf8(output).unwrap()
}

/// Encodes bytes as lowercase hexadecimal.
pub fn encode(bytes: &Slice<UInt8>) -> String {
    encode_case(bytes, false)
}

/// Encodes bytes as uppercase hexadecimal.
pub fn encode_upper(bytes: &Slice<UInt8>) -> String {
    encode_case(bytes, true)
}

/// Decodes either letter case; rejects odd length and invalid digits.
pub fn decode(text: &String) -> Result<Array<UInt8>, DecodeError> {
    let bytes = text.bytes()
    let length = slice.len(bytes)
    if length % 2 != 0 {
        return Err(DecodeError.InvalidLength)
    }
    var output = Array.with_capacity::<UInt8>(length / 2)
    var i: UInt64 = 0
    while i < length {
        let high = nibble(*slice.borrow_ref(bytes, i))
        if high == 16 {
            return Err(DecodeError.InvalidByte(i))
        }
        let low = nibble(*slice.borrow_ref(bytes, i + 1))
        if low == 16 {
            return Err(DecodeError.InvalidByte(i + 1))
        }
        output.push((high << 4) | low)
        i += 2
    }
    Ok(output)
}
