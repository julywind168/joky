//! Unordered collections of unique values.
//!
//! Sets own unique elements and do not promise iteration order. Elements need
//! consistent `Eq` and `Hash` implementations. `insert` returns whether a new
//! element was added; consuming set operations transfer elements without cloning.
//!
//! ```joky
//! fn main() {
//!     var tags = Set.new::<String>()
//!     assert(tags.insert("joky"), "new tag")
//!     assert(!tags.insert("joky"), "duplicate tag")
//!     assert(tags.contains("joky"), "tag is present")
//!     assert_eq(tags.len(), uint64(1))
//! }
//! ```

// Single-owner unordered set. Map owns both the index and resident elements.
import joky/map.{type Map}
import joky/array.{type Array}
import joky/slice.{type Slice}
import joky/option.{type Option, Some, None}
import joky/eq.{type Eq}
import joky/hash.{type Hash}

/// An unordered set owning its unique elements.
pub struct Set<T> { items: Map<T, Unit> }
impl<T> Set<T> {
    /// Creates an empty set with no reserved entries.
    pub fn new() -> Self {
        new::<T>()
    }
    /// Creates an empty set with room for the requested number of values.
    pub fn with_capacity(capacity: UInt64) -> Self {
        with_capacity::<T>(capacity)
    }
    /// Returns the number of stored values.
    pub fn len(&self) -> UInt64 {
        len(self)
    }
    /// Returns the number of values the set can hold before growing.
    pub fn capacity(&self) -> UInt64 {
        capacity(self)
    }
    /// Returns true if there are no stored values.
    pub fn is_empty(&self) -> Bool {
        is_empty(self)
    }
    /// Ensures capacity for the requested number of additional values.
    pub fn reserve(&mut self, additional: UInt64) {
        reserve(self, additional)
    }
    /// Drops all values while retaining capacity.
    pub fn clear(&mut self) {
        clear(self)
    }
    /// Consumes the set and releases its storage.
    pub fn release(self) {
        release(self)
    }
    /// Borrows the values in the set's current storage order.
    pub fn elements(&self) -> &Slice<T> {
        elements(self)
    }
    /// Moves one stored value out of the set, or returns None if the set is empty.
    pub fn pop(&mut self) -> Option<T> {
        pop(self)
    }
    /// Consumes the set and moves its values into an array in storage order.
    pub fn into_array(self) -> Array<T> {
        into_array(self)
    }
}
impl<T: Eq + Hash> Set<T> {
    /// Tests whether an equal value is present.
    pub fn contains(&self, value: &T) @noescape(value) -> Bool {
        contains(self, value)
    }
    /// Returns true if the value was newly inserted; drops an equal incoming duplicate.
    pub fn insert(&mut self, value: T) -> Bool {
        insert(self, value)
    }
    /// Removes and drops the stored value, returning whether it was present.
    pub fn remove(&mut self, value: &T) @noescape(value) -> Bool {
        remove(self, value)
    }
    /// Builds a set from an owned array, retaining only one representative per equality class.
    pub fn from_array(values: Array<T>) -> Self {
        from_array(values)
    }
    /// Moves values from an array into the set, dropping duplicates.
    pub fn extend(&mut self, values: Array<T>) {
        extend(self, values)
    }
    /// Returns true if every value in this set occurs in the other set.
    pub fn is_subset(&self, other: &Self) -> Bool {
        is_subset(self, other)
    }
    /// Returns true if the sets share no equal values.
    pub fn is_disjoint(&self, other: &Self) -> Bool {
        is_disjoint(self, other)
    }
    /// Consumes both sets and returns their unique elements without cloning.
    pub fn union(self, other: Self) -> Self {
        union(self, other)
    }
    /// Consumes this set and retains elements also present in the borrowed set.
    pub fn intersection(self, other: &Self) -> Self {
        intersection(self, other)
    }
    /// Consumes this set and retains elements absent from the borrowed set.
    pub fn difference(self, other: &Self) -> Self {
        difference(self, other)
    }
    /// Consumes both sets and retains elements present in exactly one.
    pub fn symmetric_difference(self, other: Self) -> Self {
        symmetric_difference(self, other)
    }
}

/// Creates an empty set with no reserved entries.
pub fn new<T>() -> Set<T> {
    Set { items: Map.new::<T, Unit>() }
}

fn with_capacity<T>(capacity: UInt64) -> Set<T> {
    Set { items: Map.with_capacity::<T, Unit>(capacity) }
}

/// Returns the number of stored values.
pub fn len<T>(set: &Set<T>) -> UInt64 {
    set.items.len()
}

/// Returns the number of values the set can hold before growing.
pub fn capacity<T>(set: &Set<T>) -> UInt64 {
    set.items.capacity()
}

/// Returns true if there are no stored values.
pub fn is_empty<T>(set: &Set<T>) -> Bool {
    set.items.is_empty()
}

/// Ensures capacity for the requested number of additional values.
pub fn reserve<T>(set: &mut Set<T>, additional: UInt64) {
    set.items.reserve(additional)
}

/// Drops all values while retaining capacity.
pub fn clear<T>(set: &mut Set<T>) {
    set.items.clear()
}

/// Consumes the set and releases its storage.
pub fn release<T>(set: Set<T>) {}

/// Borrows the values in the set's current storage order.
pub fn elements<T>(set: &Set<T>) -> &Slice<T> {
    set.items.keys()
}

/// Moves one stored value out of the set, or returns None if the set is empty.
pub fn pop<T>(set: &mut Set<T>) -> Option<T> {
    match set.items.pop() {
        None => None,
        Some((value, _)) => Some(value)
    }
}

/// Tests whether an equal value is present.
pub fn contains<T: Eq + Hash>(set: &Set<T>, value: &T) @noescape(value) -> Bool {
    set.items.contains_key(value)
}

/// Returns true if the value was newly inserted; drops an equal incoming duplicate.
fn insert<T: Eq + Hash>(set: &mut Set<T>, value: T) -> Bool {
    set.items.insert(value, {}).is_none()
}

/// Removes and drops the stored value, returning whether it was present.
pub fn remove<T: Eq + Hash>(set: &mut Set<T>, value: &T) @noescape(value) -> Bool {
    set.items.remove(value).is_some()
}

fn from_array<T: Eq + Hash>(values: Array<T>) -> Set<T> {
    var set = new::<T>()
    extend(&mut set, values)
    set
}

fn extend<T: Eq + Hash>(set: &mut Set<T>, values: Array<T>) {
    reserve(set, values.len())
    // Visit the input in order, retaining its first equal instance.
    for value in values {
        insert(set, value)
    }
}

/// Consumes the set and moves its values into an array in storage order.
pub fn into_array<T>(set: Set<T>) -> Array<T> {
    var entries = set.items.into_entries()
    var values = Array.with_capacity::<T>(entries.len())
    while !entries.is_empty() {
        let (value, _) = entries.take_last()
        values.push(value)
    }
    values
}

fn is_subset<T: Eq + Hash>(set: &Set<T>, other: &Set<T>) -> Bool {
    if len(set) > len(other) {
        return false
    }
    let values = elements(set)
    var i: UInt64 = 0
    while i < slice.len(values) {
        if !contains(other, slice.borrow_ref(values, i)) {
            return false
        }
        i = i + 1
    }
    true
}

fn is_disjoint<T: Eq + Hash>(set: &Set<T>, other: &Set<T>) -> Bool {
    // Iterating the smaller input saves queries; neither borrow can escape.
    if len(set) > len(other) {
        return is_disjoint(other, set)
    }
    let values = elements(set)
    var i: UInt64 = 0
    while i < slice.len(values) {
        if contains(other, slice.borrow_ref(values, i)) {
            return false
        }
        i = i + 1
    }
    true
}

/// Consumes both sets and returns their unique elements without cloning.
fn union<T: Eq + Hash>(var set: Set<T>, var other: Set<T>) -> Set<T> {
    reserve(&mut set, len(&other))
    while !is_empty(&other) {
        match pop(&mut other) {
            Some(value) => {
                insert(&mut set, value);
            },
            None => {}
        }
    }
    set
}

fn filter<T: Eq + Hash>(var set: Set<T>, other: &Set<T>, present: Bool) -> Set<T> {
    var output = with_capacity::<T>(len(&set))
    while !is_empty(&set) {
        match pop(&mut set) {
            Some(value) => {
                let keep = contains(other, &value) == present
                // End the borrowed query before moving or dropping its owner.
                if keep {
                    insert(&mut output, value);
                }
            }
            None => {}
        }
    }
    output
}

/// Consumes this set and retains elements also present in the borrowed set.
fn intersection<T: Eq + Hash>(set: Set<T>, other: &Set<T>) -> Set<T> {
    filter(set, other, true)
}

/// Consumes this set and retains elements absent from the borrowed set.
fn difference<T: Eq + Hash>(set: Set<T>, other: &Set<T>) -> Set<T> {
    filter(set, other, false)
}

/// Consumes both sets and retains elements present in exactly one.
fn symmetric_difference<T: Eq + Hash>(var set: Set<T>, var other: Set<T>) -> Set<T> {
    reserve(&mut set, len(&other))
    while !is_empty(&other) {
        match pop(&mut other) {
            Some(value) => {
                // A matching resident is dropped by remove; the query owner is
                // then dropped here. Unique elements transfer into the result.
                let duplicate = remove(&mut set, &value)
                if !duplicate {
                    insert(&mut set, value);
                }
            }
            None => {}
        }
    }
    set
}
