import joky/internal/text
import joky/internal/buffer

// The sign of cmp defines a total order; zero denotes equivalent keys.
pub trait Ord { fn cmp(&self, other: &Self) @noescape -> Int32 }

fn signed_order(a: Int64, b: Int64) -> Int32 { if a < b { -1 } else if a > b { 1 } else { 0 } }
impl Ord for Int8 { fn cmp(&self, other: &Self) @noescape -> Int32 { signed_order(int64(*self), int64(*other)) } }
impl Ord for Int16 { fn cmp(&self, other: &Self) @noescape -> Int32 { signed_order(int64(*self), int64(*other)) } }
impl Ord for Int32 { fn cmp(&self, other: &Self) @noescape -> Int32 { signed_order(int64(*self), int64(*other)) } }
impl Ord for Int64 { fn cmp(&self, other: &Self) @noescape -> Int32 { signed_order(int64(*self), int64(*other)) } }

fn unsigned_order(a: UInt64, b: UInt64) -> Int32 { if a < b { -1 } else if a > b { 1 } else { 0 } }
impl Ord for UInt8 { fn cmp(&self, other: &Self) @noescape -> Int32 { unsigned_order(uint64(*self), uint64(*other)) } }
impl Ord for UInt16 { fn cmp(&self, other: &Self) @noescape -> Int32 { unsigned_order(uint64(*self), uint64(*other)) } }
impl Ord for UInt32 { fn cmp(&self, other: &Self) @noescape -> Int32 { unsigned_order(uint64(*self), uint64(*other)) } }
impl Ord for UInt64 { fn cmp(&self, other: &Self) @noescape -> Int32 { unsigned_order(uint64(*self), uint64(*other)) } }

impl Ord for String {
    fn cmp(&self, other: &Self) @noescape -> Int32 {
        let left = text.bytes(self)
        let right = text.bytes(other)
        let n = buffer.slice_len(left)
        let m = buffer.slice_len(right)
        var index: UInt64 = 0
        while index < n && index < m {
            let a = buffer.slice_load(left, index)
            let b = buffer.slice_load(right, index)
            if a != b { return if a < b { -1 } else { 1 } }
            index += 1
        }
        unsigned_order(n, m)
    }
}
