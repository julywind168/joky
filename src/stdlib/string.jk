// Immutable UTF-8 owners. Only these trusted bridges can transfer validated bytes.
import joky/array.{type Array}
import joky/slice as slices.{type Slice}
import joky/internal/buffer as storage
import joky/option.{type Option, Some, None}

fn copy_text(text: &String) -> String { "" }
fn freeze_utf8(bytes: Array<UInt8>) -> String { "" }
fn into_bytes(text: String) -> Array<UInt8> { Array.new::<UInt8>() }
fn bytes(text: &String) -> &Slice<UInt8> { storage.subslice::<UInt8>(bytes(text), 0, 0) }

impl String {
    pub fn new() -> Self { new() }
    pub fn clone(&self) -> Self { clone(self) }
    pub fn release(self) { release(self) }
    pub fn byte_length(&self) -> UInt64 { byte_length(self) }
    pub fn is_empty(&self) -> Bool { is_empty(self) }
    pub fn equals(&self, other: &String) -> Bool { equals(self, other) }
    pub fn find(&self, needle: &String) -> Option<UInt64> { find(self, needle) }
    pub fn starts_with(&self, prefix: &String) -> Bool { starts_with(self, prefix) }
    pub fn ends_with(&self, suffix: &String) -> Bool { ends_with(self, suffix) }
}

pub fn new() -> String { "" }
pub fn clone(text: &String) -> String { copy_text(text) }
pub fn release(text: String) { into_bytes(text).release() }
pub fn byte_length(text: &String) -> UInt64 { slices.len(bytes(text)) }
pub fn is_empty(text: &String) -> Bool { byte_length(text) == 0 }

fn matches_at(text: &Slice<UInt8>, other: &Slice<UInt8>, offset: UInt64) -> Bool {
    var index: UInt64 = 0
    while index < slices.len(other) {
        if storage.slice_load(text, offset + index) != storage.slice_load(other, index) { return false }
        index = index + 1
    }
    true
}
pub fn equals(text: &String, other: &String) -> Bool {
    let text = bytes(text)
    let other = bytes(other)
    slices.len(text) == slices.len(other) && matches_at(text, other, 0)
}
pub fn starts_with(text: &String, prefix: &String) -> Bool {
    let text = bytes(text)
    let prefix = bytes(prefix)
    slices.len(prefix) <= slices.len(text) && matches_at(text, prefix, 0)
}
pub fn ends_with(text: &String, suffix: &String) -> Bool {
    let text = bytes(text)
    let suffix = bytes(suffix)
    let length = slices.len(text)
    let count = slices.len(suffix)
    count <= length && matches_at(text, suffix, length - count)
}
pub fn find(text: &String, needle: &String) -> Option<UInt64> {
    let text = bytes(text)
    let needle = bytes(needle)
    let length = slices.len(text)
    let count = slices.len(needle)
    if count > length { return None }
    var offset: UInt64 = 0
    while offset <= length - count {
        if matches_at(text, needle, offset) { return Some(offset) }
        offset = offset + 1
    }
    None
}
