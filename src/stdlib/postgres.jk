//! PostgreSQL connections and queries.
//!
//! Use `sql` templates to bind values as parameters instead of interpolating
//! SQL text. Use `ident` for dynamic identifiers. Queries are inert values until
//! passed to a pool or transaction, so this example needs no database server.
//! Executing queries may suspend and returns `DbError` on failure.
//!
//! ```joky
//! import joky/postgres
//!
//! fn main() {
//!     let name = "Ada"
//!     let query = sql"SELECT id FROM users WHERE name = ${name}"
//!     assert_eq(query.sql(), "SELECT id FROM users WHERE name = $1")
//!     assert_eq(query.params().len(), uint64(1))
//! }
//! ```

// Runtime SQL uses positional PostgreSQL parameters. Values never become SQL text.
import joky/array.{type Array}
import joky/iter
import joky/option.{type Option, Some, None}
import joky/result.{type Result, Ok, Err}
import joky/check.{panic}
import joky/show.{type Show}
import joky/string.{type StringBuilder}
import joky/time
import joky/uuid
import joky/json
import joky/json/typed

extern fn __pg_connect(
    url: &String,
    max_connections: UInt64,
    acquire_timeout_nanos: UInt64
) @suspends -> postgres.Owner
extern fn __pg_share(owner: &postgres.Owner) @suspends -> postgres.Owner
extern fn __pg_begin(owner: &postgres.Owner) @suspends -> postgres.Owner
extern fn __pg_run(
    owner: &postgres.Owner,
    query: UInt64,
    sql: &String,
    params: Array<UInt8>
) @suspends -> postgres.Owner
extern fn __pg_finish(owner: &postgres.Owner, commit: UInt64) @suspends -> postgres.Owner
extern fn __pg_status(owner: &postgres.Owner) @suspends -> UInt64
extern fn __pg_count(owner: &postgres.Owner) @suspends -> UInt64
extern fn __pg_data(owner: &postgres.Owner) @suspends -> Array<UInt8>

/// Logical PostgreSQL types supported in parameters and result columns.
pub enum Kind {
    /// PostgreSQL boolean.
    Boolean,
    /// A supported signed integer column or parameter.
    Integer,
    /// A text column or parameter.
    Text,
    /// PostgreSQL bytea.
    Bytes,
    /// PostgreSQL timestamptz.
    Timestamp,
    /// A PostgreSQL UUID value.
    Uuid,
    /// PostgreSQL JSONB.
    Jsonb,
    /// A floating-point column or parameter.
    Float,
    /// A one-dimensional text array.
    TextArray,
    /// A one-dimensional signed integer array.
    IntArray
}
impl Show for Kind {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(
            match self {
                Boolean => "boolean"
                Integer => "integer"
                Text => "text"
                Bytes => "bytes"
                Timestamp => "timestamptz"
                Uuid => "uuid"
                Jsonb => "jsonb"
                Float => "float8"
                TextArray => "text[]"
                IntArray => "int8[]"
            }
        )
    }
}

/// An owned SQL parameter or decoded column value.
pub enum Value {
    /// SQL NULL together with the expected PostgreSQL type.
    Null(Kind),
    /// A Boolean value.
    BoolValue(Bool),
    /// A signed 64-bit integer value.
    IntValue(Int64),
    /// Owned text.
    TextValue(String),
    /// Owned binary data.
    BytesValue(Array<UInt8>),
    /// A UTC timestamp.
    TimestampValue(time.Timestamp),
    /// A 128-bit UUID.
    UuidValue(uuid.Uuid),
    /// Owned JSON text for a JSONB value.
    JsonValue(String),
    /// A Float64 value.
    FloatValue(Float64),
    /// Owned strings or SQL NULL elements in array order.
    TextArrayValue(Array<Option<String>>),
    /// Signed integers or SQL NULL elements in array order.
    IntArrayValue(Array<Option<Int64>>)
}

// Queries own snapshots of their parameters; execution consumes the query.
/// Owns SQL text and a snapshot of its parameters. Executing it consumes the query.
pub struct Query { text: String, parameters: Array<Value> }
impl Query {
    /// Creates a query that owns the supplied SQL text and parameters.
    pub fn new(text: String, parameters: Array<Value>) -> Self {
        Query { text, parameters }
    }
    /// Borrows the query's SQL text.
    pub fn sql(&self) -> &String {
        &self.text
    }
    /// Borrows the query's parameters in binding order.
    pub fn params(&self) -> &Array<Value> {
        &self.parameters
    }
}
// Identifier is intentionally not constructible from arbitrary SQL fragments.
/// An escaped SQL identifier produced by the identifier constructor.
pub struct Identifier { quoted: String }

/// Quotes a nonempty SQL identifier as a single identifier.
pub fn ident(name: &String) @noescape -> Result<Identifier, DbError> {
    if name.is_empty() {
        return Err(InvalidRequest)
    }
    var quoted = StringBuilder.new()
    quoted.push('"')
    for rune in name.runes() {
        if rune == '\0' {
            return Err(InvalidRequest)
        }
        quoted.push(rune)
        if rune == '"' {
            quoted.push('"')
        }
    }
    quoted.push('"')
    Ok(Identifier { quoted: quoted.finish() })
}

// This separate protocol also accepts pre-encoded JSON and typed NULL values.
/// Converts a value into an owned parameter for SQL binding.
pub trait BindParam {
    /// Consumes the input and produces the SQL value to bind.
    fn to_param(&self) @noescape -> Value
}
impl<T: ToSql> BindParam for T {
    fn to_param(&self) @noescape -> Value {
        ToSql.to_sql(self)
    }
}
impl BindParam for Value {
    fn to_param(&self) @noescape -> Value {
        match self {
            Null(kind) => Null(kind),
            BoolValue(value) => BoolValue(value),
            IntValue(value) => IntValue(value),
            TextValue(value) => TextValue(value.clone()),
            BytesValue(value) => BytesValue(array.clone(value)),
            TimestampValue(value) => TimestampValue(value),
            UuidValue(value) => UuidValue(value),
            JsonValue(value) => JsonValue(value.clone()),
            FloatValue(value) => FloatValue(value),
            TextArrayValue(value) => TextArrayValue(copy_text_array(value)),
            IntArrayValue(value) => IntArrayValue(copy_int_array(value))
        }
    }
}
struct SqlBuilder { text: StringBuilder, parameters: Array<Value> }
impl SqlBuilder {
    fn new() -> Self {
        SqlBuilder { text: StringBuilder.new(), parameters: Array.new::<Value>() }
    }
    fn finish(self) -> Query {
        let SqlBuilder { text, parameters } = self
        Query.new(text.finish(), parameters)
    }
}

fn __sql_text(value: &String, output: &mut SqlBuilder) @noescape {
    output.text.push_str(value)
}

fn __sql_identifier(value: &Identifier, output: &mut SqlBuilder) @noescape {
    output.text.push_str(&value.quoted)
}

fn __sql_parameter<T: BindParam>(value: &T, output: &mut SqlBuilder) @noescape {
    output.parameters.push(BindParam.to_param(value))
    let placeholder = "${output.parameters.len()}"
    output.text.push_str(placeholder)
}

/// A PostgreSQL JSONB column decoded into a Joky type.
pub struct Json<T> {
    /// The owned value produced by the typed JSON decoder.
    pub value: T
}
/// A callback's choice to commit or roll back, together with the result to return.
pub enum TxOutcome<T> {
    /// Commits the transaction and returns the supplied application result.
    Commit(T),
    /// Rolls back the transaction and returns the supplied application result.
    Rollback(T)
}

// JSON encoding is fallible. These helpers retain codec details and own the text.
/// Encodes a JSON tree for binding as a JSONB parameter.
pub fn param_json(value: &json.Value) @noescape -> Result<Value, DbError> {
    match json.encode(value) {
        Ok(text) => Ok(JsonValue(text)),
        Err(error) => Err(JsonCodec(typed.CodecError.Encoding(error)))
    }
}

/// Encodes a typed Joky value for binding as JSONB.
pub fn param_json_as<T: typed.ToJson>(value: &T) @noescape -> Result<Value, DbError> {
    match typed.encode(value) {
        Ok(text) => Ok(JsonValue(text)),
        Err(error) => Err(JsonCodec(error))
    }
}

/// Binds None as SQL NULL and encodes a present value as JSONB.
pub fn param_json_optional<T: typed.ToJson>(value: &Option<T>) @noescape -> Result<Value, DbError> {
    match value {
        Some(value) => param_json_as(value),
        None => Ok(Null(Jsonb))
    }
}

// Parameters own their data; kind also describes an absent optional value.
/// Converts a value into the corresponding PostgreSQL parameter representation.
pub trait ToSql {
    /// Returns the PostgreSQL parameter kind for this Joky type.
    fn kind() -> Kind
    /// Consumes the input and converts it to an owned SQL parameter.
    fn to_sql(&self) @noescape -> Value
}

/// Converts the supplied value to an owned SQL parameter.
pub fn param<T: ToSql>(value: &T) @noescape -> Value {
    ToSql.to_sql(value)
}

impl ToSql for Bool {
    fn kind() -> Kind {
        Boolean
    }
    fn to_sql(&self) @noescape -> Value {
        BoolValue(*self)
    }
}
impl ToSql for Int16 {
    fn kind() -> Kind {
        Integer
    }
    fn to_sql(&self) @noescape -> Value {
        IntValue(int64(*self))
    }
}
impl ToSql for Int32 {
    fn kind() -> Kind {
        Integer
    }
    fn to_sql(&self) @noescape -> Value {
        IntValue(int64(*self))
    }
}
impl ToSql for Int64 {
    fn kind() -> Kind {
        Integer
    }
    fn to_sql(&self) @noescape -> Value {
        IntValue(*self)
    }
}
impl ToSql for String {
    fn kind() -> Kind {
        Text
    }
    fn to_sql(&self) @noescape -> Value {
        TextValue(self.clone())
    }
}
impl ToSql for Array<UInt8> {
    fn kind() -> Kind {
        Bytes
    }
    fn to_sql(&self) @noescape -> Value {
        BytesValue(array.clone(self))
    }
}
impl ToSql for time.Timestamp {
    fn kind() -> Kind {
        Timestamp
    }
    fn to_sql(&self) @noescape -> Value {
        TimestampValue(*self)
    }
}
impl ToSql for uuid.Uuid {
    fn kind() -> Kind {
        Uuid
    }
    fn to_sql(&self) @noescape -> Value {
        UuidValue(*self)
    }
}
impl ToSql for Float64 {
    fn kind() -> Kind {
        Float
    }
    fn to_sql(&self) @noescape -> Value {
        FloatValue(*self)
    }
}

fn copy_text_array(values: &Array<Option<String>>) @noescape -> Array<Option<String>> {
    iter.shared(values).map(
        |value| {
            match value {
                Some(text) => Some(text.clone()),
                None => None
            }
        }
    ).collect()
}

fn copy_int_array(values: &Array<Option<Int64>>) @noescape -> Array<Option<Int64>> {
    iter.shared(values).map(
        |value| {
            *value
        }
    ).collect()
}

impl ToSql for Array<String> {
    fn kind() -> Kind {
        TextArray
    }
    fn to_sql(&self) @noescape -> Value {
        let values = iter.shared(self).map(
            |text| {
                Some(text.clone())
            }
        ).collect()
        TextArrayValue(values)
    }
}
impl ToSql for Array<Option<String>> {
    fn kind() -> Kind {
        TextArray
    }
    fn to_sql(&self) @noescape -> Value {
        TextArrayValue(copy_text_array(self))
    }
}
impl ToSql for Array<Int64> {
    fn kind() -> Kind {
        IntArray
    }
    fn to_sql(&self) @noescape -> Value {
        let values = iter.shared(self).map(
            |value| {
                Some(*value)
            }
        ).collect()
        IntArrayValue(values)
    }
}
impl ToSql for Array<Option<Int64>> {
    fn kind() -> Kind {
        IntArray
    }
    fn to_sql(&self) @noescape -> Value {
        IntArrayValue(copy_int_array(self))
    }
}
impl<T: ToSql> ToSql for Option<T> {
    fn kind() -> Kind {
        ToSql.kind::<T>()
    }
    fn to_sql(&self) @noescape -> Value {
        match self {
            Some(value) => ToSql.to_sql(value),
            None => Null(ToSql.kind::<T>())
        }
    }
}

/// Reasons a query result could not be read with the requested shape.
pub enum ReadFailure {
    /// A result column uses an unsupported PostgreSQL type.
    UnsupportedType,
    /// The result exceeded a configured resource limit.
    ResultLimit,
    /// The query required one row but returned none.
    NoRows,
    /// The query returned more than one row where at most one was allowed.
    MultipleRows,
    /// The result has this column count where a different count was required.
    ColumnCount(UInt64),
    /// A column value is outside the supported representation.
    ValueRange,
    /// The PostgreSQL array shape cannot be represented by the decoder.
    ArrayShape
}
impl Show for ReadFailure {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(
            match self {
                UnsupportedType => "query sent; unsupported result column"
                ResultLimit => "query sent; result limit exceeded"
                NoRows => "query returned no rows"
                MultipleRows => "query returned multiple rows"
                ColumnCount(count) => "query returned {count} columns; expected one"
                ValueRange => "query sent; result value outside the supported range"
                ArrayShape => "query sent; expected a one-dimensional array starting at one"
            }
        )
    }
}

/// Reasons a result column could not be selected or converted.
pub enum ColumnError {
    /// The specified zero-based column index is outside the row.
    OutOfBounds(UInt64),
    /// The column at the given index has an unexpected type.
    TypeMismatch(UInt64),
    /// The specified column is NULL where a value was required.
    UnexpectedNull(UInt64),
    /// No column has the requested name.
    MissingColumn,
    /// More than one column has the requested name.
    AmbiguousColumn,
    /// An unexpected NULL array element, with the column and element indices.
    NullElement((UInt64, UInt64))
}
/// Failures from connecting, executing, or decoding PostgreSQL operations.
pub enum DbError {
    /// The connection or query request failed validation.
    InvalidRequest,
    /// The requested database resource is unavailable.
    Unavailable,
    /// The transaction no longer owns an active database transaction.
    TransactionClosed,
    /// The operation exceeded a configured resource limit.
    LimitExceeded,
    /// The connection failed before a definitive outcome was available.
    OutcomeUnknown,
    /// PostgreSQL rejected the request. The payload carries its SQLSTATE when available.
    Database(String),
    /// The query result failed decoding or shape validation.
    ResultRead(ReadFailure),
    /// Establishing the initial connection failed.
    Connect(String),
    /// The pool could not provide a usable connection.
    AcquireFailed,
    /// The pool acquisition deadline elapsed.
    AcquireTimeout,
    /// A column could not be decoded as requested.
    Column(ColumnError),
    /// The timestamp cannot be represented at PostgreSQL microsecond precision.
    TimestampPrecision,
    /// Typed JSON processing failed while binding or reading a JSONB value.
    JsonCodec(typed.CodecError)
}
impl Show for ColumnError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            OutOfBounds(i) => {
                output.push_str("no column at index ")
                i.show(output)
            },
            TypeMismatch(i) => {
                output.push_str("unexpected type at column ")
                i.show(output)
            },
            UnexpectedNull(i) => {
                output.push_str("unexpected NULL at column ")
                i.show(output)
            },
            MissingColumn => output.push_str("column name not found"),
            AmbiguousColumn => output.push_str("ambiguous column name")
            NullElement((column, element)) => output.push_str(
                "NULL at column {column}, array element {element}"
            )
        }
    }
}
impl Show for DbError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            InvalidRequest => output.push_str("invalid database request"),
            Unavailable => output.push_str("database service unavailable"),
            TransactionClosed => output.push_str("transaction closed"),
            LimitExceeded => output.push_str("database resource limit exceeded"),
            OutcomeUnknown => output.push_str("database outcome unknown"),
            Database(code) => {
                output.push_str("database error ")
                output.push_str(code)
            },
            Connect(code) => {
                output.push_str("database connection failed")
                if !code.is_empty() {
                    output.push_str(" (SQLSTATE ")
                    output.push_str(code)
                    output.push_str(")")
                }
            },
            AcquireFailed => output.push_str("pool checkout failed"),
            AcquireTimeout => output.push_str("pool checkout timed out"),
            Column(reason) => reason.show(output),
            ResultRead(reason) => reason.show(output)
            TimestampPrecision => output.push_str(
                "timestamp parameter requires microsecond precision"
            )
            JsonCodec(error) => error.show(output)
        }
    }
}
/// Owns access to a bounded set of physical PostgreSQL connections.
pub struct Pool { owner: postgres.Owner }
/// Owns exclusive use of one pooled connection until resolved or dropped.
pub struct Transaction { owner: postgres.Owner }
/// Owns a decoded result row and its column metadata.
pub struct Row { names: Array<String>, cells: Array<Value> }
impl Row {
    /// Returns the number of columns in the row.
    pub fn len(&self) -> UInt64 {
        self.cells.len()
    }
    /// Borrows the column names in result order.
    pub fn column_names(&self) -> &Array<String> {
        &self.names
    }
    /// Borrows the decoded column values in result order.
    pub fn values(&self) -> &Array<Value> {
        &self.cells
    }
    /// Borrows a column value by its zero-based ordinal.
    pub fn borrow_ref(&self, i: UInt64) -> &Value {
        self.cells.borrow_ref(i)
    }
    /// Borrows the column value at the given ordinal, or returns None if it is out of bounds.
    pub fn get_ref(&self, i: UInt64) -> Option<&Value> {
        self.cells.get_ref(i)
    }

    /// Finds the zero-based index of the named column.
    pub fn column_index(&self, name: &String) -> Result<UInt64, ColumnError> {
        var found: Option<UInt64> = None
        for i in 0 .. self.names.len() {
            if self.names.borrow_ref(i) == name {
                if found.is_some() {
                    return Err(AmbiguousColumn)
                }
                found = Some(i)
            }
        }
        found.ok_or(MissingColumn)
    }
    /// Decodes a column as the requested type.
    pub fn get<T: FromSql>(&self, name: &String) @noescape -> Result<T, DbError> {
        let i = match self.column_index(name) {
            Ok(i) => i,
            Err(reason) => return Err(Column(reason))
        }
        FromSql.from_sql::<T>(self, i)
    }
    /// Decodes a nullable column, mapping SQL NULL to None.
    pub fn get_opt<T: FromSql>(&self, name: &String) @noescape -> Result<Option<T>, DbError> {
        self.get::<Option<T>>(name)
    }
    /// Reads a Boolean column.
    pub fn get_bool(&self, name: &String) -> Result<Option<Bool>, ColumnError> {
        get_bool(self, self.column_index(name)?)
    }
    /// Reads a signed 64-bit integer column.
    pub fn get_int64(&self, name: &String) -> Result<Option<Int64>, ColumnError> {
        get_i64(self, self.column_index(name)?)
    }
    /// Reads a non-null signed 64-bit integer column or returns a column error.
    pub fn require_int64(&self, name: &String) -> Result<Int64, DbError> {
        self.get::<Int64>(name)
    }
    /// Reads a text column.
    pub fn get_text(&self, name: &String) @noescape(name) -> Result<Option<&String>, ColumnError> {
        get_text(self, self.column_index(name)?)
    }
    /// Reads a binary-data column.
    pub fn get_bytes(
        &self,
        name: &String
    ) @noescape(name) -> Result<Option<&Array<UInt8>>, ColumnError> {
        get_bytes(self, self.column_index(name)?)
    }
}

// Decoded values own their data and can outlive the source row.
/// Decodes a column of a borrowed row into a Joky value.
pub trait FromSql {
    /// Decodes the column at the specified zero-based ordinal.
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Self, DbError>
}
/// Decodes a complete borrowed result row into a Joky value.
pub trait FromRow {
    /// Decodes the borrowed row into the requested type.
    fn from_row(row: &Row) @noescape -> Result<Self, DbError>
}

fn column(row: &Row, i: UInt64) -> Result<&Value, ColumnError> {
    row.get_ref(i).ok_or(OutOfBounds(i))
}

fn required_column<T>(value: Result<Option<T>, ColumnError>, i: UInt64) -> Result<T, DbError> {
    value.map_err(
        |error| {
            Column(error)
        }
    )?.ok_or(Column(UnexpectedNull(i)))
}

impl FromSql for Int64 {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Int64, DbError> {
        required_column(get_i64(row, i), i)
    }
}
impl FromSql for Bool {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Bool, DbError> {
        required_column(get_bool(row, i), i)
    }
}
impl FromSql for String {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<String, DbError> {
        Ok(required_column(get_text(row, i), i)?.clone())
    }
}
impl FromSql for Array<UInt8> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Array<UInt8>, DbError> {
        Ok(array.clone(required_column(get_bytes(row, i), i)?))
    }
}
impl FromSql for time.Timestamp {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<time.Timestamp, DbError> {
        if i >= row.len() {
            return Err(Column(OutOfBounds(i)))
        }
        match row.borrow_ref(i) {
            TimestampValue(value) => Ok(value),
            Null(Timestamp) => Err(Column(UnexpectedNull(i))),
            _ => Err(Column(TypeMismatch(i)))
        }
    }
}
impl FromSql for uuid.Uuid {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<uuid.Uuid, DbError> {
        if i >= row.len() {
            return Err(Column(OutOfBounds(i)))
        }
        match row.borrow_ref(i) {
            UuidValue(value) => Ok(value),
            Null(Uuid) => Err(Column(UnexpectedNull(i))),
            _ => Err(Column(TypeMismatch(i)))
        }
    }
}
impl FromSql for Float64 {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Float64, DbError> {
        if i >= row.len() {
            return Err(Column(OutOfBounds(i)))
        }
        match row.borrow_ref(i) {
            FloatValue(value) => Ok(value),
            Null(Float) => Err(Column(UnexpectedNull(i))),
            _ => Err(Column(TypeMismatch(i)))
        }
    }
}

fn text_array(row: &Row, i: UInt64) -> Result<&Array<Option<String>>, ColumnError> {
    match column(row, i)? {
        TextArrayValue(values) => Ok(values),
        Null(TextArray) => Err(UnexpectedNull(i)),
        _ => Err(TypeMismatch(i))
    }
}

fn int_array(row: &Row, i: UInt64) -> Result<&Array<Option<Int64>>, ColumnError> {
    match column(row, i)? {
        IntArrayValue(values) => Ok(values),
        Null(IntArray) => Err(UnexpectedNull(i)),
        _ => Err(TypeMismatch(i))
    }
}

impl FromSql for Array<Option<String>> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Array<Option<String>>, DbError> {
        match text_array(row, i) {
            Ok(values) => Ok(copy_text_array(values)),
            Err(error) => Err(Column(error))
        }
    }
}
impl FromSql for Array<Option<Int64>> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Array<Option<Int64>>, DbError> {
        match int_array(row, i) {
            Ok(values) => Ok(copy_int_array(values)),
            Err(error) => Err(Column(error))
        }
    }
}
impl FromSql for Array<String> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Array<String>, DbError> {
        let values = match text_array(row, i) {
            Ok(values) => values,
            Err(error) => return Err(Column(error))
        }
        var result: Array<String> = []
        for j in 0 .. values.len() {
            match values.borrow_ref(j) {
                Some(value) => result.push(value.clone()),
                None => return Err(Column(NullElement((i, j))))
            }
        }
        Ok(result)
    }
}
impl FromSql for Array<Int64> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Array<Int64>, DbError> {
        let values = match int_array(row, i) {
            Ok(values) => values,
            Err(error) => return Err(Column(error))
        }
        var result: Array<Int64> = []
        for j in 0 .. values.len() {
            match values.borrow_ref(j) {
                Some(value) => result.push(value),
                None => return Err(Column(NullElement((i, j))))
            }
        }
        Ok(result)
    }
}

fn json_text(row: &Row, i: UInt64) -> Result<&String, ColumnError> {
    match column(row, i)? {
        JsonValue(value) => Ok(value),
        Null(Jsonb) => Err(UnexpectedNull(i)),
        _ => Err(TypeMismatch(i))
    }
}

impl FromSql for json.Value {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<json.Value, DbError> {
        let text = match json_text(row, i) {
            Ok(text) => text,
            Err(error) => return Err(Column(error))
        }
        match json.decode(text) {
            Ok(value) => Ok(value),
            Err(error) => Err(JsonCodec(typed.CodecError.Syntax(error)))
        }
    }
}
impl<T: typed.FromJson> FromSql for Json<T> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Json<T>, DbError> {
        let text = match json_text(row, i) {
            Ok(text) => text,
            Err(error) => return Err(Column(error))
        }
        match typed.decode::<T>(text) {
            Ok(value) => Ok(Json { value }),
            Err(error) => Err(JsonCodec(error))
        }
    }
}
impl<T: FromSql> FromSql for Option<T> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Option<T>, DbError> {
        match FromSql.from_sql::<T>(row, i) {
            Ok(value) => Ok(Some(value)),
            Err(Column(UnexpectedNull(_))) => Ok(None),
            Err(error) => Err(error)
        }
    }
}

/// Reads a Boolean column.
pub fn get_bool(row: &Row, i: UInt64) -> Result<Option<Bool>, ColumnError> {
    match column(row, i)? {
        BoolValue(v) => Ok(Some(v)),
        Null(Boolean) => Ok(None),
        _ => Err(TypeMismatch(i))
    }
}

/// Reads a signed integer column.
pub fn get_i64(row: &Row, i: UInt64) -> Result<Option<Int64>, ColumnError> {
    match column(row, i)? {
        IntValue(v) => Ok(Some(v)),
        Null(Integer) => Ok(None),
        _ => Err(TypeMismatch(i))
    }
}

/// Reads a text column.
pub fn get_text(row: &Row, i: UInt64) -> Result<Option<&String>, ColumnError> {
    match column(row, i)? {
        TextValue(v) => Ok(Some(v)),
        Null(Text) => Ok(None),
        _ => Err(TypeMismatch(i))
    }
}

/// Reads a binary-data column.
pub fn get_bytes(row: &Row, i: UInt64) -> Result<Option<&Array<UInt8>>, ColumnError> {
    match column(row, i)? {
        BytesValue(v) => Ok(Some(v)),
        Null(Bytes) => Ok(None),
        _ => Err(TypeMismatch(i))
    }
}

fn check_status(owner: &postgres.Owner) @suspends -> Result<Unit, DbError> {
    match __pg_status(owner) {
        0 => Ok({}),
        1 => Err(InvalidRequest),
        2 => Err(Unavailable),
        3 => Err(TransactionClosed),
        4 => Err(LimitExceeded),
        5 => Err(OutcomeUnknown),
        6 => Err(Database(String.from_utf8(__pg_data(owner))!)),
        7 => Err(ResultRead(UnsupportedType)),
        8 => Err(ResultRead(ResultLimit)),
        9 => Err(Connect(String.from_utf8(__pg_data(owner))!)),
        10 => Err(AcquireFailed),
        11 => Err(AcquireTimeout),
        12 => Err(ResultRead(MultipleRows)),
        13 => Err(ResultRead(ValueRange)),
        14 => Err(ResultRead(ArrayShape)),
        _ => panic("invalid database status")
    }
}

/// Connection pool settings. Defaults to four connections and a five-second timeout.
pub struct Options {
    /// Maximum number of physical connections in the pool, from 1 to 32.
    pub max_connections: UInt64,
    /// Nonzero deadline for the initial connection and for acquiring a pooled connection.
    pub acquire_timeout: time.Duration
}
impl Options {
    /// Allows four connections and waits up to five seconds to acquire one.
    pub fn default() -> Options {
        Options { max_connections: 4, acquire_timeout: 5s }
    }
}

/// Opens an owned pool for the supplied PostgreSQL URL.
/// Invalid settings return `InvalidRequest`. Initial connection failures return `Connect`.
pub fn open(url: &String, options: Options) @suspends -> Result<Pool, DbError> {
    let owner = __pg_connect(url, options.max_connections, options.acquire_timeout.as_nanos())
    check_status(&owner)?
    Ok(Pool { owner })
}

fn word(out: &mut Array<UInt8>, n: UInt64, width: UInt64) {
    for i in 0 .. width {
        out.push(uint8(n >> (8 * i)))
    }
}

fn blob(out: &mut Array<UInt8>, tag: UInt8, bytes: &Array<UInt8>) -> Result<Unit, DbError> {
    let size = bytes.len()
    if size + out.len() + 5 > 1048576 {
        return Err(LimitExceeded)
    }
    out.push(tag)
    word(out, size, 4)
    out.extend(&bytes[..])
    Ok({})
}

fn text_blob(out: &mut Array<UInt8>, tag: UInt8, text: &String) -> Result<Unit, DbError> {
    let size = text.byte_length()
    if size + out.len() + 5 > 1048576 {
        return Err(LimitExceeded)
    }
    out.push(tag)
    word(out, size, 4)
    out.extend(text.bytes())
    Ok({})
}

fn encode_text_array(
    data: &mut Array<UInt8>,
    values: &Array<Option<String>>
) -> Result<Unit, DbError> {
    if values.len() > 65536 || data.len() + 5 > 1048576 {
        return Err(LimitExceeded)
    }
    data.push(18)
    word(data, values.len(), 4)
    for i in 0 .. values.len() {
        match values.borrow_ref(i) {
            None => data.push(0),
            Some(text) => text_blob(data, 1, text)?
        }
        if data.len() > 1048576 {
            return Err(LimitExceeded)
        }
    }
    Ok({})
}

fn encode_int_array(
    data: &mut Array<UInt8>,
    values: &Array<Option<Int64>>
) -> Result<Unit, DbError> {
    if values.len() > 65536 || data.len() + 5 > 1048576 {
        return Err(LimitExceeded)
    }
    data.push(19)
    word(data, values.len(), 4)
    for i in 0 .. values.len() {
        match values.borrow_ref(i) {
            None => data.push(0),
            Some(value) => {
                data.push(1)
                word(data, uint64(value), 8)
            }
        }
        if data.len() > 1048576 {
            return Err(LimitExceeded)
        }
    }
    Ok({})
}

fn null_tag(kind: Kind) -> UInt8 {
    match kind {
        Boolean => 0,
        Integer => 1,
        Text => 2,
        Bytes => 3,
        Timestamp => 8,
        Uuid => 9,
        Jsonb => 10,
        Float => 14,
        TextArray => 15,
        IntArray => 16
    }
}

fn encode_value(data: &mut Array<UInt8>, param: Value) -> Result<Unit, DbError> {
    match param {
        Null(kind) => data.push(null_tag(kind)),
        BoolValue(value) => {
            data.push(4)
            data.push(
                if value {
                    1
                } else {
                    0
                }
            )
        },
        IntValue(value) => {
            data.push(5)
            word(data, uint64(value), 8)
        },
        TextValue(value) => {
            if value.byte_length() > 1048576 {
                return Err(LimitExceeded)
            };
            let bytes = value.into_bytes()
            blob(data, 6, &bytes)?
        },
        BytesValue(bytes) => blob(data, 7, &bytes)?,
        TimestampValue(value) => {
            if value.subsec_nanos() % 1000 != 0 {
                return Err(TimestampPrecision)
            }
            data.push(11)
            word(data, uint64(value.as_unix_micros()), 8)
        },
        UuidValue(value) => {
            let bytes = value.to_bytes()
            data.push(12)
            word(data, 16, 4)
            for i in uint64(0) .. 16 {
                data.push(bytes[i])
            }
        },
        JsonValue(text) => {
            if text.byte_length() > 1048576 {
                return Err(LimitExceeded)
            }
            let bytes = text.into_bytes()
            blob(data, 13, &bytes)?
        },
        FloatValue(value) => {
            data.push(17)
            word(data, value.to_bits(), 8)
        },
        TextArrayValue(values) => encode_text_array(data, &values)?,
        IntArrayValue(values) => encode_int_array(data, &values)?
    }
    if data.len() > 1048576 {
        return Err(LimitExceeded)
    }
    Ok({})
}

fn encode(params: Array<Value>) -> Result<Array<UInt8>, DbError> {
    if params.len() > 256 {
        return Err(LimitExceeded)
    }
    var data: Array<UInt8> = []
    for param in params {
        encode_value(&mut data, param)?
    }
    Ok(data)
}

fn take(data: &Array<UInt8>, offset: &mut UInt64, width: UInt64) -> UInt64 {
    var value: UInt64 = 0
    for i in 0 .. width {
        value = value | (uint64(data[*offset + i]) << (8 * i))
    }
    *offset = *offset + width
    value
}

fn take_bytes(data: &Array<UInt8>, offset: &mut UInt64) -> Array<UInt8> {
    let n = take(data, offset, 4)
    var bytes: Array<UInt8> = []
    array.extend_bytes(&mut bytes, &data[..], *offset, *offset + n)
    *offset = *offset + n
    bytes
}

fn take_text_array(data: &Array<UInt8>, offset: &mut UInt64) -> Value {
    let count = take(data, offset, 4)
    var values: Array<Option<String>> = []
    for i in 0 .. count {
        values.push(
            if take(data, offset, 1) == 0 {
                None
            } else {
                Some(String.from_utf8(take_bytes(data, offset))!)
            }
        )
    }
    TextArrayValue(values)
}

fn take_int_array(data: &Array<UInt8>, offset: &mut UInt64) -> Value {
    let count = take(data, offset, 4)
    var values: Array<Option<Int64>> = []
    for i in 0 .. count {
        values.push(
            if take(data, offset, 1) == 0 {
                None
            } else {
                Some(int64(take(data, offset, 8)))
            }
        )
    }
    IntArrayValue(values)
}

fn cell(data: &Array<UInt8>, offset: &mut UInt64) -> Value {
    match take(data, offset, 1) {
        0 => Null(Boolean),
        1 => Null(Integer),
        2 => Null(Text),
        3 => Null(Bytes),
        4 => BoolValue(take(data, offset, 1) != 0),
        5 => IntValue(int64(take(data, offset, 8))),
        6 => TextValue(String.from_utf8(take_bytes(data, offset))!),
        8 => Null(Timestamp),
        9 => Null(Uuid),
        10 => Null(Jsonb),
        11 => TimestampValue(time.Timestamp.from_unix_micros(int64(take(data, offset, 8)))!),
        12 => {
            let bytes = take_bytes(data, offset)
            UuidValue(uuid.Uuid.from_slice(&bytes[..])!)
        },
        13 => JsonValue(String.from_utf8(take_bytes(data, offset))!),
        14 => Null(Float),
        15 => Null(TextArray),
        16 => Null(IntArray),
        17 => FloatValue(Float64.from_bits(take(data, offset, 8))),
        18 => take_text_array(data, offset),
        19 => take_int_array(data, offset),
        _ => BytesValue(take_bytes(data, offset))
    }
}

fn rows(data: Array<UInt8>) -> Array<Row> {
    var result: Array<Row> = []
    var offset: UInt64 = 0
    while offset < data.len() {
        let count = take(&data, &mut offset, 4)
        var row = Row { names: [], cells: [] }
        for i in 0 .. count {
            row.names.push(String.from_utf8(take_bytes(&data, &mut offset))!)
            row.cells.push(cell(&data, &mut offset))
        }
        result.push(row)
    }
    result
}

fn run(
    owner: &postgres.Owner,
    mode: UInt64,
    query: Query
) @suspends -> Result<postgres.Owner, DbError> {
    let Query { text, parameters } = query
    let result = __pg_run(owner, mode, &text, encode(parameters)?)
    check_status(&result)?
    Ok(result)
}

fn exec(owner: &postgres.Owner, query: Query) @suspends -> Result<UInt64, DbError> {
    let result = run(owner, 0, query)?
    Ok(__pg_count(&result))
}

fn fetch(owner: &postgres.Owner, query: Query) @suspends -> Result<Array<Row>, DbError> {
    let result = run(owner, 3, query)?
    Ok(rows(__pg_data(&result)))
}

fn optional_row(owner: &postgres.Owner, query: Query) @suspends -> Result<Option<Row>, DbError> {
    let result = run(owner, 4, query)?
    var found = rows(__pg_data(&result))
    Ok(found.pop())
}

fn required_row(found: Option<Row>) -> Result<Row, DbError> {
    found.ok_or(ResultRead(NoRows))
}

fn scalar_value<T: FromSql>(row: Row) -> Result<T, DbError> {
    if row.len() != 1 {
        return Err(ResultRead(ColumnCount(row.len())))
    }
    FromSql.from_sql::<T>(&row, 0)
}

impl Pool {
    /// Runs a callback with an exclusive transaction and commits or rolls back according to its result.
    pub fn transaction<
        T,
        F: FnOnce(&mut Transaction) @suspends @noescape -> Result<TxOutcome<T>, DbError>
    >(&self, operation: F) @suspends -> Result<T, DbError> {
        var tx = self.begin()?
        match operation(&mut tx) {
            Ok(Commit(value)) => {
                tx.commit()?;
                Ok(value)
            },
            Ok(Rollback(value)) => {
                tx.rollback()?;
                Ok(value)
            },
            Err(error) => {
                // A failed SQL operation may already have retired the connection.
                // Preserve the original failure even if rollback also fails.
                tx.rollback()
                Err(error)
            }
        }
    }
    /// Returns another owner of the same connection pool.
    pub fn share(&self) @suspends -> Self {
        Pool { owner: __pg_share(&self.owner) }
    }
    /// Consumes the query, executes it, and reports the number of affected rows.
    pub fn execute(&self, query: Query) @suspends -> Result<UInt64, DbError> {
        exec(&self.owner, query)
    }
    /// Consumes the query and returns the decoded result rows.
    pub fn query(&self, query: Query) @suspends -> Result<Array<Row>, DbError> {
        fetch(&self.owner, query)
    }
    /// Returns at most one row and rejects additional rows.
    pub fn query_optional(&self, query: Query) @suspends -> Result<Option<Row>, DbError> {
        optional_row(&self.owner, query)
    }
    /// Requires exactly one row.
    pub fn query_one(&self, query: Query) @suspends -> Result<Row, DbError> {
        required_row(self.query_optional(query)?)
    }
    /// Requires exactly one row and one column, then decodes that column.
    pub fn query_scalar<T: FromSql>(&self, query: Query) @suspends -> Result<T, DbError> {
        scalar_value::<T>(self.query_one(query)?)
    }
    /// Requires exactly one row and converts it to the requested row type.
    pub fn query_one_as<T: FromRow>(&self, query: Query) @suspends -> Result<T, DbError> {
        let row = self.query_one(query)?
        FromRow.from_row::<T>(&row)
    }
    /// Borrows one pooled connection for an owned transaction.
    pub fn begin(&self) @suspends -> Result<Transaction, DbError> {
        let owner = __pg_begin(&self.owner)
        check_status(&owner)?
        Ok(Transaction { owner })
    }
}
impl Transaction {
    /// Consumes the query, executes it, and reports the number of affected rows.
    pub fn execute(&mut self, query: Query) @suspends -> Result<UInt64, DbError> {
        exec(&self.owner, query)
    }
    /// Consumes the query and returns the decoded result rows.
    pub fn query(&mut self, query: Query) @suspends -> Result<Array<Row>, DbError> {
        fetch(&self.owner, query)
    }
    /// Returns at most one row and rejects additional rows.
    pub fn query_optional(&mut self, query: Query) @suspends -> Result<Option<Row>, DbError> {
        optional_row(&self.owner, query)
    }
    /// Requires exactly one row.
    pub fn query_one(&mut self, query: Query) @suspends -> Result<Row, DbError> {
        required_row(self.query_optional(query)?)
    }
    /// Requires exactly one row and one column, then decodes that column.
    pub fn query_scalar<T: FromSql>(&mut self, query: Query) @suspends -> Result<T, DbError> {
        scalar_value::<T>(self.query_one(query)?)
    }
    /// Requires exactly one row and converts it to the requested row type.
    pub fn query_one_as<T: FromRow>(&mut self, query: Query) @suspends -> Result<T, DbError> {
        let row = self.query_one(query)?
        FromRow.from_row::<T>(&row)
    }
    /// Consumes the transaction and waits for PostgreSQL to commit it.
    pub fn commit(self) @suspends -> Result<Unit, DbError> {
        let result = __pg_finish(&self.owner, 1)
        check_status(&result)
    }
    /// Consumes the transaction and waits for PostgreSQL to roll it back.
    pub fn rollback(self) @suspends -> Result<Unit, DbError> {
        let result = __pg_finish(&self.owner, 0)
        check_status(&result)
    }
}
