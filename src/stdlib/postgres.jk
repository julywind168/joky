// Runtime SQL uses positional PostgreSQL parameters. Values never become SQL text.
import joky/array.{type Array}
import joky/result.{type Result, Ok, Err}
import joky/string

extern fn __pg_open(max_connections: UInt64) @suspends -> postgres.Owner
extern fn __pg_share(owner: &postgres.Owner) @suspends -> postgres.Owner
extern fn __pg_begin(owner: &postgres.Owner) @suspends -> postgres.Owner
extern fn __pg_run(owner: &postgres.Owner, query: UInt64, sql: String, params: Array<UInt8>) @suspends -> postgres.Owner
extern fn __pg_finish(owner: &postgres.Owner, commit: UInt64) @suspends -> postgres.Owner
extern fn __pg_status(owner: &postgres.Owner) @suspends -> UInt64
extern fn __pg_count(owner: &postgres.Owner) @suspends -> UInt64
extern fn __pg_data(owner: &postgres.Owner) @suspends -> Array<UInt8>

pub enum Kind { Boolean, Integer, Text, Bytes }
pub enum Value { Null(Kind), BoolValue(Bool), IntValue(Int64), TextValue(String), BytesValue(Array<UInt8>) }
pub enum DbError { Invalid, Unavailable, Closed, Limit, OutcomeUnknown, Database(String), UnsupportedType }
pub struct Pool { owner: postgres.Owner }
pub struct Transaction { owner: postgres.Owner }
pub type Row = Array<Value>

fn check(owner: &postgres.Owner) @suspends -> Result<Unit, DbError> {
    match __pg_status(owner) {
        0 => Ok({}), 1 => Err(Invalid), 2 => Err(Unavailable), 3 => Err(Closed), 4 => Err(Limit),
        5 => Err(OutcomeUnknown), 6 => Err(Database(String.from_utf8(__pg_data(owner))!)), _ => Err(UnsupportedType)
    }
}
pub fn open(max_connections: UInt64) @suspends -> Result<Pool, DbError> {
    let owner = __pg_open(max_connections)
    check(&owner)?
    Ok(Pool { owner })
}
fn word(out: &mut Array<UInt8>, n: UInt64, width: UInt64) {
    for i in uint64(0) .. width { out.push(uint8(n >> (8 * i))) }
}
fn blob(out: &mut Array<UInt8>, tag: UInt8, bytes: &Array<UInt8>) -> Result<Unit, DbError> {
    let size = bytes.len()
    if size + out.len() + 5 > 1048576 { return Err(Limit) }
    out.push(tag)
    word(out, size, 4)
    array.extend_bytes(out, bytes.slice(0, size), 0, size)
    Ok({})
}
fn encode(params: Array<Value>) -> Result<Array<UInt8>, DbError> {
    if params.len() > 256 { return Err(Limit) }
    var data: Array<UInt8> = []
    for param in params {
        match param {
            Null(kind) => data.push(match kind { Boolean => 0, Integer => 1, Text => 2, Bytes => 3 }),
            BoolValue(value) => { data.push(4); data.push(if value { 1 } else { 0 }) },
            IntValue(value) => { data.push(5); word(&mut data, uint64(value), 8) },
            TextValue(value) => { if value.byte_length() > 1048576 { return Err(Limit) }; let bytes = value.into_bytes(); blob(&mut data, 6, &bytes)? },
            BytesValue(bytes) => blob(&mut data, 7, &bytes)?
        }
    }
    if data.len() > 1048576 { return Err(Limit) }
    Ok(data)
}
fn take(data: &Array<UInt8>, offset: &mut UInt64, width: UInt64) -> UInt64 {
    var value: UInt64 = 0
    for i in uint64(0) .. width { value = value | (uint64(data[*offset + i]) << (8 * i)) }
    *offset = *offset + width
    value
}
fn cell(data: &Array<UInt8>, offset: &mut UInt64) -> Value {
    let tag = take(data, offset, 1)
    if tag < 4 { return Null(match tag { 0 => Boolean, 1 => Integer, 2 => Text, _ => Bytes }) }
    if tag == 4 { return BoolValue(take(data, offset, 1) != 0) }
    if tag == 5 { return IntValue(int64(take(data, offset, 8))) }
    let n = take(data, offset, 4)
    var bytes: Array<UInt8> = []
    array.extend_bytes(&mut bytes, data.slice(0, data.len()), *offset, *offset + n)
    *offset = *offset + n
    if tag == 6 { TextValue(String.from_utf8(bytes)!) } else { BytesValue(bytes) }
}
fn rows(data: Array<UInt8>) -> Array<Row> {
    var result: Array<Row> = []
    var offset: UInt64 = 0
    while offset < data.len() {
        let count = take(&data, &mut offset, 4)
        var row: Row = []
        for i in uint64(0) .. count { row.push(cell(&data, &mut offset)) }
        result.push(row)
    }
    result
}
fn run(owner: &postgres.Owner, mode: UInt64, sql: String, params: Array<Value>) @suspends -> Result<postgres.Owner, DbError> {
    let result = __pg_run(owner, mode, sql, encode(params)?)
    check(&result)?
    Ok(result)
}
fn exec(owner: &postgres.Owner, sql: String, params: Array<Value>) @suspends -> Result<UInt64, DbError> {
    let result = run(owner, 0, sql, params)?
    Ok(__pg_count(&result))
}
fn fetch(owner: &postgres.Owner, sql: String, params: Array<Value>) @suspends -> Result<Array<Row>, DbError> {
    let result = run(owner, 1, sql, params)?
    Ok(rows(__pg_data(&result)))
}
impl Pool {
    pub fn share(&self) @suspends -> Self { Pool { owner: __pg_share(&self.owner) } }
    pub fn execute(&self, sql: String, params: Array<Value>) @suspends -> Result<UInt64, DbError> { exec(&self.owner, sql, params) }
    pub fn query(&self, sql: String, params: Array<Value>) @suspends -> Result<Array<Row>, DbError> { fetch(&self.owner, sql, params) }
    pub fn begin(&self) @suspends -> Result<Transaction, DbError> {
        let owner = __pg_begin(&self.owner)
        check(&owner)?
        Ok(Transaction { owner })
    }
}
impl Transaction {
    pub fn execute(&mut self, sql: String, params: Array<Value>) @suspends -> Result<UInt64, DbError> { exec(&self.owner, sql, params) }
    pub fn query(&mut self, sql: String, params: Array<Value>) @suspends -> Result<Array<Row>, DbError> { fetch(&self.owner, sql, params) }
    pub fn commit(self) @suspends -> Result<Unit, DbError> { let result = __pg_finish(&self.owner, 1); check(&result) }
    pub fn rollback(self) @suspends -> Result<Unit, DbError> { let result = __pg_finish(&self.owner, 0); check(&result) }
}
