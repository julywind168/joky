// Runtime SQL uses positional PostgreSQL parameters. Values never become SQL text.
import joky/array.{type Array}
import joky/option.{type Option, Some, None}
import joky/result.{type Result, Ok, Err}
import joky/check.{panic}
import joky/show.{type Show}
import joky/string.{type StringBuilder}

extern fn __pg_open(max_connections: UInt64) @suspends -> postgres.Owner
extern fn __pg_share(owner: &postgres.Owner) @suspends -> postgres.Owner
extern fn __pg_begin(owner: &postgres.Owner) @suspends -> postgres.Owner
extern fn __pg_run(owner: &postgres.Owner, query: UInt64, sql: String, params: Array<UInt8>) @suspends -> postgres.Owner
extern fn __pg_finish(owner: &postgres.Owner, commit: UInt64) @suspends -> postgres.Owner
extern fn __pg_status(owner: &postgres.Owner) @suspends -> UInt64
extern fn __pg_count(owner: &postgres.Owner) @suspends -> UInt64
extern fn __pg_data(owner: &postgres.Owner) @suspends -> Array<UInt8>

pub enum Kind { Boolean, Integer, Text, Bytes }
impl Show for Kind {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            Boolean => "boolean"
            Integer => "integer"
            Text => "text"
            Bytes => "bytes"
        })
    }
}

pub enum Value { Null(Kind), BoolValue(Bool), IntValue(Int64), TextValue(String), BytesValue(Array<UInt8>) }
pub enum ReadFailure { UnsupportedType, ResultLimit, NoRows, MultipleRows }
impl Show for ReadFailure {
    fn show(&self, output: &mut StringBuilder) @noescape {
        output.push_str(match self {
            UnsupportedType => "query sent; unsupported result column"
            ResultLimit => "query sent; result limit exceeded"
            NoRows => "query returned no rows"
            MultipleRows => "query returned multiple rows"
        })
    }
}

pub enum ColumnError { OutOfBounds(UInt64), TypeMismatch(UInt64), UnexpectedNull(UInt64), MissingColumn, AmbiguousColumn }
pub enum DbError { Invalid, Unavailable, Closed, Limit, OutcomeUnknown, Database(String), ResultRead(ReadFailure), Connect(String), AcquireFailed, AcquireTimeout, Column(ColumnError) }
impl Show for ColumnError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            OutOfBounds(i) => { output.push_str("no column at index "); i.show(output) },
            TypeMismatch(i) => { output.push_str("unexpected type at column "); i.show(output) },
            UnexpectedNull(i) => { output.push_str("unexpected NULL at column "); i.show(output) },
            MissingColumn => output.push_str("column name not found"),
            AmbiguousColumn => output.push_str("ambiguous column name")
        }
    }
}
impl Show for DbError {
    fn show(&self, output: &mut StringBuilder) @noescape {
        match self {
            Invalid => output.push_str("invalid database request"),
            Unavailable => output.push_str("database service unavailable"),
            Closed => output.push_str("transaction closed"),
            Limit => output.push_str("database request limit exceeded"),
            OutcomeUnknown => output.push_str("database outcome unknown"),
            Database(code) => { output.push_str("database error "); output.push_str(code) },
            Connect(code) => {
                output.push_str("database connection failed")
                if !code.is_empty() { output.push_str(" (SQLSTATE "); output.push_str(code); output.push_str(")") }
            },
            AcquireFailed => output.push_str("pool checkout failed"),
            AcquireTimeout => output.push_str("pool checkout timed out"),
            Column(reason) => reason.show(output),
            ResultRead(reason) => reason.show(output)
        }
    }
}
pub struct Pool { owner: postgres.Owner }
pub struct Transaction { owner: postgres.Owner }
pub struct Row { names: Array<String>, cells: Array<Value> }
impl Row {
    pub fn len(&self) -> UInt64 { self.cells.len() }
    pub fn column_names(&self) -> &Array<String> { &self.names }
    pub fn values(&self) -> &Array<Value> { &self.cells }
    pub fn borrow_ref(&self, i: UInt64) -> &Value { self.cells.borrow_ref(i) }
    pub fn get_ref(&self, i: UInt64) -> Option<&Value> { self.cells.get_ref(i) }

    pub fn column_index(&self, name: &String) -> Result<UInt64, ColumnError> {
        var found: Option<UInt64> = None
        for i in 0 .. self.names.len() {
            if self.names.borrow_ref(i) == name {
                if found.is_some() { return Err(AmbiguousColumn) }
                found = Some(i)
            }
        }
        match found { Some(i) => Ok(i), None => Err(MissingColumn) }
    }
    pub fn get<T: FromSql>(&self, name: &String) @noescape -> Result<T, DbError> {
        let i = match self.column_index(name) { Ok(i) => i, Err(reason) => return Err(Column(reason)) }
        FromSql.from_sql::<T>(self, i)
    }
    pub fn get_opt<T: FromSql>(&self, name: &String) @noescape -> Result<Option<T>, DbError> {
        self.get::<Option<T>>(name)
    }
    pub fn get_bool(&self, name: &String) -> Result<Option<Bool>, ColumnError> {
        get_bool(self, self.column_index(name)?)
    }
    pub fn get_int64(&self, name: &String) -> Result<Option<Int64>, ColumnError> {
        get_i64(self, self.column_index(name)?)
    }
    pub fn require_int64(&self, name: &String) -> Result<Int64, DbError> {
        self.get::<Int64>(name)
    }
    pub fn get_text(&self, name: &String) @noescape(name) -> Result<Option<&String>, ColumnError> {
        get_text(self, self.column_index(name)?)
    }
    pub fn get_bytes(&self, name: &String) @noescape(name) -> Result<Option<&Array<UInt8>>, ColumnError> {
        get_bytes(self, self.column_index(name)?)
    }
}

// Decoded values own their data and can outlive the source row.
pub trait FromSql {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Self, DbError>
}
pub trait FromRow {
    fn from_row(row: &Row) @noescape -> Result<Self, DbError>
}
impl FromSql for Int64 {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Int64, DbError> {
        match get_i64(row, i) {
            Ok(Some(value)) => Ok(value), Ok(None) => Err(Column(UnexpectedNull(i))), Err(reason) => Err(Column(reason))
        }
    }
}
impl FromSql for Bool {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Bool, DbError> {
        match get_bool(row, i) {
            Ok(Some(value)) => Ok(value), Ok(None) => Err(Column(UnexpectedNull(i))), Err(reason) => Err(Column(reason))
        }
    }
}
impl FromSql for String {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<String, DbError> {
        match get_text(row, i) {
            Ok(Some(value)) => Ok(value.clone()), Ok(None) => Err(Column(UnexpectedNull(i))), Err(reason) => Err(Column(reason))
        }
    }
}
impl FromSql for Array<UInt8> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Array<UInt8>, DbError> {
        match get_bytes(row, i) {
            Ok(Some(value)) => Ok(array.clone(value)), Ok(None) => Err(Column(UnexpectedNull(i))), Err(reason) => Err(Column(reason))
        }
    }
}
impl<T: FromSql> FromSql for Option<T> {
    fn from_sql(row: &Row, i: UInt64) @noescape -> Result<Option<T>, DbError> {
        match FromSql.from_sql::<T>(row, i) {
            Ok(value) => Ok(Some(value)),
            Err(Column(UnexpectedNull(_))) => Ok(None),
            Err(error) => Err(error)
        }
    }
}

pub fn get_bool(row: &Row, i: UInt64) -> Result<Option<Bool>, ColumnError> {
    if i >= row.len() { return Err(OutOfBounds(i)) }
    match row.borrow_ref(i) {
        BoolValue(v) => Ok(Some(v)), Null(Boolean) => Ok(None), _ => Err(TypeMismatch(i))
    }
}
pub fn get_i64(row: &Row, i: UInt64) -> Result<Option<Int64>, ColumnError> {
    if i >= row.len() { return Err(OutOfBounds(i)) }
    match row.borrow_ref(i) {
        IntValue(v) => Ok(Some(v)), Null(Integer) => Ok(None), _ => Err(TypeMismatch(i))
    }
}
pub fn get_text(row: &Row, i: UInt64) -> Result<Option<&String>, ColumnError> {
    if i >= row.len() { return Err(OutOfBounds(i)) }
    match row.borrow_ref(i) {
        TextValue(v) => Ok(Some(v)), Null(Text) => Ok(None), _ => Err(TypeMismatch(i))
    }
}
pub fn get_bytes(row: &Row, i: UInt64) -> Result<Option<&Array<UInt8>>, ColumnError> {
    if i >= row.len() { return Err(OutOfBounds(i)) }
    match row.borrow_ref(i) {
        BytesValue(v) => Ok(Some(v)), Null(Bytes) => Ok(None), _ => Err(TypeMismatch(i))
    }
}
fn check_status(owner: &postgres.Owner) @suspends -> Result<Unit, DbError> {
    match __pg_status(owner) {
        0 => Ok({}), 1 => Err(Invalid), 2 => Err(Unavailable), 3 => Err(Closed), 4 => Err(Limit),
        5 => Err(OutcomeUnknown), 6 => Err(Database(String.from_utf8(__pg_data(owner))!)), 7 => Err(ResultRead(UnsupportedType)), 8 => Err(ResultRead(ResultLimit)),
        9 => Err(Connect(String.from_utf8(__pg_data(owner))!)), 10 => Err(AcquireFailed), 11 => Err(AcquireTimeout), 12 => Err(ResultRead(MultipleRows)),
        _ => panic("invalid database status")
    }
}
pub fn open(max_connections: UInt64) @suspends -> Result<Pool, DbError> {
    let owner = __pg_open(max_connections)
    check_status(&owner)?
    Ok(Pool { owner })
}
fn word(out: &mut Array<UInt8>, n: UInt64, width: UInt64) {
    for i in 0 .. width { out.push(uint8(n >> (8 * i))) }
}
fn blob(out: &mut Array<UInt8>, tag: UInt8, bytes: &Array<UInt8>) -> Result<Unit, DbError> {
    let size = bytes.len()
    if size + out.len() + 5 > 1048576 { return Err(Limit) }
    out.push(tag)
    word(out, size, 4)
    array.extend_bytes(out, bytes.slice(0, size), 0, size)
    Ok({})
}
fn encode(params: Array<Value>) -> Result<Array<UInt8>, DbError> {
    if params.len() > 256 { return Err(Limit) }
    var data: Array<UInt8> = []
    for param in params {
        match param {
            Null(kind) => data.push(match kind { Boolean => 0, Integer => 1, Text => 2, Bytes => 3 }),
            BoolValue(value) => { data.push(4); data.push(if value { 1 } else { 0 }) },
            IntValue(value) => { data.push(5); word(&mut data, uint64(value), 8) },
            TextValue(value) => { if value.byte_length() > 1048576 { return Err(Limit) }; let bytes = value.into_bytes(); blob(&mut data, 6, &bytes)? },
            BytesValue(bytes) => blob(&mut data, 7, &bytes)?
        }
    }
    if data.len() > 1048576 { return Err(Limit) }
    Ok(data)
}
fn take(data: &Array<UInt8>, offset: &mut UInt64, width: UInt64) -> UInt64 {
    var value: UInt64 = 0
    for i in 0 .. width { value = value | (uint64(data[*offset + i]) << (8 * i)) }
    *offset = *offset + width
    value
}
fn take_bytes(data: &Array<UInt8>, offset: &mut UInt64) -> Array<UInt8> {
    let n = take(data, offset, 4)
    var bytes: Array<UInt8> = []
    array.extend_bytes(&mut bytes, data.slice(0, data.len()), *offset, *offset + n)
    *offset = *offset + n
    bytes
}
fn cell(data: &Array<UInt8>, offset: &mut UInt64) -> Value {
    let tag = take(data, offset, 1)
    if tag < 4 { return Null(match tag { 0 => Boolean, 1 => Integer, 2 => Text, _ => Bytes }) }
    if tag == 4 { return BoolValue(take(data, offset, 1) != 0) }
    if tag == 5 { return IntValue(int64(take(data, offset, 8))) }
    let bytes = take_bytes(data, offset)
    if tag == 6 { TextValue(String.from_utf8(bytes)!) } else { BytesValue(bytes) }
}
fn rows(data: Array<UInt8>) -> Array<Row> {
    var result: Array<Row> = []
    var offset: UInt64 = 0
    while offset < data.len() {
        let count = take(&data, &mut offset, 4)
        var row = Row { names: [], cells: [] }
        for i in 0 .. count {
            row.names.push(String.from_utf8(take_bytes(&data, &mut offset))!)
            row.cells.push(cell(&data, &mut offset))
        }
        result.push(row)
    }
    result
}
fn run(owner: &postgres.Owner, mode: UInt64, sql: String, params: Array<Value>) @suspends -> Result<postgres.Owner, DbError> {
    let result = __pg_run(owner, mode, sql, encode(params)?)
    check_status(&result)?
    Ok(result)
}
fn exec(owner: &postgres.Owner, sql: String, params: Array<Value>) @suspends -> Result<UInt64, DbError> {
    let result = run(owner, 0, sql, params)?
    Ok(__pg_count(&result))
}
fn fetch(owner: &postgres.Owner, sql: String, params: Array<Value>) @suspends -> Result<Array<Row>, DbError> {
    let result = run(owner, 3, sql, params)?
    Ok(rows(__pg_data(&result)))
}
fn optional_row(owner: &postgres.Owner, sql: String, params: Array<Value>) @suspends -> Result<Option<Row>, DbError> {
    let result = run(owner, 4, sql, params)?
    var found = rows(__pg_data(&result))
    Ok(found.pop())
}
fn required_row(found: Option<Row>) -> Result<Row, DbError> {
    match found { Some(row) => Ok(row), None => Err(ResultRead(NoRows)) }
}
impl Pool {
    pub fn share(&self) @suspends -> Self { Pool { owner: __pg_share(&self.owner) } }
    pub fn execute(&self, sql: String, params: Array<Value>) @suspends -> Result<UInt64, DbError> { exec(&self.owner, sql, params) }
    pub fn query(&self, sql: String, params: Array<Value>) @suspends -> Result<Array<Row>, DbError> { fetch(&self.owner, sql, params) }
    pub fn query_optional(&self, sql: String, params: Array<Value>) @suspends -> Result<Option<Row>, DbError> { optional_row(&self.owner, sql, params) }
    pub fn query_one(&self, sql: String, params: Array<Value>) @suspends -> Result<Row, DbError> { required_row(optional_row(&self.owner, sql, params)?) }
    pub fn query_one_as<T: FromRow>(&self, sql: String, params: Array<Value>) @suspends -> Result<T, DbError> {
        let row = self.query_one(sql, params)?
        FromRow.from_row::<T>(&row)
    }
    pub fn begin(&self) @suspends -> Result<Transaction, DbError> {
        let owner = __pg_begin(&self.owner)
        check_status(&owner)?
        Ok(Transaction { owner })
    }
}
impl Transaction {
    pub fn execute(&mut self, sql: String, params: Array<Value>) @suspends -> Result<UInt64, DbError> { exec(&self.owner, sql, params) }
    pub fn query(&mut self, sql: String, params: Array<Value>) @suspends -> Result<Array<Row>, DbError> { fetch(&self.owner, sql, params) }
    pub fn query_optional(&mut self, sql: String, params: Array<Value>) @suspends -> Result<Option<Row>, DbError> { optional_row(&self.owner, sql, params) }
    pub fn query_one(&mut self, sql: String, params: Array<Value>) @suspends -> Result<Row, DbError> { required_row(optional_row(&self.owner, sql, params)?) }
    pub fn query_one_as<T: FromRow>(&mut self, sql: String, params: Array<Value>) @suspends -> Result<T, DbError> {
        let row = self.query_one(sql, params)?
        FromRow.from_row::<T>(&row)
    }
    pub fn commit(self) @suspends -> Result<Unit, DbError> { let result = __pg_finish(&self.owner, 1); check_status(&result) }
    pub fn rollback(self) @suspends -> Result<Unit, DbError> { let result = __pg_finish(&self.owner, 0); check_status(&result) }
}
