// A borrow-only view of one initialized element, never an owning value.
import joky/internal/buffer as storage

pub type Element<T> = storage.Element<T>
pub fn read<T: Copy>(value: &Element<T>) -> T { storage.element_load(value) }
pub fn write<T: Copy>(value: &mut Element<T>, next: T) { storage.element_store(value, next) }
