// Numeric endpoints and bounded TCP byte/text reads.
import joky/array.{type Array}
import joky/result.{type Result, Ok, Err}
import joky/option.{type Option, Some, None}
import joky/string.{type Utf8Error}
import joky/mem
import joky/internal/resolve

extern fn __joky_task_yield_now() @suspends

pub struct Address { high: UInt64, low: UInt64, endpoint: UInt64 }
impl Address {
    pub fn ipv4(ip: UInt32, port: UInt16) -> Self {
        Address { high: 0, low: uint64(ip), endpoint: 4 | (uint64(port) << 8) }
    }
    // Network-order upper/lower halves, e.g. ::1 is (0, 1).
    pub fn ipv6(high: UInt64, low: UInt64, port: UInt16) -> Self {
        Address { high: high, low: low, endpoint: 6 | (uint64(port) << 8) }
    }
    pub fn port(self) -> UInt16 { uint16((self.endpoint >> 8) & 65535) }
    pub fn scope_id(self) -> UInt32 { uint32(self.endpoint >> 32) }
    pub fn with_scope(self, index: UInt32) -> Self { Address { high: self.high, low: self.low, endpoint: (self.endpoint & 0xffffff) | (uint64(index) << 32) } }
    pub fn is_ipv6(self) -> Bool { (self.endpoint & 255) == 6 }
    pub fn high(self) -> UInt64 { self.high }
    pub fn low(self) -> UInt64 { self.low }
}

pub enum ErrorKind { ConnectionRefused, ConnectionReset, ConnectionAborted, NotConnected, AddrInUse, AddrNotAvailable, BrokenPipe, PermissionDenied, InvalidInput, TimedOut, WriteZero, Other }
pub struct IoError { code: UInt64 }
impl IoError {
    pub fn kind(self) -> ErrorKind {
        let code = self.code & 0xffffffff
        if code == 1 { return ErrorKind.ConnectionRefused }
        if code == 2 { return ErrorKind.ConnectionReset }
        if code == 3 { return ErrorKind.ConnectionAborted }
        if code == 4 { return ErrorKind.NotConnected }
        if code == 5 { return ErrorKind.AddrInUse }
        if code == 6 { return ErrorKind.AddrNotAvailable }
        if code == 7 { return ErrorKind.BrokenPipe }
        if code == 8 { return ErrorKind.PermissionDenied }
        if code == 9 { return ErrorKind.InvalidInput }
        if code == 10 { return ErrorKind.TimedOut }
        if code == 11 { return ErrorKind.WriteZero }
        ErrorKind.Other
    }
    pub fn os_code(self) -> UInt32 { uint32(self.code >> 32) }
}
pub enum Shutdown { Read, Write, Both }
pub struct TcpStream { owner: tcp.StreamOwner }
pub struct TcpListener { owner: tcp.ListenerOwner }
pub struct TcpReader { owner: tcp.ReaderOwner }
pub struct TcpWriter { owner: tcp.WriterOwner }

// Host endpoints resolve once and try candidates in system order.
pub enum EndpointError { Resolve(resolve.ResolveError), Io(IoError) }
fn resolved_address(high: UInt64, low: UInt64, endpoint: UInt64) -> Address {
    Address { high, low, endpoint }
}
pub fn listen(host: String, port: UInt16) @suspends -> Result<TcpListener, EndpointError> {
    let addresses = match resolve.lookup(host, port, resolved_address) {
        Ok(addresses) => addresses,
        Err(error) => return Err(EndpointError.Resolve(error))
    }
    var last = IoError { code: 6 }
    for address in addresses {
        match TcpListener.bind(address) {
            Ok(listener) => return Ok(listener),
            Err(error) => last = error
        }
    }
    Err(EndpointError.Io(last))
}
pub fn connect(host: String, port: UInt16) @suspends -> Result<TcpStream, EndpointError> {
    let addresses = match resolve.lookup(host, port, resolved_address) {
        Ok(addresses) => addresses,
        Err(error) => return Err(EndpointError.Resolve(error))
    }
    var last = IoError { code: 6 }
    for address in addresses {
        match TcpStream.connect(address) {
            Ok(stream) => return Ok(stream),
            Err(error) => last = error
        }
    }
    Err(EndpointError.Io(last))
}

pub enum ReadError { InvalidLimit, Io(IoError), UnexpectedEof(UInt64), LimitExceeded, InvalidUtf8(Utf8Error) }
enum ReadState { Open, Eof, Failed(IoError) }
// The synchronous framing state machine is shared by both concrete transports.
enum ReadMode { Partial, Exact, Until(UInt8) }
enum ReadStatus { More, Done, CleanEof }
struct ReadProgress { mode: ReadMode, limit: UInt64, bytes: Array<UInt8> }
impl ReadProgress {
    fn new(mode: ReadMode, limit: UInt64) -> Result<Self, ReadError> {
        if limit > 1048576 { return Err(ReadError.InvalidLimit) }
        if limit == 0 { match mode { Exact => {}, _ => { return Err(ReadError.InvalidLimit) } } }
        Ok(ReadProgress { mode: mode, limit: limit, bytes: Array.new::<UInt8>() })
    }
    fn is_complete(&self) -> Bool { self.bytes.len() == self.limit }
    fn advance(&mut self, buffer: &mut ReceiveBuffer) @noescape -> Result<ReadStatus, ReadError> {
        let limit = self.limit
        let available = buffer.buffered_len()
        if available == 0 {
            let count = self.bytes.len()
            match self.mode { Partial => { return Ok(ReadStatus.Done) }, _ => {} }
            if count == 0 { return Ok(ReadStatus.CleanEof) }
            return Err(ReadError.UnexpectedEof(count))
        }
        let remaining = self.limit - self.bytes.len()
        let length = match self.mode { Partial => if available < remaining { available } else { remaining }, _ => bounded_chunk(available, remaining) }
        var count = length
        var found = false
        match self.mode {
            Until(delimiter) => {
                count = 0
                while count < length && !found { found = buffer.byte_at(count) == delimiter; count = count + 1 }
            }
            Exact => { if self.bytes.is_empty() { self.bytes.reserve(limit) } }
            Partial => { self.bytes.reserve(length) }
        }
        buffer.take_into(&mut self.bytes, count)
        match self.mode {
            Partial => Ok(ReadStatus.Done)
            Exact => Ok(if self.is_complete() { ReadStatus.Done } else { ReadStatus.More })
            Until(_) => {
                if found { return Ok(ReadStatus.Done) }
                if self.is_complete() { return Err(ReadError.LimitExceeded) }
                Ok(ReadStatus.More)
            }
        }
    }
    fn finish(self, status: ReadStatus) -> Option<Array<UInt8>> {
        match status { CleanEof => None, _ => Some(self.bytes) }
    }
}
// Strip LF or CRLF and validate UTF-8 only after the delimiter is consumed.
fn decode_line(bytes: Array<UInt8>) -> Result<String, ReadError> {
    var bytes = bytes
    let length = bytes.len() - 1
    bytes.truncate(length)
    if length > 0 && bytes[length - 1] == 13 { bytes.truncate(length - 1) }
    match String.from_utf8(bytes) { Ok(line) => Ok(line), Err(error) => Err(ReadError.InvalidUtf8(error)) }
}
struct ReceiveBuffer {
    bytes: Array<UInt8>,
    offset: UInt64,
    capacity: UInt64,
    state: ReadState,
}
impl ReceiveBuffer {
    fn new(capacity: UInt64) -> Self {
        ReceiveBuffer { bytes: Array.new::<UInt8>(), offset: 0, capacity: capacity, state: ReadState.Open }
    }
    fn buffered_len(&self) -> UInt64 { self.bytes.len() - self.offset }
    fn is_eof(&self) -> Bool { match self.state { Eof => true, _ => false } }
    fn needs_fill(&self) -> Result<Bool, ReadError> {
        if self.buffered_len() > 0 { return Ok(false) }
        match self.state { Open => Ok(true), Eof => Ok(false), Failed(error) => Err(ReadError.Io(error)) }
    }
    fn publish(&mut self, result: Result<Array<UInt8>, IoError>) -> Result<Unit, ReadError> {
        let bytes = match result {
            Ok(bytes) => bytes
            Err(error) => { self.state = ReadState.Failed(error); return Err(ReadError.Io(error)) }
        }
        // Keep the offset in range even if cancellation splits publication.
        self.offset = 0
        mem.replace(&mut self.bytes, bytes);
        if self.bytes.is_empty() { self.state = ReadState.Eof }
        Ok({})
    }
    fn byte_at(&self, index: UInt64) -> UInt8 { self.bytes[self.offset + index] }
    fn take_into(&mut self, result: &mut Array<UInt8>, length: UInt64) {
        var index: UInt64 = 0
        while index < length { result.push(self.byte_at(index)); index = index + 1 }
        self.offset = self.offset + length
    }
}
pub struct BufferedTcp { stream: TcpStream, buffer: ReceiveBuffer }
pub struct BufferedTcpReader { stream: TcpReader, buffer: ReceiveBuffer }
impl BufferedTcp {
    // Allocate lazily; capacity bounds each refill, independently of read limits.
    pub fn new(stream: TcpStream) -> Self { BufferedTcp { stream: stream, buffer: ReceiveBuffer.new(16384) } }
    pub fn with_capacity(stream: TcpStream, capacity: UInt64) -> Result<Self, ReadError> {
        if capacity == 0 || capacity > 1048576 { return Err(ReadError.InvalidLimit) }
        Ok(BufferedTcp { stream: stream, buffer: ReceiveBuffer.new(capacity) })
    }
    pub fn capacity(&self) -> UInt64 { self.buffer.capacity }
    pub fn buffered_len(&self) -> UInt64 { self.buffer.buffered_len() }
    pub fn is_eof(&self) -> Bool { self.buffer.is_eof() }
    // A received prefix may be lost on cancellation; end the protocol connection.
    fn read_frame(&mut self, progress: ReadProgress) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        var progress = progress
        if progress.is_complete() { return Ok(progress.finish(ReadStatus.Done)) }
        while true {
            let needs_fill = self.buffer.needs_fill()?
            if needs_fill {
                let capacity = self.buffer.capacity
                let result = self.stream.read(capacity)
                self.buffer.publish(result)?
            }
            let status = progress.advance(&mut self.buffer)?
            match status { More => __joky_task_yield_now(), _ => { return Ok(progress.finish(status)) } }
        }
    }
    pub fn read(&mut self, limit: UInt64) @suspends -> Result<Array<UInt8>, ReadError> {
        let progress = ReadProgress.new(ReadMode.Partial, limit)?
        Ok(match self.read_frame(progress)? { Some(bytes) => bytes, None => Array.new::<UInt8>() })
    }
    pub fn read_exact(&mut self, length: UInt64) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        let progress = ReadProgress.new(ReadMode.Exact, length)?
        self.read_frame(progress)
    }
    pub fn read_until(&mut self, delimiter: UInt8, limit: UInt64) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        let progress = ReadProgress.new(ReadMode.Until(delimiter), limit)?
        self.read_frame(progress)
    }
    pub fn read_line(&mut self, limit: UInt64) @suspends -> Result<Option<String>, ReadError> {
        let bytes = match self.read_until(10, limit)? { Some(bytes) => bytes, None => { return Ok(None) } }
        Ok(Some(decode_line(bytes)?))
    }
    // Truncation counts all consumed bytes in the message, including its header.
    pub fn read_message(&mut self, limit: UInt64) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        if limit > 1048576 { return Err(ReadError.InvalidLimit) }
        let header = match self.read_exact(4)? { Some(header) => header, None => { return Ok(None) } }
        let length = message_length(header)
        if length > limit { return Err(ReadError.LimitExceeded) }
        match self.read_exact(length) {
            Ok(Some(bytes)) => Ok(Some(bytes))
            Ok(None) => Err(ReadError.UnexpectedEof(4))
            Err(UnexpectedEof(count)) => Err(ReadError.UnexpectedEof(4 + count))
            Err(error) => Err(error)
        }
    }
    // Move the existing allocation, cursor and terminal state without refilling.
    pub fn split(self) @suspends -> (BufferedTcpReader, TcpWriter) {
        let (stream, buffer) = buffered_parts(self)
        let (reader, writer) = stream.split()
        (BufferedTcpReader { stream: reader, buffer: buffer }, writer)
    }
    pub fn write_all(&mut self, bytes: Array<UInt8>) @suspends -> Result<Unit, IoError> { self.stream.write_all(bytes) }
    pub fn write_message(&mut self, bytes: Array<UInt8>, limit: UInt64) @suspends -> Result<Unit, IoError> {
        let (bytes, length) = byte_length(bytes)
        if limit > 1048576 || length > limit { return Err(IoError { code: 9 }) }
        self.stream.write_all(message_header(length))?
        self.stream.write_all(bytes)
    }
    pub fn close(self) @suspends -> Result<Unit, IoError> { self.stream.close() }
}
fn buffered_parts(buffered: BufferedTcp) -> (TcpStream, ReceiveBuffer) {
    let BufferedTcp { stream, buffer } = buffered
    (stream, buffer)
}

impl BufferedTcpReader {
    // Allocate lazily; capacity bounds each refill, independently of read limits.
    pub fn new(stream: TcpReader) -> Self { BufferedTcpReader { stream: stream, buffer: ReceiveBuffer.new(16384) } }
    pub fn with_capacity(stream: TcpReader, capacity: UInt64) -> Result<Self, ReadError> {
        if capacity == 0 || capacity > 1048576 { return Err(ReadError.InvalidLimit) }
        Ok(BufferedTcpReader { stream: stream, buffer: ReceiveBuffer.new(capacity) })
    }
    pub fn capacity(&self) -> UInt64 { self.buffer.capacity }
    pub fn buffered_len(&self) -> UInt64 { self.buffer.buffered_len() }
    pub fn is_eof(&self) -> Bool { self.buffer.is_eof() }
    // A received prefix may be lost on cancellation; end the protocol connection.
    fn read_frame(&mut self, progress: ReadProgress) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        var progress = progress
        if progress.is_complete() { return Ok(progress.finish(ReadStatus.Done)) }
        while true {
            let needs_fill = self.buffer.needs_fill()?
            if needs_fill {
                let capacity = self.buffer.capacity
                let result = self.stream.read(capacity)
                self.buffer.publish(result)?
            }
            let status = progress.advance(&mut self.buffer)?
            match status { More => __joky_task_yield_now(), _ => { return Ok(progress.finish(status)) } }
        }
    }
    pub fn read(&mut self, limit: UInt64) @suspends -> Result<Array<UInt8>, ReadError> {
        let progress = ReadProgress.new(ReadMode.Partial, limit)?
        Ok(match self.read_frame(progress)? { Some(bytes) => bytes, None => Array.new::<UInt8>() })
    }
    pub fn read_exact(&mut self, length: UInt64) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        let progress = ReadProgress.new(ReadMode.Exact, length)?
        self.read_frame(progress)
    }
    pub fn read_until(&mut self, delimiter: UInt8, limit: UInt64) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        let progress = ReadProgress.new(ReadMode.Until(delimiter), limit)?
        self.read_frame(progress)
    }
    pub fn read_line(&mut self, limit: UInt64) @suspends -> Result<Option<String>, ReadError> {
        let bytes = match self.read_until(10, limit)? { Some(bytes) => bytes, None => { return Ok(None) } }
        Ok(Some(decode_line(bytes)?))
    }
    // Truncation counts all consumed bytes in the message, including its header.
    pub fn read_message(&mut self, limit: UInt64) @suspends -> Result<Option<Array<UInt8>>, ReadError> {
        if limit > 1048576 { return Err(ReadError.InvalidLimit) }
        let header = match self.read_exact(4)? { Some(header) => header, None => { return Ok(None) } }
        let length = message_length(header)
        if length > limit { return Err(ReadError.LimitExceeded) }
        match self.read_exact(length) {
            Ok(Some(bytes)) => Ok(Some(bytes))
            Ok(None) => Err(ReadError.UnexpectedEof(4))
            Err(UnexpectedEof(count)) => Err(ReadError.UnexpectedEof(4 + count))
            Err(error) => Err(error)
        }
    }
    pub fn local_addr(&mut self) @suspends -> Result<Address, IoError> { self.stream.local_addr() }
    pub fn peer_addr(&mut self) @suspends -> Result<Address, IoError> { self.stream.peer_addr() }
    // Keep received bytes available; EOF is observed once that cache is exhausted.
    pub fn shutdown(&mut self) @suspends -> Result<Unit, IoError> { self.stream.shutdown() }
    pub fn close(self) @suspends -> Result<Unit, IoError> { self.stream.close() }
}

fn bounded_chunk(available: UInt64, remaining: UInt64) -> UInt64 {
    let length = if available < remaining { available } else { remaining }
    if length < 16384 { length } else { 16384 }
}

fn message_length(header: Array<UInt8>) -> UInt64 {
    var length: UInt64 = 0
    var index: UInt64 = 0
    while index < 4 {
        length = length * 256 + uint64(header[index])
        index = index + 1
    }
    length
}
fn message_header(length: UInt64) -> Array<UInt8> {
    var header = Array.with_capacity::<UInt8>(4)
    header.push(uint8((length >> 24) & 255))
    header.push(uint8((length >> 16) & 255))
    header.push(uint8((length >> 8) & 255))
    header.push(uint8(length & 255))
    header
}

extern fn __tcp_bind(high: UInt64, low: UInt64, endpoint: UInt64, error: &mut UInt64) @suspends -> tcp.ListenerOwner
extern fn __tcp_connect(high: UInt64, low: UInt64, endpoint: UInt64, error: &mut UInt64) @suspends -> tcp.StreamOwner
extern fn __tcp_accept(listener: &mut tcp.ListenerOwner, error: &mut UInt64) @suspends -> tcp.StreamOwner
extern fn __tcp_read(stream: &mut tcp.StreamOwner, limit: UInt64, error: &mut UInt64) @suspends -> Array<UInt8>
extern fn __tcp_write(stream: &mut tcp.StreamOwner, bytes: Array<UInt8>, error: &mut UInt64) @suspends -> UInt64
extern fn __tcp_stream_addr(stream: &mut tcp.StreamOwner, peer: UInt64, high: &mut UInt64, low: &mut UInt64, endpoint: &mut UInt64) @suspends -> UInt64
extern fn __tcp_listener_addr(listener: &mut tcp.ListenerOwner, high: &mut UInt64, low: &mut UInt64, endpoint: &mut UInt64) @suspends -> UInt64
extern fn __tcp_shutdown(stream: &mut tcp.StreamOwner, how: UInt64) @suspends -> UInt64
extern fn __tcp_close_stream(stream: &mut tcp.StreamOwner) @suspends -> UInt64
extern fn __tcp_close_listener(listener: &mut tcp.ListenerOwner) @suspends -> UInt64

extern fn __tcp_split_reader(stream: &mut tcp.StreamOwner) @suspends -> tcp.ReaderOwner
extern fn __tcp_split_writer(stream: &mut tcp.StreamOwner) @suspends -> tcp.WriterOwner
extern fn __tcp_read_half(reader: &mut tcp.ReaderOwner, limit: UInt64, error: &mut UInt64) @suspends -> Array<UInt8>
extern fn __tcp_write_half(writer: &mut tcp.WriterOwner, bytes: Array<UInt8>, error: &mut UInt64) @suspends -> UInt64
extern fn __tcp_reader_addr(reader: &mut tcp.ReaderOwner, peer: UInt64, high: &mut UInt64, low: &mut UInt64, endpoint: &mut UInt64) @suspends -> UInt64
extern fn __tcp_writer_addr(writer: &mut tcp.WriterOwner, peer: UInt64, high: &mut UInt64, low: &mut UInt64, endpoint: &mut UInt64) @suspends -> UInt64
extern fn __tcp_shutdown_reader(reader: &mut tcp.ReaderOwner) @suspends -> UInt64
extern fn __tcp_shutdown_writer(writer: &mut tcp.WriterOwner) @suspends -> UInt64
extern fn __tcp_close_reader(reader: &mut tcp.ReaderOwner) @suspends -> UInt64
extern fn __tcp_close_writer(writer: &mut tcp.WriterOwner) @suspends -> UInt64

fn status(code: UInt64) -> Result<Unit, IoError> {
    if code == 0 { Ok({}) } else { Err(IoError { code: code }) }
}
impl TcpStream {
    // Consume one connection into independent, non-Copy direction owners.
    pub fn split(self) @suspends -> (TcpReader, TcpWriter) {
        var owner = self.owner
        let reader = __tcp_split_reader(&mut owner)
        let writer = __tcp_split_writer(&mut owner)
        (TcpReader { owner: reader }, TcpWriter { owner: writer })
    }
    pub fn connect(address: Address) @suspends -> Result<Self, IoError> {
        var error: UInt64 = 0
        let owner = __tcp_connect(address.high, address.low, address.endpoint, &mut error)
        if error == 0 { Ok(TcpStream { owner: owner }) } else { Err(IoError { code: error }) }
    }
    // A positive limit and an empty success means EOF. Limits are at most 1 MiB.
    pub fn read(&mut self, limit: UInt64) @suspends -> Result<Array<UInt8>, IoError> {
        var error: UInt64 = 0
        let bytes = __tcp_read(&mut self.owner, limit, &mut error)
        if error == 0 { Ok(bytes) } else { Err(IoError { code: error }) }
    }
    // Consumes a bounded byte snapshot; success may report only a prefix.
    pub fn write(&mut self, bytes: Array<UInt8>) @suspends -> Result<UInt64, IoError> {
        var error: UInt64 = 0
        let count = __tcp_write(&mut self.owner, bytes, &mut error)
        if error == 0 { Ok(count) } else { Err(IoError { code: error }) }
    }
    // Cancellation/error may leave a transmitted prefix. Never retry the full
    // input blindly. Keep the original owner and copy only one bounded chunk.
    pub fn write_all(&mut self, bytes: Array<UInt8>) @suspends -> Result<Unit, IoError> {
        let (bytes, length) = byte_length(bytes)
        var remaining = bytes
        if length > 1048576 { return Err(IoError { code: 9 }) }
        var offset: UInt64 = 0
        while offset < length {
            let (original, part) = write_chunk(remaining, offset)
            remaining = original
            let count = self.write(part)?
            if count == 0 { return Err(IoError { code: 11 }) }
            offset = offset + count
            if offset < length { __joky_task_yield_now() }
        }
        Ok({})
    }
    pub fn local_addr(&mut self) @suspends -> Result<Address, IoError> { stream_addr(&mut self.owner, 0) }
    pub fn peer_addr(&mut self) @suspends -> Result<Address, IoError> { stream_addr(&mut self.owner, 1) }
    pub fn shutdown(&mut self, how: Shutdown) @suspends -> Result<Unit, IoError> {
        let mode: UInt64 = match how { Read => 0, Write => 1, Both => 2 }
        status(__tcp_shutdown(&mut self.owner, mode))
    }
    pub fn close(self) @suspends -> Result<Unit, IoError> {
        var owner = self.owner
        status(__tcp_close_stream(&mut owner))
    }
}
fn stream_addr(stream: &mut tcp.StreamOwner, peer: UInt64) @suspends -> Result<Address, IoError> {
    var high: UInt64 = 0
    var low: UInt64 = 0
    var endpoint: UInt64 = 0
    let error = __tcp_stream_addr(stream, peer, &mut high, &mut low, &mut endpoint)
    if error == 0 { Ok(Address { high: high, low: low, endpoint: endpoint }) } else { Err(IoError { code: error }) }
}

impl TcpReader {
    // A positive bounded read returns an empty success at EOF.
    pub fn read(&mut self, limit: UInt64) @suspends -> Result<Array<UInt8>, IoError> {
        var error: UInt64 = 0
        let bytes = __tcp_read_half(&mut self.owner, limit, &mut error)
        if error == 0 { Ok(bytes) } else { Err(IoError { code: error }) }
    }
    pub fn local_addr(&mut self) @suspends -> Result<Address, IoError> { reader_addr(&mut self.owner, 0) }
    pub fn peer_addr(&mut self) @suspends -> Result<Address, IoError> { reader_addr(&mut self.owner, 1) }
    pub fn shutdown(&mut self) @suspends -> Result<Unit, IoError> { status(__tcp_shutdown_reader(&mut self.owner)) }
    pub fn close(self) @suspends -> Result<Unit, IoError> {
        var owner = self.owner
        status(__tcp_close_reader(&mut owner))
    }
}
impl TcpWriter {
    pub fn write(&mut self, bytes: Array<UInt8>) @suspends -> Result<UInt64, IoError> {
        var error: UInt64 = 0
        let count = __tcp_write_half(&mut self.owner, bytes, &mut error)
        if error == 0 { Ok(count) } else { Err(IoError { code: error }) }
    }
    // Cancellation/error may leave a transmitted prefix. Never retry the full
    // input blindly. Keep the original owner and copy only one bounded chunk.
    pub fn write_all(&mut self, bytes: Array<UInt8>) @suspends -> Result<Unit, IoError> {
        let (bytes, length) = byte_length(bytes)
        var remaining = bytes
        if length == 0 {
            self.write(remaining)?
            return Ok({})
        }
        if length > 1048576 { return Err(IoError { code: 9 }) }
        var offset: UInt64 = 0
        while offset < length {
            let (original, part) = write_chunk(remaining, offset)
            remaining = original
            let count = self.write(part)?
            if count == 0 { return Err(IoError { code: 11 }) }
            offset = offset + count
            if offset < length { __joky_task_yield_now() }
        }
        Ok({})
    }

    pub fn write_message(&mut self, bytes: Array<UInt8>, limit: UInt64) @suspends -> Result<Unit, IoError> {
        let (bytes, length) = byte_length(bytes)
        if limit > 1048576 || length > limit { return Err(IoError { code: 9 }) }
        self.write_all(message_header(length))?
        self.write_all(bytes)
    }
    pub fn local_addr(&mut self) @suspends -> Result<Address, IoError> { writer_addr(&mut self.owner, 0) }
    pub fn peer_addr(&mut self) @suspends -> Result<Address, IoError> { writer_addr(&mut self.owner, 1) }
    pub fn shutdown(&mut self) @suspends -> Result<Unit, IoError> { status(__tcp_shutdown_writer(&mut self.owner)) }
    pub fn close(self) @suspends -> Result<Unit, IoError> {
        var owner = self.owner
        status(__tcp_close_writer(&mut owner))
    }
}
fn reader_addr(reader: &mut tcp.ReaderOwner, peer: UInt64) @suspends -> Result<Address, IoError> {
    var high: UInt64 = 0
    var low: UInt64 = 0
    var endpoint: UInt64 = 0
    let error = __tcp_reader_addr(reader, peer, &mut high, &mut low, &mut endpoint)
    if error == 0 { Ok(Address { high: high, low: low, endpoint: endpoint }) } else { Err(IoError { code: error }) }
}
fn writer_addr(writer: &mut tcp.WriterOwner, peer: UInt64) @suspends -> Result<Address, IoError> {
    var high: UInt64 = 0
    var low: UInt64 = 0
    var endpoint: UInt64 = 0
    let error = __tcp_writer_addr(writer, peer, &mut high, &mut low, &mut endpoint)
    if error == 0 { Ok(Address { high: high, low: low, endpoint: endpoint }) } else { Err(IoError { code: error }) }
}
impl TcpListener {
    pub fn bind(address: Address) @suspends -> Result<Self, IoError> {
        var error: UInt64 = 0
        let owner = __tcp_bind(address.high, address.low, address.endpoint, &mut error)
        if error == 0 { Ok(TcpListener { owner: owner }) } else { Err(IoError { code: error }) }
    }
    pub fn accept(&mut self) @suspends -> Result<TcpStream, IoError> {
        var error: UInt64 = 0
        let owner = __tcp_accept(&mut self.owner, &mut error)
        if error == 0 { Ok(TcpStream { owner: owner }) } else { Err(IoError { code: error }) }
    }
    pub fn local_addr(&mut self) @suspends -> Result<Address, IoError> {
        var high: UInt64 = 0
        var low: UInt64 = 0
        var endpoint: UInt64 = 0
        let error = __tcp_listener_addr(&mut self.owner, &mut high, &mut low, &mut endpoint)
        if error == 0 { Ok(Address { high: high, low: low, endpoint: endpoint }) } else { Err(IoError { code: error }) }
    }
    pub fn close(self) @suspends -> Result<Unit, IoError> {
        var owner = self.owner
        status(__tcp_close_listener(&mut owner))
    }
}

fn byte_length(bytes: Array<UInt8>) -> (Array<UInt8>, UInt64) { let length = bytes.len(); (bytes, length) }
fn write_chunk(bytes: Array<UInt8>, offset: UInt64) -> (Array<UInt8>, Array<UInt8>) {
    let remaining = bytes.len() - offset
    let length = if remaining < 16384 { remaining } else { 16384 }
    var chunk = Array.with_capacity::<UInt8>(length)
    var index: UInt64 = 0
    while index < length {
        chunk.push(bytes[offset + index])
        index = index + 1
    }
    (bytes, chunk)
}
